@page "/admin/users"


<PageTitle>Manage Users</PageTitle>

<div class="users-management">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none mb-3">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <h5 class="mb-0 flex-grow-1">Users Management</h5>
                    <button class="btn btn-link text-white p-0" @onclick='() => Navigation.NavigateTo("/admin/users/create")'>
                        <i class="fas fa-plus fa-lg"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
            <h1>Users Management</h1>
            <div>
                <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/admin/users/create")'>
                    <i class="fas fa-plus me-2"></i> Add New User
                </button>
            </div>
        </div>

        @if (!isAuthenticated)
        {
            <div class="alert alert-danger m-3">
                <i class="fas fa-exclamation-triangle me-2"></i>
                You must be logged in as an administrator to access this page.
            </div>
        }
        else if (!isAdmin)
        {
            <div class="alert alert-danger m-3">
                <i class="fas fa-shield-alt me-2"></i>
                You do not have permission to access this page. Admin access required.
            </div>
        }
        else
        {
            <!-- Stats Cards - Responsive -->
            <div class="row g-2 g-md-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-0 mb-md-1 small">Total Users</h6>
                                    <h3 class="mb-0 fs-4 fs-md-3">@totalUsersCount</h3>
                                </div>
                                <div class="avatar-sm bg-primary rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="fas fa-users text-white small"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-0 mb-md-1 small">Regular</h6>
                                    <h3 class="mb-0 fs-4 fs-md-3">@regularUsersCount</h3>
                                </div>
                                <div class="avatar-sm bg-success rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="fas fa-user text-white small"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-0 mb-md-1 small">Doctors</h6>
                                    <h3 class="mb-0 fs-4 fs-md-3">@doctorsCount</h3>
                                </div>
                                <div class="avatar-sm bg-info rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="fas fa-user-md text-white small"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-0 mb-md-1 small">Admins</h6>
                                    <h3 class="mb-0 fs-4 fs-md-3">@adminsCount</h3>
                                </div>
                                <div class="avatar-sm bg-danger rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="fas fa-user-shield text-white small"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search and Filters - Responsive -->
            <div class="card mb-4 mx-2 mx-md-0">
                <div class="card-body p-3 p-md-4">
                    <!-- Mobile Filter Toggle -->
                    <div class="d-block d-md-none mb-3">
                        <button class="btn btn-outline-primary w-100" @onclick="toggleMobileFilters">
                            <i class="fas fa-filter me-2"></i> Show Filters
                            <i class="fas fa-chevron-down ms-2 @(showMobileFilters ? "rotate-180" : "")"></i>
                        </button>
                    </div>

                    <!-- Filter Content -->
                    <div class="@(showMobileFilters ? "d-block" : "d-none d-md-block")">
                        <div class="row g-2 g-md-3">
                            <div class="col-12 col-md-8">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Search users..."
                                           @bind="searchTerm"
                                           @bind:event="oninput"
                                           @onkeypress="HandleSearchKeyPress" />
                                    <button class="btn btn-primary" @onclick="SearchUsers">
                                        <i class="fas fa-search d-md-none"></i>
                                        <span class="d-none d-md-inline">Search</span>
                                    </button>
                                </div>
                            </div>
                            <div class="col-6 col-md-2">
                                <select class="form-select" @bind="selectedStatus">
                                    <option value="">All Status</option>
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-2">
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-secondary flex-fill" @onclick="ClearFilters">
                                        <i class="fas fa-times me-md-2"></i>
                                        <span class="d-none d-md-inline">Clear</span>
                                    </button>
                                    <button class="btn btn-outline-primary" @onclick="RefreshUsers">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Type Filter - Mobile Horizontal Scroll -->
                    <div class="d-block d-md-none mt-3">
                        <div class="d-flex overflow-auto pb-2" style="gap: 0.5rem;">
                            <button type="button"
                                    class="btn btn-sm flex-shrink-0 @(filterByType == null ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => SetFilterByType(null)">
                                All
                            </button>
                            <button type="button"
                                    class="btn btn-sm flex-shrink-0 @(filterByType == UserType.User ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => SetFilterByType(UserType.User)">
                                Users
                            </button>
                            <button type="button"
                                    class="btn btn-sm flex-shrink-0 @(filterByType == UserType.Doctor ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => SetFilterByType(UserType.Doctor)">
                                Doctors
                            </button>
                            <button type="button"
                                    class="btn btn-sm flex-shrink-0 @(filterByType == UserType.Admin ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => SetFilterByType(UserType.Admin)">
                                Admins
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Users Table/Cards - Responsive -->
            <div class="card mx-2 mx-md-0">
                <!-- Desktop Header -->
                <div class="card-header d-none d-md-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Users</h5>
                    <div class="d-flex align-items-center">
                        <span class="me-2">Filter by type:</span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button"
                                    class="btn @(filterByType == null ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => SetFilterByType(null)">
                                All
                            </button>
                            <button type="button"
                                    class="btn @(filterByType == UserType.User ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => SetFilterByType(UserType.User)">
                                Users
                            </button>
                            <button type="button"
                                    class="btn @(filterByType == UserType.Doctor ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => SetFilterByType(UserType.Doctor)">
                                Doctors
                            </button>
                            <button type="button"
                                    class="btn @(filterByType == UserType.Admin ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => SetFilterByType(UserType.Admin)">
                                Admins
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body p-2 p-md-3">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading users...</p>
                        </div>
                    }
                    else if (!users.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-users fa-3x text-muted mb-3"></i>
                            <h5>No users found</h5>
                            <p class="text-muted">@(string.IsNullOrEmpty(searchTerm) ? "No users in the system" : "Try adjusting your search")</p>
                            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/admin/users/create")'>
                                <i class="fas fa-plus me-2"></i> Add First User
                            </button>
                        </div>
                    }
                    else
                    {
                        <!-- Mobile Cards View -->
                        <div class="d-block d-md-none">
                            @foreach (var user in users)
                            {
                                <div class="card mb-3 @(user.IsActive ? "" : "bg-light")">
                                    <div class="card-body p-3">
                                        <!-- User Header -->
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="me-2">
                                                @if (!string.IsNullOrEmpty(user.ProfileImageUrl))
                                                {
                                                    <img src="@GetUserImageUrl(user)"
                                                         class="rounded-circle"
                                                         width="40"
                                                         height="40"
                                                         alt="@user.FirstName"
                                                         style="object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                                         style="width: 40px; height: 40px; font-size: 16px;">
                                                        @GetUserInitials(user)
                                                    </div>
                                                }
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-0">@user.FirstName @user.LastName</h6>
                                                <small class="text-muted">ID: @user.Id</small>
                                            </div>
                                            <div>
                                                <span class="badge @GetUserTypeBadge(user.UserType)">
                                                    @GetUserTypeLabel(user.UserType)
                                                </span>
                                            </div>
                                        </div>

                                        <!-- User Details -->
                                        <div class="row g-2 mb-2">
                                            <div class="col-6">
                                                <small class="text-muted d-block">Email</small>
                                                <small>@user.Email</small>
                                            </div>
                                            <div class="col-6">
                                                <small class="text-muted d-block">Status</small>
                                                <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                                    @(user.IsActive ? "Active" : "Inactive")
                                                </span>
                                                @if (user.Id == currentUserId)
                                                {
                                                    <small class="text-muted d-block">(You)</small>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                            {
                                                <div class="col-6">
                                                    <small class="text-muted d-block">Phone</small>
                                                    <small>@user.PhoneNumber</small>
                                                </div>
                                            }
                                            <div class="col-6">
                                                <small class="text-muted d-block">Joined</small>
                                                <small>@user.CreatedAt.ToString("MMM dd, yyyy")</small>
                                            </div>
                                            @if (user.UserType == UserType.Doctor && user.Profile != null)
                                            {
                                                <div class="col-12">
                                                    <small class="text-muted d-block">Rating & Students</small>
                                                    <small>
                                                        <i class="fas fa-star text-warning me-1"></i>
                                                        @user.Profile.RatingAverage.ToString("0.0")
                                                        <i class="fas fa-users ms-2 me-1"></i>
                                                        @user.Profile.TotalStudents
                                                    </small>
                                                </div>
                                            }
                                        </div>

                                        <!-- Actions -->
                                        <div class="d-flex gap-2 mt-3 pt-2 border-top">
                                            <button class="btn btn-sm btn-outline-info flex-fill"
                                                    @onclick="() => ViewUserDetails(user.Id)"
                                                    title="View Details">
                                                <i class="fas fa-eye"></i>
                                                <span class="ms-1 d-none d-sm-inline">View</span>
                                            </button>
                                            <button class="btn btn-sm btn-outline-primary flex-fill"
                                                    @onclick="() => EditUser(user.Id)"
                                                    title="Edit"
                                                    disabled="@(user.UserType == UserType.Admin && user.Id != currentUserId)">
                                                <i class="fas fa-edit"></i>
                                                <span class="ms-1 d-none d-sm-inline">Edit</span>
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning flex-fill"
                                                    @onclick='async () => await ToggleUserStatus(user.Id, !user.IsActive)'
                                                    title="@(user.IsActive ? "Deactivate" : "Activate")">
                                                <i class="fas @(user.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                                <span class="ms-1 d-none d-sm-inline">@(user.IsActive ? "Deactivate" : "Activate")</span>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger flex-fill"
                                                    @onclick='async () => await ConfirmDelete(user.Id, $"{user.FirstName} {user.LastName}")'
                                                    title="Delete"
                                                    disabled="@(user.UserType == UserType.Admin || user.Id == currentUserId)">
                                                <i class="fas fa-trash"></i>
                                                <span class="ms-1 d-none d-sm-inline">Delete</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Desktop Table View -->
                        <div class="d-none d-md-block">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>User</th>
                                            <th>Email</th>
                                            <th>Type</th>
                                            <th>Joined</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in users)
                                        {
                                            <tr class="@(user.IsActive ? "" : "table-secondary")">
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="me-3">
                                                            @if (!string.IsNullOrEmpty(user.ProfileImageUrl))
                                                            {
                                                                <img src="@GetUserImageUrl(user)"
                                                                     class="rounded-circle"
                                                                     width="40"
                                                                     height="40"
                                                                     alt="@user.FirstName"
                                                                     style="object-fit: cover;" />
                                                            }
                                                            else
                                                            {
                                                                <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                                                     style="width: 40px; height: 40px; font-size: 16px;">
                                                                    @GetUserInitials(user)
                                                                </div>
                                                            }
                                                        </div>
                                                        <div>
                                                            <h6 class="mb-0">@user.FirstName @user.LastName</h6>
                                                            <small class="text-muted">
                                                                ID: @user.Id
                                                                @if (user.Profile?.Title != null)
                                                                {
                                                                    <span> • @user.Profile.Title</span>
                                                                }
                                                            </small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-column">
                                                        <a href="mailto:@user.Email" class="text-decoration-none">@user.Email</a>
                                                        @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                                        {
                                                            <small class="text-muted">@user.PhoneNumber</small>
                                                        }
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge @GetUserTypeBadge(user.UserType)">
                                                        @GetUserTypeLabel(user.UserType)
                                                    </span>
                                                    @if (user.UserType == UserType.Doctor && user.Profile != null)
                                                    {
                                                        <div class="mt-1">
                                                            <small class="text-muted d-block">
                                                                <i class="fas fa-star text-warning me-1"></i>
                                                                @user.Profile.RatingAverage.ToString("0.0")
                                                            </small>
                                                            <small class="text-muted">
                                                                <i class="fas fa-users me-1"></i>
                                                                @user.Profile.TotalStudents
                                                            </small>
                                                        </div>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-column">
                                                        <small>@user.CreatedAt.ToString("MMM dd, yyyy")</small>
                                                        <small class="text-muted">@user.CreatedAt.ToString("hh:mm tt")</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <span class="badge @(user.IsActive ? "bg-success" : "bg-danger") me-2">
                                                            @(user.IsActive ? "Active" : "Inactive")
                                                        </span>
                                                        @if (user.Id == currentUserId)
                                                        {
                                                            <small class="text-muted">(You)</small>
                                                        }
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <button class="btn btn-outline-info"
                                                                @onclick="() => ViewUserDetails(user.Id)"
                                                                title="View Details">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                        <button class="btn btn-outline-primary"
                                                                @onclick="() => EditUser(user.Id)"
                                                                title="Edit"
                                                                disabled="@(user.UserType == UserType.Admin && user.Id != currentUserId)">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button class="btn btn-outline-warning"
                                                                @onclick='async () => await ToggleUserStatus(user.Id, !user.IsActive)'
                                                                title="@(user.IsActive ? "Deactivate" : "Activate")">
                                                            <i class="fas @(user.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger"
                                                                @onclick='async () => await ConfirmDelete(user.Id, $"{user.FirstName} {user.LastName}")'
                                                                title="Delete"
                                                                disabled="@(user.UserType == UserType.Admin || user.Id == currentUserId)">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination - Responsive -->
                        @if (totalPages > 1)
                        {
                            <nav aria-label="Page navigation" class="mt-4">
                                <ul class="pagination justify-content-center flex-wrap">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">
                                            <i class="fas fa-chevron-left d-md-none"></i>
                                            <span class="d-none d-md-inline">Previous</span>
                                        </button>
                                    </li>

                                    <!-- Mobile: Show limited pages -->
                                    @{
                                        var startPage = Math.Max(1, currentPage - 2);
                                        var endPage = Math.Min(totalPages, currentPage + 2);

                                        if (startPage > 1)
                                        {
                                            <li class="page-item d-none d-md-block">
                                                <button class="page-link" @onclick="() => ChangePage(1)">1</button>
                                            </li>
                                            if (startPage > 2)
                                            {
                                                <li class="page-item disabled d-none d-md-block">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                        }

                                        @for (int i = startPage; i <= endPage; i++)
                                        {
                                            <li class="page-item @(i == currentPage ? "active" : "")">
                                                <button class="page-link" @onclick="() => ChangePage(i)">
                                                    @i
                                                </button>
                                            </li>
                                        }

                                        if (endPage < totalPages)
                                        {
                                            if (endPage < totalPages - 1)
                                            {
                                                <li class="page-item disabled d-none d-md-block">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                            <li class="page-item d-none d-md-block">
                                                <button class="page-link" @onclick="() => ChangePage(totalPages)">@totalPages</button>
                                            </li>
                                        }
                                    }

                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">
                                            <i class="fas fa-chevron-right d-md-none"></i>
                                            <span class="d-none d-md-inline">Next</span>
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    .avatar-placeholder {
        font-weight: 600;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        text-transform: uppercase;
    }

    .stat-card {
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .avatar-sm {
        width: 35px;
        height: 35px;
    }

        .avatar-sm i {
            font-size: 1rem;
        }

    @@media (min-width: 768px) {
        .avatar-sm {
            width: 45px;
            height: 45px;
        }

            .avatar-sm i {
                font-size: 1.25rem;
            }
    }

    .rotate-180 {
        transform: rotate(180deg);
        transition: transform 0.3s;
    }

    /* Custom scrollbar for horizontal filter on mobile */
    .overflow-auto::-webkit-scrollbar {
        height: 3px;
    }

    .overflow-auto::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .overflow-auto::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

        .overflow-auto::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

    /* Mobile card styles */
    @@media (max-width: 767px) {
        .btn-group-sm .btn {
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
        }

        .card-body {
            padding: 0.75rem;
        }
    }
</style>

@code {
    private List<UserDto> users = new();
    private string searchTerm = "";
    private UserType? filterByType = null;
    private string selectedStatus = "";
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private bool isAdmin = false;
    private int currentUserId = 0;
    private UserDto? currentUser = null;
    private bool showMobileFilters = false;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalUsersCount = 0;
    private int totalPages = 1;

    // Stats
    private int regularUsersCount = 0;
    private int doctorsCount = 0;
    private int adminsCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();

        if (isAuthenticated)
        {
            await LoadCurrentUser();
            await LoadUsers();
            await LoadStats();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();
                if (currentUser != null)
                {
                    currentUserId = currentUser.Id;
                    isAdmin = currentUser.UserType == UserType.Admin;

                    if (!isAdmin)
                    {
                        Navigation.NavigateTo("/");
                    }
                }
                else
                {
                    isAuthenticated = false;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            isAdmin = false;
        }
    }

    private async Task LoadCurrentUser()
    {
        if (currentUser == null)
        {
            currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser != null)
            {
                currentUserId = currentUser.Id;
                isAdmin = currentUser.UserType == UserType.Admin;
            }
        }
    }

    private async Task LoadUsers()
    {
        if (!isAuthenticated || !isAdmin) return;

        isLoading = true;
        StateHasChanged();

        try
        {
            bool? isActive = null;
            if (!string.IsNullOrEmpty(selectedStatus))
            {
                isActive = bool.Parse(selectedStatus);
            }

            users = await UserService.GetUsersAsync(
                search: searchTerm,
                userType: filterByType,
                isActive: isActive,
                page: currentPage,
                pageSize: pageSize
            ) ?? new List<UserDto>();

            // Get total count for pagination
            totalUsersCount = await UserService.GetUsersCountAsync(
                userType: filterByType,
                isActive: isActive
            );

            totalPages = (int)Math.Ceiling(totalUsersCount / (double)pageSize);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading users: {ex.Message}");
            await ShowToast("error", "Error loading users");
            users = new List<UserDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadStats()
    {
        try
        {
            // Get all users and count them locally
            var allUsers = await UserService.GetUsersAsync(page: 1, pageSize: int.MaxValue) ?? new List<UserDto>();

            regularUsersCount = allUsers.Count(u => u.UserType == UserType.User);
            doctorsCount = allUsers.Count(u => u.UserType == UserType.Doctor);
            adminsCount = allUsers.Count(u => u.UserType == UserType.Admin);
            totalUsersCount = allUsers.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stats: {ex.Message}");
        }
    }

    private string GetUserImageUrl(UserDto user)
    {
        if (!string.IsNullOrEmpty(user.ProfileImageUrl))
        {
            return ImageUrlService.GetImageUrl(user.ProfileImageUrl);
        }

        // Return a default avatar image
        return "/images/default-avatar.png";
    }

    private string GetUserInitials(UserDto user)
    {
        var first = user.FirstName?.Length > 0 ? user.FirstName[0] : 'U';
        var last = user.LastName?.Length > 0 ? user.LastName[0] : 'S';
        return $"{first}{last}";
    }

    private async Task HandleSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchUsers();
        }
    }

    private async Task SearchUsers()
    {
        currentPage = 1;
        await LoadUsers();
    }

    private async Task SetFilterByType(UserType? type)
    {
        filterByType = type;
        currentPage = 1;
        await LoadUsers();
        await LoadStats();
    }

    private async Task ClearFilters()
    {
        searchTerm = "";
        filterByType = null;
        selectedStatus = "";
        currentPage = 1;
        showMobileFilters = false;
        await LoadUsers();
        await LoadStats();
        await ShowToast("success", "Filters cleared");
    }

    private async Task RefreshUsers()
    {
        await LoadUsers();
        await LoadStats();
        await ShowToast("success", "Users refreshed");
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;

        currentPage = page;
        await LoadUsers();

        // Scroll to top on mobile
        if (page != currentPage)
        {
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
    }

    private void toggleMobileFilters()
    {
        showMobileFilters = !showMobileFilters;
    }

    private async Task ToggleUserStatus(int userId, bool newStatus)
    {
        var user = users.FirstOrDefault(u => u.Id == userId);
        if (user == null) return;

        if (user.UserType == UserType.Admin && userId != currentUserId)
        {
            await ShowToast("error", "You cannot modify admin accounts");
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to {(newStatus ? "activate" : "deactivate")} user '{user.FirstName} {user.LastName}'?");

        if (confirmed)
        {
            try
            {
                var success = await UserService.ToggleUserStatusAsync(userId, newStatus);

                if (success)
                {
                    user.IsActive = newStatus;
                    await ShowToast("success", $"User {(newStatus ? "activated" : "deactivated")} successfully");
                    StateHasChanged();
                }
                else
                {
                    await ShowToast("error", "Failed to update user status");
                }
            }
            catch (Exception ex)
            {
                await ShowToast("error", ex.Message);
            }
        }
    }

    private async Task ConfirmDelete(int userId, string userName)
    {
        if (userId == currentUserId)
        {
            await ShowToast("error", "You cannot delete your own account");
            return;
        }

        var user = users.FirstOrDefault(u => u.Id == userId);
        if (user == null) return;

        if (user.UserType == UserType.Admin)
        {
            await ShowToast("error", "You cannot delete admin accounts");
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete user '{userName}'? This action cannot be undone.");

        if (confirmed)
        {
            try
            {
                var success = await UserService.DeleteUserAsync(userId);

                if (success)
                {
                    users.RemoveAll(u => u.Id == userId);
                    totalUsersCount--;
                    totalPages = (int)Math.Ceiling(totalUsersCount / (double)pageSize);

                    await ShowToast("success", "User deleted successfully");
                    await LoadStats();
                    StateHasChanged();
                }
                else
                {
                    await ShowToast("error", "Failed to delete user");
                }
            }
            catch (Exception ex)
            {
                await ShowToast("error", ex.Message);
            }
        }
    }

    private string GetUserTypeBadge(UserType userType)
    {
        return userType switch
        {
            UserType.Admin => "bg-danger",
            UserType.Doctor => "bg-info",
            UserType.User => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetUserTypeLabel(UserType userType)
    {
        return userType switch
        {
            UserType.Admin => "Admin",
            UserType.Doctor => "Doctor",
            UserType.User => "User",
            _ => "Unknown"
        };
    }

