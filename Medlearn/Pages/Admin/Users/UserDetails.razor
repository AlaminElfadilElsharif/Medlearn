    // Filter methods for mobile
    private void HandleEnrollmentFilterMobile(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrEmpty(value))
        {
            ClearEnrollmentFilter();
        }
        else if (value == "inprogress")
        {
            FilterEnrollments(false);
        }
        else if (value == "completed")
        {
            FilterEnrollments(true);
        }
    }

    private void HandlePaymentFilterMobile(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrEmpty(value))
        {
            ClearPaymentFilter();
        }
        else
        {
            FilterPayments((PaymentStatus)Enum.Parse(typeof(PaymentStatus), value, true));
        }
    }

    private void HandleReviewFilterMobile(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrEmpty(value))
        {
            ClearReviewFilter();
        }
        else
        {
            FilterReviews(int.Parse(value));
        }
    }

    // Desktop filter methods
    private void FilterEnrollments(bool? completed)
    {
        enrollmentFilter = completed;

        if (!completed.HasValue)
        {
            filteredEnrollments = userEnrollments;
        }
        else
        {
            filteredEnrollments = userEnrollments
                .Where(e => e.IsCompleted == completed.Value)
                .ToList();
        }

        StateHasChanged();
    }

    private void ClearEnrollmentFilter()
    {
        enrollmentFilter = null;
        filteredEnrollments = userEnrollments;
        StateHasChanged();
    }

    private void FilterPayments(PaymentStatus? status)
    {
        paymentFilter = status;

        if (!status.HasValue)
        {
            filteredPayments = paymentRequests;
        }
        else
        {
            filteredPayments = paymentRequests
                .Where(p => p.Status == status.Value)
                .ToList();
        }

        StateHasChanged();
    }

    private void ClearPaymentFilter()
    {
        paymentFilter = null;
        filteredPayments = paymentRequests;
        StateHasChanged();
    }

    private void FilterReviews(int? minRating)
    {
        reviewFilter = minRating;

        if (!minRating.HasValue)
        {
            filteredReviews = userReviews;
        }
        else if (minRating == 1)
        {
            filteredReviews = userReviews
                .Where(r => r.Rating <= 2)
                .ToList();
        }
        else if (minRating == 3)
        {
            filteredReviews = userReviews
                .Where(r => r.Rating == 3)
                .ToList();
        }
        else if (minRating == 4)
        {
            filteredReviews = userReviews
                .Where(r => r.Rating >= 4)
                .ToList();
        }

        StateHasChanged();
    }

    private void ClearReviewFilter()
    {
        reviewFilter = null;
        filteredReviews = userReviews;
        StateHasChanged();
    }

    // Action methods
    private async Task ToggleUserStatus()
    {
        if (user == null) return;

        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to {(user.IsActive ? "deactivate" : "activate")} user '{user.FirstName}'?");

        if (confirmed)
        {
            try
            {
                var success = await UserService.ToggleUserStatusAsync(user.Id, !user.IsActive);

                if (success)
                {
                    user.IsActive = !user.IsActive;
                    await ShowToast("success",
                        $"User {(user.IsActive ? "activated" : "deactivated")} successfully");
                    StateHasChanged();
                }
                else
                {
                    await ShowToast("error", "Failed to update user status");
                }
            }
            catch (Exception ex)
            {
                await ShowToast("error", ex.Message);
            }
        }
    }

    private async Task ConfirmDelete()
    {
        if (user == null || user.UserType == UserType.Admin) return;

        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete user '{user.FirstName}'? This action cannot be undone.");

        if (confirmed)
        {
            try
            {
                var success = await UserService.DeleteUserAsync(user.Id);

                if (success)
                {
                    await ShowToast("success", "User deleted successfully");
                    Navigation.NavigateTo("/admin/users");
                }
                else
                {
                    await ShowToast("error", "Failed to delete user");
                }
            }
            catch (Exception ex)
            {
                await ShowToast("error", ex.Message);
            }
        }
    }

