    private async Task ProcessPayment(int paymentId, PaymentStatus status)
    {
        try
        {
            var updateDto = new UpdatePaymentRequestDto
            {
                Status = status
            };

            if (status == PaymentStatus.Rejected)
            {
                var reason = await JS.InvokeAsync<string>("prompt", "Enter rejection reason:");
                if (!string.IsNullOrEmpty(reason))
                {
                    updateDto.RejectionReason = reason;
                }
            }

            await PaymentService.UpdatePaymentStatusAsync(paymentId, updateDto);
            await ShowToast("success", $"Payment {status.ToString().ToLower()} successfully");
            await LoadUserData();
        }
        catch (Exception ex)
        {
            await ShowToast("error", ex.Message);
        }
    }

