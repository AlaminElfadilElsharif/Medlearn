@page "/admin/users/create"


<PageTitle>Create User</PageTitle>

<div class="user-create">
    <div class="container-fluid px-0 px-md-3">
        <!-- Responsive Header -->
        <div class="row g-0 mb-3 mb-md-4">
            <div class="col-12">
                <!-- Mobile Header -->
                <div class="d-block d-md-none">
                    <div class="bg-primary text-white p-3">
                        <div class="d-flex align-items-center">
                            <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                                <i class="fas fa-arrow-left fa-lg"></i>
                            </button>
                            <h5 class="mb-0 flex-grow-1">Create User</h5>
                            <button class="btn btn-link text-white p-0" @onclick="ResetForm">
                                <i class="fas fa-redo fa-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Desktop Header -->
                <div class="d-none d-md-flex justify-content-between align-items-center">
                    <div>
                        <h1>Create New User</h1>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/admin">Admin</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="/admin/users">Users</a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">Create</li>
                            </ol>
                        </nav>
                    </div>
                    <div>
                        <button class="btn btn-outline-secondary" @onclick="GoBack">
                            <i class="fas fa-arrow-left me-2"></i> Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Authentication Check -->
        @if (!isAuthenticated)
        {
            <div class="alert alert-warning mx-2 mx-md-0">
                <i class="fas fa-exclamation-triangle me-2"></i>
                You must be logged in as an administrator to create users.
                <a href="/login" class="alert-link">Login here</a>
            </div>
        }
        else if (!isAdmin)
        {
            <div class="alert alert-danger mx-2 mx-md-0">
                <i class="fas fa-ban me-2"></i>
                Access denied. Only administrators can create users.
            </div>
        }
        else
        {
            <div class="row justify-content-center g-0 g-md-3">
                <div class="col-12 col-lg-8">
                    <div class="card border-0 border-md">
                        <div class="card-header bg-transparent d-none d-md-block">
                            <h5 class="mb-0">User Information</h5>
                        </div>
                        <div class="card-body p-3 p-md-4">
                            <EditForm Model="@createUserDto" OnValidSubmit="@HandleValidSubmit">
                                <DataAnnotationsValidator />

                                <!-- Validation Summary - Mobile Optimized -->
                                @if (validationErrors.Any())
                                {
                                    <div class="alert alert-danger alert-dismissible fade show d-md-none" role="alert">
                                        <i class="fas fa-exclamation-circle me-2"></i>
                                        <strong>Please fix the following errors:</strong>
                                        <ul class="mb-0 mt-2 ps-3">
                                            @foreach (var error in validationErrors)
                                            {
                                                <li>@error.Value</li>
                                            }
                                        </ul>
                                        <button type="button" class="btn-close" @onclick="ClearAllValidation"></button>
                                    </div>
                                }

                                <ValidationSummary class="alert alert-danger d-none d-md-block" />

                                <!-- Mobile View -->
                                <div class="d-block d-md-none">
                                    <!-- Progress Indicator -->
                                    <div class="mb-4">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="small">Personal Info</span>
                                            <span class="small">Account Setup</span>
                                        </div>
                                        <div class="progress" style="height: 4px;">
                                            <div class="progress-bar" role="progressbar" style="width: 50%;"></div>
                                        </div>
                                    </div>

                                    <!-- Personal Information Section -->
                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-3">
                                            <i class="fas fa-user-circle me-2 text-primary"></i>Personal Information
                                        </h6>

                                        <div class="vstack gap-3">
                                            <!-- First Name -->
                                            <div class="form-floating">
                                                <InputText id="mobile-firstName" @bind-Value="createUserDto.FirstName"
                                                           class="@($"form-control {GetValidationClass("FirstName")}")"
                                                           placeholder="First Name" />
                                                <label for="mobile-firstName">First Name *</label>
                                                @if (HasValidationError("FirstName"))
                                                {
                                                    <div class="invalid-feedback d-block small">
                                                        @GetValidationError("FirstName")
                                                    </div>
                                                }
                                            </div>

                                            <!-- Last Name -->
                                            <div class="form-floating">
                                                <InputText id="mobile-lastName" @bind-Value="createUserDto.LastName"
                                                           class="@($"form-control {GetValidationClass("LastName")}")"
                                                           placeholder="Last Name" />
                                                <label for="mobile-lastName">Last Name *</label>
                                                @if (HasValidationError("LastName"))
                                                {
                                                    <div class="invalid-feedback d-block small">
                                                        @GetValidationError("LastName")
                                                    </div>
                                                }
                                            </div>

                                            <!-- Email -->
                                            <div class="form-floating">
                                                <InputText id="mobile-email" @bind-Value="createUserDto.Email"
                                                           class="@($"form-control {GetValidationClass("Email")}")"
                                                           placeholder="Email Address"
                                                           type="email" />
                                                <label for="mobile-email">Email Address *</label>
                                                @if (HasValidationError("Email"))
                                                {
                                                    <div class="invalid-feedback d-block small">
                                                        @GetValidationError("Email")
                                                    </div>
                                                }
                                            </div>

                                            <!-- Phone Number -->
                                            <div class="form-floating">
                                                <InputText id="mobile-phoneNumber" @bind-Value="createUserDto.PhoneNumber"
                                                           class="@($"form-control {GetValidationClass("PhoneNumber")}")"
                                                           placeholder="Phone Number"
                                                           type="tel" />
                                                <label for="mobile-phoneNumber">Phone Number</label>
                                                @if (HasValidationError("PhoneNumber"))
                                                {
                                                    <div class="invalid-feedback d-block small">
                                                        @GetValidationError("PhoneNumber")
                                                    </div>
                                                }
                                            </div>

                                            <!-- Date of Birth -->
                                            <div class="form-floating">
                                                <InputDate id="mobile-dateOfBirth" @bind-Value="createUserDto.DateOfBirth"
                                                           class="@($"form-control {GetValidationClass("DateOfBirth")}")"
                                                           placeholder="Date of Birth" />
                                                <label for="mobile-dateOfBirth">Date of Birth</label>
                                                @if (HasValidationError("DateOfBirth"))
                                                {
                                                    <div class="invalid-feedback d-block small">
                                                        @GetValidationError("DateOfBirth")
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Account Settings Section -->
                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-3">
                                            <i class="fas fa-cog me-2 text-primary"></i>Account Settings
                                        </h6>

                                        <div class="vstack gap-3">
                                            <!-- Password -->
                                            <div class="form-floating">
                                                <InputText type="password" id="mobile-password"
                                                           @bind-Value="createUserDto.Password"
                                                           class="@($"form-control {GetValidationClass("Password")}")"
                                                           placeholder="Password" />
                                                <label for="mobile-password">Password *</label>
                                                @if (HasValidationError("Password"))
                                                {
                                                    <div class="invalid-feedback d-block small">
                                                        @GetValidationError("Password")
                                                    </div>
                                                }
                                                <div class="form-text small mt-1">
                                                    Min 8 chars with uppercase, lowercase & number
                                                </div>
                                            </div>

                                            <!-- Confirm Password -->
                                            <div class="form-floating">
                                                <input type="password" id="mobile-confirmPassword"
                                                       class="@($"form-control {(passwordMismatch ? "is-invalid" : "")}")"
                                                       @bind="confirmPassword"
                                                       placeholder="Confirm Password" />
                                                <label for="mobile-confirmPassword">Confirm Password *</label>
                                                @if (passwordMismatch)
                                                {
                                                    <div class="invalid-feedback d-block small">
                                                        Passwords do not match
                                                    </div>
                                                }
                                            </div>

                                            <!-- Password Strength Indicator (Mobile) -->
                                            @if (!string.IsNullOrEmpty(createUserDto.Password))
                                            {
                                                <div class="password-strength mb-2">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <small class="text-muted">Password Strength:</small>
                                                        <small class="@GetPasswordStrengthClass()">@GetPasswordStrengthText()</small>
                                                    </div>
                                                    <div class="progress" style="height: 4px;">
                                                        <div class="progress-bar @GetPasswordStrengthBarClass()"
                                                             role="progressbar"
                                                             style="width: @(GetPasswordStrengthPercentage())%"></div>
                                                    </div>
                                                </div>
                                            }

                                            <!-- User Type Selection (Mobile) -->
                                            <div class="mb-2">
                                                <label class="form-label small fw-bold">User Type *</label>
                                                <div class="btn-group w-100" role="group">
                                                    <input type="radio" class="btn-check" name="mobileUserType" id="mobile-type-user"
                                                           @onchange="() => SetUserType(0)" checked="@(selectedUserTypeInt == 0)">
                                                    <label class="btn btn-outline-primary" for="mobile-type-user">
                                                        <i class="fas fa-user me-1"></i>User
                                                    </label>

                                                    <input type="radio" class="btn-check" name="mobileUserType" id="mobile-type-doctor"
                                                           @onchange="() => SetUserType(1)" checked="@(selectedUserTypeInt == 1)">
                                                    <label class="btn btn-outline-info" for="mobile-type-doctor">
                                                        <i class="fas fa-user-md me-1"></i>Doctor
                                                    </label>

                                                    <input type="radio" class="btn-check" name="mobileUserType" id="mobile-type-admin"
                                                           @onchange="() => SetUserType(2)" checked="@(selectedUserTypeInt == 2)">
                                                    <label class="btn btn-outline-success" for="mobile-type-admin">
                                                        <i class="fas fa-user-shield me-1"></i>Admin
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Bio Section -->
                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-3">
                                            <i class="fas fa-align-left me-2 text-primary"></i>Additional Information
                                        </h6>

                                        <div class="form-floating">
                                            <InputTextArea id="mobile-bio" @bind-Value="createUserDto.Bio"
                                                           class="@($"form-control {GetValidationClass("Bio")}")"
                                                           placeholder="Bio"
                                                           style="height: 100px" />
                                            <label for="mobile-bio">Bio (Optional)</label>
                                            @if (HasValidationError("Bio"))
                                            {
                                                <div class="invalid-feedback d-block small">
                                                    @GetValidationError("Bio")
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Info Note -->
                                    <div class="alert alert-info small mb-4">
                                        <i class="fas fa-info-circle me-2"></i>
                                        Profile information can be updated by the user after account creation.
                                    </div>

                                    <!-- Mobile Action Buttons (Fixed Bottom) -->
                                    <div class="fixed-bottom d-block d-md-none p-3 bg-white border-top">
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-outline-secondary flex-fill" @onclick="GoBack">
                                                Cancel
                                            </button>
                                            <button type="submit" class="btn btn-primary flex-fill" disabled="@isSubmitting">
                                                @if (isSubmitting)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-user-plus me-1"></i>
                                                }
                                                Create
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Spacer for mobile fixed button -->
                                    <div class="mb-5 pb-3 d-block d-md-none"></div>
                                </div>

                                <!-- Desktop View -->
                                <div class="d-none d-md-block">
                                    <div class="row g-3">
                                        <!-- Personal Information -->
                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <InputText id="firstName" @bind-Value="createUserDto.FirstName"
                                                           class="@($"form-control {GetValidationClass("FirstName")}")"
                                                           placeholder="First Name" />
                                                <label for="firstName">First Name *</label>
                                                <ValidationMessage For="@(() => createUserDto.FirstName)" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <InputText id="lastName" @bind-Value="createUserDto.LastName"
                                                           class="@($"form-control {GetValidationClass("LastName")}")"
                                                           placeholder="Last Name" />
                                                <label for="lastName">Last Name *</label>
                                                <ValidationMessage For="@(() => createUserDto.LastName)" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <InputText id="email" @bind-Value="createUserDto.Email"
                                                           class="@($"form-control {GetValidationClass("Email")}")"
                                                           placeholder="Email Address"
                                                           type="email" />
                                                <label for="email">Email Address *</label>
                                                <ValidationMessage For="@(() => createUserDto.Email)" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <InputText id="phoneNumber" @bind-Value="createUserDto.PhoneNumber"
                                                           class="@($"form-control {GetValidationClass("PhoneNumber")}")"
                                                           placeholder="Phone Number"
                                                           type="tel" />
                                                <label for="phoneNumber">Phone Number</label>
                                                <ValidationMessage For="@(() => createUserDto.PhoneNumber)" />
                                            </div>
                                        </div>

                                        <!-- Password -->
                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <InputText type="password" id="password" @bind-Value="createUserDto.Password"
                                                           class="@($"form-control {GetValidationClass("Password")}")"
                                                           placeholder="Password" />
                                                <label for="password">Password *</label>
                                                <ValidationMessage For="@(() => createUserDto.Password)" />
                                                <div class="form-text">
                                                    Minimum 8 characters with uppercase, lowercase, and number
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <input type="password" id="confirmPassword"
                                                       class="@($"form-control {(passwordMismatch ? "is-invalid" : "")}")"
                                                       @bind="confirmPassword"
                                                       placeholder="Confirm Password" />
                                                <label for="confirmPassword">Confirm Password *</label>
                                                @if (passwordMismatch)
                                                {
                                                    <div class="invalid-feedback">
                                                        Passwords do not match
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <!-- Password Strength Indicator (Desktop) -->
                                        @if (!string.IsNullOrEmpty(createUserDto.Password))
                                        {
                                            <div class="col-12">
                                                <div class="password-strength mb-2">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <small class="text-muted">Password Strength:</small>
                                                        <small class="@GetPasswordStrengthClass()">@GetPasswordStrengthText()</small>
                                                    </div>
                                                    <div class="progress" style="height: 4px;">
                                                        <div class="progress-bar @GetPasswordStrengthBarClass()"
                                                             role="progressbar"
                                                             style="width: @(GetPasswordStrengthPercentage())%"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <!-- User Type -->
                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <InputSelect id="userType" @bind-Value="selectedUserTypeInt" class="form-control">
                                                    <option value="0">Regular User</option>
                                                    <option value="1">Doctor</option>
                                                    <option value="2">Admin</option>
                                                </InputSelect>
                                                <label for="userType">User Type *</label>
                                                <ValidationMessage For="@(() => createUserDto.UserType)" />
                                            </div>
                                        </div>

                                        <!-- Date of Birth -->
                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <InputDate id="dateOfBirth" @bind-Value="createUserDto.DateOfBirth"
                                                           class="@($"form-control {GetValidationClass("DateOfBirth")}")"
                                                           placeholder="Date of Birth" />
                                                <label for="dateOfBirth">Date of Birth</label>
                                                <ValidationMessage For="@(() => createUserDto.DateOfBirth)" />
                                            </div>
                                        </div>

                                        <!-- Bio -->
                                        <div class="col-12">
                                            <div class="form-floating mb-3">
                                                <InputTextArea id="bio" @bind-Value="createUserDto.Bio"
                                                               class="@($"form-control {GetValidationClass("Bio")}")"
                                                               placeholder="Bio"
                                                               style="height: 100px" />
                                                <label for="bio">Bio</label>
                                                <ValidationMessage For="@(() => createUserDto.Bio)" />
                                            </div>
                                        </div>

                                        <!-- Note about profile information -->
                                        <div class="col-12">
                                            <div class="alert alert-info">
                                                <i class="fas fa-info-circle me-2"></i>
                                                Profile information can be set by the user after account creation.
                                            </div>
                                        </div>

                                        <!-- Desktop Action Buttons -->
                                        <div class="col-12">
                                            <div class="d-flex justify-content-between">
                                                <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">
                                                    <i class="fas fa-redo me-2"></i> Reset
                                                </button>
                                                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                                    @if (isSubmitting)
                                                    {
                                                        <span>
                                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                            Creating...
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>
                                                            <i class="fas fa-user-plus me-2"></i>
                                                            Create User
                                                        </span>
                                                    }
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private CreateUserDto createUserDto = new();
    private string confirmPassword = "";
    private int selectedUserTypeInt = 0;
    private bool isSubmitting = false;
    private bool isAuthenticated = false;
    private bool isAdmin = false;
    private UserDto? currentUser = null;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();
    private bool passwordMismatch => !string.IsNullOrEmpty(confirmPassword) && createUserDto.Password != confirmPassword;

    protected override async Task OnInitializedAsync()
    {
        // Initialize with default values
        createUserDto.UserType = UserType.User;
        selectedUserTypeInt = 0;

        // Check authentication using TokenService
        await CheckAuthentication();

        // Load current user if authenticated
        if (isAuthenticated)
        {
            await LoadCurrentUser();
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();
            Console.WriteLine($"IsAuthenticated: {isAuthenticated}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
        }
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            currentUser = await AuthService.GetCurrentUserAsync();
            Console.WriteLine($"Current User: {currentUser?.Email}, Type: {currentUser?.UserType}");

            if (currentUser != null)
            {
                isAdmin = currentUser.UserType == UserType.Admin;
                Console.WriteLine($"Is Admin: {isAdmin}");
            }
            else
            {
                isAdmin = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading current user: {ex.Message}");
            currentUser = null;
            isAdmin = false;
        }
    }

    private void SetUserType(int userTypeInt)
    {
        selectedUserTypeInt = userTypeInt;
        createUserDto.UserType = (UserType)userTypeInt;
    }

    private async Task HandleValidSubmit()
    {
        // Clear previous validation errors
        validationErrors.Clear();

        // Check authentication again before submitting
        await CheckAuthentication();

        if (!isAuthenticated)
        {
            await ShowToast("error", "You must be logged in to create users");
            Navigation.NavigateTo("/login");
            return;
        }

        if (!isAdmin)
        {
            await ShowToast("error", "Only administrators can create users");
            return;
        }

        // Validate passwords match
        if (createUserDto.Password != confirmPassword)
        {
            await ShowToast("error", "Passwords do not match");
            return;
        }

        // Validate password strength
        if (createUserDto.Password.Length < 8)
        {
            await ShowToast("error", "Password must be at least 8 characters long");
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        try
        {
            Console.WriteLine($"Attempting to create user: {createUserDto.Email}, Type: {createUserDto.UserType}");

            var user = await AuthService.RegisterAsync(createUserDto);

            if (user != null)
            {
                await ShowToast("success", "User created successfully");
                Console.WriteLine($"User created: {user.Email}");
                Navigation.NavigateTo("/admin/users");
            }
            else
            {
                await ShowToast("error", "Failed to create user. Please try again.");
                Console.WriteLine("User creation returned null");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating user: {ex.Message}\n{ex.StackTrace}");

            var errorMessage = "An error occurred while creating the user. Please try again.";

            if (ex.Message.Contains("already exists", StringComparison.OrdinalIgnoreCase))
            {
                errorMessage = "Email address is already registered.";
                validationErrors["Email"] = errorMessage;
            }
            else if (ex.Message.Contains("unauthorized", StringComparison.OrdinalIgnoreCase) ||
                     ex.Message.Contains("forbidden", StringComparison.OrdinalIgnoreCase))
            {
                errorMessage = "You don't have permission to perform this action.";
                Navigation.NavigateTo("/admin");
            }
            else if (ex.Message.Contains("400") || ex.Message.Contains("bad request", StringComparison.OrdinalIgnoreCase))
            {
                errorMessage = "Invalid data provided. Please check all fields.";
            }

            await ShowToast("error", errorMessage);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    // Password strength methods
    private string GetPasswordStrengthText()
    {
        var score = CalculatePasswordStrength();
        return score switch
        {
            <= 1 => "Weak",
            <= 2 => "Fair",
            <= 3 => "Good",
            _ => "Strong"
        };
    }

    private string GetPasswordStrengthClass()
    {
        var score = CalculatePasswordStrength();
        return score switch
        {
            <= 1 => "text-danger",
            <= 2 => "text-warning",
            <= 3 => "text-info",
            _ => "text-success"
        };
    }

    private string GetPasswordStrengthBarClass()
    {
        var score = CalculatePasswordStrength();
        return score switch
        {
            <= 1 => "bg-danger",
            <= 2 => "bg-warning",
            <= 3 => "bg-info",
            _ => "bg-success"
        };
    }

    private int GetPasswordStrengthPercentage()
    {
        var score = CalculatePasswordStrength();
        return (score * 25);
    }

    private int CalculatePasswordStrength()
    {
        if (string.IsNullOrEmpty(createUserDto.Password))
            return 0;

        int score = 0;

        // Length check
        if (createUserDto.Password.Length >= 8) score++;
        if (createUserDto.Password.Length >= 12) score++;

        // Complexity checks
        if (createUserDto.Password.Any(char.IsUpper)) score++;
        if (createUserDto.Password.Any(char.IsLower)) score++;
        if (createUserDto.Password.Any(char.IsDigit)) score++;
        if (createUserDto.Password.Any(ch => !char.IsLetterOrDigit(ch))) score++;

        return Math.Min(4, score / 2);
    }

    private void ResetForm()
    {
        createUserDto = new CreateUserDto
        {
            UserType = UserType.User
        };
        confirmPassword = "";
        selectedUserTypeInt = 0;
        validationErrors.Clear();
        StateHasChanged();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/users");
    }

    private async Task ShowToast(string type, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", type, message);
        }
        catch
        {
            Console.WriteLine($"{type.ToUpper()}: {message}");
        }
    }

    // Validation helpers
    private bool HasValidationError(string fieldName)
    {
        return validationErrors.ContainsKey(fieldName);
    }

    private string GetValidationError(string fieldName)
    {
        return validationErrors.TryGetValue(fieldName, out var error) ? error : "";
    }

    private string GetValidationClass(string fieldName)
    {
        return HasValidationError(fieldName) ? "is-invalid" : "";
    }

    private void ClearAllValidation()
    {
        validationErrors.Clear();
    }
}