    private async Task ExportReport()
    {
        if (!enrollments.Any())
        {
            await ShowToast("warning", "No data to export");
            return;
        }

        isExporting = true;
        StateHasChanged();

        try
        {
            var csvContent = "Student,Email,Content Type,Item,Enrollment Date,Status,Progress,Revenue\n";

            foreach (var enrollment in enrollments)
            {
                csvContent += $"\"{enrollment.User?.FirstName} {enrollment.User?.LastName}\"," +
                              $"\"{enrollment.User?.Email}\"," +
                              $"{enrollment.EnrollmentType}," +
                              $"\"{GetEnrollmentItemName(enrollment)}\"," +
                              $"{enrollment.EnrollmentDate:yyyy-MM-dd}," +
                              $"{(enrollment.IsCompleted ? "Completed" : "Active")}," +
                              $"{enrollment.ProgressPercentage:F1}%," +
                              $"{enrollment.PricePaid:F2}\n";
            }

            // Add summary
            csvContent += $"\n\nSUMMARY\n";
            csvContent += $"Total Enrollments,{totalEnrollments}\n";
            csvContent += $"Completed Enrollments,{completedEnrollments}\n";
            csvContent += $"Active Enrollments,{activeEnrollments}\n";
            csvContent += $"Completion Rate,{completionRate:F1}%\n";
            csvContent += $"Total Revenue,${totalRevenue:F2}\n";
            csvContent += $"Period,{startDate:yyyy-MM-dd} to {endDate:yyyy-MM-dd}\n";
            csvContent += $"Generated By,{currentUser?.FirstName} {currentUser?.LastName}\n";
            csvContent += $"Generated At,{DateTime.Now:yyyy-MM-dd HH:mm:ss}\n";

            var fileName = $"Enrollment_Report_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            var bytes = System.Text.Encoding.UTF8.GetBytes(csvContent);
            var base64 = Convert.ToBase64String(bytes);

            await JS.InvokeVoidAsync("downloadFile", base64, fileName);
            await ShowToast("success", "Report exported successfully");
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Export failed: {ex.Message}");
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private async Task ShowToast(string type, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", type, message);
        }
        catch
        {
            Console.WriteLine($"[{type}] {message}");
        }
    }
