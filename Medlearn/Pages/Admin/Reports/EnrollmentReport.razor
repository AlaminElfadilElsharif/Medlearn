@page "/admin/reports/enrollment"


<PageTitle>Enrollment Report</PageTitle>

@if (!isAuthenticated || currentUser?.UserType != UserType.Admin)
{
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                        <h4>Access Denied</h4>
                        <p class="text-muted mb-4">You need to be logged in as an administrator to access this page.</p>
                        <a href="/account/login" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt me-2"></i> Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="enrollment-report">
        <div class="container-fluid px-0 px-md-3">
            <!-- Mobile Header -->
            <div class="d-block d-md-none mb-3">
                <div class="bg-primary text-white p-3">
                    <div class="d-flex align-items-center">
                        <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                            <i class="fas fa-arrow-left fa-lg"></i>
                        </button>
                        <h5 class="mb-0 flex-grow-1">Enrollment Analytics</h5>
                        <button class="btn btn-link text-white p-0 me-2" @onclick="ExportReport" disabled="@isExporting">
                            @if (isExporting)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="fas fa-file-export fa-lg"></i>
                            }
                        </button>
                        <button class="btn btn-link text-white p-0" @onclick="GoToRevenueReport">
                            <i class="fas fa-dollar-sign fa-lg"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Desktop Header -->
            <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
                <h1>Enrollment Analytics</h1>
                <div>
                    <button class="btn btn-outline-secondary me-2" @onclick="GoToRevenueReport">
                        <i class="fas fa-dollar-sign me-2"></i> Revenue Report
                    </button>
                    <button class="btn btn-primary" @onclick="ExportReport" disabled="@isExporting">
                        @if (isExporting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Exporting...</span>
                        }
                        else
                        {
                            <i class="fas fa-file-export me-2"></i>
                            <span>Export Report</span>
                        }
                    </button>
                </div>
            </div>

            <!-- Filters -->
            <div class="card mb-3 mb-md-4">
                <div class="card-body p-3 p-md-4">
                    <!-- Mobile Filters -->
                    <div class="d-block d-md-none">
                        <div class="accordion" id="filterAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse">
                                        <i class="fas fa-filter me-2"></i> Filter Report
                                    </button>
                                </h2>
                                <div id="filterCollapse" class="accordion-collapse collapse show">
                                    <div class="accordion-body p-3">
                                        <div class="mb-3">
                                            <label class="form-label small">Start Date</label>
                                            <input type="date" class="form-control form-control-sm" @bind="startDate" @bind:format="yyyy-MM-dd" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small">End Date</label>
                                            <input type="date" class="form-control form-control-sm" @bind="endDate" @bind:format="yyyy-MM-dd" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small">Content Type</label>
                                            <select class="form-select form-select-sm" @bind="contentTypeFilter">
                                                <option value="">All Types</option>
                                                <option value="specialization">Specializations</option>
                                                <option value="course">Courses</option>
                                                <option value="lecture">Lectures</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small">Status</label>
                                            <select class="form-select form-select-sm" @bind="statusFilter">
                                                <option value="">All Status</option>
                                                <option value="active">Active</option>
                                                <option value="completed">Completed</option>
                                            </select>
                                        </div>
                                        <button class="btn btn-primary w-100" @onclick="LoadReport" disabled="@isLoading">
                                            @if (isLoading)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                                <span>Loading...</span>
                                            }
                                            else
                                            {
                                                <i class="fas fa-sync-alt me-2"></i>
                                                <span>Generate Report</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Desktop Filters -->
                    <div class="d-none d-md-block">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Start Date</label>
                                <input type="date" class="form-control" @bind="startDate" @bind:format="yyyy-MM-dd" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">End Date</label>
                                <input type="date" class="form-control" @bind="endDate" @bind:format="yyyy-MM-dd" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Content Type</label>
                                <select class="form-select" @bind="contentTypeFilter">
                                    <option value="">All Types</option>
                                    <option value="specialization">Specializations</option>
                                    <option value="course">Courses</option>
                                    <option value="lecture">Lectures</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Status</label>
                                <select class="form-select" @bind="statusFilter">
                                    <option value="">All Status</option>
                                    <option value="active">Active</option>
                                    <option value="completed">Completed</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">&nbsp;</label>
                                <div class="d-grid">
                                    <button class="btn btn-primary" @onclick="LoadReport" disabled="@isLoading">
                                        @if (isLoading)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <span>Loading...</span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-sync-alt me-2"></i>
                                            <span>Generate</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading enrollment data...</p>
                </div>
            }
            else if (errorMessage != null)
            {
                <div class="alert alert-danger mx-2 mx-md-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    @errorMessage
                </div>
            }
            else if (!enrollments.Any())
            {
                <div class="alert alert-info mx-2 mx-md-0">
                    <i class="fas fa-info-circle me-2"></i>
                    No enrollment data found for the selected period
                </div>
            }
            else
            {
                <!-- Summary Cards -->
                <div class="row mb-4">
                    <div class="col-6 col-md-3 mb-3">
                        <div class="card metric-card h-100">
                            <div class="card-body text-center">
                                <div class="metric-icon">
                                    <i class="fas fa-users text-primary"></i>
                                </div>
                                <h2 class="mt-3">@totalEnrollments</h2>
                                <h6 class="text-muted">Total Enrollments</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <div class="card metric-card h-100">
                            <div class="card-body text-center">
                                <div class="metric-icon">
                                    <i class="fas fa-user-check text-success"></i>
                                </div>
                                <h2 class="mt-3">@completedEnrollments</h2>
                                <h6 class="text-muted">Completed</h6>
                                <small>@completionRate.ToString("0.0")%</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <div class="card metric-card h-100">
                            <div class="card-body text-center">
                                <div class="metric-icon">
                                    <i class="fas fa-clock text-warning"></i>
                                </div>
                                <h2 class="mt-3">@activeEnrollments</h2>
                                <h6 class="text-muted">Active</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <div class="card metric-card h-100">
                            <div class="card-body text-center">
                                <div class="metric-icon">
                                    <i class="fas fa-dollar-sign text-success"></i>
                                </div>
                                <h2 class="mt-3">$@totalRevenue.ToString("N0")</h2>
                                <h6 class="text-muted">Total Revenue</h6>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Popular Content -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header">
                                <h5 class="mb-0">Most Popular Content</h5>
                            </div>
                            <div class="card-body">
                                @if (popularContent.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Content</th>
                                                    <th class="text-end">Enrollments</th>
                                                    <th class="text-end">Revenue</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in popularContent.Take(5))
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex align-items-center">
                                                                <div class="content-icon me-2">
                                                                    @if (item.ContentType == "Specialization")
                                                                    {
                                                                        <i class="fas fa-graduation-cap text-primary"></i>
                                                                    }
                                                                    else if (item.ContentType == "Course")
                                                                    {
                                                                        <i class="fas fa-book text-info"></i>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="fas fa-video text-success"></i>
                                                                    }
                                                                </div>
                                                                <div>
                                                                    <div class="fw-bold">@item.Name</div>
                                                                    <small class="text-muted">@item.ContentType</small>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="text-end align-middle">
                                                            <span class="badge bg-primary">@item.EnrollmentCount</span>
                                                        </td>
                                                        <td class="text-end align-middle">
                                                            <span class="badge bg-success">$@item.TotalRevenue.ToString("N0")</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted text-center mb-0">No content data available</p>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header">
                                <h5 class="mb-0">Most Active Students</h5>
                            </div>
                            <div class="card-body">
                                @if (activeStudents.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Student</th>
                                                    <th class="text-end">Enrollments</th>
                                                    <th class="text-end">Completed</th>
                                                    <th class="text-end">Spent</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var student in activeStudents.Take(5))
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex align-items-center">
                                                                <div class="avatar-sm me-2">
                                                                    @if (!string.IsNullOrEmpty(student.ProfileImageUrl))
                                                                    {
                                                                        <img src="@student.ProfileImageUrl" class="rounded-circle" width="32" height="32" alt="Student" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                                            @student.FirstName.Substring(0, 1)
                                                                        </div>
                                                                    }
                                                                </div>
                                                                <div>
                                                                    <div class="fw-bold">@student.FirstName @student.LastName</div>
                                                                    <small class="text-muted">@student.Email</small>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="text-end align-middle">
                                                            <span class="badge bg-primary">@student.TotalEnrollments</span>
                                                        </td>
                                                        <td class="text-end align-middle">
                                                            <span class="badge bg-success">@student.CompletedEnrollments</span>
                                                        </td>
                                                        <td class="text-end align-middle">
                                                            <span class="badge bg-warning text-dark">$@student.TotalSpent.ToString("N0")</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted text-center mb-0">No student data available</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Detailed Enrollment Table -->
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Detailed Enrollments</h5>
                        <div class="d-flex gap-2">
                            <div class="input-group input-group-sm" style="width: 250px;">
                                <span class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" class="form-control" placeholder="Search..."
                                       @bind="searchTerm" @bind:event="oninput" />
                            </div>
                            <select class="form-select form-select-sm" @bind="sortBy" style="width: 120px;">
                                <option value="date">Date</option>
                                <option value="progress">Progress</option>
                                <option value="content">Content</option>
                                <option value="student">Student</option>
                                <option value="revenue">Revenue</option>
                            </select>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>Content</th>
                                        <th class="text-center">Type</th>
                                        <th class="text-center">Enrolled</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Progress</th>
                                        <th class="text-center">Revenue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var enrollment in filteredEnrollments)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-sm me-2">
                                                        @if (!string.IsNullOrEmpty(enrollment.User?.ProfileImageUrl))
                                                        {
                                                            <img src="@enrollment.User.ProfileImageUrl" class="rounded-circle" width="32" height="32" alt="Student" />
                                                        }
                                                        else
                                                        {
                                                            <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                                @enrollment.User?.FirstName?.Substring(0, 1)
                                                            </div>
                                                        }
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold">@enrollment.User?.FirstName @enrollment.User?.LastName</div>
                                                        <small class="text-muted">@enrollment.User?.Email</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="content-icon me-2">
                                                        @if (enrollment.EnrollmentType == EnrollmentType.Specialization)
                                                        {
                                                            <i class="fas fa-graduation-cap text-primary"></i>
                                                        }
                                                        else if (enrollment.EnrollmentType == EnrollmentType.Course)
                                                        {
                                                            <i class="fas fa-book text-info"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-video text-success"></i>
                                                        }
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold">@GetEnrollmentItemName(enrollment)</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge @GetEnrollmentTypeBadge(enrollment.EnrollmentType)">
                                                    @enrollment.EnrollmentType
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                @enrollment.EnrollmentDate.ToString("MMM dd, yyyy")
                                            </td>
                                            <td class="text-center">
                                                @if (enrollment.IsCompleted)
                                                {
                                                    <span class="badge bg-success">Completed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">Active</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="d-flex align-items-center">
                                                    <div class="progress flex-grow-1" style="height: 6px; width: 80px;">
                                                        <div class="progress-bar @(enrollment.IsCompleted ? "bg-success" : "bg-info")"
                                                             style="width: @enrollment.ProgressPercentage%;">
                                                        </div>
                                                    </div>
                                                    <small class="ms-2">@enrollment.ProgressPercentage.ToString("0")%</small>
                                                </div>
                                            </td>
                                            <td class="text-center text-success fw-bold">
                                                $@enrollment.PricePaid.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (totalPages > 1)
                        {
                            <nav class="mt-4 pb-3 px-3">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">
                                            <i class="fas fa-chevron-left"></i>
                                        </button>
                                    </li>

                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        <li class="page-item @(currentPage == i ? "active" : "")">
                                            <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
                                        </li>
                                    }

                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">
                                            <i class="fas fa-chevron-right"></i>
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<EnrollmentDto> enrollments = new();
    private List<EnrollmentDto> filteredEnrollments = new();
    private List<ContentPopularity> popularContent = new();
    private List<ActiveStudent> activeStudents = new();

    private DateTime startDate = DateTime.Now.AddMonths(-1);
    private DateTime endDate = DateTime.Now;
    private string contentTypeFilter = "";
    private string statusFilter = "";
    private string searchTerm = "";
    private string sortBy = "date";
    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages = 1;
    private bool isLoading = false;
    private bool isExporting = false;

    private UserDto? currentUser = null;
    private bool isAuthenticated = false;

    private int totalEnrollments = 0;
    private int completedEnrollments = 0;
    private int activeEnrollments = 0;
    private decimal completionRate = 0;
    private decimal totalRevenue = 0;
    private string? errorMessage = null;

    private class ContentPopularity
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string ContentType { get; set; } = "";
        public int EnrollmentCount { get; set; }
        public decimal CompletionRate { get; set; }
        public decimal AverageProgress { get; set; }
        public decimal TotalRevenue { get; set; }
    }

    private class ActiveStudent
    {
        public int Id { get; set; }
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string? ProfileImageUrl { get; set; }
        public int TotalEnrollments { get; set; }
        public int CompletedEnrollments { get; set; }
        public decimal AverageProgress { get; set; }
        public decimal TotalSpent { get; set; }
        public DateTime LastEnrollmentDate { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
        
        if (isAuthenticated && currentUser?.UserType == UserType.Admin)
        {
            await LoadReport();
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();
                isAuthenticated = currentUser?.UserType == UserType.Admin;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
        }
    }

    private async Task LoadReport()
    {
        if (!isAuthenticated || currentUser?.UserType != UserType.Admin)
        {
            errorMessage = "Access denied. Administrator privileges required.";
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            // Clear existing data
            enrollments.Clear();
            
            // Get all users (students)
            var users = await UserService.GetUsersAsync(
                search: null,
                userType: UserType.User, // Only get regular users
                isActive: true,
                page: 1,
                pageSize: 1000
            );

            if (users == null || !users.Any())
            {
                await ShowToast("info", "No users found");
                return;
            }

            // Get enrollments for each user
            var allEnrollments = new List<EnrollmentDto>();
            
            foreach (var user in users)
            {
                try
                {
                    var userEnrollments = await EnrollmentService.GetUserEnrollmentsAsync(user.Id);
                    if (userEnrollments != null)
                    {
                        // Add user info to each enrollment
                        foreach (var enrollment in userEnrollments)
                        {
                            enrollment.User = user;
                        }
                        allEnrollments.AddRange(userEnrollments);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading enrollments for user {user.Id}: {ex.Message}");
                }
            }

            // Filter by date range
            enrollments = allEnrollments
                .Where(e => e.EnrollmentDate >= startDate && e.EnrollmentDate <= endDate.AddDays(1))
                .ToList();

            if (enrollments.Any())
            {
                CalculateMetrics();
                GeneratePopularContent();
                GenerateActiveStudents();
                ApplyFilters();
                SortEnrollments();
                ApplyPagination();
                
                await ShowToast("success", $"Loaded {enrollments.Count} enrollments");
            }
            else
            {
                await ShowToast("info", "No enrollment data found for the selected period");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading report: {ex.Message}";
            Console.WriteLine($"Error loading report: {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CalculateMetrics()
    {
        totalEnrollments = enrollments.Count;
        completedEnrollments = enrollments.Count(e => e.IsCompleted);
        activeEnrollments = enrollments.Count(e => !e.IsCompleted);
        totalRevenue = enrollments.Sum(e => e.PricePaid);

        completionRate = totalEnrollments > 0 ?
            ((decimal)completedEnrollments / totalEnrollments) * 100 : 0;
    }

    private void GeneratePopularContent()
    {
        var contentGroups = enrollments
            .GroupBy(e => new
            {
                Type = e.EnrollmentType,
                Id = e.EnrollmentType switch
                {
                    EnrollmentType.Lecture => e.LectureId ?? 0,
                    EnrollmentType.Course => e.CourseId ?? 0,
                    EnrollmentType.Specialization => e.SpecializationId ?? 0,
                    _ => 0
                },
                Name = e.EnrollmentType switch
                {
                    EnrollmentType.Lecture => e.Lecture?.Title ?? "Unknown Lecture",
                    EnrollmentType.Course => e.Course?.Title ?? "Unknown Course",
                    EnrollmentType.Specialization => e.Specialization?.Title ?? "Unknown Specialization",
                    _ => "Unknown"
                }
            })
            .Where(g => g.Key.Id > 0)
            .Select(g => new ContentPopularity
            {
                Id = g.Key.Id,
                Name = g.Key.Name,
                ContentType = g.Key.Type.ToString(),
                EnrollmentCount = g.Count(),
                CompletionRate = g.Any() ? 
                    ((decimal)g.Count(x => x.IsCompleted) / g.Count()) * 100 : 0,
                AverageProgress = g.Any() ?
                    (decimal)g.Average(x => (decimal)x.ProgressPercentage) : 0,
                TotalRevenue = g.Sum(x => x.PricePaid)
            })
            .OrderByDescending(c => c.EnrollmentCount)
            .ThenByDescending(c => c.TotalRevenue)
            .Take(10)
            .ToList();

        popularContent = contentGroups;
    }

    private void GenerateActiveStudents()
    {
        activeStudents = enrollments
            .Where(e => e.User != null)
            .GroupBy(e => new
            {
                e.UserId,
                User = e.User
            })
            .Select(g => new ActiveStudent
            {
                Id = g.Key.UserId,
                FirstName = g.Key.User?.FirstName ?? "",
                LastName = g.Key.User?.LastName ?? "",
                Email = g.Key.User?.Email ?? "",
                ProfileImageUrl = g.Key.User?.ProfileImageUrl,
                TotalEnrollments = g.Count(),
                CompletedEnrollments = g.Count(x => x.IsCompleted),
                AverageProgress = g.Any() ?
                    (decimal)g.Average(x => (decimal)x.ProgressPercentage) : 0,
                TotalSpent = g.Sum(x => x.PricePaid),
                LastEnrollmentDate = g.Max(x => x.EnrollmentDate)
            })
            .OrderByDescending(s => s.TotalEnrollments)
            .ThenByDescending(s => s.TotalSpent)
            .Take(10)
            .ToList();
    }

    private void ApplyFilters()
    {
        var query = enrollments.AsQueryable();

        if (!string.IsNullOrEmpty(contentTypeFilter))
        {
            query = contentTypeFilter.ToLower() switch
            {
                "specialization" => query.Where(e => e.EnrollmentType == EnrollmentType.Specialization),
                "course" => query.Where(e => e.EnrollmentType == EnrollmentType.Course),
                "lecture" => query.Where(e => e.EnrollmentType == EnrollmentType.Lecture),
                _ => query
            };
        }

        if (!string.IsNullOrEmpty(statusFilter))
        {
            query = statusFilter.ToLower() switch
            {
                "active" => query.Where(e => !e.IsCompleted),
                "completed" => query.Where(e => e.IsCompleted),
                _ => query
            };
        }

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var search = searchTerm.ToLower();
            query = query.Where(e =>
                (e.User != null &&
                 (e.User.FirstName.ToLower().Contains(search) ||
                  e.User.LastName.ToLower().Contains(search) ||
                  e.User.Email.ToLower().Contains(search))) ||
                (e.Lecture != null && e.Lecture.Title.ToLower().Contains(search)) ||
                (e.Course != null && e.Course.Title.ToLower().Contains(search)) ||
                (e.Specialization != null && e.Specialization.Title.ToLower().Contains(search))
            );
        }

        filteredEnrollments = query.ToList();
    }

    private void SortEnrollments()
    {
        filteredEnrollments = sortBy switch
        {
            "date" => filteredEnrollments.OrderByDescending(e => e.EnrollmentDate).ToList(),
            "progress" => filteredEnrollments.OrderByDescending(e => e.ProgressPercentage).ToList(),
            "content" => filteredEnrollments.OrderBy(e => GetEnrollmentItemName(e)).ToList(),
            "student" => filteredEnrollments.OrderBy(e => e.User?.LastName).ThenBy(e => e.User?.FirstName).ToList(),
            "revenue" => filteredEnrollments.OrderByDescending(e => e.PricePaid).ToList(),
            _ => filteredEnrollments.OrderByDescending(e => e.EnrollmentDate).ToList()
        };
    }

    private void ApplyPagination()
    {
        totalPages = filteredEnrollments.Any() ?
            (int)Math.Ceiling((double)filteredEnrollments.Count / pageSize) : 1;
        
        filteredEnrollments = filteredEnrollments
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            ApplyPagination();
            StateHasChanged();
        }
    }

    private string GetEnrollmentItemName(EnrollmentDto enrollment)
    {
        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Lecture => enrollment.Lecture?.Title ?? "Lecture",
            EnrollmentType.Course => enrollment.Course?.Title ?? "Course",
            EnrollmentType.Specialization => enrollment.Specialization?.Title ?? "Specialization",
            _ => "Unknown"
        };
    }

    private string GetEnrollmentTypeBadge(EnrollmentType type)
    {
        return type switch
        {
            EnrollmentType.Lecture => "bg-success",
            EnrollmentType.Course => "bg-info",
            EnrollmentType.Specialization => "bg-primary",
            _ => "bg-secondary"
        };
    }

