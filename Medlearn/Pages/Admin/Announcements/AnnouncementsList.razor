@page "/admin/announcements"


<PageTitle>Manage Announcements</PageTitle>

<div class="announcements-management">
    <div class="container-fluid px-0 px-md-3">
        <!-- Header - Responsive -->
        <div class="d-block d-md-none">
            <!-- Mobile Header -->
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <h5 class="mb-0 flex-grow-1">Announcements</h5>
                    @if (currentUserIsAdmin)
                    {
                        <button class="btn btn-link text-white p-0" @onclick="Create">
                            <i class="fas fa-plus fa-lg"></i>
                        </button>
                    }
                </div>
            </div>

            <!-- Mobile Stats Cards -->
            @if (isAuthenticated && currentUserIsAdmin)
            {
                <div class="px-3 py-2 bg-light border-bottom">
                    <div class="row g-2">
                        <div class="col-4">
                            <div class="card">
                                <div class="card-body p-2 text-center">
                                    <small class="text-muted d-block">Total</small>
                                    <h6 class="mb-0">@totalCount</h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="card">
                                <div class="card-body p-2 text-center">
                                    <small class="text-muted d-block">Active</small>
                                    <h6 class="mb-0 text-success">@activeCount</h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="card">
                                <div class="card-body p-2 text-center">
                                    <small class="text-muted d-block">Important</small>
                                    <h6 class="mb-0 text-warning">@importantCount</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-block">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Announcements Management</h1>
                <div>
                    <button class="btn btn-primary" @onclick="Create" disabled="@(!currentUserIsAdmin)">
                        <i class="fas fa-plus me-2"></i> Create Announcement
                    </button>
                </div>
            </div>
        </div>

        <!-- Filters - Responsive -->
        @if (isAuthenticated && currentUserIsAdmin)
        {
            <div class="card mb-3 mb-md-4">
                <div class="card-body p-3">
                    <!-- Mobile Filters -->
                    <div class="d-block d-md-none">
                        <div class="d-flex align-items-center mb-2">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" class="form-control" placeholder="Search..."
                                       @bind="searchTerm" @bind:event="oninput" />
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-6">
                                <select class="form-select form-select-sm" @bind="statusFilter">
                                    <option value="">All Status</option>
                                    <option value="active">Active</option>
                                    <option value="expired">Expired</option>
                                    <option value="important">Important</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <select class="form-select form-select-sm" @bind="audienceFilter">
                                    <option value="">All Audiences</option>
                                    <option value="all">All Users</option>
                                    <option value="doctors">Doctors</option>
                                    <option value="students">Students</option>
                                </select>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(statusFilter) || !string.IsNullOrEmpty(audienceFilter))
                        {
                            <div class="mt-2 text-end">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">
                                    <i class="fas fa-times me-1"></i> Clear filters
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Desktop Filters -->
                    <div class="d-none d-md-block">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    <input type="text" class="form-control" placeholder="Search announcements..."
                                           @bind="searchTerm" @bind:event="oninput" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" @bind="statusFilter">
                                    <option value="">All Status</option>
                                    <option value="active">Active</option>
                                    <option value="expired">Expired</option>
                                    <option value="important">Important Only</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" @bind="audienceFilter">
                                    <option value="">All Audiences</option>
                                    <option value="all">All Users</option>
                                    <option value="doctors">Doctors Only</option>
                                    <option value="students">Students Only</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">
                                    <i class="fas fa-times me-2"></i> Clear
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Announcements List -->
        <div class="card border-0 border-md">
            <!-- Mobile Card Header -->
            <div class="d-block d-md-none card-header bg-light py-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small fw-bold">@filteredAnnouncements.Count announcements</span>
                    <span class="badge bg-primary">@activeCount active</span>
                </div>
            </div>

            <!-- Desktop Card Header -->
            <div class="d-none d-md-block card-header">
                <h5 class="mb-0">
                    @if (isAuthenticated && currentUserIsAdmin)
                    {
                        <span>Announcements (@filteredAnnouncements.Count)</span>
                    }
                    else
                    {
                        <span>Announcements Management</span>
                    }
                </h5>
            </div>

            <div class="card-body p-0 p-md-3">
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading announcements...</p>
                    </div>
                }
                else if (!isAuthenticated)
                {
                    <div class="text-center py-5">
                        <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                        <h5>Authentication Required</h5>
                        <p class="text-muted">Please log in to access announcements</p>
                        <button class="btn btn-primary" @onclick="NavigateToLogin">
                            <i class="fas fa-sign-in-alt me-2"></i> Go to Login
                        </button>
                    </div>
                }
                else if (!currentUserIsAdmin)
                {
                    <div class="text-center py-5">
                        <i class="fas fa-ban fa-3x text-danger mb-3"></i>
                        <h5>Access Denied</h5>
                        <p class="text-muted">You need admin privileges to manage announcements</p>
                        <a href="/" class="btn btn-outline-primary mt-3">
                            <i class="fas fa-home me-2"></i> Go to Homepage
                        </a>
                    </div>
                }
                else if (!filteredAnnouncements.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-bullhorn fa-3x text-muted mb-3"></i>
                        <h5>No announcements found</h5>
                        <p class="text-muted">Create your first announcement to notify users</p>
                        <button class="btn btn-primary mt-3" @onclick="Create">
                            <i class="fas fa-plus me-2"></i> Create Announcement
                        </button>
                    </div>
                }
                else
                {
                    <!-- Mobile Announcement Cards -->
                    <div class="d-block d-md-none">
                        @foreach (var announcement in filteredAnnouncements)
                        {
                            <div class="border-bottom p-3 @(announcement.IsImportant ? "bg-warning bg-opacity-10" : "")">
                                <!-- Mobile Announcement Card -->
                                <div class="d-flex gap-2">
                                    <!-- Thumbnail -->
                                    <div class="flex-shrink-0" style="width: 60px; height: 60px;">
                                        @if (!string.IsNullOrEmpty(announcement.ThumbnailUrl))
                                        {
                                            <img src="@announcement.ThumbnailUrl"
                                                 class="rounded"
                                                 alt="@(announcement.ImageAltText ?? announcement.Title)"
                                                 style="width: 60px; height: 60px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center h-100">
                                                <i class="fas fa-newspaper text-muted"></i>
                                            </div>
                                        }
                                    </div>

                                    <!-- Content -->
                                    <div class="flex-grow-1 min-width-0">
                                        <div class="d-flex align-items-start justify-content-between">
                                            <div class="me-2">
                                                <h6 class="mb-1 text-truncate">@announcement.Title</h6>
                                                <div class="d-flex align-items-center gap-1 mb-1">
                                                    @if (announcement.IsImportant)
                                                    {
                                                        <span class="badge bg-warning">Important</span>
                                                    }
                                                    @if (announcement.ExpiryDate.HasValue)
                                                    {
                                                        <span class="badge @(announcement.ExpiryDate < DateTime.UtcNow ? "bg-secondary" : "bg-info")">
                                                            @(announcement.ExpiryDate < DateTime.UtcNow ? "Expired" : "Active")
                                                        </span>
                                                    }
                                                </div>
                                                <p class="small text-muted mb-1">
                                                    @GetTruncatedContent(announcement.Content, 60)
                                                </p>
                                                <small class="text-muted">
                                                    <i class="fas fa-calendar me-1"></i>
                                                    @announcement.CreatedAt.ToString("MMM dd, yyyy")
                                                </small>
                                            </div>

                                            <!-- Mobile Action Menu -->
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-light"
                                                        data-bs-toggle="dropdown"
                                                        aria-expanded="false"
                                                        style="padding: 0.25rem 0.5rem;">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li>
                                                        <button class="dropdown-item small" @onclick="() => ViewAnnouncement(announcement.Id)">
                                                            <i class="fas fa-eye me-2"></i> View
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item small" @onclick="() => EditAnnouncement(announcement.Id)">
                                                            <i class="fas fa-edit me-2"></i> Edit
                                                        </button>
                                                    </li>
                                                    @if (announcement.ExpiryDate.HasValue && announcement.ExpiryDate > DateTime.UtcNow)
                                                    {
                                                        <li>
                                                            <button class="dropdown-item small" @onclick="async () => await ExpireAnnouncement(announcement.Id)">
                                                                <i class="fas fa-clock me-2"></i> Expire Now
                                                            </button>
                                                        </li>
                                                    }
                                                    @if (!announcement.ExpiryDate.HasValue || announcement.ExpiryDate > DateTime.UtcNow)
                                                    {
                                                        <li>
                                                            <button class="dropdown-item small" @onclick="async () => await ToggleImportant(announcement.Id, !announcement.IsImportant)">
                                                                @if (announcement.IsImportant)
                                                                {
                                                                    <span>
                                                                        <i class="fas fa-star me-2"></i> Remove Important
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span>
                                                                        <i class="fas fa-star me-2"></i> Mark Important
                                                                    </span>
                                                                }
                                                            </button>
                                                        </li>
                                                    }
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <button class="dropdown-item small text-danger"
                                                                @onclick="async () => await ConfirmDelete(announcement.Id, announcement.Title)">
                                                            <i class="fas fa-trash me-2"></i> Delete
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Desktop Announcement List -->
                    <div class="d-none d-md-block list-group">
                        @foreach (var announcement in filteredAnnouncements)
                        {
                            <div class="list-group-item list-group-item-action @(announcement.IsImportant ? "list-group-item-warning" : "")">
                                <div class="d-flex w-100 justify-content-between align-items-start">
                                    @if (!string.IsNullOrEmpty(announcement.ThumbnailUrl))
                                    {
                                        <div class="me-3 flex-shrink-0" style="width: 120px; height: 80px;">
                                            <img src="@announcement.ThumbnailUrl"
                                                 class="img-fluid rounded"
                                                 alt="@(announcement.ImageAltText ?? announcement.Title)"
                                                 style="width: 100%; height: 100%; object-fit: cover;" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="me-3 flex-shrink-0" style="width: 120px; height: 80px;">
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center h-100">
                                                <i class="fas fa-newspaper text-muted"></i>
                                            </div>
                                        </div>
                                    }

                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center mb-2">
                                            <h5 class="mb-0 me-2">@announcement.Title</h5>
                                            @if (announcement.IsImportant)
                                            {
                                                <span class="badge bg-warning">
                                                    <i class="fas fa-exclamation-circle me-1"></i> Important
                                                </span>
                                            }
                                            @if (announcement.ExpiryDate.HasValue && announcement.ExpiryDate < DateTime.UtcNow)
                                            {
                                                <span class="badge bg-secondary ms-2">
                                                    <i class="fas fa-clock me-1"></i> Expired
                                                </span>
                                            }
                                            else if (announcement.ExpiryDate.HasValue)
                                            {
                                                <span class="badge bg-info ms-2">
                                                    <i class="fas fa-clock me-1"></i> Active
                                                </span>
                                            }
                                        </div>

                                        <div class="mb-2">
                                            <span class="text-muted small">
                                                Created by @announcement.CreatedByAdmin?.FirstName @announcement.CreatedByAdmin?.LastName
                                                on @announcement.CreatedAt.ToString("MMMM dd, yyyy HH:mm")
                                            </span>
                                        </div>

                                        <div class="mb-3">
                                            <p class="mb-0 text-muted">@GetTruncatedContent(announcement.Content, 200)</p>
                                            @if (!string.IsNullOrEmpty(announcement.ImageAltText))
                                            {
                                                <small class="text-muted d-block mt-1">
                                                    <i class="fas fa-info-circle me-1"></i> @announcement.ImageAltText
                                                </small>
                                            }
                                        </div>

                                        <div class="d-flex align-items-center">
                                            <div class="audience-badges me-3">
                                                @if (announcement.ForAllUsers)
                                                {
                                                    <span class="badge bg-primary me-1">
                                                        <i class="fas fa-users me-1"></i> All Users
                                                    </span>
                                                }
                                                @if (announcement.ForDoctorsOnly)
                                                {
                                                    <span class="badge bg-info me-1">
                                                        <i class="fas fa-user-md me-1"></i> Doctors Only
                                                    </span>
                                                }
                                                @if (announcement.ForRegularUsersOnly)
                                                {
                                                    <span class="badge bg-success me-1">
                                                        <i class="fas fa-user-graduate me-1"></i> Students Only
                                                    </span>
                                                }
                                            </div>

                                            @if (announcement.ExpiryDate.HasValue)
                                            {
                                                <div class="text-muted small">
                                                    @if (announcement.ExpiryDate < DateTime.UtcNow)
                                                    {
                                                        <span class="text-danger">
                                                            <i class="fas fa-times-circle me-1"></i>
                                                            Expired on @announcement.ExpiryDate.Value.ToString("MMMM dd, yyyy")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-success">
                                                            <i class="fas fa-clock me-1"></i>
                                                            Expires in @((announcement.ExpiryDate.Value - DateTime.UtcNow).Days) days
                                                        </span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="dropdown ms-3 d-none d-md-block">
                                        <button class="btn btn-sm btn-light dropdown-toggle"
                                                data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <button class="dropdown-item" @onclick="() => ViewAnnouncement(announcement.Id)">
                                                    <i class="fas fa-eye me-2"></i> View
                                                </button>
                                            </li>
                                            <li>
                                                <button class="dropdown-item" @onclick="() => EditAnnouncement(announcement.Id)">
                                                    <i class="fas fa-edit me-2"></i> Edit
                                                </button>
                                            </li>
                                            @if (announcement.ExpiryDate.HasValue && announcement.ExpiryDate > DateTime.UtcNow)
                                            {
                                                <li>
                                                    <button class="dropdown-item" @onclick="async () => await ExpireAnnouncement(announcement.Id)">
                                                        <i class="fas fa-clock me-2"></i> Expire Now
                                                    </button>
                                                </li>
                                            }
                                            else if (announcement.ExpiryDate == null || announcement.ExpiryDate > DateTime.UtcNow)
                                            {
                                                <li>
                                                    <button class="dropdown-item" @onclick="async () => await ToggleImportant(announcement.Id, !announcement.IsImportant)">
                                                        @if (announcement.IsImportant)
                                                        {
                                                            <span>
                                                                <i class="fas fa-star me-2"></i> Remove Important
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span>
                                                                <i class="fas fa-star me-2"></i> Mark as Important
                                                            </span>
                                                        }
                                                    </button>
                                                </li>
                                            }
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <button class="dropdown-item text-danger"
                                                        @onclick="async () => await ConfirmDelete(announcement.Id, announcement.Title)">
                                                    <i class="fas fa-trash me-2"></i> Delete
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pagination - Mobile -->
                    @if (totalPages > 1)
                    {
                        <div class="d-block d-md-none mt-3 px-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <button class="btn btn-sm btn-outline-primary @(currentPage == 1 ? "disabled" : "")"
                                        @onclick="() => ChangePage(currentPage - 1)">
                                    <i class="fas fa-chevron-left"></i> Prev
                                </button>
                                <span class="small">Page @currentPage of @totalPages</span>
                                <button class="btn btn-sm btn-outline-primary @(currentPage == totalPages ? "disabled" : "")"
                                        @onclick="() => ChangePage(currentPage + 1)">
                                    Next <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Pagination - Desktop -->
                        <nav class="d-none d-md-block mt-4">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">
                                        <i class="fas fa-chevron-left"></i>
                                    </button>
                                </li>

                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(currentPage == i ? "active" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
                                    </li>
                                }

                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">
                                        <i class="fas fa-chevron-right"></i>
                                    </button>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>

        <!-- Stats Summary - Desktop Only -->
        @if (isAuthenticated && currentUserIsAdmin)
        {
            <div class="d-none d-md-block row mt-4">
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Total Announcements</h6>
                            <h2>@totalCount</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Active Announcements</h6>
                            <h2 class="text-success">@activeCount</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Important Announcements</h6>
                            <h2 class="text-warning">@importantCount</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h6 class="text-muted">With Images</h6>
                            <h2 class="text-info">@announcements.Count(a => !string.IsNullOrEmpty(a.ThumbnailUrl))</h2>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // ... (keep all your existing code in the @code block exactly as is from the original)
    private List<AnnouncementDto> announcements = new();
    private List<AnnouncementDto> filteredAnnouncements = new();
    private string searchTerm = "";
    private string statusFilter = "";
    private string audienceFilter = "";
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private bool isLoading = true;
    private int totalCount = 0;
    private int activeCount = 0;
    private int importantCount = 0;
    private int expiredCount = 0;
    private bool isAuthenticated = false;
    private bool currentUserIsAdmin = false;
    private UserDto? currentUser;
    private Timer? refreshTimer;
    private int debounceTimerId;

    protected override async Task OnInitializedAsync()
    {
        // Listen to location changes
        Navigation.LocationChanged += HandleLocationChanged;

        await LoadUserAndAnnouncements();

        // Start auto-refresh timer (same as notification component)
        if (isAuthenticated && currentUserIsAdmin)
        {
            refreshTimer = new Timer(async _ => await RefreshData(), null, 30000, 30000);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Check authentication when parameters change
        await CheckAuthentication();
    }

    private async Task CheckAuthentication()
    {
        try
        {
            // SIMPLE AUTHENTICATION CHECK - SAME AS NOTIFICATION COMPONENT
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                // Try to get user from localStorage first (fast)
                currentUser = await GetUserFromStorage();

                // If not in storage, get from API
                if (currentUser == null)
                {
                    currentUser = await AuthService.GetCurrentUserAsync();
                    if (currentUser != null)
                    {
                        // Store for next time
                        await JS.InvokeVoidAsync("localStorage.setItem", "currentUser",
                            System.Text.Json.JsonSerializer.Serialize(currentUser));
                    }
                }

                // Check if user is admin
                currentUserIsAdmin = currentUser?.UserType == UserType.Admin;
            }
            else
            {
                currentUser = null;
                currentUserIsAdmin = false;
                // Clear any stale data
                await JS.InvokeVoidAsync("localStorage.removeItem", "currentUser");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            currentUser = null;
            currentUserIsAdmin = false;
        }
    }

    private async Task<UserDto?> GetUserFromStorage()
    {
        try
        {
            var userJson = await JS.InvokeAsync<string>("localStorage.getItem", "currentUser");

            if (!string.IsNullOrEmpty(userJson))
            {
                return System.Text.Json.JsonSerializer.Deserialize<UserDto>(userJson);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting user from storage: {ex.Message}");
        }

        return null;
    }

    private async Task LoadUserAndAnnouncements()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // First check authentication using TokenService
            await CheckAuthentication();

            if (isAuthenticated && currentUserIsAdmin)
            {
                await LoadAnnouncements();
            }
            else
            {
                announcements = new List<AnnouncementDto>();
                filteredAnnouncements = new List<AnnouncementDto>();
                CalculateStats();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", $"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAnnouncements()
    {
        try
        {
            // Use GetAllAnnouncementsAsync method from your IAnnouncementService
            var allAnnouncements = await AnnouncementService.GetAllAnnouncementsAsync(
                activeOnly: null,
                page: 1,
                pageSize: 1000); // Use large page size to get all announcements

            if (allAnnouncements != null)
            {
                announcements = allAnnouncements.ToList();
                CalculateStats();
                ApplyFilters();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading announcements: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", $"Failed to load announcements: {ex.Message}");
        }
    }

    private async Task RefreshData()
    {
        if (!isAuthenticated || !currentUserIsAdmin) return;

        await InvokeAsync(async () =>
        {
            try
            {
                await LoadAnnouncements();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error refreshing announcements: {ex.Message}");
            }
        });
    }

    private void CalculateStats()
    {
        totalCount = announcements.Count;
        activeCount = announcements.Count(a =>
            a.ExpiryDate == null || a.ExpiryDate >= DateTime.UtcNow);
        importantCount = announcements.Count(a => a.IsImportant);
        expiredCount = announcements.Count(a =>
            a.ExpiryDate.HasValue && a.ExpiryDate < DateTime.UtcNow);
    }

    private void ApplyFilters()
    {
        var query = announcements.AsQueryable();

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query = query.Where(a =>
                (a.Title != null && a.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (a.Content != null && a.Content.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (a.ImageAltText != null && a.ImageAltText.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            );
        }

        // Apply status filter
        switch (statusFilter)
        {
            case "active":
                query = query.Where(a => a.ExpiryDate == null || a.ExpiryDate >= DateTime.UtcNow);
                break;
            case "expired":
                query = query.Where(a => a.ExpiryDate.HasValue && a.ExpiryDate < DateTime.UtcNow);
                break;
            case "important":
                query = query.Where(a => a.IsImportant);
                break;
        }

        // Apply audience filter
        switch (audienceFilter)
        {
            case "all":
                query = query.Where(a => a.ForAllUsers);
                break;
            case "doctors":
                query = query.Where(a => a.ForDoctorsOnly);
                break;
            case "students":
                query = query.Where(a => a.ForRegularUsersOnly);
                break;
        }

        // Sort by important and date
        query = query.OrderByDescending(a => a.IsImportant)
                    .ThenByDescending(a => a.CreatedAt);

        // Apply pagination
        var totalItems = query.Count();
        totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
        filteredAnnouncements = query.Skip((currentPage - 1) * pageSize)
                                    .Take(pageSize)
                                    .ToList();
    }

    private async Task SearchAnnouncements()
    {
        await InvokeAsync(() =>
        {
            currentPage = 1;
            ApplyFilters();
            StateHasChanged();
        });
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";

        // Debounce search
        await InvokeAsync(async () =>
        {
            if (debounceTimerId != 0)
            {
                await JS.InvokeVoidAsync("clearTimeout", debounceTimerId);
            }

            debounceTimerId = await JS.InvokeAsync<int>("setTimeout",
                DotNetObjectReference.Create(this),
                nameof(SearchAnnouncements),
                300);
        });
    }

    private async Task OnFilterChange(ChangeEventArgs e)
    {
        await SearchAnnouncements();
    }

