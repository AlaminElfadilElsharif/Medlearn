    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        refreshTimer?.Dispose();

        if (debounceTimerId != 0)
        {
            _ = JS.InvokeVoidAsync("clearTimeout", debounceTimerId);
        }

        // Clean up .NET object reference
        GC.SuppressFinalize(this);
    }

