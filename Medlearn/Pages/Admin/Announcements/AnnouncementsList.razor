    private string GetTruncatedContent(string content, int maxLength)
    {
        if (string.IsNullOrEmpty(content)) return "";
        if (content.Length <= maxLength) return content;

        return content.Substring(0, maxLength) + "...";
    }

    private async Task ConfirmDelete(int announcementId, string announcementTitle)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete announcement '{announcementTitle}'?");

        if (confirmed)
        {
            try
            {
                await AnnouncementService.DeleteAnnouncementAsync(announcementId);
                await JS.InvokeVoidAsync("showToast", "success", "Announcement deleted successfully");
                await LoadAnnouncements();
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("showToast", "error", $"Error deleting announcement: {ex.Message}");
            }
        }
    }

    private async Task ExpireAnnouncement(int announcementId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            "Are you sure you want to expire this announcement?");

        if (confirmed)
        {
            try
            {
                // Get the announcement first
                var announcement = await AnnouncementService.GetAnnouncementAsync(announcementId);

                if (announcement != null)
                {
                    // Update with expiry date set to now
                    var updateDto = new UpdateAnnouncementDto
                    {
                        ExpiryDate = DateTime.UtcNow
                    };

                    await AnnouncementService.UpdateAnnouncementAsync(announcementId, updateDto);
                    await JS.InvokeVoidAsync("showToast", "success", "Announcement expired successfully");
                    await LoadAnnouncements();
                }
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("showToast", "error", $"Error expiring announcement: {ex.Message}");
            }
        }
    }

    private async Task ToggleImportant(int announcementId, bool isImportant)
    {
        try
        {
            var updateDto = new UpdateAnnouncementDto
            {
                IsImportant = isImportant
            };

            await AnnouncementService.UpdateAnnouncementAsync(announcementId, updateDto);

            await JS.InvokeVoidAsync("showToast", "success",
                $"Announcement {(isImportant ? "marked as important" : "removed from important")}");
            await LoadAnnouncements();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showToast", "error", $"Error updating announcement: {ex.Message}");
        }
    }

