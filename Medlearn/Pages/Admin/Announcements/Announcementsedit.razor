                                            </div>

                                            <div class="row g-3">
                                                <!-- For All Users -->
                                                <div class="col-md-4">
                                                    <div class="card h-100 @(updatedAnnouncement.ForAllUsers == true ? "border-primary" : "")"
                                                         style="cursor: pointer;"
                                                         @onclick='() => ToggleAudience("all")'>
                                                        <div class="card-body text-center">
                                                            <div class="mb-3">
                                                                <i class="fas fa-users fa-3x @(updatedAnnouncement.ForAllUsers == true ? "text-primary" : "text-muted")"></i>
                                                            </div>
                                                            <h5 class="card-title">All Users</h5>
                                                            <p class="card-text small text-muted">
                                                                Show to all users including doctors and regular users
                                                            </p>
                                                            <div class="form-check d-inline-block">
                                                                <input class="form-check-input"
                                                                       type="radio"
                                                                       name="audience"
                                                                       checked="@(updatedAnnouncement.ForAllUsers == true)"
                                                                       @onchange='() => ToggleAudience("all")' />
                                                                <label class="form-check-label">Select</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- For Doctors Only -->
                                                <div class="col-md-4">
                                                    <div class="card h-100 @(updatedAnnouncement.ForDoctorsOnly == true ? "border-info" : "")"
                                                         style="cursor: pointer;"
                                                         @onclick='() => ToggleAudience("doctors")'>
                                                        <div class="card-body text-center">
                                                            <div class="mb-3">
                                                                <i class="fas fa-user-md fa-3x @(updatedAnnouncement.ForDoctorsOnly == true ? "text-info" : "text-muted")"></i>
                                                            </div>
                                                            <h5 class="card-title">Doctors Only</h5>
                                                            <p class="card-text small text-muted">
                                                                Show only to doctors (content creators)
                                                            </p>
                                                            <div class="form-check d-inline-block">
                                                                <input class="form-check-input"
                                                                       type="radio"
                                                                       name="audience"
                                                                       checked="@(updatedAnnouncement.ForDoctorsOnly == true)"
                                                                       @onchange='() => ToggleAudience("doctors")' />
                                                                <label class="form-check-label">Select</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- For Regular Users Only -->
                                                <div class="col-md-4">
                                                    <div class="card h-100 @(updatedAnnouncement.ForRegularUsersOnly == true ? "border-success" : "")"
                                                         style="cursor: pointer;"
                                                         @onclick='() => ToggleAudience("regular")'>
                                                        <div class="card-body text-center">
                                                            <div class="mb-3">
                                                                <i class="fas fa-user-graduate fa-3x @(updatedAnnouncement.ForRegularUsersOnly == true ? "text-success" : "text-muted")"></i>
                                                            </div>
                                                            <h5 class="card-title">Students Only</h5>
                                                            <p class="card-text small text-muted">
                                                                Show only to regular users (students)
                                                            </p>
                                                            <div class="form-check d-inline-block">
                                                                <input class="form-check-input"
                                                                       type="radio"
                                                                       name="audience"
                                                                       checked="@(updatedAnnouncement.ForRegularUsersOnly == true)"
                                                                       @onchange='() => ToggleAudience("regular")' />
                                                                <label class="form-check-label">Select</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            @if (validationErrors.ContainsKey("Audience"))
                                            {
                                                <div class="alert alert-danger mt-3">
                                                    @validationErrors["Audience"]
                                                </div>
                                            }
                                        </div>

                                        <!-- Preview Section (Desktop) -->
                                        <div class="col-md-12 mb-4">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5 class="mb-0">
                                                        <i class="fas fa-eye me-2"></i> Preview
                                                    </h5>
                                                </div>
                                                <div class="card-body">
                                                    <div class="announcement-preview">
                                                        @if (updatedAnnouncement.IsImportant == true)
                                                        {
                                                            <div class="alert alert-warning mb-3">
                                                                <i class="fas fa-exclamation-triangle me-2"></i>
                                                                <strong>Important Announcement</strong>
                                                            </div>
                                                        }

                                                        <h4 class="preview-title">@(updatedAnnouncement.Title ?? announcement.Title)</h4>

                                                        @if (!string.IsNullOrEmpty(previewImageUrl))
                                                        {
                                                            <div class="mb-3">
                                                                <img src="@previewImageUrl" class="img-fluid rounded"
                                                                     alt="@updatedAnnouncement.ImageAltText"
                                                                     style="max-height: 200px;" />
                                                                @if (!string.IsNullOrEmpty(updatedAnnouncement.ImageAltText))
                                                                {
                                                                    <small class="text-muted d-block mt-1">
                                                                        <i class="fas fa-info-circle me-1"></i>
                                                                        @updatedAnnouncement.ImageAltText
                                                                    </small>
                                                                }
                                                            </div>
                                                        }
                                                        else if (!string.IsNullOrEmpty(announcement.ThumbnailUrl) && !hasRemovedExistingThumbnail)
                                                        {
                                                            <div class="mb-3">
                                                                <img src="@announcement.ThumbnailUrl" class="img-fluid rounded"
                                                                     alt="@announcement.ImageAltText"
                                                                     style="max-height: 200px;" />
                                                                @if (!string.IsNullOrEmpty(announcement.ImageAltText))
                                                                {
                                                                    <small class="text-muted d-block mt-1">
                                                                        <i class="fas fa-info-circle me-1"></i>
                                                                        @announcement.ImageAltText
                                                                    </small>
                                                                }
                                                            </div>
                                                        }

                                                        <div class="preview-meta mb-3">
                                                            <span class="badge bg-secondary me-2">
                                                                <i class="fas fa-calendar me-1"></i>
                                                                @DateTime.Now.ToString("MMM dd, yyyy")
                                                            </span>
                                                            <span class="badge @GetAudienceBadgeColor()">
                                                                @GetAudienceText()
                                                            </span>
                                                        </div>
                                                        <div class="preview-content">
                                                            @((MarkupString)FormatContentPreview(updatedAnnouncement.Content ?? announcement.Content))
                                                        </div>

                                                        @if (!string.IsNullOrEmpty(expiryDateString) && DateTime.TryParse(expiryDateString, out var expiryDate))
                                                        {
                                                            <div class="alert alert-light mt-3">
                                                                <i class="fas fa-clock me-2"></i>
                                                                <strong>Expires:</strong>
                                                                @expiryDate.ToString("MMMM dd, yyyy")
                                                            </div>
                                                        }
                                                        else if (announcement.ExpiryDate.HasValue)
                                                        {
                                                            <div class="alert alert-light mt-3">
                                                                <i class="fas fa-clock me-2"></i>
                                                                <strong>Current Expiry:</strong>
                                                                @announcement.ExpiryDate.Value.ToString("MMMM dd, yyyy")
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Status Information (Desktop) -->
                                        @if (announcement.ExpiryDate.HasValue && announcement.ExpiryDate < DateTime.UtcNow)
                                        {
                                            <div class="col-md-12 mb-4">
                                                <div class="alert alert-danger">
                                                    <i class="fas fa-exclamation-circle me-2"></i>
                                                    <strong>This announcement has expired!</strong>
                                                    <div class="mt-2">
                                                        <small>Expired on: @announcement.ExpiryDate.Value.ToString("MMMM dd, yyyy HH:mm")</small>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <!-- Form Actions (Desktop) -->
                                        <div class="col-md-12">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <button type="button"
                                                            class="btn btn-outline-secondary me-2"
                                                            @onclick="GoBack">
                                                        <i class="fas fa-times me-2"></i> Cancel
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-outline-danger"
                                                            @onclick="ConfirmDelete"
                                                            disabled="@isSubmitting">
                                                        <i class="fas fa-trash me-2"></i> Delete
                                                    </button>
                                                </div>
                                                <div>
                                                    <button type="button"
                                                            class="btn btn-outline-primary me-2"
                                                            @onclick="ResetForm"
                                                            disabled="@isSubmitting">
                                                        <i class="fas fa-redo me-2"></i> Reset
                                                    </button>
                                                    <button type="submit"
                                                            class="btn btn-primary"
                                                            disabled="@isSubmitting">
                                                        @if (isSubmitting)
                                                        {
                                                            <span>
                                                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                                Updating...
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span>
                                                                <i class="fas fa-save me-2"></i> Update Announcement
                                                            </span>
                                                        }
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private AnnouncementDto? announcement;
    private UpdateAnnouncementDto updatedAnnouncement = new UpdateAnnouncementDto();
    private bool isAuthenticated = false;
    private bool isAdmin = false;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showPreview = false;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();
    private string expiryDateString = "";
    private UserDto? currentUser = null;

    // Image upload related
    private string previewImageUrl = "";
    private string imageUploadError = "";
    private IBrowserFile? thumbnailFile;
    private bool hasRemovedExistingThumbnail = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
        if (isAdmin)
        {
            await LoadAnnouncement();
        }
        else
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (isAdmin && announcement != null)
        {
            await LoadAnnouncement();
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                currentUser = await GetUserFromStorage();

                if (currentUser == null)
                {
                    currentUser = await AuthService.GetCurrentUserAsync();
                    if (currentUser != null)
                    {
                        await JS.InvokeVoidAsync("localStorage.setItem", "currentUser",
                            System.Text.Json.JsonSerializer.Serialize(currentUser));
                    }
                }

                isAdmin = currentUser?.UserType == UserType.Admin;
            }
            else
            {
                currentUser = null;
                isAdmin = false;
                await JS.InvokeVoidAsync("localStorage.removeItem", "currentUser");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            isAdmin = false;
        }
    }

    private async Task<UserDto?> GetUserFromStorage()
    {
        try
        {
            var userJson = await JS.InvokeAsync<string>("localStorage.getItem", "currentUser");

            if (!string.IsNullOrEmpty(userJson))
            {
                return System.Text.Json.JsonSerializer.Deserialize<UserDto>(userJson);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting user from storage: {ex.Message}");
        }

        return null;
    }

    private void togglePreview()
    {
        showPreview = !showPreview;
    }

    private void TriggerFileUpload()
    {
        JS.InvokeVoidAsync("document.getElementById('mobile-thumbnail').click()");
    }

    private async Task LoadAnnouncement()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            announcement = await AnnouncementService.GetAnnouncementAsync(Id);

            if (announcement != null)
            {
                // Initialize update DTO with current values
                updatedAnnouncement = new UpdateAnnouncementDto
                {
                    Title = announcement.Title,
                    Content = announcement.Content,
                    IsImportant = announcement.IsImportant,
                    ExpiryDate = announcement.ExpiryDate,
                    ForAllUsers = announcement.ForAllUsers,
                    ForDoctorsOnly = announcement.ForDoctorsOnly,
                    ForRegularUsersOnly = announcement.ForRegularUsersOnly,
                    ImageAltText = announcement.ImageAltText
                };

                // Set expiry date string for date input
                if (announcement.ExpiryDate.HasValue)
                {
                    expiryDateString = announcement.ExpiryDate.Value.ToString("yyyy-MM-dd");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading announcement: {ex.Message}");

            // Check if it's an auth error
            if (ex.Message.Contains("401") || ex.Message.Contains("Unauthorized") || ex.Message.Contains("403"))
            {
                // Re-check authentication
                await CheckAuthentication();
            }
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ... (keep all your existing methods exactly as they are)
    private void OnTitleInput(ChangeEventArgs e)
    {
        updatedAnnouncement.Title = e.Value?.ToString();
        ClearValidation("Title");
    }

    private void OnContentInput(ChangeEventArgs e)
    {
        updatedAnnouncement.Content = e.Value?.ToString();
        ClearValidation("Content");
    }

    private void OnImageAltTextInput(ChangeEventArgs e)
    {
        updatedAnnouncement.ImageAltText = e.Value?.ToString();
    }

    private async Task HandleThumbnailUpload(InputFileChangeEventArgs e)
    {
        imageUploadError = "";
        var file = e.File;

        if (file.Size > 5 * 1024 * 1024)
        {
            imageUploadError = "File size must be less than 5MB";
            await ShowToast("error", imageUploadError);
            return;
        }

        var allowedTypes = new[] { "image/jpeg", "image/jpg", "image/png", "image/gif", "image/webp" };
        if (!allowedTypes.Contains(file.ContentType.ToLower()))
        {
            imageUploadError = "Please upload a JPG, JPEG, PNG, GIF, or WEBP file";
            await ShowToast("error", imageUploadError);
            return;
        }

        thumbnailFile = file;
        hasRemovedExistingThumbnail = false;

        try
        {
            var format = "image/jpeg";
            var resizedImage = await file.RequestImageFileAsync(format, 800, 450);
            var buffer = new byte[resizedImage.Size];
            await resizedImage.OpenReadStream().ReadAsync(buffer);
            previewImageUrl = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
        }
        catch (Exception ex)
        {
            imageUploadError = $"Error creating preview: {ex.Message}";
            Console.WriteLine($"Error creating preview: {ex.Message}");
        }

        StateHasChanged();
    }

    private void RemoveThumbnail()
    {
        thumbnailFile = null;
        previewImageUrl = "";
        imageUploadError = "";
        StateHasChanged();
    }

    private void RemoveExistingThumbnail()
    {
        hasRemovedExistingThumbnail = true;
        updatedAnnouncement.ImageAltText = "";
        StateHasChanged();
    }

    private void ToggleAudience(string audienceType)
    {
        // Reset all audience options
        updatedAnnouncement.ForAllUsers = false;
        updatedAnnouncement.ForDoctorsOnly = false;
        updatedAnnouncement.ForRegularUsersOnly = false;

        // Set the selected option
        switch (audienceType)
        {
            case "all":
                updatedAnnouncement.ForAllUsers = true;
                break;
            case "doctors":
                updatedAnnouncement.ForDoctorsOnly = true;
                break;
            case "regular":
                updatedAnnouncement.ForRegularUsersOnly = true;
                break;
        }
    }

    private string GetAudienceText()
    {
        if (updatedAnnouncement.ForAllUsers == true) return "All Users";
        if (updatedAnnouncement.ForDoctorsOnly == true) return "Doctors Only";
        if (updatedAnnouncement.ForRegularUsersOnly == true) return "Students Only";

        // Fallback to original announcement audience
        if (announcement != null)
        {
            if (announcement.ForAllUsers) return "All Users";
            if (announcement.ForDoctorsOnly) return "Doctors Only";
            if (announcement.ForRegularUsersOnly) return "Students Only";
        }

        return "No Audience Selected";
    }

    private string GetAudienceBadgeColor()
    {
        if (updatedAnnouncement.ForAllUsers == true) return "bg-primary";
        if (updatedAnnouncement.ForDoctorsOnly == true) return "bg-info";
        if (updatedAnnouncement.ForRegularUsersOnly == true) return "bg-success";

        // Fallback to original announcement audience
        if (announcement != null)
        {
            if (announcement.ForAllUsers) return "bg-primary";
            if (announcement.ForDoctorsOnly) return "bg-info";
            if (announcement.ForRegularUsersOnly) return "bg-success";
        }

        return "bg-secondary";
    }

    private string FormatContentPreview(string content)
    {
        if (string.IsNullOrEmpty(content))
            return "";

        // Replace newlines with <br> tags for HTML display
        return content.Replace("\n", "<br>");
    }

    private async Task HandleSubmit()
    {
        if (!ValidateForm())
            return;

        isSubmitting = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Parse expiry date if provided
            if (!string.IsNullOrEmpty(expiryDateString))
            {
                if (DateTime.TryParse(expiryDateString, out var expiryDate))
                {
                    updatedAnnouncement.ExpiryDate = expiryDate;
                }
            }
            else if (announcement?.ExpiryDate != null)
            {
                // Clear expiry date if user cleared the input
                updatedAnnouncement.ExpiryDate = null;
            }

            // Create multipart form data
            using var form = new MultipartFormDataContent();

            // Add all form fields as StringContent (only if they have values)
            if (!string.IsNullOrEmpty(updatedAnnouncement.Title))
            {
                form.Add(new StringContent(updatedAnnouncement.Title), "Title");
            }

            if (!string.IsNullOrEmpty(updatedAnnouncement.Content))
            {
                form.Add(new StringContent(updatedAnnouncement.Content), "Content");
            }

            if (updatedAnnouncement.IsImportant.HasValue)
            {
                form.Add(new StringContent(updatedAnnouncement.IsImportant.Value.ToString()), "IsImportant");
            }

            if (updatedAnnouncement.ForAllUsers.HasValue)
            {
                form.Add(new StringContent(updatedAnnouncement.ForAllUsers.Value.ToString()), "ForAllUsers");
            }

            if (updatedAnnouncement.ForDoctorsOnly.HasValue)
            {
                form.Add(new StringContent(updatedAnnouncement.ForDoctorsOnly.Value.ToString()), "ForDoctorsOnly");
            }

            if (updatedAnnouncement.ForRegularUsersOnly.HasValue)
            {
                form.Add(new StringContent(updatedAnnouncement.ForRegularUsersOnly.Value.ToString()), "ForRegularUsersOnly");
            }

            if (updatedAnnouncement.ExpiryDate.HasValue)
            {
                form.Add(new StringContent(updatedAnnouncement.ExpiryDate.Value.ToString("yyyy-MM-dd")), "ExpiryDate");
            }

            if (!string.IsNullOrEmpty(updatedAnnouncement.ImageAltText))
            {
                form.Add(new StringContent(updatedAnnouncement.ImageAltText), "ImageAltText");
            }

            // Add thumbnail file if provided
            if (thumbnailFile != null)
            {
                var fileContent = new StreamContent(thumbnailFile.OpenReadStream(5 * 1024 * 1024));
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(thumbnailFile.ContentType);
                form.Add(fileContent, "ThumbnailImage", thumbnailFile.Name);
            }

            // Add authentication token
            var token = await TokenService.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                _httpClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await _httpClient.PutAsync($"api/announcements/{Id}", form);

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Announcement updated successfully!");
                await ShowToast("success", "Announcement updated successfully!");
                Navigation.NavigateTo("/admin/announcements");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Failed to update announcement: {response.StatusCode}, {errorContent}");
                validationErrors["General"] = "Failed to update announcement. Please try again.";
                await ShowToast("error", "Failed to update announcement");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating announcement: {ex.Message}");
            validationErrors["General"] = "An error occurred while updating the announcement.";
            await ShowToast("error", $"Error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetForm()
    {
        if (announcement != null)
        {
            updatedAnnouncement = new UpdateAnnouncementDto
            {
                Title = announcement.Title,
                Content = announcement.Content,
                IsImportant = announcement.IsImportant,
                ExpiryDate = announcement.ExpiryDate,
                ForAllUsers = announcement.ForAllUsers,
                ForDoctorsOnly = announcement.ForDoctorsOnly,
                ForRegularUsersOnly = announcement.ForRegularUsersOnly,
                ImageAltText = announcement.ImageAltText
            };

            if (announcement.ExpiryDate.HasValue)
            {
                expiryDateString = announcement.ExpiryDate.Value.ToString("yyyy-MM-dd");
            }
            else
            {
                expiryDateString = "";
            }
        }

        thumbnailFile = null;
        previewImageUrl = "";
        imageUploadError = "";
        hasRemovedExistingThumbnail = false;
        validationErrors.Clear();

        StateHasChanged();
    }

    private bool ValidateForm()
    {
        validationErrors.Clear();

        // Title validation (if provided)
        if (!string.IsNullOrWhiteSpace(updatedAnnouncement.Title) && updatedAnnouncement.Title.Length > 200)
        {
            validationErrors["Title"] = "Title must be 200 characters or less";
        }

        // Content validation (if provided)
        if (!string.IsNullOrWhiteSpace(updatedAnnouncement.Content) && updatedAnnouncement.Content.Length > 4000)
        {
            validationErrors["Content"] = "Content must be 4000 characters or less";
        }

        return validationErrors.Count == 0;
    }

    private void ClearValidation(string fieldName)
    {
        if (validationErrors.ContainsKey(fieldName))
        {
            validationErrors.Remove(fieldName);
        }
    }

    private async Task ConfirmDelete()
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete this announcement?\n\n" +
            $"Title: {announcement?.Title}\n\n" +
            $"This action cannot be undone.");

        if (!confirm) return;

        try
        {
            var success = await AnnouncementService.DeleteAnnouncementAsync(Id);
            if (success)
            {
                Console.WriteLine("Announcement deleted successfully");
                await ShowToast("success", "Announcement deleted successfully");
                Navigation.NavigateTo("/admin/announcements");
            }
            else
            {
                Console.WriteLine("Failed to delete announcement");
                await ShowToast("error", "Failed to delete announcement");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting announcement: {ex.Message}");
            await ShowToast("error", $"Error: {ex.Message}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/announcements");
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private void NavigateToHome()
    {
        Navigation.NavigateTo("/");
    }

    private async Task ShowToast(string type, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", type, message);
        }
        catch
        {
            Console.WriteLine($"{type.ToUpper()}: {message}");
        }
    }

    // You need to inject HttpClient in your component
    [Inject] private HttpClient _httpClient { get; set; } = default!;
}
