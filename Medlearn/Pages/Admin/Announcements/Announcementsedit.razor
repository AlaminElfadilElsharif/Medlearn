@page "/admin/announcements/edit/{id:int}"


<PageTitle>Edit Announcement</PageTitle>

<div class="edit-announcement">
    <div class="container-fluid px-0 px-md-3">
        <!-- Header - Responsive -->
        <div class="row g-0 mb-3 mb-md-4">
            <div class="col-12">
                <!-- Mobile Header -->
                <div class="d-block d-md-none">
                    <div class="bg-primary text-white p-3">
                        <div class="d-flex align-items-center">
                            <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                                <i class="fas fa-arrow-left fa-lg"></i>
                            </button>
                            <h5 class="mb-0 flex-grow-1">Edit Announcement</h5>
                            <button class="btn btn-link text-white p-0" @onclick="ResetForm" disabled="@isSubmitting">
                                <i class="fas fa-redo fa-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Desktop Header -->
                <div class="d-none d-md-block">
                    <div class="d-flex align-items-center mb-3">
                        <button class="btn btn-outline-secondary me-3" @onclick="GoBack">
                            <i class="fas fa-arrow-left"></i>
                        </button>
                        <div>
                            <h1 class="mb-0">Edit Announcement</h1>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="/admin">Admin</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="/admin/announcements">Announcements</a>
                                    </li>
                                    <li class="breadcrumb-item active" aria-current="page">Edit</li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Show unauthorized message if not admin (same for both) -->
        @if (!isAuthenticated)
        {
            <div class="text-center py-5">
                <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                <h4>Authentication Required</h4>
                <p class="text-muted mb-4">Please log in to access this page</p>
                <button class="btn btn-primary" @onclick="NavigateToLogin">
                    <i class="fas fa-sign-in-alt me-2"></i> Go to Login
                </button>
            </div>
        }
        else if (!isAdmin)
        {
            <div class="text-center py-5">
                <i class="fas fa-ban fa-3x text-danger mb-3"></i>
                <h4>Access Denied</h4>
                <p class="text-muted mb-4">You don't have admin privileges to access this page</p>
                <button class="btn btn-primary" @onclick="NavigateToHome">
                    <i class="fas fa-home me-2"></i> Go to Home
                </button>
            </div>
        }
        else if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3">Loading announcement details...</p>
            </div>
        }
        else if (announcement == null)
        {
            <div class="text-center py-5">
                <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                <h4>Announcement Not Found</h4>
                <p class="text-muted mb-4">The announcement you're trying to edit doesn't exist or you don't have access to it.</p>
                <button class="btn btn-primary" @onclick="GoBack">
                    <i class="fas fa-arrow-left me-2"></i> Go Back
                </button>
            </div>
        }
        else
        {
            <!-- Form Content - Responsive Layouts -->
            <div class="row g-0 g-md-3 justify-content-center">
                <div class="col-12 col-lg-10">
                    <div class="card border-0 border-md">
                        <div class="card-body p-3 p-md-4">
                            @if (isSubmitting)
                            {
                                <div class="overlay-spinner">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Updating announcement...</span>
                                    </div>
                                </div>
                            }

                            <!-- Announcement Info - Mobile Compact -->
                            <div class="d-block d-md-none mb-3">
                                <div class="bg-light p-2 rounded small">
                                    <i class="fas fa-info-circle me-1 text-primary"></i>
                                    Created: @announcement.CreatedAt.ToString("MMM dd, yyyy")
                                    <span class="mx-2">|</span>
                                    By: @announcement.CreatedByAdmin?.FirstName?.Substring(0, 1).
                                </div>
                            </div>

                            <!-- Announcement Info - Desktop Full -->
                            <div class="d-none d-md-block alert alert-info mb-4">
                                <div class="d-flex">
                                    <i class="fas fa-info-circle fa-2x me-3 mt-1"></i>
                                    <div>
                                        <h6 class="alert-heading">Announcement Information</h6>
                                        <div class="row mt-2">
                                            <div class="col-md-6">
                                                <small><strong>Created:</strong> @announcement.CreatedAt.ToString("MMMM dd, yyyy HH:mm")</small>
                                            </div>
                                            <div class="col-md-6">
                                                <small><strong>By:</strong> @announcement.CreatedByAdmin?.FirstName @announcement.CreatedByAdmin?.LastName</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <form @onsubmit="HandleSubmit" enctype="multipart/form-data">
                                <!-- Mobile View (Stacked Layout) -->
                                <div class="d-block d-md-none">
                                    <!-- Basic Info Section -->
                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-3">
                                            <i class="fas fa-info-circle me-2 text-primary"></i>Basic Information
                                        </h6>

                                        <!-- Title (Mobile) -->
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold" for="mobile-title">
                                                Title <span class="text-danger">*</span>
                                            </label>
                                            <input type="text"
                                                   class="form-control form-control-sm @(validationErrors.ContainsKey("Title") ? "is-invalid" : "")"
                                                   id="mobile-title"
                                                   @bind="updatedAnnouncement.Title"
                                                   @oninput="OnTitleInput"
                                                   maxlength="200"
                                                   placeholder="Enter announcement title"
                                                   required />
                                            @if (validationErrors.ContainsKey("Title"))
                                            {
                                                <div class="invalid-feedback small">
                                                    @validationErrors["Title"]
                                                </div>
                                            }
                                            <small class="form-text text-muted small">@(updatedAnnouncement.Title?.Length ?? 0)/200</small>
                                        </div>

                                        <!-- Content (Mobile) -->
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold" for="mobile-content">
                                                Content <span class="text-danger">*</span>
                                            </label>
                                            <textarea class="form-control form-control-sm @(validationErrors.ContainsKey("Content") ? "is-invalid" : "")"
                                                      id="mobile-content"
                                                      @bind="updatedAnnouncement.Content"
                                                      @oninput="OnContentInput"
                                                      rows="4"
                                                      maxlength="4000"
                                                      placeholder="Write your announcement content here..."
                                                      required></textarea>
                                            @if (validationErrors.ContainsKey("Content"))
                                            {
                                                <div class="invalid-feedback small">
                                                    @validationErrors["Content"]
                                                </div>
                                            }
                                            <small class="form-text text-muted small">@(updatedAnnouncement.Content?.Length ?? 0)/4000</small>
                                        </div>
                                    </div>

                                    <!-- Image Section (Mobile) -->
                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-3">
                                            <i class="fas fa-image me-2 text-primary"></i>Thumbnail Image
                                        </h6>

                                        <!-- Mobile Image Display -->
                                        <div class="mb-3">
                                            @if (!string.IsNullOrEmpty(previewImageUrl))
                                            {
                                                <div class="position-relative mb-2">
                                                    <img src="@previewImageUrl" class="img-fluid rounded w-100"
                                                         alt="Thumbnail preview" style="max-height: 150px; object-fit: cover;" />
                                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2"
                                                            @onclick="RemoveThumbnail">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            }
                                            else if (!string.IsNullOrEmpty(announcement.ThumbnailUrl) && !hasRemovedExistingThumbnail)
                                            {
                                                <div class="position-relative mb-2">
                                                    <img src="@announcement.ThumbnailUrl" class="img-fluid rounded w-100"
                                                         alt="@announcement.ImageAltText" style="max-height: 150px; object-fit: cover;" />
                                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2"
                                                            @onclick="RemoveExistingThumbnail">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                                @if (!string.IsNullOrEmpty(announcement.ImageAltText))
                                                {
                                                    <small class="text-muted d-block mb-2">
                                                        <i class="fas fa-info-circle me-1"></i> @announcement.ImageAltText
                                                    </small>
                                                }
                                            }
                                            else
                                            {
                                                <div class="upload-area mb-2 p-3 text-center border rounded bg-light"
                                                     @onclick="TriggerFileUpload">
                                                    <i class="fas fa-cloud-upload-alt fa-2x text-muted mb-2"></i>
                                                    <p class="small mb-1">Tap to upload image</p>
                                                    <p class="text-muted small mb-0">JPG, PNG, GIF (Max 5MB)</p>
                                                </div>
                                            }

                                            <InputFile id="mobile-thumbnail" class="d-none"
                                                       OnChange="HandleThumbnailUpload"
                                                       accept="image/png, image/jpeg, image/jpg, image/gif, image/webp" />

                                            @if (!string.IsNullOrEmpty(imageUploadError))
                                            {
                                                <div class="alert alert-danger p-2 small mt-2">
                                                    <i class="fas fa-exclamation-circle me-1"></i>
                                                    @imageUploadError
                                                </div>
                                            }

                                            <!-- Image Alt Text (Mobile) -->
                                            <div class="mt-2">
                                                <label class="form-label small" for="mobile-alt-text">Image Description</label>
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       id="mobile-alt-text"
                                                       placeholder="Describe the image"
                                                       @bind="updatedAnnouncement.ImageAltText"
                                                       @oninput="OnImageAltTextInput" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Settings Section (Mobile) -->
                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-3">
                                            <i class="fas fa-cog me-2 text-primary"></i>Settings
                                        </h6>

                                        <!-- Importance Toggle (Mobile) -->
                                        <div class="mb-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       id="mobile-important"
                                                       @bind="updatedAnnouncement.IsImportant" />
                                                <label class="form-check-label small" for="mobile-important">
                                                    Mark as Important
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Expiry Date (Mobile) -->
                                        <div class="mb-3">
                                            <label class="form-label small" for="mobile-expiry">Expiry Date (Optional)</label>
                                            <input type="date"
                                                   class="form-control form-control-sm"
                                                   id="mobile-expiry"
                                                   value="@expiryDateString"
                                                   @onchange="@((ChangeEventArgs e) => expiryDateString = e.Value?.ToString())"
                                                   min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                        </div>
                                    </div>

                                    <!-- Audience Selection (Mobile) -->
                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-3">
                                            <i class="fas fa-users me-2 text-primary"></i>Target Audience
                                            <span class="text-danger">*</span>
                                        </h6>

                                        <div class="btn-group-vertical w-100 gap-2" role="group">
                                            <button type="button"
                                                    class="btn @(updatedAnnouncement.ForAllUsers == true ? "btn-primary" : "btn-outline-primary") text-start d-flex align-items-center"
                                                    @onclick='() => ToggleAudience("all")'>
                                                <i class="fas fa-users me-2"></i>
                                                <span class="flex-grow-1">All Users</span>
                                                @if (updatedAnnouncement.ForAllUsers == true)
                                                {
                                                    <i class="fas fa-check"></i>
                                                }
                                            </button>
                                            <button type="button"
                                                    class="btn @(updatedAnnouncement.ForDoctorsOnly == true ? "btn-info" : "btn-outline-info") text-start d-flex align-items-center"
                                                    @onclick='() => ToggleAudience("doctors")'>
                                                <i class="fas fa-user-md me-2"></i>
                                                <span class="flex-grow-1">Doctors Only</span>
                                                @if (updatedAnnouncement.ForDoctorsOnly == true)
                                                {
                                                    <i class="fas fa-check"></i>
                                                }
                                            </button>
                                            <button type="button"
                                                    class="btn @(updatedAnnouncement.ForRegularUsersOnly == true ? "btn-success" : "btn-outline-success") text-start d-flex align-items-center"
                                                    @onclick='() => ToggleAudience("regular")'>
                                                <i class="fas fa-user-graduate me-2"></i>
                                                <span class="flex-grow-1">Students Only</span>
                                                @if (updatedAnnouncement.ForRegularUsersOnly == true)
                                                {
                                                    <i class="fas fa-check"></i>
                                                }
                                            </button>
                                        </div>

                                        @if (validationErrors.ContainsKey("Audience"))
                                        {
                                            <div class="alert alert-danger small mt-2 p-2">
                                                @validationErrors["Audience"]
                                            </div>
                                        }
                                    </div>

                                    <!-- Status Warning (Mobile) -->
                                    @if (announcement.ExpiryDate.HasValue && announcement.ExpiryDate < DateTime.UtcNow)
                                    {
                                        <div class="mb-4">
                                            <div class="alert alert-danger p-2 small">
                                                <i class="fas fa-exclamation-circle me-2"></i>
                                                <strong>Expired!</strong> This announcement expired on @announcement.ExpiryDate.Value.ToString("MMM dd, yyyy")
                                            </div>
                                        </div>
                                    }

                                    <!-- Preview Section (Mobile - Collapsible) -->
                                    <div class="mb-4">
                                        <div class="card">
                                            <div class="card-header p-2 bg-light"
                                                 @onclick="togglePreview"
                                                 style="cursor: pointer;">
                                                <h6 class="mb-0 d-flex justify-content-between align-items-center">
                                                    <span>
                                                        <i class="fas fa-eye me-2 text-primary"></i>Preview
                                                    </span>
                                                    <i class="fas @(showPreview ? "fa-chevron-up" : "fa-chevron-down")"></i>
                                                </h6>
                                            </div>
                                            @if (showPreview)
                                            {
                                                <div class="card-body p-2">
                                                    <div class="announcement-preview small">
                                                        @if (updatedAnnouncement.IsImportant == true)
                                                        {
                                                            <div class="alert alert-warning p-2 mb-2">
                                                                <i class="fas fa-exclamation-triangle me-2"></i>
                                                                <small><strong>Important</strong></small>
                                                            </div>
                                                        }

                                                        <h6 class="fw-bold">@(updatedAnnouncement.Title ?? announcement.Title)</h6>

                                                        @if (!string.IsNullOrEmpty(previewImageUrl))
                                                        {
                                                            <div class="mb-2">
                                                                <img src="@previewImageUrl" class="img-fluid rounded"
                                                                     alt="@updatedAnnouncement.ImageAltText"
                                                                     style="max-height: 100px;" />
                                                            </div>
                                                        }
                                                        else if (!string.IsNullOrEmpty(announcement.ThumbnailUrl) && !hasRemovedExistingThumbnail)
                                                        {
                                                            <div class="mb-2">
                                                                <img src="@announcement.ThumbnailUrl" class="img-fluid rounded"
                                                                     alt="@announcement.ImageAltText"
                                                                     style="max-height: 100px;" />
                                                            </div>
                                                        }

                                                        <div class="preview-meta mb-2">
                                                            <span class="badge bg-secondary me-1 small">
                                                                @DateTime.Now.ToString("MMM dd")
                                                            </span>
                                                            <span class="badge @GetAudienceBadgeColor() small">
                                                                @GetAudienceText()
                                                            </span>
                                                        </div>
                                                        <div class="preview-content small">
                                                            @((MarkupString)FormatContentPreview(updatedAnnouncement.Content ?? announcement.Content))
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Action Buttons (Mobile - Fixed Bottom) -->
                                    <div class="fixed-bottom d-block d-md-none p-3 bg-white border-top">
                                        <div class="d-flex gap-2">
                                            <button type="button"
                                                    class="btn btn-outline-danger flex-fill"
                                                    @onclick="ConfirmDelete"
                                                    disabled="@isSubmitting">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-outline-secondary flex-fill"
                                                    @onclick="GoBack">
                                                Cancel
                                            </button>
                                            <button type="submit"
                                                    class="btn btn-primary flex-fill"
                                                    disabled="@isSubmitting">
                                                @if (isSubmitting)
                                                {
                                                    <span class="spinner-border spinner-border-sm"></span>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-save"></i>
                                                }
                                                Update
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Spacer for mobile fixed button -->
                                    <div class="mb-5 pb-3 d-block d-md-none"></div>
                                </div>

                                <!-- Desktop View (Original Layout Enhanced) -->
                                <div class="d-none d-md-block">
                                    <div class="row">
                                        <!-- Title -->
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label" for="title">
                                                Title <span class="text-danger">*</span>
                                            </label>
                                            <input type="text"
                                                   class="form-control @(validationErrors.ContainsKey("Title") ? "is-invalid" : "")"
                                                   id="title"
                                                   @bind="updatedAnnouncement.Title"
                                                   @oninput="OnTitleInput"
                                                   maxlength="200"
                                                   required />
                                            @if (validationErrors.ContainsKey("Title"))
                                            {
                                                <div class="invalid-feedback">
                                                    @validationErrors["Title"]
                                                </div>
                                            }
                                            <small class="form-text text-muted">
                                                Maximum 200 characters
                                            </small>
                                        </div>

                                        <!-- Content -->
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label" for="content">
                                                Content <span class="text-danger">*</span>
                                            </label>
                                            <textarea class="form-control @(validationErrors.ContainsKey("Content") ? "is-invalid" : "")"
                                                      id="content"
                                                      @bind="updatedAnnouncement.Content"
                                                      @oninput="OnContentInput"
                                                      rows="6"
                                                      maxlength="4000"
                                                      required></textarea>
                                            @if (validationErrors.ContainsKey("Content"))
                                            {
                                                <div class="invalid-feedback">
                                                    @validationErrors["Content"]
                                                </div>
                                            }
                                            <small class="form-text text-muted">
                                                Maximum 4000 characters
                                            </small>
                                        </div>

                                        <!-- Thumbnail Upload (Desktop) -->
                                        <div class="col-md-12 mb-4">
                                            <hr />
                                            <h5>Thumbnail Image</h5>
                                            <div class="row align-items-center">
                                                <div class="col-md-4">
                                                    @if (!string.IsNullOrEmpty(previewImageUrl))
                                                    {
                                                        <div class="thumbnail-preview mb-3">
                                                            <img src="@previewImageUrl" class="img-fluid rounded"
                                                                 alt="Thumbnail preview" style="max-height: 200px;" />
                                                            <button type="button" class="btn btn-sm btn-danger mt-2"
                                                                    @onclick="RemoveThumbnail">
                                                                <i class="fas fa-trash me-1"></i> Remove
                                                            </button>
                                                        </div>
                                                    }
                                                    else if (!string.IsNullOrEmpty(announcement.ThumbnailUrl) && !hasRemovedExistingThumbnail)
                                                    {
                                                        <div class="thumbnail-preview mb-3">
                                                            <img src="@announcement.ThumbnailUrl" class="img-fluid rounded"
                                                                 alt="@announcement.ImageAltText" style="max-height: 200px;" />
                                                            <div class="mt-2">
                                                                <small class="text-muted">Current thumbnail</small>
                                                                @if (!string.IsNullOrEmpty(announcement.ImageAltText))
                                                                {
                                                                    <div class="text-muted small">
                                                                        <i class="fas fa-info-circle me-1"></i> @announcement.ImageAltText
                                                                    </div>
                                                                }
                                                                <button type="button" class="btn btn-sm btn-outline-danger mt-1"
                                                                        @onclick="RemoveExistingThumbnail">
                                                                    <i class="fas fa-trash me-1"></i> Remove
                                                                </button>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="thumbnail-preview mb-3">
                                                            <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                                                 style="height: 150px; border: 2px dashed #dee2e6;">
                                                                <div class="text-center">
                                                                    <i class="fas fa-image fa-2x text-muted mb-2"></i>
                                                                    <p class="text-muted small mb-0">No Thumbnail</p>
                                                                    <p class="text-muted small">Optional</p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="col-md-8">
                                                    <div class="mb-3">
                                                        <label class="form-label">Upload New Thumbnail Image</label>
                                                        <InputFile id="thumbnail" class="form-control"
                                                                   OnChange="HandleThumbnailUpload"
                                                                   accept="image/png, image/jpeg, image/jpg, image/gif, image/webp" />
                                                        <div class="form-text">
                                                            Optional. Recommended: 1280x720px, JPG, PNG, or GIF format, max 5MB
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(imageUploadError))
                                                        {
                                                            <div class="alert alert-danger p-2 mt-2">
                                                                <i class="fas fa-exclamation-circle me-2"></i>
                                                                @imageUploadError
                                                            </div>
                                                        }
                                                        @if (thumbnailFile != null)
                                                        {
                                                            <div class="alert alert-info mt-2 p-2">
                                                                <i class="fas fa-check-circle me-2 text-success"></i>
                                                                File selected: @thumbnailFile.Name (@((thumbnailFile.Size / 1024).ToString("N0")) KB)
                                                            </div>
                                                        }
                                                    </div>

                                                    <!-- Image Alt Text -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="imageAltText">Image Description (Alt Text)</label>
                                                        <input type="text"
                                                               class="form-control"
                                                               id="imageAltText"
                                                               placeholder="Describe the image for accessibility"
                                                               @bind="updatedAnnouncement.ImageAltText"
                                                               @oninput="OnImageAltTextInput" />
                                                        <div class="form-text">
                                                            Optional. Helps visually impaired users understand the image content
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Importance and Expiry -->
                                        <div class="col-md-6 mb-3">
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       id="isImportant"
                                                       @bind="updatedAnnouncement.IsImportant" />
                                                <label class="form-check-label" for="isImportant">
                                                    Mark as Important
                                                </label>
                                            </div>
                                            <small class="form-text text-muted">
                                                Important announcements will be highlighted
                                            </small>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" for="expiryDate">
                                                Expiry Date (Optional)
                                            </label>
                                            <input type="date"
                                                   class="form-control"
                                                   id="expiryDate"
                                                   value="@expiryDateString"
                                                   @onchange="@((ChangeEventArgs e) => expiryDateString = e.Value?.ToString())"
                                                   min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                            <small class="form-text text-muted">
                                                Announcement will automatically expire on this date
                                            </small>
                                        </div>

                                        <!-- Audience Selection (Desktop) -->
                                        <div class="col-md-12 mb-4">
                                            <label class="form-label d-block">
                                                Target Audience <span class="text-danger">*</span>
                                            </label>
                                            <div class="alert alert-info">
                                                <i class="fas fa-info-circle me-2"></i>
