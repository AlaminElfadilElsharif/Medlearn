@code {
    [Parameter] public int Id { get; set; }

    private AnnouncementDto? announcement;
    private List<AnnouncementDto> relatedAnnouncements = new List<AnnouncementDto>();
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private bool hasAccess = false;
    private bool isAdmin = false;
    private bool isExpired = false;
    private int totalViews = 0;
    private string lastUpdated = "";
    private UserDto? currentUser = null;
    private DateTime? lastViewed = null;

    // ... (keep all your existing methods exactly as they are)
    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
        if (isAuthenticated)
        {
            await LoadAnnouncement();
            await LoadRelatedAnnouncements();
        }
        else
        {
            isLoading = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (isAuthenticated && Id > 0)
        {
            await LoadAnnouncement();
            await LoadRelatedAnnouncements();
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                currentUser = await GetUserFromStorage();

                if (currentUser == null)
                {
                    currentUser = await AuthService.GetCurrentUserAsync();
                    if (currentUser != null)
                    {
                        await JS.InvokeVoidAsync("localStorage.setItem", "currentUser",
                            System.Text.Json.JsonSerializer.Serialize(currentUser));
                    }
                }

                isAdmin = currentUser?.UserType == UserType.Admin;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            isAdmin = false;
        }
    }

    private async Task<UserDto?> GetUserFromStorage()
    {
        try
        {
            var userJson = await JS.InvokeAsync<string>("localStorage.getItem", "currentUser");

            if (!string.IsNullOrEmpty(userJson))
            {
                return System.Text.Json.JsonSerializer.Deserialize<UserDto>(userJson);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting user from storage: {ex.Message}");
        }

        return null;
    }

    private async Task LoadAnnouncement()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            announcement = await AnnouncementService.GetAnnouncementAsync(Id);

            if (announcement != null)
            {
                // Check if user has access
                hasAccess = CheckAccess(announcement);

                if (!hasAccess)
                {
                    isLoading = false;
                    return;
                }

                // Check if announcement is expired
                isExpired = announcement.ExpiryDate.HasValue &&
                           announcement.ExpiryDate.Value < DateTime.UtcNow;

                // Simulate view count (in a real app, this would come from the API)
                totalViews = new Random().Next(50, 500);

                // Calculate last updated
                var timeSinceUpdate = DateTime.UtcNow - announcement.CreatedAt;
                if (timeSinceUpdate.TotalDays < 1)
                {
                    lastUpdated = "Today";
                }
                else if (timeSinceUpdate.TotalDays < 7)
                {
                    lastUpdated = $"{(int)timeSinceUpdate.TotalDays} days ago";
                }
                else if (timeSinceUpdate.TotalDays < 30)
                {
                    lastUpdated = $"{(int)(timeSinceUpdate.TotalDays / 7)} weeks ago";
                }
                else
                {
                    lastUpdated = announcement.CreatedAt.ToString("MMMM dd, yyyy");
                }

                // Track view time
                lastViewed = DateTime.Now;

                // Save to recently viewed
                await SaveToRecentlyViewed();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading announcement: {ex.Message}");

            // Check if it's an access denied error
            if (ex.Message.Contains("403") || ex.Message.Contains("Forbidden"))
            {
                hasAccess = false;
            }
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool CheckAccess(AnnouncementDto announcement)
    {
        if (isAdmin) return true;

        if (currentUser == null) return false;

        // Check expiry
        if (announcement.ExpiryDate.HasValue && announcement.ExpiryDate.Value < DateTime.UtcNow)
        {
            return false;
        }

        // Check audience
        if (announcement.ForAllUsers) return true;

        if (currentUser.UserType == UserType.Doctor && announcement.ForDoctorsOnly) return true;

        if (currentUser.UserType == UserType.User && announcement.ForRegularUsersOnly) return true;

        return false;
    }

    private async Task LoadRelatedAnnouncements()
    {
        try
        {
            var allAnnouncements = await AnnouncementService.GetAnnouncementsAsync();

            if (allAnnouncements != null && announcement != null)
            {
                // Get announcements with same audience and not the current one
                relatedAnnouncements = allAnnouncements
                    .Where(a => a.Id != announcement.Id &&
                               ((a.ForAllUsers && announcement.ForAllUsers) ||
                                (a.ForDoctorsOnly && announcement.ForDoctorsOnly) ||
                                (a.ForRegularUsersOnly && announcement.ForRegularUsersOnly)))
                    .OrderByDescending(a => a.CreatedAt)
                    .Take(4)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading related announcements: {ex.Message}");
        }
    }

    private string GetAudienceText()
    {
        if (announcement == null) return "";

        if (announcement.ForAllUsers) return "All Users";
        if (announcement.ForDoctorsOnly) return "Doctors Only";
        if (announcement.ForRegularUsersOnly) return "Students Only";
        return "Specific Audience";
    }

    private string GetAudienceBadgeColor()
    {
        if (announcement == null) return "bg-secondary";

        if (announcement.ForAllUsers) return "bg-primary";
        if (announcement.ForDoctorsOnly) return "bg-info";
        if (announcement.ForRegularUsersOnly) return "bg-success";
        return "bg-secondary";
    }

    private string FormatContent(string content)
    {
        if (string.IsNullOrEmpty(content))
            return "";

        // Replace newlines with <br> tags for HTML display
        var formattedContent = content.Replace("\n", "<br>");

        // Add paragraphs for better readability
        formattedContent = $"<p>{formattedContent}</p>";
        formattedContent = formattedContent.Replace("<br><br>", "</p><p>");

        return formattedContent;
    }

    private string GetDaysRemaining()
    {
        if (announcement == null || !announcement.ExpiryDate.HasValue)
            return "∞";

        var daysRemaining = (announcement.ExpiryDate.Value - DateTime.UtcNow).Days;
        return daysRemaining > 0 ? daysRemaining.ToString() : "0";
    }

    private async Task SaveToRecentlyViewed()
    {
        try
        {
            var recentlyViewed = new List<RecentlyViewedAnnouncement>();

            // Get existing recently viewed
            var existingJson = await JS.InvokeAsync<string>("localStorage.getItem", "recently_viewed_announcements");
            if (!string.IsNullOrEmpty(existingJson))
            {
                recentlyViewed = System.Text.Json.JsonSerializer.Deserialize<List<RecentlyViewedAnnouncement>>(existingJson)
                              ?? new List<RecentlyViewedAnnouncement>();
            }

            // Remove if already exists
            recentlyViewed.RemoveAll(r => r.Id == Id);

            // Add to beginning
            recentlyViewed.Insert(0, new RecentlyViewedAnnouncement
            {
                Id = Id,
                Title = announcement?.Title ?? "",
                ThumbnailUrl = announcement?.ThumbnailUrl ?? "",
                ViewedAt = DateTime.Now
            });

            // Keep only last 10
            if (recentlyViewed.Count > 10)
            {
                recentlyViewed = recentlyViewed.Take(10).ToList();
            }

            // Save back to localStorage
            await JS.InvokeVoidAsync("localStorage.setItem",
                "recently_viewed_announcements",
                System.Text.Json.JsonSerializer.Serialize(recentlyViewed));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving to recently viewed: {ex.Message}");
        }
    }

    private async Task PrintAnnouncement()
    {
        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing announcement: {ex.Message}");
        }
    }

    private async Task ShareAnnouncement()
    {
        try
        {
            var url = Navigation.Uri;
            var title = announcement?.Title ?? "Announcement";
            var text = TruncateText(announcement?.Content ?? "", 100);
            var imageUrl = announcement?.ThumbnailUrl ?? "";

            if (await JS.InvokeAsync<bool>("checkShareAPI"))
            {
                await JS.InvokeVoidAsync("shareContent", title, text, url, imageUrl);
            }
            else
            {
                await JS.InvokeVoidAsync("copyToClipboard", url);
                await ShowToast("success", "Link copied to clipboard!");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sharing announcement: {ex.Message}");
            await ShowToast("error", "Failed to share announcement");
        }
    }

    private async Task ConfirmDelete()
    {
        if (announcement == null) return;

        bool confirm = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete this announcement?\n\n" +
            $"Title: {announcement.Title}\n\n" +
            $"This action cannot be undone.");

        if (!confirm) return;

        try
        {
            var success = await AnnouncementService.DeleteAnnouncementAsync(Id);
            if (success)
            {
                await ShowToast("success", "Announcement deleted successfully");
                Navigation.NavigateTo("/announcements");
            }
            else
            {
                await ShowToast("error", "Failed to delete announcement");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting announcement: {ex.Message}");
            await ShowToast("error", $"Error: {ex.Message}");
        }
    }

