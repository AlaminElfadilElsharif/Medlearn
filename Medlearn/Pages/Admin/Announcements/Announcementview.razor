    private string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
            return text;

        return text.Substring(0, maxLength) + "...";
    }

    private async Task ShowToast(string type, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", type, message);
        }
        catch
        {
            Console.WriteLine($"{type.ToUpper()}: {message}");
        }
    }

    // Helper class for recently viewed
    private class RecentlyViewedAnnouncement
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string? ThumbnailUrl { get; set; }
        public DateTime ViewedAt { get; set; }
