@code {
    private List<WithdrawalRequestDto> withdrawals = new();
    private bool isLoading = true;
    private bool isProcessing = false;

    // Mobile specific
    private bool showMobileFilters = false;
    private bool showMobileActionSheet = false;

    // Pagination
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalItems = 0;
    private const int pageSize = 10;

    // Filters
    private string selectedStatus = "";
    private string searchTerm = "";
    private Timer? searchTimer;

    // Stats
    private int pendingCount = 0;
    private int approvedCount = 0;
    private int rejectedCount = 0;
    private decimal totalAmount = 0;

    // Modal state
    private bool showApproveModal = false;
    private bool showRejectModal = false;
    private WithdrawalRequestDto? selectedWithdrawal = null;
    private string notes = "";

    protected override async Task OnInitializedAsync()
    {
        await CheckAuth();
        await LoadWithdrawals();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin");
    }

    private void ToggleMobileActionSheet()
    {
        showMobileActionSheet = !showMobileActionSheet;
        StateHasChanged();
    }

    private void CloseMobileActionSheet()
    {
        showMobileActionSheet = false;
        StateHasChanged();
    }

    private void toggleMobileFilters()
    {
        showMobileFilters = !showMobileFilters;
        StateHasChanged();
    }

    private async Task CheckAuth()
    {
        try
        {
            var isAuthenticated = await TokenService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/account/login?returnUrl=/admin/withdrawals");
                return;
            }

            var user = await AuthService.GetCurrentUserAsync();
            if (user?.UserType != UserType.Admin)
            {
                await ShowError("Access denied. Admin privileges required.");
                Navigation.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Auth check error: {ex.Message}");
            Navigation.NavigateTo("/account/login");
        }
    }

    private async Task LoadWithdrawals()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            WithdrawalStatus? status = null;
            if (!string.IsNullOrEmpty(selectedStatus))
            {
                status = (WithdrawalStatus)int.Parse(selectedStatus);
            }

            var result = await WithdrawalService.GetAdminWithdrawalsAsync(
                status: status,
                search: string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                page: currentPage,
                pageSize: pageSize
            );

            if (result != null)
            {
                withdrawals = result;
                totalItems = withdrawals.Count;
                CalculateStats();
                totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);

                if (currentPage > totalPages && totalPages > 0)
                {
                    currentPage = totalPages;
                    await LoadWithdrawals();
                    return;
                }
            }
            else
            {
                withdrawals = new List<WithdrawalRequestDto>();
                totalItems = 0;
                totalPages = 1;
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Failed to load withdrawals: {ex.Message}");
            withdrawals = new List<WithdrawalRequestDto>();
        }
        finally
        {
            isLoading = false;
            showMobileFilters = false;
            showMobileActionSheet = false;
            StateHasChanged();
        }
    }

    private void CalculateStats()
    {
        pendingCount = withdrawals.Count(w => w.Status == WithdrawalStatus.Pending);
        approvedCount = withdrawals.Count(w => w.Status == WithdrawalStatus.Approved);
        rejectedCount = withdrawals.Count(w => w.Status == WithdrawalStatus.Rejected);
        totalAmount = withdrawals.Sum(w => w.Amount);
    }

    private string GetStatusBadgeClass(WithdrawalStatus status)
    {
        return status switch
        {
            WithdrawalStatus.Pending => "badge bg-warning",
            WithdrawalStatus.Approved => "badge bg-success",
            WithdrawalStatus.Rejected => "badge bg-danger",
            _ => "badge bg-secondary"
        };
    }

    private string GetStatusText(WithdrawalStatus status)
    {
        return status.ToString();
    }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages && page != currentPage)
        {
            currentPage = page;
            await LoadWithdrawals();
        }
    }

    private void OnFilterChanged(ChangeEventArgs e)
    {
        selectedStatus = e.Value?.ToString() ?? "";
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadWithdrawals();
        }
        else if (searchTimer != null)
        {
            searchTimer.Dispose();
        }

        // Debounce search
        searchTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                currentPage = 1;
                await LoadWithdrawals();
            });
        }, null, 500, Timeout.Infinite);
    }

    private void ViewDetails(int withdrawalId)
    {
        Navigation.NavigateTo($"/admin/withdrawals/{withdrawalId}");
    }

    private void ShowApproveModal(WithdrawalRequestDto withdrawal)
    {
        selectedWithdrawal = withdrawal;
        notes = "";
        showApproveModal = true;
        StateHasChanged();
    }

    private void ShowRejectModal(WithdrawalRequestDto withdrawal)
    {
        selectedWithdrawal = withdrawal;
        notes = "";
        showRejectModal = true;
        StateHasChanged();
    }

    private void CloseModals()
    {
        showApproveModal = false;
        showRejectModal = false;
        selectedWithdrawal = null;
        notes = "";
        StateHasChanged();
    }

    private async Task ApproveWithdrawal()
    {
        if (selectedWithdrawal == null) return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            var dto = new ProcessWithdrawalDto
            {
                Status = WithdrawalStatus.Approved,
                Notes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim()
            };

            var success = await WithdrawalService.ProcessWithdrawalAsync(selectedWithdrawal.Id, dto);

            if (success)
            {
                await ShowSuccess($"Withdrawal #{selectedWithdrawal.Id} approved successfully!");
                CloseModals();
                await LoadWithdrawals();
            }
            else
            {
                await ShowError("Failed to approve withdrawal. Please try again.");
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task RejectWithdrawal()
    {
        if (selectedWithdrawal == null || string.IsNullOrWhiteSpace(notes)) return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            var dto = new ProcessWithdrawalDto
            {
                Status = WithdrawalStatus.Rejected,
                Notes = notes.Trim()
            };

            var success = await WithdrawalService.ProcessWithdrawalAsync(selectedWithdrawal.Id, dto);

            if (success)
            {
                await ShowSuccess($"Withdrawal #{selectedWithdrawal.Id} rejected successfully!");
                CloseModals();
                await LoadWithdrawals();
            }
            else
            {
                await ShowError("Failed to reject withdrawal. Please try again.");
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadWithdrawals();
        await ShowSuccess("Data refreshed successfully!");
    }

    private async Task ClearFilters()
    {
        selectedStatus = "";
        searchTerm = "";
        currentPage = 1;
        await LoadWithdrawals();
        await ShowSuccess("Filters cleared");
    }

    private async Task ExportToCSV()
    {
        try
        {
            if (!withdrawals.Any())
            {
                await ShowError("No data to export");
                return;
            }

            var csvContent = "ID,Doctor Name,Doctor Email,Amount,Payment Method,Account Details,Status,Request Date,Processed Date,Processed By,Notes\n";

            foreach (var w in withdrawals.OrderByDescending(w => w.RequestDate))
            {
                var processedBy = w.ProcessedByAdmin != null ?
                    $"{w.ProcessedByAdmin.FirstName} {w.ProcessedByAdmin.LastName}" : "";
                var processedDate = w.ProcessedDate?.ToString("yyyy-MM-dd HH:mm:ss") ?? "";
                var safeNotes = w.Notes?.Replace("\"", "\"\"")?.Replace("\n", " ") ?? "";
                var safeAccountDetails = w.AccountDetails?.Replace("\"", "\"\"")?.Replace("\n", " ") ?? "";

                csvContent += $"{w.Id},\"{w.Doctor.FirstName} {w.Doctor.LastName}\",{w.Doctor.Email},{w.Amount},\"{w.PaymentMethod}\",\"{safeAccountDetails}\",{w.Status},{w.RequestDate:yyyy-MM-dd HH:mm:ss},{processedDate},\"{processedBy}\",\"{safeNotes}\"\n";
            }

            var fileName = $"withdrawals_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await JS.InvokeVoidAsync("downloadFile", fileName, "text/csv", csvContent);

            await ShowSuccess("CSV exported successfully!");
        }
        catch (Exception ex)
        {
            await ShowError($"Failed to export CSV: {ex.Message}");
        }
    }

    private async Task ShowSuccess(string message)
    {
        await JS.InvokeVoidAsync("showToast", "success", message);
    }

    private async Task ShowError(string message)
    {
        await JS.InvokeVoidAsync("showToast", "error", message);
    }

    public void Dispose()
    {
        searchTimer?.Dispose();
    }
}
