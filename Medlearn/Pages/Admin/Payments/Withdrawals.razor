@page "/admin/withdrawals"


<PageTitle>Admin - Withdrawal Requests</PageTitle>

<div class="admin-withdrawals">
    <div class="container-fluid px-0 px-md-3 py-3 py-md-4">
        <!-- Mobile Header -->
        <div class="d-block d-md-none mb-3">
            <div class="bg-primary text-white p-3 rounded-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <div class="flex-grow-1">
                        <h5 class="mb-0">Withdrawal Requests</h5>
                        <small class="opacity-75">Manage doctor withdrawals</small>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-link text-white p-0" @onclick="RefreshData" disabled="@isLoading">
                            <i class="fas fa-sync-alt @(isLoading ? "fa-spin" : "")"></i>
                        </button>
                        <button class="btn btn-link text-white p-0" @onclick="ExportToCSV">
                            <i class="fas fa-share-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-block mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2><i class="fas fa-money-bill-wave me-2"></i>Withdrawal Requests</h2>
                    <p class="text-muted mb-0">Manage doctor withdrawal requests</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" @onclick="ExportToCSV" title="Export to CSV">
                        <i class="fas fa-file-export me-2"></i> Export
                    </button>
                    <button class="btn btn-outline-primary" @onclick="RefreshData" disabled="@isLoading">
                        <i class="fas fa-sync-alt @(isLoading ? "fa-spin" : "")"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Stats Cards - Responsive Grid -->
        <div class="row g-2 g-md-4 mb-3 mb-md-4">
            <div class="col-6 col-xl-3">
                <div class="card border-0 border-md shadow-sm h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <div class="text-xs text-uppercase fw-bold text-warning mb-1">Pending</div>
                                <div class="h5 mb-0 fw-bold">@pendingCount</div>
                                <small class="text-muted d-none d-md-inline">requests</small>
                            </div>
                            <div class="bg-warning bg-opacity-10 p-2 p-md-3 rounded-circle">
                                <i class="fas fa-clock text-warning fa-fw"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-xl-3">
                <div class="card border-0 border-md shadow-sm h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <div class="text-xs text-uppercase fw-bold text-success mb-1">Approved</div>
                                <div class="h5 mb-0 fw-bold">@approvedCount</div>
                                <small class="text-muted d-none d-md-inline">requests</small>
                            </div>
                            <div class="bg-success bg-opacity-10 p-2 p-md-3 rounded-circle">
                                <i class="fas fa-check-circle text-success fa-fw"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-xl-3">
                <div class="card border-0 border-md shadow-sm h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <div class="text-xs text-uppercase fw-bold text-danger mb-1">Rejected</div>
                                <div class="h5 mb-0 fw-bold">@rejectedCount</div>
                                <small class="text-muted d-none d-md-inline">requests</small>
                            </div>
                            <div class="bg-danger bg-opacity-10 p-2 p-md-3 rounded-circle">
                                <i class="fas fa-times-circle text-danger fa-fw"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-xl-3">
                <div class="card border-0 border-md shadow-sm h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <div class="text-xs text-uppercase fw-bold text-info mb-1">Total</div>
                                <div class="h5 mb-0 fw-bold">$@totalAmount.ToString("N0")</div>
                                <small class="text-muted d-none d-md-inline">amount</small>
                            </div>
                            <div class="bg-info bg-opacity-10 p-2 p-md-3 rounded-circle">
                                <i class="fas fa-dollar-sign text-info fa-fw"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters - Responsive -->
        <div class="card shadow-sm border-0 border-md mb-3 mb-md-4">
            <div class="card-body p-3">
                <!-- Mobile Filter Toggle -->
                <div class="d-block d-md-none">
                    <button class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-between"
                            @onclick="toggleMobileFilters">
                        <span><i class="fas fa-filter me-2"></i>Filter & Search</span>
                        <i class="fas @(showMobileFilters ? "fa-chevron-up" : "fa-chevron-down")"></i>
                    </button>

                    @if (showMobileFilters)
                    {
                        <div class="mt-3">
                            <!-- Mobile Status Filter -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Status</label>
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="mobileStatus" id="mobileStatusAll"
                                           value="" @onchange='() => selectedStatus = ""' checked="@(selectedStatus == "")" />
                                    <label class="btn btn-outline-secondary" for="mobileStatusAll">All</label>

                                    <input type="radio" class="btn-check" name="mobileStatus" id="mobileStatusPending"
                                           value="0" @onchange='() => selectedStatus = "0"' checked="@(selectedStatus == "0")" />
                                    <label class="btn btn-outline-warning" for="mobileStatusPending">Pending</label>

                                    <input type="radio" class="btn-check" name="mobileStatus" id="mobileStatusApproved"
                                           value="1" @onchange='() => selectedStatus = "1"' checked="@(selectedStatus == "1")" />
                                    <label class="btn btn-outline-success" for="mobileStatusApproved">Approved</label>

                                    <input type="radio" class="btn-check" name="mobileStatus" id="mobileStatusRejected"
                                           value="2" @onchange='() => selectedStatus = "2"' checked="@(selectedStatus == "2")" />
                                    <label class="btn btn-outline-danger" for="mobileStatusRejected">Rejected</label>
                                </div>
                            </div>

                            <!-- Mobile Search -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Search</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="fas fa-search text-muted"></i>
                                    </span>
                                    <input type="text" class="form-control"
                                           placeholder="Name, email, payment..."
                                           @bind="searchTerm" @bind:event="oninput"
                                           @onkeyup="OnSearchKeyUp" />
                                </div>
                            </div>

                            <!-- Mobile Filter Actions -->
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary flex-grow-1" @onclick="LoadWithdrawals">
                                    <i class="fas fa-search me-2"></i> Apply
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="ClearFilters">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Desktop Filters -->
                <div class="d-none d-md-block">
                    <div class="row align-items-end">
                        <div class="col-md-4 mb-3">
                            <label class="form-label small fw-bold">Status</label>
                            <select class="form-select" @bind="selectedStatus">
                                <option value="">All Statuses</option>
                                <option value="0">Pending</option>
                                <option value="1">Approved</option>
                                <option value="2">Rejected</option>
                            </select>
                        </div>
                        <div class="col-md-5 mb-3">
                            <label class="form-label small fw-bold">Search</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" class="form-control"
                                       placeholder="Search by doctor name, email, or payment method..."
                                       @bind="searchTerm" @bind:event="oninput"
                                       @onkeyup="OnSearchKeyUp" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <button class="btn btn-primary w-100" @onclick="LoadWithdrawals">
                                <i class="fas fa-filter me-2"></i> Apply Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Withdrawals List/Table -->
        <div class="card shadow-sm border-0 border-md">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold text-primary">
                    <i class="fas fa-list me-2"></i>
                    <span class="d-none d-md-inline">Withdrawal Requests</span>
                    <span class="d-md-none">Requests</span>
                </h6>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary">@totalItems total</span>
                    <span class="badge bg-warning d-none d-md-inline">@pendingCount pending</span>
                </div>
            </div>

            <div class="card-body p-0">
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading withdrawal requests...</p>
                    </div>
                }
                else if (!withdrawals.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-money-bill-wave fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No Withdrawal Requests</h5>
                        <p class="text-muted mb-4 px-3">No withdrawal requests found matching your criteria.</p>
                        <button class="btn btn-primary" @onclick="ClearFilters">
                            <i class="fas fa-times me-2"></i> Clear Filters
                        </button>
                    </div>
                }
                else
                {
                    <!-- Mobile Card View -->
                    <div class="d-block d-md-none">
                        @foreach (var withdrawal in withdrawals)
                        {
                            <div class="border-bottom p-3 @(withdrawal.Status == WithdrawalStatus.Pending ? "bg-warning bg-opacity-10" : "")">
                                <!-- Header with ID and Status -->
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="fw-bold">#@withdrawal.Id</span>
                                        <span class="badge @GetStatusBadgeClass(withdrawal.Status) ms-2">
                                            @GetStatusText(withdrawal.Status)
                                        </span>
                                    </div>
                                    <div class="fw-bold text-success">$@withdrawal.Amount.ToString("N2")</div>
                                </div>

                                <!-- Doctor Info -->
                                <div class="d-flex align-items-center mb-2">
                                    <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2">
                                        <i class="fas fa-user-md"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold">@withdrawal.Doctor.FirstName @withdrawal.Doctor.LastName</div>
                                        <small class="text-muted">@withdrawal.Doctor.Email</small>
                                    </div>
                                </div>

                                <!-- Payment Details -->
                                <div class="mb-2">
                                    <div class="d-flex align-items-center">
                                        <span class="badge bg-info me-2">@withdrawal.PaymentMethod</span>
                                        <small class="text-muted">@withdrawal.RequestDate.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    @if (!string.IsNullOrEmpty(withdrawal.AccountDetails))
                                    {
                                        <small class="text-muted d-block mt-1 text-truncate">
                                            <i class="fas fa-credit-card me-1"></i>
                                            @withdrawal.AccountDetails
                                        </small>
                                    }
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex gap-2 mt-3">
                                    <button class="btn btn-sm btn-outline-info flex-grow-1"
                                            @onclick="() => ViewDetails(withdrawal.Id)">
                                        <i class="fas fa-eye me-1"></i> Details
                                    </button>
                                    @if (withdrawal.Status == WithdrawalStatus.Pending)
                                    {
                                        <button class="btn btn-sm btn-outline-success flex-grow-1"
                                                @onclick="() => ShowApproveModal(withdrawal)">
                                            <i class="fas fa-check me-1"></i> Approve
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger flex-grow-1"
                                                @onclick="() => ShowRejectModal(withdrawal)">
                                            <i class="fas fa-times me-1"></i> Reject
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Desktop Table View -->
                    <div class="d-none d-md-block table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-nowrap">ID</th>
                                    <th class="text-nowrap">Doctor</th>
                                    <th class="text-nowrap text-end">Amount</th>
                                    <th class="text-nowrap">Payment Method</th>
                                    <th class="text-nowrap">Status</th>
                                    <th class="text-nowrap">Request Date</th>
                                    <th class="text-nowrap text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var withdrawal in withdrawals)
                                {
                                    <tr class="@(withdrawal.Status == WithdrawalStatus.Pending ? "table-warning" : "")">
                                        <td class="fw-bold">#@withdrawal.Id</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2">
                                                    <i class="fas fa-user-md"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold">@withdrawal.Doctor.FirstName @withdrawal.Doctor.LastName</div>
                                                    <small class="text-muted">@withdrawal.Doctor.Email</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-bold text-success">$@withdrawal.Amount.ToString("N2")</span>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <span class="badge bg-info">@withdrawal.PaymentMethod</span>
                                                @if (!string.IsNullOrEmpty(withdrawal.AccountDetails))
                                                {
                                                    <small class="text-muted mt-1 text-truncate" style="max-width: 150px;">
                                                        @withdrawal.AccountDetails
                                                    </small>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(withdrawal.Status)">
                                                @GetStatusText(withdrawal.Status)
                                            </span>
                                            @if (withdrawal.ProcessedByAdmin != null)
                                            {
                                                <div class="small text-muted mt-1">
                                                    By: @withdrawal.ProcessedByAdmin.FirstName
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div class="small">@withdrawal.RequestDate.ToString("MMM dd, yyyy")</div>
                                            <div class="text-muted small">@withdrawal.RequestDate.ToString("hh:mm tt")</div>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-center gap-1">
                                                <button class="btn btn-sm btn-outline-info"
                                                        @onclick="() => ViewDetails(withdrawal.Id)"
                                                        title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                @if (withdrawal.Status == WithdrawalStatus.Pending)
                                                {
                                                    <button class="btn btn-sm btn-outline-success"
                                                            @onclick="() => ShowApproveModal(withdrawal)"
                                                            title="Approve">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => ShowRejectModal(withdrawal)"
                                                            title="Reject">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (withdrawals.Any())
            {
                <div class="card-footer bg-white">
                    <!-- Mobile Pagination -->
                    <div class="d-block d-md-none">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Page @currentPage of @totalPages</span>
                            <span class="text-muted small">@withdrawals.Count of @totalItems</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-primary flex-grow-1 @(currentPage <= 1 ? "disabled" : "")"
                                    @onclick="() => ChangePage(currentPage - 1)">
                                <i class="fas fa-chevron-left me-1"></i> Previous
                            </button>
                            <button class="btn btn-outline-primary flex-grow-1 @(currentPage >= totalPages ? "disabled" : "")"
                                    @onclick="() => ChangePage(currentPage + 1)">
                                Next <i class="fas fa-chevron-right ms-1"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Desktop Pagination -->
                    <div class="d-none d-md-flex justify-content-between align-items-center">
                        <div class="text-muted small">
                            Showing @withdrawals.Count of @totalItems withdrawal requests
                        </div>

                        @if (totalPages > 1)
                        {
                            <nav aria-label="Page navigation">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)"
                                                aria-label="Previous">
                                            <i class="fas fa-chevron-left"></i>
                                        </button>
                                    </li>

                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        if (i == 1 || i == totalPages || (i >= currentPage - 1 && i <= currentPage + 1))
                                        {
                                            <li class="page-item @(i == currentPage ? "active" : "")">
                                                <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
                                            </li>
                                        }
                                        else if (i == currentPage - 2 || i == currentPage + 2)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                    }

                                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)"
                                                aria-label="Next">
                                            <i class="fas fa-chevron-right"></i>
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Mobile Action Bottom Sheet (for quick actions) -->
@if (showMobileActionSheet)
{
    <div class="modal-backdrop fade show"></div>
    <div class="mobile-action-sheet d-block d-md-none">
        <div class="action-sheet-content bg-white rounded-top">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Quick Actions</h6>
                <button class="btn btn-link text-muted p-0" @onclick="CloseMobileActionSheet">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="p-3">
                <button class="btn btn-outline-primary w-100 mb-2 text-start" @onclick="ExportToCSV">
                    <i class="fas fa-file-export me-2"></i> Export to CSV
                </button>
                <button class="btn btn-outline-secondary w-100 mb-2 text-start" @onclick="RefreshData">
                    <i class="fas fa-sync-alt me-2"></i> Refresh Data
                </button>
                <hr />
                <button class="btn btn-outline-danger w-100 text-start" @onclick="ClearFilters">
                    <i class="fas fa-filter me-2"></i> Clear All Filters
                </button>
            </div>
        </div>
    </div>
}

<!-- Approve Modal (Updated for mobile) -->
@if (showApproveModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-check-circle me-2"></i>Approve Withdrawal
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-success small mb-3">
                        <i class="fas fa-info-circle me-2"></i>
                        Are you sure you want to approve this withdrawal request?
                    </div>

                    <div class="card mb-3 bg-light">
                        <div class="card-body p-3">
                            <div class="row g-2">
                                <div class="col-6">
                                    <small class="text-muted d-block">Doctor</small>
                                    <span class="fw-bold small">
                                        @selectedWithdrawal?.Doctor?.FirstName @selectedWithdrawal?.Doctor?.LastName
                                    </span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Amount</small>
                                    <span class="fw-bold text-success">$@selectedWithdrawal?.Amount.ToString("N2")</span>
                                </div>
                                <div class="col-12 mt-2">
                                    <small class="text-muted d-block">Payment Method</small>
                                    <span>@selectedWithdrawal?.PaymentMethod</span>
                                </div>
                                <div class="col-12">
                                    <small class="text-muted d-block">Account Details</small>
                                    <span class="small text-break">@selectedWithdrawal?.AccountDetails</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="approveNotes" class="form-label small fw-bold">Notes (Optional)</label>
                        <textarea class="form-control form-control-sm" id="approveNotes" rows="2"
                                  placeholder="Add any notes for the doctor..." @bind="notes"></textarea>
                        <div class="form-text small">Optional notes will be visible to the doctor.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseModals">Cancel</button>
                    <button type="button" class="btn btn-sm btn-success" @onclick="ApproveWithdrawal" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        <i class="fas fa-check me-2"></i> Approve
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Reject Modal (Updated for mobile) -->
@if (showRejectModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-times-circle me-2"></i>Reject Withdrawal
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger small mb-3">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Are you sure you want to reject this withdrawal request?
                    </div>

                    <div class="card mb-3 bg-light">
                        <div class="card-body p-3">
                            <div class="row g-2">
                                <div class="col-6">
                                    <small class="text-muted d-block">Doctor</small>
                                    <span class="fw-bold small">
                                        @selectedWithdrawal?.Doctor?.FirstName @selectedWithdrawal?.Doctor?.LastName
                                    </span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Amount</small>
                                    <span class="fw-bold">$@selectedWithdrawal?.Amount.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="rejectReason" class="form-label small fw-bold text-danger">
                            <span class="text-danger">*</span> Reason for Rejection
                        </label>
                        <textarea class="form-control form-control-sm" id="rejectReason" rows="3"
                                  placeholder="Please provide a reason..."
                                  @bind="notes" required></textarea>
                        <div class="form-text small">This reason will be shared with the doctor.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseModals">Cancel</button>
                    <button type="button" class="btn btn-sm btn-danger" @onclick="RejectWithdrawal"
                            disabled="@isProcessing || string.IsNullOrWhiteSpace(notes)">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        <i class="fas fa-times me-2"></i> Reject
                    </button>
                </div>
            </div>
        </div>
    </div>
}

