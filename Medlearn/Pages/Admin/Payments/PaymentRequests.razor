    private string GetItemName(PaymentRequestDto payment)
    {
        if (payment == null) return "Unknown";

        return payment.EnrollmentType switch
        {
            EnrollmentType.Lecture => payment.Lecture?.Title ?? "Lecture",
            EnrollmentType.Course => payment.Course?.Title ?? "Course",
            EnrollmentType.Specialization => payment.Specialization?.Title ?? "Specialization",
            _ => "Unknown Item"
        };
    }

    private string GetItemDetails(PaymentRequestDto payment)
    {
        if (payment == null) return "";

        return payment.EnrollmentType switch
        {
            EnrollmentType.Lecture => payment.LectureId?.ToString() ?? "N/A",
            EnrollmentType.Course => payment.CourseId?.ToString() ?? "N/A",
            EnrollmentType.Specialization => payment.SpecializationId?.ToString() ?? "N/A",
            _ => ""
        };
    }

    private string GetInitials(string? firstName, string? lastName)
    {
        if (string.IsNullOrEmpty(firstName) && string.IsNullOrEmpty(lastName))
            return "U";

        var firstInitial = string.IsNullOrEmpty(firstName) ? "" : firstName[0].ToString();
        var lastInitial = string.IsNullOrEmpty(lastName) ? "" : lastName[0].ToString();

        return $"{firstInitial}{lastInitial}";
    }

    private async Task ProcessPayment(int paymentId, bool approve)
    {
        if (currentUser == null || currentUser.UserType != UserType.Admin)
        {
            await ShowToast("error", "Admin privileges required");
            return;
        }

        if (approve)
        {
            bool confirmed = await JS.InvokeAsync<bool>("confirm",
                "Are you sure you want to approve this payment? This will grant the user access to the content and transfer funds to the doctor.");

            if (!confirmed) return;

            try
            {
                var updateDto = new UpdatePaymentRequestDto
                {
                    Status = PaymentStatus.Approved,
                    RejectionReason = null
                };

                var result = await PaymentService.UpdatePaymentStatusAsync(paymentId, updateDto);

                if (result)
                {
                    await ShowToast("success", "Payment approved successfully");
                    await LoadPayments();
                }
                else
                {
                    await ShowToast("error", "Failed to approve payment");
                }
            }
            catch (Exception ex)
            {
                await ShowToast("error", $"Error approving payment: {ex.Message}");
            }
        }
        else
        {
            var reason = await JS.InvokeAsync<string>("prompt", "Please enter rejection reason:");

            if (!string.IsNullOrWhiteSpace(reason))
            {
                try
                {
                    var updateDto = new UpdatePaymentRequestDto
                    {
                        Status = PaymentStatus.Rejected,
                        RejectionReason = reason
                    };

                    var result = await PaymentService.UpdatePaymentStatusAsync(paymentId, updateDto);

                    if (result)
                    {
                        await ShowToast("success", "Payment rejected successfully");
                        await LoadPayments();
                    }
                    else
                    {
                        await ShowToast("error", "Failed to reject payment");
                    }
                }
                catch (Exception ex)
                {
                    await ShowToast("error", $"Error rejecting payment: {ex.Message}");
                }
            }
        }
    }

    private async Task ExportToExcel()
    {
        if (currentUser?.UserType != UserType.Admin)
        {
            await ShowToast("error", "Admin privileges required");
            return;
        }

        isExporting = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Get all data (not just current page) for export
            PaymentStatus? status = null;
            if (!string.IsNullOrEmpty(statusFilter) && int.TryParse(statusFilter, out int statusValue))
            {
                status = (PaymentStatus)statusValue;
            }

            // Get all payment requests without pagination for export
            var allPayments = await PaymentService.GetPaymentRequestsAsync(
                status: status,
                search: searchTerm,
                page: 1,
                pageSize: 10000); // Large number to get all for export

            if (allPayments == null || !allPayments.Any())
            {
                await ShowToast("error", "No data to export");
                isExporting = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Create CSV content
            var csvContent = new StringBuilder();
            csvContent.AppendLine("Invoice Number,User Name,User Email,Type,Item,Amount,Status,Created Date,Invoice URL");

            foreach (var payment in allPayments)
            {
                var userName = $"{payment.User?.FirstName} {payment.User?.LastName}";
                var userEmail = payment.User?.Email ?? "N/A";
                var itemName = GetItemName(payment);
                var invoiceUrl = payment.InvoicePdfUrl ?? "N/A";

                // Escape quotes in CSV
                userName = userName?.Replace("\"", "\"\"") ?? "";
                userEmail = userEmail?.Replace("\"", "\"\"") ?? "";
                itemName = itemName?.Replace("\"", "\"\"") ?? "";
                invoiceUrl = invoiceUrl?.Replace("\"", "\"\"") ?? "";

                csvContent.AppendLine($"\"{payment.InvoiceNumber}\",\"{userName}\",\"{userEmail}\",\"{payment.EnrollmentType}\",\"{itemName}\",\"{payment.Amount}\",\"{payment.Status}\",\"{payment.CreatedAt:yyyy-MM-dd HH:mm}\",\"{invoiceUrl}\"");
            }

            // Create download
            var fileName = $"PaymentRequests_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            var bytes = Encoding.UTF8.GetBytes(csvContent.ToString());
            var base64 = Convert.ToBase64String(bytes);

            await JS.InvokeVoidAsync("downloadFile", fileName, base64, "text/csv");

            await ShowToast("success", "Export completed successfully");
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Export failed: {ex.Message}");
            Console.WriteLine($"Export error: {ex.Message}");
        }
        finally
        {
            isExporting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

