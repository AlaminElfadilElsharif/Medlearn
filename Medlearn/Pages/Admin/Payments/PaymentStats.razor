@code {
    // Add these new variables
    private bool showMobileFilter = false;
    private bool showMobileInsights = false;

    // ... (keep all your existing code in the @code block exactly as is)
    private DashboardStatsDto? dashboardStats;
    private List<PaymentRequestDto>? paymentRequests;
    private object? paymentStats;
    private UserDto? currentUser = null;
    private bool isAuthenticated = false;

    private DateTime startDate = DateTime.Now.AddMonths(-1);
    private DateTime endDate = DateTime.Now;
    private string groupBy = "month";
    private bool isLoading = false;

    // Add toggle methods
    private void ToggleFilter()
    {
        showMobileFilter = !showMobileFilter;
    }

    private void ToggleInsights()
    {
        showMobileInsights = !showMobileInsights;
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();

        if (isAuthenticated && currentUser?.UserType == UserType.Admin)
        {
            await LoadAllStatistics();
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            // Simple authentication check like notifications component
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                // Try to get user from storage
                currentUser = await GetUserFromStorage();

                // If not in storage, get from API
                if (currentUser == null)
                {
                    currentUser = await AuthService.GetCurrentUserAsync();
                    if (currentUser != null)
                    {
                        // Store for next time
                        await JS.InvokeVoidAsync("localStorage.setItem", "currentUser",
                            System.Text.Json.JsonSerializer.Serialize(currentUser));
                    }
                }

                // Check if user is admin
                if (currentUser?.UserType != UserType.Admin)
                {
                    await ShowWarning("You do not have permission to access this page.");
                }
            }
            else
            {
                currentUser = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            currentUser = null;
        }

        StateHasChanged();
    }

    private async Task<UserDto?> GetUserFromStorage()
    {
        try
        {
            var userJson = await JS.InvokeAsync<string>("localStorage.getItem", "currentUser");

            if (!string.IsNullOrEmpty(userJson))
            {
                return System.Text.Json.JsonSerializer.Deserialize<UserDto>(userJson);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting user from storage: {ex.Message}");
        }

        return null;
    }

    private async Task LoadAllStatistics()
    {
        if (!isAuthenticated || currentUser?.UserType != UserType.Admin)
            return;

        isLoading = true;
        StateHasChanged();

        try
        {
            // Verify token is still valid
            var tokenValid = await TokenService.IsAuthenticatedAsync();
            if (!tokenValid)
            {
                await ShowError("Session expired. Please login again.");
                Navigation.NavigateTo("/account/login");
                return;
            }

            // Load dashboard stats
            var dashboardData = await DashboardService.GetAdminDashboardStatsAsync();
            dashboardStats = dashboardData as DashboardStatsDto;

            // Load payment requests
            await LoadPaymentRequests();

            // Load payment stats
            await LoadPaymentStats();
        }
        catch (Exception ex)
        {
            await ShowError($"Failed to load statistics: {ex.Message}");

            // If unauthorized, redirect to login
            if (ex.Message.Contains("401") || ex.Message.Contains("Unauthorized"))
            {
                await ShowError("Session expired. Redirecting to login...");
                await Task.Delay(2000);
                Navigation.NavigateTo("/account/login");
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadPaymentRequests()
    {
        if (!isAuthenticated) return;

        try
        {
            paymentRequests = await PaymentService.GetPaymentRequestsAsync(
                status: null,
                search: null,
                page: 1,
                pageSize: 15
            );
        }
        catch (Exception ex)
        {
            await ShowError($"Failed to load payment requests: {ex.Message}");
        }
    }

    private async Task LoadPaymentStats()
    {
        if (!isAuthenticated) return;

        try
        {
            paymentStats = await PaymentService.GetPaymentStatsAsync();
        }
        catch (Exception ex)
        {
            await ShowError($"Failed to load payment stats: {ex.Message}");
        }
    }

    private string GetRevenueGrowth()
    {
        if (dashboardStats?.MonthlyRevenue == null || dashboardStats.MonthlyRevenue.Count() < 2)
            return "0";

        var current = dashboardStats.MonthlyRevenue.Last();
        var previous = dashboardStats.MonthlyRevenue.ElementAtOrDefault(dashboardStats.MonthlyRevenue.Count() - 2);

        if (previous == null || previous.Revenue == 0)
            return "100";

        var growth = ((current.Revenue - previous.Revenue) / previous.Revenue) * 100;
        return Math.Max(growth, 0).ToString("0.0");
    }

    private string GetApprovalRate()
    {
        if (dashboardStats == null) return "0";

        var totalProcessed = dashboardStats.ApprovedPayments + dashboardStats.RejectedPayments;
        if (totalProcessed == 0) return "0";

        var rate = (dashboardStats.ApprovedPayments / (double)totalProcessed) * 100;
        return rate.ToString("0.0");
    }

    private double GetRejectionRateDouble()
    {
        if (dashboardStats == null) return 0;

        var totalProcessed = dashboardStats.ApprovedPayments + dashboardStats.RejectedPayments;
        if (totalProcessed == 0) return 0;

        var rate = (dashboardStats.RejectedPayments / (double)totalProcessed) * 100;
        return rate;
    }

    private string GetRejectionRate()
    {
        return GetRejectionRateDouble().ToString("0.0");
    }

    private string GetEntityTitle(PaymentRequestDto payment)
    {
        if (payment.Lecture != null)
            return payment.Lecture.Title;
        else if (payment.Course != null)
            return payment.Course.Title;
        else if (payment.Specialization != null)
            return payment.Specialization.Title;
        else
            return "Payment";
    }

    private string GetStatusColor(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Approved => "bg-success",
            PaymentStatus.Pending => "bg-warning",
            PaymentStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetStatusBadgeClass(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Approved => "bg-success",
            PaymentStatus.Pending => "bg-warning",
            PaymentStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private async Task ExportReport()
    {
        if (!isAuthenticated) return;

        try
        {
            var reportData = new
            {
                Period = $"{startDate:yyyy-MM-dd} to {endDate:yyyy-MM-dd}",
                GeneratedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm"),
                Summary = new
                {
                    dashboardStats?.TotalRevenue,
                    dashboardStats?.ApprovedPayments,
                    dashboardStats?.PendingPayments,
                    dashboardStats?.RejectedPayments,
                    ApprovalRate = GetApprovalRate(),
                    RejectionRate = GetRejectionRate(),
                    RevenueGrowth = GetRevenueGrowth(),
                    TotalUsers = dashboardStats?.TotalUsers,
                    TotalEnrollments = dashboardStats?.TotalEnrollments,
                    DoctorsBalance = dashboardStats?.DoctorsBalance
                },
                MonthlyRevenue = dashboardStats?.MonthlyRevenue?.Select(m => new
                {
                    Period = m.Month,
                    Revenue = m.Revenue
                }),
                RecentPayments = paymentRequests?.Select(p => new
                {
                    InvoiceNumber = p.InvoiceNumber,
                    User = $"{p.User?.FirstName} {p.User?.LastName}",
                    Amount = p.Amount,
                    Status = p.Status.ToString(),
                    Date = p.CreatedAt.ToString("yyyy-MM-dd"),
                    Entity = GetEntityTitle(p)
                })
            };

            await JS.InvokeVoidAsync("exportToExcel", reportData, $"PaymentStatisticsReport_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx");
            await ShowSuccess("Report exported successfully");
        }
        catch (Exception ex)
        {
            await ShowError($"Failed to export report: {ex.Message}");
        }
    }

    private void NavigateToPendingPayments()
    {
        Navigation.NavigateTo("/admin/payments?status=0");
    }

    private async Task ShowRejectionAnalysis()
    {
        var rejectedPayments = paymentRequests?.Where(p => p.Status == PaymentStatus.Rejected).ToList();

        if (rejectedPayments == null || !rejectedPayments.Any())
        {
            await ShowInfo("No rejected payments to analyze");
            return;
        }

        var reasons = rejectedPayments
            .GroupBy(p => p.RejectionReason ?? "No reason provided")
            .Select(g => new { Reason = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .ToList();

        var analysis = $"Rejection Analysis:\n\n" +
                      $"Total Rejected: {rejectedPayments.Count}\n\n" +
                      "Top Reasons:\n" +
                      string.Join("\n", reasons.Select(r => $"- {r.Reason}: {r.Count}"));

        await JS.InvokeVoidAsync("alert", analysis);
    }

    private async Task ShowSuccess(string message)
    {
        await JS.InvokeVoidAsync("showToast", "success", message);
    }

    private async Task ShowError(string message)
    {
        await JS.InvokeVoidAsync("showToast", "error", message);
    }

    private async Task ShowInfo(string message)
    {
        await JS.InvokeVoidAsync("showToast", "info", message);
    }

    private async Task ShowWarning(string message)
    {
        await JS.InvokeVoidAsync("showToast", "warning", message);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin");
    }
}

