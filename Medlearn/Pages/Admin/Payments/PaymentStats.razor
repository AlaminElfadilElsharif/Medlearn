@page "/admin/payments/stats"


<PageTitle>Payment Statistics</PageTitle>

<div class="payment-stats">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none">
            <div class="bg-primary text-white p-3 mb-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <h5 class="mb-0 flex-grow-1">Payment Statistics</h5>
                    <button class="btn btn-link text-white p-0" @onclick="ExportReport" disabled="@isLoading">
                        <i class="fas fa-file-export fa-lg"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
            <h1>Payment Statistics</h1>
            <div>
                <button class="btn btn-outline-secondary me-2" @onclick="GoBack">
                    <i class="fas fa-arrow-left me-2"></i> Back
                </button>
                <button class="btn btn-primary" @onclick="ExportReport" disabled="@isLoading">
                    <i class="fas fa-file-export me-2"></i> Export Report
                </button>
            </div>
        </div>

        @if (!isAuthenticated || currentUser?.UserType != UserType.Admin)
        {
            <!-- Authentication Required (same for both) -->
            <div class="card mx-3 mx-md-0">
                <div class="card-body text-center py-5">
                    <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                    <h3>Admin Access Required</h3>
                    <p class="text-muted">You need administrator privileges to access payment statistics.</p>
                    @if (!isAuthenticated)
                    {
                        <a href="/account/login" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt me-2"></i> Login
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="CheckAuthentication">
                            <i class="fas fa-sync-alt me-2"></i> Re-check Authentication
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Date Range Filter - Mobile Collapsible -->
            <div class="d-block d-md-none mb-3">
                <div class="card">
                    <div class="card-header bg-white" @onclick="ToggleFilter" style="cursor: pointer;">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <i class="fas fa-filter me-2 text-primary"></i>Filters
                            </h6>
                            <i class="fas @(showMobileFilter ? "fa-chevron-up" : "fa-chevron-down")"></i>
                        </div>
                    </div>
                    @if (showMobileFilter)
                    {
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label small">Start Date</label>
                                <input type="date" class="form-control form-control-sm"
                                       @bind="startDate"
                                       @bind:format="yyyy-MM-dd" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small">End Date</label>
                                <input type="date" class="form-control form-control-sm"
                                       @bind="endDate"
                                       @bind:format="yyyy-MM-dd" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small">Group By</label>
                                <select class="form-select form-select-sm" @bind="groupBy">
                                    <option value="month">Monthly</option>
                                    <option value="week">Weekly</option>
                                    <option value="day">Daily</option>
                                </select>
                            </div>
                            <button class="btn btn-primary w-100" @onclick="LoadAllStatistics" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Loading...</span>
                                }
                                else
                                {
                                    <i class="fas fa-sync-alt me-2"></i>
                                    <span>Refresh Data</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Desktop Date Range Filter -->
            <div class="d-none d-md-block card mb-4">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Start Date</label>
                            <input type="date" class="form-control"
                                   @bind="startDate"
                                   @bind:format="yyyy-MM-dd" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-control"
                                   @bind="endDate"
                                   @bind:format="yyyy-MM-dd" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Group By</label>
                            <select class="form-select" @bind="groupBy">
                                <option value="month">Monthly</option>
                                <option value="week">Weekly</option>
                                <option value="day">Daily</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <div class="d-grid gap-2">
                                <button class="btn btn-primary" @onclick="LoadAllStatistics" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Loading...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sync-alt me-2"></i>
                                        <span>Refresh Data</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (isLoading && dashboardStats == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading statistics...</p>
                </div>
            }
            else if (dashboardStats == null)
            {
                <div class="alert alert-warning mx-3 mx-md-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    No statistics data available
                </div>
            }
            else
            {
                <!-- Summary Stats - Horizontal Scroll on Mobile -->
                <div class="d-block d-md-none mb-3">
                    <div class="overflow-auto" style="white-space: nowrap; -webkit-overflow-scrolling: touch;">
                        <div class="d-flex px-3" style="gap: 12px;">
                            <!-- Total Revenue Card -->
                            <div class="stat-card-mobile flex-shrink-0" style="width: 200px;">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="text-muted small mb-0">Total Revenue</h6>
                                            <div class="stat-icon-mobile">
                                                <i class="fas fa-dollar-sign text-success"></i>
                                            </div>
                                        </div>
                                        <h5 class="mb-1">$@dashboardStats.TotalRevenue.ToString("N2")</h5>
                                        <small class="text-success">
                                            <i class="fas fa-arrow-up"></i> +@GetRevenueGrowth()%
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Approved Payments Card -->
                            <div class="stat-card-mobile flex-shrink-0" style="width: 200px;">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="text-muted small mb-0">Approved</h6>
                                            <div class="stat-icon-mobile">
                                                <i class="fas fa-check text-info"></i>
                                            </div>
                                        </div>
                                        <h5 class="mb-1">@dashboardStats.ApprovedPayments</h5>
                                        <small class="text-info">
                                            @GetApprovalRate()% approval rate
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Pending Payments Card -->
                            <div class="stat-card-mobile flex-shrink-0" style="width: 200px;">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="text-muted small mb-0">Pending</h6>
                                            <div class="stat-icon-mobile">
                                                <i class="fas fa-clock text-warning"></i>
                                            </div>
                                        </div>
                                        <h5 class="mb-1">@dashboardStats.PendingPayments</h5>
                                        <small class="text-warning">Needs review</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Rejected Payments Card -->
                            <div class="stat-card-mobile flex-shrink-0" style="width: 200px;">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="text-muted small mb-0">Rejected</h6>
                                            <div class="stat-icon-mobile">
                                                <i class="fas fa-times text-danger"></i>
                                            </div>
                                        </div>
                                        <h5 class="mb-1">@dashboardStats.RejectedPayments</h5>
                                        <small class="text-danger">
                                            @GetRejectionRate()% rejection rate
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Desktop Summary Stats -->
                <div class="d-none d-md-flex row mb-4">
                    <div class="col-md-3">
                        <div class="card stat-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted">Total Revenue</h6>
                                        <h3>$@dashboardStats.TotalRevenue.ToString("N2")</h3>
                                        <small class="text-success">
                                            <i class="fas fa-arrow-up"></i> +@GetRevenueGrowth()% from previous period
                                        </small>
                                    </div>
                                    <div class="stat-icon">
                                        <i class="fas fa-dollar-sign text-success"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card stat-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted">Approved Payments</h6>
                                        <h3>@dashboardStats.ApprovedPayments</h3>
                                        <small class="text-info">
                                            <i class="fas fa-check-circle"></i> @GetApprovalRate()% approval rate
                                        </small>
                                    </div>
                                    <div class="stat-icon">
                                        <i class="fas fa-check text-info"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card stat-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted">Pending Payments</h6>
                                        <h3>@dashboardStats.PendingPayments</h3>
                                        <small class="text-warning">
                                            <i class="fas fa-clock"></i> Needs review
                                        </small>
                                    </div>
                                    <div class="stat-icon">
                                        <i class="fas fa-clock text-warning"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card stat-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted">Rejected Payments</h6>
                                        <h3>@dashboardStats.RejectedPayments</h3>
                                        <small class="text-danger">
                                            <i class="fas fa-times"></i> @GetRejectionRate()% rejection rate
                                        </small>
                                    </div>
                                    <div class="stat-icon">
                                        <i class="fas fa-times text-danger"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mobile Detailed Statistics (Stacked) -->
                <div class="d-block d-md-none">
                    <div class="row g-3 px-3">
                        <!-- Recent Payments Mobile -->
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-white">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0">
                                            <i class="fas fa-history me-2 text-primary"></i>Recent Payments
                                        </h6>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadPaymentRequests">
                                            <i class="fas fa-sync-alt"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    @if (paymentRequests == null || !paymentRequests.Any())
                                    {
                                        <div class="text-center py-4">
                                            <i class="fas fa-receipt fa-2x text-muted mb-2"></i>
                                            <p class="text-muted small">No data available</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var payment in paymentRequests.Take(10))
                                            {
                                                <div class="list-group-item">
                                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                                        <div>
                                                            <h6 class="mb-0 small">@GetEntityTitle(payment)</h6>
                                                            <small class="text-muted">
                                                                @payment.User?.FirstName @payment.User?.LastName
                                                            </small>
                                                        </div>
                                                        <span class="fw-bold">$@payment.Amount.ToString("N2")</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <span class="badge @GetStatusBadgeClass(payment.Status) me-2">
                                                                @payment.Status
                                                            </span>
                                                            <small class="text-muted">@payment.CreatedAt.ToString("MMM dd")</small>
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(payment.InvoiceNumber))
                                                        {
                                                            <small class="text-muted">@payment.InvoiceNumber</small>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Payment Stats Mobile -->
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-white">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0">
                                            <i class="fas fa-chart-pie me-2 text-primary"></i>Payment Stats
                                        </h6>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadPaymentStats">
                                            <i class="fas fa-sync-alt"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body">
                                    @if (paymentStats == null)
                                    {
                                        <div class="text-center py-3">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <div class="p-3 bg-light rounded text-center">
                                                    <div class="h5 mb-1">@dashboardStats.ApprovedPayments</div>
                                                    <small class="text-muted">Approved</small>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-3 bg-light rounded text-center">
                                                    <div class="h5 mb-1">@dashboardStats.PendingPayments</div>
                                                    <small class="text-muted">Pending</small>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-3 bg-light rounded text-center">
                                                    <div class="h5 mb-1">@dashboardStats.RejectedPayments</div>
                                                    <small class="text-muted">Rejected</small>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-3 bg-light rounded text-center">
                                                    <div class="h5 mb-1">$@dashboardStats.TotalRevenue.ToString("N0")</div>
                                                    <small class="text-muted">Revenue</small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Desktop Detailed Statistics (2 Columns) -->
                <div class="d-none d-md-flex row">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Recent Payment Requests</h5>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadPaymentRequests">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body">
                                @if (paymentRequests == null || !paymentRequests.Any())
                                {
                                    <div class="text-center py-4">
                                        <i class="fas fa-receipt fa-2x text-muted mb-3"></i>
                                        <p class="text-muted">No payment request data available</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="timeline">
                                        @foreach (var payment in paymentRequests.Take(15))
                                        {
                                            <div class="timeline-item">
                                                <div class="timeline-marker @GetStatusColor(payment.Status)"></div>
                                                <div class="timeline-content">
                                                    <div class="d-flex justify-content-between">
                                                        <div>
                                                            <h6 class="mb-0">@GetEntityTitle(payment)</h6>
                                                            <small class="text-muted">
                                                                @payment.User?.FirstName @payment.User?.LastName
                                                            </small>
                                                        </div>
                                                        <div class="text-end">
                                                            <div class="fw-bold">$@payment.Amount.ToString("N2")</div>
                                                            <small class="text-muted">@payment.CreatedAt.ToString("MMM dd")</small>
                                                        </div>
                                                    </div>
                                                    <div class="mt-1">
                                                        <span class="badge @GetStatusBadgeClass(payment.Status)">
                                                            @payment.Status
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(payment.InvoiceNumber))
                                                        {
                                                            <small class="text-muted ms-2">@payment.InvoiceNumber</small>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Payment Statistics</h5>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadPaymentStats">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body">
                                @if (paymentStats == null)
                                {
                                    <div class="text-center py-4">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-3">
                                        <i class="fas fa-chart-pie fa-3x text-primary mb-3"></i>
                                        <h4>Payment Overview</h4>
                                        <p class="text-muted">Last 30 Days</p>
                                    </div>
                                    <div class="row text-center">
                                        <div class="col-6 mb-3">
                                            <div class="p-3 bg-light rounded">
                                                <div class="h4 mb-1">@dashboardStats.ApprovedPayments</div>
                                                <small class="text-muted">Approved</small>
                                            </div>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <div class="p-3 bg-light rounded">
                                                <div class="h4 mb-1">@dashboardStats.PendingPayments</div>
                                                <small class="text-muted">Pending</small>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="p-3 bg-light rounded">
                                                <div class="h4 mb-1">@dashboardStats.RejectedPayments</div>
                                                <small class="text-muted">Rejected</small>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="p-3 bg-light rounded">
                                                <div class="h4 mb-1">$@dashboardStats.TotalRevenue.ToString("N0")</div>
                                                <small class="text-muted">Total Revenue</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mobile Insights (Collapsible) -->
                <div class="d-block d-md-none px-3 mt-3">
                    <div class="card">
                        <div class="card-header bg-white" @onclick="ToggleInsights" style="cursor: pointer;">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">
                                    <i class="fas fa-lightbulb me-2 text-warning"></i>Insights
                                </h6>
                                <i class="fas @(showMobileInsights ? "fa-chevron-up" : "fa-chevron-down")"></i>
                            </div>
                        </div>
                        @if (showMobileInsights)
                        {
                            <div class="card-body">
                                @if (dashboardStats.PendingPayments > 5)
                                {
                                    <div class="alert alert-warning mb-2 small p-2">
                                        <i class="fas fa-clock me-2"></i>
                                        <strong>@dashboardStats.PendingPayments pending payments</strong> need review
                                        <button class="btn btn-sm btn-warning w-100 mt-2" @onclick="NavigateToPendingPayments">
                                            Review Now
                                        </button>
                                    </div>
                                }

                                @if (dashboardStats.RejectedPayments > 0 && GetRejectionRateDouble() > 20)
                                {
                                    <div class="alert alert-danger small p-2">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        <strong>High rejection rate</strong> (@GetRejectionRate()%)
                                        <button class="btn btn-sm btn-outline-danger w-100 mt-2" @onclick="ShowRejectionAnalysis">
                                            Analyze Reasons
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Desktop Insights -->
                <div class="d-none d-md-block card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0">Insights & Recommendations</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @if (dashboardStats.PendingPayments > 10)
                            {
                                <div class="col-md-6">
                                    <div class="alert alert-warning">
                                        <div class="d-flex">
                                            <div class="flex-shrink-0">
                                                <i class="fas fa-clock fa-2x"></i>
                                            </div>
                                            <div class="flex-grow-1 ms-3">
                                                <h6 class="alert-heading">Action Required</h6>
                                                <p class="mb-0">
                                                    You have @dashboardStats.PendingPayments pending payments waiting for review.
                                                </p>
                                                <hr>
                                                <button class="btn btn-sm btn-warning" @onclick="NavigateToPendingPayments">
                                                    <i class="fas fa-external-link-alt me-1"></i>
                                                    Review Now
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (dashboardStats.RejectedPayments > 0 && GetRejectionRateDouble() > 20)
                            {
                                <div class="col-md-6">
                                    <div class="alert alert-danger">
                                        <div class="d-flex">
                                            <div class="flex-shrink-0">
                                                <i class="fas fa-exclamation-triangle fa-2x"></i>
                                            </div>
                                            <div class="flex-grow-1 ms-3">
                                                <h6 class="alert-heading">High Rejection Rate</h6>
                                                <p class="mb-0">
                                                    Rejection rate is @GetRejectionRateDouble().ToString("0.0")%
                                                </p>
                                                <hr>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="ShowRejectionAnalysis">
                                                    <i class="fas fa-chart-bar me-1"></i>
                                                    Analyze Reasons
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
