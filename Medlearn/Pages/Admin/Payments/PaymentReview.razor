@page "/admin/payments/review/{paymentId:int}"


<PageTitle>Review Payment</PageTitle>

<div class="payment-review">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <h5 class="mb-0 flex-grow-1">Payment Review</h5>
                    @if (payment != null && payment.Status == PaymentStatus.Pending && !isProcessing)
                    {
                        <div class="dropdown">
                            <button class="btn btn-link text-white p-0" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-ellipsis-v fa-lg"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <button class="dropdown-item text-success" @onclick="ApprovePayment">
                                        <i class="fas fa-check me-2"></i> Approve
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item text-danger" @onclick="ShowRejectModal">
                                        <i class="fas fa-times me-2"></i> Reject
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
            <!-- Mobile Breadcrumb -->
            <div class="bg-light p-2 small">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/admin">Admin</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="/admin/payments">Payments</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Review</li>
                    </ol>
                </nav>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-block">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1>Payment Review</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="/admin">Admin</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="/admin/payments">Payments</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Review</li>
                        </ol>
                    </nav>
                </div>
                <div>
                    <button class="btn btn-outline-secondary me-2" @onclick="GoBack">
                        <i class="fas fa-arrow-left me-2"></i> Back
                    </button>
                    @if (payment != null && payment.Status == PaymentStatus.Pending)
                    {
                        <button class="btn btn-success me-2" @onclick="ApprovePayment" disabled="@isProcessing">
                            <i class="fas fa-check me-2"></i> Approve
                        </button>
                        <button class="btn btn-danger" @onclick="ShowRejectModal" disabled="@isProcessing">
                            <i class="fas fa-times me-2"></i> Reject
                        </button>
                    }
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading payment details...</p>
            </div>
        }
        else if (payment == null)
        {
            <div class="alert alert-danger m-3 m-md-0">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Payment request not found
            </div>
        }
        else
        {
            <!-- Mobile View -->
            <div class="d-block d-md-none">
                <!-- Status Banner -->
                <div class="p-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Status</span>
                        <span class="badge @GetStatusBadge(payment.Status)" style="font-size: 1rem;">
                            @payment.Status.ToString()
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Invoice</span>
                        <span class="fw-bold">#@payment.InvoiceNumber</span>
                    </div>
                </div>

                <!-- Amount Card -->
                <div class="p-3 border-bottom bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Total Amount</small>
                            <h3 class="text-success mb-0">$@payment.Amount.ToString("N2")</h3>
                        </div>
                        <span class="badge @GetTypeBadge(payment.EnrollmentType) fs-6">
                            @payment.EnrollmentType.ToString()
                        </span>
                    </div>
                </div>

                <!-- Quick Actions (if pending) -->
                @if (payment.Status == PaymentStatus.Pending)
                {
                    <div class="p-3 border-bottom">
                        <div class="alert alert-warning small mb-3">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            This payment requires review
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-success flex-fill" @onclick="ApprovePayment" disabled="@isProcessing">
                                <i class="fas fa-check me-2"></i> Approve
                            </button>
                            <button class="btn btn-danger flex-fill" @onclick="ShowRejectModal" disabled="@isProcessing">
                                <i class="fas fa-times me-2"></i> Reject
                            </button>
                        </div>
                    </div>
                }

                <!-- User Info Accordion -->
                <div class="accordion" id="mobileAccordion">
                    <!-- Payment Details -->
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePayment">
                                <i class="fas fa-credit-card me-2 text-primary"></i> Payment Information
                            </button>
                        </h2>
                        <div id="collapsePayment" class="accordion-collapse collapse show">
                            <div class="accordion-body p-3">
                                <div class="info-row mb-3">
                                    <small class="text-muted d-block">Date Submitted</small>
                                    <span>@payment.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                </div>

                                @if (payment.Status != PaymentStatus.Pending && payment.ApprovedDate.HasValue)
                                {
                                    <div class="info-row mb-3">
                                        <small class="text-muted d-block">
                                            @(payment.Status == PaymentStatus.Approved ? "Approved" : "Rejected") By
                                        </small>
                                        @if (payment.ApprovedByAdmin != null)
                                        {
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm me-2">
                                                    @if (!string.IsNullOrEmpty(payment.ApprovedByAdmin.ProfileImageUrl))
                                                    {
                                                        <img src="@payment.ApprovedByAdmin.ProfileImageUrl" class="rounded-circle" width="24" height="24" alt="Admin" />
                                                    }
                                                    else
                                                    {
                                                        <div class="avatar-placeholder bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 12px;">
                                                            @GetInitials(payment.ApprovedByAdmin.FirstName, payment.ApprovedByAdmin.LastName)
                                                        </div>
                                                    }
                                                </div>
                                                <span>@payment.ApprovedByAdmin.FirstName @payment.ApprovedByAdmin.LastName</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span>System</span>
                                        }
                                    </div>
                                    <div class="info-row">
                                        <small class="text-muted d-block">
                                            @(payment.Status == PaymentStatus.Approved ? "Approved" : "Rejected") Date
                                        </small>
                                        <span>@payment.ApprovedDate?.ToString("MMM dd, yyyy HH:mm")</span>
                                    </div>
                                }

                                @if (payment.Status == PaymentStatus.Rejected && !string.IsNullOrEmpty(payment.RejectionReason))
                                {
                                    <div class="mt-3 p-2 bg-danger bg-opacity-10 rounded">
                                        <small class="text-danger fw-bold d-block">
                                            <i class="fas fa-info-circle me-1"></i>Rejection Reason:
                                        </small>
                                        <small class="text-danger">@payment.RejectionReason</small>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(payment.InvoicePdfUrl))
                                {
                                    <div class="mt-3">
                                        <button class="btn btn-outline-primary btn-sm w-100" @onclick="() => DownloadInvoice(payment.InvoicePdfUrl)">
                                            <i class="fas fa-file-pdf me-2"></i> View Invoice
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Content Details -->
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseContent">
                                <i class="fas @GetContentIcon() me-2 text-primary"></i> Content Details
                            </button>
                        </h2>
                        <div id="collapseContent" class="accordion-collapse collapse">
                            <div class="accordion-body p-3">
                                @if (payment.EnrollmentType == EnrollmentType.Lecture && payment.Lecture != null)
                                {
                                    <div>
                                        <div class="bg-light rounded p-3 text-center mb-3">
                                            <i class="fas fa-video fa-3x text-muted"></i>
                                        </div>
                                        <h6 class="fw-bold">@payment.Lecture.Title</h6>
                                        <p class="small text-muted">@(string.IsNullOrEmpty(payment.Lecture.Description) ? "No description available" : payment.Lecture.Description)</p>
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            <span class="badge bg-light text-dark">
                                                <i class="fas fa-clock me-1"></i> @payment.Lecture.EstimatedDurationMinutes min
                                            </span>
                                            @if (payment.Lecture.IsFreePreview)
                                            {
                                                <span class="badge bg-info">Free Preview</span>
                                            }
                                        </div>
                                        <a href="/admin/content/lectures/@payment.Lecture.Id" class="btn btn-outline-primary btn-sm w-100">
                                            View Details
                                        </a>
                                    </div>
                                }
                                else if (payment.EnrollmentType == EnrollmentType.Course && payment.Course != null)
                                {
                                    <div>
                                        @if (!string.IsNullOrEmpty(payment.Course.ThumbnailUrl))
                                        {
                                            <img src="@payment.Course.ThumbnailUrl" class="img-fluid rounded mb-3 w-100" style="height: 120px; object-fit: cover;" alt="Course" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded p-3 text-center mb-3">
                                                <i class="fas fa-book fa-3x text-muted"></i>
                                            </div>
                                        }
                                        <h6 class="fw-bold">@payment.Course.Title</h6>
                                        <p class="small text-muted">@(string.IsNullOrEmpty(payment.Course.Description) ? "No description available" : payment.Course.Description)</p>
                                        <a href="/admin/content/courses/@payment.Course.Id" class="btn btn-outline-primary btn-sm w-100">
                                            View Details
                                        </a>
                                    </div>
                                }
                                else if (payment.EnrollmentType == EnrollmentType.Specialization && payment.Specialization != null)
                                {
                                    <div>
                                        @if (!string.IsNullOrEmpty(payment.Specialization.ThumbnailUrl))
                                        {
                                            <img src="@payment.Specialization.ThumbnailUrl" class="img-fluid rounded mb-3 w-100" style="height: 120px; object-fit: cover;" alt="Specialization" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded p-3 text-center mb-3">
                                                <i class="fas fa-graduation-cap fa-3x text-muted"></i>
                                            </div>
                                        }
                                        <h6 class="fw-bold">@payment.Specialization.Title</h6>
                                        <p class="small text-muted">@(string.IsNullOrEmpty(payment.Specialization.Description) ? "No description available" : payment.Specialization.Description)</p>
                                        <a href="/admin/content/specializations/@payment.Specialization.Id" class="btn btn-outline-primary btn-sm w-100">
                                            View Details
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- User Information -->
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUser">
                                <i class="fas fa-user me-2 text-primary"></i> User Information
                            </button>
                        </h2>
                        <div id="collapseUser" class="accordion-collapse collapse">
                            <div class="accordion-body p-3">
                                <div class="text-center mb-3">
                                    @if (!string.IsNullOrEmpty(payment.User?.ProfileImageUrl))
                                    {
                                        <img src="@payment.User.ProfileImageUrl" class="rounded-circle mb-2" width="60" height="60" alt="User" />
                                    }
                                    else
                                    {
                                        <div class="avatar-placeholder-lg bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 60px; height: 60px; font-size: 24px;">
                                            @GetInitials(payment.User?.FirstName ?? "U", payment.User?.LastName ?? "N")
                                        </div>
                                    }
                                    <h6>@(payment.User?.FirstName ?? "Unknown") @(payment.User?.LastName ?? "User")</h6>
                                    <small class="text-muted d-block">@(payment.User?.Email ?? "No email")</small>
                                    @if (payment.User != null)
                                    {
                                        <span class="badge @GetUserTypeBadge(payment.User.UserType) mt-1">
                                            @payment.User.UserType.ToString()
                                        </span>
                                    }
                                </div>

                                <div class="info-list small">
                                    @if (payment.User != null)
                                    {
                                        @if (!string.IsNullOrEmpty(payment.User.PhoneNumber))
                                        {
                                            <div class="mb-2">
                                                <i class="fas fa-phone me-2 text-muted"></i>
                                                <a href="tel:@payment.User.PhoneNumber">@payment.User.PhoneNumber</a>
                                            </div>
                                        }
                                        <div class="mb-2">
                                            <i class="fas fa-calendar me-2 text-muted"></i>
                                            Joined: @payment.User.CreatedAt.ToString("MMM dd, yyyy")
                                        </div>
                                        <div class="mb-3">
                                            <i class="fas fa-circle me-2 @(payment.User.IsActive ? "text-success" : "text-danger")"></i>
                                            @(payment.User.IsActive ? "Active Account" : "Inactive Account")
                                        </div>
                                    }
                                </div>

                                @if (payment.User != null)
                                {
                                    <button class="btn btn-outline-primary btn-sm w-100" @onclick="() => ViewUserProfile(payment.User.Id)">
                                        <i class="fas fa-user me-2"></i> View Full Profile
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    @if (payment.Status == PaymentStatus.Approved)
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEnrollment">
                                    <i class="fas fa-check-circle me-2 text-success"></i> Enrollment Status
                                </button>
                            </h2>
                            <div id="collapseEnrollment" class="accordion-collapse collapse">
                                <div class="accordion-body p-3">
                                    <div class="alert alert-success mb-3">
                                        <i class="fas fa-check-circle me-2"></i>
                                        Payment approved. User should have access.
                                    </div>
                                    <button class="btn btn-outline-primary btn-sm w-100" @onclick="CheckUserEnrollment">
                                        <i class="fas fa-search me-2"></i> Verify Enrollment
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Desktop View -->
            <div class="d-none d-md-block">
                <div class="row">
                    <!-- Payment Details -->
                    <div class="col-md-8">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Payment Information</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label text-muted">Invoice Number</label>
                                        <p class="h5">@payment.InvoiceNumber</p>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label text-muted">Status</label>
                                        <div>
                                            <span class="badge @GetStatusBadge(payment.Status)" style="font-size: 1rem;">
                                                @payment.Status.ToString()
                                            </span>
                                            @if (payment.Status == PaymentStatus.Rejected && !string.IsNullOrEmpty(payment.RejectionReason))
                                            {
                                                <div class="mt-1">
                                                    <small class="text-danger">
                                                        <i class="fas fa-info-circle me-1"></i>
                                                        Reason: @payment.RejectionReason
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label text-muted">Payment Type</label>
                                        <p>
                                            <span class="badge @GetTypeBadge(payment.EnrollmentType)">
                                                @payment.EnrollmentType.ToString()
                                            </span>
                                        </p>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label text-muted">Amount</label>
                                        <p class="h4 text-success">$@payment.Amount.ToString("N2")</p>
                                        @if (payment.LectureId.HasValue || payment.CourseId.HasValue || payment.SpecializationId.HasValue)
                                        {
                                            <small class="text-muted">Doctor receives: $@((payment.Amount * 0.8m).ToString("N2")) (80%)</small>
                                        }
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label text-muted">Date Submitted</label>
                                        <p>@payment.CreatedAt.ToString("MMMM dd, yyyy HH:mm")</p>
                                    </div>

                                    @if (payment.Status != PaymentStatus.Pending && payment.ApprovedDate.HasValue)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label text-muted">
                                                @(payment.Status == PaymentStatus.Approved ? "Approved" : "Rejected") By
                                            </label>
                                            <p>
                                                @if (payment.ApprovedByAdmin != null)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar-sm me-2">
                                                            @if (!string.IsNullOrEmpty(payment.ApprovedByAdmin.ProfileImageUrl))
                                                            {
                                                                <img src="@payment.ApprovedByAdmin.ProfileImageUrl" class="rounded-circle" width="24" height="24" alt="Admin" />
                                                            }
                                                            else
                                                            {
                                                                <div class="avatar-placeholder bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 12px;">
                                                                    @GetInitials(payment.ApprovedByAdmin.FirstName, payment.ApprovedByAdmin.LastName)
                                                                </div>
                                                            }
                                                        </div>
                                                        <div>
                                                            @payment.ApprovedByAdmin.FirstName @payment.ApprovedByAdmin.LastName
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span>System</span>
                                                }
                                            </p>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label text-muted">
                                                @(payment.Status == PaymentStatus.Approved ? "Approved" : "Rejected") Date
                                            </label>
                                            <p>@payment.ApprovedDate?.ToString("MMMM dd, yyyy HH:mm")</p>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(payment.InvoicePdfUrl))
                                    {
                                        <div class="col-12 mb-3">
                                            <label class="form-label text-muted">Invoice Document</label>
                                            <div>
                                                <a href="@payment.InvoicePdfUrl" target="_blank" class="btn btn-outline-primary">
                                                    <i class="fas fa-file-pdf me-2"></i> View Invoice PDF
                                                </a>
                                                <button class="btn btn-outline-secondary ms-2" @onclick="() => DownloadInvoice(payment.InvoicePdfUrl)">
                                                    <i class="fas fa-download me-2"></i> Download
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Item Details -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Content Details</h5>
                            </div>
                            <div class="card-body">
                                @if (payment.EnrollmentType == EnrollmentType.Lecture && payment.Lecture != null)
                                {
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 150px;">
                                                <i class="fas fa-video fa-2x text-muted"></i>
                                            </div>
                                        </div>
                                        <div class="col-md-8">
                                            <h5>@payment.Lecture.Title</h5>
                                            <p class="text-muted">@(string.IsNullOrEmpty(payment.Lecture.Description) ? "No description available" : payment.Lecture.Description)</p>
                                            <div class="d-flex gap-3 mb-3">
                                                <span class="text-muted">
                                                    <i class="fas fa-clock me-1"></i>
                                                    @payment.Lecture.EstimatedDurationMinutes min
                                                </span>
                                                <span class="text-muted">
                                                    <i class="fas fa-dollar-sign me-1"></i>
                                                    $@payment.Lecture.Price.ToString("N2")
                                                </span>
                                                @if (payment.Lecture.IsFreePreview)
                                                {
                                                    <span class="badge bg-info">Free Preview</span>
                                                }
                                            </div>
                                            <a href="/admin/content/lectures/@payment.Lecture.Id" class="btn btn-sm btn-outline-primary">
                                                View Lecture Details
                                            </a>
                                        </div>
                                    </div>
                                }
                                else if (payment.EnrollmentType == EnrollmentType.Course && payment.Course != null)
                                {
                                    <div class="row">
                                        <div class="col-md-4">
                                            @if (!string.IsNullOrEmpty(payment.Course.ThumbnailUrl))
                                            {
                                                <img src="@payment.Course.ThumbnailUrl" class="img-fluid rounded" style="height: 150px; object-fit: cover;" alt="Course" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 150px;">
                                                    <i class="fas fa-book fa-2x text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="col-md-8">
                                            <h5>@payment.Course.Title</h5>
                                            <p class="text-muted">@(string.IsNullOrEmpty(payment.Course.Description) ? "No description available" : payment.Course.Description)</p>
                                            <div class="d-flex gap-3 mb-3">
                                                <span class="text-muted">
                                                    <i class="fas fa-dollar-sign me-1"></i>
                                                    $@payment.Course.Price.ToString("N2")
                                                </span>
                                            </div>
                                            <a href="/admin/content/courses/@payment.Course.Id" class="btn btn-sm btn-outline-primary">
                                                View Course Details
                                            </a>
                                        </div>
                                    </div>
                                }
                                else if (payment.EnrollmentType == EnrollmentType.Specialization && payment.Specialization != null)
                                {
                                    <div class="row">
                                        <div class="col-md-4">
                                            @if (!string.IsNullOrEmpty(payment.Specialization.ThumbnailUrl))
                                            {
                                                <img src="@payment.Specialization.ThumbnailUrl" class="img-fluid rounded" style="height: 150px; object-fit: cover;" alt="Specialization" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 150px;">
                                                    <i class="fas fa-graduation-cap fa-2x text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="col-md-8">
                                            <h5>@payment.Specialization.Title</h5>
                                            <p class="text-muted">@(string.IsNullOrEmpty(payment.Specialization.Description) ? "No description available" : payment.Specialization.Description)</p>
                                            <div class="d-flex gap-3 mb-3">
                                                <span class="text-muted">
                                                    <i class="fas fa-dollar-sign me-1"></i>
                                                    $@payment.Specialization.Price.ToString("N2")
                                                </span>
                                                <span class="text-muted">
                                                    <i class="fas fa-clock me-1"></i>
                                                    @payment.Specialization.EstimatedDurationHours hours
                                                </span>
                                            </div>
                                            @if (payment.Specialization.IsFeatured)
                                            {
                                                <span class="badge bg-warning me-2">
                                                    <i class="fas fa-star me-1"></i> Featured
                                                </span>
                                            }
                                            <a href="/admin/content/specializations/@payment.Specialization.Id" class="btn btn-sm btn-outline-primary">
                                                View Specialization Details
                                            </a>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-3">
                                        <i class="fas fa-question-circle fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">Content details not available</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- User Information -->
                    <div class="col-md-4">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">User Information</h5>
                            </div>
                            <div class="card-body">
                                <div class="text-center mb-3">
                                    @if (!string.IsNullOrEmpty(payment.User?.ProfileImageUrl))
                                    {
                                        <img src="@payment.User.ProfileImageUrl" class="rounded-circle mb-3" width="80" height="80" alt="User" />
                                    }
                                    else
                                    {
                                        <div class="avatar-placeholder-lg bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px; font-size: 32px;">
                                            @GetInitials(payment.User?.FirstName ?? "U", payment.User?.LastName ?? "N")
                                        </div>
                                    }
                                    <h5>@(payment.User?.FirstName ?? "Unknown") @(payment.User?.LastName ?? "User")</h5>
                                    <p class="text-muted">@(payment.User?.Email ?? "No email")</p>
                                    @if (payment.User != null)
                                    {
                                        <span class="badge @GetUserTypeBadge(payment.User.UserType)">
                                            @payment.User.UserType.ToString()
                                        </span>
                                    }
                                </div>
                                <ul class="list-unstyled">
                                    @if (payment.User != null)
                                    {
                                        <li class="mb-2">
                                            <i class="fas fa-envelope me-2 text-muted"></i>
                                            <a href="mailto:@payment.User.Email">@payment.User.Email</a>
                                        </li>
                                        @if (!string.IsNullOrEmpty(payment.User.PhoneNumber))
                                        {
                                            <li class="mb-2">
                                                <i class="fas fa-phone me-2 text-muted"></i>
                                                <a href="tel:@payment.User.PhoneNumber">@payment.User.PhoneNumber</a>
                                            </li>
                                        }
                                        <li class="mb-2">
                                            <i class="fas fa-calendar me-2 text-muted"></i>
                                            Joined: @payment.User.CreatedAt.ToString("MMMM dd, yyyy")
                                        </li>
                                        <li>
                                            <i class="fas fa-circle me-2 @(payment.User.IsActive ? "text-success" : "text-danger")"></i>
                                            @(payment.User.IsActive ? "Active Account" : "Inactive Account")
                                        </li>
                                    }
                                </ul>
                                @if (payment.User != null)
                                {
                                    <div class="d-grid">
                                        <button class="btn btn-outline-primary" @onclick="() => ViewUserProfile(payment.User.Id)">
                                            <i class="fas fa-user me-2"></i> View Profile
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Payment Actions -->
                        @if (payment.Status == PaymentStatus.Pending)
                        {
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">Actions</h5>
                                </div>
                                <div class="card-body">
                                    <div class="alert alert-warning">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        This payment requires review. Please verify the invoice and approve or reject accordingly.
                                    </div>
                                    <div class="d-grid gap-2">
                                        <button class="btn btn-success" @onclick="ApprovePayment" disabled="@isProcessing">
                                            <i class="fas fa-check me-2"></i> Approve Payment
                                        </button>
                                        <button class="btn btn-danger" @onclick="ShowRejectModal" disabled="@isProcessing">
                                            <i class="fas fa-times me-2"></i> Reject Payment
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (payment.Status == PaymentStatus.Approved)
                        {
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">Enrollment Status</h5>
                                </div>
                                <div class="card-body">
                                    <div class="alert alert-success">
                                        <i class="fas fa-check-circle me-2"></i>
                                        Payment approved. User should have access to the content.
                                    </div>
                                    <div class="d-grid">
                                        <button class="btn btn-outline-primary" @onclick="CheckUserEnrollment">
                                            <i class="fas fa-search me-2"></i> Check Enrollment Status
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Reject Modal (Mobile Optimized) -->
@if (showRejectModal)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Reject Payment</h5>
                    <button type="button" class="btn-close" @onclick="CloseRejectModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Reason for Rejection <span class="text-danger">*</span></label>
                        <textarea class="form-control"
                                  @bind="rejectionReason"
                                  @bind:event="oninput"
                                  rows="4"
                                  placeholder="Please provide a reason for rejecting this payment request..."
                                  disabled="@isProcessing"></textarea>
                        @if (showRejectionError && string.IsNullOrWhiteSpace(rejectionReason))
                        {
                            <div class="text-danger small mt-1">
                                <i class="fas fa-exclamation-circle me-1"></i>
                                Please provide a reason for rejection
                            </div>
                        }
                    </div>
                    <div class="alert alert-info small">
                        <i class="fas fa-info-circle me-2"></i>
                        The user will be notified with this reason.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseRejectModal" disabled="@isProcessing">Cancel</button>
                    <button type="button" class="btn @(string.IsNullOrWhiteSpace(rejectionReason) ? "btn-outline-danger" : "btn-danger")"
                            @onclick="TryRejectPayment"
                            disabled="@isProcessing">
                        @if (string.IsNullOrWhiteSpace(rejectionReason))
                        {
                            <span>Reason Required</span>
                        }
                        else
                        {
                            <span><i class="fas fa-times me-2"></i>Reject Payment</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int PaymentId { get; set; }

    private PaymentRequestDto? payment;
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showRejectModal = false;
    private string rejectionReason = string.Empty;
    private bool showRejectionError = false;
    private UserDto? currentAdmin;
    private List<PaymentRequestDto>? allPayments;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
        await LoadPayment();
    }

    private async Task CheckAuthentication()
    {
        try
        {
            var isAuthenticated = await TokenService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/account/login");
                return;
            }

            currentAdmin = await AuthService.GetCurrentUserAsync();

            if (currentAdmin == null || currentAdmin.UserType != UserType.Admin)
            {
                await ShowToast("error", "Access denied. Admin privileges required.");
                Navigation.NavigateTo("/");
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            Navigation.NavigateTo("/account/login");
        }
    }

    private string GetContentIcon()
    {
        return payment?.EnrollmentType switch
        {
            EnrollmentType.Lecture => "fa-video",
            EnrollmentType.Course => "fa-book",
            EnrollmentType.Specialization => "fa-graduation-cap",
            _ => "fa-question-circle"
        };
    }

    private async Task TryRejectPayment()
    {
        if (string.IsNullOrWhiteSpace(rejectionReason))
        {
            showRejectionError = true;
            StateHasChanged();
            return;
        }

        await RejectPayment();
    }

    private void CloseRejectModal()
    {
        showRejectModal = false;
        rejectionReason = string.Empty;
        showRejectionError = false;
        StateHasChanged();
    }

    private async Task LoadPayment()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            allPayments = await PaymentService.GetPaymentRequestsAsync(
                status: null,
                search: null,
                page: 1,
                pageSize: 1000
            );

            if (allPayments != null)
            {
                payment = allPayments.FirstOrDefault(p => p.Id == PaymentId);
            }

            if (payment == null)
            {
                await ShowToast("error", "Payment request not found");
                Navigation.NavigateTo("/admin/payments");
            }
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Error loading payment: {ex.Message}");
            Console.WriteLine($"Error loading payment: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetStatusBadge(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Approved => "bg-success",
            PaymentStatus.Pending => "bg-warning",
            PaymentStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetTypeBadge(EnrollmentType type)
    {
        return type switch
        {
            EnrollmentType.Lecture => "bg-info",
            EnrollmentType.Course => "bg-primary",
            EnrollmentType.Specialization => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetUserTypeBadge(UserType userType)
    {
        return userType switch
        {
            UserType.Admin => "bg-danger",
            UserType.Doctor => "bg-info",
            UserType.User => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetInitials(string firstName, string lastName)
    {
        if (string.IsNullOrEmpty(firstName) || string.IsNullOrEmpty(lastName))
            return "UU";

        return $"{firstName[0]}{lastName[0]}".ToUpper();
    }

    private async Task ApprovePayment()
    {
        if (payment == null || currentAdmin == null) return;

        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to approve payment {payment.InvoiceNumber}? This will grant user access to the content.");

        if (confirmed)
        {
            isProcessing = true;
            StateHasChanged();

            try
            {
                var updateDto = new UpdatePaymentRequestDto
                {
                    Status = PaymentStatus.Approved,
                    RejectionReason = null
                };

                await PaymentService.UpdatePaymentStatusAsync(payment.Id, updateDto);

                await ShowToast("success", "Payment approved successfully");
                await LoadPayment();
            }
            catch (Exception ex)
            {
                await ShowToast("error", ex.Message);
                Console.WriteLine($"Error approving payment: {ex.Message}");
            }
            finally
            {
                isProcessing = false;
                StateHasChanged();
            }
        }
    }

    private void ShowRejectModal()
    {
        rejectionReason = string.Empty;
        showRejectModal = true;
        StateHasChanged();
    }

    private async Task RejectPayment()
    {
        if (payment == null || string.IsNullOrWhiteSpace(rejectionReason) || currentAdmin == null) return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            var updateDto = new UpdatePaymentRequestDto
            {
                Status = PaymentStatus.Rejected,
                RejectionReason = rejectionReason
            };

            await PaymentService.UpdatePaymentStatusAsync(payment.Id, updateDto);

            await ShowToast("success", "Payment rejected successfully");
            CloseRejectModal();
            await LoadPayment();
        }
        catch (Exception ex)
        {
            await ShowToast("error", ex.Message);
            Console.WriteLine($"Error rejecting payment: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task DownloadInvoice(string url)
    {
        try
        {
            if (string.IsNullOrEmpty(url)) return;

            var fileName = $"invoice_{payment?.InvoiceNumber ?? "unknown"}.pdf";
            await JS.InvokeVoidAsync("downloadFile", url, fileName);
        }
        catch (Exception ex)
        {
            await ShowToast("error", ex.Message);
        }
    }

    private void ViewUserProfile(int userId)
    {
        Navigation.NavigateTo($"/admin/users/{userId}");
    }

    private async Task CheckUserEnrollment()
    {
        await ShowToast("info", "This feature is not implemented in the current service");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/payments");
    }

    private async Task ShowToast(string type, string message)
    {
        await JS.InvokeVoidAsync("showToast", type, message);
    }
}