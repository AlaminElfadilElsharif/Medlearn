
<div class="modal-backdrop fade show"></div>
<div class="modal fade show" style="display: block;" tabindex="-1" role="dialog">
    <!-- Responsive modal-dialog classes -->
    <div class="modal-dialog modal-dialog-scrollable @GetModalSizeClass()" role="document">
        <div class="modal-content">
            <!-- Header - Responsive -->
            <div class="modal-header @GetHeaderClass() text-white py-2 py-md-3">
                <h5 class="modal-title fs-6 fs-md-5">
                    <i class="@GetIcon() me-2"></i>@GetTitle() Withdrawal
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
            </div>

            <!-- Body - Responsive -->
            <div class="modal-body p-3 p-md-4">
                <!-- Alert Message -->
                <div class="alert @GetAlertClass() py-2 py-md-3 mb-3">
                    <i class="fas fa-info-circle me-2"></i>
                    <span class="small small-md-normal">@GetConfirmationMessage()</span>
                </div>

                <!-- Withdrawal Details Card - Responsive -->
                <div class="card mb-3">
                    <div class="card-body p-3 p-md-4">
                        <!-- Mobile View (Stacked) -->
                        <div class="d-block d-md-none">
                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-light rounded-circle p-2 me-2">
                                        <i class="fas fa-user-md text-primary"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Doctor</small>
                                        <span class="fw-bold">@Withdrawal?.Doctor?.FirstName @Withdrawal?.Doctor?.LastName</span>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="bg-light rounded p-2">
                                        <small class="text-muted d-block">Amount</small>
                                        <span class="fw-bold text-success fs-5">$@Withdrawal?.Amount.ToString("N2")</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-light rounded p-2">
                                        <small class="text-muted d-block">Method</small>
                                        <span class="fw-bold small">@GetShortPaymentMethod()</span>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-light rounded p-2">
                                <small class="text-muted d-block mb-1">Account Details</small>
                                <div class="small">@Withdrawal?.AccountDetails</div>
                            </div>
                        </div>

                        <!-- Desktop View (Grid) -->
                        <div class="d-none d-md-block">
                            <div class="row">
                                <div class="col-6">
                                    <small class="text-muted">Doctor</small>
                                    <div class="fw-bold">
                                        @Withdrawal?.Doctor?.FirstName @Withdrawal?.Doctor?.LastName
                                    </div>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Amount</small>
                                    <div class="fw-bold text-success">$@Withdrawal?.Amount.ToString("N2")</div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-12">
                                    <small class="text-muted">Payment Method</small>
                                    <div>@Withdrawal?.PaymentMethod</div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-12">
                                    <small class="text-muted">Account Details</small>
                                    <div class="small">@Withdrawal?.AccountDetails</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Notes Section - Responsive -->
                <div class="mb-3">
                    <label for="notes" class="form-label small @GetLabelClass() mb-1 mb-md-2">
                        @if (Action == WithdrawalStatus.Rejected)
                        {
                            <i class="fas fa-asterisk text-danger" style="font-size: 8px;"></i>
                        }
                        @GetNotesLabel()
                    </label>

                    <!-- Mobile: Smaller textarea -->
                    <div class="d-block d-md-none">
                        <textarea class="form-control form-control-sm" id="notes-mobile" rows="@GetMobileRows()"
                                  placeholder="@GetPlaceholder()" @bind="Notes"
                                  @oninput="HandleInput" required="@IsRequired()"
                                  style="font-size: 16px;"></textarea>
                    </div>

                    <!-- Desktop: Larger textarea -->
                    <div class="d-none d-md-block">
                        <textarea class="form-control" id="notes-desktop" rows="@GetDesktopRows()"
                                  placeholder="@GetPlaceholder()" @bind="Notes"
                                  @oninput="HandleInput" required="@IsRequired()"></textarea>
                    </div>

                    <div class="form-text small mt-1">@GetHelperText()</div>
                </div>

                <!-- Character Count for Rejection (Mobile) -->
                @if (Action == WithdrawalStatus.Rejected && !string.IsNullOrEmpty(Notes))
                {
                    <div class="text-end small text-muted d-block d-md-none">
                        @Notes.Length/500
                    </div>
                }
            </div>

            <!-- Footer - Responsive with mobile-optimized buttons -->
            <div class="modal-footer p-3 p-md-3">
                <!-- Mobile: Full-width buttons stacked -->
                <div class="d-block d-md-none w-100">
                    <button type="button" class="btn btn-outline-secondary w-100 mb-2" @onclick="Close">
                        Cancel
                    </button>
                    <button type="button" class="btn @GetButtonClass() w-100"
                            @onclick="Confirm" disabled="@IsDisabled()">
                        @if (IsProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        <i class="@GetButtonIcon() me-2"></i> @GetButtonText() Withdrawal
                    </button>
                </div>

                <!-- Desktop: Side-by-side buttons -->
                <div class="d-none d-md-block">
                    <button type="button" class="btn btn-secondary me-2" @onclick="Close">Cancel</button>
                    <button type="button" class="btn @GetButtonClass()"
                            @onclick="Confirm" disabled="@IsDisabled()">
                        @if (IsProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        <i class="@GetButtonIcon() me-2"></i> @GetButtonText() Withdrawal
                    </button>
                </div>
            </div>

            <!-- Mobile Swipe Indicator (optional) -->
            <div class="d-block d-md-none text-center pb-2">
                <div class="swipe-indicator">
                    <i class="fas fa-chevron-down text-muted"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mobile Bottom Sheet Style (for better mobile experience) -->
<style>
    @* Mobile-specific styles *@
    @@media (max-width: 767.98px) {
        .modal-dialog {
            margin: 0;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            max-height: 90vh;
            margin-bottom: 0;
            border-radius: 20px 20px 0 0;
            overflow: hidden;
        }

        .modal-content {
            border: none;
            border-radius: 20px 20px 0 0;
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-header {
            border-radius: 20px 20px 0 0;
            padding: 1rem;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .modal-footer {
            position: sticky;
            bottom: 0;
            background: white;
            border-top: 1px solid #dee2e6;
            padding: 1rem;
        }
        /* Swipe indicator animation */
        .swipe-indicator {
            animation: bounce 2s infinite;
        }

        @@keyframes bounce {
            0%, 20%, 50%, 80%, 100% {
                transform: translateY(0);
            }

            40% {
                transform: translateY(-5px);
            }

            60% {
                transform: translateY(-3px);
            }
        }
        /* Larger touch targets */
        .btn {
            padding: 12px !important;
            font-size: 16px !important;
        }
        /* Better spacing for mobile */
        .modal-body {
            padding-bottom: 1rem !important;
        }
        /* Prevent zoom on input focus for iOS */
        input, textarea, select {
            font-size: 16px !important;
        }
    }

    /* Tablet and up */
    @@media (min-width: 768px) {
        .small-md-normal {
            font-size: 1rem !important;
        }
    }
</style>

@code {
    [Parameter] public WithdrawalRequestDto? Withdrawal { get; set; }
    [Parameter] public WithdrawalStatus Action { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<WithdrawalStatus> OnConfirm { get; set; }

    private string Notes { get; set; } = "";
    private bool IsProcessing { get; set; } = false;

    private string GetModalSizeClass()
    {
        // Different sizes based on action
        return Action == WithdrawalStatus.Approved ? "modal-md" : "modal-md";
        // You could also use: return "modal-fullscreen-md-down"; for fullscreen on mobile
    }

    private string GetHeaderClass()
    {
        return Action == WithdrawalStatus.Approved ? "bg-success" : "bg-danger";
    }

    private string GetIcon()
    {
        return Action == WithdrawalStatus.Approved ? "fas fa-check-circle" : "fas fa-times-circle";
    }

    private string GetTitle()
    {
        return Action == WithdrawalStatus.Approved ? "Approve" : "Reject";
    }

    private string GetAlertClass()
    {
        return Action == WithdrawalStatus.Approved ? "alert-success" : "alert-danger";
    }

    private string GetConfirmationMessage()
    {
        return Action == WithdrawalStatus.Approved
            ? "Approve this withdrawal request?"
            : "Reject this withdrawal request?";
    }

    private string GetShortPaymentMethod()
    {
        if (string.IsNullOrEmpty(Withdrawal?.PaymentMethod))
            return "N/A";

        // Shorten payment method for mobile
        if (Withdrawal.PaymentMethod.Contains("Bank", StringComparison.OrdinalIgnoreCase))
            return "Bank Transfer";
        if (Withdrawal.PaymentMethod.Contains("PayPal", StringComparison.OrdinalIgnoreCase))
            return "PayPal";
        if (Withdrawal.PaymentMethod.Contains("Card", StringComparison.OrdinalIgnoreCase))
            return "Card";

        return Withdrawal.PaymentMethod.Length > 15
            ? Withdrawal.PaymentMethod.Substring(0, 12) + "..."
            : Withdrawal.PaymentMethod;
    }

    private string GetNotesLabel()
    {
        return Action == WithdrawalStatus.Approved
            ? "Notes (Optional)"
            : "Reason for Rejection";
    }

    private string GetLabelClass()
    {
        return Action == WithdrawalStatus.Rejected ? "text-danger fw-bold" : "";
    }

    private int GetMobileRows()
    {
        return Action == WithdrawalStatus.Rejected ? 4 : 3;
    }

    private int GetDesktopRows()
    {
        return Action == WithdrawalStatus.Rejected ? 3 : 2;
    }

    private string GetPlaceholder()
    {
        return Action == WithdrawalStatus.Approved
            ? "Add any notes for the doctor..."
            : "Please provide a reason for rejecting this withdrawal request...";
    }

    private string GetHelperText()
    {
        return Action == WithdrawalStatus.Rejected
            ? "This reason will be shared with the doctor."
            : "Optional notes will be visible to the doctor.";
    }

    private string GetButtonClass()
    {
        return Action == WithdrawalStatus.Approved ? "btn-success" : "btn-danger";
    }

    private string GetButtonIcon()
    {
        return Action == WithdrawalStatus.Approved ? "fas fa-check" : "fas fa-times";
    }

    private string GetButtonText()
    {
        return Action == WithdrawalStatus.Approved ? "Approve" : "Reject";
    }

    private bool IsRequired()
    {
        return Action == WithdrawalStatus.Rejected;
    }

    private bool IsDisabled()
    {
        if (IsProcessing) return true;
        if (Action == WithdrawalStatus.Rejected && string.IsNullOrWhiteSpace(Notes)) return true;
        return false;
    }

    private void HandleInput(ChangeEventArgs e)
    {
        Notes = e.Value?.ToString() ?? "";

        // Optional: Limit notes length for rejection
        if (Action == WithdrawalStatus.Rejected && Notes.Length > 500)
        {
            Notes = Notes[..500];
        }

        StateHasChanged();
    }

    private void Close()
    {
        OnClose.InvokeAsync();
    }

    private async Task Confirm()
    {
        IsProcessing = true;
        try
        {
            // You can pass the notes along with the action if needed
            await OnConfirm.InvokeAsync(Action);
        }
        finally
        {
            IsProcessing = false;
        }
    }
}
