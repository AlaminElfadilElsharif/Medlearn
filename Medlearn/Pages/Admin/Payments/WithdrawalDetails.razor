@page "/admin/withdrawals/{id:int}"


<PageTitle>Admin - Withdrawal Details #@Id</PageTitle>

<div class="withdrawal-details">
    <div class="container-fluid px-0 px-md-3 py-0 py-md-4">
        <!-- Mobile Header -->
        <div class="d-block d-md-none bg-primary text-white p-3 mb-3">
            <div class="d-flex align-items-center">
                <a href="/admin/withdrawals" class="btn btn-link text-white p-0 me-3">
                    <i class="fas fa-arrow-left fa-lg"></i>
                </a>
                <div class="flex-grow-1">
                    <h5 class="mb-0">Withdrawal #@Id</h5>
                    <small class="opacity-75">@(withdrawal?.RequestDate.ToString("MMM dd, yyyy") ?? "Loading...")</small>
                </div>
                @if (withdrawal?.Status == WithdrawalStatus.Pending)
                {
                    <div class="dropdown">
                        <button class="btn btn-link text-white p-0" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-ellipsis-v fa-lg"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <button class="dropdown-item text-success" @onclick="ShowApproveModal">
                                    <i class="fas fa-check-circle me-2"></i>Approve
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item text-danger" @onclick="ShowRejectModal">
                                    <i class="fas fa-times-circle me-2"></i>Reject
                                </button>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a href="mailto:@withdrawal?.Doctor.Email" class="dropdown-item">
                                    <i class="fas fa-envelope me-2"></i>Email
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>

        <!-- Desktop Back Button -->
        <div class="d-none d-md-block mb-4">
            <a href="/admin/withdrawals" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i> Back to Withdrawals
            </a>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3">Loading withdrawal details...</p>
            </div>
        }
        else if (withdrawal == null)
        {
            <div class="text-center py-5">
                <i class="fas fa-exclamation-circle fa-3x text-danger mb-3"></i>
                <h4>Withdrawal Not Found</h4>
                <p class="text-muted">The requested withdrawal could not be found.</p>
                <a href="/admin/withdrawals" class="btn btn-primary">
                    <i class="fas fa-list me-2"></i> View All Withdrawals
                </a>
            </div>
        }
        else
        {
            <div class="row g-3 g-md-4">
                <!-- Left Column -->
                <div class="col-lg-8">
                    <!-- Header Card - Mobile Summary -->
                    <div class="d-block d-md-none mb-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge @GetStatusBadgeClass(withdrawal.Status) px-3 py-2">
                                        @withdrawal.Status
                                    </span>
                                    <div class="text-end">
                                        <div class="h4 mb-0 text-success">$@withdrawal.Amount.ToString("N2")</div>
                                    </div>
                                </div>
                                <div class="small text-muted">
                                    <i class="fas fa-clock me-1"></i>Requested: @withdrawal.RequestDate.ToString("MMM dd, yyyy hh:mm tt")
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Desktop Header Card -->
                    <div class="d-none d-md-block card shadow mb-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h4 class="mb-1">
                                        Withdrawal Request #@withdrawal.Id
                                        <span class="badge @GetStatusBadgeClass(withdrawal.Status) ms-2">
                                            @withdrawal.Status
                                        </span>
                                    </h4>
                                    <p class="text-muted mb-0">
                                        Requested on @withdrawal.RequestDate.ToString("MMMM dd, yyyy hh:mm tt")
                                    </p>
                                </div>
                                <div class="text-end">
                                    <div class="display-6 fw-bold text-success">$@withdrawal.Amount.ToString("N2")</div>
                                    <small class="text-muted">Amount requested</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Doctor Information Card -->
                    <div class="card shadow mb-3 mb-md-4">
                        <div class="card-header bg-light">
                            <h6 class="m-0 fw-bold text-primary">
                                <i class="fas fa-user-md me-2"></i>Doctor Information
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <div class="d-flex flex-column">
                                        <small class="text-muted">Name</small>
                                        <span class="fw-bold">@withdrawal.Doctor.FirstName @withdrawal.Doctor.LastName</span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="d-flex flex-column">
                                        <small class="text-muted">Email</small>
                                        <span class="text-break">@withdrawal.Doctor.Email</span>
                                    </div>
                                </div>
                                <div class="col-6 col-md-6">
                                    <div class="d-flex flex-column">
                                        <small class="text-muted">Phone</small>
                                        <span>@(withdrawal.Doctor.PhoneNumber ?? "Not provided")</span>
                                    </div>
                                </div>
                                <div class="col-6 col-md-6">
                                    <div class="d-flex flex-column">
                                        <small class="text-muted">Member Since</small>
                                        <span>@withdrawal.Doctor.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Mobile Quick Actions -->
                            <div class="d-block d-md-none mt-3">
                                <div class="btn-group w-100" role="group">
                                    <a href="mailto:@withdrawal.Doctor.Email" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-envelope me-1"></i> Email
                                    </a>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="PrintDetails">
                                        <i class="fas fa-print me-1"></i> Print
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Information Card -->
                    <div class="card shadow mb-3 mb-md-4">
                        <div class="card-header bg-light">
                            <h6 class="m-0 fw-bold text-primary">
                                <i class="fas fa-credit-card me-2"></i>Payment Information
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-6 col-md-6">
                                    <div class="d-flex flex-column">
                                        <small class="text-muted">Payment Method</small>
                                        <span class="badge bg-info d-inline-block mt-1" style="width: fit-content;">
                                            @withdrawal.PaymentMethod
                                        </span>
                                    </div>
                                </div>
                                <div class="col-6 col-md-6">
                                    <div class="d-flex flex-column">
                                        <small class="text-muted">Request Date</small>
                                        <span>@withdrawal.RequestDate.ToString("MMM dd, yyyy")</span>
                                        <small class="text-muted">@withdrawal.RequestDate.ToString("hh:mm tt")</small>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="d-flex flex-column">
                                        <small class="text-muted mb-1">Account Details</small>
                                        <div class="border rounded p-3 bg-light">
                                            <pre class="mb-0 small" style="white-space: pre-wrap; font-family: inherit;">@withdrawal.AccountDetails</pre>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Admin Notes (Mobile) -->
                    @if (!string.IsNullOrEmpty(withdrawal.Notes))
                    {
                        <div class="d-block d-md-none card shadow mb-3">
                            <div class="card-header bg-light">
                                <h6 class="m-0 fw-bold text-primary">
                                    <i class="fas fa-sticky-note me-2"></i>Admin Notes
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="border rounded p-3 bg-light small">
                                    @withdrawal.Notes
                                </div>
                                @if (withdrawal.ProcessedByAdmin != null)
                                {
                                    <small class="text-muted mt-2 d-block">
                                        Added by: @withdrawal.ProcessedByAdmin.FirstName @withdrawal.ProcessedByAdmin.LastName
                                    </small>
                                }
                            </div>
                        </div>
                    }

                    <!-- Admin Actions - Mobile Floating Action Button -->
                    @if (withdrawal.Status == WithdrawalStatus.Pending)
                    {
                        <div class="d-block d-md-none">
                            <!-- Floating Action Button -->
                            <button class="fab-btn" @onclick="ShowActionMenu">
                                <i class="fas fa-gavel"></i>
                            </button>

                            <!-- Action Menu Modal -->
                            @if (showActionMenu)
                            {
                                <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
                                    <div class="modal-dialog modal-dialog-bottom">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Take Action</h5>
                                                <button type="button" class="btn-close" @onclick="CloseActionMenu"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="d-grid gap-2">
                                                    <button class="btn btn-success btn-lg" @onclick="ShowApproveModal">
                                                        <i class="fas fa-check-circle me-2"></i> Approve Withdrawal
                                                    </button>
                                                    <button class="btn btn-danger btn-lg" @onclick="ShowRejectModal">
                                                        <i class="fas fa-times-circle me-2"></i> Reject Withdrawal
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button class="btn btn-secondary w-100" @onclick="CloseActionMenu">Cancel</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Desktop Admin Actions -->
                        <div class="d-none d-md-block card shadow">
                            <div class="card-header bg-warning text-white">
                                <h6 class="m-0 fw-bold">
                                    <i class="fas fa-tasks me-2"></i>Admin Actions
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    This withdrawal request requires your action.
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <button class="btn btn-success w-100" @onclick="ShowApproveModal">
                                            <i class="fas fa-check-circle me-2"></i> Approve Withdrawal
                                        </button>
                                    </div>
                                    <div class="col-md-6">
                                        <button class="btn btn-danger w-100" @onclick="ShowRejectModal">
                                            <i class="fas fa-times-circle me-2"></i> Reject Withdrawal
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Right Column - Desktop Only -->
                <div class="col-lg-4 d-none d-md-block">
                    <!-- Status Timeline -->
                    <div class="card shadow mb-4">
                        <div class="card-header bg-light">
                            <h6 class="m-0 fw-bold text-primary">
                                <i class="fas fa-history me-2"></i>Status Timeline
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="timeline">
                                <div class="timeline-item">
                                    <div class="timeline-marker bg-primary"></div>
                                    <div class="timeline-content">
                                        <h6 class="fw-bold">Request Submitted</h6>
                                        <p class="text-muted small mb-0">
                                            @withdrawal.RequestDate.ToString("MMM dd, yyyy hh:mm tt")
                                        </p>
                                    </div>
                                </div>

                                @if (withdrawal.Status == WithdrawalStatus.Approved)
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-marker bg-success"></div>
                                        <div class="timeline-content">
                                            <h6 class="fw-bold">Approved</h6>
                                            <p class="text-muted small mb-0">
                                                @withdrawal.ProcessedDate?.ToString("MMM dd, yyyy hh:mm tt")
                                            </p>
                                            <small>
                                                By: @withdrawal.ProcessedByAdmin?.FirstName @withdrawal.ProcessedByAdmin?.LastName
                                            </small>
                                        </div>
                                    </div>
                                }
                                else if (withdrawal.Status == WithdrawalStatus.Rejected)
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-marker bg-danger"></div>
                                        <div class="timeline-content">
                                            <h6 class="fw-bold">Rejected</h6>
                                            <p class="text-muted small mb-0">
                                                @withdrawal.ProcessedDate?.ToString("MMM dd, yyyy hh:mm tt")
                                            </p>
                                            <small>
                                                By: @withdrawal.ProcessedByAdmin?.FirstName @withdrawal.ProcessedByAdmin?.LastName
                                            </small>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-marker bg-secondary"></div>
                                        <div class="timeline-content">
                                            <h6 class="fw-bold">Awaiting Review</h6>
                                            <p class="text-muted small mb-0">Pending admin approval</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Admin Notes (Desktop) -->
                    @if (!string.IsNullOrEmpty(withdrawal.Notes))
                    {
                        <div class="card shadow mb-4">
                            <div class="card-header bg-light">
                                <h6 class="m-0 fw-bold text-primary">
                                    <i class="fas fa-sticky-note me-2"></i>Admin Notes
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="border rounded p-3 bg-light">
                                    @withdrawal.Notes
                                </div>
                                @if (withdrawal.ProcessedByAdmin != null)
                                {
                                    <small class="text-muted mt-2 d-block">
                                        Added by: @withdrawal.ProcessedByAdmin.FirstName @withdrawal.ProcessedByAdmin.LastName
                                    </small>
                                }
                            </div>
                        </div>
                    }

                    <!-- Quick Actions (Desktop) -->
                    <div class="card shadow">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3">Quick Actions</h6>
                            <div class="d-grid gap-2">
                                <a href="mailto:@withdrawal.Doctor.Email" class="btn btn-outline-primary">
                                    <i class="fas fa-envelope me-2"></i> Email Doctor
                                </a>
                                <button class="btn btn-outline-secondary" @onclick="PrintDetails">
                                    <i class="fas fa-print me-2"></i> Print Details
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Approve Modal (Shared) -->
            @if (showApproveModal)
            {
                <div class="modal-backdrop fade show"></div>
                <div class="modal fade show d-block" tabindex="-1" role="dialog">
                    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
                        <div class="modal-content">
                            <div class="modal-header bg-success text-white">
                                <h5 class="modal-title">
                                    <i class="fas fa-check-circle me-2"></i>Approve Withdrawal
                                </h5>
                                <button type="button" class="btn-close btn-close-white" @onclick="CloseModals"></button>
                            </div>
                            <div class="modal-body">
                                <div class="alert alert-success">
                                    <i class="fas fa-info-circle me-2"></i>
                                    Are you sure you want to approve this withdrawal request?
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Notes (Optional)</label>
                                    <textarea class="form-control" rows="3" @bind="notes"
                                              placeholder="Add any notes for the doctor..."></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                                <button type="button" class="btn btn-success" @onclick="@(() => ProcessWithdrawal(WithdrawalStatus.Approved))">
                                    <i class="fas fa-check me-2"></i> Approve
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Reject Modal (Shared) -->
            @if (showRejectModal)
            {
                <div class="modal-backdrop fade show"></div>
                <div class="modal fade show d-block" tabindex="-1" role="dialog">
                    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
                        <div class="modal-content">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title">
                                    <i class="fas fa-times-circle me-2"></i>Reject Withdrawal
                                </h5>
                                <button type="button" class="btn-close btn-close-white" @onclick="CloseModals"></button>
                            </div>
                            <div class="modal-body">
                                <div class="alert alert-danger">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    Are you sure you want to reject this withdrawal request?
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-danger">
                                        Reason for Rejection <span class="text-danger">*</span>
                                    </label>
                                    <textarea class="form-control" rows="3" @bind="notes"
                                              placeholder="Please provide a reason..."></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                                <button type="button" class="btn btn-danger"
                                        @onclick="@(() => ProcessWithdrawal(WithdrawalStatus.Rejected))"
                                        disabled="@string.IsNullOrWhiteSpace(notes)">
                                    <i class="fas fa-times me-2"></i> Reject
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Timeline Mobile View -->
            <div class="d-block d-md-none mt-3">
                <div class="card shadow">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold text-primary">
                            <i class="fas fa-history me-2"></i>Status Timeline
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="timeline-horizontal">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="text-center flex-fill">
                                    <div class="timeline-dot @(withdrawal.Status != WithdrawalStatus.Pending ? "bg-primary" : "bg-primary")"></div>
                                    <small class="d-block mt-1">Requested</small>
                                    <small class="text-muted">@withdrawal.RequestDate.ToString("MMM dd")</small>
                                </div>
                                <div class="timeline-line flex-fill"></div>
                                <div class="text-center flex-fill">
                                    <div class="timeline-dot @(withdrawal.Status == WithdrawalStatus.Approved ? "bg-success" : (withdrawal.Status == WithdrawalStatus.Rejected ? "bg-danger" : "bg-secondary"))"></div>
                                    <small class="d-block mt-1">
                                        @if (withdrawal.Status == WithdrawalStatus.Approved)
                                        {
                                            <span>Approved</span>
                                        }
                                        else if (withdrawal.Status == WithdrawalStatus.Rejected)
                                        {
                                            <span>Rejected</span>
                                        }
                                        else
                                        {
                                            <span>Pending</span>
                                        }
                                    </small>
                                    @if (withdrawal.ProcessedDate.HasValue)
                                    {
                                        <small class="text-muted">@withdrawal.ProcessedDate.Value.ToString("MMM dd")</small>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .withdrawal-details {
        background-color: #f8f9fc;
        min-height: calc(100vh - 56px);
    }

    /* Desktop styles */
    .display-6 {
        font-size: 2.5rem;
    }

    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 20px;
    }

    .timeline-marker {
        position: absolute;
        left: -30px;
        top: 0;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 3px solid #fff;
    }

    .timeline-content {
        padding-left: 15px;
    }

    .timeline:before {
        content: '';
        position: absolute;
        left: -21px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e9ecef;
    }

    /* Mobile Floating Action Button */
    .fab-btn {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background-color: #007bff;
        color: white;
        border: none;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        font-size: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        transition: transform 0.2s;
    }

        .fab-btn:active {
            transform: scale(0.95);
        }

    /* Mobile Bottom Modal */
    .modal-dialog-bottom {
        margin: 0;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        max-width: 100%;
    }

        .modal-dialog-bottom .modal-content {
            border-radius: 15px 15px 0 0;
            border: none;
        }

    /* Mobile Timeline */
    .timeline-horizontal {
        padding: 10px 0;
    }

    .timeline-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin: 0 auto;
    }

    .timeline-line {
        height: 2px;
        background: #dee2e6;
        margin: 0 -10px;
    }

    /* Status badges */
    .badge.bg-warning {
        background-color: #f6c23e !important;
        color: #000;
    }

    .badge.bg-success {
        background-color: #1cc88a !important;
        color: #fff;
    }

    .badge.bg-danger {
        background-color: #e74a3b !important;
        color: #fff;
    }

    pre {
        font-family: inherit;
        font-size: inherit;
        margin: 0;
    }

    /* Mobile text break */
    .text-break {
        word-break: break-word;
    }

    /* Card borders for mobile */
    @@media (max-width: 767.98px) {
        .card {
            border-left: none;
            border-right: none;
            border-radius: 0;
        }

        .card-header {
            border-radius: 0 !important;
        }

        .container-fluid {
            padding-left: 0;
            padding-right: 0;
        }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private WithdrawalRequestDto? withdrawal = null;
    private bool isLoading = true;
    private bool showApproveModal = false;
    private bool showRejectModal = false;
    private bool showActionMenu = false;
    private string notes = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadWithdrawalDetails();
    }

    private async Task LoadWithdrawalDetails()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Load all withdrawals and find the specific one
            var withdrawals = await WithdrawalService.GetAdminWithdrawalsAsync();
            withdrawal = withdrawals?.FirstOrDefault(w => w.Id == Id);
        }
        catch (Exception ex)
        {
            await ShowError($"Failed to load withdrawal details: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetStatusBadgeClass(WithdrawalStatus status)
    {
        return status switch
        {
            WithdrawalStatus.Pending => "bg-warning",
            WithdrawalStatus.Approved => "bg-success",
            WithdrawalStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private void ShowActionMenu()
    {
        showActionMenu = true;
        StateHasChanged();
    }

    private void CloseActionMenu()
    {
        showActionMenu = false;
        StateHasChanged();
    }

    private void ShowApproveModal()
    {
        notes = "";
        showApproveModal = true;
        showRejectModal = false;
        showActionMenu = false;
        StateHasChanged();
    }

    private void ShowRejectModal()
    {
        notes = "";
        showRejectModal = true;
        showApproveModal = false;
        showActionMenu = false;
        StateHasChanged();
    }

    private void CloseModals()
    {
        showApproveModal = false;
        showRejectModal = false;
        showActionMenu = false;
        notes = "";
        StateHasChanged();
    }

    private async Task ProcessWithdrawal(WithdrawalStatus status)
    {
        if (withdrawal == null) return;

        try
        {
            var dto = new ProcessWithdrawalDto
            {
                Status = status,
                Notes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim()
            };

            var success = await WithdrawalService.ProcessWithdrawalAsync(Id, dto);

            if (success)
            {
                await ShowSuccess($"Withdrawal {status.ToString().ToLower()} successfully!");
                CloseModals();
                await LoadWithdrawalDetails();
            }
            else
            {
                await ShowError($"Failed to {status.ToString().ToLower()} withdrawal");
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Error: {ex.Message}");
        }
    }

    private async Task PrintDetails()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task ShowSuccess(string message)
    {
        await JS.InvokeVoidAsync("showToast", "success", message);
    }

    private async Task ShowError(string message)
    {
        await JS.InvokeVoidAsync("showToast", "error", message);
    }
}
