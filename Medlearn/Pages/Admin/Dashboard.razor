    private async Task QuickApproveWithdrawal(WithdrawalRequestDto withdrawal)
    {
        try
        {
            var dto = new ProcessWithdrawalDto
            {
                Status = WithdrawalStatus.Approved,
                Notes = "Approved from dashboard"
            };

            var success = await WithdrawalService.ProcessWithdrawalAsync(withdrawal.Id, dto);

            if (success)
            {
                await ShowSuccess($"Withdrawal #{withdrawal.Id} approved!");
                await LoadDashboardData();
            }
            else
            {
                await ShowError("Failed to approve withdrawal");
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Error: {ex.Message}");
        }
    }

