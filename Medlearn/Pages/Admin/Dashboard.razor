@page "/admin/dashboard"
@using System.Text.Json


<PageTitle>Admin Dashboard</PageTitle>

<div class="admin-dashboard">
    <div class="container-fluid px-0 px-md-3">
        <!-- Authentication Check -->
        @if (!isAuthenticated)
        {
            <div class="text-center py-5 px-3">
                <div class="alert alert-warning shadow-sm" role="alert">
                    <i class="fas fa-exclamation-circle fa-3x mb-3"></i>
                    <h4>Authentication Required</h4>
                    <p class="mb-3">Please log in to access the admin dashboard.</p>
                    <button class="btn btn-primary px-4" @onclick="RedirectToLogin">
                        <i class="fas fa-sign-in-alt me-2"></i> Login
                    </button>
                </div>
            </div>
        }
        else if (currentUser?.UserType != UserType.Admin)
        {
            <div class="text-center py-5 px-3">
                <div class="alert alert-danger shadow-sm" role="alert">
                    <i class="fas fa-ban fa-3x mb-3"></i>
                    <h4>Access Denied</h4>
                    <p class="mb-3">Admin privileges required to access this page.</p>
                    <button class="btn btn-primary px-4" @onclick="RedirectToHome">
                        <i class="fas fa-home me-2"></i> Go to Home
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Mobile Header -->
            <div class="d-block d-md-none mb-3">
                <div class="bg-primary text-white p-3 rounded-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h5 class="mb-0">
                                <i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard
                            </h5>
                            <small class="text-white-50">
                                Welcome, @currentUser?.FirstName
                            </small>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-link text-white p-0" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-ellipsis-v fa-lg"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <button class="dropdown-item" @onclick="RefreshData" disabled="@isLoading">
                                        <i class="fas fa-sync-alt me-2 @(isLoading ? "fa-spin" : "")"></i>Refresh
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="/admin/users">
                                        <i class="fas fa-users me-2"></i>Users
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/admin/announcements">
                                        <i class="fas fa-bullhorn me-2"></i>Announcements
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/admin/withdrawals">
                                        <i class="fas fa-money-bill-wave me-2"></i>Withdrawals
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="bg-light p-2 text-end">
                    <small class="text-muted">
                        <i class="fas fa-clock me-1"></i>Last updated: @lastRefreshTime.ToString("HH:mm")
                    </small>
                </div>
            </div>

            <!-- Desktop Header -->
            <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h1>
                    <p class="text-muted mb-0">
                        Welcome, <strong>@currentUser?.FirstName @currentUser?.LastName</strong>
                        <span class="badge bg-danger ms-2">Administrator</span>
                    </p>
                </div>
                <div>
                    <button class="btn btn-outline-primary me-2" @onclick="RefreshData" disabled="@isLoading">
                        <i class="fas fa-sync-alt @(isLoading ? "fa-spin" : "") me-2"></i>
                        Refresh
                    </button>
                    <span class="text-muted small">Last updated: @lastRefreshTime.ToString("HH:mm")</span>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3">Loading dashboard data...</p>
                </div>
            }
            else
            {
                <!-- Quick Stats - Mobile Horizontal Scroll -->
                <div class="d-block d-md-none mb-3">
                    <div class="stats-scroll-container">
                        <div class="stats-row">
                            <!-- Total Users -->
                            <div class="stat-card bg-primary text-white">
                                <div class="stat-content">
                                    <div class="stat-label">Total Users</div>
                                    <div class="stat-value">@totalUsers</div>
                                    <div class="stat-detail">
                                        <small>@doctorCount Docs • @studentCount Stud</small>
                                    </div>
                                </div>
                                <i class="fas fa-users stat-icon"></i>
                            </div>

                            <!-- Total Revenue -->
                            <div class="stat-card bg-success text-white">
                                <div class="stat-content">
                                    <div class="stat-label">Revenue</div>
                                    <div class="stat-value">$@totalRevenue.ToString("N0")</div>
                                    <div class="stat-detail">
                                        <small>Bal: $@doctorBalance.ToString("N0")</small>
                                    </div>
                                </div>
                                <i class="fas fa-dollar-sign stat-icon"></i>
                            </div>

                            <!-- Enrollments -->
                            <div class="stat-card bg-info text-white">
                                <div class="stat-content">
                                    <div class="stat-label">Enrollments</div>
                                    <div class="stat-value">@totalEnrollments</div>
                                    <div class="stat-detail">
                                        <small>@completedEnrollments Comp</small>
                                    </div>
                                </div>
                                <i class="fas fa-graduation-cap stat-icon"></i>
                            </div>

                            <!-- Pending Payments -->
                            <div class="stat-card bg-warning text-dark">
                                <div class="stat-content">
                                    <div class="stat-label">Pending</div>
                                    <div class="stat-value">@pendingPayments</div>
                                    <div class="stat-detail">
                                        <small>Payments</small>
                                    </div>
                                </div>
                                <i class="fas fa-credit-card stat-icon"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Desktop Quick Stats -->
                <div class="d-none d-md-block">
                    <div class="row mb-3">
                        <div class="col-md-3 col-6 mb-3">
                            <div class="card bg-primary text-white shadow">
                                <div class="card-body p-3">
                                    <div class="row">
                                        <div class="col-8">
                                            <div class="text-white-50 small">Total Users</div>
                                            <div class="h5 mb-0">@totalUsers</div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <i class="fas fa-users fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-primary py-1 border-0">
                                    <small class="text-white-50">
                                        @doctorCount Docs • @studentCount Stud • @adminCount Adm
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6 mb-3">
                            <div class="card bg-success text-white shadow">
                                <div class="card-body p-3">
                                    <div class="row">
                                        <div class="col-8">
                                            <div class="text-white-50 small">Total Revenue</div>
                                            <div class="h5 mb-0">$@totalRevenue.ToString("N2")</div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <i class="fas fa-dollar-sign fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-success py-1 border-0">
                                    <small class="text-white-50">
                                        Doctor Balance: $@doctorBalance.ToString("N2")
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6 mb-3">
                            <div class="card bg-info text-white shadow">
                                <div class="card-body p-3">
                                    <div class="row">
                                        <div class="col-8">
                                            <div class="text-white-50 small">Enrollments</div>
                                            <div class="h5 mb-0">@totalEnrollments</div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <i class="fas fa-graduation-cap fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-info py-1 border-0">
                                    <small class="text-white-50">
                                        @completedEnrollments Comp • @activeEnrollments Active
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6 mb-3">
                            <div class="card bg-warning text-dark shadow">
                                <div class="card-body p-3">
                                    <div class="row">
                                        <div class="col-8">
                                            <div class="text-dark-50 small">Pending Payments</div>
                                            <div class="h5 mb-0">@pendingPayments</div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <i class="fas fa-credit-card fa-2x text-dark"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-warning py-1 border-0">
                                    <small class="text-dark-50">
                                        @approvedPayments Approved • @rejectedPayments Rejected
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Dashboard - Mobile Optimized -->
                <div class="d-block d-md-none">
                    <!-- Withdrawals Overview Card -->
                    <div class="card shadow mb-3">
                        <div class="card-header py-2 d-flex justify-content-between align-items-center bg-light">
                            <h6 class="m-0 fw-bold text-primary">
                                <i class="fas fa-money-bill-wave me-2"></i>Withdrawals
                            </h6>
                            <a href="/admin/withdrawals" class="btn btn-sm btn-outline-primary">
                                View All
                            </a>
                        </div>
                        <div class="card-body p-3">
                            <!-- Withdrawal Stats Row -->
                            <div class="row g-2 mb-3">
                                <div class="col-4">
                                    <div class="border rounded p-2 text-center">
                                        <span class="badge bg-warning mb-1">Pending</span>
                                        <div class="fw-bold">@pendingWithdrawalCount</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2 text-center">
                                        <span class="badge bg-success mb-1">Approved</span>
                                        <div class="fw-bold">@approvedWithdrawalCount</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2 text-center">
                                        <span class="badge bg-danger mb-1">Rejected</span>
                                        <div class="fw-bold">@rejectedWithdrawalCount</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Recent Withdrawals List -->
                            <h6 class="small fw-bold mb-2">Recent Requests</h6>
                            @if (recentWithdrawals != null && recentWithdrawals.Any())
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var withdrawal in recentWithdrawals.Take(3))
                                    {
                                        <div class="list-group-item px-0 py-2 border-0 border-bottom">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-grow-1" @onclick="() => ViewWithdrawal(withdrawal.Id)">
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2">
                                                            <i class="fas fa-user-md"></i>
                                                        </div>
                                                        <div>
                                                            <div class="fw-bold small">@withdrawal.Doctor.FirstName @withdrawal.Doctor.LastName</div>
                                                            <small class="text-muted">$@withdrawal.Amount.ToString("N2")</small>
                                                        </div>
                                                    </div>
                                                    <small class="text-muted d-block mt-1">
                                                        @withdrawal.RequestDate.ToString("MMM dd, hh:mm tt")
                                                    </small>
                                                </div>
                                                <div class="ms-2">
                                                    <span class="badge @GetWithdrawalStatusBadge(withdrawal.Status)">
                                                        @withdrawal.Status
                                                    </span>
                                                    @if (withdrawal.Status == WithdrawalStatus.Pending)
                                                    {
                                                        <button class="btn btn-sm btn-outline-success mt-1"
                                                                @onclick:stopPropagation="true"
                                                                @onclick="() => QuickApproveWithdrawal(withdrawal)">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-3">
                                    <i class="fas fa-money-bill-wave fa-2x text-muted mb-2"></i>
                                    <p class="text-muted small mb-0">No withdrawal requests</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Popular Content Card -->
                    <div class="card shadow mb-3">
                        <div class="card-header py-2 d-flex justify-content-between align-items-center bg-light">
                            <h6 class="m-0 fw-bold text-success">
                                <i class="fas fa-chart-line me-2"></i>Top Content
                            </h6>
                            <span class="badge bg-success">@popularContent?.Count(x => x.EnrollmentCount > 0) active</span>
                        </div>
                        <div class="card-body p-3">
                            @if (popularContent != null && popularContent.Any())
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var content in popularContent
                                                            .Where(c => c.EnrollmentCount > 0)
                                                            .OrderByDescending(c => c.EnrollmentCount)
                                                            .Take(5))
                                    {
                                        <div class="list-group-item px-0 py-2 border-0 border-bottom" @onclick="() => ViewContent(content)">
                                            <div class="d-flex align-items-start">
                                                <div class="flex-grow-1">
                                                    <div class="d-flex align-items-center mb-1">
                                                        <span class="badge @GetContentTypeBadge(content.ContentType) me-2">
                                                            @content.ContentType
                                                        </span>
                                                        <small class="text-muted">@content.EnrollmentCount enrollments</small>
                                                    </div>
                                                    <div class="fw-bold small">@content.Title</div>
                                                    <div class="d-flex align-items-center mt-1">
                                                        <span class="badge bg-info me-2">$@content.Revenue.ToString("N0")</span>
                                                        <div class="star-rating-small">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i class="fas fa-star @(i <= Math.Round(content.AverageRating) ? "text-warning" : "text-muted")" style="font-size: 10px;"></i>
                                                            }
                                                            <small class="ms-1 text-muted">(@content.AverageRating.ToString("0.0"))</small>
                                                        </div>
                                                    </div>
                                                </div>
                                                <i class="fas fa-chevron-right text-muted"></i>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <i class="fas fa-chart-line fa-2x text-muted mb-2"></i>
                                    <p class="text-muted small mb-0">No content available</p>
                                    <a href="/admin/specializations/create" class="btn btn-primary btn-sm mt-2">
                                        <i class="fas fa-plus me-1"></i> Create Content
                                    </a>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Recent Payments Card -->
                    <div class="card shadow mb-3">
                        <div class="card-header py-2 d-flex justify-content-between align-items-center bg-light">
                            <h6 class="m-0 fw-bold text-warning">
                                <i class="fas fa-credit-card me-2"></i>Recent Payments
                            </h6>
                            <span class="badge bg-warning">@recentPayments.Count</span>
                        </div>
                        <div class="card-body p-3">
                            @if (recentPayments.Any())
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var payment in recentPayments.Take(3))
                                    {
                                        <a href="/admin/payments/review/@payment.Id" class="list-group-item px-0 py-2 border-0 border-bottom">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <div class="fw-bold small">@payment.InvoiceNumber</div>
                                                    <small class="text-muted">@payment.User?.FirstName @payment.User?.LastName</small>
                                                </div>
                                                <div class="text-end">
                                                    <div class="fw-bold text-success">$@payment.Amount.ToString("N2")</div>
                                                    <span class="badge @GetPaymentStatusBadge(payment.Status) small">
                                                        @payment.Status
                                                    </span>
                                                </div>
                                            </div>
                                            <small class="text-muted d-block mt-1">
                                                <i class="fas fa-clock me-1"></i>@payment.CreatedAt.ToString("MMM dd, hh:mm tt")
                                            </small>
                                        </a>
                                    }
                                </div>
                                <a href="/admin/payments" class="btn btn-sm btn-outline-primary w-100 mt-2">
                                    View All Payments
                                </a>
                            }
                            else
                            {
                                <div class="text-center py-3">
                                    <i class="fas fa-credit-card fa-2x text-muted mb-2"></i>
                                    <p class="text-muted small mb-0">No recent payments</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Pending Actions Card -->
                    <div class="card shadow mb-4">
                        <div class="card-header py-2 bg-light">
                            <h6 class="m-0 fw-bold text-danger">
                                <i class="fas fa-tasks me-2"></i>Pending Actions
                            </h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-2">
                                @if (pendingPayments > 0)
                                {
                                    <div class="col-6">
                                        <a href="/admin/payments?status=0" class="btn btn-outline-warning w-100">
                                            <i class="fas fa-credit-card me-2"></i>
                                            <span>Payments</span>
                                            <span class="badge bg-warning ms-2">@pendingPayments</span>
                                        </a>
                                    </div>
                                }
                                @if (pendingWithdrawalCount > 0)
                                {
                                    <div class="col-6">
                                        <a href="/admin/withdrawals?status=0" class="btn btn-outline-danger w-100">
                                            <i class="fas fa-money-bill-wave me-2"></i>
                                            <span>Withdrawals</span>
                                            <span class="badge bg-danger ms-2">@pendingWithdrawalCount</span>
                                        </a>
                                    </div>
                                }
                                @if (pendingPayments == 0 && pendingWithdrawalCount == 0)
                                {
                                    <div class="col-12 text-center py-2">
                                        <i class="fas fa-check-circle text-success me-2"></i>
                                        <span class="text-success">All caught up!</span>
                                    </div>
                                }
                            </div>

                            <hr class="my-2" />

                            <div class="row g-2">
                                <div class="col-6">
                                    <a href="/admin/users" class="btn btn-sm btn-outline-primary w-100">
                                        <i class="fas fa-users me-1"></i> Users
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a href="/admin/announcements" class="btn btn-sm btn-outline-success w-100">
                                        <i class="fas fa-bullhorn me-1"></i> Announce
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a href="/admin/withdrawals" class="btn btn-sm btn-outline-warning w-100">
                                        <i class="fas fa-money-bill-wave me-1"></i> Withdrawals
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a href="/admin/enrollments" class="btn btn-sm btn-outline-info w-100">
                                        <i class="fas fa-graduation-cap me-1"></i> Enrollments
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Navigation for Mobile -->
                    <div class="mobile-bottom-nav d-block d-md-none">
                        <div class="d-flex justify-content-around align-items-center h-100">
                            <a href="/admin/dashboard" class="nav-item active">
                                <i class="fas fa-home"></i>
                                <span>Home</span>
                            </a>
                            <a href="/admin/users" class="nav-item">
                                <i class="fas fa-users"></i>
                                <span>Users</span>
                            </a>
                            <a href="/admin/withdrawals" class="nav-item">
                                <i class="fas fa-money-bill-wave"></i>
                                <span>Withdrawals</span>
                            </a>
                            <a href="/admin/announcements" class="nav-item">
                                <i class="fas fa-bullhorn"></i>
                                <span>Announce</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Desktop Main Dashboard -->
                <div class="d-none d-md-block">
                    <div class="row">
                        <!-- Left Column - Withdrawals & Content -->
                        <div class="col-lg-8">
                            <!-- Withdrawals Overview -->
                            <div class="card shadow mb-4">
                                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                                    <h6 class="m-0 fw-bold text-primary">
                                        <i class="fas fa-money-bill-wave me-2"></i>Withdrawals Overview
                                    </h6>
                                    <a href="/admin/withdrawals" class="btn btn-sm btn-primary">
                                        <i class="fas fa-external-link-alt me-1"></i> Manage
                                    </a>
                                </div>
                                <div class="card-body">
                                    <!-- Withdrawal Stats -->
                                    <div class="row mb-4">
                                        <div class="col-md-4 mb-3">
                                            <div class="card border-warning h-100">
                                                <div class="card-body text-center">
                                                    <div class="text-warning fw-bold display-5">@pendingWithdrawalCount</div>
                                                    <div class="text-warning fw-bold">Pending</div>
                                                    <small class="text-muted d-block mt-2">Awaiting review</small>
                                                </div>
                                                <div class="card-footer bg-transparent border-top-0">
                                                    <a href="/admin/withdrawals?status=0" class="btn btn-sm btn-warning w-100">
                                                        <i class="fas fa-clock me-1"></i> Review
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <div class="card border-success h-100">
                                                <div class="card-body text-center">
                                                    <div class="text-success fw-bold display-5">@approvedWithdrawalCount</div>
                                                    <div class="text-success fw-bold">Approved</div>
                                                    <small class="text-muted d-block mt-2">This month</small>
                                                </div>
                                                <div class="card-footer bg-transparent border-top-0">
                                                    <a href="/admin/withdrawals?status=1" class="btn btn-sm btn-success w-100">
                                                        <i class="fas fa-check me-1"></i> View All
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <div class="card border-danger h-100">
                                                <div class="card-body text-center">
                                                    <div class="text-danger fw-bold display-5">@rejectedWithdrawalCount</div>
                                                    <div class="text-danger fw-bold">Rejected</div>
                                                    <small class="text-muted d-block mt-2">Total rejected</small>
                                                </div>
                                                <div class="card-footer bg-transparent border-top-0">
                                                    <a href="/admin/withdrawals?status=2" class="btn btn-sm btn-danger w-100">
                                                        <i class="fas fa-times me-1"></i> View All
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Recent Withdrawal Requests -->
                                    <h6 class="fw-bold mb-3">Recent Withdrawal Requests</h6>
                                    @if (recentWithdrawals != null && recentWithdrawals.Any())
                                    {
