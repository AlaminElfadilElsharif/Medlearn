@code {
    // ... (keep all your existing code in the @code block exactly as is)
    private bool isAuthenticated = false;
    private bool isLoading = true;
    private UserDto? currentUser = null;
    private DateTime lastRefreshTime = DateTime.Now;

    // Dashboard statistics
    private int totalUsers = 0;
    private int doctorCount = 0;
    private int studentCount = 0;
    private int adminCount = 0;
    private decimal totalRevenue = 0;
    private decimal doctorBalance = 0;
    private int totalEnrollments = 0;
    private int completedEnrollments = 0;
    private int activeEnrollments = 0;
    private int pendingPayments = 0;
    private int approvedPayments = 0;
    private int rejectedPayments = 0;
    private int pendingWithdrawalCount = 0;
    private int approvedWithdrawalCount = 0;
    private int rejectedWithdrawalCount = 0;

    // Lists
    private List<PaymentRequestDto> recentPayments = new();
    private List<WithdrawalRequestDto> recentWithdrawals = new();
    private List<PopularContentDto> popularContent = new();

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
        if (isAuthenticated && currentUser?.UserType == UserType.Admin)
        {
            await LoadDashboardData();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();
            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();
                Console.WriteLine($"User authenticated: {currentUser?.FirstName} {currentUser?.LastName}, Type: {currentUser?.UserType}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Authentication error: {ex.Message}");
            isAuthenticated = false;
        }
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            Console.WriteLine("Loading dashboard data...");

            // Load admin dashboard stats
            var dashboardData = await DashboardService.GetAdminDashboardStatsAsync();
            Console.WriteLine($"Dashboard data received: {dashboardData != null}");

            if (dashboardData != null)
            {
                await ParseDashboardData(dashboardData);
            }

            // Load recent payments
            var payments = await PaymentService.GetPaymentRequestsAsync(pageSize: 10);
            if (payments != null)
            {
                recentPayments = payments
                    .OrderByDescending(p => p.CreatedAt)
                    .Take(5)
                    .ToList();
                Console.WriteLine($"Loaded {recentPayments.Count} recent payments");
            }

            // Load withdrawal requests
            var withdrawals = await WithdrawalService.GetAdminWithdrawalsAsync(
                pageSize: 10);
            if (withdrawals != null)
            {
                recentWithdrawals = withdrawals
                    .OrderByDescending(w => w.RequestDate)
                    .Take(5)
                    .ToList();

                // Calculate withdrawal stats
                pendingWithdrawalCount = withdrawals.Count(w => w.Status == WithdrawalStatus.Pending);
                approvedWithdrawalCount = withdrawals.Count(w => w.Status == WithdrawalStatus.Approved);
                rejectedWithdrawalCount = withdrawals.Count(w => w.Status == WithdrawalStatus.Rejected);

                Console.WriteLine($"Loaded {recentWithdrawals.Count} recent withdrawals");
            }

            lastRefreshTime = DateTime.Now;
            Console.WriteLine($"Dashboard loaded successfully at {lastRefreshTime}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
            await ShowError("Failed to load dashboard data");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ParseDashboardData(object dashboardData)
    {
        try
        {
            Console.WriteLine("Parsing dashboard data...");

            // Convert to JSON string first
            var json = JsonSerializer.Serialize(dashboardData, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });

            Console.WriteLine($"Dashboard JSON: {json}");

            // Deserialize as dynamic to check structure
            var jsonDocument = JsonDocument.Parse(json);
            var root = jsonDocument.RootElement;

            // Check if it's a DashboardStatsDto
            if (root.TryGetProperty("totalUsers", out var totalUsersElement))
            {
                // It's DashboardStatsDto
                var statsDto = JsonSerializer.Deserialize<DashboardStatsDto>(json, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (statsDto != null)
                {
                    ApplyStatsDto(statsDto);
                }
            }
            else
            {
                // It's the old DashboardStats from your controller
                // Try to parse the stats from the JSON directly
                ParseStatsFromJson(jsonDocument);
            }

            Console.WriteLine($"Parsed: TotalUsers={totalUsers}, Doctors={doctorCount}, Students={studentCount}, Admins={adminCount}");
            Console.WriteLine($"Popular content count: {popularContent?.Count ?? 0}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing dashboard data: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");

            // Set default values based on your database
            SetDefaultValues();
        }
    }

    private void ApplyStatsDto(DashboardStatsDto statsDto)
    {
        totalUsers = statsDto.TotalUsers;
        studentCount = statsDto.TotalStudents;
        doctorCount = statsDto.TotalDoctors;
        adminCount = statsDto.TotalAdmins;
        totalRevenue = statsDto.TotalRevenue;
        doctorBalance = statsDto.DoctorsBalance;
        totalEnrollments = statsDto.TotalEnrollments;
        completedEnrollments = statsDto.CompletedEnrollments;
        activeEnrollments = statsDto.ActiveEnrollments;
        pendingPayments = statsDto.PendingPayments;
        approvedPayments = statsDto.ApprovedPayments;
        rejectedPayments = statsDto.RejectedPayments;
        popularContent = statsDto.PopularContent ?? new();
    }

    private void ParseStatsFromJson(JsonDocument jsonDocument)
    {
        var root = jsonDocument.RootElement;

        totalUsers = GetJsonProperty<int>(root, "TotalUsers");
        studentCount = GetJsonProperty<int>(root, "TotalStudents");
        doctorCount = GetJsonProperty<int>(root, "TotalDoctors");
        adminCount = GetJsonProperty<int>(root, "TotalAdmins");
        totalRevenue = GetJsonProperty<decimal>(root, "TotalRevenue");
        doctorBalance = GetJsonProperty<decimal>(root, "DoctorsBalance");
        totalEnrollments = GetJsonProperty<int>(root, "TotalEnrollments");
        completedEnrollments = GetJsonProperty<int>(root, "CompletedEnrollments");
        activeEnrollments = GetJsonProperty<int>(root, "ActiveEnrollments");
        pendingPayments = GetJsonProperty<int>(root, "PendingPayments");
        approvedPayments = GetJsonProperty<int>(root, "ApprovedPayments");
        rejectedPayments = GetJsonProperty<int>(root, "RejectedPayments");

        // Parse popular content
        if (root.TryGetProperty("PopularContent", out var popularContentElement) ||
            root.TryGetProperty("popularContent", out popularContentElement))
        {
            try
            {
                if (popularContentElement.ValueKind == JsonValueKind.Array)
                {
                    popularContent = JsonSerializer.Deserialize<List<PopularContentDto>>(
                        popularContentElement.GetRawText(),
                        new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error parsing popular content: {ex.Message}");
                popularContent = new();
            }
        }
    }

    private T GetJsonProperty<T>(JsonElement element, string propertyName)
    {
        if (element.TryGetProperty(propertyName, out var value))
        {
            try
            {
                return JsonSerializer.Deserialize<T>(value.GetRawText()) ?? default(T)!;
            }
            catch
            {
                return default(T)!;
            }
        }

        // Try with lowerCamelCase
        var lowerCamelCase = char.ToLowerInvariant(propertyName[0]) + propertyName.Substring(1);
        if (element.TryGetProperty(lowerCamelCase, out var lowerValue))
        {
            try
            {
                return JsonSerializer.Deserialize<T>(lowerValue.GetRawText()) ?? default(T)!;
            }
            catch
            {
                return default(T)!;
            }
        }

        return default(T)!;
    }

