@code {
    [Parameter] public UserDto? User { get; set; }
    [Parameter] public List<EnrollmentDto> RecentEnrollments { get; set; } = new();
    [Parameter] public List<EnrollmentDto> CompletedEnrollments { get; set; } = new();
    [Parameter] public List<SpecializationDto> RecommendedSpecializations { get; set; } = new();
    [Parameter] public int InProgressCount { get; set; }
    [Parameter] public int CompletedCount { get; set; }
    [Parameter] public decimal AverageProgress { get; set; }
    [Parameter] public int PendingPayments { get; set; }

    [Parameter] public EventCallback<EnrollmentDto> OnContinueLearning { get; set; }
    [Parameter] public EventCallback OnBrowseAll { get; set; }
    [Parameter] public EventCallback<int> OnViewSpecialization { get; set; }
    [Parameter] public EventCallback<EnrollmentDto> OnWriteReview { get; set; }
    [Parameter] public EventCallback OnViewPayments { get; set; }

    // Catalog data
    private List<SpecializationDto> allSpecializations = new();
    private List<CourseDto> allCourses = new();
    private List<LectureDto> allLectures = new();

    // Displayed data (filtered)
    private List<SpecializationDto> displayedSpecializations = new();
    private List<CourseDto> displayedCourses = new();
    private List<LectureDto> displayedLectures = new();

    // Filter properties
    private string searchQuery = "";
    private string activeContentType = "all";
    private string sortBy = "relevance";
    private string priceFilter = "all";
    private string viewMode = "grid";

    // Mobile UI state
    private bool showMobileSort = false;
    private bool showMobilePriceFilter = false;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 12;
    private bool hasMoreItems = false;
    private bool isLoading = true;

    // Stats
    private int totalItems => allSpecializations.Count + allCourses.Count + allLectures.Count;
    private int displayedItemsCount => displayedSpecializations.Count + displayedCourses.Count + displayedLectures.Count;

    private Timer? debounceTimer;

    // Mobile toggle methods
    private void ToggleMobileSort()
    {
        showMobileSort = !showMobileSort;
        if (showMobileSort) showMobilePriceFilter = false;
    }

    private void ToggleMobilePriceFilter()
    {
        showMobilePriceFilter = !showMobilePriceFilter;
        if (showMobilePriceFilter) showMobileSort = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogData();
    }

    private async Task LoadCatalogData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Load all specializations (active only)
            var specializations = await SpecializationService.GetSpecializationsAsync(
                search: null,
                featured: null,
                doctorId: null,
                minPrice: null,
                maxPrice: null,
                page: 1,
                pageSize: 50
            );

            if (specializations != null)
            {
                allSpecializations = specializations.ToList();

                // Load courses for each specialization
                foreach (var spec in allSpecializations.Take(5)) // Limit to avoid too many calls
                {
                    var courses = await CourseService.GetCoursesBySpecializationAsync(spec.Id);
                    if (courses != null)
                    {
                        allCourses.AddRange(courses.Where(c => c.IsActive));

                        // Load lectures for each course
                        foreach (var course in courses.Take(3))
                        {
                            var lectures = await LectureService.GetLecturesByCourseAsync(course.Id);
                            if (lectures != null)
                            {
                                allLectures.AddRange(lectures.Where(l => l.IsActive));
                            }
                        }
                    }
                }
            }

            // Apply initial filters
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading catalog: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        // Close mobile panels when applying filters
        showMobileSort = false;
        showMobilePriceFilter = false;

        // Filter specializations
        var filteredSpecs = allSpecializations.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var query = searchQuery.ToLower();
            filteredSpecs = filteredSpecs.Where(s =>
                (s.Title?.ToLower().Contains(query) ?? false) ||
                (s.Description?.ToLower().Contains(query) ?? false) ||
                (s.Doctor?.FirstName?.ToLower().Contains(query) ?? false) ||
                (s.Doctor?.LastName?.ToLower().Contains(query) ?? false)
            );
        }

        // Apply price filter
        filteredSpecs = ApplyPriceFilter(filteredSpecs, priceFilter);

        // Apply sorting and assign
        filteredSpecs = ApplySorting(filteredSpecs, sortBy);
        displayedSpecializations = filteredSpecs.ToList();

        // Filter courses
        var filteredCourses = allCourses.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var query = searchQuery.ToLower();
            filteredCourses = filteredCourses.Where(c =>
                (c.Title?.ToLower().Contains(query) ?? false) ||
                (c.Description?.ToLower().Contains(query) ?? false)
            );
        }

        // Apply price filter and sorting
        filteredCourses = ApplyPriceFilter(filteredCourses, priceFilter);
        filteredCourses = ApplySorting(filteredCourses, sortBy);
        displayedCourses = filteredCourses.ToList();

        // Filter lectures
        var filteredLectures = allLectures.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var query = searchQuery.ToLower();
            filteredLectures = filteredLectures.Where(l =>
                (l.Title?.ToLower().Contains(query) ?? false) ||
                (l.Description?.ToLower().Contains(query) ?? false)
            );
        }

        // Apply price filter and sorting
        filteredLectures = ApplyPriceFilter(filteredLectures, priceFilter);
        filteredLectures = ApplySorting(filteredLectures, sortBy);
        displayedLectures = filteredLectures.ToList();

        // Update pagination
        hasMoreItems = displayedItemsCount > currentPage * pageSize;
    }

    private IEnumerable<T> ApplyPriceFilter<T>(IEnumerable<T> items, string filter) where T : class
    {
        if (filter == "all") return items;

        return items.Where(item =>
        {
            decimal price = GetPrice(item);
            return filter switch
            {
                "free" => price == 0,
                "paid" => price > 0,
                "under50" => price > 0 && price < 50,
                "under100" => price > 0 && price < 100,
                _ => true
            };
        });
    }

    private IEnumerable<T> ApplySorting<T>(IEnumerable<T> items, string sort) where T : class
    {
        var itemList = items.ToList();

        if (sort == "newest")
        {
            return itemList.OrderByDescending(item => GetCreatedAt(item)).ToList();
        }
        else if (sort == "price_low")
        {
            return itemList.OrderBy(item => GetPrice(item)).ToList();
        }
        else if (sort == "price_high")
        {
            return itemList.OrderByDescending(item => GetPrice(item)).ToList();
        }
        else if (sort == "popular")
        {
            return itemList.OrderByDescending(item => GetEnrollments(item)).ToList();
        }
        else if (sort == "rating")
        {
            return itemList.OrderByDescending(item => GetRating(item)).ToList();
        }

        // Default: relevance (keep original order)
        return itemList;
    }

    private DateTime GetCreatedAt(object item)
    {
        return item switch
        {
            SpecializationDto s => s.CreatedAt,
            CourseDto c => c.CreatedAt,
            LectureDto l => l.CreatedAt,
            _ => DateTime.MinValue
        };
    }

    private decimal GetPrice(object item)
    {
        return item switch
        {
            SpecializationDto s => s.Price,
            CourseDto c => c.Price,
            LectureDto l => l.Price,
            _ => 0
        };
    }

    private int GetEnrollments(object item)
    {
        return item switch
        {
            SpecializationDto s => s.TotalEnrollments,
            CourseDto c => c.TotalEnrollments,
            LectureDto l => l.TotalEnrollments,
            _ => 0
        };
    }

    private decimal GetRating(object item)
    {
        return item switch
        {
            SpecializationDto s => s.AverageRating,
            CourseDto c => c.AverageRating,
            LectureDto l => l.AverageRating,
            _ => 0
        };
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ApplySearch();
        }
        else if (e.Key == "Escape")
        {
            ClearSearch();
        }
        else
        {
            // Debounce search
            debounceTimer?.Dispose();
            debounceTimer = new Timer(async _ =>
            {
                await InvokeAsync(() =>
                {
                    if (searchQuery.Length >= 2 || searchQuery.Length == 0)
                    {
                        ApplySearch();
                    }
                });
            }, null, 300, Timeout.Infinite);
        }
    }

    private void ApplySearch()
    {
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void ClearSearch()
    {
        searchQuery = "";
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void SetContentType(string type)
    {
        activeContentType = type;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void SetSortBy(string sort)
    {
        sortBy = sort;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void SetPriceFilter(string filter)
    {
        priceFilter = filter;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void SetViewMode(string mode)
    {
        viewMode = mode;
        StateHasChanged();
    }

    private void ResetFilters()
    {
        searchQuery = "";
        activeContentType = "all";
        sortBy = "relevance";
        priceFilter = "all";
        currentPage = 1;
        showMobileSort = false;
        showMobilePriceFilter = false;
        ApplyFilters();
        StateHasChanged();
    }

    private void LoadMore()
    {
        currentPage++;
        StateHasChanged();
    }

    private string GetInitials(string? firstName, string? lastName)
    {
        if (string.IsNullOrEmpty(firstName) && string.IsNullOrEmpty(lastName))
            return "?";

        var initials = "";
        if (!string.IsNullOrEmpty(firstName))
            initials += firstName[0];
        if (!string.IsNullOrEmpty(lastName))
            initials += lastName[0];

        return initials.ToUpper();
    }

    private string GetEnrollmentTitle(EnrollmentDto enrollment)
    {
        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => enrollment.Specialization?.Title ?? "Specialization",
            EnrollmentType.Course => enrollment.Course?.Title ?? "Course",
            EnrollmentType.Lecture => enrollment.Lecture?.Title ?? "Lecture",
            _ => "Unknown"
        };
    }

    private string GetTruncatedText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "";
        if (text.Length <= maxLength) return text;
        return text.Substring(0, maxLength).TrimEnd() + "...";
    }

    private void NavigateToSpecialization(int id)
    {
        Navigation.NavigateTo($"/specializations/{id}");
    }

    private void NavigateToCourse(int id)
    {
        Navigation.NavigateTo($"/courses/{id}");
    }

    private void NavigateToLecture(int id)
    {
        Navigation.NavigateTo($"/lectures/{id}");
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
}
