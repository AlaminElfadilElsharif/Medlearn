

<div class="doctor-home-view">
    <!-- Welcome Header -->
    <div class="bg-primary text-white p-4 mb-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col">
                    <h2>Welcome, Dr. @User?.FirstName @User?.LastName</h2>
                    <p class="mb-0">@User?.Profile?.Title at @User?.Profile?.Institution</p>
                </div>
                <div class="col-auto">
                    <button class="btn btn-light" @onclick="OnCreateContent">
                        <i class="fas fa-plus me-2"></i>Create Content
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- Stats Cards -->
        <div class="row g-4 mb-4">
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted">Available Balance</h6>
                        <h3 class="text-success">$@AvailableBalance.ToString("N2")</h3>
                        <small class="text-muted">Ready to withdraw</small>
                        @if (PendingWithdrawals > 0)
                        {
                            <span class="badge bg-warning ms-2">@PendingWithdrawals pending</span>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted">Total Students</h6>
                        <h3>@TotalStudents</h3>
                        <small>Across all content</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted">Average Rating</h6>
                        <div class="d-flex align-items-center">
                            <h3 class="mb-0 me-2">@AverageRating.ToString("0.0")</h3>
                            <div>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fas fa-star @(i <= Math.Round(AverageRating) ? "text-warning" : "text-muted")"></i>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted">Monthly Revenue</h6>
                        <h3 class="text-success">$@MonthlyRevenue.ToString("N2")</h3>
                        <small>This month</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="btn-group w-100" role="group">
                    <button class="btn btn-outline-primary" @onclick='() => Navigation.NavigateTo("/createspecialization")'>
                        <i class="fas fa-book me-2"></i>New Specialization
                    </button>
                    <button class="btn btn-outline-success" @onclick='() => Navigation.NavigateTo("/createcourse")'>
                        <i class="fas fa-graduation-cap me-2"></i>New Course
                    </button>
                    <button class="btn btn-outline-warning" @onclick="OnWithdraw">
                        <i class="fas fa-money-bill-wave me-2"></i>Withdraw
                    </button>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Recent Enrollments -->
            <div class="col-lg-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Enrollments</h5>
                        <button class="btn btn-sm btn-outline-primary" @onclick='() => Navigation.NavigateTo("/doctor/enrollments")'>
                            View All
                        </button>
                    </div>
                    <div class="card-body p-0">
                        @if (RecentEnrollments.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var enrollment in RecentEnrollments.Take(5))
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@enrollment.User?.FirstName @enrollment.User?.LastName</strong><br />
                                                <small class="text-muted">@GetEnrollmentTitle(enrollment)</small>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge bg-info">@enrollment.EnrollmentType</span><br />
                                                <small class="text-muted">@enrollment.EnrollmentDate.ToString("MMM dd")</small>
                                            </div>
                                        </div>
                                        <div class="progress mt-2" style="height: 4px;">
                                            <div class="progress-bar bg-success" style="width: @enrollment.ProgressPercentage%"></div>
                                        </div>
                                        <small class="text-muted">@enrollment.ProgressPercentage.ToString("0")% complete</small>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <p class="text-muted mb-0">No enrollments yet</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Recent Reviews -->
            <div class="col-lg-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Reviews</h5>
                        <button class="btn btn-sm btn-outline-primary" @onclick="OnViewReviews">
                            View All
                        </button>
                    </div>
                    <div class="card-body p-0">
                        @if (RecentReviews.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var review in RecentReviews.Take(3))
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="me-2">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="fas fa-star @(i <= review.Rating ? "text-warning" : "text-muted")"></i>
                                                }
                                            </div>
                                            <small class="text-muted">@review.ReviewDate.ToString("MMM dd")</small>
                                        </div>
                                        <p class="mb-1">@review.Comment</p>
                                        <small class="text-muted">
                                            - @review.User?.FirstName @review.User?.LastName
                                            on @GetReviewContentTitle(review)
                                        </small>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <p class="text-muted mb-0">No reviews yet</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- My Content -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">My Content</h5>
                        <button class="btn btn-sm btn-outline-primary" @onclick="OnViewAllContent">
                            Manage All
                        </button>
                    </div>
                    <div class="card-body">
                        <ul class="nav nav-tabs mb-3" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#specializations" type="button">
                                    Specializations (@MySpecializations.Count)
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#courses" type="button">
                                    Courses (@MyCourses.Count)
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#lectures" type="button">
                                    Lectures (@MyLectures.Count)
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <!-- Specializations Tab -->
                            <div class="tab-pane fade show active" id="specializations">
                                @if (MySpecializations.Any())
                                {
                                    <div class="row g-3">
                                        @foreach (var spec in MySpecializations.Take(3))
                                        {
                                            <div class="col-md-4">
                                                <div class="card h-100">
                                                    <div class="card-body">
                                                        <h6>@spec.Title</h6>
                                                        <small class="text-muted d-block">@spec.Courses.Count courses</small>
                                                        <small class="text-muted d-block">@spec.TotalEnrollments enrollments</small>
                                                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="() => OnViewSpecialization.InvokeAsync(spec.Id)">
                                                            View
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted text-center py-3">No specializations created yet</p>
                                }
                            </div>

                            <!-- Courses Tab -->
                            <div class="tab-pane fade" id="courses">
                                @if (MyCourses.Any())
                                {
                                    <div class="row g-3">
                                        @foreach (var course in MyCourses.Take(3))
                                        {
                                            <div class="col-md-4">
                                                <div class="card h-100">
                                                    <div class="card-body">
                                                        <h6>@course.Title</h6>
                                                        <small class="text-muted d-block">@course.Lectures.Count lectures</small>
                                                        <small class="text-muted d-block">@course.TotalEnrollments enrollments</small>
                                                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="() => OnViewCourse.InvokeAsync(course.Id)">
                                                            View
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted text-center py-3">No courses created yet</p>
                                }
                            </div>

                            <!-- Lectures Tab -->
                            <div class="tab-pane fade" id="lectures">
                                @if (MyLectures.Any())
                                {
                                    <div class="row g-3">
                                        @foreach (var lecture in MyLectures.Take(3))
                                        {
                                            <div class="col-md-4">
                                                <div class="card h-100">
                                                    <div class="card-body">
                                                        <h6>@lecture.Title</h6>
                                                        <small class="text-muted d-block">@lecture.Materials.Count materials</small>
                                                        <small class="text-muted d-block">@lecture.TotalEnrollments enrollments</small>
                                                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="() => OnViewLecture.InvokeAsync(lecture.Id)">
                                                            View
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted text-center py-3">No lectures created yet</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public UserDto? User { get; set; }
    [Parameter] public List<EnrollmentDto> RecentEnrollments { get; set; } = new();
    [Parameter] public List<ReviewDto> RecentReviews { get; set; } = new();
    [Parameter] public List<SpecializationDto> MySpecializations { get; set; } = new();
    [Parameter] public List<CourseDto> MyCourses { get; set; } = new();
    [Parameter] public List<LectureDto> MyLectures { get; set; } = new();
    [Parameter] public decimal MonthlyRevenue { get; set; }
    [Parameter] public int TotalStudents { get; set; }
    [Parameter] public decimal AverageRating { get; set; }
    [Parameter] public decimal AvailableBalance { get; set; }
    [Parameter] public int PendingWithdrawals { get; set; }

    [Parameter] public EventCallback OnCreateContent { get; set; }
    [Parameter] public EventCallback OnViewAllContent { get; set; }
    [Parameter] public EventCallback OnViewReviews { get; set; }
    [Parameter] public EventCallback OnWithdraw { get; set; }
    [Parameter] public EventCallback<int> OnViewStudent { get; set; }
    [Parameter] public EventCallback<int> OnViewSpecialization { get; set; }
    [Parameter] public EventCallback<int> OnViewCourse { get; set; }
    [Parameter] public EventCallback<int> OnViewLecture { get; set; }


    private string GetEnrollmentTitle(EnrollmentDto enrollment)
    {
        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => enrollment.Specialization?.Title ?? "Specialization",
            EnrollmentType.Course => enrollment.Course?.Title ?? "Course",
            EnrollmentType.Lecture => enrollment.Lecture?.Title ?? "Lecture",
            _ => "Unknown"
        };
    }

    private string GetReviewContentTitle(ReviewDto review)
    {
        return review.ReviewType switch
        {
            EnrollmentType.Lecture => review.Lecture?.Title ?? "Lecture",
            EnrollmentType.Course => review.Course?.Title ?? "Course",
            EnrollmentType.Specialization => review.Specialization?.Title ?? "Specialization",
            _ => "Content"
        };
    }
}
