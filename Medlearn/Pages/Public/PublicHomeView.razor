
<div class="public-home-view">
    <!-- Hero Section -->
    <section class="bg-light py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <h1 class="display-4 fw-bold mb-4">
                        Learn from the <span class="text-primary">Best Doctors</span> in Medicine
                    </h1>
                    <p class="lead mb-4 text-muted">
                        Access premium medical education, specialized courses, and interactive lectures
                        from top healthcare professionals worldwide.
                    </p>
                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <button @onclick="OnRegister" class="btn btn-primary btn-lg px-4">
                            <i class="fas fa-user-plus me-2"></i> Join Free
                        </button>
                        <button @onclick="OnLogin" class="btn btn-outline-primary btn-lg px-4">
                            <i class="fas fa-sign-in-alt me-2"></i> Login
                        </button>
                    </div>
                    <div class="mt-4">
                        <div class="d-flex align-items-center">
                            <div class="d-flex me-3">
                                @for (int i = 0; i < Math.Min(5, TotalUsers); i++)
                                {
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                         style="width: 40px; height: 40px; border: 3px solid white; margin-left: -10px;">
                                        <i class="fas fa-user-md"></i>
                                    </div>
                                }
                                @if (TotalUsers > 5)
                                {
                                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                                         style="width: 40px; height: 40px; border: 3px solid white; margin-left: -10px;">
                                        +@(TotalUsers - 5)
                                    </div>
                                }
                            </div>
                            <div>
                                <small>Join <strong class="text-primary">@(TotalUsers.ToString("N0"))+</strong> medical professionals</small>
                                <div class="d-inline-flex align-items-center ms-2">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <i class="fas fa-star @(i < Math.Floor(OverallRating) ? "text-warning" : "text-muted")"></i>
                                    }
                                    <span class="ms-2">@OverallRating.ToString("0.0")/5.0</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="position-relative">
                        <div class="rounded-3 overflow-hidden shadow-lg">
                            <img src="/images/hero-medical-education.jpg"
                                 class="img-fluid"
                                 alt="Medical education"
                                 onerror="this.src='https://images.unsplash.com/photo-1551601651-2a8555f1a136?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80';" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="py-5 bg-dark text-white">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-3 col-6 mb-3 mb-md-0">
                    <h3 class="fw-bold">@TotalCourses+</h3>
                    <p>Medical Courses</p>
                </div>
                <div class="col-md-3 col-6 mb-3 mb-md-0">
                    <h3 class="fw-bold">@TotalUsers+</h3>
                    <p>Medical Professionals</p>
                </div>
                <div class="col-md-3 col-6 mb-3 mb-md-0">
                    <h3 class="fw-bold">@TotalInstructors+</h3>
                    <p>Expert Instructors</p>
                </div>
                <div class="col-md-3 col-6 mb-3 mb-md-0">
                    <h3 class="fw-bold">@((int)(OverallRating * 20))%</h3>
                    <p>Satisfaction Rate</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Specializations -->
    <section class="py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold">Featured Specializations</h2>
                <button @onclick="OnBrowseAll" class="btn btn-outline-primary">
                    View All <i class="fas fa-arrow-right ms-2"></i>
                </button>
            </div>

            @if (FeaturedSpecializations.Any())
            {
                <div class="row g-4">
                    @foreach (var spec in FeaturedSpecializations.Take(6))
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm hover-card">
                                <div class="position-relative">
                                    @if (!string.IsNullOrEmpty(spec.ThumbnailUrl))
                                    {
                                        <img src="@spec.ThumbnailUrl"
                                             class="card-img-top"
                                             style="height: 180px; object-fit: cover;"
                                             alt="@spec.Title" />
                                    }
                                    else
                                    {
                                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                             style="height: 180px;">
                                            <i class="fas fa-book-medical fa-4x text-muted"></i>
                                        </div>
                                    }
                                    @if (spec.IsFeatured)
                                    {
                                        <span class="position-absolute top-0 start-0 m-3 badge bg-warning">
                                            <i class="fas fa-star me-1"></i> Featured
                                        </span>
                                    }
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">@spec.Title</h5>
                                    <p class="card-text small text-muted">
                                        @(spec.Doctor?.FirstName ?? "Dr.") @(spec.Doctor?.LastName ?? "Expert")
                                    </p>
                                    <p class="card-text small text-muted">@GetTruncated(spec.Description, 80)</p>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-primary fs-6">$@spec.Price.ToString("N2")</span>
                                        @if (spec.AverageRating > 0)
                                        {
                                            <div>
                                                <i class="fas fa-star text-warning"></i>
                                                <small>@spec.AverageRating.ToString("0.0")</small>
                                            </div>
                                        }
                                    </div>
                                    <div class="d-flex justify-content-between text-muted small mb-3">
                                        <span><i class="fas fa-clock me-1"></i> @spec.EstimatedDurationHours hrs</span>
                                        <span><i class="fas fa-users me-1"></i> @spec.TotalEnrollments</span>
                                    </div>
                                    <button @onclick="() => OnViewSpecialization.InvokeAsync(spec.Id)"
                                            class="btn btn-primary w-100">
                                        View Details
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-book-medical fa-3x text-muted mb-3"></i>
                    <h5>No specializations available yet</h5>
                    <p class="text-muted">Check back soon for new courses</p>
                </div>
            }
        </div>
    </section>

    <!-- Reviews Section -->
    @if (RecentReviews.Any())
    {
        <section class="py-5 bg-light">
            <div class="container">
                <h2 class="text-center fw-bold mb-5">What Our Students Say</h2>
                <div class="row g-4">
                    @foreach (var review in RecentReviews.Take(3))
                    {
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body p-4">
                                    <div class="mb-3">
                                        @for (int i = 0; i < 5; i++)
                                        {
                                            <i class="@(i < review.Rating ? "fas" : "far") fa-star text-warning"></i>
                                        }
                                    </div>
                                    <p class="card-text fst-italic">"@GetTruncated(review.Comment, 120)"</p>
                                    <div class="d-flex align-items-center mt-3">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3"
                                             style="width: 48px; height: 48px;">
                                            @review.User?.FirstName?.Substring(0, 1)
                                        </div>
                                        <div>
                                            <h6 class="mb-0">@review.User?.FirstName @review.User?.LastName</h6>
                                            <small class="text-muted">
                                                @(review.Specialization?.Title ?? review.Course?.Title ?? "Medical Course")
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- CTA Section -->
    <section class="py-5">
        <div class="container">
            <div class="card border-0 shadow-lg cta-gradient text-white">
                <div class="card-body p-5 text-center">
                    <h2 class="fw-bold mb-3">Ready to Advance Your Medical Career?</h2>
                    <p class="mb-4">Join thousands of medical professionals already learning with us.</p>
                    <button @onclick="OnRegister" class="btn btn-light btn-lg px-5">
                        Get Started Free
                    </button>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    [Parameter] public List<SpecializationDto> FeaturedSpecializations { get; set; } = new();
    [Parameter] public List<ReviewDto> RecentReviews { get; set; } = new();
    [Parameter] public int TotalCourses { get; set; }
    [Parameter] public int TotalUsers { get; set; }
    [Parameter] public int TotalInstructors { get; set; }
    [Parameter] public decimal OverallRating { get; set; }
    
    [Parameter] public EventCallback OnBrowseAll { get; set; }
    [Parameter] public EventCallback<int> OnViewSpecialization { get; set; }
    [Parameter] public EventCallback OnLogin { get; set; }
    [Parameter] public EventCallback OnRegister { get; set; }

    private string GetTruncated(string? text, int length)
    {
        if (string.IsNullOrEmpty(text)) return "";
        if (text.Length <= length) return text;
        return text.Substring(0, length) + "...";
    }
}
