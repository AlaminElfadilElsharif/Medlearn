@code {
    private ContactFormModel contactForm = new();
    private bool isSubmitting = false;
    private bool showSuccessMessage = false;
    private bool showErrorMessage = false;
    private bool showMobileMenu = false;
    private string errorMessage = "";

    private bool isAuthenticated = false;
    private UserDto? currentUser = null;

   

    
    private class ContactFormModel
    {
        [Required(ErrorMessage = "Name is required")]
        [StringLength(100, ErrorMessage = "Name cannot exceed 100 characters")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = "";

        [Phone(ErrorMessage = "Invalid phone number")]
        public string? Phone { get; set; }

        [Required(ErrorMessage = "Subject is required")]
        public string Subject { get; set; } = "";

        [Required(ErrorMessage = "Message is required")]
        [StringLength(2000, ErrorMessage = "Message cannot exceed 2000 characters")]
        public string Message { get; set; } = "";

        public bool SubscribeNewsletter { get; set; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();
                if (currentUser != null)
                {
                    // Pre-fill form with user data
                    contactForm.Name = $"{currentUser.FirstName} {currentUser.LastName}";
                    contactForm.Email = currentUser.Email;
                    contactForm.Phone = currentUser.PhoneNumber ?? "";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking authentication: {ex.Message}");
        }
    }

    private void ToggleMobileMenu()
    {
        showMobileMenu = !showMobileMenu;
    }

    private async void OpenLiveChat()
    {
        showMobileMenu = false;
        // Implement live chat logic here
        await JS.InvokeVoidAsync("alert", "Live chat feature coming soon!");
    }

    private async void ScrollToForm()
    {
        showMobileMenu = false;
        await JS.InvokeVoidAsync("eval", @"
            const formSection = document.getElementById('contact-form-section');
            if (formSection) {
                formSection.scrollIntoView({ behavior: 'smooth' });
            }
        ");
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        showSuccessMessage = false;
        showErrorMessage = false;

        try
        {
            // Create contact message DTO
            var contactDto = new ContactMessageDto
            {
                Name = contactForm.Name,
                Email = contactForm.Email,
                Phone = contactForm.Phone,
                Subject = contactForm.Subject,
                Message = contactForm.Message,
                SubscribeNewsletter = contactForm.SubscribeNewsletter,
                IsAuthenticatedUser = isAuthenticated,
                UserId = currentUser?.Id
            };

            // Send message via ContactService
            var result = await ContactService.SendContactMessageAsync(contactDto);

            if (result)
            {
                showSuccessMessage = true;
                contactForm = new ContactFormModel();

                // Show success message and scroll to it
                await JS.InvokeVoidAsync("eval", @"
                    const successMessage = document.getElementById('contact-success-message');
                    if (successMessage) {
                        successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                    
                    // Auto-hide success message after 5 seconds
                    setTimeout(() => {
                        const msg = document.getElementById('contact-success-message');
                        if (msg) msg.style.display = 'none';
                    }, 5000);
                ");
            }
            else
            {
                showErrorMessage = true;
                errorMessage = "Failed to send message. Please try again later.";
            }
        }
        catch (Exception ex)
        {
            showErrorMessage = true;
            errorMessage = ex.Message;
            Console.WriteLine($"Error sending contact message: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", @"
                // Phone number formatting
                const phoneInput = document.querySelector('#contact-phone');
                if (phoneInput) {
                    phoneInput.addEventListener('input', function(e) {
                        let value = e.target.value.replace(/\D/g, '');
                        if (value.length > 3 && value.length <= 6) {
                            value = value.replace(/(\d{3})(\d+)/, '($1) $2');
                        } else if (value.length > 6) {
                            value = value.replace(/(\d{3})(\d{3})(\d+)/, '($1) $2-$3');
                        }
                        e.target.value = value;
                    });
                }
                
                // Close mobile menu when clicking outside
                document.addEventListener('click', function(event) {
                    const menu = document.querySelector('.mobile-action-menu');
                    const button = document.querySelector('.mobile-action-button');
                    if (menu && button && !button.contains(event.target) && !menu.contains(event.target)) {
                        menu.classList.remove('show');
                    }
                });
            ");
        }
    }
}