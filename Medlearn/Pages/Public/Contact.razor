@page "/contact"


<PageTitle>Contact Us - Medical Learning Platform</PageTitle>

<style>
    /* Contact Page Specific Styles */
    .contact-hero {
        background: linear-gradient(rgba(13, 110, 253, 0.05), rgba(25, 135, 84, 0.05));
        padding: 4rem 0;
        position: relative;
        overflow: hidden;
    }

        .contact-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%230d6efd' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        }

        .contact-hero h1 {
            background: linear-gradient(135deg, #0d6efd 0%, #198754 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .contact-image {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        transform: perspective(1000px) rotateY(5deg);
        transition: transform 0.3s ease;
    }

        .contact-image:hover {
            transform: perspective(1000px) rotateY(0deg);
        }

    .icon-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .contact-form-card {
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        border-radius: 15px;
        overflow: hidden;
    }

        .contact-form-card .form-floating > .form-control {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .contact-form-card .form-floating > .form-control:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
            }

    .contact-method {
        padding: 15px;
        border-radius: 10px;
        background: #f8f9fa;
        transition: all 0.3s ease;
    }

        .contact-method:hover {
            background: #e9ecef;
            transform: translateX(5px);
        }

    .social-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .social-icon.facebook {
            background: #3b5998;
            color: white;
        }

        .social-icon.twitter {
            background: #1da1f2;
            color: white;
        }

        .social-icon.linkedin {
            background: #0077b5;
            color: white;
        }

        .social-icon.youtube {
            background: #ff0000;
            color: white;
        }

        .social-icon.instagram {
            background: linear-gradient(45deg, #405de6, #5851db, #833ab4, #c13584, #e1306c, #fd1d1d);
            color: white;
        }

        .social-icon:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

    .faq-preview .faq-item {
        border-left: 4px solid #0d6efd;
        transition: all 0.3s ease;
    }

        .faq-preview .faq-item:hover {
            transform: translateX(5px);
            box-shadow: 5px 5px 15px rgba(0,0,0,0.1);
        }

    .map-section {
        position: relative;
    }

    .map-container {
        border-radius: 0 15px 15px 0;
        overflow: hidden;
        background: #f8f9fa;
    }

    /* Mobile Optimizations */
    @@media (max-width: 991.98px) {
        .contact-hero {
            padding: 2rem 0;
        }

        .contact-image {
            transform: none;
            margin-top: 2rem;
        }

        .map-container {
            border-radius: 0 0 15px 15px;
        }

        .contact-method {
            padding: 12px;
        }

        .icon-circle {
            width: 45px;
            height: 45px;
            font-size: 1.2rem;
        }
    }

    @@media (max-width: 767.98px) {
        .contact-hero h1 {
            font-size: 2rem;
        }

        .contact-hero .lead {
            font-size: 1rem;
        }

        .contact-form-card .card-body {
            padding: 1.25rem;
        }

        .faq-preview h2 {
            font-size: 1.75rem;
        }

        .map-section .p-4 {
            padding: 1.25rem;
        }

        .social-icon {
            width: 35px;
            height: 35px;
            font-size: 0.9rem;
        }
    }

    /* Mobile Menu Toggle */
    .mobile-contact-actions {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 1000;
        display: none;
    }

    @@media (max-width: 767.98px) {
        .mobile-contact-actions {
            display: block;
        }
    }

    .mobile-action-button {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #0d6efd;
        color: white;
        border: none;
        box-shadow: 0 4px 10px rgba(13, 110, 253, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .mobile-action-button:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 15px rgba(13, 110, 253, 0.4);
        }

    .mobile-action-menu {
        position: absolute;
        bottom: 70px;
        right: 0;
        background: white;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
        padding: 0.5rem;
        min-width: 200px;
        display: none;
    }

        .mobile-action-menu.show {
            display: block;
        }

        .mobile-action-menu a {
            display: flex;
            align-items: center;
            padding: 0.75rem 1rem;
            color: #333;
            text-decoration: none;
            border-radius: 8px;
            transition: background 0.3s ease;
        }

            .mobile-action-menu a:hover {
                background: #f8f9fa;
            }

        .mobile-action-menu i {
            width: 24px;
            margin-right: 12px;
            color: #0d6efd;
        }

    /* Mobile Quick Contact Bar */
    @@media (max-width: 767.98px) {
        .mobile-quick-contact {
            display: flex;
            position: sticky;
            top: 0;
            z-index: 1020;
            background: white;
            border-bottom: 1px solid #dee2e6;
            padding: 0.5rem;
        }
    }

    .mobile-quick-contact {
        display: none;
    }

    .quick-contact-item {
        flex: 1;
        text-align: center;
        padding: 0.5rem;
        color: #0d6efd;
        text-decoration: none;
        font-size: 0.875rem;
    }

        .quick-contact-item i {
            display: block;
            font-size: 1.25rem;
            margin-bottom: 4px;
        }

    /* Guest Badge */
    .guest-badge {
        background: #f0f9ff;
        border: 1px dashed #0d6efd;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        color: #0d6efd;
    }

    .user-badge {
        background: #e8f5e9;
        border: 1px solid #198754;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        color: #198754;
    }
</style>

<!-- User Status Banner -->
@if (isAuthenticated)
{
    <div class="bg-light border-bottom py-2">
        <div class="container">
            <div class="user-badge d-inline-flex align-items-center">
                <i class="fas fa-user-check me-2"></i>
                Logged in as @currentUser?.FirstName @currentUser?.LastName
                <span class="badge bg-success ms-2">Registered User</span>
            </div>
        </div>
    </div>
}
else
{
    <div class="bg-light border-bottom py-2">
        <div class="container">
            <div class="guest-badge d-inline-flex align-items-center">
                <i class="fas fa-user me-2"></i>
                Contacting as Guest
                <small class="text-muted ms-2">(No login required)</small>
            </div>
        </div>
    </div>
}

<!-- Mobile Quick Contact Bar -->
<div class="mobile-quick-contact d-md-none">
    <a href="tel:+15551234567" class="quick-contact-item">
        <i class="fas fa-phone"></i>
        <span>Call</span>
    </a>
    <a href="mailto:support@medicallearning.com" class="quick-contact-item">
        <i class="fas fa-envelope"></i>
        <span>Email</span>
    </a>
    <a href="#" class="quick-contact-item" @onclick="OpenLiveChat">
        <i class="fas fa-comment"></i>
        <span>Chat</span>
    </a>
    <a href="#" class="quick-contact-item" @onclick="ScrollToForm">
        <i class="fas fa-paper-plane"></i>
        <span>Message</span>
    </a>
</div>

<!-- Hero Section -->
<section class="contact-hero">
    <div class="container position-relative" style="z-index: 1;">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <!-- Desktop Hero Title -->
                <h1 class="display-5 fw-bold mb-3 d-none d-md-block">Get in Touch</h1>
                <!-- Mobile Hero Title -->
                <h1 class="h2 fw-bold mb-3 d-block d-md-none">Get in Touch</h1>

                <p class="lead mb-4">
                    Have questions about our platform? Need support? We're here to help you
                    succeed in your medical education journey.
                </p>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="d-flex align-items-center">
                            <div class="icon-circle bg-primary text-white me-3">
                                <i class="fas fa-headset"></i>
                            </div>
                            <div>
                                <h5 class="mb-0">24/7 Support</h5>
                                <small class="text-muted">Get help anytime</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="d-flex align-items-center">
                            <div class="icon-circle bg-success text-white me-3">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div>
                                <h5 class="mb-0">Fast Response</h5>
                                <small class="text-muted">Within 24 hours</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="contact-image">
                    <div style="background: linear-gradient(135deg, #0d6efd, #198754); width: 100%; height: 250px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-comments text-white fa-4x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Form & Info -->
<section class="contact-main py-5" id="contact-form-section">
    <div class="container">
        <div class="row g-4">
            <!-- Contact Form - Full width on mobile -->
            <div class="col-lg-7">
                <div class="contact-form-card card shadow-lg">
                    <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-envelope me-2"></i>
                            <span class="d-none d-md-inline">Send us a Message</span>
                            <span class="d-inline d-md-none">Send Message</span>
                        </h4>
                        @if (!isAuthenticated)
                        {
                            <small class="text-white-50">
                                <i class="fas fa-info-circle me-1"></i>
                                No login required
                            </small>
                        }
                    </div>
                    <div class="card-body p-3 p-md-4">
                        <EditForm Model="@contactForm" OnValidSubmit="@HandleSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="alert alert-danger" />

                            <!-- Mobile Form Layout -->
                            <div class="d-block d-md-none">
                                <!-- Guest Info Notice -->
                                @if (!isAuthenticated)
                                {
                                    <div class="alert alert-info small mb-3">
                                        <i class="fas fa-info-circle me-2"></i>
                                        You're contacting as a guest. Please provide your email so we can respond.
                                    </div>
                                }

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Name *</label>
                                    <InputText @bind-Value="contactForm.Name" class="form-control" placeholder="Your full name" />
                                    <ValidationMessage For="@(() => contactForm.Name)" class="text-danger small" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Email *</label>
                                    <InputText @bind-Value="contactForm.Email" class="form-control" placeholder="your@email.com" />
                                    <ValidationMessage For="@(() => contactForm.Email)" class="text-danger small" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Phone (Optional)</label>
                                    <InputText @bind-Value="contactForm.Phone" class="form-control" placeholder="(555) 123-4567" />
                                    <ValidationMessage For="@(() => contactForm.Phone)" class="text-danger small" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Subject *</label>
                                    <InputSelect @bind-Value="contactForm.Subject" class="form-control">
                                        <option value="">Select Subject</option>
                                        <option value="General Inquiry">General Inquiry</option>
                                        <option value="Technical Support">Technical Support</option>
                                        <option value="Billing Question">Billing Question</option>
                                        <option value="Course Inquiry">Course Inquiry</option>
                                        <option value="Partnership">Partnership</option>
                                        <option value="Other">Other</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => contactForm.Subject)" class="text-danger small" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Message *</label>
                                    <InputTextArea @bind-Value="contactForm.Message"
                                                   class="form-control"
                                                   placeholder="Type your message here..."
                                                   rows="5" />
                                    <ValidationMessage For="@(() => contactForm.Message)" class="text-danger small" />
                                </div>
                            </div>

                            <!-- Desktop Form Layout -->
                            <div class="d-none d-md-block">
                                <!-- Guest Info Notice -->
                                @if (!isAuthenticated)
                                {
                                    <div class="alert alert-info mb-3">
                                        <i class="fas fa-info-circle me-2"></i>
                                        You're contacting as a guest. We'll respond to the email address you provide.
                                    </div>
                                }

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3">
                                            <InputText id="contact-name" @bind-Value="contactForm.Name" class="form-control" placeholder="Your Name" />
                                            <label for="contact-name">Your Name *</label>
                                            <ValidationMessage For="@(() => contactForm.Name)" />
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating mb-3">
                                            <InputText id="contact-email" @bind-Value="contactForm.Email" class="form-control" placeholder="Email Address" />
                                            <label for="contact-email">Email Address *</label>
                                            <ValidationMessage For="@(() => contactForm.Email)" />
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating mb-3">
                                            <InputText id="contact-phone" @bind-Value="contactForm.Phone" class="form-control" placeholder="Phone Number" />
                                            <label for="contact-phone">Phone Number</label>
                                            <ValidationMessage For="@(() => contactForm.Phone)" />
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating mb-3">
                                            <InputSelect id="contact-subject" @bind-Value="contactForm.Subject" class="form-control">
                                                <option value="">Select Subject</option>
                                                <option value="General Inquiry">General Inquiry</option>
                                                <option value="Technical Support">Technical Support</option>
                                                <option value="Billing Question">Billing Question</option>
                                                <option value="Course Inquiry">Course Inquiry</option>
                                                <option value="Partnership">Partnership</option>
                                                <option value="Other">Other</option>
                                            </InputSelect>
                                            <label for="contact-subject">Subject *</label>
                                            <ValidationMessage For="@(() => contactForm.Subject)" />
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating mb-3">
                                            <InputTextArea id="contact-message" @bind-Value="contactForm.Message"
                                                           class="form-control" placeholder="Your Message" style="height: 150px" />
                                            <label for="contact-message">Your Message *</label>
                                            <ValidationMessage For="@(() => contactForm.Message)" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="contact-newsletter" @bind="contactForm.SubscribeNewsletter" />
                                        <label class="form-check-label small" for="contact-newsletter">
                                            Subscribe to newsletter
                                        </label>
                                    </div>

                                    <!-- Mobile Send Button -->
                                    <button type="submit" class="btn btn-primary w-100 d-block d-md-none" disabled="@isSubmitting">
                                        @if (isSubmitting)
                                        {
                                            <span>
                                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                Sending...
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                <i class="fas fa-paper-plane me-2"></i>
                                                Send Message
                                            </span>
                                        }
                                    </button>

                                    <!-- Desktop Send Button -->
                                    <button type="submit" class="btn btn-primary px-4 d-none d-md-block" disabled="@isSubmitting">
                                        @if (isSubmitting)
                                        {
                                            <span>
                                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                Sending...
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                <i class="fas fa-paper-plane me-2"></i>
                                                Send Message
                                            </span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </EditForm>

                        @if (showSuccessMessage)
                        {
                            <div class="alert alert-success mt-4" id="contact-success-message">
                                <i class="fas fa-check-circle me-2"></i>
                                <strong>Thank you!</strong> Your message has been sent successfully. We'll get back to you soon.
                            </div>
                        }

                        @if (showErrorMessage)
                        {
                            <div class="alert alert-danger mt-4" id="contact-error-message">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                <strong>Error!</strong> @errorMessage
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Contact Info - Stacked on mobile -->
            <div class="col-lg-5">
                <!-- Mobile Contact Info (Collapsible) -->
                <div class="d-block d-lg-none">
                    <div class="accordion" id="mobileContactAccordion">
                        <!-- Support Hours -->
                        <div class="accordion-item border-0 mb-3 shadow-sm">
                            <h2 class="accordion-header">
                                <button class="accordion-button bg-info text-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHours">
                                    <i class="fas fa-clock me-2"></i> Support Hours
                                </button>
                            </h2>
                            <div id="collapseHours" class="accordion-collapse collapse show" data-bs-parent="#mobileContactAccordion">
                                <div class="accordion-body">
                                    <ul class="list-unstyled mb-0">
                                        <li class="mb-2 d-flex justify-content-between">
                                            <span>Monday - Friday</span>
                                            <span class="fw-bold">24/7</span>
                                        </li>
                                        <li class="mb-2 d-flex justify-content-between">
                                            <span>Saturday</span>
                                            <span class="fw-bold">9 AM - 8 PM EST</span>
                                        </li>
                                        <li class="d-flex justify-content-between">
                                            <span>Sunday</span>
                                            <span class="fw-bold">10 AM - 6 PM EST</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Contact Methods -->
                        <div class="accordion-item border-0 mb-3 shadow-sm">
                            <h2 class="accordion-header">
                                <button class="accordion-button bg-primary text-white collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseContact">
                                    <i class="fas fa-phone me-2"></i> Contact Methods
                                </button>
                            </h2>
                            <div id="collapseContact" class="accordion-collapse collapse" data-bs-parent="#mobileContactAccordion">
                                <div class="accordion-body">
                                    <div class="contact-method mb-3">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-circle bg-primary text-white me-3">
                                                <i class="fas fa-phone"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-1">Phone Support</h6>
                                                <a href="tel:+15551234567" class="text-decoration-none">+1 (555) 123-4567</a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="contact-method mb-3">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-circle bg-success text-white me-3">
                                                <i class="fas fa-envelope"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-1">Email</h6>
                                                <a href="mailto:support@medicallearning.com" class="text-decoration-none">support@medicallearning.com</a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="contact-method">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-circle bg-info text-white me-3">
                                                <i class="fas fa-map-marker-alt"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-1">Address</h6>
                                                <p class="mb-0">123 Medical Plaza, Boston</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Desktop Contact Info -->
                <div class="d-none d-lg-block">
                    <div class="sticky-top" style="top: 20px;">
                        <!-- Support Hours -->
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-info text-white">
                                <h5 class="mb-0"><i class="fas fa-clock me-2"></i> Support Hours</h5>
                            </div>
                            <div class="card-body">
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-2 d-flex justify-content-between">
                                        <span>Monday - Friday</span>
                                        <span class="fw-bold">24/7</span>
                                    </li>
                                    <li class="mb-2 d-flex justify-content-between">
                                        <span>Saturday</span>
                                        <span class="fw-bold">9 AM - 8 PM EST</span>
                                    </li>
                                    <li class="d-flex justify-content-between">
                                        <span>Sunday</span>
                                        <span class="fw-bold">10 AM - 6 PM EST</span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Contact Methods -->
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title mb-4">Other Ways to Reach Us</h5>

                                <div class="contact-method mb-4">
                                    <div class="d-flex align-items-start">
                                        <div class="icon-circle bg-primary text-white me-3">
