

<!-- Mobile Full-Screen Search Overlay -->
<div class="mobile-search-overlay d-md-none @(showMobileOverlay ? "show" : "")">
    <div class="mobile-search-header">
        <div class="d-flex align-items-center p-3 bg-white border-bottom">
            <button class="btn btn-link text-dark p-0 me-3" @onclick="CloseMobileOverlay">
                <i class="fas fa-arrow-left fa-lg"></i>
            </button>
            <div class="flex-grow-1">
                <input type="text"
                       class="form-control form-control-lg border-0 px-0"
                       placeholder="Search courses, lectures..."
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeyup="HandleKeyUp"
                       autofocus
                       autocomplete="off" />
            </div>
            <button class="btn btn-link text-dark p-0 ms-3" @onclick="ClearSearch">
                <i class="fas fa-times fa-lg"></i>
            </button>
        </div>
    </div>

    <div class="mobile-search-body" style="height: calc(100vh - 70px); overflow-y: auto;">
        @if (isLoading)
        {
            <div class="d-flex flex-column align-items-center justify-content-center p-5">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <p class="text-muted">Searching...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(searchQuery))
        {
            @if (!hasResults)
            {
                <div class="text-center p-5">
                    <i class="fas fa-search fa-3x text-muted mb-3"></i>
                    <h6>No results found</h6>
                    <p class="text-muted small">Try different keywords or browse categories</p>
                    <button class="btn btn-outline-primary mt-3" @onclick="BrowseCategories">
                        <i class="fas fa-compass me-2"></i>Browse Categories
                    </button>
                </div>
            }
            else
            {
                <!-- Mobile Results -->
                <div class="p-3">
                    <!-- Quick Stats -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted small">Found @(specializations.Count + courses.Count + lectures.Count) results</span>
                        <button class="btn btn-sm btn-link" @onclick="PerformFullSearch">
                            View All <i class="fas fa-arrow-right ms-1"></i>
                        </button>
                    </div>

                    <!-- Specializations -->
                    @if (specializations.Any())
                    {
                        <div class="mb-4">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-layer-group text-primary me-2"></i>
                                <h6 class="mb-0 flex-grow-1">Specializations</h6>
                                @if (specializations.Count > 3)
                                {
                                    <small class="text-primary">@specializations.Count total</small>
                                }
                            </div>
                            @foreach (var spec in specializations.Take(3))
                            {
                                <div class="mobile-search-result" @onclick="() => NavigateToSpecialization(spec.Id)">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(spec.ThumbnailUrl))
                                        {
                                            <img src="@spec.ThumbnailUrl" class="rounded me-3" width="50" height="50" style="object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                <i class="fas fa-layer-group text-muted"></i>
                                            </div>
                                        }
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1">@spec.Title</h6>
                                            <div class="d-flex align-items-center small text-muted">
                                                <span class="me-2"><i class="fas fa-clock me-1"></i>@spec.EstimatedDurationHours h</span>
                                                @if (spec.Courses != null)
                                                {
                                                    <span><i class="fas fa-book me-1"></i>@spec.Courses.Count courses</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <span class="fw-bold text-success">$@spec.Price.ToString("N0")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (specializations.Count > 3)
                            {
                                <button class="btn btn-light w-100 mt-2" @onclick='() => SwitchTab("specializations")'>
                                    View all @specializations.Count specializations
                                </button>
                            }
                        </div>
                    }

                    <!-- Courses -->
                    @if (courses.Any())
                    {
                        <div class="mb-4">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-book-open text-info me-2"></i>
                                <h6 class="mb-0 flex-grow-1">Courses</h6>
                                @if (courses.Count > 3)
                                {
                                    <small class="text-info">@courses.Count total</small>
                                }
                            </div>
                            @foreach (var course in courses.Take(3))
                            {
                                <div class="mobile-search-result" @onclick="() => NavigateToCourse(course.Id)">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                        {
                                            <img src="@course.ThumbnailUrl" class="rounded me-3" width="50" height="50" style="object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                <i class="fas fa-book-open text-muted"></i>
                                            </div>
                                        }
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1">@course.Title</h6>
                                            <div class="d-flex align-items-center small text-muted">
                                                <span class="me-2"><i class="fas fa-book me-1"></i>@GetLectureCountText(course)</span>
                                                @if (enrollmentStatus.ContainsKey($"course_{course.Id}"))
                                                {
                                                    <span class="badge bg-success">@GetEnrollmentStatusText(enrollmentStatus[$"course_{course.Id}"])</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <span class="fw-bold text-success">$@course.Price.ToString("N0")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (courses.Count > 3)
                            {
                                <button class="btn btn-light w-100 mt-2" @onclick='() => SwitchTab("courses")'>
                                    View all @courses.Count courses
                                </button>
                            }
                        </div>
                    }

                    <!-- Lectures -->
                    @if (lectures.Any())
                    {
                        <div class="mb-4">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-play-circle text-warning me-2"></i>
                                <h6 class="mb-0 flex-grow-1">Lectures</h6>
                                @if (lectures.Count > 3)
                                {
                                    <small class="text-warning">@lectures.Count total</small>
                                }
                            </div>
                            @foreach (var lecture in lectures.Take(3))
                            {
                                <div class="mobile-search-result" @onclick="() => NavigateToLecture(lecture.Id)">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                            <i class="fas fa-play-circle text-warning"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1">@lecture.Title</h6>
                                            <div class="d-flex align-items-center small text-muted">
                                                <span class="me-2"><i class="fas fa-clock me-1"></i>@lecture.EstimatedDurationMinutes min</span>
                                                @if (lecture.IsFreePreview)
                                                {
                                                    <span class="badge bg-success">Free</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <span class="fw-bold text-success">$@lecture.Price.ToString("N0")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (lectures.Count > 3)
                            {
                                <button class="btn btn-light w-100 mt-2" @onclick='() => SwitchTab("lectures")'>
                                    View all @lectures.Count lectures
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <!-- Mobile Empty State with Suggestions -->
            <div class="p-4">
                <div class="text-center mb-4">
                    <i class="fas fa-search fa-3x text-muted mb-3"></i>
                    <h5>Search for anything</h5>
                    <p class="text-muted small">Find specializations, courses, and lectures</p>
                </div>

                <div class="popular-searches mt-4">
                    <h6 class="mb-3">Popular Searches</h6>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick='() => SetSearchQuery("Programming")'>Programming</button>
                        <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick='() => SetSearchQuery("Web Development")'>Web Development</button>
                        <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick='() => SetSearchQuery("Data Science")'>Data Science</button>
                        <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick='() => SetSearchQuery("Mobile Apps")'>Mobile Apps</button>
                    </div>
                </div>

                <div class="categories-section mt-4">
                    <h6 class="mb-3">Browse Categories</h6>
                    <div class="list-group">
                        <button class="list-group-item list-group-item-action d-flex align-items-center" @onclick='() => BrowseCategory(" specializations")'>
                            <i class="fas fa-layer-group text-primary me-3" style="width: 20px;"></i>
                            <span>Specializations</span>
                            <i class="fas fa-chevron-right ms-auto text-muted"></i>
                        </button>
                        <button class="list-group-item list-group-item-action d-flex align-items-center" @onclick='() => BrowseCategory(" courses")'>
                            <i class="fas fa-book-open text-info me-3" style="width: 20px;"></i>
                            <span>Courses</span>
                            <i class="fas fa-chevron-right ms-auto text-muted"></i>
                        </button>
                        <button class="list-group-item list-group-item-action d-flex align-items-center" @onclick='() => BrowseCategory(" lectures")'>
                            <i class="fas fa-play-circle text-warning me-3" style="width: 20px;"></i>
                            <span>Lectures</span>
                            <i class="fas fa-chevron-right ms-auto text-muted"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Desktop Search Component (Original) -->
<div class="search-component d-none d-md-block">
    <div class="input-group">
        <span class="input-group-text bg-white border-end-0">
            <i class="fas fa-search text-muted"></i>
        </span>
        <input type="text"
               class="form-control border-start-0"
               placeholder="Search specializations, courses, lectures..."
               @bind="searchQuery"
               @bind:event="oninput"
               @onclick="OpenMobileOverlay"
               @onkeyup="HandleKeyUp"
               @onfocus="ShowDropdown"
               @onblur="HideDropdown"
               autocomplete="off" />
        @if (!string.IsNullOrEmpty(searchQuery))
        {
            <button class="btn btn-outline-secondary border-start-0" @onclick="ClearSearch">
                <i class="fas fa-times"></i>
            </button>
        }
        else
        {
            <button class="btn btn-outline-secondary border-start-0" @onclick="TriggerSearch">
                <i class="fas fa-search"></i>
            </button>
        }
    </div>

    <!-- Desktop Search Results Dropdown (Original) -->
    @if (showResults && !string.IsNullOrEmpty(searchQuery) && (hasResults || isLoading))
    {
        <div class="search-results dropdown-menu show w-100 mt-1 shadow-lg" style="max-height: 400px; overflow-y: auto;"
             @onmouseenter="KeepDropdownOpen" @onmouseleave="HideDropdown">
            @if (isLoading)
            {
                <div class="p-3 text-center">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Searching...</span>
                    </div>
                    <p class="text-muted mt-2 mb-0">Searching...</p>
                </div>
            }
            else if (hasResults)
            {
                <!-- Desktop Tabs (Original) -->
                <ul class="nav nav-tabs px-3 pt-2" id="searchTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "all" ? "active" : "")"
                                @onclick='() => SwitchTab("all")'>
                            All (@(specializations.Count + courses.Count + lectures.Count))
                        </button>
                    </li>
                    @if (specializations.Any())
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeTab == "specializations" ? "active" : "")"
                                    @onclick='() => SwitchTab("specializations")'>
                                Specializations (@specializations.Count)
                            </button>
                        </li>
                    }
                    @if (courses.Any())
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeTab == "courses" ? "active" : "")"
                                    @onclick='() => SwitchTab("courses")'>
                                Courses (@courses.Count)
                            </button>
                        </li>
                    }
                    @if (lectures.Any())
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeTab == "lectures" ? "active" : "")"
                                    @onclick='() => SwitchTab("lectures")'>
                                Lectures (@lectures.Count)
                            </button>
                        </li>
                    }
                </ul>

                <!-- Desktop Results Content (Original - Keep your existing desktop results HTML) -->
                <div class="tab-content p-3">
                    <!-- ... (keep your existing desktop tab content exactly as is) ... -->
                </div>

                <!-- Desktop View All Button -->
                <div class="border-top p-3 text-center">
                    <button class="btn btn-primary btn-sm" @onclick="PerformFullSearch">
                        <i class="fas fa-search me-1"></i>
                        View all results for "@searchQuery"
                    </button>
                </div>
            }
            else if (!isLoading)
            {
                <div class="p-4 text-center">
                    <i class="fas fa-search fa-2x text-muted mb-3"></i>
                    <p class="text-muted mb-1">No results found for "@searchQuery"</p>
                    <small class="text-muted">Try different keywords</small>
                </div>
            }
        </div>
    }
</div>

<!-- Mobile Trigger Button (visible only on mobile) -->
<div class="d-md-none">
    <button class="btn btn-light w-100 d-flex align-items-center justify-content-start p-3 border rounded-3"
            @onclick="OpenMobileOverlay">
        <i class="fas fa-search text-muted me-3"></i>
        <span class="text-muted">Search courses and lectures...</span>
    </button>
</div>

<style>
    /* Desktop Styles */
    .search-component {
        position: relative;
    }

    .search-results {
        position: absolute;
        z-index: 1050;
        left: 0;
        right: 0;
        display: block !important;
        animation: fadeIn 0.2s ease-in-out;
    }

    .search-result-item {
        padding: 10px 15px;
        cursor: pointer;
        transition: all 0.2s ease;
        border-radius: 5px;
        margin-bottom: 5px;
    }

        .search-result-item:hover {
            background-color: #f8f9fa;
            transform: translateX(2px);
        }

        .search-result-item:active {
            background-color: #e9ecef;
            transform: translateX(0);
        }

    /* Mobile Styles */
    .mobile-search-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: white;
        z-index: 2000;
        overflow-y: auto;
    }

        .mobile-search-overlay.show {
            display: block;
        }

    .mobile-search-result {
        padding: 12px;
        margin-bottom: 8px;
        background-color: white;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .mobile-search-result:hover {
            background-color: #f8f9fa;
        }

        .mobile-search-result:active {
            background-color: #e9ecef;
        }

    /* Category buttons */
    .list-group-item {
        border: none;
        padding: 15px;
        background-color: #f8f9fa;
        margin-bottom: 8px;
        border-radius: 12px !important;
    }

        .list-group-item:active {
            background-color: #e9ecef;
        }

    /* Popular search buttons */
    .btn-outline-secondary.rounded-pill {
        padding: 8px 16px;
        font-size: 14px;
    }

    /* Animations */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideUp {
        from {
            transform: translateY(100%);
        }

        to {
            transform: translateY(0);
        }
    }

    /* Form controls */
    .form-control:focus {
        box-shadow: none;
        border-color: #dee2e6;
    }

    .mobile-search-header .form-control:focus {
        outline: none;
    }

    /* Desktop nav tabs */
    .nav-tabs .nav-link {
        padding: 8px 16px;
        font-size: 0.875rem;
        border: none;
        color: #6c757d;
        transition: all 0.2s;
    }

        .nav-tabs .nav-link:hover {
            color: #0d6efd;
            border: none;
        }

        .nav-tabs .nav-link.active {
            color: #0d6efd;
            border-bottom: 2px solid #0d6efd;
            background: none;
        }
</style>

@code {
    [Parameter] public bool AutoSearch { get; set; } = true;
    [Parameter] public int MinChars { get; set; } = 2;
    [Parameter] public int DebounceDelay { get; set; } = 300;
    [Parameter] public string Size { get; set; } = "normal";
    [Parameter] public EventCallback<string> OnSearch { get; set; }

    private string searchQuery = "";
    private List<SpecializationDto> specializations = new();
    private List<CourseDto> courses = new();
    private List<LectureDto> lectures = new();
    private bool showResults = false;
    private bool isLoading = false;
    private string activeTab = "all";
    private Timer? debounceTimer;
    private UserDto? currentUser;
    private bool isAuthenticated = false;
    private (int id, string type)? hoverItem = null;
    private bool keepOpen = false;
    private bool isInitialized = false;
    private bool showMobileOverlay = false;

    private Dictionary<string, string> enrollmentStatus = new();
    private CancellationTokenSource? cts;

    private bool hasResults => specializations.Any() || courses.Any() || lectures.Any();

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
        isInitialized = true;
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();
            }
            else
            {
                currentUser = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SearchComponent: Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            currentUser = null;
        }
    }

    private void OpenMobileOverlay()
    {
        showMobileOverlay = true;
        StateHasChanged();
    }

    private void CloseMobileOverlay()
    {
        showMobileOverlay = false;
        StateHasChanged();
    }

    private void BrowseCategories()
    {
        CloseMobileOverlay();
        Navigation.NavigateTo("/browse");
    }

    private void BrowseCategory(string category)
    {
        CloseMobileOverlay();
        Navigation.NavigateTo($"/browse?category={category}");
    }

    private string GetTruncatedText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return text;
        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
    }

    private string GetLectureCountText(CourseDto course)
    {
        if (course.Lectures == null || !course.Lectures.Any())
            return "0 lectures";

        return $"{course.Lectures.Count} lecture{(course.Lectures.Count != 1 ? "s" : "")}";
    }

    private string GetEnrollmentStatusText(string status)
    {
        return status switch
        {
            "enrolled" => "Enrolled",
            "in-progress" => "In Progress",
            "completed" => "Completed",
            _ => status
        };
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformFullSearch();
            if (showMobileOverlay)
            {
                CloseMobileOverlay();
            }
        }
        else if (e.Key == "Escape")
        {
            if (showMobileOverlay)
            {
                CloseMobileOverlay();
            }
            else
            {
                HideDropdown();
            }
        }
        else if (AutoSearch && searchQuery.Length >= MinChars)
        {
            debounceTimer?.Dispose();
            debounceTimer = new Timer(async _ => await SearchAsync(), null, DebounceDelay, Timeout.Infinite);
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || searchQuery.Length < MinChars)
        {
            ClearResults();
            return;
        }

        // Cancel previous search if still running
        cts?.Cancel();
        cts = new CancellationTokenSource();

        isLoading = true;
        if (!showMobileOverlay)
        {
            showResults = true;
        }
        StateHasChanged();

        try
        {
            Console.WriteLine($"SearchComponent: Searching for '{searchQuery}'...");

            var quickResults = await SearchService.QuickSearchAsync(searchQuery, 5);

            if (quickResults != null)
            {
                specializations = quickResults.Specializations ?? new List<SpecializationDto>();
                courses = quickResults.Courses ?? new List<CourseDto>();
                lectures = quickResults.Lectures ?? new List<LectureDto>();

                Console.WriteLine($"SearchComponent: Found {specializations.Count} specializations, {courses.Count} courses, {lectures.Count} lectures");
            }
            else
            {
                specializations = new List<SpecializationDto>();
                courses = new List<CourseDto>();
                lectures = new List<LectureDto>();
            }

            // Load enrollment status for current user
            if (isAuthenticated && currentUser?.UserType == UserType.User)
            {
                await LoadEnrollmentStatus(cts.Token);
            }
            else
            {
                enrollmentStatus.Clear();
            }

            // Set default tab based on results
            UpdateActiveTab();

            // Notify parent component
            await OnSearch.InvokeAsync(searchQuery);
        }
        catch (OperationCanceledException)
        {
            Console.WriteLine("Search was cancelled");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SearchComponent: Search error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ClearResults()
    {
        specializations.Clear();
        courses.Clear();
        lectures.Clear();
        enrollmentStatus.Clear();
    }

    private async Task LoadEnrollmentStatus(CancellationToken cancellationToken)
    {
        try
        {
            enrollmentStatus.Clear();

            if (!isAuthenticated || currentUser?.UserType != UserType.User)
                return;

            Console.WriteLine($"SearchComponent: Loading enrollment status for user {currentUser.Id}");

            var enrollments = await EnrollmentService.GetMyEnrollmentsAsync();
            if (enrollments == null || !enrollments.Any())
            {
                Console.WriteLine("SearchComponent: No enrollments found");
                return;
            }

            Console.WriteLine($"SearchComponent: Found {enrollments.Count} enrollments");

            // Check enrollment status for specializations
            foreach (var spec in specializations)
            {
                if (cancellationToken.IsCancellationRequested)
                    break;

                var enrollment = enrollments.FirstOrDefault(e => e.SpecializationId == spec.Id);
                if (enrollment != null)
                {
                    var status = enrollment.IsCompleted ? "completed" :
                                enrollment.ProgressPercentage > 0 ? "in-progress" : "enrolled";
                    enrollmentStatus[$"spec_{spec.Id}"] = status;
                    Console.WriteLine($"SearchComponent: User enrolled in specialization {spec.Id} - Status: {status}");
                }
            }

            // Check enrollment status for courses
            foreach (var course in courses)
            {
                if (cancellationToken.IsCancellationRequested)
                    break;

                var enrollment = enrollments.FirstOrDefault(e => e.CourseId == course.Id);
                if (enrollment != null)
                {
                    var status = enrollment.IsCompleted ? "completed" :
                                enrollment.ProgressPercentage > 0 ? "in-progress" : "enrolled";
                    enrollmentStatus[$"course_{course.Id}"] = status;
                    Console.WriteLine($"SearchComponent: User enrolled in course {course.Id} - Status: {status}");
                }
            }

            // Check enrollment status for lectures
            foreach (var lecture in lectures)
            {
                if (cancellationToken.IsCancellationRequested)
                    break;

                var enrollment = enrollments.FirstOrDefault(e => e.LectureId == lecture.Id);
                if (enrollment != null)
                {
                    var status = enrollment.IsCompleted ? "completed" :
                                enrollment.ProgressPercentage > 0 ? "in-progress" : "enrolled";
                    enrollmentStatus[$"lecture_{lecture.Id}"] = status;
                    Console.WriteLine($"SearchComponent: User enrolled in lecture {lecture.Id} - Status: {status}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SearchComponent: Error loading enrollment status: {ex.Message}");
        }
    }

    private void UpdateActiveTab()
    {
        if (activeTab == "all")
        {
            // Auto-switch if no results in current tab
            if (!specializations.Any() && !courses.Any() && lectures.Any())
                activeTab = "lectures";
            else if (!specializations.Any() && courses.Any())
                activeTab = "courses";
        }
    }

    private async Task PerformFullSearch()
    {
        if (!string.IsNullOrEmpty(searchQuery))
        {
            HideDropdown();
            CloseMobileOverlay();
            Console.WriteLine($"SearchComponent: Navigating to search page with query: {searchQuery}");
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(searchQuery)}");
        }
    }

    private void ShowDropdown()
    {
        if (!showMobileOverlay)
        {
            showResults = true;
            keepOpen = false;
            if (!string.IsNullOrEmpty(searchQuery) && searchQuery.Length >= MinChars && isInitialized)
            {
                _ = SearchAsync();
            }
        }
    }

    private void HideDropdown()
    {
        if (!keepOpen && !showMobileOverlay)
        {
            showResults = false;
            cts?.Cancel();
        }
    }

    private void KeepDropdownOpen()
    {
        keepOpen = true;
    }

    private async void ClearSearch()
    {
        searchQuery = "";
        specializations.Clear();
        courses.Clear();
        lectures.Clear();
        enrollmentStatus.Clear();
        showResults = false;
        keepOpen = false;
        cts?.Cancel();
        await InvokeAsync(StateHasChanged);
    }

    private async void TriggerSearch()
    {
        if (!string.IsNullOrEmpty(searchQuery))
        {
            await PerformFullSearch();
        }
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        if (showMobileOverlay)
        {
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(searchQuery)}&type={tab}");
            CloseMobileOverlay();
        }
        else
        {
            StateHasChanged();
        }
    }

    private void NavigateToSpecialization(int id)
    {
        HideDropdown();
        CloseMobileOverlay();
        Navigation.NavigateTo($"/specialization/{id}");
    }

    private void NavigateToCourse(int id)
    {
        HideDropdown();
        CloseMobileOverlay();
        Navigation.NavigateTo($"/course/{id}");
    }

    private void NavigateToLecture(int id)
    {
        HideDropdown();
        CloseMobileOverlay();
        Navigation.NavigateTo($"/lecture/{id}");
    }

    private void SetHoverItem(int id, string type)
    {
        hoverItem = (id, type);
        keepOpen = true;
    }

    private void ClearHoverItem()
    {
        hoverItem = null;
        keepOpen = false;
    }

    public async Task RefreshUserState()
    {
        await CheckAuthentication();
        await InvokeAsync(StateHasChanged);
    }

    public void Clear()
    {
        ClearSearch();
    }

    public async void SetSearchQuery(string query)
    {
        searchQuery = query;
        if (!string.IsNullOrEmpty(query) && query.Length >= MinChars)
        {
            await SearchAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
        cts?.Cancel();
        cts?.Dispose();
    }
}