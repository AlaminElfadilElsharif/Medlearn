    private int GetTimeSpentSeconds()
    {
        if (currentProgress != null)
        {
            return Math.Max(currentProgress.TimeSpentSeconds, 30);
        }
        
        return GetInitialTimeSpent();
    }
    
    private int GetInitialTimeSpent()
    {
        return Material.Type switch
        {
            MaterialType.Video => Math.Max(30, Math.Min(300, Material.DurationSeconds / 4)),
            MaterialType.Audio => Math.Max(30, Math.Min(300, Material.DurationSeconds / 4)),
            MaterialType.Document => 60,
            MaterialType.PDF => 90,
            MaterialType.Text => 45,
            MaterialType.Image => 20,
            MaterialType.Presentation => 120,
            _ => 30
        };
    }
    
    private int GetMinimumViewingTime()
    {
        return Material.Type switch
        {
            MaterialType.Video => Math.Max(60, (int)(Material.DurationSeconds * 0.1)),
            MaterialType.Audio => Math.Max(60, (int)(Material.DurationSeconds * 0.1)),
            MaterialType.Document => 30,
            MaterialType.PDF => 45,
            MaterialType.Text => 20,
            MaterialType.Image => 5,
            MaterialType.Presentation => 60,
            _ => 30
        };
    }
    
