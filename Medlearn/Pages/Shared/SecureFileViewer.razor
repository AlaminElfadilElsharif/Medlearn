    private async Task LoadCurrentProgress()
    {
        if (!hasAccess || Material == null || isFreePreview) 
        {
            Console.WriteLine($"[Progress] Skipping - no access, no material, or free preview");
            return;
        }
        
        if (isProgressLoading) 
        {
            Console.WriteLine($"[Progress] Already loading");
            return;
        }

        if ((DateTime.UtcNow - lastProgressLoadTime).TotalSeconds < 5)
        {
            Console.WriteLine($"[Progress] Debounced");
            return;
        }

        await progressLoadLock.WaitAsync();
        isProgressLoading = true;
        
        try
        {
            lastProgressLoadTime = DateTime.UtcNow;
            Console.WriteLine($"[Progress] Loading progress for Material ID: {Material.Id}");

            try
            {
                var enrollments = await EnrollmentService.GetMyEnrollmentsAsync();
                
                Console.WriteLine($"[Progress] Found {enrollments?.Count ?? 0} enrollments");

                if (enrollments != null && enrollments.Any())
                {
                    currentEnrollmentId = await FindEnrollmentContainingMaterial(enrollments, Material.Id);
                    
                    if (currentEnrollmentId > 0)
                    {
                        Console.WriteLine($"[Progress] Found enrollment: {currentEnrollmentId}");
                        
                        var progressList = await EnrollmentService.GetEnrollmentProgressAsync(currentEnrollmentId);
                        
                        if (progressList != null)
                        {
                            currentProgress = progressList.FirstOrDefault(p => p.MaterialId == Material.Id);
                            
                            if (currentProgress != null)
                            {
                                Console.WriteLine($"[Progress] Progress found: Completed={currentProgress.IsCompleted}");
                            }
                            else
                            {
                                Console.WriteLine($"[Progress] No progress found for this material");
                            }
                        }
                    }
                    else
                    {
                        Console.WriteLine($"[Progress] No matching enrollment found");
                        currentEnrollmentId = 0;
                        currentProgress = null;
                    }
                }
                else
                {
                    Console.WriteLine($"[Progress] No enrollments found");
                    currentEnrollmentId = 0;
                    currentProgress = null;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Progress] Error: {ex.Message}");
                currentEnrollmentId = 0;
                currentProgress = null;
            }
        }
        finally
        {
            isProgressLoading = false;
            progressLoadLock.Release();
        }
    }
    
    private async Task<int> FindEnrollmentContainingMaterial(List<EnrollmentDto> enrollments, int materialId)
    {
        try
        {
            var lecture = await LectureService.GetLectureAsync(Material.LectureId);
            if (lecture == null) 
            {
                Console.WriteLine($"[FindEnrollment] Lecture not found: {Material.LectureId}");
                return 0;
            }
            
            Console.WriteLine($"[FindEnrollment] Lecture found: {lecture.Id}, Course: {lecture.CourseId}");
            
            foreach (var enrollment in enrollments)
            {
                Console.WriteLine($"[FindEnrollment] Checking enrollment {enrollment.Id}, Type: {enrollment.EnrollmentType}");
                
                switch (enrollment.EnrollmentType)
                {
                    case EnrollmentType.Lecture:
                        if (enrollment.LectureId == lecture.Id)
                        {
                            Console.WriteLine($"[FindEnrollment] Found lecture enrollment match");
                            return enrollment.Id;
                        }
                        break;
                        
                    case EnrollmentType.Course:
                        if (enrollment.CourseId == lecture.CourseId)
                        {
                            Console.WriteLine($"[FindEnrollment] Found course enrollment match");
                            return enrollment.Id;
                        }
                        break;
                        
                    case EnrollmentType.Specialization:
                        var course = await CourseService.GetCourseAsync(lecture.CourseId);
                        if (course != null && enrollment.SpecializationId == course.SpecializationId)
                        {
                            Console.WriteLine($"[FindEnrollment] Found specialization enrollment match");
                            return enrollment.Id;
                        }
                        break;
                }
            }
            
            Console.WriteLine($"[FindEnrollment] No matching enrollment found");
            return 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FindEnrollment] Error: {ex.Message}");
            return 0;
        }
    }
    
    private async Task HandleProgressUpdated(ProgressUpdateEventArgs args)
    {
        if (!isAuthenticated || Material == null || currentEnrollmentId == 0) return;
        
        try
        {
            var updateDto = new UpdateProgressDto
            {
                MaterialId = Material.Id,
                IsCompleted = args.IsCompleted,
                TimeSpentSeconds = args.TimeSpentSeconds,
                LastPositionSeconds = args.LastPositionSeconds
            };
            
            await EnrollmentService.UpdateProgressAsync(currentEnrollmentId, updateDto);
            
            if (currentProgress != null)
            {
                currentProgress.IsCompleted = args.IsCompleted;
                currentProgress.TimeSpentSeconds = args.TimeSpentSeconds;
                currentProgress.LastPositionSeconds = args.LastPositionSeconds;
                if (args.IsCompleted)
                {
                    currentProgress.CompletedDate = DateTime.UtcNow;
                }
            }
            
            Console.WriteLine($"[Progress] Updated for material {Material.Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Progress] Error updating: {ex.Message}");
        }
    }
    
    private async Task HandleMarkAsCompleted()
    {
        if (!isAuthenticated || Material == null || currentEnrollmentId == 0) return;
        
        try
        {
            int totalTimeSpent = GetTimeSpentSeconds();
            int minTime = GetMinimumViewingTime();
            
            if (totalTimeSpent < minTime)
            {
                totalTimeSpent = minTime;
            }
            
            var updateDto = new UpdateProgressDto
            {
                MaterialId = Material.Id,
                IsCompleted = true,
                TimeSpentSeconds = totalTimeSpent,
                LastPositionSeconds = 0
            };
            
            Console.WriteLine($"[Progress] Marking material as completed: {Material.Title}");
            await EnrollmentService.UpdateProgressAsync(currentEnrollmentId, updateDto);
            
            if (currentProgress != null)
            {
                currentProgress.IsCompleted = true;
                currentProgress.TimeSpentSeconds = totalTimeSpent;
                currentProgress.LastPositionSeconds = 0;
                currentProgress.CompletedDate = DateTime.UtcNow;
            }
            
            await ShowToast("success", "Material marked as completed!");
            await CheckLectureCompletion();
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Error marking as completed: {ex.Message}");
            Console.WriteLine($"[Progress] Error marking as completed: {ex.Message}");
        }
    }
    
    private async Task CheckLectureCompletion()
    {
        try
        {
            if (Material.LectureId == 0 || currentEnrollmentId == 0) return;
            
            var lecture = await LectureService.GetLectureAsync(Material.LectureId);
            if (lecture?.Materials == null) return;
            
            bool allMaterialsCompleted = true;
            
            foreach (var material in lecture.Materials)
            {
                var progressList = await EnrollmentService.GetEnrollmentProgressAsync(currentEnrollmentId);
                var materialProgress = progressList?.FirstOrDefault(p => p.MaterialId == material.Id);
                
                if (materialProgress == null || !materialProgress.IsCompleted)
                {
                    allMaterialsCompleted = false;
                    break;
                }
            }
            
            if (allMaterialsCompleted)
            {
                await ShowToast("success", "All materials in this lecture are completed!");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Progress] Error checking lecture completion: {ex.Message}");
        }
    }
    
    private async Task DownloadMaterial()
    {
        if (!isAuthenticated || !hasAccess || Material == null || !Material.IsDownloadable) return;
        
        try
        {
            Console.WriteLine($"[Download] Downloading material {Material.Id}");
            await SecureFileViewerService.DownloadMaterialAsync(Material.Id, Material.Title);
            await ShowToast("success", "Download started!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Download] Error: {ex.Message}");
            await ShowToast("error", $"Download failed: {ex.Message}");
        }
    }
    
    private async Task RetryLoading()
    {
        Console.WriteLine($"[Retry] Retrying load for material {Material?.Id}");
        
        // Clear all caches for this material
        SecureFileViewerService.ClearAccessCacheForMaterial(Material.Id);
        
        // Clear local caches
        await _cacheLock.WaitAsync();
        try
        {
            _accessCache.Remove(Material.Id);
            if (Material.LectureId > 0)
            {
                _freePreviewCache.Remove(Material.LectureId);
            }
        }
        finally
        {
            _cacheLock.Release();
        }
        
        loadError = false;
        errorMessage = string.Empty;
        isLoading = true;
        hasAccess = false;
        isFreePreview = false;
        
        await InvokeAsync(StateHasChanged);
        
        // Wait a moment then retry
        await Task.Delay(500);
        await OnParametersSetAsync();
    }
    
