    private async Task CheckAuthentication()
    {
        try
        {
            var tokenExists = await TokenService.IsAuthenticatedAsync();
            if (!tokenExists)
            {
                isAuthenticated = false;
                currentUser = null;
                Console.WriteLine($"[Auth] No token found");
                return;
