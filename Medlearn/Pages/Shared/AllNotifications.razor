@page "/notifications"


<PageTitle>Notifications</PageTitle>

<!-- Mobile Header (visible only on mobile) -->
<div class="d-block d-md-none bg-primary text-white p-3">
    <div class="d-flex align-items-center">
        <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
            <i class="fas fa-arrow-left fa-lg"></i>
        </button>
        <h5 class="mb-0 flex-grow-1">Notifications</h5>
        <button class="btn btn-link text-white p-0" @onclick="LoadNotifications">
            <i class="fas fa-sync-alt fa-lg"></i>
        </button>
    </div>
</div>

<div class="container-fluid px-0 px-md-3 mt-0 mt-md-4">
    <div class="row g-0 g-md-3">
        <div class="col-12 col-lg-8 mx-auto">
            <!-- Desktop Header (visible only on desktop) -->
            <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="mb-1">Notifications</h3>
                    <p class="text-muted mb-0">Manage your notifications</p>
                </div>
                <div class="d-flex gap-2">
                    @if (unreadCount > 0)
                    {
                        <button class="btn btn-outline-primary" @onclick="MarkAllAsRead">
                            <i class="fas fa-check-double me-2"></i>Mark all as read
                        </button>
                    }
                    <button class="btn btn-outline-secondary" @onclick="LoadNotifications">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>

            <!-- Stats Cards - Responsive -->
            <div class="row g-2 g-md-3 mb-3 mb-md-4">
                <div class="col-4">
                    <div class="card bg-primary text-white border-0 shadow-sm">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex flex-column align-items-center">
                                <i class="fas fa-bell d-block d-md-none mb-1"></i>
                                <h6 class="card-title mb-0 mb-md-1 small d-block d-md-none">Total</h6>
                                <h5 class="card-title mb-0 mb-md-1 d-none d-md-block">Total</h5>
                                <p class="card-text mb-0 fw-bold fs-5 fs-md-1">@totalCount</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card bg-warning text-white border-0 shadow-sm">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex flex-column align-items-center">
                                <i class="fas fa-envelope d-block d-md-none mb-1"></i>
                                <h6 class="card-title mb-0 mb-md-1 small d-block d-md-none">Unread</h6>
                                <h5 class="card-title mb-0 mb-md-1 d-none d-md-block">Unread</h5>
                                <p class="card-text mb-0 fw-bold fs-5 fs-md-1">@unreadCount</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card bg-secondary text-white border-0 shadow-sm">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex flex-column align-items-center">
                                <i class="fas fa-calendar-alt d-block d-md-none mb-1"></i>
                                <h6 class="card-title mb-0 mb-md-1 small d-block d-md-none">This Month</h6>
                                <h5 class="card-title mb-0 mb-md-1 d-none d-md-block">This Month</h5>
                                <p class="card-text mb-0 fw-bold fs-5 fs-md-1">@monthCount</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notifications List -->
            <div class="card border-0 border-md shadow-sm">
                <div class="card-body p-0">
                    @if (isLoading)
                    {
                        <div class="p-4 text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="text-muted mt-2">Loading notifications...</p>
                        </div>
                    }
                    else if (!notifications.Any())
                    {
                        <div class="p-5 text-center">
                            <div class="mb-3">
                                <i class="fas fa-bell-slash fa-3x text-muted"></i>
                            </div>
                            <h5 class="text-muted">No notifications yet</h5>
                            <p class="text-muted">You'll see important updates here</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var notification in notifications)
                            {
                                <!-- Mobile Notification Card -->
                                <div class="d-block d-md-none list-group-item p-2 @(!notification.IsRead ? "bg-light" : "")"
                                     style="border-left: 4px solid @GetNotificationColor(notification.Type);">
                                    <div class="d-flex align-items-start">
                                        <div class="notification-icon me-2">
                                            @GetNotificationIcon(notification.Type)
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <h6 class="mb-0 fw-bold small">@notification.Title</h6>
                                                <small class="text-muted">
                                                    @notification.SentDate.ToString("MMM dd")
                                                </small>
                                            </div>
                                            <p class="mb-1 small text-truncate" style="max-width: 200px;">
                                                @notification.Message
                                            </p>
                                            <div class="d-flex justify-content-end gap-1 mt-1">
                                                @if (!notification.IsRead)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary py-0 px-2"
                                                            @onclick="async () => await MarkAsRead(notification.Id)">
                                                        <i class="fas fa-check d-block d-md-none"></i>
                                                        <span class="d-none d-md-inline">Mark read</span>
                                                    </button>
                                                }
                                                <button class="btn btn-sm btn-outline-danger py-0 px-2"
                                                        @onclick="async () => await DeleteNotification(notification.Id)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                                @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                                {
                                                    <a href="@notification.ActionUrl" class="btn btn-sm btn-primary py-0 px-2">
                                                        <i class="fas fa-external-link-alt"></i>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Desktop Notification Card -->
                                <div class="d-none d-md-block list-group-item p-3 @(!notification.IsRead ? "bg-light" : "")"
                                     style="border-left: 4px solid @GetNotificationColor(notification.Type);">
                                    <div class="d-flex align-items-start">
                                        <div class="notification-icon me-3">
                                            @GetNotificationIcon(notification.Type)
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <h6 class="mb-0 fw-bold">@notification.Title</h6>
                                                    <small class="text-muted">
                                                        <i class="fas fa-clock me-1"></i>
                                                        @notification.SentDate.ToString("MMM dd, yyyy HH:mm")
                                                    </small>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    @if (!notification.IsRead)
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary"
                                                                @onclick="async () => await MarkAsRead(notification.Id)">
                                                            Mark read
                                                        </button>
                                                    }
                                                    <button class="btn btn-sm btn-outline-danger"
                                                            @onclick="async () => await DeleteNotification(notification.Id)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <p class="mb-2">@notification.Message</p>
                                            @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                            {
                                                <div class="mt-2">
                                                    <a href="@notification.ActionUrl" class="btn btn-sm btn-primary">
                                                        <i class="fas fa-external-link-alt me-1"></i>View Details
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination - Responsive -->
                        @if (totalPages > 1)
                        {
                            <div class="p-2 p-md-3 border-top">
                                <!-- Mobile Pagination -->
                                <div class="d-flex d-md-none justify-content-between align-items-center">
                                    <button class="btn btn-outline-primary btn-sm @(currentPage == 1 ? "disabled" : "")"
                                            @onclick="async () => await ChangePage(currentPage - 1)">
                                        <i class="fas fa-chevron-left"></i> Prev
                                    </button>
                                    <span class="small">Page @currentPage of @totalPages</span>
                                    <button class="btn btn-outline-primary btn-sm @(currentPage == totalPages ? "disabled" : "")"
                                            @onclick="async () => await ChangePage(currentPage + 1)">
                                        Next <i class="fas fa-chevron-right"></i>
                                    </button>
                                </div>

                                <!-- Desktop Pagination -->
                                <div class="d-none d-md-block">
                                    <nav aria-label="Page navigation">
                                        <ul class="pagination justify-content-center mb-0">
                                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                                <button class="page-link" @onclick="async () => await ChangePage(currentPage - 1)">
                                                    Previous
                                                </button>
                                            </li>

                                            @for (int i = 1; i <= totalPages; i++)
                                            {
                                                <li class="page-item @(i == currentPage ? "active" : "")">
                                                    <button class="page-link" @onclick="async () => await ChangePage(i)">
                                                        @i
                                                    </button>
                                                </li>
                                            }

                                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                                <button class="page-link" @onclick="async () => await ChangePage(currentPage + 1)">
                                                    Next
                                                </button>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Mobile Quick Actions (visible only on mobile) -->
            <div class="d-block d-md-none mt-3">
                <div class="row g-2">
                    @if (unreadCount > 0)
                    {
                        <div class="col-6">
                            <button class="btn btn-outline-primary w-100" @onclick="MarkAllAsRead">
                                <i class="fas fa-check-double me-2"></i>Mark all read
                            </button>
                        </div>
                    }
                    <div class="col-6">
                        <button class="btn btn-outline-secondary w-100" @onclick="LoadNotifications">
                            <i class="fas fa-sync-alt me-2"></i>Refresh
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<NotificationDto> notifications = new();
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalCount = 0;
    private int totalPages = 1;
    private int unreadCount = 0;
    private int monthCount = 0;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotifications();
        await LoadStats();
    }

    private async Task LoadNotifications()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await NotificationService.GetMyNotificationsAsync(
                unreadOnly: false,
                page: currentPage,
                pageSize: pageSize);

            if (result != null)
            {
                notifications = result;
                // 假设总数为通知数（实际应该从API获取总数）
                totalCount = notifications.Count;
                totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading notifications: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadStats()
    {
        try
        {
            unreadCount = await NotificationService.GetUnreadCountAsync();
            // 计算本月通知数（这里简化处理，实际应该从API获取）
            monthCount = notifications.Count(n => n.SentDate.Month == DateTime.Now.Month);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stats: {ex.Message}");
        }
    }

    private async Task MarkAsRead(int id)
    {
        try
        {
            await NotificationService.MarkAsReadAsync(id);
            await LoadNotifications();
            await LoadStats();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error marking as read: {ex.Message}");
        }
    }

    private async Task MarkAllAsRead()
    {
        try
        {
            await NotificationService.MarkAllAsReadAsync();
            await LoadNotifications();
            await LoadStats();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error marking all as read: {ex.Message}");
        }
    }

    private async Task DeleteNotification(int id)
    {
        try
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this notification?");
            if (confirmed)
            {
                await NotificationService.DeleteNotificationAsync(id);
                await LoadNotifications();
                await LoadStats();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting notification: {ex.Message}");
        }
    }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            await LoadNotifications();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    private string GetNotificationColor(string notificationType)
    {
        return notificationType switch
        {
            "PaymentStatus" => "#28a745",
            "Announcement" => "#007bff",
            "Enrollment" => "#17a2b8",
            "System" => "#6c757d",
            "Warning" => "#ffc107",
            "Error" => "#dc3545",
            _ => "#6c757d"
        };
    }

    private MarkupString GetNotificationIcon(string notificationType)
    {
        var iconClass = notificationType switch
        {
            "PaymentStatus" => "fas fa-money-bill-wave text-success",
            "Announcement" => "fas fa-bullhorn text-primary",
            "Enrollment" => "fas fa-graduation-cap text-info",
            "System" => "fas fa-cog text-secondary",
            "Warning" => "fas fa-exclamation-triangle text-warning",
            "Error" => "fas fa-exclamation-circle text-danger",
            _ => "fas fa-bell text-muted"
        };

        return new MarkupString($"<i class='{iconClass} fa-fw'></i>");
    }
}
