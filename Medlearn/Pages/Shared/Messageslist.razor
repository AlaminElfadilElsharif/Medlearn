</style>

@code {
    [Parameter]
    public string? ViewMode { get; set; }

    private enum MessageView
    {
        Inbox,
        Sent
    }

    private List<MessageDto> messages = new();
    private List<MessageDto> filteredMessages = new();
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = "";

    // View state
    private MessageView currentView = MessageView.Inbox;
    private UserDto? currentUser;

    // Filter properties
    private string searchQuery = "";
    private string? filterType = "";
    private string filterDateRange = "30";

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;

    // Statistics
    private int totalMessages = 0;
    private int unreadCount = 0;

    // Mobile UI state
    private bool showMobileFilters = false;
    private bool showMobileSearch = false;

    private int totalPages => (int)Math.Ceiling(filteredMessages.Count / (double)pageSize);

    protected override async Task OnInitializedAsync()
    {
        // Set view from route parameter
        if (!string.IsNullOrEmpty(ViewMode) && ViewMode.ToLower() == "sent")
        {
            currentView = MessageView.Sent;
        }

        await LoadCurrentUser();
        await LoadMessages();
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
                return;
            }

            currentUser = await AuthService.GetCurrentUserAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading current user: {ex.Message}");
            hasError = true;
            errorMessage = "Failed to load user information.";
        }
    }

    private string GetPageTitle()
    {
        if (currentUser == null) return "Messages";

        var userType = currentUser.UserType switch
        {
            UserType.Admin => "Admin",
            UserType.Doctor => "Doctor",
            UserType.User => "Student",
            _ => "User"
        };

        return $"{userType} - {(currentView == MessageView.Inbox ? "Inbox" : "Sent Messages")}";
    }

    private string GetUserTypeDisplay(UserType? userType)
    {
        return userType switch
        {
            UserType.Admin => "Admin",
            UserType.Doctor => "Doctor",
            UserType.User => "Student",
            _ => "User"
        };
    }

    private string GetUserTypeBadge(UserType? userType)
    {
        return userType switch
        {
            UserType.Admin => "Admin",
            UserType.Doctor => "Dr",
            UserType.User => "Student",
            _ => ""
        };
    }

    private string GetUserTypeBadgeClass(UserType? userType)
    {
        return userType switch
        {
            UserType.Admin => "bg-danger",
            UserType.Doctor => "bg-success",
            UserType.User => "bg-primary",
            _ => "bg-secondary"
        };
    }

    private string GetUserColor(UserType? userType)
    {
        return userType switch
        {
            UserType.Admin => "#dc3545", // Red
            UserType.Doctor => "#28a745", // Green
            UserType.User => "#0d6efd", // Blue
            _ => "#6c757d" // Gray
        };
    }

    private async Task LoadMessages()
    {
        isLoading = true;
        hasError = false;
        errorMessage = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            // Load messages based on current view
            if (currentView == MessageView.Inbox)
            {
                messages = await MessageService.GetInboxAsync() ?? new List<MessageDto>();
                unreadCount = await MessageService.GetUnreadCountAsync();
            }
            else
            {
                messages = await MessageService.GetSentMessagesAsync() ?? new List<MessageDto>();
                unreadCount = 0; // No unread count for sent messages
            }

            totalMessages = messages.Count;

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading messages: {ex.Message}");
            errorMessage = "Failed to load messages. Please try again.";
            hasError = true;
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshData()
    {
        await LoadMessages();
    }

    private void SwitchView(MessageView view)
    {
        if (currentView != view)
        {
            currentView = view;
            LoadMessages();
        }
    }

    private void ToggleView()
    {
        SwitchView(currentView == MessageView.Inbox ? MessageView.Sent : MessageView.Inbox);
    }

    private void FilterTypeChanged(ChangeEventArgs e)
    {
        filterType = e.Value?.ToString();
        ApplyFilters();
    }

    private void FilterDateRangeChanged(ChangeEventArgs e)
    {
        filterDateRange = e.Value?.ToString() ?? "30";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        try
        {
            var query = messages.AsQueryable();

            // Apply search query
            if (!string.IsNullOrEmpty(searchQuery))
            {
                var search = searchQuery.ToLower();
                query = query.Where(m =>
                    (currentView == MessageView.Inbox && m.Sender != null && (
                        (m.Sender.FirstName != null && m.Sender.FirstName.ToLower().Contains(search)) ||
                        (m.Sender.LastName != null && m.Sender.LastName.ToLower().Contains(search)) ||
                        (m.Sender.Email != null && m.Sender.Email.ToLower().Contains(search))
                    )) ||
                    (currentView == MessageView.Sent && m.Recipient != null && (
                        (m.Recipient.FirstName != null && m.Recipient.FirstName.ToLower().Contains(search)) ||
                        (m.Recipient.LastName != null && m.Recipient.LastName.ToLower().Contains(search)) ||
                        (m.Recipient.Email != null && m.Recipient.Email.ToLower().Contains(search))
                    )) ||
                    (m.Subject != null && m.Subject.ToLower().Contains(search)) ||
                    (m.Content != null && m.Content.ToLower().Contains(search))
                );
            }

            // Apply type filter
            if (!string.IsNullOrEmpty(filterType))
            {
                switch (filterType)
                {
                    case "unread":
                        if (currentView == MessageView.Inbox)
                            query = query.Where(m => !m.IsRead);
                        break;
                    case "read":
                        if (currentView == MessageView.Inbox)
                            query = query.Where(m => m.IsRead);
                        break;
                    case "urgent":
                        query = query.Where(m => m.IsUrgent);
                        break;
                    case "with-attachments":
                        query = query.Where(m => m.Attachments != null && m.Attachments.Any());
                        break;
                }
            }

            // Apply date range filter
            if (filterDateRange != "all" && int.TryParse(filterDateRange, out int days))
            {
                var startDate = DateTime.UtcNow.AddDays(-days);
                query = query.Where(m => m.SentDate >= startDate);
            }

            filteredMessages = query
                .OrderByDescending(m => m.IsUrgent)
                .ThenByDescending(m => m.SentDate)
                .ToList();

            currentPage = 1;
            showMobileFilters = false;
            showMobileSearch = false;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error applying filters: {ex.Message}");
            filteredMessages = messages.ToList();
        }
    }

    private void ClearFilters()
    {
        searchQuery = "";
        filterType = "";
        filterDateRange = "30";
        ApplyFilters();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrEmpty(searchQuery) ||
               !string.IsNullOrEmpty(filterType) ||
               filterDateRange != "30";
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void ChangePageSize(int size)
    {
        pageSize = size;
        currentPage = 1;
        StateHasChanged();
    }

    private IEnumerable<MessageDto> GetCurrentPageItems()
    {
        return filteredMessages
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);
    }

    private void ViewMessage(int id)
    {
        Navigation.NavigateTo($"/messages/view/{id}");
    }

    private void ReplyToMessage(MessageDto message)
    {
        Navigation.NavigateTo($"/messages/compose?userId={message.SenderId}&replyTo={message.Id}");
    }

    private void ComposeMessage()
    {
        Navigation.NavigateTo("/messages/compose");
    }

    private async Task DeleteMessage(int id)
    {
        try
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this message?");
            if (confirmed)
            {
                var result = await MessageService.DeleteMessageAsync(id);
                if (result)
                {
                    await LoadMessages();
                    await JS.InvokeVoidAsync("showToast", "success", "Message deleted successfully!");
                }
                else
                {
                    await JS.InvokeVoidAsync("showToast", "error", "Failed to delete message.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting message: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", "An error occurred while deleting the message.");
        }
    }

    private async Task MarkAllAsRead()
    {
        try
        {
            if (currentView != MessageView.Inbox)
                return;

            var confirmed = await JS.InvokeAsync<bool>("confirm", "Mark all messages as read?");
            if (confirmed)
            {
                var result = await MessageService.MarkAllAsReadAsync();
                if (result)
                {
                    await LoadMessages();
                    await JS.InvokeVoidAsync("showToast", "success", "All messages marked as read!");
                }
                else
                {
                    await JS.InvokeVoidAsync("showToast", "error", "Failed to mark messages as read.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error marking all as read: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", "An error occurred.");
        }
    }

    private async Task ClearAllMessages()
    {
        try
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to clear all {(currentView == MessageView.Inbox ? "inbox" : "sent")} messages? This action cannot be undone.");
            if (confirmed)
            {
                foreach (var message in messages)
                {
                    await MessageService.DeleteMessageAsync(message.Id);
                }
                await LoadMessages();
                await JS.InvokeVoidAsync("showToast", "success", $"All {(currentView == MessageView.Inbox ? "inbox" : "sent")} messages cleared!");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error clearing messages: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", "An error occurred while clearing messages.");
        }
    }

    private void GoBack()
    {
        if (currentUser?.UserType == UserType.Admin)
            Navigation.NavigateTo("/admin/dashboard");
        else if (currentUser?.UserType == UserType.Doctor)
            Navigation.NavigateTo("/doctor/dashboard");
        else
            Navigation.NavigateTo("/student/dashboard");
    }

    private void ToggleMobileFilters()
    {
        showMobileFilters = !showMobileFilters;
        showMobileSearch = false;
    }

    private void ToggleSearch()
    {
        showMobileSearch = !showMobileSearch;
        showMobileFilters = false;
    }

    private string GetInitials(string? firstName, string? lastName)
    {
        if (string.IsNullOrEmpty(firstName) && string.IsNullOrEmpty(lastName))
            return "U";

        var first = !string.IsNullOrEmpty(firstName) ? firstName[0].ToString() : "";
        var last = !string.IsNullOrEmpty(lastName) ? lastName[0].ToString() : "";
        return (first + last).ToUpper();
    }

    private string GetMessagePreview(string content, int maxLength = 80)
    {
        if (string.IsNullOrEmpty(content))
            return "";

        if (content.Length <= maxLength)
            return content;

        return content.Substring(0, maxLength) + "...";
    }

    private string FormatDate(DateTime date)
    {
        var now = DateTime.UtcNow;
        var today = now.Date;
        var yesterday = today.AddDays(-1);
        var messageDate = date.Date;

        if (messageDate == today)
            return date.ToString("hh:mm tt");
        if (messageDate == yesterday)
            return "Yesterday";
        if (messageDate >= today.AddDays(-6))
            return date.ToString("dddd");

        return date.ToString("MMM dd, yyyy");
    }
}
