@page "/messages"
@page "/messages/{ViewMode?}"

<PageTitle>@GetPageTitle()</PageTitle>

<div class="messages-page">
    <!-- Loading Overlay -->
    @if (isLoading)
    {
        <div class="position-fixed top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-flex justify-content-center align-items-center" style="z-index: 9999;">
            <div class="text-center">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="mt-3">Loading messages...</h5>
            </div>
        </div>
    }

    <!-- Mobile Header -->
    <div class="d-block d-md-none mb-3">
        <div class="bg-primary text-white p-3">
            <div class="d-flex align-items-center">
                <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                    <i class="fas fa-arrow-left fa-lg"></i>
                </button>
                <div class="flex-grow-1">
                    <h5 class="mb-0">@GetPageTitle()</h5>
                    <small>@filteredMessages.Count of @totalMessages messages</small>
                </div>
                <div class="dropdown">
                    <button class="btn btn-link text-white p-0" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-ellipsis-v fa-lg"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button class="dropdown-item" @onclick="ToggleView">
                                <i class="fas @(currentView == MessageView.Inbox ? "fa-paper-plane" : "fa-inbox") me-2"></i>
                                Switch to @(currentView == MessageView.Inbox ? "Sent" : "Inbox")
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" @onclick="MarkAllAsRead" disabled="@(currentView != MessageView.Inbox)">
                                <i class="fas fa-check-double me-2"></i>Mark all as read
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" @onclick="RefreshData">
                                <i class="fas fa-sync-alt me-2"></i>Refresh
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button class="dropdown-item text-danger" @onclick="ClearAllMessages">
                                <i class="fas fa-trash-alt me-2"></i>Clear all
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Desktop Header -->
    <div class="container-fluid py-4">
        <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>@GetPageTitle()</h1>
                <p class="text-muted">
                    @if (currentView == MessageView.Inbox)
                    {
                        <span>@unreadCount unread messages</span>
                    }
                    else
                    {
                        <span>@totalMessages sent messages</span>
                    }
                    <span class="mx-2">•</span>
                    <span>@totalMessages total messages</span>
                </p>
            </div>
            <div class="d-flex gap-2">
                <div class="btn-group me-2">
                    <button class="btn @(currentView == MessageView.Inbox ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => SwitchView(MessageView.Inbox)">
                        <i class="fas fa-inbox me-2"></i> Inbox
                        @if (unreadCount > 0 && currentView == MessageView.Inbox)
                        {
                            <span class="badge bg-light text-primary ms-2">@unreadCount</span>
                        }
                    </button>
                    <button class="btn @(currentView == MessageView.Sent ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => SwitchView(MessageView.Sent)">
                        <i class="fas fa-paper-plane me-2"></i> Sent
                    </button>
                </div>
                <button class="btn btn-primary" @onclick="ComposeMessage">
                    <i class="fas fa-pen me-2"></i> Compose
                </button>
                <div class="btn-group">
                    <button class="btn btn-outline-secondary" @onclick="MarkAllAsRead"
                            disabled="@(currentView != MessageView.Inbox)" title="Mark all as read">
                        <i class="fas fa-check-double"></i>
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="RefreshData" title="Refresh">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- View Tabs for Mobile -->
        <div class="d-block d-md-none px-3 mb-3">
            <div class="btn-group w-100">
                <button class="btn @(currentView == MessageView.Inbox ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SwitchView(MessageView.Inbox)">
                    <i class="fas fa-inbox me-2"></i> Inbox
                    @if (unreadCount > 0)
                    {
                        <span class="badge bg-light text-primary ms-2">@unreadCount</span>
                    }
                </button>
                <button class="btn @(currentView == MessageView.Sent ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SwitchView(MessageView.Sent)">
                    <i class="fas fa-paper-plane me-2"></i> Sent
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading messages...</p>
            </div>
        }
        else if (hasError)
        {
            <div class="alert alert-danger m-3 m-md-0">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
                <button class="btn btn-sm btn-outline-danger ms-3" @onclick="LoadMessages">
                    <i class="fas fa-redo me-1"></i> Retry
                </button>
            </div>
        }
        else
        {
            <!-- Mobile Filter Bar -->
            <div class="d-block d-md-none mb-3 px-3">
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary flex-grow-1" @onclick="ToggleMobileFilters">
                        <i class="fas fa-filter me-2"></i>Filters
                        @if (HasActiveFilters())
                        {
                            <span class="badge bg-primary ms-2">!</span>
                        }
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ToggleSearch">
                        <i class="fas fa-search"></i>
                    </button>
                </div>

                <!-- Mobile Filters Panel -->
                @if (showMobileFilters)
                {
                    <div class="card mt-3">
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label small">Filter by</label>
                                <select class="form-select form-select-sm" @onchange="FilterTypeChanged">
                                    <option value="">All Messages</option>
                                    @if (currentView == MessageView.Inbox)
                                    {
                                        <option value="unread">Unread Only</option>
                                        <option value="read">Read Only</option>
                                    }
                                    <option value="urgent">Urgent</option>
                                    <option value="with-attachments">With Attachments</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small">Date Range</label>
                                <select class="form-select form-select-sm" @onchange="FilterDateRangeChanged">
                                    <option value="7">Last 7 Days</option>
                                    <option value="30" selected>Last 30 Days</option>
                                    <option value="90">Last 90 Days</option>
                                    <option value="all">All Time</option>
                                </select>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary flex-grow-1" @onclick="ApplyFilters">
                                    Apply Filters
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="ClearFilters">
                                    Clear
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Mobile Search Panel -->
                @if (showMobileSearch)
                {
                    <div class="card mt-3">
                        <div class="card-body">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Search messages..."
                                       @bind="searchQuery" @bind:event="oninput" />
                                <button class="btn btn-primary" type="button" @onclick="ApplyFilters">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Desktop Filters -->
            <div class="d-none d-md-block card mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Filter by</label>
                            <select class="form-select" @onchange="FilterTypeChanged">
                                <option value="">All Messages</option>
                                @if (currentView == MessageView.Inbox)
                                {
                                    <option value="unread">Unread Only</option>
                                    <option value="read">Read Only</option>
                                }
                                <option value="urgent">Urgent</option>
                                <option value="with-attachments">With Attachments</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Date Range</label>
                            <select class="form-select" @onchange="FilterDateRangeChanged">
                                <option value="7">Last 7 Days</option>
                                <option value="30" selected>Last 30 Days</option>
                                <option value="90">Last 90 Days</option>
                                <option value="all">All Time</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Search</label>
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Search by sender, subject, or content..."
                                       @bind="searchQuery" @bind:event="oninput" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="ApplyFilters">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">
                                <i class="fas fa-times me-2"></i>Clear
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Messages List -->
            @if (filteredMessages.Any())
            {
                <!-- Mobile View -->
                <div class="d-block d-md-none">
                    @foreach (var message in GetCurrentPageItems())
                    {
                        var displayUser = currentView == MessageView.Inbox ? message.Sender : message.Recipient;
                        var userTypeBadge = GetUserTypeBadge(displayUser?.UserType);

                        <div class="message-card @(message.IsRead && currentView == MessageView.Inbox ? "" : "unread") @(message.IsUrgent ? "urgent" : "")"
                             @onclick="() => ViewMessage(message.Id)">
                            <div class="d-flex align-items-start gap-2">
                                <!-- Avatar -->
                                <div class="avatar-sm flex-shrink-0">
                                    @if (displayUser != null && !string.IsNullOrEmpty(displayUser.ProfileImageUrl))
                                    {
                                        <img src="@displayUser.ProfileImageUrl"
                                             class="rounded-circle" width="48" height="48"
                                             alt="@displayUser.FirstName @displayUser.LastName"
                                             onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
                                    }
                                    else
                                    {
                                        <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center"
                                             style="width: 48px; height: 48px; font-size: 1.2rem; background-color: @GetUserColor(displayUser?.UserType); color: white;">
                                            @GetInitials(displayUser?.FirstName, displayUser?.LastName)
                                        </div>
                                    }
                                    @if (message.IsUrgent)
                                    {
                                        <span class="urgent-badge">
                                            <i class="fas fa-exclamation-circle"></i>
                                        </span>
                                    }
                                </div>

                                <!-- Message Content -->
                                <div class="flex-grow-1 min-width-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong class="@(message.IsRead && currentView == MessageView.Inbox ? "" : "fw-bold")">
                                                @{
                                                    var name = currentView == MessageView.Inbox
                                                    ? $"{message.Sender?.FirstName} {message.Sender?.LastName}"
                                                    : $"To: {message.Recipient?.FirstName} {message.Recipient?.LastName}";
                                                }
                                                @name
                                            </strong>
                                            @if (!string.IsNullOrEmpty(userTypeBadge))
                                            {
                                                <span class="badge @GetUserTypeBadgeClass(displayUser?.UserType) ms-1">@userTypeBadge</span>
                                            }
                                        </div>
                                        <small class="text-muted text-nowrap ms-2">
                                            @FormatDate(message.SentDate)
                                        </small>
                                    </div>

                                    <div class="message-subject mt-1">
                                        <strong>@(message.Subject ?? "(No Subject)")</strong>
                                        @if (currentView == MessageView.Sent)
                                        {
                                            <span class="badge bg-secondary ms-1">
                                                <i class="fas @(message.IsRead ? "fa-check-circle" : "fa-clock")"></i>
                                                @(message.IsRead ? "Read" : "Sent")
                                            </span>
                                        }
                                    </div>

                                    <div class="message-preview text-muted small">
                                        @GetMessagePreview(message.Content)
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <div>
                                            @if (!message.IsRead && currentView == MessageView.Inbox)
                                            {
                                                <span class="badge bg-primary">New</span>
                                            }
                                            @if (message.Attachments != null && message.Attachments.Any())
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="fas fa-paperclip me-1"></i>@message.Attachments.Count
                                                </span>
                                            }
                                            @if (message.IsUrgent)
                                            {
                                                <span class="badge bg-danger">Urgent</span>
                                            }
                                        </div>
                                        <div class="btn-group btn-group-sm" @onclick:stopPropagation="true">
                                            @if (currentView == MessageView.Inbox)
                                            {
                                                <button class="btn btn-outline-primary"
                                                        @onclick="() => ReplyToMessage(message)"
                                                        title="Reply">
                                                    <i class="fas fa-reply"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-info"
                                                        @onclick="() => ViewMessage(message.Id)"
                                                        title="View">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                            }
                                            <button class="btn btn-outline-danger"
                                                    @onclick="() => DeleteMessage(message.Id)"
                                                    title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Desktop Table View -->
                <div class="d-none d-md-block card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@(currentView == MessageView.Inbox ? "Inbox" : "Sent Messages")</h5>
                        <div>
                            <span class="text-muted me-3">
                                @((currentPage - 1) * pageSize + 1)-@Math.Min(currentPage * pageSize, filteredMessages.Count) of @filteredMessages.Count
                            </span>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary @(pageSize == 10 ? "active" : "")" @onclick="() => ChangePageSize(10)">10</button>
                                <button class="btn btn-outline-secondary @(pageSize == 25 ? "active" : "")" @onclick="() => ChangePageSize(25)">25</button>
                                <button class="btn btn-outline-secondary @(pageSize == 50 ? "active" : "")" @onclick="() => ChangePageSize(50)">50</button>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 40px"></th>
                                    <th>@(currentView == MessageView.Inbox ? "Sender" : "Recipient")</th>
                                    <th>Subject</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th style="width: 120px">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var message in GetCurrentPageItems())
                                {
                                    var displayUser = currentView == MessageView.Inbox ? message.Sender : message.Recipient;
                                    <tr class="@(message.IsRead && currentView == MessageView.Inbox ? "" : "table-active fw-bold") @(message.IsUrgent ? "table-danger" : "")"
                                        @onclick="() => ViewMessage(message.Id)" style="cursor: pointer;">
                                        <td>
                                            @if (!message.IsRead && currentView == MessageView.Inbox)
                                            {
                                                <span class="badge bg-primary rounded-pill" title="Unread">●</span>
                                            }
                                            @if (message.IsUrgent)
                                            {
                                                <span class="badge bg-danger" title="Urgent">!</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm me-2">
                                                    @if (displayUser != null && !string.IsNullOrEmpty(displayUser.ProfileImageUrl))
                                                    {
                                                        <img src="@displayUser.ProfileImageUrl"
                                                             class="rounded-circle" width="32" height="32"
                                                             alt="@displayUser.FirstName @displayUser.LastName"
                                                             onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
                                                    }
                                                    else
                                                    {
                                                        <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center"
                                                             style="width: 32px; height: 32px; background-color: @GetUserColor(displayUser?.UserType); color: white;">
                                                            @GetInitials(displayUser?.FirstName, displayUser?.LastName)
                                                        </div>
                                                    }
                                                </div>
                                                <div>
                                                    <span>@displayUser?.FirstName @displayUser?.LastName</span>
                                                    @if (displayUser?.UserType != null)
                                                    {
                                                        <br />
                                                        <small class="text-muted">@GetUserTypeDisplay(displayUser.UserType)</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div>
                                                <strong>@(message.Subject ?? "(No Subject)")</strong>
                                                <br />
                                                <small class="text-muted">@GetMessagePreview(message.Content, 60)</small>
                                            </div>
                                            @if (message.Attachments != null && message.Attachments.Any())
                                            {
                                                <small class="text-muted">
                                                    <i class="fas fa-paperclip me-1"></i>@message.Attachments.Count
                                                </small>
                                            }
                                        </td>
                                        <td>
                                            @message.SentDate.ToString("MMM dd, yyyy")
                                            <br />
                                            <small class="text-muted">@message.SentDate.ToString("hh:mm tt")</small>
                                        </td>
                                        <td>
                                            @if (currentView == MessageView.Inbox)
                                            {
                                                if (message.IsRead)
                                                {
                                                    <span class="badge bg-secondary">Read</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary">New</span>
                                                }
                                            }
                                            else
                                            {
                                                if (message.IsRead)
                                                {
                                                    <span class="badge bg-success">Read @(message.ReadDate?.ToString("MMM dd") ?? "")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">Sent</span>
                                                }
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" @onclick:stopPropagation="true">
                                                @if (currentView == MessageView.Inbox)
                                                {
                                                    <button class="btn btn-outline-primary"
                                                            @onclick="() => ReplyToMessage(message)"
                                                            title="Reply">
                                                        <i class="fas fa-reply"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-info"
                                                            @onclick="() => ViewMessage(message.Id)"
                                                            title="View">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                }
                                                <button class="btn btn-outline-danger"
                                                        @onclick="() => DeleteMessage(message.Id)"
                                                        title="Delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (totalPages > 1)
                    {
                        <div class="card-footer">
                            <nav aria-label="Message pagination">
                                <ul class="pagination justify-content-center mb-0">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">
                                            <i class="fas fa-chevron-left"></i>
                                        </button>
                                    </li>

                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        @if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                                        {
                                            <li class="page-item @(i == currentPage ? "active" : "")">
                                                <button class="page-link" @onclick="() => ChangePage(i)">
                                                    @i
                                                </button>
                                            </li>
                                        }
                                        else if (i == currentPage - 3 || i == currentPage + 3)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                    }

                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">
                                            <i class="fas fa-chevron-right"></i>
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5">
                    <div class="empty-state-icon mb-4">
                        <i class="fas fa-envelope-open-text fa-4x text-muted"></i>
                    </div>
                    <h3>No Messages @(currentView == MessageView.Inbox ? "In Inbox" : "Sent")</h3>
                    <p class="text-muted mb-4">
                        @if (HasActiveFilters())
                        {
                            <span>No messages match your current filters.</span>
                        }
                        else if (currentView == MessageView.Inbox)
                        {
                            <span>Your inbox is empty. When other users message you, they'll appear here.</span>
                        }
                        else
                        {
                            <span>You haven't sent any messages yet.</span>
                        }
                    </p>
                    @if (HasActiveFilters())
                    {
                        <button class="btn btn-outline-primary" @onclick="ClearFilters">
                            <i class="fas fa-times me-2"></i> Clear Filters
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="ComposeMessage">
                            <i class="fas fa-pen me-2"></i> Compose Message
                        </button>
                    }
                </div>
            }
        }
    </div>
</div>

<style>
    .messages-page {
        min-height: 100vh;
        background-color: #f8f9fc;
    }

    .message-card {
        background: white;
        border: 1px solid #eef2f6;
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 0.75rem;
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .message-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            border-color: #cbd5e1;
        }

        .message-card.unread {
            background: #f0f7ff;
            border-color: #0d6efd;
        }

        .message-card.urgent {
            border-left: 4px solid #dc3545;
        }

    .avatar-placeholder {
        font-weight: 600;
    }

    .urgent-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        background: #dc3545;
        color: white;
        border-radius: 50%;
        width: 18px;
        height: 18px;
        font-size: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
    }

    .avatar-sm {
        position: relative;
        width: 48px;
        height: 48px;
    }

    .min-width-0 {
        min-width: 0;
    }

    .message-subject {
        font-size: 0.95rem;
        white-space: nowrap;
        overflow: hidden;
