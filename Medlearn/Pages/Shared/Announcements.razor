

<style>
    /* Announcements Section Styles - Professional News/Announcements Design */
    .announcements-section {
        background: #ffffff;
        border-radius: 24px;
        padding: 2rem;
        margin: 2rem 0;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
        border: 1px solid #eef2f6;
    }

    /* Section Header */
    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .header-icon {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, #f5f7ff 0%, #eef2ff 100%);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4f46e5;
        font-size: 1.5rem;
    }

    .header-title h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 0.25rem 0;
    }

    .header-title p {
        font-size: 0.875rem;
        color: #64748b;
        margin: 0;
    }

    .header-badge {
        background: #f1f5f9;
        color: #475569;
        padding: 0.5rem 1rem;
        border-radius: 100px;
        font-size: 0.875rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .header-badge i {
            color: #4f46e5;
        }

    /* Announcement Cards - Grid Layout */
    .announcements-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    /* Announcement Card */
    .announcement-card {
        background: #ffffff;
        border: 1px solid #eef2f6;
        border-radius: 20px;
        padding: 1.5rem;
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .announcement-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 30px -10px rgba(79, 70, 229, 0.15);
            border-color: #cbd5e1;
        }

    /* Card Badges - Fixed with proper colors and Bootstrap override */
    .card-badges {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .badge {
        padding: 0.25rem 0.75rem;
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        /* Override Bootstrap's default */
        color: inherit !important;
        background-color: transparent !important;
    }

    .badge-important {
        background: #fef2f2 !important;
        color: #dc2626 !important;
        border: 1px solid #fee2e2;
    }

    .badge-new {
        background: #ecfdf5 !important;
        color: #059669 !important;
        border: 1px solid #d1fae5;
    }

    .badge-official {
        background: #eff6ff !important;
        color: #2563eb !important;
        border: 1px solid #dbeafe;
    }

    .badge-target {
        background: #f8fafc !important;
        color: #475569 !important;
        border: 1px solid #e2e8f0;
    }

    /* Card Content */
    .card-title {
        font-size: 1.125rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 0.75rem 0;
        line-height: 1.4;
    }

    .card-excerpt {
        font-size: 0.875rem;
        color: #64748b;
        line-height: 1.6;
        margin: 0 0 1.5rem 0;
        flex-grow: 1;
    }

    /* Card Footer */
    .card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1rem;
        border-top: 1px solid #eef2f6;
    }

    .card-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        color: #94a3b8;
        font-size: 0.75rem;
    }

        .meta-item i {
            font-size: 0.875rem;
        }

    .read-more-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .read-more-btn:hover {
            background: #4f46e5;
            color: white;
            border-color: #4f46e5;
        }

    /* Compact Mode Styles */
    .announcements-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .announcement-list-item {
        background: #ffffff;
        border: 1px solid #eef2f6;
        border-radius: 16px;
        padding: 1rem;
        transition: all 0.3s ease;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .announcement-list-item:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
        }

    .list-item-icon {
        width: 40px;
        height: 40px;
        background: #f1f5f9;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4f46e5;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .list-item-content {
        flex: 1;
        min-width: 0;
    }

    .list-item-title {
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .list-item-excerpt {
        font-size: 0.813rem;
        color: #64748b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .list-item-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 0.25rem;
    }

    .list-meta-item {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        color: #94a3b8;
        font-size: 0.688rem;
    }

    /* Mobile Styles */
    @@media (max-width: 768px) {
        .announcements-section {
            padding: 1.5rem;
            border-radius: 20px;
            margin: 1.5rem 0;
        }

        .section-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .announcements-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .header-badge {
            align-self: flex-start;
        }

        .card-footer {
            flex-wrap: wrap;
            gap: 1rem;
        }
    }

    @@media (min-width: 769px) and (max-width: 1024px) {
        .announcements-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* Loading State */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        background: #f8fafc;
        border-radius: 20px;
    }

    .loading-spinner {
        width: 48px;
        height: 48px;
        border: 3px solid #e2e8f0;
        border-top-color: #4f46e5;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 1rem;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: #f8fafc;
        border-radius: 20px;
    }

    .empty-icon {
        width: 80px;
        height: 80px;
        background: #eef2ff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        color: #4f46e5;
        font-size: 2rem;
    }

    .empty-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 0.5rem;
    }

    .empty-description {
        color: #64748b;
        font-size: 0.938rem;
        max-width: 400px;
        margin: 0 auto 1.5rem;
    }

    /* View All Button */
    .view-all-container {
        text-align: center;
        margin-top: 2rem;
    }

    .view-all-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #ffffff;
        color: #4f46e5;
        padding: 0.75rem 2rem;
        border-radius: 100px;
        font-weight: 600;
        font-size: 0.938rem;
        border: 1px solid #e2e8f0;
        transition: all 0.3s ease;
        text-decoration: none;
        cursor: pointer;
    }

        .view-all-btn:hover {
            background: #4f46e5;
            color: white;
            border-color: #4f46e5;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.3);
        }

    /* Featured Image (Optional) */
    .card-image {
        margin: -1.5rem -1.5rem 1rem -1.5rem;
        border-radius: 20px 20px 0 0;
        overflow: hidden;
        height: 160px;
        background: #f1f5f9;
    }

        .card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .announcement-card:hover .card-image img {
        transform: scale(1.05);
    }

    .image-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        opacity: 0.8;
    }

    /* Admin Create Button */
    .admin-create-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #4f46e5;
        color: white;
        padding: 0.5rem 1.25rem;
        border-radius: 100px;
        font-size: 0.875rem;
        font-weight: 600;
        border: none;
        transition: all 0.3s ease;
        text-decoration: none;
        margin-top: 1rem;
    }

        .admin-create-btn:hover {
            background: #4338ca;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px -5px rgba(79, 70, 229, 0.4);
        }

    /* Badge text color fixes for compact mode */
    .compact-list .badge {
        color: inherit !important;
    }
</style>

@* Parameters *@
@code {
    [Parameter] public bool ShowOnlyImportant { get; set; } = false;
    [Parameter] public int? MaxItems { get; set; }
    [Parameter] public bool CompactMode { get; set; } = false;
    [Parameter] public bool ShowImages { get; set; } = false;
    [Parameter] public string Title { get; set; } = "Announcements & Updates";
    [Parameter] public string Subtitle { get; set; } = "Stay informed with the latest news and updates from our platform";
}

<div class="announcements-section">
    <!-- Section Header -->
    <div class="section-header">
        <div class="header-left">
            <div class="header-icon">
                <i class="fas fa-bullhorn"></i>
            </div>
            <div class="header-title">
                <h2>@Title</h2>
                <p>@Subtitle</p>
            </div>
        </div>
        @if (filteredAnnouncements.Any())
        {
            <div class="header-badge">
                <i class="fas fa-newspaper"></i>
                <span>@filteredAnnouncements.Count Announcements</span>
            </div>
        }
    </div>

    @if (isLoading)
    {
        <!-- Loading State -->
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <p style="color: #64748b; margin: 0;">Loading announcements...</p>
        </div>
    }
    else if (!filteredAnnouncements.Any())
    {
        <!-- Empty State -->
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-newspaper"></i>
            </div>
            <h3 class="empty-title">No Announcements Yet</h3>
            <p class="empty-description">Check back soon for important updates and news from our team.</p>
            @if (isAdmin)
            {
                <a href="/admin/announcements/create" class="admin-create-btn">
                    <i class="fas fa-plus"></i>
                    Create First Announcement
                </a>
            }
        </div>
    }
    else if (CompactMode)
    {
        <!-- Compact List View -->
        <div class="announcements-list">
            @foreach (var announcement in filteredAnnouncements.Take(MaxItems ?? 5))
            {
                var badges = GetBadges(announcement);

                <div class="announcement-list-item" @onclick="() => ViewAnnouncement(announcement.Id)">
                    <div class="list-item-icon">
                        @if (announcement.IsImportant)
                        {
                            <i class="fas fa-exclamation-circle" style="color: #dc2626;"></i>
                        }
                        else
                        {
                            <i class="fas fa-bullhorn"></i>
                        }
                    </div>

                    <div class="list-item-content">
                        <div class="list-item-title">
                            @announcement.Title
                            <div class="badge-container" style="display: inline-flex; gap: 0.25rem; flex-wrap: wrap;">
                                @foreach (var badge in badges)
                                {
                                    <span class="badge @badge.Class">
                                        @if (badge.Icon != null)
                                        {
                                            <i class="@badge.Icon me-1"></i>
                                        }
                                        @badge.Text
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="list-item-excerpt">
                            @GetPreviewText(announcement.Content, 80)
                        </div>

                        <div class="list-item-meta">
                            <span class="list-meta-item">
                                <i class="far fa-calendar"></i>
                                @FormatDate(announcement.CreatedAt)
                            </span>
                            @if (announcement.CreatedByAdmin != null)
                            {
                                <span class="list-meta-item">
                                    <i class="far fa-user-circle"></i>
                                    @announcement.CreatedByAdmin.FirstName
                                </span>
                            }
                        </div>
                    </div>

                    <div class="read-more-btn">
                        <i class="fas fa-chevron-right"></i>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Grid/Card View -->
        <div class="announcements-grid">
            @foreach (var announcement in filteredAnnouncements.Take(MaxItems ?? 3))
            {
                var badges = GetBadges(announcement);

                <div class="announcement-card" @onclick="() => ViewAnnouncement(announcement.Id)">
                    <!-- Optional Image -->
                    @if (ShowImages && !string.IsNullOrEmpty(announcement.ThumbnailUrl))
                    {
                        <div class="card-image">
                            <img src="@announcement.ThumbnailUrl" alt="@announcement.Title" />
                        </div>
                    }
                    else if (ShowImages)
                    {
                        <div class="card-image">
                            <div class="image-placeholder">
                                <i class="fas fa-newspaper"></i>
                            </div>
                        </div>
                    }

                    <!-- Badges -->
                    <div class="card-badges">
                        @foreach (var badge in badges)
                        {
                            <span class="badge @badge.Class">
                                @if (badge.Icon != null)
                                {
                                    <i class="@badge.Icon me-1"></i>
                                }
                                @badge.Text
                            </span>
                        }
                    </div>

                    <!-- Content -->
                    <h3 class="card-title">@announcement.Title</h3>
                    <p class="card-excerpt">@GetPreviewText(announcement.Content, 120)</p>

                    <!-- Footer -->
                    <div class="card-footer">
                        <div class="card-meta">
                            <span class="meta-item">
                                <i class="far fa-calendar-alt"></i>
                                @FormatDate(announcement.CreatedAt)
                            </span>
                            @if (announcement.CreatedByAdmin != null)
                            {
                                <span class="meta-item">
                                    <i class="far fa-user"></i>
                                    @announcement.CreatedByAdmin.FirstName
                                </span>
                            }
                        </div>

                        <div class="read-more-btn">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- View All Link -->
    @if (filteredAnnouncements.Count > (MaxItems ?? 3))
    {
        <div class="view-all-container">
            <a href="/announcements" class="view-all-btn">
                <span>View All Announcements</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    }
</div>

@code {
    private List<AnnouncementDto> announcements = new();
    private List<AnnouncementDto> filteredAnnouncements = new();
    private bool isLoading = true;
    private UserDto? currentUser;
    private bool isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadAnnouncements();
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser != null)
            {
                isAdmin = currentUser.UserType == UserType.Admin;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading current user: {ex.Message}");
        }
    }

    private async Task LoadAnnouncements()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await AnnouncementService.GetAnnouncementsAsync(
                important: ShowOnlyImportant ? true : null,
                activeOnly: true
            );

            if (result != null)
            {
                announcements = result;
                filteredAnnouncements = FilterAnnouncementsByUser(announcements)
                    .OrderByDescending(a => a.IsImportant)
                    .ThenByDescending(a => a.CreatedAt)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading announcements: {ex.Message}");
            announcements = new List<AnnouncementDto>();
            filteredAnnouncements = new List<AnnouncementDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private List<AnnouncementDto> FilterAnnouncementsByUser(List<AnnouncementDto> allAnnouncements)
    {
        if (currentUser == null)
        {
            return allAnnouncements.Where(a => a.ForAllUsers).ToList();
        }

        return allAnnouncements.Where(announcement =>
        {
            if (announcement.ForAllUsers) return true;
            if (currentUser.UserType == UserType.Doctor && announcement.ForDoctorsOnly) return true;
            if (currentUser.UserType == UserType.User && announcement.ForRegularUsersOnly) return true;
            if (currentUser.UserType == UserType.Admin) return true;
            return false;
        }).ToList();
    }

    private List<(string Text, string Class, string? Icon)> GetBadges(AnnouncementDto announcement)
    {
        var badges = new List<(string, string, string?)>();

        if (announcement.IsImportant)
        {
            badges.Add(("Important", "badge-important", "fas fa-exclamation-circle"));
        }

        if (announcement.CreatedAt > DateTime.UtcNow.AddDays(-2))
        {
            badges.Add(("New", "badge-new", "fas fa-star"));
        }

        if (announcement.ForAllUsers)
        {
            badges.Add(("All Users", "badge-target", "fas fa-users"));
        }
        else if (announcement.ForDoctorsOnly)
        {
            badges.Add(("Doctors", "badge-target", "fas fa-user-md"));
        }
        else if (announcement.ForRegularUsersOnly)
        {
            badges.Add(("Students", "badge-target", "fas fa-user-graduate"));
        }

        return badges;
    }

    private string GetPreviewText(string content, int maxLength = 100)
    {
        if (string.IsNullOrEmpty(content))
            return "No content available.";

        var plainText = System.Text.RegularExpressions.Regex.Replace(content, "<.*?>", string.Empty);

        if (plainText.Length <= maxLength)
            return plainText;

        return plainText.Substring(0, maxLength) + "...";
    }

    private string FormatDate(DateTime date)
    {
        var now = DateTime.UtcNow;
        var diff = now - date;

        if (diff.TotalDays < 1)
            return "Today";
        if (diff.TotalDays < 2)
            return "Yesterday";
        if (diff.TotalDays < 7)
            return $"{diff.TotalDays:F0} days ago";

        return date.ToString("MMM dd, yyyy");
    }

    private void ViewAnnouncement(int id)
    {
        Navigation.NavigateTo($"/announcements/{id}");
    }
}
