@page "/messages/compose"


<PageTitle>@GetPageTitle()</PageTitle>

<div class="compose-page">
    <!-- Loading Overlay -->
    @if (isLoading)
    {
        <div class="position-fixed top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-flex justify-content-center align-items-center" style="z-index: 9999;">
            <div class="text-center">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="mt-3">Loading...</h5>
            </div>
        </div>
    }

    <!-- Mobile Header -->
    <div class="d-block d-md-none mb-3">
        <div class="bg-primary text-white p-3">
            <div class="d-flex align-items-center">
                <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                    <i class="fas fa-arrow-left fa-lg"></i>
                </button>
                <div class="flex-grow-1">
                    <h5 class="mb-0">@GetPageTitle()</h5>
                </div>
                <button class="btn btn-link text-white p-0" @onclick="SendMessage" disabled="@(!CanSend)">
                    <i class="fas fa-paper-plane fa-lg"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Desktop Header -->
    <div class="container-fluid py-4">
        <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
            <h1>@GetPageTitle()</h1>
            <div>
                <button class="btn btn-outline-secondary me-2" @onclick="GoBack">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button class="btn btn-primary" @onclick="SendMessage" disabled="@(!CanSend)">
                    <i class="fas fa-paper-plane me-2"></i>Send Message
                </button>
            </div>
        </div>

        <!-- Original Message (for replies) -->
        @if (originalMessage != null)
        {
            <div class="card mb-4 bg-light">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-reply me-2"></i>
                        Replying to message
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3">
                        <div class="avatar-sm">
                            @if (originalMessage.Sender != null && !string.IsNullOrEmpty(originalMessage.Sender.ProfileImageUrl))
                            {
                                <img src="@originalMessage.Sender.ProfileImageUrl" class="rounded-circle" width="40" height="40" />
                            }
                            else
                            {
                                <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center"
                                     style="width: 40px; height: 40px; background-color: @GetUserColor(originalMessage.Sender?.UserType); color: white;">
                                    @GetInitials(originalMessage.Sender?.FirstName, originalMessage.Sender?.LastName)
                                </div>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                                <strong>@originalMessage.Sender?.FirstName @originalMessage.Sender?.LastName</strong>
                                <small class="text-muted">@originalMessage.SentDate.ToString("MMM dd, yyyy hh:mm tt")</small>
                            </div>
                            <div class="mt-2 p-3 bg-white rounded border">
                                @if (!string.IsNullOrEmpty(originalMessage.Subject))
                                {
                                    <div class="fw-bold mb-2">Subject: @originalMessage.Subject</div>
                                }
                                <div class="original-content">
                                    @GetMessagePreview(originalMessage.Content, 200)
                                </div>
                                @if (originalMessage.Content?.Length > 200)
                                {
                                    <button class="btn btn-link btn-sm p-0 mt-2" @onclick="ToggleShowFullOriginal">
                                        @(showFullOriginal ? "Show less" : "Show more")
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Main Form -->
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <!-- Reply Indicator -->
                        @if (ReplyTo.HasValue)
                        {
                            <div class="alert alert-info mb-3">
                                <i class="fas fa-info-circle me-2"></i>
                                Your reply will be sent to @selectedUser?.FirstName @selectedUser?.LastName
                            </div>
                        }

                        <!-- Recipient Selection -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                To <span class="text-danger">*</span>
                                @if (ReplyTo.HasValue)
                                {
                                    <span class="text-muted small ms-2">(Recipient is locked for replies)</span>
                                }
                            </label>
                            @if (selectedUser == null)
                            {
                                <div class="input-group">
                                    <input type="text" class="form-control" 
                                           placeholder="Search for a user by name or email..." 
                                           @bind="searchQuery" 
                                           @bind:event="oninput"
                                           @onkeypress="(e) => HandleKeyPress(e)" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="SearchUsers">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                                
                                @if (isSearching)
                                {
                                    <div class="text-center mt-2">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                                            <span class="visually-hidden">Searching...</span>
                                        </div>
                                        <span class="ms-2 small">Searching...</span>
                                    </div>
                                }
                                else if (searchResults != null)
                                {
                                    if (searchResults.Any())
                                    {
                                        <div class="search-results mt-2">
                                            @foreach (var user in searchResults)
                                            {
                                                <div class="search-result-item d-flex align-items-center p-2 border-bottom" 
                                                     @onclick="() => SelectUser(user)">
                                                    <div class="avatar-sm me-2">
                                                        @if (!string.IsNullOrEmpty(user.ProfileImageUrl))
                                                        {
                                                            <img src="@user.ProfileImageUrl" class="rounded-circle" width="32" height="32" />
                                                        }
                                                        else
                                                        {
                                                            <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center" 
                                                                 style="width: 32px; height: 32px; background-color: @GetUserColor(user.UserType); color: white;">
                                                                @GetInitials(user.FirstName, user.LastName)
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <strong>@user.FirstName @user.LastName</strong>
                                                        <br/>
                                                        <small class="text-muted">@user.Email</small>
                                                    </div>
                                                    <span class="badge @GetUserTypeBadgeClass(user.UserType)">@GetUserTypeDisplay(user.UserType)</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (!string.IsNullOrEmpty(searchQuery) && searchQuery.Length >= 2)
                                    {
                                        <div class="alert alert-info mt-2 py-2">
                                            <i class="fas fa-info-circle me-2"></i>
                                            No users found matching "@searchQuery"
                                        </div>
                                    }
                                }
                            }
                            else
                            {
                                <div class="selected-recipient d-flex align-items-center p-3 bg-light rounded">
                                    <div class="avatar-sm me-3">
                                        @if (!string.IsNullOrEmpty(selectedUser.ProfileImageUrl))
                                        {
                                            <img src="@selectedUser.ProfileImageUrl" class="rounded-circle" width="40" height="40" />
                                        }
                                        else
                                        {
                                            <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center" 
                                                 style="width: 40px; height: 40px; background-color: @GetUserColor(selectedUser.UserType); color: white;">
                                                @GetInitials(selectedUser.FirstName, selectedUser.LastName)
                                            </div>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <strong>@selectedUser.FirstName @selectedUser.LastName</strong>
                                        <br/>
                                        <small class="text-muted">@selectedUser.Email</small>
                                        <br/>
                                        <small class="text-muted">@GetUserTypeDisplay(selectedUser.UserType)</small>
                                    </div>
                                    @if (!ReplyTo.HasValue)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearRecipient">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Subject -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Subject</label>
                            <input type="text" class="form-control" 
                                   placeholder="Enter subject..." 
                                   @bind="subject"
                                   @bind:event="oninput"
                                   disabled="@(ReplyTo.HasValue)" />
                            @if (ReplyTo.HasValue && !string.IsNullOrEmpty(originalMessage?.Subject))
                            {
                                <small class="text-muted">Replying to: "@originalMessage.Subject"</small>
                            }
                        </div>

                        <!-- Content -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Message <span class="text-danger">*</span></label>
                            <textarea class="form-control" 
                                      rows="8" 
                                      placeholder="Write your message here..." 
                                      @bind="content"
                                      @bind:event="oninput"></textarea>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">@content.Length characters</small>
                                @if (ReplyTo.HasValue && originalMessage != null && !originalMessage.AllowReplies)
                                {
                                    <small class="text-warning">
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        The original message does not allow replies, but you can still send a new message
                                    </small>
                                }
                            </div>
                        </div>

                        <!-- Options -->
                        <div class="mb-3">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="urgentCheck" @bind="isUrgent">
                                <label class="form-check-label" for="urgentCheck">
                                    <i class="fas fa-exclamation-circle text-danger me-1"></i>
                                    Mark as urgent
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="receiptCheck" @bind="requestReadReceipt">
                                <label class="form-check-label" for="receiptCheck">
                                    <i class="fas fa-receipt me-1"></i>
                                    Request read receipt
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="repliesCheck" @bind="allowReplies">
                                <label class="form-check-label" for="repliesCheck">
                                    <i class="fas fa-reply me-1"></i>
                                    Allow replies
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Tips</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                Be clear and concise
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                Include relevant details
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                Use urgent only for important messages
                            </li>
                            <li>
                                <i class="fas fa-check-circle text-success me-2"></i>
                                You can't edit after sending
                            </li>
                        </ul>

                        @if (ReplyTo.HasValue)
                        {
                            <hr />
                            <div class="small">
                                <strong>Reply Tips:</strong>
                                <ul class="mt-2 ps-3">
                                    <li>Keep your reply relevant to the original message</li>
                                    <li>Quote specific parts if needed</li>
                                    <li>Be respectful and professional</li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .compose-page {
        min-height: 100vh;
        background-color: #f8f9fc;
    }

    .search-results {
        max-height: 300px;
        overflow-y: auto;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: white;
    }

    .search-result-item {
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .search-result-item:hover {
        background-color: #f8f9fa;
    }

    .selected-recipient {
        border: 1px solid #dee2e6;
    }

    .avatar-placeholder {
        font-weight: 600;
        font-size: 0.9rem;
    }

    .avatar-sm {
        width: 40px;
        height: 40px;
    }

    .original-content {
        white-space: pre-wrap;
        color: #495057;
    }

    @@media (max-width: 768px) {
        .compose-page {
            padding-bottom: 70px;
        }
    }
</style>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int? UserId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public int? ReplyTo { get; set; }

    private UserDto? currentUser;
    private UserDto? selectedUser;
    private MessageDto? originalMessage;
    private List<UserDto>? searchResults;
    private string searchQuery = "";
    private string subject = "";
    private string content = "";
    private bool isUrgent = false;
    private bool requestReadReceipt = false;
    private bool allowReplies = true;
    private bool isLoading = false;
    private bool isSearching = false;
    private bool showFullOriginal = false;
    private Timer? searchTimer;

    private bool CanSend => selectedUser != null && !string.IsNullOrWhiteSpace(content);

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        
        if (UserId.HasValue && UserId.Value > 0)
        {
            await LoadUser(UserId.Value);
        }

        if (ReplyTo.HasValue && ReplyTo.Value > 0)
        {
            await LoadOriginalMessage(ReplyTo.Value);
        }
    }

    private string GetPageTitle()
    {
        if (ReplyTo.HasValue)
            return "Reply to Message";
        return "Compose Message";
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
                return;
            }

            currentUser = await AuthService.GetCurrentUserAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading current user: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", "Failed to load user information.");
        }
    }

    private async Task LoadUser(int userId)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            selectedUser = await UserService.GetUserByIdAsync(userId);
            
            if (selectedUser == null)
            {
                await JS.InvokeVoidAsync("showToast", "error", "User not found.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", "Failed to load user information.");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadOriginalMessage(int messageId)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            originalMessage = await MessageService.GetMessageAsync(messageId);
            
            if (originalMessage == null)
            {
                await JS.InvokeVoidAsync("showToast", "error", "Original message not found.");
                return;
            }

            // Set the recipient to the original sender
            if (originalMessage.SenderId != currentUser?.Id)
            {
                selectedUser = originalMessage.Sender;
            }
            else
            {
                // If replying to own message, set recipient to original recipient
                selectedUser = originalMessage.Recipient;
            }

            // Set subject for reply (add "Re: " prefix if not already there)
            if (!string.IsNullOrEmpty(originalMessage.Subject))
            {
                subject = originalMessage.Subject.StartsWith("Re:") 
                    ? originalMessage.Subject 
                    : $"Re: {originalMessage.Subject}";
            }

            // Pre-fill content with quoted original message
            content = $"\n\n--- Original Message ---\nFrom: {originalMessage.Sender?.FirstName} {originalMessage.Sender?.LastName}\nDate: {originalMessage.SentDate:MMM dd, yyyy hh:mm tt}\nSubject: {originalMessage.Subject ?? "(No Subject)"}\n\n{originalMessage.Content}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading original message: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", "Failed to load original message.");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchUsers();
        }
    }

    private async Task SearchUsers()
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || searchQuery.Length < 2)
        {
            await JS.InvokeVoidAsync("console.log", "Search query too short (minimum 2 characters)");
            searchResults = new List<UserDto>();
            return;
        }

        try
        {
            isSearching = true;
            StateHasChanged();

            // Cancel previous timer if exists
            searchTimer?.Dispose();
            
            // Add debounce to avoid too many requests
            searchTimer = new Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    try
                    {
                        await JS.InvokeVoidAsync("console.log", $"Searching for users: {searchQuery}");
                        
                        searchResults = await MessageService.SearchUsersAsync(searchQuery);
                        
                        await JS.InvokeVoidAsync("console.log", $"Found {searchResults?.Count ?? 0} users");
                    }
                    catch (Exception ex)
                    {
                        await JS.InvokeVoidAsync("console.error", "Search error:", ex.Message);
                        searchResults = new List<UserDto>();
                    }
                    finally
                    {
                        isSearching = false;
                        StateHasChanged();
                    }
                });
            }, null, 500, Timeout.Infinite);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", "Search error:", ex.Message);
            isSearching = false;
            searchResults = new List<UserDto>();
            await JS.InvokeVoidAsync("showToast", "error", "Failed to search users.");
            StateHasChanged();
        }
    }

    private void SelectUser(UserDto user)
    {
        selectedUser = user;
        searchResults = null;
        searchQuery = "";
        StateHasChanged();
    }

    private void ClearRecipient()
    {
        selectedUser = null;
        StateHasChanged();
    }

    private async Task SendMessage()
    {
        if (!CanSend)
            return;

        try
        {
            isLoading = true;
            StateHasChanged();

            var message = new SendMessageDto
            {
                RecipientId = selectedUser!.Id,
                Subject = subject,
                Content = content,
                IsUrgent = isUrgent,
                RequestReadReceipt = requestReadReceipt,
                AllowReplies = allowReplies
            };

            bool result;
            if (ReplyTo.HasValue)
            {
                result = await MessageService.ReplyToMessageAsync(ReplyTo.Value, content);
            }
            else
            {
                result = await MessageService.SendMessageAsync(message);
            }

            if (result)
            {
                await JS.InvokeVoidAsync("showToast", "success",
                    ReplyTo.HasValue ? "Reply sent successfully!" : "Message sent successfully!");
                Navigation.NavigateTo("/messages");
            }
        }
        catch (HttpRequestException ex) when (ex.Message.Contains("403"))
        {
            await JS.InvokeVoidAsync("showToast", "error",
                "You don't have permission to send messages to this user. " +
                GetPermissionMessage());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending message: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", "An error occurred while sending the message.");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetPermissionMessage()
    {
        var role = currentUser?.UserType.ToString();

        return role switch
        {
            "User" => "Students can only message doctors they are enrolled with or the Help team.",
            "Doctor" => "Doctors can only message other doctors, students enrolled in their content, or the Help team.",
            _ => "You don't have permission to message this user."
        };
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/messages");
    }

    private void ToggleShowFullOriginal()
    {
        showFullOriginal = !showFullOriginal;
    }

    private string GetUserTypeDisplay(UserType userType)
    {
        return userType switch
        {
            UserType.Admin => "Admin",
            UserType.Doctor => "Doctor",
            UserType.User => "Student",
            _ => "User"
        };
    }

    private string GetUserTypeBadgeClass(UserType userType)
    {
        return userType switch
        {
            UserType.Admin => "bg-danger",
            UserType.Doctor => "bg-success",
            UserType.User => "bg-primary",
            _ => "bg-secondary"
        };
    }

    private string GetUserColor(UserType? userType)
    {
        return userType switch
        {
            UserType.Admin => "#dc3545",
            UserType.Doctor => "#28a745",
            UserType.User => "#0d6efd",
            _ => "#6c757d"
        };
    }

    private string GetInitials(string? firstName, string? lastName)
    {
        if (string.IsNullOrEmpty(firstName) && string.IsNullOrEmpty(lastName))
            return "U";
        
        var first = !string.IsNullOrEmpty(firstName) ? firstName[0].ToString() : "";
        var last = !string.IsNullOrEmpty(lastName) ? lastName[0].ToString() : "";
        return (first + last).ToUpper();
    }

    private string GetMessagePreview(string content, int maxLength = 100)
    {
        if (string.IsNullOrEmpty(content))
            return "";
        
        if (showFullOriginal || content.Length <= maxLength)
            return content;
        
        return content.Substring(0, maxLength) + "...";
    }
}
