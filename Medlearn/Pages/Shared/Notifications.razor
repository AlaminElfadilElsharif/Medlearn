

<div class="notifications-dropdown">
    <!-- Notification Bell -->
    <div class="dropdown">
        <button class="btn btn-link position-relative p-0 p-md-2 text-decoration-none"
                type="button" data-bs-toggle="dropdown" aria-expanded="false"
                disabled="@(!isAuthenticated)">
            <i class="fas fa-bell fa-lg @(isAuthenticated && unreadCount > 0 ? "text-primary" : "text-muted")"></i>
            @if (isAuthenticated && unreadCount > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                      style="font-size: 0.6rem; padding: 0.2rem 0.4rem;">
                    @(unreadCount > 9 ? "9+" : unreadCount.ToString())
                </span>
            }
        </button>

        <!-- Dropdown Menu -->
        @if (isAuthenticated)
        {
            <div class="dropdown-menu dropdown-menu-end p-0 shadow-lg border-0"
                 style="width: 380px; max-width: 90vw; right: 0; left: auto !important; transform: translateX(0) !important;">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center p-2 p-md-3 border-bottom bg-light">
                    <h6 class="mb-0 fw-bold">Notifications</h6>
                    <div class="d-flex gap-1 gap-md-2">
                        @if (unreadCount > 0)
                        {
                            <button class="btn btn-sm btn-outline-primary py-0 py-md-1 px-1 px-md-2" @onclick="MarkAllAsRead">
                                <small class="d-none d-md-inline">Mark all read</small>
                                <i class="fas fa-check-double d-md-none"></i>
                            </button>
                        }
                        <button class="btn btn-sm btn-link text-muted p-0 p-md-1" @onclick="ReloadNotifications">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                </div>

                <!-- Loading State -->
                @if (isLoading)
                {
                    <div class="p-3 p-md-4 text-center">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-muted mt-2 mb-0 small">Loading notifications...</p>
                    </div>
                }
                else if (!notifications.Any())
                {
                    <div class="p-3 p-md-4 text-center">
                        <div class="mb-2 mb-md-3">
                            <i class="fas fa-bell-slash fa-2x text-muted"></i>
                        </div>
                        <p class="text-muted mb-1 small">No notifications yet</p>
                        <small class="text-muted d-none d-md-inline">You'll see important updates here</small>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                        @foreach (var notification in notifications)
                        {
                            <div class="list-group-item list-group-item-action p-2 p-md-3 @(!notification.IsRead ? "unread-notification" : "")"
                                 @onclick="async () => await HandleNotificationClick(notification)"
                                 style="cursor: pointer; border-left: 3px solid @GetNotificationColor(notification.Type);">
                                <div class="d-flex align-items-start">
                                    <!-- Icon - Hidden on smallest screens -->
                                    <div class="notification-icon d-none d-sm-flex me-2 me-md-3">
                                        @GetNotificationIcon(notification.Type)
                                    </div>
                                    <div class="flex-grow-1 min-width-0" style="overflow-wrap: break-word; word-wrap: break-word; word-break: break-word;">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <h6 class="mb-0 fw-semibold small small-md-normal text-truncate" style="max-width: 200px;">@notification.Title</h6>
                                            <small class="text-muted ms-1 flex-shrink-0">@FormatTime(notification.SentDate)</small>
                                        </div>
                                        <p class="mb-1 mb-md-2 text-muted small text-truncate-mobile" style="max-width: 250px;">@notification.Message</p>
                                        <div class="d-flex gap-2 align-items-center">
                                            @if (!notification.IsRead)
                                            {
                                                <span class="badge bg-primary rounded-pill" style="font-size: 0.6rem;">New</span>
                                            }
                                            @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                            {
                                                <small class="text-primary d-none d-sm-inline">
                                                    <i class="fas fa-external-link-alt me-1"></i>
                                                    Click to view
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Footer -->
                <div class="p-2 p-md-3 border-top bg-light">
                    <a href="/notifications" class="btn btn-outline-primary btn-sm w-100">
                        <i class="fas fa-list me-1 d-none d-sm-inline"></i>
                        <span class="d-none d-sm-inline">View All Notifications</span>
                        <span class="d-sm-none">All</span>
                        <i class="fas fa-arrow-right ms-1 d-sm-none"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .notifications-dropdown {
        position: relative;
    }

        .notifications-dropdown .dropdown-menu {
            position: absolute !important;
            inset: 0px 0px auto auto !important;
            margin: 0px !important;
            transform: translate(0px, 40px) !important;
            width: 380px;
            max-width: 90vw;
            transition: all 0.3s ease;
            max-height: 80vh !important;
            overflow-y: hidden !important;
            border-radius: 8px !important;
            box-shadow: 0 10px 40px rgba(0,0,0,0.15) !important;
        }

            .notifications-dropdown .dropdown-menu.show {
                transform: translate(0px, 40px) !important;
            }

        /* Ensure the dropdown stays within viewport on the right side */
        .notifications-dropdown .dropdown-menu-end {
            right: 0 !important;
            left: auto !important;
        }

    .unread-notification {
        background-color: rgba(13, 110, 253, 0.05);
    }

        .unread-notification:hover {
            background-color: rgba(13, 110, 253, 0.1);
        }

    .notification-icon {
        font-size: 1rem;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background-color: rgba(0, 0, 0, 0.05);
        flex-shrink: 0;
    }

    /* Fix text overflow */
    .min-width-0 {
        min-width: 0;
        max-width: calc(100% - 40px);
    }

    .text-truncate-mobile {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }

    /* Mobile-specific styles */
    @@media (max-width: 576px) {
        .notifications-dropdown .dropdown-menu {
            position: fixed !important;
            top: 60px !important;
            left: 0 !important;
            right: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            min-width: 100% !important;
            border-radius: 0 !important;
            max-height: calc(100vh - 60px) !important;
            transform: translate(0, 0) !important;
            box-shadow: none !important;
        }

            .notifications-dropdown .dropdown-menu.show {
                transform: translate(0, 0) !important;
            }

        .text-truncate-mobile {
            -webkit-line-clamp: 2;
        }

        .notification-icon {
            width: 28px;
            height: 28px;
            font-size: 0.9rem;
        }
    }

    /* Tablet adjustments */
    @@media (min-width: 577px) and (max-width: 768px) {
        .notifications-dropdown .dropdown-menu {
            width: 400px !important;
            max-width: 90vw !important;
        }
    }

    /* Desktop */
    @@media (min-width: 769px) {
        .small-md-normal {
            font-size: 0.9rem;
        }

        .text-truncate-mobile {
            max-width: 280px;
        }
    }

    /* Ensure dropdown doesn't overflow right edge */
    @@media (min-width: 769px) and (max-width: 1200px) {
        .notifications-dropdown .dropdown-menu {
            right: -10px !important;
        }
    }
</style>

@code {
    private List<NotificationDto> notifications = new();
    private int unreadCount = 0;
    private bool isLoading = false;
    private bool isAuthenticated = false;
    private Timer? refreshTimer;
    private bool isMobile = false;
    private ElementReference dropdownMenu;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
        await CheckDeviceType();

        if (isAuthenticated)
        {
            await LoadNotifications();

            // Start auto-refresh every 30 seconds only if authenticated
            refreshTimer = new Timer(async _ => await RefreshNotifications(), null, 30000, 30000);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckDeviceType();
            StateHasChanged();

            // Ensure dropdown is properly positioned
            await JS.InvokeVoidAsync("ensureDropdownPosition");
        }
    }

    private async Task CheckDeviceType()
    {
        try
        {
            isMobile = await JS.InvokeAsync<bool>("checkMobileDevice");
        }
        catch
        {
            // Fallback to window width check
            var width = await JS.InvokeAsync<int>("eval", "window.innerWidth");
            isMobile = width <= 768;
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            // Use TokenService to check authentication
            isAuthenticated = await TokenService.IsAuthenticatedAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
        }
    }

    private async Task LoadNotifications()
    {
        if (!isAuthenticated)
        {
            notifications.Clear();
            unreadCount = 0;
            isLoading = false;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            // Adjust page size based on device
            int pageSize = isMobile ? 8 : 5;

            // Get recent notifications
            var recentNotifications = await NotificationService.GetMyNotificationsAsync(
                unreadOnly: false,
                page: 1,
                pageSize: pageSize);

            if (recentNotifications != null)
            {
                notifications = recentNotifications
                    .OrderByDescending(n => n.SentDate)
                    .Take(pageSize)
                    .ToList();
            }
            else
            {
                notifications = new List<NotificationDto>();
            }

            // Get unread count
            unreadCount = await NotificationService.GetUnreadCountAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading notifications: {ex.Message}");
            notifications = new List<NotificationDto>();
            unreadCount = 0;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshNotifications()
    {
        if (!isAuthenticated)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            try
            {
                await LoadNotifications();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error refreshing notifications: {ex.Message}");
            }
        });
    }

    private async Task HandleNotificationClick(NotificationDto notification)
    {
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/account/login");
            return;
        }

        try
        {
            // Mark as read
            if (!notification.IsRead)
            {
                await NotificationService.MarkAsReadAsync(notification.Id);

                // Update local state
                unreadCount--;
                notification.IsRead = true;
                StateHasChanged();
            }

            // Navigate if there's an action URL
            if (!string.IsNullOrEmpty(notification.ActionUrl))
            {
                Navigation.NavigateTo(notification.ActionUrl);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error handling notification click: {ex.Message}");
        }
    }

    private async Task MarkAllAsRead()
    {
        if (!isAuthenticated)
        {
            return;
        }

        try
        {
            await NotificationService.MarkAllAsReadAsync();

            // Update local state
            unreadCount = 0;
            foreach (var notification in notifications)
            {
                notification.IsRead = true;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error marking all as read: {ex.Message}");
        }
    }

    private async Task ReloadNotifications()
    {
        if (!isAuthenticated)
        {
            return;
        }

        await LoadNotifications();
    }

    private string GetNotificationColor(string notificationType)
    {
        return notificationType switch
        {
            "PaymentStatus" => "#28a745",
            "Announcement" => "#007bff",
            "Enrollment" => "#17a2b8",
            "System" => "#6c757d",
            "Warning" => "#ffc107",
            "Error" => "#dc3545",
            _ => "#6c757d"
        };
    }

    private MarkupString GetNotificationIcon(string notificationType)
    {
        var iconClass = notificationType switch
        {
            "PaymentStatus" => "fas fa-money-bill-wave text-success",
            "Announcement" => "fas fa-bullhorn text-primary",
            "Enrollment" => "fas fa-graduation-cap text-info",
            "System" => "fas fa-cog text-secondary",
            "Warning" => "fas fa-exclamation-triangle text-warning",
            "Error" => "fas fa-exclamation-circle text-danger",
            _ => "fas fa-bell text-muted"
        };

        return new MarkupString($"<i class='{iconClass}'></i>");
    }

    private string FormatTime(DateTime date)
    {
        var timeSpan = DateTime.UtcNow - date.ToUniversalTime();

        if (timeSpan.TotalSeconds < 60)
            return "Just now";

        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes}m ago";

        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours}h ago";

        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays}d ago";

        return date.ToString("MMM dd");
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}