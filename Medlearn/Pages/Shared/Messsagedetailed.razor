@page "/messages/view/{id:int}"


<PageTitle>View Message</PageTitle>

<div class="view-message-page">
    <!-- Loading Overlay -->
    @if (isLoading)
    {
        <div class="position-fixed top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-flex justify-content-center align-items-center">
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading message...</p>
            </div>
        </div>
    }

    <!-- Mobile Header -->
    <div class="d-block d-md-none mb-3">
        <div class="bg-primary text-white p-3">
            <div class="d-flex align-items-center">
                <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                    <i class="fas fa-arrow-left fa-lg"></i>
                </button>
                <div class="flex-grow-1">
                    <h5 class="mb-0">Message</h5>
                </div>
                <div class="dropdown">
                    <button class="btn btn-link text-white p-0" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-ellipsis-v fa-lg"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @if (message?.SenderId != currentUser?.Id)
                        {
                            <li>
                                <button class="dropdown-item" @onclick="ReplyToMessage">
                                    <i class="fas fa-reply me-2"></i>Reply
                                </button>
                            </li>
                        }
                        <li>
                            <button class="dropdown-item text-danger" @onclick="DeleteMessage">
                                <i class="fas fa-trash-alt me-2"></i>Delete
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Desktop Header -->
    <div class="container-fluid py-4">
        <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
            <h1>Message</h1>
            <div>
                <button class="btn btn-outline-secondary me-2" @onclick="GoBack">
                    <i class="fas fa-arrow-left me-2"></i>Back
                </button>
                @if (message?.SenderId != currentUser?.Id)
                {
                    <button class="btn btn-primary me-2" @onclick="ReplyToMessage">
                        <i class="fas fa-reply me-2"></i>Reply
                    </button>
                }
                <button class="btn btn-outline-danger" @onclick="DeleteMessage">
                    <i class="fas fa-trash-alt me-2"></i>Delete
                </button>
            </div>
        </div>

        @if (message != null)
        {
            <!-- Message Header -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h3 class="mb-3">@(message.Subject ?? "(No Subject)")</h3>

                            <div class="d-flex align-items-center mb-3">
                                <div class="avatar-lg me-3">
                                    @{
                                        var displayUser = message.SenderId == currentUser?.Id ? message.Recipient : message.Sender;
                                    }
                                    @if (displayUser != null && !string.IsNullOrEmpty(displayUser.ProfileImageUrl))
                                    {
                                        <img src="@displayUser.ProfileImageUrl" class="rounded-circle" width="64" height="64" />
                                    }
                                    else
                                    {
                                        <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center"
                                             style="width: 64px; height: 64px; background-color: @GetUserColor(displayUser?.UserType); color: white; font-size: 1.5rem;">
                                            @GetInitials(displayUser?.FirstName, displayUser?.LastName)
                                        </div>
                                    }
                                </div>
                                <div>
                                    @if (message.SenderId == currentUser?.Id)
                                    {
                                        <div>
                                            <strong>To:</strong> @message.Recipient?.FirstName @message.Recipient?.LastName
                                            @if (message.Recipient?.UserType != null)
                                            {
                                                <span class="badge @GetUserTypeBadgeClass(message.Recipient.UserType) ms-2">
                                                    @GetUserTypeDisplay(message.Recipient.UserType)
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <strong>From:</strong> @message.Sender?.FirstName @message.Sender?.LastName
                                            @if (message.Sender?.UserType != null)
                                            {
                                                <span class="badge @GetUserTypeBadgeClass(message.Sender.UserType) ms-2">
                                                    @GetUserTypeDisplay(message.Sender.UserType)
                                                </span>
                                            }
                                        </div>
                                    }
                                    <div class="text-muted">
                                        <i class="fas fa-clock me-1"></i> @message.SentDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                    </div>
                                    @if (message.IsRead && message.ReadDate.HasValue && message.RecipientId == currentUser?.Id)
                                    {
                                        <div class="text-muted small">
                                            <i class="fas fa-check-circle text-success me-1"></i>
                                            Read on @message.ReadDate.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (message.IsUrgent)
                            {
                                <div class="alert alert-danger py-2 mb-3">
                                    <i class="fas fa-exclamation-circle me-2"></i>
                                    This message is marked as urgent
                                </div>
                            }

                            @if (message.RequestReadReceipt && message.SenderId == currentUser?.Id && message.IsRead)
                            {
                                <div class="alert alert-success py-2 mb-3">
                                    <i class="fas fa-receipt me-2"></i>
                                    Read receipt: Message was read on @message.ReadDate?.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                </div>
                            }
                        </div>

                        <div class="col-md-4">
                            <div class="message-meta p-3 bg-light rounded">
                                <h6>Message Details</h6>
                                <table class="table table-sm">
                                    <tr>
                                        <th>Status:</th>
                                        <td>
                                            @if (message.SenderId == currentUser?.Id)
                                            {
                                                if (message.IsRead)
                                                {
                                                    <span class="badge bg-success">Read</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">Delivered</span>
                                                }
                                            }
                                            else
                                            {
                                                if (message.IsRead)
                                                {
                                                    <span class="badge bg-secondary">Read</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary">New</span>
                                                }
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Urgent:</th>
                                        <td>@(message.IsUrgent ? "Yes" : "No")</td>
                                    </tr>
                                    <tr>
                                        <th>Replies allowed:</th>
                                        <td>@(message.AllowReplies ? "Yes" : "No")</td>
                                    </tr>
                                    <tr>
                                        <th>Read receipt:</th>
                                        <td>@(message.RequestReadReceipt ? "Requested" : "Not requested")</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Message Content -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Message Content</h5>
                </div>
                <div class="card-body">
                    <div class="message-content">
                        @message.Content
                    </div>
                </div>
            </div>

            <!-- Attachments -->
            @if (message.Attachments != null && message.Attachments.Any())
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-paperclip me-2"></i>
                            Attachments (@message.Attachments.Count)
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var attachment in message.Attachments)
                            {
                                <div class="col-md-4 mb-3">
                                    <div class="attachment-item p-3 border rounded">
                                        <i class="fas fa-file fa-2x text-primary mb-2"></i>
                                        <div class="attachment-name">@attachment.FileName</div>
                                        <div class="attachment-size text-muted small">
                                            @FormatFileSize(attachment.FileSize)
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="() => DownloadAttachment(attachment)">
                                            <i class="fas fa-download me-1"></i> Download
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Replies -->
            @if (message.Replies != null && message.Replies.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-reply-all me-2"></i>
                            Replies (@message.Replies.Count)
                        </h5>
                    </div>
                    <div class="card-body">
                        @foreach (var reply in message.Replies.OrderBy(r => r.SentDate))
                        {
                            <div class="reply-item mb-3 pb-3 border-bottom">
                                <div class="d-flex align-items-start">
                                    <div class="avatar-sm me-2">
                                        @if (reply.Sender != null && !string.IsNullOrEmpty(reply.Sender.ProfileImageUrl))
                                        {
                                            <img src="@reply.Sender.ProfileImageUrl" class="rounded-circle" width="32" height="32" />
                                        }
                                        else
                                        {
                                            <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center"
                                                 style="width: 32px; height: 32px; background-color: @GetUserColor(reply.Sender?.UserType); color: white;">
                                                @GetInitials(reply.Sender?.FirstName, reply.Sender?.LastName)
                                            </div>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between">
                                            <strong>@reply.Sender?.FirstName @reply.Sender?.LastName</strong>
                                            <small class="text-muted">@reply.SentDate.ToString("MMM dd, hh:mm tt")</small>
                                        </div>
                                        <div class="mt-1">
                                            @reply.Content
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else if (!isLoading)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>
                Message not found or you don't have permission to view it.
            </div>
        }
    </div>
</div>

<style>
    .view-message-page {
        min-height: 100vh;
        background-color: #f8f9fc;
    }

    .avatar-lg {
        width: 64px;
        height: 64px;
    }

    .avatar-sm {
        width: 32px;
        height: 32px;
    }

    .avatar-placeholder {
        font-weight: 600;
    }

    .message-content {
        white-space: pre-wrap;
        line-height: 1.6;
    }

    .attachment-item {
        text-align: center;
        transition: all 0.2s;
    }

        .attachment-item:hover {
            background-color: #f8f9fa;
            transform: translateY(-2px);
        }

    .attachment-name {
        font-size: 0.9rem;
        word-break: break-all;
        max-height: 40px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .reply-item:last-child {
        border-bottom: none !important;
        margin-bottom: 0 !important;
        padding-bottom: 0 !important;
    }

    @@media (max-width: 768px) {
        .view-message-page {
            padding-bottom: 70px;
        }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private UserDto? currentUser;
    private MessageDto? message;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadMessage();
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
                return;
            }

            currentUser = await AuthService.GetCurrentUserAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading current user: {ex.Message}");
        }
    }

    private async Task LoadMessage()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            message = await MessageService.GetMessageAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading message: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteMessage()
    {
        try
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this message?");
            if (confirmed)
            {
                var result = await MessageService.DeleteMessageAsync(Id);
                if (result)
                {
                    await JS.InvokeVoidAsync("showToast", "success", "Message deleted successfully!");
                    Navigation.NavigateTo("/messages");
                }
                else
                {
                    await JS.InvokeVoidAsync("showToast", "error", "Failed to delete message.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting message: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", "An error occurred while deleting the message.");
        }
    }

    private void ReplyToMessage()
    {
        if (message != null)
        {
            Navigation.NavigateTo($"/messages/compose?userId={message.SenderId}&replyTo={message.Id}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/messages");
    }

    private async Task DownloadAttachment(MessageAttachmentDto attachment)
    {
        // Implement download logic
        await JS.InvokeVoidAsync("downloadFile", attachment.FileName, attachment.FileData);
    }

    private string GetUserTypeDisplay(UserType? userType)
    {
        return userType switch
        {
            UserType.Admin => "Admin",
            UserType.Doctor => "Doctor",
            UserType.User => "Student",
            _ => "User"
        };
    }

    private string GetUserTypeBadgeClass(UserType? userType)
    {
        return userType switch
        {
            UserType.Admin => "bg-danger",
            UserType.Doctor => "bg-success",
            UserType.User => "bg-primary",
            _ => "bg-secondary"
        };
    }

    private string GetUserColor(UserType? userType)
    {
        return userType switch
        {
            UserType.Admin => "#dc3545",
            UserType.Doctor => "#28a745",
            UserType.User => "#0d6efd",
            _ => "#6c757d"
        };
    }

    private string GetInitials(string? firstName, string? lastName)
    {
        if (string.IsNullOrEmpty(firstName) && string.IsNullOrEmpty(lastName))
            return "U";

        var first = !string.IsNullOrEmpty(firstName) ? firstName[0].ToString() : "";
        var last = !string.IsNullOrEmpty(lastName) ? lastName[0].ToString() : "";
        return (first + last).ToUpper();
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}