

<div class="compact-widget @(ShowInNavbar ? "navbar-widget" : "")">
    @if (isLoading)
    {
        <div class="text-center py-2">
            <div class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="small fw-bold">
                <i class="bi bi-envelope-paper me-1 text-primary"></i>
                Contact Messages
            </span>
            <span class="badge @GetUnreadBadgeClass">@unreadCount Unread</span>
        </div>

        <div class="row g-1 text-center small mb-2">
            <div class="col-4">
                <div class="p-1 bg-light rounded">
                    <div class="text-muted">Total</div>
                    <div class="fw-bold">@totalCount</div>
                </div>
            </div>
            <div class="col-4">
                <div class="p-1 bg-light rounded">
                    <div class="text-muted">Replied</div>
                    <div class="fw-bold">@repliedCount</div>
                </div>
            </div>
            <div class="col-4">
                <div class="p-1 bg-light rounded">
                    <div class="text-muted">Response</div>
                    <div class="fw-bold">@averageResponseTime</div>
                </div>
            </div>
        </div>

        <a href="/admin/contact-messages" class="btn btn-outline-primary btn-sm w-100">
            <i class="bi bi-inbox me-2"></i>
            Manage Messages
            @if (unreadCount > 0)
            {
                <span class="badge bg-danger ms-2">@unreadCount</span>
            }
        </a>
    }
</div>

<style>
    .compact-widget {
        font-size: 0.9rem;
    }

    .navbar-widget {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 0.75rem;
        min-width: 250px;
        margin: 0.25rem 0;
    }

    .compact-widget .bg-light {
        background-color: rgba(255,255,255,0.8) !important;
        border: 1px solid rgba(0,0,0,0.03);
    }

    /* Dark theme for navbar dropdown */
    .navbar-widget .bg-light {
        background-color: #e9ecef !important;
    }

    .compact-widget .btn-sm {
        font-size: 0.8rem;
    }

    /* Mobile optimizations */
    @@media (max-width: 768px) {
        .compact-widget .badge {
            font-size: 0.7rem;
        }

        .compact-widget .row {
            margin-bottom: 0.5rem;
        }
    }
</style>

@code {
    [Parameter]
    public bool ShowInNavbar { get; set; } = false;

    private int totalCount;
    private int unreadCount;
    private int repliedCount;
    private string averageResponseTime = "N/A";
    private bool isLoading = true;
    private System.Timers.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ShowInNavbar)
        {
            // Set up periodic refresh for navbar widget (every 30 seconds)
            refreshTimer = new System.Timers.Timer(30000);
            refreshTimer.Elapsed += async (sender, e) => await InvokeAsync(async () =>
            {
                await LoadData();
                StateHasChanged();
            });
            refreshTimer.AutoReset = true;
            refreshTimer.Start();
        }
    }

    private async Task LoadData()
    {
        try
        {
            unreadCount = await ContactService.GetUnreadCountAsync();

            var messages = await ContactService.GetContactMessagesAsync(1, 100);
            if (messages != null)
            {
                totalCount = messages.Count;
                repliedCount = messages.Count(m => m.IsReplied);

                var repliedMessages = messages.Where(m => m.IsReplied && m.RepliedAt.HasValue);
                if (repliedMessages.Any())
                {
                    var avgHours = repliedMessages
                        .Select(m => (m.RepliedAt!.Value - m.CreatedAt).TotalHours)
                        .Average();

                    averageResponseTime = avgHours < 1 ? "< 1h" :
                                         avgHours < 24 ? $"{avgHours:F0}h" :
                                         $"{(avgHours / 24):F1}d";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading compact widget: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetUnreadBadgeClass => unreadCount > 0 ? "bg-danger" : "bg-secondary";

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}