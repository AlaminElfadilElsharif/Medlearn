

<div class="message-widget">
    <!-- Widget Header -->
    <div class="widget-header d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center">
            <div class="widget-icon me-2">
                <i class="fas fa-envelope"></i>
            </div>
            <h5 class="mb-0">Messages</h5>
            @if (unreadCount > 0)
            {
                <span class="badge bg-danger ms-2 unread-badge">@unreadCount new</span>
            }
        </div>
        <div class="widget-actions">
            <button class="btn btn-sm btn-link text-decoration-none" 
                    @onclick="RefreshData" 
                    title="Refresh messages"
                    disabled="@isLoading">
                <i class="fas fa-sync-alt @(isLoading ? "fa-spin" : "")"></i>
            </button>
            <button class="btn btn-sm btn-link text-decoration-none" 
                    @onclick="() => NavigateToMessages()" 
                    title="View all messages">
                <i class="fas fa-arrow-right"></i>
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-4">
            <div class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted small mt-2">Loading messages...</p>
        </div>
    }
    else if (hasError)
    {
        <div class="alert alert-danger py-2 px-3 small">
            <i class="fas fa-exclamation-circle me-2"></i>
            @errorMessage
            <button class="btn btn-sm btn-link p-0 ms-2" @onclick="LoadMessages">Retry</button>
        </div>
    }
    else if (!recentMessages.Any())
    {
        <div class="empty-state text-center py-4">
            <div class="empty-icon mb-2">
                <i class="fas fa-envelope-open fa-2x text-muted"></i>
            </div>
            <p class="text-muted small mb-2">No messages yet</p>
            <button class="btn btn-sm btn-outline-primary" @onclick="ComposeMessage">
                <i class="fas fa-pen me-1"></i> Compose
            </button>
        </div>
    }
    else
    {
        <!-- Message List -->
        <div class="message-list">
            @foreach (var message in recentMessages)
            {
                var isUnread = !message.IsRead;
                var sender = message.Sender;
                var senderName = sender != null ? $"{sender.FirstName} {sender.LastName}" : "Unknown";
                var senderInitials = GetInitials(sender?.FirstName, sender?.LastName);
                var senderColor = GetUserColor(sender?.UserType);

                <div class="message-item @(isUnread ? "unread" : "")" 
                     @onclick="() => ViewMessage(message.Id)">
                    
                    <!-- Desktop Layout -->
                    <div class="d-none d-md-flex align-items-start gap-3">
                        <!-- Avatar -->
                        <div class="avatar-container position-relative">
                            @if (sender != null && !string.IsNullOrEmpty(sender.ProfileImageUrl))
                            {
                                <img src="@sender.ProfileImageUrl" 
                                     class="rounded-circle" 
                                     width="40" height="40"
                                     alt="@senderName"
                                     onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
                            }
                            else
                            {
                                <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center"
                                     style="width: 40px; height: 40px; background-color: @senderColor; color: white; font-weight: 600;">
                                    @senderInitials
                                </div>
                            }
                            
                            @if (message.IsUrgent)
                            {
                                <span class="urgent-indicator" title="Urgent message">
                                    <i class="fas fa-exclamation-circle"></i>
                                </span>
                            }
                            
                            @if (isUnread)
                            {
                                <span class="unread-indicator"></span>
                            }
                        </div>

                        <!-- Message Content -->
                        <div class="flex-grow-1 min-width-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong class="sender-name">@senderName</strong>
                                    @if (sender?.UserType != null)
                                    {
                                        <span class="badge @GetUserTypeBadgeClass(sender.UserType) ms-1">
                                            @GetUserTypeDisplay(sender.UserType)
                                        </span>
                                    }
                                </div>
                                <small class="text-muted time-ago">
                                    @FormatDate(message.SentDate)
                                </small>
                            </div>
                            
                            <div class="message-subject small fw-bold @(isUnread ? "" : "text-muted")">
                                @(message.Subject ?? "(No Subject)")
                            </div>
                            
                            <div class="message-preview small text-muted">
                                @GetMessagePreview(message.Content)
                            </div>
                            
                            <div class="message-meta d-flex align-items-center gap-2 mt-1">
                                @if (message.Attachments != null && message.Attachments.Any())
                                {
                                    <span class="badge bg-light text-dark">
                                        <i class="fas fa-paperclip me-1"></i>@message.Attachments.Count
                                    </span>
                                }
                                @if (message.IsUrgent)
                                {
                                    <span class="badge bg-danger">Urgent</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Mobile Layout -->
                    <div class="d-block d-md-none">
                        <div class="d-flex align-items-start gap-2">
                            <!-- Avatar -->
                            <div class="avatar-container position-relative">
                                @if (sender != null && !string.IsNullOrEmpty(sender.ProfileImageUrl))
                                {
                                    <img src="@sender.ProfileImageUrl" 
                                         class="rounded-circle" 
                                         width="36" height="36"
                                         alt="@senderName"
                                         onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
                                }
                                else
                                {
                                    <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center"
                                         style="width: 36px; height: 36px; background-color: @senderColor; color: white; font-weight: 600; font-size: 0.9rem;">
                                        @senderInitials
                                    </div>
                                }
                                
                                @if (message.IsUrgent)
                                {
                                    <span class="urgent-indicator" style="width: 10px; height: 10px;">
                                        <i class="fas fa-exclamation-circle" style="font-size: 10px;"></i>
                                    </span>
                                }
                                
                                @if (isUnread)
                                {
                                    <span class="unread-indicator" style="width: 8px; height: 8px;"></span>
                                }
                            </div>

                            <!-- Message Content -->
                            <div class="flex-grow-1 min-width-0">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong class="sender-name small">@senderName</strong>
                                        @if (sender?.UserType != null)
                                        {
                                            <span class="badge @GetUserTypeBadgeClass(sender.UserType) ms-1" style="font-size: 0.6rem;">
                                                @GetUserTypeInitials(sender.UserType)
                                            </span>
                                        }
                                    </div>
                                    <small class="text-muted time-ago" style="font-size: 0.7rem;">
                                        @FormatDateShort(message.SentDate)
                                    </small>
                                </div>
                                
                                <div class="message-subject small fw-bold @(isUnread ? "" : "text-muted")" style="font-size: 0.8rem;">
                                    @(message.Subject ?? "(No Subject)")
                                </div>
                                
                                <div class="message-preview small text-muted" style="font-size: 0.75rem;">
                                    @GetMessagePreview(message.Content, 50)
                                </div>
                                
                                <div class="message-meta d-flex align-items-center gap-1 mt-1">
                                    @if (message.Attachments != null && message.Attachments.Any())
                                    {
                                        <span class="badge bg-light text-dark" style="font-size: 0.6rem;">
                                            <i class="fas fa-paperclip"></i>@message.Attachments.Count
                                        </span>
                                    }
                                    @if (message.IsUrgent)
                                    {
                                        <span class="badge bg-danger" style="font-size: 0.6rem;">Urgent</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Footer Actions -->
        <div class="widget-footer d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
            @if (unreadCount > 0)
            {
                <button class="btn btn-sm btn-link text-primary p-0" @onclick="MarkAllAsRead">
                    <i class="fas fa-check-double me-1"></i> Mark all read
                </button>
            }
            else
            {
                <span></span>
            }
            <button class="btn btn-sm btn-primary" @onclick="ComposeMessage">
                <i class="fas fa-pen me-1"></i> New Message
            </button>
        </div>
    }
</div>

<style>
    .message-widget {
        background: white;
        border-radius: 16px;
        padding: 1.25rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
    }

    .message-widget:hover {
        box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    }

    .widget-icon {
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

        .widget-icon i {
            font-size: 1rem;
        }

    .unread-badge {
        animation: pulse 2s infinite;
    }

    .message-item {
        padding: 0.75rem;
        margin: 0 -0.75rem;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
        border-left: 3px solid transparent;
    }

        .message-item:hover {
            background-color: #f8f9fc;
            transform: translateX(4px);
        }

        .message-item.unread {
            background-color: #f0f7ff;
            border-left-color: #0d6efd;
        }

    .avatar-container {
        flex-shrink: 0;
    }

    .avatar-placeholder {
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .unread-indicator {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 10px;
        height: 10px;
        background-color: #0d6efd;
        border: 2px solid white;
        border-radius: 50%;
    }

    .urgent-indicator {
        position: absolute;
        top: -2px;
        right: -2px;
        width: 16px;
        height: 16px;
        background-color: #dc3545;
        border: 2px solid white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 8px;
    }

    .min-width-0 {
        min-width: 0;
    }

    .sender-name {
        font-size: 0.9rem;
    }

    .message-subject {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .message-preview {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .time-ago {
        font-size: 0.75rem;
        white-space: nowrap;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05);
        }
        100% {
            transform: scale(1);
        }
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .message-widget {
            padding: 1rem;
            border-radius: 12px;
        }

        .widget-header h5 {
            font-size: 1rem;
        }

        .message-item {
            padding: 0.5rem;
        }
    }
</style>

@code {
    private List<MessageDto> recentMessages = new();
    private int unreadCount = 0;
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = "";
    private UserDto? currentUser;

    [Parameter]
    public int MaxMessages { get; set; } = 5;

    [Parameter]
    public bool ShowComposeButton { get; set; } = true;

    [Parameter]
    public bool AutoRefresh { get; set; } = true;

    [Parameter]
    public int RefreshInterval { get; set; } = 60000; // 1 minute default

    private System.Timers.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadMessages();

        if (AutoRefresh)
        {
            StartAutoRefresh();
        }
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading current user: {ex.Message}");
        }
    }

    private async Task LoadMessages()
    {
        isLoading = true;
        hasError = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Get unread count
            unreadCount = await MessageService.GetUnreadCountAsync();

            // Get recent inbox messages
            var messages = await MessageService.GetInboxAsync(page: 1, pageSize: MaxMessages);
            
            if (messages != null)
            {
                recentMessages = messages
                    .OrderByDescending(m => m.IsUrgent)
                    .ThenByDescending(m => m.SentDate)
                    .Take(MaxMessages)
                    .ToList();
            }
            else
            {
                recentMessages = new List<MessageDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading messages: {ex.Message}");
            hasError = true;
            errorMessage = "Failed to load messages";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartAutoRefresh()
    {
        refreshTimer = new System.Timers.Timer(RefreshInterval);
        refreshTimer.Elapsed += async (sender, e) => await RefreshData();
        refreshTimer.Start();
    }

    private async Task RefreshData()
    {
        await LoadMessages();
    }

    private void ViewMessage(int id)
    {
        Navigation.NavigateTo($"/messages/view/{id}");
    }

    private void ComposeMessage()
    {
        Navigation.NavigateTo("/messages/compose");
    }

    private void NavigateToMessages()
    {
        Navigation.NavigateTo("/messages");
    }

    private async Task MarkAllAsRead()
    {
        try
        {
            var result = await MessageService.MarkAllAsReadAsync();
            if (result)
            {
                unreadCount = 0;
                foreach (var message in recentMessages)
                {
                    message.IsRead = true;
                }
                await InvokeAsync(StateHasChanged);
                
                await JS.InvokeVoidAsync("showToast", "success", "All messages marked as read!");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error marking all as read: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", "Failed to mark messages as read");
        }
    }

    private string GetInitials(string? firstName, string? lastName)
    {
        if (string.IsNullOrEmpty(firstName) && string.IsNullOrEmpty(lastName))
            return "U";

        var first = !string.IsNullOrEmpty(firstName) ? firstName[0].ToString() : "";
        var last = !string.IsNullOrEmpty(lastName) ? lastName[0].ToString() : "";
        return (first + last).ToUpper();
    }

    private string GetUserColor(UserType? userType)
    {
        return userType switch
        {
            UserType.Admin => "#dc3545", // Red
            UserType.Doctor => "#28a745", // Green
            UserType.User => "#0d6efd", // Blue
            _ => "#6c757d" // Gray
        };
    }

    private string GetUserTypeDisplay(UserType userType)
    {
        return userType switch
        {
            UserType.Admin => "Admin",
            UserType.Doctor => "Doctor",
            UserType.User => "Student",
            _ => "User"
        };
    }

    private string GetUserTypeInitials(UserType userType)
    {
        return userType switch
        {
            UserType.Admin => "A",
            UserType.Doctor => "Dr",
            UserType.User => "S",
            _ => "U"
        };
    }

    private string GetUserTypeBadgeClass(UserType userType)
    {
        return userType switch
        {
            UserType.Admin => "bg-danger",
            UserType.Doctor => "bg-success",
            UserType.User => "bg-primary",
            _ => "bg-secondary"
        };
    }

    private string GetMessagePreview(string content, int maxLength = 60)
    {
        if (string.IsNullOrEmpty(content))
            return "";

        if (content.Length <= maxLength)
            return content;

        return content.Substring(0, maxLength) + "...";
    }

    private string FormatDate(DateTime date)
    {
        var now = DateTime.UtcNow;
        var today = now.Date;
        var yesterday = today.AddDays(-1);
        var messageDate = date.Date;

        if (messageDate == today)
            return date.ToString("h:mm tt");
        if (messageDate == yesterday)
            return "Yesterday";
        if (messageDate >= today.AddDays(-6))
            return date.ToString("dddd");

        return date.ToString("MMM d");
    }

    private string FormatDateShort(DateTime date)
    {
        var now = DateTime.UtcNow;
        var today = now.Date;
        var messageDate = date.Date;

        if (messageDate == today)
            return date.ToString("h:mm tt");
        if (messageDate == today.AddDays(-1))
            return "Yesterday";
        
        return date.ToString("M/d");
    }

    public void Dispose()
    {
        refreshTimer?.Stop();
        refreshTimer?.Dispose();
    }
}
