@page "/student/certificate"
@page "/student/mylearning/certificate/{enrollmentId:int}"


<PageTitle>Certificate of Completion</PageTitle>

<div class="certificate-page">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none mb-3">
            <div class="bg-white p-3 shadow-sm">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-dark p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <h5 class="mb-0 flex-grow-1">Certificate</h5>
                    <div class="dropdown">
                        <button class="btn btn-link text-dark p-0" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-ellipsis-v fa-lg"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <button class="dropdown-item" @onclick="PrintCertificate">
                                    <i class="fas fa-print me-2"></i> Print
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" @onclick="DownloadCertificate">
                                    <i class="fas fa-download me-2"></i> Download PDF
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" @onclick="ShareCertificate">
                                    <i class="fas fa-share-alt me-2"></i> Share
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Desktop Action Buttons -->
        <div class="d-none d-md-block row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <button class="btn btn-outline-light" @onclick="GoBack">
                            <i class="fas fa-arrow-left me-2"></i> Back to Learning
                        </button>
                    </div>
                    <div class="btn-group">
                        <button class="btn btn-outline-light" @onclick="PrintCertificate">
                            <i class="fas fa-print me-2"></i> Print Certificate
                        </button>
                        <button class="btn btn-outline-light" @onclick="DownloadCertificate">
                            <i class="fas fa-download me-2"></i> Download PDF
                        </button>
                        <button class="btn btn-outline-light" @onclick="ShareCertificate">
                            <i class="fas fa-share-alt me-2"></i> Share
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-light" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 text-white">Loading your certificate...</p>
            </div>
        }
        else if (enrollment == null)
        {
            <div class="text-center py-5">
                <div class="certificate-error bg-white p-4 p-md-5 rounded-3 shadow">
                    <i class="fas fa-certificate fa-4x text-muted mb-4"></i>
                    <h3 class="mb-3">Certificate Not Found</h3>
                    <p class="text-muted mb-4">We couldn't find the certificate you're looking for.</p>
                    <button class="btn btn-primary" @onclick="GoBack">
                        <i class="fas fa-arrow-left me-2"></i> Return to Learning
                    </button>
                </div>
            </div>
        }
        else if (!enrollment.IsCompleted)
        {
            <div class="text-center py-5">
                <div class="certificate-incomplete bg-white p-4 p-md-5 rounded-3 shadow">
                    <i class="fas fa-clock fa-4x text-warning mb-4"></i>
                    <h3 class="mb-3">Course In Progress</h3>
                    <p class="text-muted mb-4">Complete your course to unlock this certificate!</p>
                    <div class="progress mb-3" style="height: 20px; max-width: 300px; margin: 0 auto;">
                        <div class="progress-bar bg-success" role="progressbar"
                             style="width: @enrollment.ProgressPercentage%"
                             aria-valuenow="@enrollment.ProgressPercentage"
                             aria-valuemin="0" aria-valuemax="100">
                            @enrollment.ProgressPercentage.ToString("0.0")%
                        </div>
                    </div>
                    <button class="btn btn-primary" @onclick="ContinueLearning">
                        <i class="fas fa-play me-2"></i> Continue Learning
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Certificate Display - Mobile Optimized -->
            <div class="d-block d-md-none">
                <div class="certificate-wrapper-mobile">
                    <div class="certificate-content-mobile" id="certificate-content-mobile">
                        <!-- Mobile Certificate Header -->
                        <div class="text-center mb-4">
                            <div class="mobile-logo mb-3">
                                <i class="fas fa-graduation-cap fa-3x text-primary"></i>
                            </div>
                            <h4 class="fw-bold mb-1">Learning Academy</h4>
                            <p class="small text-muted">Excellence in Education</p>
                        </div>

                        <!-- Mobile Certificate Title -->
                        <div class="text-center mb-4">
                            <h5 class="text-uppercase text-primary mb-2" style="letter-spacing: 2px;">Certificate of Completion</h5>
                            <p class="small text-muted">This is to certify that</p>
                        </div>

                        <!-- Mobile Student Name -->
                        <div class="text-center mb-4">
                            <h3 class="student-name-mobile">@currentUser?.FirstName.ToUpper() @currentUser?.LastName.ToUpper()</h3>
                        </div>

                        <!-- Mobile Completion Statement -->
                        <div class="text-center mb-4">
                            <p class="small text-muted">has successfully completed</p>
                            <h5 class="course-title-mobile fw-bold">"@GetEnrollmentTitle()"</h5>
                        </div>

                        <!-- Mobile Details -->
                        <div class="bg-light p-3 rounded-3 mb-4">
                            <p class="small mb-2 text-center text-muted">@GetCourseDetails()</p>
                        </div>

                        <!-- Mobile Dates -->
                        <div class="row g-2 mb-4">
                            <div class="col-6">
                                <div class="bg-light p-2 rounded-3 text-center">
                                    <small class="text-muted d-block">Completed On</small>
                                    <strong>@enrollment.CompletedDate?.ToString("MMM dd, yyyy")</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-light p-2 rounded-3 text-center">
                                    <small class="text-muted d-block">Certificate ID</small>
                                    <strong>CERT-@enrollment.Id.ToString("D6")</strong>
                                </div>
                            </div>
                        </div>

                        <!-- Mobile Signatures -->
                        <div class="row g-3 mb-4">
                            <div class="col-4 text-center">
                                <div class="signature-line-mobile"></div>
                                <small class="fw-bold d-block">@currentUser?.FirstName</small>
                                <small class="text-muted">Student</small>
                            </div>
                            <div class="col-4 text-center">
                                <div class="signature-line-mobile"></div>
                                <small class="fw-bold d-block">@GetInstructorName().Split(' ')[0]</small>
                                <small class="text-muted">Instructor</small>
                            </div>
                            <div class="col-4 text-center">
                                <div class="signature-line-mobile"></div>
                                <small class="fw-bold d-block">J. Wilson</small>
                                <small class="text-muted">Dean</small>
                            </div>
                        </div>

                        <!-- Mobile Verification -->
                        <div class="text-center">
                            <small class="text-muted d-block">verify.learningacademy.com/@enrollment.Id</small>
                            <div class="qr-small d-inline-block mt-2">
                                <i class="fas fa-qrcode fa-2x text-muted"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Desktop Certificate Display -->
            <div class="d-none d-md-block row justify-content-center">
                <div class="col-xxl-10">
                    <div class="certificate-wrapper" id="certificate-content">
                        <!-- Certificate Border Design -->
                        <div class="certificate-border">
                            <!-- Ornate Border -->
                            <div class="border-top-left"></div>
                            <div class="border-top-right"></div>
                            <div class="border-bottom-left"></div>
                            <div class="border-bottom-right"></div>

                            <!-- Certificate Content -->
                            <div class="certificate-content">
                                <!-- Certificate Header -->
                                <div class="certificate-header text-center">
                                    <div class="institution-logo">
                                        <div class="logo-circle">
                                            <i class="fas fa-graduation-cap"></i>
                                        </div>
                                        <h2 class="institution-name mb-0">Learning Academy</h2>
                                        <p class="institution-tagline text-muted">Excellence in Education</p>
                                    </div>
                                </div>

                                <!-- Certificate Title -->
                                <div class="certificate-title-section text-center my-5">
                                    <h1 class="certificate-main-title">CERTIFICATE OF COMPLETION</h1>
                                    <p class="certificate-subtitle">This is to certify that</p>
                                </div>

                                <!-- Student Name -->
                                <div class="student-name-section text-center my-5">
                                    <h2 class="student-name">@currentUser?.FirstName.ToUpper() @currentUser?.LastName.ToUpper()</h2>
                                </div>

                                <!-- Completion Statement -->
                                <div class="completion-statement text-center my-5">
                                    <p class="statement-text">
                                        has successfully completed the requirements for
                                    </p>
                                </div>

                                <!-- Course Title -->
                                <div class="course-title-section text-center my-5">
                                    <h3 class="course-title">"@GetEnrollmentTitle().ToUpper()"</h3>
                                </div>

                                <!-- Course Details -->
                                <div class="course-details-section text-center my-5">
                                    <p class="details-text">
                                        @GetCourseDetails()
                                    </p>
                                </div>

                                <!-- Dates Section -->
                                <div class="dates-section my-5">
                                    <div class="row justify-content-center">
                                        <div class="col-md-4 text-center">
                                            <div class="date-box">
                                                <p class="date-label">Completed On</p>
                                                <p class="date-value">@enrollment.CompletedDate?.ToString("MMMM dd, yyyy")</p>
                                            </div>
                                        </div>
                                        <div class="col-md-4 text-center">
                                            <div class="date-box">
                                                <p class="date-label">Certificate ID</p>
                                                <p class="date-value">CERT-@enrollment.Id.ToString("D6")</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Signatures -->
                                <div class="signatures-section mt-5 pt-5">
                                    <div class="row">
                                        <div class="col-md-4 text-center">
                                            <div class="signature-line"></div>
                                            <p class="signature-name">@currentUser?.FirstName @currentUser?.LastName</p>
                                            <p class="signature-title">Student</p>
                                        </div>
                                        <div class="col-md-4 text-center">
                                            <div class="signature-line"></div>
                                            <p class="signature-name">@GetInstructorName()</p>
                                            <p class="signature-title">Instructor</p>
                                        </div>
                                        <div class="col-md-4 text-center">
                                            <div class="signature-line"></div>
                                            <p class="signature-name">DR. JAMES WILSON</p>
                                            <p class="signature-title">Dean of Academic Affairs</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Official Seal -->
                                <div class="official-seal">
                                    <div class="seal-circle">
                                        <div class="seal-inner">
                                            <span class="seal-text">OFFICIAL</span>
                                            <span class="seal-year">@DateTime.Now.Year</span>
                                        </div>
                                        <div class="seal-center">
                                            <i class="fas fa-award"></i>
                                        </div>
                                    </div>
                                </div>

                                <!-- Verification -->
                                <div class="verification-section text-center mt-4">
                                    <p class="verification-text">
                                        Verify this certificate at: <strong>verify.learningacademy.com/@enrollment.Id</strong>
                                    </p>
                                    <div class="verification-qr">
                                        <div class="qr-placeholder">
                                            <i class="fas fa-qrcode fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Info Panel -->
            <div class="d-block d-md-none mt-4">
                <div class="bg-white p-3 rounded-3 shadow-sm">
                    <h6 class="mb-3"><i class="fas fa-info-circle me-2 text-primary"></i>Certificate Details</h6>
                    <div class="row g-2">
                        <div class="col-6">
                            <small class="text-muted d-block">Student ID</small>
                            <strong>STU-@currentUser?.Id.ToString("D6")</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Credential Type</small>
                            <strong>@GetCredentialType()</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Price Paid</small>
                            <strong>$@enrollment.PricePaid.ToString("N2")</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Duration</small>
                            <strong>@GetDuration()</strong>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-3 rounded-3 shadow-sm mt-3">
                    <h6 class="mb-3"><i class="fas fa-share-alt me-2 text-success"></i>Share</h6>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary btn-sm flex-fill" @onclick="ShareLinkedIn">
                            <i class="fab fa-linkedin"></i>
                        </button>
                        <button class="btn btn-outline-info btn-sm flex-fill" @onclick="ShareTwitter">
                            <i class="fab fa-twitter"></i>
                        </button>
                        <button class="btn btn-outline-success btn-sm flex-fill" @onclick="CopyCertificateLink">
                            <i class="fas fa-link"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Desktop Info Panel -->
            <div class="d-none d-md-block certificate-info-panel mt-5">
                <div class="row">
                    <div class="col-md-8">
                        <div class="info-card">
                            <h5><i class="fas fa-info-circle me-2"></i> Certificate Details</h5>
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <table class="table table-sm">
                                        <tbody>
                                            <tr>
                                                <td><strong>Certificate ID:</strong></td>
                                                <td>CERT-@enrollment.Id.ToString("D6")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Issue Date:</strong></td>
                                                <td>@DateTime.Now.ToString("MMMM dd, yyyy")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Student ID:</strong></td>
                                                <td>STU-@currentUser?.Id.ToString("D6")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Credential Type:</strong></td>
                                                <td>@GetCredentialType()</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-sm">
                                        <tbody>
                                            <tr>
                                                <td><strong>Completion Date:</strong></td>
                                                <td>@enrollment.CompletedDate?.ToString("MMMM dd, yyyy")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Progress:</strong></td>
                                                <td>@enrollment.ProgressPercentage.ToString("0.0")%</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Price Paid:</strong></td>
                                                <td>$@enrollment.PricePaid.ToString("N2")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Duration:</strong></td>
                                                <td>@GetDuration()</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="action-card">
                            <h5><i class="fas fa-share-alt me-2"></i> Share Your Achievement</h5>
                            <div class="d-grid gap-2 mt-3">
                                <button class="btn btn-outline-primary" @onclick="ShareLinkedIn">
                                    <i class="fab fa-linkedin me-2"></i> Share on LinkedIn
                                </button>
                                <button class="btn btn-outline-info" @onclick="ShareTwitter">
                                    <i class="fab fa-twitter me-2"></i> Share on Twitter
                                </button>
                                <button class="btn btn-outline-success" @onclick="CopyCertificateLink">
                                    <i class="fas fa-link me-2"></i> Copy Certificate Link
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Mobile Styles */
    .certificate-wrapper-mobile {
        background: white;
        border-radius: 15px;
        padding: 20px;
        margin: 10px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
    }

    .certificate-content-mobile {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .student-name-mobile {
        font-family: 'Great Vibes', cursive;
        font-size: 2rem;
        color: #2c3e50;
        margin: 0;
        padding: 0 10px;
    }

    .course-title-mobile {
        font-size: 1.2rem;
        color: #667eea;
        margin: 0;
    }

    .signature-line-mobile {
        width: 60px;
        height: 1px;
        background: #2c3e50;
        margin: 5px auto;
    }

    .qr-small {
        width: 50px;
        height: 50px;
        background: #f8f9fa;
        border: 1px solid #ddd;
        border-radius: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Desktop Styles */
    .certificate-page {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 30px 0;
    }

    .certificate-wrapper {
        background: white;
        border-radius: 15px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        overflow: hidden;
        margin-bottom: 30px;
    }

    .certificate-border {
        position: relative;
        padding: 50px;
        background: white;
        border: 20px solid transparent;
        border-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><rect x="0" y="0" width="100" height="100" fill="none" stroke="%23d4af37" stroke-width="2"/><circle cx="50" cy="50" r="40" fill="none" stroke="%23d4af37" stroke-width="1" stroke-dasharray="5,5"/></svg>') 30 stretch;
        min-height: 800px;
    }

    .border-top-left,
    .border-top-right,
    .border-bottom-left,
    .border-bottom-right {
        position: absolute;
        width: 100px;
        height: 100px;
        background: #f8f9fa;
    }

    .border-top-left {
        top: -20px;
        left: -20px;
        border-bottom-right-radius: 50%;
    }

    .border-top-right {
        top: -20px;
        right: -20px;
        border-bottom-left-radius: 50%;
    }

    .border-bottom-left {
        bottom: -20px;
        left: -20px;
        border-top-right-radius: 50%;
    }

    .border-bottom-right {
        bottom: -20px;
        right: -20px;
        border-top-left-radius: 50%;
    }

    .certificate-content {
        position: relative;
        z-index: 1;
    }

    .institution-logo {
        margin-bottom: 40px;
    }

    .logo-circle {
        width: 120px;
        height: 120px;
        margin: 0 auto 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 5px solid #d4af37;
    }

        .logo-circle i {
            font-size: 50px;
            color: white;
        }

    .institution-name {
        font-family: 'Times New Roman', Times, serif;
        font-size: 2.5rem;
        color: #2c3e50;
        letter-spacing: 2px;
    }

    .institution-tagline {
        font-family: Georgia, serif;
        font-style: italic;
        letter-spacing: 1px;
    }

    .certificate-main-title {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        color: #d4af37;
        letter-spacing: 5px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        position: relative;
        display: inline-block;
    }

        .certificate-main-title::before,
        .certificate-main-title::after {
            content: "✧";
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            color: #d4af37;
            font-size: 2rem;
        }

        .certificate-main-title::before {
            left: -60px;
        }

        .certificate-main-title::after {
            right: -60px;
        }

    .certificate-subtitle {
        font-family: Georgia, serif;
        font-size: 1.2rem;
        color: #666;
        letter-spacing: 1px;
        margin-top: 10px;
    }

    .student-name {
        font-family: 'Great Vibes', cursive;
        font-size: 3.5rem;
        color: #2c3e50;
        margin: 0;
        padding: 10px 40px;
        display: inline-block;
        position: relative;
    }

        .student-name::before,
        .student-name::after {
            content: "";
            position: absolute;
            top: 50%;
            width: 40px;
            height: 2px;
            background: #d4af37;
        }

        .student-name::before {
            left: 0;
        }

        .student-name::after {
            right: 0;
        }

    .statement-text {
        font-family: Georgia, serif;
        font-size: 1.3rem;
        color: #444;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.8;
    }

    .course-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.2rem;
        color: #2c3e50;
        font-style: italic;
        padding: 20px 40px;
        background: linear-gradient(to right, transparent, #f8f9fa, transparent);
        border-left: 4px solid #d4af37;
        border-right: 4px solid #d4af37;
        display: inline-block;
    }

    .details-text {
        font-family: Georgia, serif;
        font-size: 1.1rem;
        color: #555;
        max-width: 700px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .date-box {
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
        border-top: 3px solid #d4af37;
    }

    .date-label {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 0.9rem;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }

    .date-value {
        font-family: 'Courier New', monospace;
        font-size: 1.1rem;
        color: #2c3e50;
        font-weight: bold;
    }

    .signatures-section {
        border-top: 2px solid #eee;
        padding-top: 30px;
    }

    .signature-line {
        width: 200px;
        height: 1px;
        background: #2c3e50;
        margin: 0 auto 10px;
    }

    .signature-name {
        font-family: 'Brush Script MT', cursive;
        font-size: 1.8rem;
        color: #2c3e50;
        margin-bottom: 5px;
    }

    .signature-title {
        font-family: Georgia, serif;
        font-size: 0.9rem;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .official-seal {
        position: absolute;
        bottom: 50px;
        right: 50px;
    }

    .seal-circle {
        width: 150px;
        height: 150px;
        background: radial-gradient(circle, #d4af37 0%, #b8941f 100%);
        border-radius: 50%;
        border: 8px solid #2c3e50;
        position: relative;
        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
    }

