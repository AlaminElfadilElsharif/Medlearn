@code {
    // ... (keep all your existing code in the @code block exactly as is)
    [Parameter] public int EnrollmentId { get; set; }

    private EnrollmentDto? enrollment;
    private UserDto? currentUser;
    private LectureDto? fullLecture;
    private CourseDto? fullCourse;
    private SpecializationDto? fullSpecialization;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadCertificateData();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (EnrollmentId > 0)
        {
            await LoadCertificateData();
        }
    }

    private async Task LoadCertificateData()
    {
        isLoading = true;

        try
        {
            currentUser = await AuthService.GetCurrentUserAsync();

            var enrollments = await EnrollmentService.GetMyEnrollmentsAsync();

            if (enrollments != null)
            {
                enrollment = enrollments.FirstOrDefault(e => e.Id == EnrollmentId);

                if (enrollment != null)
                {
                    await LoadAdditionalContext();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading certificate: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAdditionalContext()
    {
        if (enrollment == null) return;

        try
        {
            if (enrollment.EnrollmentType == EnrollmentType.Lecture && enrollment.LectureId.HasValue)
            {
                fullLecture = await LectureService.GetLectureAsync(enrollment.LectureId.Value);

                if (fullLecture != null && fullLecture.CourseId > 0)
                {
                    fullCourse = await CourseService.GetCourseAsync(fullLecture.CourseId);

                    if (fullCourse != null && fullCourse.SpecializationId > 0)
                    {
                        fullSpecialization = await SpecializationService.GetSpecializationAsync(fullCourse.SpecializationId);
                    }
                }
            }
            else if (enrollment.EnrollmentType == EnrollmentType.Course && enrollment.CourseId.HasValue)
            {
                fullCourse = await CourseService.GetCourseAsync(enrollment.CourseId.Value);

                if (fullCourse != null && fullCourse.SpecializationId > 0)
                {
                    fullSpecialization = await SpecializationService.GetSpecializationAsync(fullCourse.SpecializationId);
                }
            }
            else if (enrollment.EnrollmentType == EnrollmentType.Specialization && enrollment.SpecializationId.HasValue)
            {
                fullSpecialization = await SpecializationService.GetSpecializationAsync(enrollment.SpecializationId.Value);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading additional context: {ex.Message}");
        }
    }

    private string GetEnrollmentTitle()
    {
        if (enrollment == null) return "Course";

        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => enrollment.Specialization?.Title ?? "Specialization",
            EnrollmentType.Course => enrollment.Course?.Title ?? "Course",
            EnrollmentType.Lecture => enrollment.Lecture?.Title ?? "Lecture",
            _ => "Course"
        };
    }

    private string GetCourseDetails()
    {
        if (enrollment == null) return string.Empty;

        var details = new List<string>();

        if (enrollment.EnrollmentType == EnrollmentType.Specialization)
        {
            if (enrollment.Specialization != null)
            {
                details.Add($"A comprehensive specialization program consisting of {enrollment.Specialization.EstimatedDurationHours} hours of expert-led instruction.");
                details.Add($"This program includes advanced coursework in specialized areas and demonstrates mastery of key concepts.");
            }
        }
        else if (enrollment.EnrollmentType == EnrollmentType.Course)
        {
            if (enrollment.Course != null)
            {
                details.Add($"An intensive course requiring {enrollment.Course.Lectures?.Sum(l => l.EstimatedDurationMinutes) / 60} hours of dedicated study.");
                if (enrollment.Course.SpecializationId > 0)
                {
                    details.Add($"Part of the '{enrollment.Specialization?.Title ?? "Advanced Learning"}' specialization program.");
                }
            }
        }
        else if (enrollment.EnrollmentType == EnrollmentType.Lecture)
        {
            if (enrollment.Lecture != null)
            {
                details.Add($"A specialized lecture of {enrollment.Lecture.EstimatedDurationMinutes} minutes duration.");
                if (fullCourse != null)
                {
                    details.Add($"Part of the '{fullCourse.Title}' course.");
                    if (fullSpecialization != null)
                    {
                        details.Add($"Within the '{fullSpecialization.Title}' specialization.");
                    }
                }
            }
        }

        return string.Join(" ", details);
    }

    private string GetCredentialType()
    {
        if (enrollment == null) return "Course Completion";

        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => "Specialization Certificate",
            EnrollmentType.Course => "Course Completion",
            EnrollmentType.Lecture => "Lecture Completion",
            _ => "Course Completion"
        };
    }

    private string GetDuration()
    {
        if (enrollment == null) return "N/A";

        if (enrollment.CompletedDate.HasValue)
        {
            var duration = enrollment.CompletedDate.Value - enrollment.EnrollmentDate;

            if (duration.TotalDays >= 30)
            {
                return $"{Math.Round(duration.TotalDays / 30)} months";
            }
            else if (duration.TotalDays >= 7)
            {
                return $"{Math.Round(duration.TotalDays / 7)} weeks";
            }
            else if (duration.TotalDays >= 1)
            {
                return $"{duration.Days} days";
            }
            else
            {
                return $"{duration.Hours} hours";
            }
        }

        return "N/A";
    }

    private string GetInstructorName()
    {
        if (enrollment == null) return "Prof. John Smith";

        string name = enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization =>
                $"{fullSpecialization?.Doctor?.FirstName ?? enrollment.Specialization?.Doctor?.FirstName} {fullSpecialization?.Doctor?.LastName ?? enrollment.Specialization?.Doctor?.LastName}",
            EnrollmentType.Course =>
                $"{fullCourse?.Doctor?.FirstName ?? enrollment.Course?.Doctor?.FirstName} {fullCourse?.Doctor?.LastName ?? enrollment.Course?.Doctor?.LastName}",
            EnrollmentType.Lecture =>
                $"{fullLecture?.Doctor?.FirstName ?? enrollment.Lecture?.Doctor?.FirstName} {fullLecture?.Doctor?.LastName ?? enrollment.Lecture?.Doctor?.LastName}",
            _ => "Prof. John Smith"
        };

        return string.IsNullOrWhiteSpace(name) || name.Trim() == " " ? "Prof. John Smith" : name.Trim();
    }

    private async Task PrintCertificate()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task DownloadCertificate()
    {
        try
        {
            // For now, use print to PDF
            await JS.InvokeVoidAsync("window.print");

            // You could implement actual PDF generation with a library like jsPDF
            // await JS.InvokeVoidAsync("generatePDF", "certificate-content");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading certificate: {ex.Message}");
        }
    }

    private async Task ShareCertificate()
    {
        try
        {
            var certificateUrl = $"{Navigation.BaseUri}student/certificate/{EnrollmentId}";
            var shareText = $"I just earned my certificate for '{GetEnrollmentTitle()}' from Learning Academy! Check it out: {certificateUrl}";

            await JS.InvokeVoidAsync("navigator.share", new
            {
                title = "My Learning Certificate",
                text = shareText,
                url = certificateUrl
            });
        }
        catch
        {
            // Fallback: Copy to clipboard
            await CopyCertificateLink();
        }
    }

    private async Task ShareLinkedIn()
    {
        var certificateUrl = $"{Navigation.BaseUri}student/certificate/{EnrollmentId}";
        var linkedinUrl = $"https://www.linkedin.com/sharing/share-offsite/?url={Uri.EscapeDataString(certificateUrl)}";
        await JS.InvokeVoidAsync("window.open", linkedinUrl, "_blank");
    }

    private async Task ShareTwitter()
    {
        var certificateUrl = $"{Navigation.BaseUri}student/certificate/{EnrollmentId}";
        var tweetText = $"I just earned my certificate for '{GetEnrollmentTitle()}' from @LearningAcademy!";
        var twitterUrl = $"https://twitter.com/intent/tweet?text={Uri.EscapeDataString(tweetText)}&url={Uri.EscapeDataString(certificateUrl)}";
        await JS.InvokeVoidAsync("window.open", twitterUrl, "_blank");
    }

    private async Task CopyCertificateLink()
    {
        var certificateUrl = $"{Navigation.BaseUri}student/certificate/{EnrollmentId}";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", certificateUrl);
        await ShowToast("success", "Certificate link copied to clipboard!");
    }

    private async Task ShowToast(string type, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", type, message);
        }
        catch
        {
            Console.WriteLine($"{type.ToUpper()}: {message}");
        }
    }

    private void ContinueLearning()
    {
        if (enrollment == null) return;

        switch (enrollment.EnrollmentType)
        {
            case EnrollmentType.Specialization:
                Navigation.NavigateTo($"/student/mylearning/specialization/{enrollment.SpecializationId}");
                break;
            case EnrollmentType.Course:
                Navigation.NavigateTo($"/student/mylearning/course/{enrollment.CourseId}");
                break;
            case EnrollmentType.Lecture:
                Navigation.NavigateTo($"/student/mylearning/lecture/{enrollment.LectureId}");
                break;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/student/mylearning");
    }
}
