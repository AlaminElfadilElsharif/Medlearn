@page "/search"
@using Microsoft.AspNetCore.WebUtilities


<PageTitle>Search Results - MyApp</PageTitle>

<div class="search-results-page">
    <!-- Mobile Search Header (d-block d-md-none) -->
    <div class="d-block d-md-none">
        <div class="bg-primary bg-gradient text-white p-3">
            <div class="d-flex align-items-center mb-3">
                <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                    <i class="fas fa-arrow-left fa-lg"></i>
                </button>
                <h5 class="mb-0 flex-grow-1">Search</h5>
                <span class="badge bg-light text-primary fs-6 p-2">
                    @totalResults results
                </span>
            </div>

            <!-- Mobile Search Box -->
            <div class="search-box-mobile">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fas fa-search text-primary"></i>
                    </span>
                    <input type="text"
                           class="form-control border-start-0 border-end-0"
                           placeholder="Search courses, lectures..."
                           @bind="searchQuery"
                           @bind:event="oninput"
                           @onkeyup="HandleKeyUp" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button class="btn btn-light border-start-0" @onclick="ClearSearch">
                            <i class="fas fa-times text-muted"></i>
                        </button>
                    }
                    <button class="btn btn-light" @onclick="Search">
                        <i class="fas fa-arrow-right text-primary"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Desktop Search Header (d-none d-md-block) -->
    <div class="d-none d-md-block search-header bg-primary bg-gradient text-white py-5 mb-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb bg-transparent p-0 mb-3">
                            <li class="breadcrumb-item">
                                <a href="/" class="text-white-50 text-decoration-none">
                                    <i class="fas fa-home me-1"></i>Home
                                </a>
                            </li>
                            <li class="breadcrumb-item active text-white" aria-current="page">Search Results</li>
                        </ol>
                    </nav>
                    <h1 class="h2 mb-3">Search Results</h1>
                    <div class="d-flex align-items-center">
                        <div class="input-group search-box shadow-sm" style="max-width: 500px;">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text"
                                   class="form-control border-start-0"
                                   placeholder="Continue searching..."
                                   @bind="searchQuery"
                                   @bind:event="oninput"
                                   @onkeyup="HandleKeyUp" />
                            @if (!string.IsNullOrEmpty(searchQuery))
                            {
                                <button class="btn btn-outline-secondary border-start-0" @onclick="ClearSearch">
                                    <i class="fas fa-times"></i>
                                </button>
                            }
                            <button class="btn btn-primary" @onclick="Search">
                                <i class="fas fa-search"></i> Search
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <div class="mt-3 mt-md-0">
                        <span class="badge bg-light text-primary fs-6 p-2">
                            <i class="fas fa-search me-2"></i>
                            Showing results for: <strong>"@searchQuery"</strong>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container-fluid px-0 px-md-3">
        <div class="row g-0 g-md-3">
            <!-- Mobile Filter Bar (d-block d-md-none) -->
            <div class="d-block d-md-none">
                <div class="bg-white border-bottom p-2">
                    <div class="d-flex gap-2 overflow-auto filter-scroll">
                        <button class="btn btn-sm @(searchType == "all" ? "btn-primary" : "btn-outline-primary") rounded-pill px-3"
                                @onclick="@(() => SetSearchType("all"))">
                            <i class="fas fa-th-large me-1"></i>All
                            <span class="badge bg-light text-dark ms-1">@totalResults</span>
                        </button>
                        <button class="btn btn-sm @(searchType == "specializations" ? "btn-primary" : "btn-outline-primary") rounded-pill px-3"
                                @onclick="@(() => SetSearchType("specializations"))">
                            <i class="fas fa-layer-group me-1"></i>Specializations
                            <span class="badge bg-light text-dark ms-1">@specializationsCount</span>
                        </button>
                        <button class="btn btn-sm @(searchType == "courses" ? "btn-primary" : "btn-outline-primary") rounded-pill px-3"
                                @onclick="@(() => SetSearchType("courses"))">
                            <i class="fas fa-book-open me-1"></i>Courses
                            <span class="badge bg-light text-dark ms-1">@coursesCount</span>
                        </button>
                        <button class="btn btn-sm @(searchType == "lectures" ? "btn-primary" : "btn-outline-primary") rounded-pill px-3"
                                @onclick="@(() => SetSearchType("lectures"))">
                            <i class="fas fa-play-circle me-1"></i>Lectures
                            <span class="badge bg-light text-dark ms-1">@lecturesCount</span>
                        </button>
                    </div>
                </div>

                <!-- Mobile Filter & Sort Actions -->
                <div class="bg-light p-2 d-flex justify-content-between">
                    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#filterModal">
                        <i class="fas fa-filter me-1"></i>Filters
                    </button>
                    <div class="btn-group">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => SetViewMode("grid"))">
                            <i class="fas @(viewMode == "grid" ? "fa-th-large text-primary" : "fa-th-large")"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => SetViewMode("list"))">
                            <i class="fas @(viewMode == "list" ? "fa-list text-primary" : "fa-list")"></i>
                        </button>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                        <i class="fas fa-sort me-1"></i>@GetSortByLabel()
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><button class="dropdown-item @(sortBy == "relevance" ? "active" : "")" @onclick="@(() => SetSortBy("relevance"))">Relevance</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item @(sortBy == "newest" ? "active" : "")" @onclick="@(() => SetSortBy("newest"))">Newest</button></li>
                        <li><button class="dropdown-item @(sortBy == "price_low" ? "active" : "")" @onclick="@(() => SetSortBy("price_low"))">Price: Low to High</button></li>
                        <li><button class="dropdown-item @(sortBy == "price_high" ? "active" : "")" @onclick="@(() => SetSortBy("price_high"))">Price: High to Low</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item @(sortBy == "popular" ? "active" : "")" @onclick="@(() => SetSortBy("popular"))">Most Popular</button></li>
                        <li><button class="dropdown-item @(sortBy == "rating" ? "active" : "")" @onclick="@(() => SetSortBy("rating"))">Highest Rated</button></li>
                    </ul>
                </div>

                <!-- Mobile Filter Modal -->
                <div class="modal fade" id="filterModal" tabindex="-1">
                    <div class="modal-dialog modal-dialog-bottom">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Filters</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <!-- Price Filter (Mobile) -->
                                <div class="mb-4">
                                    <h6 class="fw-bold mb-3">Price Range</h6>
                                    <div class="btn-group-vertical w-100">
                                        <button class="btn @(priceFilter == "all" ? "btn-primary" : "btn-outline-primary") text-start"
                                                @onclick="@(() => { SetPriceFilter("all"); JS.InvokeVoidAsync("hideModal", "#filterModal"); })">
                                            <i class="fas fa-dollar-sign me-2"></i>All Prices
                                        </button>
                                        <button class="btn @(priceFilter == "free" ? "btn-primary" : "btn-outline-primary") text-start"
                                                @onclick="@(() => { SetPriceFilter("free"); JS.InvokeVoidAsync("hideModal", "#filterModal"); })">
                                            <i class="fas fa-gift me-2"></i>Free Only
                                        </button>
                                        <button class="btn @(priceFilter == "paid" ? "btn-primary" : "btn-outline-primary") text-start"
                                                @onclick="@(() => { SetPriceFilter("paid"); JS.InvokeVoidAsync("hideModal", "#filterModal"); })">
                                            <i class="fas fa-credit-card me-2"></i>Paid Only
                                        </button>
                                        <button class="btn @(priceFilter == "under50" ? "btn-primary" : "btn-outline-primary") text-start"
                                                @onclick="@(() => { SetPriceFilter("under50"); JS.InvokeVoidAsync("hideModal", "#filterModal"); })">
                                            <i class="fas fa-coins me-2"></i>Under $50
                                        </button>
                                        <button class="btn @(priceFilter == "under100" ? "btn-primary" : "btn-outline-primary") text-start"
                                                @onclick="@(() => { SetPriceFilter("under100"); JS.InvokeVoidAsync("hideModal", "#filterModal"); })">
                                            <i class="fas fa-money-bill-wave me-2"></i>Under $100
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    Cancel
                                </button>
                                <button class="btn btn-primary" @onclick="ResetFilters" data-bs-dismiss="modal">
                                    Reset All Filters
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Desktop Filters Sidebar (d-none d-md-block) -->
            <div class="d-none d-md-block col-lg-3 mb-4">
                <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                    <div class="card-body">
                        <h5 class="card-title mb-3">
                            <i class="fas fa-filter me-2 text-primary"></i>Filters
                        </h5>

                        <!-- Content Type Filter -->
                        <div class="mb-4">
                            <h6 class="text-muted mb-2">
                                <i class="fas fa-layer-group me-1"></i>Content Type
                            </h6>
                            <div class="list-group list-group-flush">
                                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 py-2 px-0 @(searchType == "all" ? "active" : "")"
                                        @onclick="@(() => SetSearchType("all"))">
                                    <span>
                                        <i class="fas fa-th-large me-2"></i>All Content
                                    </span>
                                    @if (searchType == "all")
                                    {
                                        <span class="badge bg-primary rounded-pill">@totalResults</span>
                                    }
                                </button>
                                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 py-2 px-0 @(searchType == "specializations" ? "active" : "")"
                                        @onclick="@(() => SetSearchType("specializations"))">
                                    <span>
                                        <i class="fas fa-layer-group me-2"></i>Specializations
                                    </span>
                                    @if (searchType == "specializations")
                                    {
                                        <span class="badge bg-primary rounded-pill">@specializationsCount</span>
                                    }
                                </button>
                                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 py-2 px-0 @(searchType == "courses" ? "active" : "")"
                                        @onclick="@(() => SetSearchType("courses"))">
                                    <span>
                                        <i class="fas fa-book-open me-2"></i>Courses
                                    </span>
                                    @if (searchType == "courses")
                                    {
                                        <span class="badge bg-primary rounded-pill">@coursesCount</span>
                                    }
                                </button>
                                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 py-2 px-0 @(searchType == "lectures" ? "active" : "")"
                                        @onclick="@(() => SetSearchType("lectures"))">
                                    <span>
                                        <i class="fas fa-play-circle me-2"></i>Lectures
                                    </span>
                                    @if (searchType == "lectures")
                                    {
                                        <span class="badge bg-primary rounded-pill">@lecturesCount</span>
                                    }
                                </button>
                            </div>
                        </div>

                        <!-- Price Filter -->
                        <div class="mb-4">
                            <h6 class="text-muted mb-2">
                                <i class="fas fa-tag me-1"></i>Price Range
                            </h6>
                            <div class="list-group list-group-flush">
                                <button class="list-group-item list-group-item-action border-0 py-2 px-0 @(priceFilter == "all" ? "active" : "")"
                                        @onclick="@(() => SetPriceFilter("all"))">
                                    <i class="fas fa-dollar-sign me-2"></i>All Prices
                                </button>
                                <button class="list-group-item list-group-item-action border-0 py-2 px-0 @(priceFilter == "free" ? "active" : "")"
                                        @onclick="@(() => SetPriceFilter("free"))">
                                    <i class="fas fa-gift me-2"></i>Free Only
                                </button>
                                <button class="list-group-item list-group-item-action border-0 py-2 px-0 @(priceFilter == "paid" ? "active" : "")"
                                        @onclick="@(() => SetPriceFilter("paid"))">
                                    <i class="fas fa-credit-card me-2"></i>Paid Only
                                </button>
                                <button class="list-group-item list-group-item-action border-0 py-2 px-0 @(priceFilter == "under50" ? "active" : "")"
                                        @onclick="@(() => SetPriceFilter("under50"))">
                                    <i class="fas fa-coins me-2"></i>Under $50
                                </button>
                                <button class="list-group-item list-group-item-action border-0 py-2 px-0 @(priceFilter == "under100" ? "active" : "")"
                                        @onclick="@(() => SetPriceFilter("under100"))">
                                    <i class="fas fa-money-bill-wave me-2"></i>Under $100
                                </button>
                            </div>
                        </div>

                        <!-- Sort Options (Desktop) -->
                        <div class="mb-4">
                            <h6 class="text-muted mb-2">
                                <i class="fas fa-sort me-1"></i>Sort By
                            </h6>
                            <div class="list-group list-group-flush">
                                <button class="list-group-item list-group-item-action border-0 py-2 px-0 @(sortBy == "relevance" ? "active" : "")"
                                        @onclick="@(() => SetSortBy("relevance"))">
                                    <i class="fas fa-bullseye me-2"></i>Relevance
                                </button>
                                <button class="list-group-item list-group-item-action border-0 py-2 px-0 @(sortBy == "newest" ? "active" : "")"
                                        @onclick="@(() => SetSortBy("newest"))">
                                    <i class="fas fa-clock me-2"></i>Newest
                                </button>
                                <button class="list-group-item list-group-item-action border-0 py-2 px-0 @(sortBy == "price_low" ? "active" : "")"
                                        @onclick="@(() => SetSortBy("price_low"))">
                                    <i class="fas fa-sort-amount-down me-2"></i>Price: Low to High
                                </button>
                                <button class="list-group-item list-group-item-action border-0 py-2 px-0 @(sortBy == "price_high" ? "active" : "")"
                                        @onclick="@(() => SetSortBy("price_high"))">
                                    <i class="fas fa-sort-amount-up me-2"></i>Price: High to Low
                                </button>
                                <button class="list-group-item list-group-item-action border-0 py-2 px-0 @(sortBy == "popular" ? "active" : "")"
                                        @onclick="@(() => SetSortBy("popular"))">
                                    <i class="fas fa-fire me-2"></i>Most Popular
                                </button>
                                <button class="list-group-item list-group-item-action border-0 py-2 px-0 @(sortBy == "rating" ? "active" : "")"
                                        @onclick="@(() => SetSortBy("rating"))">
                                    <i class="fas fa-star me-2"></i>Highest Rated
                                </button>
                            </div>
                        </div>

                        <!-- Reset Filters -->
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary" @onclick="ResetFilters">
                                <i class="fas fa-redo me-2"></i>Reset All Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results Column (Shared) -->
            <div class="col-lg-9">
                <!-- Desktop Results Header (d-none d-md-flex) -->
                <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="h4 mb-1">Search Results</h2>
                        <p class="text-muted mb-0">
                            @if (isLoading)
                            {
                                <span>Searching...</span>
                            }
                            else
                            {
                                <span>Found <strong>@totalResults</strong> results for "<strong>@searchQuery</strong>"</span>
                            }
                        </p>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="dropdown me-3">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-sort me-2"></i>
                                @GetSortByLabel()
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <button class="dropdown-item @(sortBy == "relevance" ? "active" : "")"
                                            @onclick="@(() => SetSortBy("relevance"))">
                                        <i class="fas fa-bullseye me-2"></i>Relevance
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item @(sortBy == "newest" ? "active" : "")"
                                            @onclick="@(() => SetSortBy("newest"))">
                                        <i class="fas fa-clock me-2"></i>Newest
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item @(sortBy == "price_low" ? "active" : "")"
                                            @onclick="@(() => SetSortBy("price_low"))">
                                        <i class="fas fa-sort-amount-down me-2"></i>Price: Low to High
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item @(sortBy == "price_high" ? "active" : "")"
                                            @onclick="@(() => SetSortBy("price_high"))">
                                        <i class="fas fa-sort-amount-up me-2"></i>Price: High to Low
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item @(sortBy == "popular" ? "active" : "")"
                                            @onclick="@(() => SetSortBy("popular"))">
                                        <i class="fas fa-fire me-2"></i>Most Popular
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item @(sortBy == "rating" ? "active" : "")"
                                            @onclick="@(() => SetSortBy("rating"))">
                                        <i class="fas fa-star me-2"></i>Highest Rated
                                    </button>
                                </li>
                            </ul>
                        </div>
                        <div class="btn-group" role="group">
                            <button class="btn btn-outline-secondary @(viewMode == "grid" ? "active" : "")"
                                    @onclick="@(() => SetViewMode("grid"))" title="Grid View">
                                <i class="fas fa-th-large"></i>
                            </button>
                            <button class="btn btn-outline-secondary @(viewMode == "list" ? "active" : "")"
                                    @onclick="@(() => SetViewMode("list"))" title="List View">
                                <i class="fas fa-list"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Mobile Results Info -->
                <div class="d-block d-md-none px-3 py-2">
                    <p class="text-muted mb-0 small">
                        @if (isLoading)
                        {
                            <span>Searching...</span>
                        }
                        else
                        {
                            <span>Found <strong>@totalResults</strong> results</span>
                        }
                    </p>
                </div>

                <!-- Results Content (Shared but responsive card layouts) -->
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 text-muted">Searching for "@searchQuery"...</p>
                    </div>
                }
                else if (searchResults != null && totalResults > 0)
                {
                    <!-- Mobile Results Tabs -->
                    <div class="d-block d-md-none px-3 mb-3">
                        <div class="d-flex gap-2 overflow-auto filter-scroll pb-2">
                            @if (searchType == "all" || searchType == "specializations")
                            {
                                <button class="btn btn-sm @(activeResultsTab == "specializations" ? "btn-primary" : "btn-outline-primary") rounded-pill px-3"
                                        @onclick="@(() => SwitchResultsTab("specializations"))">
                                    <i class="fas fa-layer-group me-1"></i>Specializations
                                    <span class="badge bg-light text-dark ms-1">@displayedSpecializationsCount</span>
                                </button>
                            }
                            @if (searchType == "all" || searchType == "courses")
                            {
                                <button class="btn btn-sm @(activeResultsTab == "courses" ? "btn-primary" : "btn-outline-primary") rounded-pill px-3"
                                        @onclick="@(() => SwitchResultsTab("courses"))">
                                    <i class="fas fa-book-open me-1"></i>Courses
                                    <span class="badge bg-light text-dark ms-1">@displayedCoursesCount</span>
                                </button>
                            }
                            @if (searchType == "all" || searchType == "lectures")
                            {
                                <button class="btn btn-sm @(activeResultsTab == "lectures" ? "btn-primary" : "btn-outline-primary") rounded-pill px-3"
                                        @onclick="@(() => SwitchResultsTab("lectures"))">
                                    <i class="fas fa-play-circle me-1"></i>Lectures
                                    <span class="badge bg-light text-dark ms-1">@displayedLecturesCount</span>
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Desktop Results Tabs -->
                    <div class="d-none d-md-block mb-4">
                        <ul class="nav nav-tabs" id="resultsTabs" role="tablist">
                            @if (searchType == "all" || searchType == "specializations")
                            {
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link @(activeResultsTab == "specializations" ? "active" : "")"
                                            @onclick="@(() => SwitchResultsTab("specializations"))">
                                        <i class="fas fa-layer-group me-2"></i>
                                        Specializations
                                        <span class="badge bg-primary rounded-pill ms-2">@displayedSpecializationsCount</span>
                                    </button>
                                </li>
                            }
                            @if (searchType == "all" || searchType == "courses")
                            {
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link @(activeResultsTab == "courses" ? "active" : "")"
                                            @onclick="@(() => SwitchResultsTab("courses"))">
                                        <i class="fas fa-book-open me-2"></i>
                                        Courses
                                        <span class="badge bg-primary rounded-pill ms-2">@displayedCoursesCount</span>
                                    </button>
                                </li>
                            }
                            @if (searchType == "all" || searchType == "lectures")
                            {
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link @(activeResultsTab == "lectures" ? "active" : "")"
                                            @onclick="@(() => SwitchResultsTab("lectures"))">
                                        <i class="fas fa-play-circle me-2"></i>
                                        Lectures
                                        <span class="badge bg-primary rounded-pill ms-2">@displayedLecturesCount</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Tab Content (Shared) -->
                    <div class="tab-content px-3 px-md-0">
                        <!-- Specializations Tab -->
                        @if (searchType == "all" || searchType == "specializations")
                        {
                            <div class="tab-pane fade @(activeResultsTab == "specializations" ? "show active" : "")">
                                @if (displayedSpecializations.Any())
                                {
                                    @if (viewMode == "grid")
                                    {
                                        <!-- Mobile Grid (2 columns) / Desktop Grid (3 columns) -->
