    private SearchResultsDto? searchResults;
    private string searchQuery = "";
    private string searchType = "all";
    private string priceFilter = "all";
    private string sortBy = "relevance";
    private string viewMode = "grid";
    private string activeResultsTab = "specializations";
    private int currentPage = 1;
    private int pageSize = 12;
    private int totalResults = 0;
    private int totalPages = 1;
    private int startPage = 1;
    private int endPage = 1;
    private bool isLoading = false;
    private List<string> recentSearches = new();
    private Timer? debounceTimer;
    private CancellationTokenSource? cts;

    // Separate lists for each type
    private List<SpecializationDto> displayedSpecializations = new();
    private List<CourseDto> displayedCourses = new();
    private List<LectureDto> displayedLectures = new();

    // Count properties
    private int specializationsCount => searchResults?.Specializations?.Count ?? 0;
    private int coursesCount => searchResults?.Courses?.Count ?? 0;
    private int lecturesCount => searchResults?.Lectures?.Count ?? 0;

    // Displayed count properties (after filtering)
    private int displayedSpecializationsCount => displayedSpecializations.Count;
    private int displayedCoursesCount => displayedCourses.Count;
    private int displayedLecturesCount => displayedLectures.Count;

    protected override async Task OnInitializedAsync()
    {
        await LoadRecentSearches();
        await ParseQueryParameters();
    }

    protected override async Task OnParametersSetAsync()
    {
        await ParseQueryParameters();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    private async Task ParseQueryParameters()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("q", out var query))
        {
            searchQuery = query.FirstOrDefault() ?? "";
            if (!string.IsNullOrEmpty(searchQuery))
            {
                await Search();
            }
        }

        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("type", out var type))
        {
            searchType = type.FirstOrDefault() ?? "all";
        }

        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("page", out var page))
        {
            if (int.TryParse(page.FirstOrDefault(), out var pageNumber))
            {
                currentPage = Math.Max(1, pageNumber);
            }
        }
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || searchQuery.Length < 2)
        {
            searchResults = null;
            totalResults = 0;
            UpdateDisplayedItems();
            return;
        }

        // Cancel previous search
        cts?.Cancel();
        cts = new CancellationTokenSource();

        isLoading = true;
        StateHasChanged();

        try
        {
            Console.WriteLine($"SearchPage: Searching for '{searchQuery}' (Type: {searchType}, Page: {currentPage}, PageSize: {pageSize})");

            // Call the SearchService
            var results = await SearchService.SearchAsync(searchQuery, searchType, currentPage, pageSize);

            if (results != null)
            {
                searchResults = results;
                totalResults = results.TotalCount;
                totalPages = (int)Math.Ceiling((double)totalResults / pageSize);

                // Update active tab based on results
                UpdateActiveResultsTab();

                // Add to recent searches
                await AddToRecentSearches(searchQuery);

                Console.WriteLine($"SearchPage: Found {totalResults} results, {totalPages} pages");
            }
            else
            {
                searchResults = null;
                totalResults = 0;
                totalPages = 1;
            }

            // Update URL without reloading
            UpdateUrl();
        }
        catch (OperationCanceledException)
        {
            Console.WriteLine("SearchPage: Search cancelled");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SearchPage: Search error: {ex.Message}");
            searchResults = null;
            totalResults = 0;
            totalPages = 1;
        }
        finally
        {
            isLoading = false;
            UpdateDisplayedItems();
            UpdatePagination();
            StateHasChanged();
        }
    }

    private void UpdateDisplayedItems()
    {
        if (searchResults == null) return;

        // Always work with the original searchResults data
        // Don't clear the original data, just filter/sort for display

        switch (activeResultsTab)
        {
            case "specializations":
                if (searchResults.Specializations != null)
                {
                    var filtered = ApplyFiltersToSpecializations(searchResults.Specializations);
                    displayedSpecializations = ApplySortingToSpecializations(filtered);
                }
                else
                {
                    displayedSpecializations = new List<SpecializationDto>();
                }
                break;

            case "courses":
                if (searchResults.Courses != null)
                {
                    var filtered = ApplyFiltersToCourses(searchResults.Courses);
                    displayedCourses = ApplySortingToCourses(filtered);
                }
                else
                {
                    displayedCourses = new List<CourseDto>();
                }
                break;

            case "lectures":
                if (searchResults.Lectures != null)
                {
                    var filtered = ApplyFiltersToLectures(searchResults.Lectures);
                    displayedLectures = ApplySortingToLectures(filtered);
                }
                else
                {
                    displayedLectures = new List<LectureDto>();
                }
                break;

            default:
                // For "all" tab, show all items
                if (searchResults.Specializations != null)
                {
                    var filteredSpecs = ApplyFiltersToSpecializations(searchResults.Specializations);
                    displayedSpecializations = ApplySortingToSpecializations(filteredSpecs);
                }
                else
                {
                    displayedSpecializations = new List<SpecializationDto>();
                }

                if (searchResults.Courses != null)
                {
                    var filteredCourses = ApplyFiltersToCourses(searchResults.Courses);
                    displayedCourses = ApplySortingToCourses(filteredCourses);
                }
                else
                {
                    displayedCourses = new List<CourseDto>();
                }

                if (searchResults.Lectures != null)
                {
                    var filteredLectures = ApplyFiltersToLectures(searchResults.Lectures);
                    displayedLectures = ApplySortingToLectures(filteredLectures);
                }
                else
                {
                    displayedLectures = new List<LectureDto>();
                }
                break;
        }
    }

    private List<SpecializationDto> ApplyFiltersToSpecializations(List<SpecializationDto> specializations)
    {
        if (string.IsNullOrEmpty(priceFilter) || priceFilter == "all")
            return specializations;

        return specializations.Where(spec =>
        {
            return priceFilter switch
            {
                "free" => spec.Price == 0,
                "paid" => spec.Price > 0,
                "under50" => spec.Price > 0 && spec.Price < 50,
                "under100" => spec.Price > 0 && spec.Price < 100,
                _ => true
            };
        }).ToList();
    }

    private List<CourseDto> ApplyFiltersToCourses(List<CourseDto> courses)
    {
        if (string.IsNullOrEmpty(priceFilter) || priceFilter == "all")
            return courses;

        return courses.Where(course =>
        {
            return priceFilter switch
            {
                "free" => course.Price == 0,
                "paid" => course.Price > 0,
                "under50" => course.Price > 0 && course.Price < 50,
                "under100" => course.Price > 0 && course.Price < 100,
                _ => true
            };
        }).ToList();
    }

    private List<LectureDto> ApplyFiltersToLectures(List<LectureDto> lectures)
    {
        if (string.IsNullOrEmpty(priceFilter) || priceFilter == "all")
            return lectures;

        return lectures.Where(lecture =>
        {
            return priceFilter switch
            {
                "free" => lecture.Price == 0,
                "paid" => lecture.Price > 0,
                "under50" => lecture.Price > 0 && lecture.Price < 50,
                "under100" => lecture.Price > 0 && lecture.Price < 100,
                _ => true
            };
        }).ToList();
    }

    private List<SpecializationDto> ApplySortingToSpecializations(List<SpecializationDto> specializations)
    {
        if (string.IsNullOrEmpty(sortBy) || sortBy == "relevance")
            return specializations;

        return sortBy switch
        {
            "newest" => specializations.OrderByDescending(s => s.CreatedAt).ToList(),
            "price_low" => specializations.OrderBy(s => s.Price).ToList(),
            "price_high" => specializations.OrderByDescending(s => s.Price).ToList(),
            "popular" => specializations.OrderByDescending(s => s.TotalEnrollments).ToList(),
            "rating" => specializations.OrderByDescending(s => s.AverageRating).ToList(),
            _ => specializations
        };
    }

    private List<CourseDto> ApplySortingToCourses(List<CourseDto> courses)
    {
        if (string.IsNullOrEmpty(sortBy) || sortBy == "relevance")
            return courses;

        return sortBy switch
        {
            "newest" => courses.OrderByDescending(c => c.CreatedAt).ToList(),
            "price_low" => courses.OrderBy(c => c.Price).ToList(),
            "price_high" => courses.OrderByDescending(c => c.Price).ToList(),
            "popular" => courses.OrderByDescending(c => c.TotalEnrollments).ToList(),
            "rating" => courses.OrderByDescending(c => c.AverageRating).ToList(),
            _ => courses
        };
    }

    private List<LectureDto> ApplySortingToLectures(List<LectureDto> lectures)
    {
        if (string.IsNullOrEmpty(sortBy) || sortBy == "relevance")
            return lectures;

        return sortBy switch
        {
            "newest" => lectures.OrderByDescending(l => l.CreatedAt).ToList(),
            "price_low" => lectures.OrderBy(l => l.Price).ToList(),
            "price_high" => lectures.OrderByDescending(l => l.Price).ToList(),
            "popular" => lectures.OrderByDescending(l => l.TotalEnrollments).ToList(),
            "rating" => lectures.OrderByDescending(l => l.AverageRating).ToList(),
            _ => lectures
        };
    }

    private void UpdateActiveResultsTab()
    {
        if (searchResults == null) return;

        // Determine which tab should be active based on results
        if (searchType == "all")
        {
            if (searchResults.Specializations?.Any() == true)
                activeResultsTab = "specializations";
            else if (searchResults.Courses?.Any() == true)
                activeResultsTab = "courses";
            else if (searchResults.Lectures?.Any() == true)
                activeResultsTab = "lectures";
        }
        else
        {
            activeResultsTab = searchType;
        }
    }

    private void UpdatePagination()
    {
        totalPages = Math.Max(1, (int)Math.Ceiling((double)totalResults / pageSize));
        currentPage = Math.Clamp(currentPage, 1, totalPages);

        // Calculate start and end pages for pagination display
        int maxPagesToShow = 5;
        startPage = Math.Max(1, currentPage - (maxPagesToShow / 2));
        endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

        if (endPage - startPage + 1 < maxPagesToShow)
        {
            startPage = Math.Max(1, endPage - maxPagesToShow + 1);
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
        else if (e.Key == "Escape")
        {
            ClearSearch();
        }
    }

    private void ClearSearch()
    {
        searchQuery = "";
        searchResults = null;
        totalResults = 0;
        currentPage = 1;
        UpdateDisplayedItems();
        StateHasChanged();
    }

    private void SetSearchType(string type)
    {
        searchType = type;
        currentPage = 1;
        UpdateDisplayedItems();
        UpdateUrl();
        _ = Search();
    }

    private void SetPriceFilter(string filter)
    {
        priceFilter = filter;
        UpdateDisplayedItems();
        StateHasChanged();
    }

    private void SetSortBy(string sort)
    {
        sortBy = sort;
        UpdateDisplayedItems();
        StateHasChanged();
    }

    private void SetViewMode(string mode)
    {
        viewMode = mode;
        StateHasChanged();
    }

    private string GetSortByLabel()
    {
        return sortBy switch
        {
            "relevance" => "Relevance",
            "newest" => "Newest",
            "price_low" => "Price: Low to High",
            "price_high" => "Price: High to Low",
            "popular" => "Most Popular",
            "rating" => "Highest Rated",
            _ => "Sort By"
        };
    }

    private void SwitchResultsTab(string tab)
    {
        activeResultsTab = tab;
        UpdateDisplayedItems();
        StateHasChanged();
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages || page == currentPage) return;

        currentPage = page;
        UpdatePagination();
        UpdateUrl();
        _ = Search();
    }

    private void UpdateUrl()
    {
        var queryParams = new List<string>
        {
            $"q={Uri.EscapeDataString(searchQuery)}"
        };

        if (searchType != "all")
        {
            queryParams.Add($"type={searchType}");
        }

        if (currentPage > 1)
        {
            queryParams.Add($"page={currentPage}");
        }

        var url = "/search";
        if (queryParams.Any())
        {
            url += $"?{string.Join("&", queryParams)}";
        }

        Navigation.NavigateTo(url, forceLoad: false);
    }

    private async Task LoadRecentSearches()
    {
        try
        {
            var recentJson = await JS.InvokeAsync<string>("localStorage.getItem", "recentSearches");
            if (!string.IsNullOrEmpty(recentJson))
            {
                recentSearches = System.Text.Json.JsonSerializer.Deserialize<List<string>>(recentJson) ?? new List<string>();
            }
        }
        catch
        {
            recentSearches = new List<string>();
        }
    }

    private async Task AddToRecentSearches(string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return;

        // Remove if already exists
        recentSearches.RemoveAll(s => s.Equals(query, StringComparison.OrdinalIgnoreCase));

        // Add to beginning
        recentSearches.Insert(0, query);

        // Keep only last 20 searches
        if (recentSearches.Count > 20)
        {
            recentSearches = recentSearches.Take(20).ToList();
        }

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "recentSearches",
                System.Text.Json.JsonSerializer.Serialize(recentSearches));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving recent searches: {ex.Message}");
        }
    }

    private async Task SearchWithQuery(string query)
    {
        searchQuery = query;
        currentPage = 1;
        await Search();
    }

    private void ResetFilters()
    {
        searchType = "all";
        priceFilter = "all";
        sortBy = "relevance";
        currentPage = 1;
        UpdateDisplayedItems();
        UpdateUrl();
        _ = Search();
    }

    private string GetTruncatedText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return text;
        if (text.Length <= maxLength) return text;
        return text.Substring(0, maxLength).TrimEnd() + "...";
    }

    private void NavigateToSpecialization(int id)
    {
        Navigation.NavigateTo($"/specialization/{id}");
    }

    private void NavigateToCourse(int id)
    {
        Navigation.NavigateTo($"/course/{id}");
    }

    private void NavigateToLecture(int id)
    {
        Navigation.NavigateTo($"/lecture/{id}");
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
        cts?.Cancel();
        cts?.Dispose();
    }
}
