

<div class="image-container" style="position: relative; width: 100%; height: 100%;">
    <!-- Custom image controls -->
    <div class="image-controls bg-dark p-2 d-flex justify-content-between align-items-center">
        <div>
            <button class="btn btn-sm btn-outline-light me-2" @onclick="ZoomIn" title="Zoom In">
                <i class="fas fa-search-plus"></i>
            </button>
            <button class="btn btn-sm btn-outline-light me-2" @onclick="ZoomOut" title="Zoom Out">
                <i class="fas fa-search-minus"></i>
            </button>
            <button class="btn btn-sm btn-outline-light me-2" @onclick="ResetZoom" title="Reset Zoom">
                <i class="fas fa-expand"></i>
            </button>
            <span class="text-white ms-2 me-3">Zoom: @(Math.Round(zoomLevel * 100))%</span>
        </div>
        
        <div>
            <button class="btn btn-sm btn-outline-light me-2" @onclick="RotateLeft" title="Rotate Left">
                <i class="fas fa-undo"></i>
            </button>
            <button class="btn btn-sm btn-outline-light me-2" @onclick="RotateRight" title="Rotate Right">
                <i class="fas fa-redo"></i>
            </button>
            <span class="text-white">Rotation: @rotationDeg°</span>
        </div>
        
        <div>
            @if (Material.IsDownloadable)
            {
                <button class="btn btn-sm btn-outline-light me-2" @onclick="DownloadFile" title="Download">
                    <i class="fas fa-download"></i>
                </button>
            }
            <button class="btn btn-sm btn-outline-light" @onclick="FullScreen" title="Full Screen">
                <i class="fas fa-expand-arrows-alt"></i>
            </button>
        </div>
    </div>
    
    <!-- Image Display Area -->
    <div class="image-display-area" style="height: calc(100% - 60px); overflow: auto; background: #000;" 
         @ref="contentAreaRef">
        @if (imageSrc != null && !isLoading)
        {
            <div style="display: flex; justify-content: center; align-items: center; height: 100%; 
                        width: 100%; padding: 20px;">
                <img src="@imageSrc" 
                     alt="@Material.Title"
                     style="transform: scale(@zoomLevel) rotate(@(rotationDeg)deg); 
                            max-width: 100%; max-height: 100%;
                            transition: transform 0.2s ease;"
                     @onload="OnContentLoaded"
                     draggable="false" />
            </div>
        }
        else if (isLoading)
        {
            <div class="loading-overlay">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2 text-white">Loading image...</div>
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center m-3">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Failed to load image
            </div>
        }
    </div>
    
    <!-- Progress tracking section -->
    @if (CurrentProgress != null && IsAuthenticated && HasAccess)
    {
        <ProgressSection Progress="CurrentProgress" 
                        IsLoading="isLoading"
                        OnMarkAsCompleted="HandleMarkAsCompleted"
                        ProgressPercentage="0" />
    }
</div>

<style>
    .image-container {
        width: 100%;
        height: 100%;
    }
    
    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.8);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }
</style>

@code {
    [Parameter] public LearningMaterialDto Material { get; set; }
    [Parameter] public ProgressTrackingDto? CurrentProgress { get; set; }
    [Parameter] public int CurrentEnrollmentId { get; set; }
    [Parameter] public bool IsAuthenticated { get; set; }
    [Parameter] public bool HasAccess { get; set; }
    [Parameter] public EventCallback<ProgressUpdateEventArgs> OnProgressUpdated { get; set; }
    [Parameter] public EventCallback OnMarkAsCompleted { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    
    private ElementReference contentAreaRef;
    private string? imageSrc;
    private bool isLoading = true;
    private float zoomLevel = 1.0f;
    private int rotationDeg = 0;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadImageContent();
    }
    
    private async Task LoadImageContent()
    {
        try
        {
            var imageUrl = await SecureFileViewerService.GetSecureViewUrlAsync(Material.Id);
            
            if (!string.IsNullOrEmpty(imageUrl))
            {
                imageSrc = imageUrl;
                isLoading = false;
            }
            else
            {
                await OnError.InvokeAsync("Failed to load image");
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Error loading image: {ex.Message}");
            isLoading = false;
        }
    }
    
    private void ZoomIn()
    {
        zoomLevel = Math.Min(zoomLevel + 0.1f, 3.0f);
        StateHasChanged();
    }
    
    private void ZoomOut()
    {
        zoomLevel = Math.Max(zoomLevel - 0.1f, 0.5f);
        StateHasChanged();
    }
    
    private void ResetZoom()
    {
        zoomLevel = 1.0f;
        rotationDeg = 0;
        StateHasChanged();
    }
    
    private void RotateLeft()
    {
        rotationDeg -= 90;
        StateHasChanged();
    }
    
    private void RotateRight()
    {
        rotationDeg += 90;
        StateHasChanged();
    }
    
    private async Task FullScreen()
    {
        try
        {
            await JS.InvokeVoidAsync("toggleFullScreen", contentAreaRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error entering fullscreen: {ex.Message}");
        }
    }
    
    private async Task DownloadFile()
    {
        try
        {
            await SecureFileViewerService.DownloadMaterialAsync(Material.Id, Material.Title);
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Download failed: {ex.Message}");
        }
    }
    
    private async Task HandleMarkAsCompleted()
    {
        await OnMarkAsCompleted.InvokeAsync();
    }
    
    private void OnContentLoaded()
    {
        isLoading = false;
        StateHasChanged();
    }
}