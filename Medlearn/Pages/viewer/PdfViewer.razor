@implements IDisposable

<div class="pdf-container" style="position: relative; width: 100%; height: 100%;">
    <!-- Custom PDF controls -->
    <div class="pdf-controls bg-dark p-2 d-flex justify-content-between align-items-center">
        <div>
            <button class="btn btn-sm btn-outline-light me-2" @onclick="ZoomIn" title="Zoom In" disabled="@(isLoading || !isPdfLoaded)">
                <i class="fas fa-search-plus"></i>
            </button>
            <button class="btn btn-sm btn-outline-light me-2" @onclick="ZoomOut" title="Zoom Out" disabled="@(isLoading || !isPdfLoaded)">
                <i class="fas fa-search-minus"></i>
            </button>
            <button class="btn btn-sm btn-outline-light me-2" @onclick="ResetZoom" title="Reset Zoom" disabled="@(isLoading || !isPdfLoaded)">
                <i class="fas fa-expand"></i>
            </button>
            <button class="btn btn-sm btn-outline-light me-2" @onclick="PreviousPage" title="Previous Page" disabled="@(isLoading || !isPdfLoaded || currentPage <= 1)">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="btn btn-sm btn-outline-light me-2" @onclick="NextPage" title="Next Page" disabled="@(isLoading || !isPdfLoaded || currentPage >= totalPages)">
                <i class="fas fa-chevron-right"></i>
            </button>
            <span class="text-white ms-2 me-3">
                Page <strong>@currentPage</strong> of <strong>@totalPages</strong>
                (Zoom: @(Math.Round(zoomLevel * 100))%)
            </span>
        </div>
        
        <div>
            @if (Material.IsDownloadable)
            {
                <button class="btn btn-sm btn-outline-light me-2" @onclick="DownloadFile" title="Download" disabled="@isLoading">
                    <i class="fas fa-download"></i>
                </button>
            }
            <button class="btn btn-sm btn-outline-light" @onclick="FullScreen" title="Full Screen" disabled="@(isLoading || !isPdfLoaded)">
                <i class="fas fa-expand-arrows-alt"></i>
            </button>
        </div>
    </div>
    
    <!-- PDF Display Area -->
    <div id="pdf-viewer-container" 
         class="pdf-display-area" 
         style="height: calc(100% - 60px); overflow: auto; background: #525659;" 
         @ref="pdfContainerRef"
         @onscroll="OnPdfScroll">
        
        <canvas id="pdf-canvas" 
                style="display: @(isPdfLoaded && !isLoading ? "block" : "none"); 
                       box-shadow: 0 4px 8px rgba(0,0,0,0.3); 
                       background: white; 
                       margin: 20px auto;"
                @ref="canvasRef">
        </canvas>
        
        @if (isLoading)
        {
            <div class="loading-overlay">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2 text-white">
                    @(isPdfLoading ? "Rendering PDF..." : "Loading PDF...")
                </div>
            </div>
        }
        else if (!isPdfLoaded)
        {
            <div class="alert alert-warning text-center m-3">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Failed to load PDF content
            </div>
        }
    </div>
    
    <!-- Progress tracking section -->
    @if (CurrentProgress != null && IsAuthenticated && HasAccess)
    {
        <ProgressSection Progress="CurrentProgress" 
                        IsLoading="isLoading"
                        OnMarkAsCompleted="HandleMarkAsCompleted"
                        OnSaveProgress="SavePdfProgress"
                        ProgressPercentage="@GetProgressPercentage()" />
    }
</div>

<style>
    .pdf-container {
        width: 100%;
        height: 100%;
    }
    
    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.8);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }
</style>

@code {
    [Parameter] public LearningMaterialDto Material { get; set; }
    [Parameter] public ProgressTrackingDto? CurrentProgress { get; set; }
    [Parameter] public int CurrentEnrollmentId { get; set; }
    [Parameter] public bool IsAuthenticated { get; set; }
    [Parameter] public bool HasAccess { get; set; }
    [Parameter] public EventCallback<ProgressUpdateEventArgs> OnProgressUpdated { get; set; }
    [Parameter] public EventCallback OnMarkAsCompleted { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    
    private ElementReference pdfContainerRef;
    private ElementReference canvasRef;
    private bool isLoading = true;
    private bool isPdfLoading = false;
    private bool isPdfLoaded = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private float zoomLevel = 1.0f;
    private string? base64Data = null;
    private double lastScrollPercentage = 0;
    private DateTime lastScrollSave = DateTime.UtcNow;
    private DateTime lastProgressSave = DateTime.UtcNow;
    private CancellationTokenSource renderCts = new CancellationTokenSource();
    private DateTime lastRenderTime = DateTime.MinValue;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadPdfContent();
    }
    
    private async Task LoadPdfContent()
    {
        try
        {
            Console.WriteLine("Loading PDF content...");
            isPdfLoading = true;
            
            var pdfBytes = await SecureMaterialService.GetSecureMaterialViewAsync(Material.Id);
            base64Data = Convert.ToBase64String(pdfBytes);
            
            // Load PDF document and store the reference
            var pdfRef = await JS.InvokeAsync<string>("loadPdfDocument", base64Data);
            Console.WriteLine($"PDF loaded with reference: {pdfRef}");
            
            totalPages = await JS.InvokeAsync<int>("getPdfTotalPagesFromReference", pdfRef);
            Console.WriteLine($"Total pages: {totalPages}");
            
            isPdfLoaded = true;
            isLoading = false;
            
            // Render first page
            await RenderPage(1);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading PDF: {ex.Message}");
            isLoading = false;
            isPdfLoading = false;
            await OnError.InvokeAsync($"Error loading PDF: {ex.Message}");
        }
    }
    
    private async Task RenderPage(int pageNumber)
    {
        if (!isPdfLoaded || string.IsNullOrEmpty(base64Data)) return;
        
        // Debounce: only render once every 200ms
        if ((DateTime.Now - lastRenderTime).TotalMilliseconds < 200)
        {
            return;
        }

        lastRenderTime = DateTime.Now;

        // Cancel previous render if still in progress
        renderCts?.Cancel();
        renderCts = new CancellationTokenSource();
        
        try
        {
            await Task.Delay(50, renderCts.Token);
            
            currentPage = pageNumber;
            await InvokeAsync(StateHasChanged);
            
            // Render the page
            await JS.InvokeVoidAsync("renderPageFromLoadedPdf", 
                "pdf-canvas",
                pageNumber,
                zoomLevel);
        }
        catch (TaskCanceledException)
        {
            // Render cancelled
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering page {pageNumber}: {ex.Message}");
        }
    }
    
    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            await RenderPage(currentPage + 1);
        }
    }
    
    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            await RenderPage(currentPage - 1);
        }
    }
    
    private async Task ZoomIn()
    {
        zoomLevel = Math.Min(zoomLevel + 0.1f, 3.0f);
        await RenderPage(currentPage);
        await InvokeAsync(StateHasChanged);
    }
    
    private async Task ZoomOut()
    {
        zoomLevel = Math.Max(zoomLevel - 0.1f, 0.5f);
        await RenderPage(currentPage);
        await InvokeAsync(StateHasChanged);
    }
    
    private async Task ResetZoom()
    {
        zoomLevel = 1.0f;
        await RenderPage(currentPage);
        await InvokeAsync(StateHasChanged);
    }
    
    private async Task OnPdfScroll()
    {
        if (!IsAuthenticated || !HasAccess) return;
        
        if ((DateTime.UtcNow - lastScrollSave).TotalSeconds < 3) return;
        
        try
        {
            var scrollPercentage = await GetScrollPercentage();
            
            if (scrollPercentage > lastScrollPercentage)
            {
                lastScrollPercentage = scrollPercentage;
                
                if (scrollPercentage > 0.1 && (DateTime.UtcNow - lastProgressSave).TotalSeconds > 15)
                {
                    await SavePdfProgress();
                    lastProgressSave = DateTime.UtcNow;
                }
                
                lastScrollSave = DateTime.UtcNow;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error tracking scroll progress: {ex.Message}");
        }
    }
    
    private async Task<double> GetScrollPercentage()
    {
        try
        {
            return await JS.InvokeAsync<double>("getScrollPercentage", pdfContainerRef);
        }
        catch
        {
            return 0;
        }
    }
    
    private async Task SavePdfProgress()
    {
        if (!IsAuthenticated || !HasAccess || CurrentEnrollmentId == 0) return;
        
        try
        {
            var pageProgress = totalPages > 0 ? (double)currentPage / totalPages : lastScrollPercentage;
            int readingTime = CalculateReadingTime(pageProgress);
            bool isCompleted = pageProgress >= 0.95;
            
            var args = new ProgressUpdateEventArgs
            {
                IsCompleted = isCompleted,
                TimeSpentSeconds = (CurrentProgress?.TimeSpentSeconds ?? 0) + readingTime,
                LastPositionSeconds = 0
            };
            
            await OnProgressUpdated.InvokeAsync(args);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving PDF progress: {ex.Message}");
        }
    }
    
    private int CalculateReadingTime(double progress)
    {
        double progressChange = progress - lastScrollPercentage;
        
        if (progressChange <= 0) return 0;
        
        return (int)(progressChange * 60 * 2); // PDFs typically take longer to read
    }
    
    private double GetProgressPercentage()
    {
        if (CurrentProgress == null) return 0;
        
        if (CurrentProgress.IsCompleted) return 100;
        
        if (totalPages > 0 && currentPage > 0)
        {
            return Math.Min(100, ((double)currentPage / totalPages) * 100);
        }
        
        return lastScrollPercentage * 100;
    }
    
    private async Task HandleMarkAsCompleted()
    {
        await OnMarkAsCompleted.InvokeAsync();
    }
    
    private async Task FullScreen()
    {
        try
        {
            await JS.InvokeVoidAsync("toggleFullScreen", pdfContainerRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error entering fullscreen: {ex.Message}");
        }
    }
    
    private async Task DownloadFile()
    {
        try
        {
            // Implement download logic
            await OnError.InvokeAsync("Download not implemented");
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Download failed: {ex.Message}");
        }
    }
    
    public void Dispose()
    {
        renderCts?.Cancel();
        renderCts?.Dispose();
        
        // Clean up PDF resources
        try
        {
            if (isPdfLoaded)
            {
                JS.InvokeVoidAsync("cleanupPdfJs");
                JS.InvokeVoidAsync("destroyPdfDocument");
            }
        }
        catch { }
    }
}