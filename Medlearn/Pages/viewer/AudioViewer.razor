@implements IDisposable

<div class="audio-container" style="position: relative; width: 100%; height: 100%;">
    <!-- Custom audio controls -->
    <div class="audio-controls bg-dark p-2 d-flex justify-content-between align-items-center">
        <div class="text-white">
            <i class="fas fa-music me-2"></i>Audio Player - @Material.Title
        </div>
        
        <div class="text-white d-flex align-items-center">
            <span>Duration: @FormatDuration(Material.DurationSeconds)</span>
            @if (currentAudioTime > 0)
            {
                <span class="ms-3">Current: @FormatDuration(currentAudioTime)</span>
            }
        </div>
        
        <div>
            @if (Material.IsDownloadable)
            {
                <button class="btn btn-sm btn-outline-light me-2" @onclick="DownloadFile" title="Download">
                    <i class="fas fa-download"></i>
                </button>
            }
            <button class="btn btn-sm btn-outline-light" @onclick="FullScreenAudio" title="Full Screen">
                <i class="fas fa-expand-arrows-alt"></i>
            </button>
        </div>
    </div>
    
    <!-- Audio Display Area -->
    <div class="audio-display-area" style="height: calc(100% - 60px); display: flex; align-items: center; justify-content: center; background: #1a1a1a;" 
         @ref="audioAreaRef">
        @if (audioSrc != null && !isLoading)
        {
            <div class="text-center text-white w-75">
                <i class="fas fa-music fa-4x text-primary mb-4"></i>
                <h5 class="mb-3">@Material.Title</h5>
                @if (!string.IsNullOrEmpty(Material.Description))
                {
                    <p class="text-light opacity-75 mb-4">@Material.Description</p>
                }
                
                <!-- Custom audio player -->
                <div class="custom-audio-player">
                    <!-- Progress bar -->
                    <div class="progress-container mb-3" style="position: relative; cursor: pointer;"
                         @onclick="HandleAudioProgressClick"
                         @ref="audioProgressBarRef">
                        <div class="progress" style="height: 6px; background: rgba(255,255,255,0.3);">
                            <div class="progress-bar" role="progressbar" 
                                 style="width: @(audioProgressPercentage)%; background: #007bff; height: 100%;"></div>
                        </div>
                    </div>
                    
                    <!-- Controls -->
                    <div class="d-flex justify-content-between align-items-center">
                        <button class="btn btn-lg btn-outline-light" @onclick="ToggleAudioPlay">
                            <i class="fas @(isAudioPlaying ? "fa-pause" : "fa-play") fa-2x"></i>
                        </button>
                        
                        <div class="d-flex align-items-center">
                            <div class="time-display text-white" style="font-family: monospace; font-size: 14px;">
                                <span>@FormatDuration(currentAudioTime)</span>
                                <span class="mx-1">/</span>
                                <span>@FormatDuration(Material.DurationSeconds)</span>
                            </div>
                            
                            <div class="volume-control ms-3" style="width: 100px;">
                                <input type="range" class="form-range" min="0" max="100" 
                                       value="@(audioVolume * 100)" 
                                       @onchange="HandleAudioVolumeChange" 
                                       style="cursor: pointer;" />
                            </div>
                        </div>
                        
                        <div>
                            <button class="btn btn-sm btn-outline-light me-2" @onclick="SkipAudioBackward">
                                <i class="fas fa-backward"></i> 10s
                            </button>
                            <button class="btn btn-sm btn-outline-light" @onclick="SkipAudioForward">
                                <i class="fas fa-forward"></i> 10s
                            </button>
                        </div>
                    </div>
                    
                    <audio @ref="audioElement"
                           @oncanplay="OnAudioCanPlay"
                           @ontimeupdate="OnAudioTimeUpdate"
                           @onplay="OnAudioPlay"
                           @onpause="OnAudioPause"
                           @onended="OnAudioEnded">
                        <source src="@audioSrc" type="@GetAudioMimeType(Material.ContentUrl)">
                        Your browser does not support the audio element.
                    </audio>
                </div>
            </div>
        }
        else if (isLoading)
        {
            <div class="loading-overlay">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2 text-white">Loading audio...</div>
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center m-3">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Failed to load audio
            </div>
        }
    </div>
    
    <!-- Progress tracking section -->
    @if (CurrentProgress != null && IsAuthenticated && HasAccess)
    {
        <ProgressSection Progress="CurrentProgress" 
                        IsLoading="isLoading"
                        OnMarkAsCompleted="HandleMarkAsCompleted"
                        OnSaveProgress="SaveAudioProgress"
                        ProgressPercentage="@GetProgressPercentage()" />
    }
</div>

<style>
    .audio-container {
        width: 100%;
        height: 100%;
    }
    
    .custom-audio-player {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
    }
    
    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.8);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }
</style>

@code {
    [Parameter] public LearningMaterialDto Material { get; set; }
    [Parameter] public ProgressTrackingDto? CurrentProgress { get; set; }
    [Parameter] public int CurrentEnrollmentId { get; set; }
    [Parameter] public bool IsAuthenticated { get; set; }
    [Parameter] public bool HasAccess { get; set; }
    [Parameter] public EventCallback<ProgressUpdateEventArgs> OnProgressUpdated { get; set; }
    [Parameter] public EventCallback OnMarkAsCompleted { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    
    private ElementReference audioAreaRef;
    private ElementReference audioElement;
    private ElementReference audioProgressBarRef;
    private string? audioSrc;
    private bool isLoading = true;
    private bool isAudioPlaying = false;
    private bool isAudioMuted = false;
    private double audioVolume = 0.7;
    private double currentAudioTime = 0;
    private double audioProgressPercentage = 0;
    private DateTime lastAudioRenderTime = DateTime.UtcNow;
    private DateTime lastAudioEventTime = DateTime.UtcNow;
    private bool isProcessingAudioEvent = false;
    private SemaphoreSlim audioEventLock = new SemaphoreSlim(1, 1);
    private DateTime lastProgressSave = DateTime.UtcNow;
    private double lastKnownAudioProgress = 0;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadAudioContent();
    }
    
    private async Task LoadAudioContent()
    {
        try
        {
            var audioUrl = await SecureFileViewerService.GetSecureStreamUrlAsync(Material.Id);
            
            if (!string.IsNullOrEmpty(audioUrl))
            {
                audioSrc = audioUrl;
                isLoading = false;
            }
            else
            {
                await OnError.InvokeAsync("Failed to load audio");
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Error loading audio: {ex.Message}");
            isLoading = false;
        }
    }
    
    private async Task ToggleAudioPlay()
    {
        if (audioElement.Context == null || isProcessingAudioEvent) return;
        
        await audioEventLock.WaitAsync();
        isProcessingAudioEvent = true;
        
        try
        {
            if (isAudioPlaying)
            {
                await JS.InvokeVoidAsync("pauseAudio", audioElement);
            }
            else
            {
                await JS.InvokeVoidAsync("playAudio", audioElement);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling audio play: {ex.Message}");
            await OnError.InvokeAsync("Could not control audio playback");
        }
        finally
        {
            isProcessingAudioEvent = false;
            audioEventLock.Release();
        }
    }
    
    private async Task OnAudioCanPlay()
    {
        isLoading = false;
        
        // Restore progress if exists
        if (CurrentProgress != null && CurrentProgress.LastPositionSeconds > 0)
        {
            await SeekAudioToTime(CurrentProgress.LastPositionSeconds);
        }
        
        StateHasChanged();
    }
    
    private async Task OnAudioTimeUpdate()
    {
        if ((DateTime.UtcNow - lastAudioEventTime).TotalMilliseconds < 500 ||
            audioElement.Context == null ||
            Material.DurationSeconds <= 0 ||
            isProcessingAudioEvent)
        {
            return;
        }

        await audioEventLock.WaitAsync();
        isProcessingAudioEvent = true;

        try
        {
            lastAudioEventTime = DateTime.UtcNow;

            currentAudioTime = await JS.InvokeAsync<double>("getAudioCurrentTime", audioElement);
            audioProgressPercentage = (currentAudioTime / Material.DurationSeconds) * 100;

            if (Math.Abs(audioProgressPercentage - lastKnownAudioProgress) > 1)
            {
                lastKnownAudioProgress = audioProgressPercentage;

                // Auto-save progress periodically
                if ((DateTime.UtcNow - lastProgressSave).TotalSeconds > 30)
                {
                    await SaveAudioProgress();
                    lastProgressSave = DateTime.UtcNow;
                }

                if ((DateTime.UtcNow - lastAudioRenderTime).TotalMilliseconds > 500)
                {
                    lastAudioRenderTime = DateTime.UtcNow;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in audio time update: {ex.Message}");
        }
        finally
        {
            isProcessingAudioEvent = false;
            audioEventLock.Release();
        }
    }
    
    private async void OnAudioPlay()
    {
        await Task.Delay(50);
        isAudioPlaying = true;

        if ((DateTime.UtcNow - lastAudioRenderTime).TotalMilliseconds > 200)
        {
            lastAudioRenderTime = DateTime.UtcNow;
            await InvokeAsync(StateHasChanged);
        }
    }
    
    private async void OnAudioPause()
    {
        await Task.Delay(50);
        isAudioPlaying = false;

        if (CurrentEnrollmentId > 0)
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(1000);
                await SaveAudioProgress();
            });
        }

        if ((DateTime.UtcNow - lastAudioRenderTime).TotalMilliseconds > 200)
        {
            lastAudioRenderTime = DateTime.UtcNow;
            await InvokeAsync(StateHasChanged);
        }
    }
    
    private async Task OnAudioEnded()
    {
        isAudioPlaying = false;
        currentAudioTime = Material.DurationSeconds;
        audioProgressPercentage = 100;
        
        if (CurrentEnrollmentId > 0 && CurrentProgress?.IsCompleted != true)
        {
            await HandleMarkAsCompleted();
        }
        
        StateHasChanged();
    }
    
    private async Task HandleAudioProgressClick(MouseEventArgs e)
    {
        if (audioElement.Context == null || Material.DurationSeconds <= 0) return;
        
        try
        {
            var rect = await JS.InvokeAsync<DOMRect>("getBoundingClientRect", audioProgressBarRef);
            var clickX = e.ClientX - rect.Left;
            var percentage = Math.Max(0, Math.Min(1, clickX / rect.Width));
            var newTime = Material.DurationSeconds * percentage;
            
            await SeekAudioToTime(newTime);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error handling audio progress click: {ex.Message}");
        }
    }
    
    private async Task SkipAudioForward()
    {
        if (audioElement.Context == null || isProcessingAudioEvent) return;

        await audioEventLock.WaitAsync();
        isProcessingAudioEvent = true;

        try
        {
            double currentTime = currentAudioTime;
            
            try
            {
                currentTime = await JS.InvokeAsync<double>("getAudioCurrentTime", audioElement);
            }
            catch { }

            var newTime = currentTime + 10;
            if (Material.DurationSeconds > 0 && newTime > Material.DurationSeconds)
            {
                newTime = Material.DurationSeconds;
            }

            await SeekAudioToTime(newTime);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error skipping audio forward: {ex.Message}");
            currentAudioTime = Math.Min(currentAudioTime + 10, Material.DurationSeconds);
            audioProgressPercentage = Material.DurationSeconds > 0 ?
                (currentAudioTime / Material.DurationSeconds) * 100 : 0;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            isProcessingAudioEvent = false;
            audioEventLock.Release();
        }
    }
    
    private async Task SkipAudioBackward()
    {
        if (audioElement.Context == null || isProcessingAudioEvent) return;

        try
        {
            double currentTime = currentAudioTime;
            
            var newTime = Math.Max(0, currentTime - 10);
            await SeekAudioToTime(newTime);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error skipping audio backward: {ex.Message}");
            currentAudioTime = Math.Max(0, currentAudioTime - 10);
            audioProgressPercentage = Material.DurationSeconds > 0 ?
                (currentAudioTime / Material.DurationSeconds) * 100 : 0;
            await InvokeAsync(StateHasChanged);
        }
    }
    
    private async Task SeekAudioToTime(double time)
    {
        if (audioElement.Context == null || isProcessingAudioEvent) return;

        await audioEventLock.WaitAsync();
        isProcessingAudioEvent = true;

        try
        {
            var maxTime = Material.DurationSeconds > 0 ? Material.DurationSeconds : 999999;
            time = Math.Max(0, Math.Min(maxTime, time));

            bool wasPlaying = isAudioPlaying;

            if (wasPlaying)
            {
                await JS.InvokeVoidAsync("pauseAudio", audioElement);
                isAudioPlaying = false;
                await Task.Delay(100);
            }

            bool timeSetSuccessfully = await JS.InvokeAsync<bool>("setAudioCurrentTime", audioElement, time);

            if (timeSetSuccessfully)
            {
                currentAudioTime = time;
                audioProgressPercentage = Material.DurationSeconds > 0 ?
                    (currentAudioTime / Material.DurationSeconds) * 100 : 0;
            }

            await InvokeAsync(StateHasChanged);

            if (wasPlaying)
            {
                await Task.Delay(300);
                await JS.InvokeVoidAsync("playAudio", audioElement);
                isAudioPlaying = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error seeking audio: {ex.Message}");
        }
        finally
        {
            isProcessingAudioEvent = false;
            audioEventLock.Release();
        }
    }
    
    private async Task HandleAudioVolumeChange(ChangeEventArgs e)
    {
        if (audioElement.Context == null) return;
        
        try
        {
            if (int.TryParse(e.Value?.ToString(), out var volumePercent))
            {
                audioVolume = volumePercent / 100.0;
                await JS.InvokeVoidAsync("setElementVolume", audioElement, audioVolume);
                
                isAudioMuted = audioVolume <= 0;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error changing audio volume: {ex.Message}");
        }
    }
    
    private async Task SaveAudioProgress()
    {
        if (!IsAuthenticated || Material == null || CurrentEnrollmentId == 0) return;
        
        try
        {
            int timeSpentSeconds = await CalculateActualAudioTimeListened();
            bool isCompleted = audioProgressPercentage >= 95 || 
                              (Material.DurationSeconds > 0 && 
                               currentAudioTime >= Material.DurationSeconds * 0.95);
            
            var args = new ProgressUpdateEventArgs
            {
                MaterialId = Material.Id,
                IsCompleted = isCompleted,
                TimeSpentSeconds = timeSpentSeconds,
                LastPositionSeconds = (int)currentAudioTime
            };
            
            await OnProgressUpdated.InvokeAsync(args);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving audio progress: {ex.Message}");
            await OnError.InvokeAsync("Could not save progress");
        }
    }
    
    private async Task<int> CalculateActualAudioTimeListened()
    {
        if (CurrentProgress == null) return (int)currentAudioTime;

        int totalTime = CurrentProgress.TimeSpentSeconds;

        if (isAudioPlaying)
        {
            var timeSinceLastSave = (DateTime.UtcNow - lastProgressSave).TotalSeconds;
            totalTime += (int)Math.Min(timeSinceLastSave, 60);
        }

        return Math.Max(totalTime, (int)currentAudioTime);
    }
    
    private async Task HandleMarkAsCompleted()
    {
        await OnMarkAsCompleted.InvokeAsync();
    }
    
    private double GetProgressPercentage()
    {
        if (CurrentProgress == null) return 0;
        
        if (CurrentProgress.IsCompleted) return 100;
        
        if (Material.DurationSeconds > 0)
        {
            var percentage = (currentAudioTime / Material.DurationSeconds) * 100;
            return Math.Min(100, Math.Max(0, percentage));
        }
        
        return 0;
    }
    
    private async Task FullScreenAudio()
    {
        try
        {
            await JS.InvokeVoidAsync("toggleFullScreen", audioAreaRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error entering fullscreen: {ex.Message}");
        }
    }
    
    private async Task DownloadFile()
    {
        try
        {
            await SecureFileViewerService.DownloadMaterialAsync(Material.Id, Material.Title);
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Download failed: {ex.Message}");
        }
    }
    
    private string GetAudioMimeType(string url)
    {
        var ext = Path.GetExtension(url)?.ToLower();
        return ext switch
        {
            ".mp3" => "audio/mpeg",
            ".wav" => "audio/wav",
            ".ogg" => "audio/ogg",
            ".m4a" => "audio/mp4",
            _ => "audio/mpeg"
        };
    }
    
    private string FormatDuration(double seconds)
    {
        var timeSpan = TimeSpan.FromSeconds(seconds);
        
        if (timeSpan.Hours > 0)
        {
            return $"{timeSpan.Hours:00}:{timeSpan.Minutes:00}:{timeSpan.Seconds:00}";
        }
        else
        {
            return $"{timeSpan.Minutes:00}:{timeSpan.Seconds:00}";
        }
    }
    
    private class DOMRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }
    
    protected override bool ShouldRender()
    {
        if ((DateTime.UtcNow - lastAudioRenderTime).TotalMilliseconds < 200)
        {
            return false;
        }
        return true;
    }
    
    public void Dispose()
    {
        audioEventLock?.Dispose();
    }
}