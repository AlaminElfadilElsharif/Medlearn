

<div class="text-container" style="position: relative; width: 100%; height: 100%;">
    <!-- Custom text controls -->
    <div class="text-controls bg-dark p-2 d-flex justify-content-between align-items-center">
        <div>
            <button class="btn btn-sm btn-outline-light me-2" @onclick="IncreaseFont" title="Increase Font">
                <i class="fas fa-text-height"></i>
            </button>
            <button class="btn btn-sm btn-outline-light me-2" @onclick="DecreaseFont" title="Decrease Font">
                <i class="fas fa-text-width"></i>
            </button>
            <select class="form-select form-select-sm w-auto" @bind="textTheme">
                <option value="light">Light</option>
                <option value="dark">Dark</option>
                <option value="sepia">Sepia</option>
            </select>
            <span class="text-white ms-2">Font: @(fontSize)px</span>
        </div>
        
        <div>
            @if (Material.IsDownloadable)
            {
                <button class="btn btn-sm btn-outline-light me-2" @onclick="DownloadFile" title="Download">
                    <i class="fas fa-download"></i>
                </button>
            }
            <button class="btn btn-sm btn-outline-light" @onclick="CopyText" title="Copy Text">
                <i class="fas fa-copy"></i>
            </button>
        </div>
    </div>
    
    <!-- Text Display Area -->
    <div class="text-display-area @($"theme-{textTheme}")" 
         style="height: calc(100% - 60px); overflow: auto; padding: 20px;"
         @ref="textContainerRef"
         @onscroll="OnTextScroll">
        @if (textContent != null && !isLoading)
        {
            <pre style="font-size: @(fontSize)px; margin: 0; white-space: pre-wrap; 
                  font-family: 'Courier New', monospace; line-height: 1.5;">@textContent</pre>
        }
        else if (isLoading)
        {
            <div class="loading-overlay">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2 text-white">Loading text content securely...</div>
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center m-3">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Failed to load text content
            </div>
        }
    </div>
    
    <!-- Progress tracking section -->
    @if (CurrentProgress != null && IsAuthenticated && HasAccess)
    {
        <ProgressSection Progress="CurrentProgress" 
                        IsLoading="isLoading"
                        OnMarkAsCompleted="HandleMarkAsCompleted"
                        OnSaveProgress="SaveTextProgress"
                        ProgressPercentage="@GetProgressPercentage()" />
    }
</div>

<style>
    .text-container {
        width: 100%;
        height: 100%;
    }
    
    .theme-light {
        background-color: white;
        color: black;
    }
    
    .theme-dark {
        background-color: #1a1a1a;
        color: #f0f0f0;
    }
    
    .theme-sepia {
        background-color: #f4ecd8;
        color: #5b4636;
    }
    
    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.8);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }
</style>

@code {
    [Parameter] public LearningMaterialDto Material { get; set; }
    [Parameter] public ProgressTrackingDto? CurrentProgress { get; set; }
    [Parameter] public int CurrentEnrollmentId { get; set; }
    [Parameter] public bool IsAuthenticated { get; set; }
    [Parameter] public bool HasAccess { get; set; }
    [Parameter] public EventCallback<ProgressUpdateEventArgs> OnProgressUpdated { get; set; }
    [Parameter] public EventCallback OnMarkAsCompleted { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    
    private ElementReference textContainerRef;
    private string textContent = string.Empty;
    private bool isLoading = true;
    private int fontSize = 16;
    private string textTheme = "light";
    private double lastScrollPercentage = 0;
    private DateTime lastScrollSave = DateTime.UtcNow;
    private DateTime lastProgressSave = DateTime.UtcNow;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadTextContent();
    }
    
    private async Task LoadTextContent()
    {
        try
        {
            textContent = await SecureFileViewerService.GetTextContentAsync(Material.Id);
            
            if (textContent == null)
            {
                throw new Exception("Failed to load text content");
            }
            
            isLoading = false;
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Error loading text content: {ex.Message}");
            isLoading = false;
        }
    }
    
    private async Task OnTextScroll()
    {
        if (!IsAuthenticated || !HasAccess) return;
        
        if ((DateTime.UtcNow - lastScrollSave).TotalSeconds < 3) return;
        
        try
        {
            var scrollPercentage = await GetScrollPercentage();
            
            if (scrollPercentage > lastScrollPercentage)
            {
                lastScrollPercentage = scrollPercentage;
                
                if (scrollPercentage > 0.1 && (DateTime.UtcNow - lastProgressSave).TotalSeconds > 15)
                {
                    await SaveTextProgress();
                    lastProgressSave = DateTime.UtcNow;
                }
                
                lastScrollSave = DateTime.UtcNow;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error tracking scroll progress: {ex.Message}");
        }
    }
    
    private async Task<double> GetScrollPercentage()
    {
        try
        {
            return await JS.InvokeAsync<double>("getScrollPercentage", textContainerRef);
        }
        catch
        {
            return 0;
        }
    }
    
    private async Task SaveTextProgress()
    {
        if (!IsAuthenticated || !HasAccess || CurrentEnrollmentId == 0) return;
        
        try
        {
            int readingTime = CalculateReadingTime(lastScrollPercentage);
            bool isCompleted = lastScrollPercentage >= 0.95;
            
            var args = new ProgressUpdateEventArgs
            {
                IsCompleted = isCompleted,
                TimeSpentSeconds = (CurrentProgress?.TimeSpentSeconds ?? 0) + readingTime,
                LastPositionSeconds = 0
            };
            
            await OnProgressUpdated.InvokeAsync(args);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving text progress: {ex.Message}");
        }
    }
    
    private int CalculateReadingTime(double scrollPercentage)
    {
        double progressChange = scrollPercentage - lastScrollPercentage;
        
        if (progressChange <= 0) return 0;
        
        return (int)(progressChange * 45); // Text reading time estimate
    }
    
    private double GetProgressPercentage()
    {
        if (CurrentProgress == null) return 0;
        
        if (CurrentProgress.IsCompleted) return 100;
        
        return Math.Min(100, Math.Max(0, lastScrollPercentage * 100));
    }
    
    private async Task HandleMarkAsCompleted()
    {
        await OnMarkAsCompleted.InvokeAsync();
    }
    
    private void IncreaseFont()
    {
        fontSize = Math.Min(fontSize + 2, 32);
        StateHasChanged();
    }
    
    private void DecreaseFont()
    {
        fontSize = Math.Max(fontSize - 2, 10);
        StateHasChanged();
    }
    
    private async Task CopyText()
    {
        try
        {
            await JS.InvokeVoidAsync("copyToClipboard", textContent);
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync("Failed to copy text");
            Console.WriteLine($"Error copying text: {ex.Message}");
        }
    }
    
    private async Task DownloadFile()
    {
        try
        {
            await SecureFileViewerService.DownloadMaterialAsync(Material.Id, Material.Title);
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Download failed: {ex.Message}");
        }
    }
}