
<div class="progress-section">
    <!-- Mobile View -->
    <div class="d-block d-md-none">
        @if (Progress.IsCompleted)
        {
            <!-- Mobile Completed State -->
            <div class="bg-dark p-3 border-top">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success p-2 me-2" style="width: 32px; height: 32px;">
                            <i class="fas fa-check text-white"></i>
                        </div>
                        <div>
                            <div class="text-white fw-bold">Completed</div>
                            <small class="text-muted">@Progress.CompletedDate?.ToString("MMM dd, yyyy")</small>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-info" @onclick="HandleSaveProgress"
                            disabled="@IsLoading">
                        <i class="fas fa-save"></i>
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Mobile In Progress State -->
            <div class="bg-dark p-3 border-top">
                <!-- Header with status and actions -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-warning p-2 me-2" style="width: 32px; height: 32px;">
                            <i class="fas fa-clock text-white"></i>
                        </div>
                        <div>
                            <div class="text-white fw-bold">In Progress</div>
                            @if (Progress.TimeSpentSeconds > 0)
                            {
                                <small class="text-muted">@(ProgressPercentage)% complete</small>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-success" @onclick="HandleMarkAsCompleted"
                                title="Mark as completed" disabled="@IsLoading">
                            <i class="fas fa-check"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-info" @onclick="HandleSaveProgress"
                                title="Save progress" disabled="@IsLoading">
                            <i class="fas fa-save"></i>
                        </button>
                    </div>
                </div>

                <!-- Progress Bar -->
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-success" role="progressbar"
                         style="width: @(ProgressPercentage)%;
                                    border-radius: @(ProgressPercentage >= 100 ? "4px" : "4px 0 0 4px")">
                    </div>
                </div>

                <!-- Percentage indicator -->
                <div class="d-flex justify-content-between mt-2">
                    <small class="text-muted">Progress</small>
                    <small class="text-white fw-bold">@(ProgressPercentage)%</small>
                </div>
            </div>
        }
    </div>

    <!-- Desktop View -->
    <div class="d-none d-md-block bg-dark p-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
            <div class="text-white small">
                @if (Progress.IsCompleted)
                {
                    <span class="text-success">
                        <i class="fas fa-check-circle me-1"></i> Completed
                    </span>
                    <span class="ms-2 text-muted">
                        @Progress.CompletedDate?.ToString("MMM dd, yyyy")
                    </span>
                }
                else
                {
                    <span class="text-warning">
                        <i class="fas fa-clock me-1"></i> In Progress
                    </span>
                    @if (Progress.TimeSpentSeconds > 0)
                    {
                        <span class="ms-2 text-muted">
                            Progress: @(ProgressPercentage)%
                        </span>
                    }
                }
            </div>

            <div class="d-flex gap-2">
                @if (!Progress.IsCompleted)
                {
                    <button class="btn btn-sm btn-success" @onclick="HandleMarkAsCompleted"
                            title="Mark as completed" disabled="@IsLoading">
                        <i class="fas fa-check me-1"></i> Mark Complete
                    </button>
                }

                <button class="btn btn-sm btn-info" @onclick="HandleSaveProgress"
                        title="Save progress" disabled="@IsLoading">
                    <i class="fas fa-save me-1"></i> Save Progress
                </button>
            </div>
        </div>

        @if (!Progress.IsCompleted)
        {
            <div class="progress mt-2" style="height: 5px;">
                <div class="progress-bar bg-success" role="progressbar"
                     style="width: @(ProgressPercentage)%;"></div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public ProgressTrackingDto Progress { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public double ProgressPercentage { get; set; }
    [Parameter] public EventCallback OnMarkAsCompleted { get; set; }
    [Parameter] public EventCallback OnSaveProgress { get; set; }

    private async Task HandleMarkAsCompleted()
    {
        await OnMarkAsCompleted.InvokeAsync();
    }

    private async Task HandleSaveProgress()
    {
        await OnSaveProgress.InvokeAsync();
    }
}