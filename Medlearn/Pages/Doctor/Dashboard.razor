    private string GetReviewContentPath(ReviewDto review)
    {
        var pathParts = new List<string>();
        
        switch (review.ReviewType)
        {
            case EnrollmentType.Lecture:
                if (review.Lecture != null && review.Lecture.CourseId > 0)
                {
                    var course = myCourses.FirstOrDefault(c => c.Id == review.Lecture.CourseId);
                    if (course != null)
                    {
                        pathParts.Add(course.Title);
                        
                        if (course.SpecializationId > 0)
                        {
                            var spec = mySpecializations.FirstOrDefault(s => s.Id == course.SpecializationId);
                            if (spec != null)
                            {
                                pathParts.Add(spec.Title);
                            }
                        }
                    }
                }
                break;
                
            case EnrollmentType.Course:
                if (review.Course != null && review.Course.SpecializationId > 0)
                {
                    var spec = mySpecializations.FirstOrDefault(s => s.Id == review.Course.SpecializationId);
                    if (spec != null)
                    {
                        pathParts.Add(spec.Title);
                    }
                }
                break;
        }
        
        if (pathParts.Any())
        {
            return string.Join(" → ", pathParts.Reverse<string>());
        }
        
        return string.Empty;
    }

