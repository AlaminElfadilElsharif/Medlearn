@code {
    // Keep all your existing code in the @code block exactly as is
    private UserDto? doctor;
    private bool isAuthenticated = false;
    private List<EnrollmentDto> recentEnrollments = new();
    private List<ReviewDto> recentReviews = new();
    private List<SpecializationDto> mySpecializations = new();
    private List<CourseDto> myCourses = new();
    private List<LectureDto> myLectures = new();
    private List<PerformanceMetric> topPerformingContent = new();
    private List<ContentEnrollmentSummary> contentSummaries = new();
    private bool isLoading = true;
    
    // Statistics
    private ProfileDto doctorProfile = new ProfileDto();
    private int totalEnrollments = 0;
    private int totalReviews = 0;
    private decimal monthlyRevenue = 0;
    private decimal revenueChange = 0;
    private double completionRate = 0;

    // Mobile-specific properties
    private bool showMobileMenu = false;
    private string activeMobileTab = "overview";
    private string studentSearch = "";

    private void GoBack() => Navigation.NavigateTo("/");
    private void ToggleMobileMenu() => showMobileMenu = !showMobileMenu;
    private void SetActiveTab(string tab) => activeMobileTab = tab;
    private void SearchStudents(ChangeEventArgs e) => studentSearch = e.Value?.ToString() ?? "";
    private void ViewAllEnrollments() => Navigation.NavigateTo("/doctor/enrollments");
    private void NavigateToCreateLectureForCourse(int courseId) 
    {
        ShowCourseDropdown = false;
        Navigation.NavigateTo($"/createlecture/{courseId}");
    }

    // Helper method to get image URLs using ImageUrlService
    private string GetImageUrl(string? relativePath)
    {
        return ImageUrlService.GetImageUrl(relativePath);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
            
            if (!isAuthenticated)
            {
                await JS.InvokeVoidAsync("showToast", "warning", "Please log in to access the doctor dashboard.");
                return;
            }

            doctor = await AuthService.GetCurrentUserAsync();
            
            if (doctor == null)
            {
                await JS.InvokeVoidAsync("showToast", "error", "User information not found.");
                return;
            }

            if (doctor.UserType != UserType.Doctor)
            {
                await JS.InvokeVoidAsync("showToast", "error", "Access denied. This dashboard is only for doctors.");
                return;
            }

            // Set doctor profile from user data
            doctorProfile = doctor.Profile ?? new ProfileDto();

            // LOAD IN SEQUENCE (not parallel)
            Console.WriteLine("=== Starting sequential loading ===");
            
            // 1. First load doctor's content
            await LoadDoctorContent();
            
            // 2. Then load recent enrollments (depends on content)
            await LoadRecentEnrollments();
            
            // 3. Finally load recent reviews (depends on content)
            await LoadRecentReviews();

            // Calculate statistics
            CalculateStatistics();

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctor dashboard: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", $"Error loading dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadDoctorContent()
    {
        try
        {
            Console.WriteLine("=== START LoadDoctorContent ===");
            
            // Reset lists
            mySpecializations = new List<SpecializationDto>();
            myCourses = new List<CourseDto>();
            myLectures = new List<LectureDto>();
            
            // Get doctor's specializations
            var specializations = await SpecializationService.GetMySpecializationsAsync();
            
            if (specializations != null)
            {
                mySpecializations = specializations;
                Console.WriteLine($"Found {mySpecializations.Count} specializations");
                
                // For each specialization, get its courses
                foreach (var spec in mySpecializations)
                {
                    Console.WriteLine($"  Specialization: {spec.Id} - {spec.Title}");
                    
                    var courses = await CourseService.GetCoursesBySpecializationAsync(spec.Id);
                    if (courses != null)
                    {
                        // Filter courses created by this doctor
                        var doctorCourses = courses.Where(c => c.DoctorId == doctor?.Id).ToList();
                        myCourses.AddRange(doctorCourses);
                        Console.WriteLine($"    Found {doctorCourses.Count} courses in this specialization");
                        
                        // For each course, get its lectures
                        foreach (var course in doctorCourses)
                        {
                            Console.WriteLine($"      Course: {course.Id} - {course.Title}");
                            
                            var lectures = await LectureService.GetLecturesByCourseAsync(course.Id);
                            if (lectures != null)
                            {
                                // Filter lectures created by this doctor
                                var doctorLectures = lectures.Where(l => l.DoctorId == doctor?.Id).ToList();
                                myLectures.AddRange(doctorLectures);
                                Console.WriteLine($"        Found {doctorLectures.Count} lectures in this course");
                                
                                // Debug: Show lecture details
                                foreach (var lecture in doctorLectures)
                                {
                                    Console.WriteLine($"          Lecture: {lecture.Id} - {lecture.Title}");
                                }
                            }
                        }
                    }
                }
            }
            else
            {
                Console.WriteLine("No specializations found (GetMySpecializationsAsync returned null)");
            }
            
            Console.WriteLine($"Total Summary:");
            Console.WriteLine($"- Specializations: {mySpecializations.Count}");
            Console.WriteLine($"- Courses: {myCourses.Count}");
            Console.WriteLine($"- Lectures: {myLectures.Count}");
            
            Console.WriteLine("=== END LoadDoctorContent ===");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctor content: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            
            // Reset to empty lists on error
            mySpecializations = new List<SpecializationDto>();
            myCourses = new List<CourseDto>();
            myLectures = new List<LectureDto>();
        }
    }

    private async Task LoadRecentEnrollments()
    {
        try
        {
            var doctorEnrollments = await EnrollmentService.GetDoctorContentEnrollmentsAsync();
            
            if (doctorEnrollments == null)
            {
                recentEnrollments = new List<EnrollmentDto>();
                contentSummaries = new List<ContentEnrollmentSummary>();
                totalEnrollments = 0;
                return;
            }
            
            totalEnrollments = doctorEnrollments.Count;
            
            // First, let's group enrollments by content
            var groupedByContent = new List<ContentEnrollmentSummary>();
            
            // Group by specialization
            var specializationEnrollments = doctorEnrollments
                .Where(e => e.SpecializationId.HasValue)
                .GroupBy(e => e.SpecializationId.Value);
                
            foreach (var group in specializationEnrollments)
            {
                var spec = mySpecializations.FirstOrDefault(s => s.Id == group.Key);
                if (spec != null)
                {
                    groupedByContent.Add(new ContentEnrollmentSummary
                    {
                        ContentId = spec.Id,
                        Title = spec.Title,
                        ThumbnailUrl = spec.ThumbnailUrl,
                        ContentType = EnrollmentType.Specialization,
                        StudentEnrollments = group.ToList()
                    });
                }
            }
            
            // Group by course
            var courseEnrollments = doctorEnrollments
                .Where(e => e.CourseId.HasValue)
                .GroupBy(e => e.CourseId.Value);
                
            foreach (var group in courseEnrollments)
            {
                var course = myCourses.FirstOrDefault(c => c.Id == group.Key);
                if (course != null)
                {
                    groupedByContent.Add(new ContentEnrollmentSummary
                    {
                        ContentId = course.Id,
                        Title = course.Title,
                        ThumbnailUrl = course.ThumbnailUrl,
                        ContentType = EnrollmentType.Course,
                        StudentEnrollments = group.ToList()
                    });
                }
            }
            
            // Group by lecture
            var lectureEnrollments = doctorEnrollments
                .Where(e => e.LectureId.HasValue)
                .GroupBy(e => e.LectureId.Value);
                
            foreach (var group in lectureEnrollments)
            {
                var lecture = myLectures.FirstOrDefault(l => l.Id == group.Key);
                if (lecture != null)
                {
                    groupedByContent.Add(new ContentEnrollmentSummary
                    {
                        ContentId = lecture.Id,
                        Title = lecture.Title,
                        ContentType = EnrollmentType.Lecture,
                        StudentEnrollments = group.ToList()
                    });
                }
            }
            
            // Sort by most recent enrollment or total enrollments
            contentSummaries = groupedByContent
                .OrderByDescending(c => c.MostRecentEnrollment)
                .ThenByDescending(c => c.TotalEnrollments)
                .Take(6) // Show top 6 content items
                .ToList();
            
            // Keep flat list for other calculations
            var thirtyDaysAgo = DateTime.Now.AddDays(-30);
            recentEnrollments = doctorEnrollments
                .Where(e => e.EnrollmentDate >= thirtyDaysAgo)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading enrollments: {ex.Message}");
            contentSummaries = new List<ContentEnrollmentSummary>();
            totalEnrollments = 0;
        }
    }

    private async Task LoadRecentReviews()
    {
        try
        {
            Console.WriteLine("=== START LoadRecentReviews ===");
            var allReviews = new List<ReviewDto>();
            
            // Debug: Show what content we have
            Console.WriteLine($"My Specializations: {mySpecializations.Count}");
            Console.WriteLine($"My Courses: {myCourses.Count}");
