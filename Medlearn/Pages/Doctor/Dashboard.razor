@page "/doctor/dashboard"


<PageTitle>Doctor Dashboard</PageTitle>

<div class="doctor-dashboard">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-2" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <h5 class="mb-0 flex-grow-1">Doctor Dashboard</h5>
                    <button class="btn btn-link text-white p-0" @onclick="ToggleMobileMenu">
                        <i class="fas fa-ellipsis-v fa-lg"></i>
                    </button>
                </div>
                
                <!-- Mobile Profile Quick Info -->
                <div class="d-flex align-items-center mt-3">
                    @if (!string.IsNullOrEmpty(doctor?.ProfileImageUrl))
                    {
                        <img src="@GetImageUrl(doctor.ProfileImageUrl)" 
                             class="rounded-circle me-2" width="50" height="50" alt="Profile" 
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="avatar-placeholder bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-2" 
                             style="width: 50px; height: 50px; font-size: 1.2rem;">
                            @doctor?.FirstName?.Substring(0, 1)@doctor?.LastName?.Substring(0, 1)
                        </div>
                    }
                    <div>
                        <div class="fw-bold">Dr. @doctor?.FirstName @doctor?.LastName</div>
                        <small>@doctor?.Profile?.Title at @doctor?.Profile?.Institution</small>
                    </div>
                </div>
            </div>

            <!-- Mobile Stats Cards -->
            <div class="row g-2 p-3 bg-light">
                <div class="col-6">
                    <div class="bg-white p-3 rounded shadow-sm">
                        <small class="text-muted d-block">Balance</small>
                        <div class="fw-bold text-success">$@doctorProfile.Balance.ToString("N0")</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="bg-white p-3 rounded shadow-sm">
                        <small class="text-muted d-block">Students</small>
                        <div class="fw-bold">@doctorProfile.TotalStudents</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="bg-white p-3 rounded shadow-sm">
                        <small class="text-muted d-block">Rating</small>
                        <div class="fw-bold">
                            @doctorProfile.RatingAverage.ToString("0.0") 
                            <i class="fas fa-star text-warning small"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="bg-white p-3 rounded shadow-sm">
                        <small class="text-muted d-block">Content</small>
                        <div class="fw-bold">@(mySpecializations.Count + myCourses.Count + myLectures.Count)</div>
                    </div>
                </div>
            </div>

            <!-- Mobile Menu Overlay -->
            @if (showMobileMenu)
            {
                <div class="mobile-menu-overlay" @onclick="ToggleMobileMenu">
                    <div class="mobile-menu-content bg-white p-3" @onclick:stopPropagation="true">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">Quick Actions</h6>
                            <button class="btn btn-sm btn-light" @onclick="ToggleMobileMenu">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="list-group">
                            <button class="list-group-item list-group-item-action d-flex align-items-center" @onclick="CreateContent">
                                <i class="fas fa-plus text-primary me-3"></i> Create Content
                            </button>
                            <button class="list-group-item list-group-item-action d-flex align-items-center" @onclick="EditProfile">
                                <i class="fas fa-edit text-info me-3"></i> Edit Profile
                            </button>
                            <button class="list-group-item list-group-item-action d-flex align-items-center" @onclick="WithdrawBalance">
                                <i class="fas fa-money-bill-wave text-success me-3"></i> Withdraw Funds
                            </button>
                            <button class="list-group-item list-group-item-action d-flex align-items-center" @onclick="ViewStudents">
                                <i class="fas fa-users text-warning me-3"></i> View Students
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-block mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        @if (!string.IsNullOrEmpty(doctor?.ProfileImageUrl))
                        {
                            <img src="@GetImageUrl(doctor.ProfileImageUrl)" 
                                 class="rounded-circle" width="80" height="80" alt="Profile" 
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                 style="width: 80px; height: 80px; font-size: 2rem;">
                                @doctor?.FirstName?.Substring(0, 1)@doctor?.LastName?.Substring(0, 1)
                            </div>
                        }
                    </div>
                    <div>
                        <h1>Welcome, Dr. @doctor?.FirstName @doctor?.LastName</h1>
                        <p class="text-muted mb-0">
                            <i class="fas fa-briefcase me-1"></i> 
                            @doctor?.Profile?.Title at @doctor?.Profile?.Institution
                            @if (!string.IsNullOrEmpty(doctor?.Profile?.Department))
                            {
                                <span class="ms-2">• @doctor?.Profile?.Department</span>
                            }
                        </p>
                        @if (!string.IsNullOrEmpty(doctor?.Profile?.Expertise))
                        {
                            <p class="text-muted small mb-0">
                                <i class="fas fa-star me-1"></i> 
                                Expertise: @doctor?.Profile?.Expertise
                            </p>
                        }
                    </div>
                </div>
                <div>
                    <button class="btn btn-primary" @onclick="CreateContent">
                        <i class="fas fa-plus me-2"></i> Create Content
                    </button>
                    <button class="btn btn-outline-secondary ms-2" @onclick="EditProfile">
                        <i class="fas fa-edit me-2"></i> Edit Profile
                    </button>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading dashboard...</p>
            </div>
        }
        else if (!isAuthenticated)
        {
            <div class="alert alert-warning m-3">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Please log in to access the doctor dashboard.
                <a href="/account/login" class="alert-link ms-2">Login</a>
            </div>
        }
        else if (doctor == null || doctor.UserType != UserType.Doctor)
        {
            <div class="alert alert-danger m-3">
                <i class="fas fa-exclamation-circle me-2"></i>
                Access denied. This dashboard is only available for doctors.
                <a href="/" class="alert-link ms-2">Go to Home</a>
            </div>
        }
        else
        {
            <!-- Desktop Stats Cards -->
            <div class="d-none d-md-block">
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card stat-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted">Available Balance</h6>
                                        <h3>$@doctorProfile.Balance.ToString("N2")</h3>
                                        <small class="text-success">
                                            <i class="fas fa-wallet me-1"></i> Ready to withdraw
                                        </small>
                                    </div>
                                    <div class="stat-icon">
                                        <i class="fas fa-dollar-sign text-success"></i>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-sm btn-outline-success w-100" @onclick="WithdrawBalance">
                                        <i class="fas fa-money-bill-wave me-1"></i> Withdraw Funds
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card stat-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted">Total Students</h6>
                                        <h3>@doctorProfile.TotalStudents</h3>
                                        <small class="text-primary">
                                            <i class="fas fa-user-plus me-1"></i> Across all courses
                                        </small>
                                    </div>
                                    <div class="stat-icon">
                                        <i class="fas fa-users text-primary"></i>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-sm btn-outline-primary w-100" @onclick="ViewStudents">
                                        <i class="fas fa-list me-1"></i> View Students
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card stat-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted">Average Rating</h6>
                                        <div class="d-flex align-items-center">
                                            <div class="rating-stars me-2">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="fas fa-star @(i <= Math.Round(doctorProfile.RatingAverage) ? "text-warning" : "text-muted")"></i>
                                                }
                                            </div>
                                            <h3 class="mb-0">@doctorProfile.RatingAverage.ToString("0.0")</h3>
                                        </div>
                                        <small class="text-muted">
                                            Based on @totalReviews reviews
                                        </small>
                                    </div>
                                    <div class="stat-icon">
                                        <i class="fas fa-star text-warning"></i>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-sm btn-outline-warning w-100" @onclick="ViewReviews">
                                        <i class="fas fa-comments me-1"></i> View Reviews
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card stat-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted">Total Content</h6>
                                        <h3>@(mySpecializations.Count + myCourses.Count + myLectures.Count)</h3>
                                        <small class="text-info">
                                            @mySpecializations.Count spec(s), @myCourses.Count course(s), @myLectures.Count lecture(s)
                                        </small>
                                    </div>
                                    <div class="stat-icon">
                                        <i class="fas fa-book text-info"></i>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-sm btn-outline-info w-100" @onclick="ManageContent">
                                        <i class="fas fa-cog me-1"></i> Manage Content
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Desktop Quick Actions -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Quick Actions</h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-2">
                                        <button class="btn btn-outline-primary w-100" @onclick="NavigateToCreateSpecialization">
                                            <i class="fas fa-book me-2"></i> New Spec
                                        </button>
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-outline-success w-100" @onclick="NavigateToCreateCourse">
                                            <i class="fas fa-graduation-cap me-2"></i> New Course
                                        </button>
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-outline-info w-100" @onclick="async () => await NavigateToCreateLecture()">
                                            <i class="fas fa-video me-2"></i> New Lecture
                                        </button>
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-outline-warning w-100" @onclick="NavigateToEnrollments">
                                            <i class="fas fa-graduation-cap me-2"></i> Enrollments
                                        </button>
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-outline-danger w-100" @onclick="NavigateToRevenue">
                                            <i class="fas fa-chart-line me-2"></i> Revenue
                                        </button>
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-outline-dark w-100" @onclick="NavigateToAnalytics">
                                            <i class="fas fa-chart-pie me-2"></i> Analytics
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Quick Actions (Swipeable) -->
            <div class="d-block d-md-none my-3">
                <div class="px-3">
                    <h6 class="mb-2">Quick Actions</h6>
                    <div class="quick-actions-scroll">
                        <div class="d-flex gap-2 overflow-auto pb-2">
                            <button class="btn btn-outline-primary btn-sm flex-shrink-0" @onclick="NavigateToCreateSpecialization">
                                <i class="fas fa-book me-1"></i> New Spec
                            </button>
                            <button class="btn btn-outline-success btn-sm flex-shrink-0" @onclick="NavigateToCreateCourse">
                                <i class="fas fa-graduation-cap me-1"></i> New Course
                            </button>
                            <button class="btn btn-outline-info btn-sm flex-shrink-0" @onclick="async () => await NavigateToCreateLecture()">
                                <i class="fas fa-video me-1"></i> New Lecture
                            </button>
                            <button class="btn btn-outline-warning btn-sm flex-shrink-0" @onclick="NavigateToEnrollments">
                                <i class="fas fa-graduation-cap me-1"></i> Enrollments
                            </button>
                            <button class="btn btn-outline-danger btn-sm flex-shrink-0" @onclick="NavigateToRevenue">
                                <i class="fas fa-chart-line me-1"></i> Revenue
                            </button>
                            <button class="btn btn-outline-dark btn-sm flex-shrink-0" @onclick="NavigateToAnalytics">
                                <i class="fas fa-chart-pie me-1"></i> Analytics
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Content Tabs -->
            <div class="d-block d-md-none">
                <ul class="nav nav-tabs nav-fill" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeMobileTab == "overview" ? "active" : "")" 
                                @onclick='() => SetActiveTab("overview")'>
                            <i class="fas fa-home"></i>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeMobileTab == "content" ? "active" : "")" 
                                @onclick='() => SetActiveTab("content")'>
                            <i class="fas fa-book"></i>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeMobileTab == "students" ? "active" : "")" 
                                @onclick='() => SetActiveTab("students")'>
                            <i class="fas fa-users"></i>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeMobileTab == "reviews" ? "active" : "")" 
                                @onclick='() => SetActiveTab("reviews")'>
                            <i class="fas fa-star"></i>
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-3">
                    <!-- Overview Tab -->
                    @if (activeMobileTab == "overview")
                    {
                        <div>
                            <!-- Enrollment Overview -->
                            <div class="mb-4">
                                <h6 class="mb-3">Enrollment Overview</h6>
                                @if (contentSummaries.Any())
                                {
                                    @foreach (var content in contentSummaries.Take(3))
                                    {
                                        <div class="card mb-3">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center mb-2">
                                                    <div class="flex-grow-1">
                                                        <h6 class="mb-0">@content.Title</h6>
                                                        <small class="text-muted">
                                                            <span class="badge @GetContentTypeBadge(content.ContentType) me-2">
                                                                @content.ContentType
                                                            </span>
                                                            @content.TotalEnrollments students
                                                        </small>
                                                    </div>
                                                    <span class="fw-bold text-success">$@content.TotalRevenue.ToString("N0")</span>
                                                </div>
                                                <div class="progress mb-2" style="height: 4px;">
                                                    <div class="progress-bar bg-success" 
                                                         style="width: @(content.TotalEnrollments > 0 ? (content.CompletedEnrollments * 100.0 / content.TotalEnrollments) : 0)%">
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-between small text-muted">
                                                    <span>@content.CompletedEnrollments completed</span>
                                                    <span>@content.AverageProgress.ToString("0")% avg progress</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    
                                    @if (contentSummaries.Count > 3)
                                    {
                                        <button class="btn btn-outline-primary w-100" @onclick="ViewAllEnrollments">
                                            View All @contentSummaries.Count Enrollments
                                        </button>
                                    }
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <i class="fas fa-graduation-cap fa-2x text-muted mb-2"></i>
                                        <p class="text-muted">No enrollments yet</p>
                                    </div>
                                }
                            </div>

                            <!-- Performance Metrics -->
                            <div class="mb-4">
                                <h6 class="mb-3">Performance</h6>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="card">
                                            <div class="card-body p-3">
                                                <small class="text-muted">Completion Rate</small>
                                                <div class="fw-bold text-success">@completionRate.ToString("0")%</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="card">
                                            <div class="card-body p-3">
                                                <small class="text-muted">Monthly Revenue</small>
                                                <div class="fw-bold text-success">$@monthlyRevenue.ToString("N0")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Recent Reviews -->
                            <div>
                                <h6 class="mb-3">Recent Reviews</h6>
                                @if (recentReviews.Any())
                                {
                                    @foreach (var review in recentReviews.Take(3))
                                    {
                                        <div class="card mb-2">
                                            <div class="card-body p-3">
                                                <div class="d-flex justify-content-between mb-2">
                                                    <div class="d-flex align-items-center">
                                                        <div class="rating-stars">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i class="fas fa-star @(i <= review.Rating ? "text-warning" : "text-muted") small"></i>
                                                            }
                                                        </div>
                                                        <small class="ms-2 text-muted">@GetTimeAgo(review.ReviewDate)</small>
                                                    </div>
                                                    <span class="badge @GetReviewTypeBadge(review.ReviewType)">@review.ReviewType</span>
                                                </div>
                                                <p class="small mb-0">@review.Comment</p>
                                                <small class="text-primary">- @review.User?.FirstName @review.User?.LastName</small>
                                            </div>
                                        </div>
                                    }
                                    
                                    @if (recentReviews.Count > 3)
                                    {
                                        <button class="btn btn-outline-primary w-100" @onclick="ViewReviews">
                                            View All Reviews
                                        </button>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted small">No reviews yet</p>
                                }
                            </div>
                        </div>
                    }

                    <!-- Content Tab -->
                    @if (activeMobileTab == "content")
                    {
                        <div>
                            <!-- Specializations -->
                            @if (mySpecializations.Any())
                            {
                                <div class="mb-4">
                                    <h6 class="mb-3">Specializations</h6>
                                    @foreach (var spec in mySpecializations.Take(3))
                                    {
                                        <div class="card mb-2">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(spec.ThumbnailUrl))
                                                    {
                                                        <img src="@GetImageUrl(spec.ThumbnailUrl)" 
                                                             class="rounded me-2" width="40" height="40" alt="Specialization" 
                                                             loading="lazy" />
                                                    }
                                                    <div class="flex-grow-1">
                                                        <h6 class="mb-0">@spec.Title</h6>
                                                        <small class="text-muted">
                                                            @spec.Courses.Count courses • @spec.TotalEnrollments enrollments
                                                        </small>
                                                    </div>
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewSpecialization(spec.Id)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    
                                    @if (mySpecializations.Count > 3)
                                    {
                                        <button class="btn btn-outline-primary w-100" @onclick="NavigateToSpecializations">
                                            View All @mySpecializations.Count Specializations
                                        </button>
                                    }
                                </div>
                            }

                            <!-- Courses -->
                            @if (myCourses.Any())
                            {
                                <div class="mb-4">
                                    <h6 class="mb-3">Courses</h6>
                                    @foreach (var course in myCourses.Take(3))
                                    {
                                        <div class="card mb-2">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                                    {
                                                        <img src="@GetImageUrl(course.ThumbnailUrl)" 
                                                             class="rounded me-2" width="40" height="40" alt="Course" 
                                                             loading="lazy" />
                                                    }
                                                    <div class="flex-grow-1">
                                                        <h6 class="mb-0">@course.Title</h6>
                                                        <small class="text-muted">
                                                            @course.Lectures.Count lectures • @course.TotalEnrollments enrollments
                                                        </small>
                                                    </div>
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewCourse(course.Id)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    
                                    @if (myCourses.Count > 3)
                                    {
                                        <button class="btn btn-outline-primary w-100" @onclick="NavigateToCourses">
                                            View All @myCourses.Count Courses
                                        </button>
                                    }
                                </div>
                            }

                            <!-- Lectures -->
                            @if (myLectures.Any())
                            {
                                <div>
                                    <h6 class="mb-3">Lectures</h6>
                                    @foreach (var lecture in myLectures.Take(3))
                                    {
                                        <div class="card mb-2">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="flex-grow-1">
                                                        <h6 class="mb-0">@lecture.Title</h6>
                                                        <small class="text-muted">
                                                            @lecture.Materials.Count materials • @lecture.TotalEnrollments enrollments
                                                        </small>
                                                    </div>
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewLecture(lecture.Id)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    
                                    @if (myLectures.Count > 3)
                                    {
                                        <button class="btn btn-outline-primary w-100" @onclick="NavigateToLectures">
                                            View All @myLectures.Count Lectures
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Students Tab -->
                    @if (activeMobileTab == "students")
                    {
                        <div>
                            @if (contentSummaries.Any())
                            {
                                <div class="mb-3">
                                    <input type="text" class="form-control" placeholder="Search students..." 
                                           @bind="studentSearch" @oninput="SearchStudents" />
                                </div>

                                <div class="student-list">
                                    @{
                                        var allStudents = contentSummaries
                                            .SelectMany(c => c.StudentEnrollments.Select(e => e.User))
                                            .Where(u => u != null)
                                            .DistinctBy(u => u.Id)
                                            .Where(u => string.IsNullOrEmpty(studentSearch) || 
                                                        u.FirstName?.Contains(studentSearch, StringComparison.OrdinalIgnoreCase) == true)
                                            .ToList();
                                    }

                                    @if (allStudents.Any())
                                    {
                                        @foreach (var student in allStudents)
                                        {
                                            <div class="card mb-2">
                                                <div class="card-body p-3">
                                                    <div class="d-flex align-items-center">
                                                        @if (!string.IsNullOrEmpty(student?.ProfileImageUrl))
                                                        {
                                                            <img src="@GetImageUrl(student.ProfileImageUrl)" 
                                                                 class="rounded-circle me-2" width="40" height="40" alt="Student" />
                                                        }
                                                        else
                                                        {
                                                            <div class="avatar-placeholder-sm bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2" 
                                                                 style="width: 40px; height: 40px;">
                                                                @student?.FirstName?.Substring(0, 1)
                                                            </div>
                                                        }
                                                        <div class="flex-grow-1">
                                                            <h6 class="mb-0">@student?.FirstName @student?.LastName</h6>
                                                            <small class="text-muted">@student?.Email</small>
                                                        </div>
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewStudent(student.Id)">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted text-center py-3">No students found</p>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted text-center py-3">No students enrolled yet</p>
                            }
                        </div>
                    }

                    <!-- Reviews Tab -->
                    @if (activeMobileTab == "reviews")
                    {
                        <div>
                            @if (recentReviews.Any())
                            {
                                @foreach (var review in recentReviews)
                                {
                                    <div class="card mb-3">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between mb-2">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(review.User?.ProfileImageUrl))
                                                    {
                                                        <img src="@GetImageUrl(review.User.ProfileImageUrl)" 
                                                             class="rounded-circle me-2" width="32" height="32" alt="Student" />
                                                    }
                                                    <div>
                                                        <div class="fw-bold">@review.User?.FirstName @review.User?.LastName</div>
                                                        <div class="rating-stars">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i class="fas fa-star @(i <= review.Rating ? "text-warning" : "text-muted") small"></i>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="text-end">
                                                    <span class="badge @GetReviewTypeBadge(review.ReviewType)">@review.ReviewType</span>
                                                    <small class="text-muted d-block">@GetTimeAgo(review.ReviewDate)</small>
                                                </div>
                                            </div>
                                            
                                            <p class="small mb-2">@review.Comment</p>
                                            
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-muted">
                                                    <i class="fas @GetReviewContentIcon(review.ReviewType) me-1"></i>
                                                    @GetReviewContentTitle(review)
                                                </small>
                                                <div>
                                                    <button class="btn btn-sm btn-outline-success" @onclick="() => ThankReviewer(review.UserId)">
                                                        <i class="fas fa-thumbs-up"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted text-center py-3">No reviews yet</p>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Desktop Main Content -->
            <div class="d-none d-md-block">
                <div class="row">
                    <!-- Left Column: Recent Activity -->
                    <div class="col-lg-8">
                        <!-- Content Enrollment Summary -->
                        <div class="card mb-4">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="fas fa-chart-line me-2"></i> Content Enrollment Overview
                                    <span class="badge bg-primary ms-2">@contentSummaries.Count items</span>
                                </h5>
                                <div>
                                    <span class="text-muted me-3">
                                        <i class="fas fa-users me-1"></i> @totalEnrollments total enrollments
                                    </span>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button class="btn btn-outline-secondary" @onclick="SortByRecent" title="Sort by Recent">
                                            <i class="fas fa-clock"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" @onclick="SortByEnrollments" title="Sort by Enrollments">
                                            <i class="fas fa-user-graduate"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" @onclick="SortByRevenue" title="Sort by Revenue">
                                            <i class="fas fa-dollar-sign"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                @if (contentSummaries.Any())
                                {
                                    <div class="row g-3">
                                        @foreach (var content in contentSummaries)
                                        {
                                            <div class="col-md-6">
                                                <div class="card content-enrollment-card h-100">
                                                    <div class="card-body">
                                                        <!-- Content Header (same as original) -->
                                                        <div class="d-flex align-items-start mb-3">
                                                            @if (!string.IsNullOrEmpty(content.ThumbnailUrl) && content.ContentType != EnrollmentType.Lecture)
                                                            {
                                                                <div class="me-3 flex-shrink-0">
                                                                    <img src="@GetImageUrl(content.ThumbnailUrl)" 
                                                                         class="rounded" width="80" height="60" alt="@content.Title"
                                                                         style="object-fit: cover;" />
                                                                </div>
                                                            }
                                                            <div class="flex-grow-1">
                                                                <div class="d-flex justify-content-between align-items-start">
                                                                    <div>
                                                                        <h6 class="mb-1">
                                                                            <i class="fas @GetContentTypeIcon(content.ContentType) me-2 text-primary"></i>
                                                                            @content.Title
                                                                        </h6>
                                                                        <div class="d-flex align-items-center">
                                                                            <span class="badge @GetContentTypeBadge(content.ContentType) me-2">
                                                                                @content.ContentType
                                                                            </span>
                                                                            <small class="text-muted">
                                                                                <i class="fas fa-user-graduate me-1"></i> @content.TotalEnrollments enrollments
                                                                            </small>
                                                                        </div>
                                                                    </div>
                                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewContentDetail(content.ContentType, content.ContentId)">
                                                                        <i class="fas fa-external-link-alt"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Content Statistics -->
                                                        <div class="row g-2 mb-3">
                                                            <div class="col-4">
                                                                <div class="text-center p-2 border rounded bg-light">
                                                                    <div class="fw-bold text-primary">@content.TotalEnrollments</div>
                                                                    <small class="text-muted">Enrollments</small>
                                                                </div>
                                                            </div>
                                                            <div class="col-4">
                                                                <div class="text-center p-2 border rounded bg-light">
                                                                    <div class="fw-bold text-success">$@content.TotalRevenue.ToString("N0")</div>
                                                                    <small class="text-muted">Revenue</small>
                                                                </div>
                                                            </div>
                                                            <div class="col-4">
                                                                <div class="text-center p-2 border rounded bg-light">
                                                                    <div class="fw-bold @(content.AverageProgress >= 80 ? "text-success" : content.AverageProgress >= 50 ? "text-warning" : "text-info")">
                                                                        @content.AverageProgress.ToString("0")%
                                                                    </div>
                                                                    <small class="text-muted">Avg Progress</small>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Progress Bar -->
                                                        <div class="mb-3">
                                                            <div class="d-flex justify-content-between mb-1">
                                                                <small class="text-muted">Completion Rate</small>
                                                                <small class="text-muted">@content.CompletedEnrollments of @content.TotalEnrollments</small>
                                                            </div>
                                                            <div class="progress" style="height: 8px;">
                                                                <div class="progress-bar bg-success" 
                                                                     style="width: @(content.TotalEnrollments > 0 ? (content.CompletedEnrollments * 100.0 / content.TotalEnrollments) : 0)%">
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Recent Students -->
                                                        <div class="mb-3">
                                                            <small class="text-muted d-block mb-2">Recent Students:</small>
                                                            <div class="d-flex align-items-center">
                                                                @if (content.RecentStudents.Any())
                                                                {
                                                                    <div class="d-flex">
                                                                        @foreach (var student in content.RecentStudents)
                                                                        {
                                                                            <div class="me-2 position-relative" title="@student.FirstName @student.LastName">
                                                                                @if (!string.IsNullOrEmpty(student.ProfileImageUrl))
                                                                                {
                                                                                    <img src="@GetImageUrl(student.ProfileImageUrl)" 
                                                                                         class="rounded-circle" width="32" height="32" alt="Student" 
                                                                                         style="border: 2px solid white;" />
                                                                                }
                                                                                else
                                                                                {
                                                                                    <div class="avatar-placeholder-sm bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                                                                         style="width: 32px; height: 32px; border: 2px solid white;">
                                                                                        @student.FirstName?.Substring(0, 1)
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                    @if (content.StudentEnrollments.Select(e => e.UserId).Distinct().Count() > 3)
                                                                    {
                                                                        <div class="ms-2">
                                                                            <small class="text-muted">+@(content.StudentEnrollments.Select(e => e.UserId).Distinct().Count() - 3) more</small>
                                                                        </div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <small class="text-muted">No students yet</small>
                                                                }
                                                            </div>
                                                        </div>

                                                        <!-- Student List Toggle -->
                                                        @if (content.StudentEnrollments.Any())
                                                        {
                                                            <div>
                                                                <button class="btn btn-sm btn-link p-0 mb-2" @onclick="() => ToggleContentVisibility(content.ContentId)">
                                                                    <small class="text-primary">
                                                                        <i class="fas fa-list me-1"></i> 
                                                                        @if (IsContentVisible(content.ContentId))
                                                                        {
                                                                            <span>Hide All Students (@content.StudentEnrollments.Count)</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>View All Students (@content.StudentEnrollments.Count)</span>
                                                                        }
                                                                    </small>
                                                                </button>
                                                                
                                                                @if (IsContentVisible(content.ContentId))
                                                                {
                                                                    <div class="mt-2">
                                                                        <div class="table-responsive">
                                                                            <table class="table table-sm table-hover mb-0">
                                                                                <thead>
                                                                                    <tr>
                                                                                        <th>Student</th>
                                                                                        <th>Enrolled</th>
                                                                                        <th>Progress</th>
                                                                                        <th>Status</th>
                                                                                        <th>Actions</th>
                                                                                    </tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    @foreach (var enrollment in content.StudentEnrollments.OrderByDescending(e => e.EnrollmentDate))
                                                                                    {
                                                                                        <tr>
                                                                                            <td>
                                                                                                <div class="d-flex align-items-center">
                                                                                                    @if (!string.IsNullOrEmpty(enrollment.User?.ProfileImageUrl))
                                                                                                    {
                                                                                                        <img src="@GetImageUrl(enrollment.User.ProfileImageUrl)" 
                                                                                                             class="rounded-circle me-2" width="24" height="24" alt="Student" />
                                                                                                    }
                                                                                                    <div>
                                                                                                        <div class="small">@enrollment.User?.FirstName @enrollment.User?.LastName</div>
                                                                                                        <small class="text-muted">@enrollment.User?.Email</small>
                                                                                                    </div>
                                                                                                </div>
                                                                                            </td>
                                                                                            <td>
                                                                                                <small class="text-muted">@enrollment.EnrollmentDate.ToString("MMM dd")</small>
                                                                                            </td>
                                                                                            <td>
                                                                                                <div class="progress" style="height: 4px; width: 60px;">
                                                                                                    <div class="progress-bar @(enrollment.ProgressPercentage >= 100 ? "bg-success" : "bg-info")" 
                                                                                                         style="width: @(enrollment.ProgressPercentage)%"></div>
                                                                                                </div>
                                                                                                <small>@enrollment.ProgressPercentage.ToString("0")%</small>
                                                                                            </td>
                                                                                            <td>
                                                                                                @if (enrollment.IsCompleted)
                                                                                                {
                                                                                                    <span class="badge bg-success badge-sm">
                                                                                                        <i class="fas fa-check me-1"></i> Completed
                                                                                                    </span>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <span class="badge bg-warning badge-sm">
                                                                                                        <i class="fas fa-spinner me-1"></i> In Progress
                                                                                                    </span>
                                                                                                }
                                                                                            </td>
                                                                                            <td>
                                                                                                <button class="btn btn-sm btn-outline-primary" 
                                                                                                        @onclick="() => ViewStudent(enrollment.UserId)" 
                                                                                                        title="View Student">
                                                                                                    <i class="fas fa-eye"></i>
                                                                                                </button>
                                                                                            </td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    
                                    <!-- Summary Footer -->
                                    <div class="mt-4 pt-3 border-top">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="text-center">
                                                    <h4 class="text-primary">@contentSummaries.Sum(c => c.TotalEnrollments)</h4>
                                                    <small class="text-muted">Total Enrollments</small>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="text-center">
                                                    <h4 class="text-success">$@contentSummaries.Sum(c => c.TotalRevenue).ToString("N0")</h4>
                                                    <small class="text-muted">Total Revenue</small>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="text-center">
                                                    <h4 class="text-info">@CalculateUniqueStudents()</h4>
                                                    <small class="text-muted">Unique Students</small>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                @{
                                                    var totalCompleted = contentSummaries.Sum(c => c.CompletedEnrollments);
                                                    var totalEnroll = contentSummaries.Sum(c => c.TotalEnrollments);
                                                    var overallCompletion = totalEnroll > 0 ? (totalCompleted * 100.0 / totalEnroll) : 0;
                                                }
                                                <div class="text-center">
                                                    <h4 class="@(overallCompletion >= 50 ? "text-success" : "text-warning")">@overallCompletion.ToString("0")%</h4>
                                                    <small class="text-muted">Overall Completion</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <i class="fas fa-graduation-cap fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">No student enrollments yet</p>
                                        <button class="btn btn-primary" @onclick="CreateContent">
                                            <i class="fas fa-plus me-2"></i> Create Your First Content
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Recent Reviews -->
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="fas fa-star me-2"></i> Recent Reviews
                                </h5>
                                <div>
                                    <span class="me-2">Average: <strong>@doctorProfile.RatingAverage.ToString("0.0")</strong></span>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="NavigateToReviews">
                                        View All (@totalReviews)
                                    </button>
                                </div>
                            </div>
                            <div class="card-body">
                                @if (recentReviews.Any())
                                {
                                    <div class="list-group">
                                        @foreach (var review in recentReviews)
                                        {
                                            <div class="list-group-item">
                                                <!-- Review content (same as original) -->
                                                <div class="d-flex w-100 justify-content-between">
                                                    <div class="d-flex align-items-center">
                                                        <div class="rating-stars me-2">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i class="fas fa-star @(i <= review.Rating ? "text-warning" : "text-muted")"></i>
                                                            }
                                                        </div>
                                                        <div class="d-flex align-items-center">
                                                            <div>
                                                                <h6 class="mb-0">@review.User?.FirstName @review.User?.LastName</h6>
                                                                <small class="text-muted d-block">
                                                                    <i class="fas fa-user me-1"></i> Student
                                                                </small>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(review.User?.ProfileImageUrl))
                                                            {
                                                                <img src="@GetImageUrl(review.User.ProfileImageUrl)" 
                                                                     class="rounded-circle ms-2" width="32" height="32" alt="Reviewer" 
                                                                     loading="lazy" />
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="text-end">
                                                        <small class="text-muted d-block">@review.ReviewDate.ToString("MMM dd, yyyy")</small>
                                                        <span class="badge @GetReviewTypeBadge(review.ReviewType)">
                                                            <i class="fas @GetReviewTypeIcon(review.ReviewType) me-1"></i>
                                                            @review.ReviewType
                                                        </span>
                                                    </div>
                                                </div>
                                                
                                                <!-- Content Information -->
                                                <div class="mt-2 mb-2 p-2 bg-light rounded">
                                                    <div class="d-flex align-items-center">
                                                        <div class="me-2">
                                                            <i class="fas @GetReviewContentIcon(review.ReviewType) text-primary"></i>
                                                        </div>
                                                        <div class="flex-grow-1">
                                                            <strong>@GetReviewContentTitle(review)</strong>
                                                            @if (!string.IsNullOrEmpty(GetReviewContentPath(review)))
                                                            {
                                                                <div class="text-muted small">
                                                                    <i class="fas fa-folder me-1"></i>
                                                                    @GetReviewContentPath(review)
                                                                </div>
                                                            }
                                                        </div>
                                                        @if (CanNavigateToContent(review))
                                                        {
                                                            <div>
                                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewContent(review)" title="View Content">
                                                                    <i class="fas fa-external-link-alt"></i>
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                
                                                @if (!string.IsNullOrEmpty(review.Comment))
                                                {
                                                    <p class="mb-1 mt-2">
                                                        <i class="fas fa-quote-left me-1 text-muted"></i>
                                                        @review.Comment
                                                        <i class="fas fa-quote-right ms-1 text-muted"></i>
                                                    </p>
                                                }
                                                <div class="mt-2 d-flex justify-content-between align-items-center">
                                                    <small class="text-muted">
                                                        <i class="fas fa-clock me-1"></i>
                                                        Posted @GetTimeAgo(review.ReviewDate)
                                                    </small>
                                                    <div>
                                                        <button class="btn btn-sm btn-outline-success" @onclick="() => ThankReviewer(review.UserId)" title="Thank Reviewer">
                                                            <i class="fas fa-thumbs-up me-1"></i> Thank
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-primary ms-1" @onclick="() => ReplyToReview(review.Id)" title="Reply">
                                                            <i class="fas fa-reply me-1"></i> Reply
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <i class="fas fa-star fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">No reviews yet</p>
                                        <p class="text-muted small">Reviews will appear here when students rate your content</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Content & Analytics -->
                    <div class="col-lg-4">
                        <!-- My Content Summary (same as original) -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fas fa-book me-2"></i> My Content Summary
                                </h5>
                            </div>
                            <div class="card-body">
                                <!-- Specializations -->
                                <div class="mb-3">
                                    <h6>Specializations (@mySpecializations.Count)</h6>
                                    @if (mySpecializations.Any())
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var spec in mySpecializations.Take(3))
                                            {
                                                <div class="list-group-item px-0">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div class="d-flex align-items-center">
                                                            @if (!string.IsNullOrEmpty(spec.ThumbnailUrl))
                                                            {
                                                                <img src="@GetImageUrl(spec.ThumbnailUrl)" 
                                                                     class="rounded me-2" width="40" height="40" alt="Specialization" 
                                                                     loading="lazy" />
                                                            }
                                                            <div>
                                                                <strong>@spec.Title</strong>
                                                                <br/>
                                                                <small class="text-muted">
                                                                    @spec.Courses.Count courses • @spec.TotalEnrollments enrollments
                                                                    @if (spec.AverageRating > 0)
                                                                    {
                                                                        <span class="ms-2">
                                                                            <i class="fas fa-star text-warning"></i> @spec.AverageRating.ToString("0.0")
                                                                        </span>
                                                                    }
                                                                </small>
                                                            </div>
                                                        </div>
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewSpecialization(spec.Id)">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        @if (mySpecializations.Count > 3)
                                        {
                                            <div class="text-center mt-2">
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="NavigateToSpecializations">
                                                    View All @mySpecializations.Count Specializations
                                                </button>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted small">No specializations created yet</p>
                                    }
                                </div>

                                <!-- Courses -->
                                <div class="mb-3">
                                    <h6>Courses (@myCourses.Count)</h6>
                                    @if (myCourses.Any())
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var course in myCourses.Take(3))
                                            {
                                                <div class="list-group-item px-0">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div class="d-flex align-items-center">
