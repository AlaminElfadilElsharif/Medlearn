            }
            
            // Load reviews for courses
            foreach (var course in myCourses)
            {
                Console.WriteLine($"Fetching reviews for course: {course.Id} - {course.Title}");
                var response = await ReviewService.GetCourseReviewsAsync(course.Id, 1, 50);
                Console.WriteLine($"Response for course {course.Id}: {response != null}");
                
                var reviews = await ParseReviewResponseAsync(response);
                Console.WriteLine($"Parsed reviews count for course {course.Id}: {reviews?.Count ?? 0}");
                
                if (reviews != null && reviews.Any())
                {
                    foreach (var review in reviews)
                    {
                        Console.WriteLine($"  Review found: ID={review.Id}, Rating={review.Rating}");
                        review.Course = new CourseDto
                        {
                            Id = course.Id,
                            Title = course.Title
                        };
                    }
                    allReviews.AddRange(reviews);
                }
            }
            
            // Load reviews for lectures
            foreach (var lecture in myLectures)
            {
                Console.WriteLine($"Fetching reviews for lecture: {lecture.Id} - {lecture.Title}");
                var response = await ReviewService.GetLectureReviewsAsync(lecture.Id, 1, 50);
                Console.WriteLine($"Response for lecture {lecture.Id}: {response != null}");
                
                var reviews = await ParseReviewResponseAsync(response);
                Console.WriteLine($"Parsed reviews count for lecture {lecture.Id}: {reviews?.Count ?? 0}");
                
                if (reviews != null && reviews.Any())
                {
                    foreach (var review in reviews)
                    {
                        Console.WriteLine($"  Review found: ID={review.Id}, Rating={review.Rating}");
                        review.Lecture = new LectureDto
                        {
                            Id = lecture.Id,
                            Title = lecture.Title
                        };
                    }
                    allReviews.AddRange(reviews);
                }
            }
            
            totalReviews = allReviews.Count;
            Console.WriteLine($"Total reviews found: {totalReviews}");
            
            // Get recent reviews (last 5)
            recentReviews = allReviews
                .OrderByDescending(r => r.ReviewDate)
                .Take(5)
                .ToList();
                
            Console.WriteLine($"Recent reviews to display: {recentReviews.Count}");
            
            // Debug: Show what we found
            if (recentReviews.Any())
            {
                foreach (var review in recentReviews)
                {
                    Console.WriteLine($"Displaying Review: ID={review.Id}, Rating={review.Rating}, Type={review.ReviewType}");
                    Console.WriteLine($"  User: {review.User?.FirstName} {review.User?.LastName}");
                    Console.WriteLine($"  Comment: {review.Comment}");
                }
            }
            else
            {
                Console.WriteLine("No reviews found. Possible reasons:");
                Console.WriteLine("1. No reviews in database for doctor's content");
                Console.WriteLine("2. Reviews API returning empty response");
                Console.WriteLine("3. ParseReviewResponse returning null");
                Console.WriteLine("4. Doctor has no content yet");
            }
            
            Console.WriteLine("=== END LoadRecentReviews ===");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading reviews: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            recentReviews = new List<ReviewDto>();
            totalReviews = 0;
        }
    }

    private async Task<List<ReviewDto>?> ParseReviewResponseAsync(object? response)
    {
        if (response == null) return null;
        
        try
        {
            // First, try to cast directly to List<ReviewDto>
            if (response is List<ReviewDto> reviews)
            {
                // Need to hydrate the lecture/course/specialization objects
                return await HydrateReviewObjects(reviews);
            }
            
            // If it's not directly a list, we need to parse it from JSON
            var json = System.Text.Json.JsonSerializer.Serialize(response);
            
            // Check if the response has a specific structure
            using var jsonDoc = System.Text.Json.JsonDocument.Parse(json);
            var root = jsonDoc.RootElement;
            
            List<ReviewDto> reviewsList = null;
            
            // Your API returns an object with properties like:
            // { TotalCount = X, AverageRating = Y, Reviews = [...] }
            if (root.TryGetProperty("Reviews", out var reviewsElement))
            {
                reviewsList = System.Text.Json.JsonSerializer.Deserialize<List<ReviewDto>>(
                    reviewsElement.GetRawText(),
                    new System.Text.Json.JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true,
                        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                    }
                );
            }
            else if (root.TryGetProperty("reviews", out var reviewsElement2))
            {
                reviewsList = System.Text.Json.JsonSerializer.Deserialize<List<ReviewDto>>(
                    reviewsElement2.GetRawText(),
                    new System.Text.Json.JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true,
                        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                    }
                );
            }
            else if (root.TryGetProperty("items", out var itemsElement))
            {
                reviewsList = System.Text.Json.JsonSerializer.Deserialize<List<ReviewDto>>(
                    itemsElement.GetRawText(),
                    new System.Text.Json.JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true,
                        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                    }
                );
            }
            else if (root.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                // If the root is an array, deserialize the entire response
                reviewsList = System.Text.Json.JsonSerializer.Deserialize<List<ReviewDto>>(
                    json,
                    new System.Text.Json.JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true,
                        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                    }
                );
            }
            
            if (reviewsList == null) return null;
            
            // Hydrate the review objects with titles
            return await HydrateReviewObjects(reviewsList);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing review response: {ex.Message}");
            return null;
        }
    }

    private async Task<List<ReviewDto>> HydrateReviewObjects(List<ReviewDto> reviews)
    {
        var hydratedReviews = new List<ReviewDto>();
        
        foreach (var review in reviews)
        {
            // Create a copy of the review
            var hydratedReview = new ReviewDto
            {
                Id = review.Id,
                UserId = review.UserId,
                User = review.User,
                ReviewType = review.ReviewType,
                LectureId = review.LectureId,
                CourseId = review.CourseId,
                SpecializationId = review.SpecializationId,
                EnrollmentId = review.EnrollmentId,
                Rating = review.Rating,
                Comment = review.Comment,
                ReviewDate = review.ReviewDate,
                CreatedAt = review.CreatedAt
            };
            
            // Hydrate based on review type
            try
            {
                switch (review.ReviewType)
                {
                    case EnrollmentType.Lecture:
                        if (review.LectureId.HasValue)
                        {
                            // Get lecture from your local cache or fetch it
                            var lecture = myLectures.FirstOrDefault(l => l.Id == review.LectureId.Value);
                            if (lecture != null)
                            {
                                hydratedReview.Lecture = new LectureDto
                                {
                                    Id = lecture.Id,
                                    Title = lecture.Title,
                                    CourseId = lecture.CourseId,
                                    DoctorId = lecture.DoctorId
                                };
                            }
                            else
                            {
                                // Try to fetch it from service
                                var fetchedLecture = await LectureService.GetLectureAsync(review.LectureId.Value);
                                if (fetchedLecture != null)
                                {
                                    hydratedReview.Lecture = fetchedLecture;
                                }
                                else
                                {
                                    hydratedReview.Lecture = new LectureDto
                                    {
                                        Id = review.LectureId.Value,
                                        Title = $"Lecture #{review.LectureId}"
                                    };
                                }
                            }
                        }
                        break;
                        
                    case EnrollmentType.Course:
                        if (review.CourseId.HasValue)
                        {
                            var course = myCourses.FirstOrDefault(c => c.Id == review.CourseId.Value);
                            if (course != null)
                            {
                                hydratedReview.Course = new CourseDto
                                {
                                    Id = course.Id,
                                    Title = course.Title,
                                    SpecializationId = course.SpecializationId,
                                    DoctorId = course.DoctorId
                                };
                            }
                            else
                            {
                                var fetchedCourse = await CourseService.GetCourseAsync(review.CourseId.Value);
                                if (fetchedCourse != null)
                                {
                                    hydratedReview.Course = fetchedCourse;
                                }
                                else
                                {
                                    hydratedReview.Course = new CourseDto
                                    {
                                        Id = review.CourseId.Value,
                                        Title = $"Course #{review.CourseId}"
                                    };
                                }
                            }
                        }
                        break;
                        
                    case EnrollmentType.Specialization:
                        if (review.SpecializationId.HasValue)
                        {
                            var specialization = mySpecializations.FirstOrDefault(s => s.Id == review.SpecializationId.Value);
                            if (specialization != null)
                            {
                                hydratedReview.Specialization = new SpecializationDto
                                {
                                    Id = specialization.Id,
                                    Title = specialization.Title,
                                    DoctorId = specialization.DoctorId
                                };
                            }
                            else
                            {
                                var fetchedSpec = await SpecializationService.GetSpecializationAsync(review.SpecializationId.Value);
                                if (fetchedSpec != null)
                                {
                                    hydratedReview.Specialization = fetchedSpec;
                                }
                                else
                                {
                                    hydratedReview.Specialization = new SpecializationDto
                                    {
                                        Id = review.SpecializationId.Value,
                                        Title = $"Specialization #{review.SpecializationId}"
                                    };
                                }
                            }
                        }
                        break;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error hydrating review {review.Id}: {ex.Message}");
                // Continue with other reviews
            }
            
            hydratedReviews.Add(hydratedReview);
        }
        
        return hydratedReviews;
    }

    private void CalculateStatistics()
    {
        try
        {
            // Calculate completion rate
            var completedEnrollments = recentEnrollments.Count(e => e.IsCompleted);
            completionRate = recentEnrollments.Any() ? 
                (completedEnrollments * 100.0 / recentEnrollments.Count) : 0;

            // Calculate monthly revenue
            var currentMonth = DateTime.Now.Month;
            var currentYear = DateTime.Now.Year;
            monthlyRevenue = recentEnrollments
                .Where(e => e.EnrollmentDate.Month == currentMonth && e.EnrollmentDate.Year == currentYear)
                .Sum(e => e.PricePaid);

            // Calculate revenue change (simplified - compare with previous month)
            var lastMonth = DateTime.Now.AddMonths(-1);
            var lastMonthRevenue = recentEnrollments
                .Where(e => e.EnrollmentDate.Month == lastMonth.Month && e.EnrollmentDate.Year == lastMonth.Year)
                .Sum(e => e.PricePaid);
            
            revenueChange = lastMonthRevenue > 0 ? 
                ((monthlyRevenue - lastMonthRevenue) / lastMonthRevenue * 100) : 0;

            // Calculate top performing content
            CalculateTopPerformingContent();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating statistics: {ex.Message}");
        }
    }

    private void CalculateTopPerformingContent()
    {
        topPerformingContent = new List<PerformanceMetric>();
        
        // Add specializations
        foreach (var spec in mySpecializations)
        {
            var specEnrollments = recentEnrollments
                .Where(e => e.SpecializationId == spec.Id)
                .ToList();
            
            if (specEnrollments.Any())
            {
                topPerformingContent.Add(new PerformanceMetric
                {
                    Id = spec.Id,
                    Title = spec.Title,
                    Type = "Specialization",
                    EnrollmentCount = spec.TotalEnrollments,
                    Revenue = specEnrollments.Sum(e => e.PricePaid),
                    AverageRating = spec.AverageRating
                });
            }
        }
        
        // Add courses
        foreach (var course in myCourses)
        {
            var courseEnrollments = recentEnrollments
                .Where(e => e.CourseId == course.Id)
                .ToList();
            
            if (courseEnrollments.Any())
            {
                topPerformingContent.Add(new PerformanceMetric
                {
                    Id = course.Id,
                    Title = course.Title,
                    Type = "Course",
                    EnrollmentCount = course.TotalEnrollments,
                    Revenue = courseEnrollments.Sum(e => e.PricePaid),
                    AverageRating = course.AverageRating
                });
            }
        }
        
        // Add lectures
        foreach (var lecture in myLectures)
        {
            var lectureEnrollments = recentEnrollments
                .Where(e => e.LectureId == lecture.Id)
                .ToList();
            
            if (lectureEnrollments.Any())
            {
                topPerformingContent.Add(new PerformanceMetric
                {
                    Id = lecture.Id,
                    Title = lecture.Title,
                    Type = "Lecture",
                    EnrollmentCount = lecture.TotalEnrollments,
                    Revenue = lectureEnrollments.Sum(e => e.PricePaid),
                    AverageRating = lecture.AverageRating
                });
            }
        }
        
        // Sort by revenue
        topPerformingContent = topPerformingContent
            .OrderByDescending(p => p.Revenue)
            .Take(5)
            .ToList();
    }

