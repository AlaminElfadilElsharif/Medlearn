    private class ContentEnrollmentSummary
    {
        public int ContentId { get; set; }
        public string Title { get; set; } = string.Empty;
        public string ThumbnailUrl { get; set; } = string.Empty;
        public EnrollmentType ContentType { get; set; }
        public List<EnrollmentDto> StudentEnrollments { get; set; } = new();
        public int TotalEnrollments => StudentEnrollments.Count;
        public int ActiveEnrollments => StudentEnrollments.Count(e => !e.IsCompleted);
        public int CompletedEnrollments => StudentEnrollments.Count(e => e.IsCompleted);
        public decimal TotalRevenue => StudentEnrollments.Sum(e => e.PricePaid);
        public double AverageProgress => StudentEnrollments.Any() 
            ? StudentEnrollments.Average(e => e.ProgressPercentage) 
            : 0;
        public DateTime? MostRecentEnrollment => StudentEnrollments.Any()
            ? StudentEnrollments.Max(e => e.EnrollmentDate)
            : null;
        
        // Recent students (last 3)
        public List<UserDto> RecentStudents => StudentEnrollments
            .OrderByDescending(e => e.EnrollmentDate)
            .Select(e => e.User)
            .Where(u => u != null)
            .DistinctBy(u => u.Id)
            .Take(3)
            .ToList();
    }

