    private int CalculateUniqueStudents()
    {
        if (!contentSummaries.Any()) return 0;
        
        var allStudentIds = new HashSet<int>();
        foreach (var content in contentSummaries)
        {
            foreach (var enrollment in content.StudentEnrollments)
            {
                if (enrollment.UserId > 0)
                {
                    allStudentIds.Add(enrollment.UserId);
                }
            }
        }
        return allStudentIds.Count;
    }

