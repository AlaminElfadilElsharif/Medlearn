By proceeding, you agree to these terms and conditions.";

        await JS.InvokeVoidAsync("alert", terms);
    }

    private void CancelWithdrawal()
    {
        Navigation.NavigateTo("/doctor/dashboard");
    }

    private string GetStatusBadge(WithdrawalStatus status)
    {
        return status switch
        {
            WithdrawalStatus.Completed => "bg-success",
            WithdrawalStatus.Approved => "bg-info",
            WithdrawalStatus.Pending => "bg-warning text-dark",
            WithdrawalStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private bool CanSubmit => balanceData != null &&
                              balanceData.AvailableBalance >= minimumWithdrawal &&
                              balanceData.PendingWithdrawals == 0 &&
                              !isLoading;

    // Supporting classes
    private class PaymentMethod
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public string ProcessingTime { get; set; } = "";
    }
}