@page "/doctor/reviews"
@implements IDisposable

<PageTitle>Doctor Reviews</PageTitle>

<div class="doctor-reviews">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <h5 class="mb-0 flex-grow-1">Student Reviews</h5>
                    <button class="btn btn-link text-white p-0" @onclick="RequestReviews">
                        <i class="fas fa-envelope fa-lg"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>Student Reviews</h1>
                <p class="text-muted">Manage and respond to student feedback</p>
            </div>
            <div>
                <button class="btn btn-primary" @onclick="RequestReviews">
                    <i class="fas fa-envelope me-2"></i> Request Reviews
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading reviews...</p>
            </div>
        }
        else
        {
            <!-- Review Summary - Mobile Version -->
            <div class="d-block d-md-none mb-3">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">Average Rating</h6>
                            <span class="badge bg-primary">@totalReviews total</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <div class="display-4 fw-bold me-3">@averageRating.ToString("0.0")</div>
                            <div class="rating-large">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fas fa-star @(i <= Math.Round(averageRating) ? "text-warning" : "text-muted")"></i>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Review Summary - Desktop Version -->
            <div class="d-none d-md-block">
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card stat-card">
                            <div class="card-body">
                                <h6 class="text-muted">Average Rating</h6>
                                <div class="d-flex align-items-center">
                                    <div class="rating-large me-3">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="fas fa-star @(i <= Math.Round(averageRating) ? "text-warning" : "text-muted")"></i>
                                        }
                                    </div>
                                    <div>
                                        <h2 class="mb-0">@averageRating.ToString("0.0")</h2>
                                        <small class="text-muted">@totalReviews total reviews</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="text-muted mb-3">Rating Distribution</h6>
                                <div class="rating-distribution">
                                    @for (int i = 5; i >= 1; i--)
                                    {
                                        var count = ratingDistribution.FirstOrDefault(r => r.Rating == i)?.Count ?? 0;
                                        var percentage = totalReviews > 0 ? (count * 100.0 / totalReviews) : 0;
                                        
                                        <div class="mb-2">
                                            <div class="d-flex align-items-center">
                                                <div class="rating-stars me-2">
                                                    @for (int j = 1; j <= 5; j++)
                                                    {
                                                        <i class="fas fa-star @(j <= i ? "text-warning" : "text-muted")"></i>
                                                    }
                                                </div>
                                                <div class="progress flex-grow-1 me-2" style="height: 10px;">
                                                    <div class="progress-bar bg-warning" role="progressbar" 
                                                         style="width: @percentage%"></div>
                                                </div>
                                                <div class="text-end" style="min-width: 60px;">
                                                    <span class="fw-bold">@count</span>
                                                    <small class="text-muted">(@percentage.ToString("0")%)</small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Filters - Collapsible -->
            <div class="d-block d-md-none mb-3">
                <div class="card">
                    <div class="card-body">
                        <button class="btn btn-outline-primary w-100" @onclick="ToggleMobileFilters">
                            <i class="fas fa-sliders-h me-2"></i>
                            @if (showMobileFilters)
                            {
                                <span>Hide Filters</span>
                            }
                            else
                            {
                                <span>Show Filters</span>
                            }
                        </button>
                        
                        @if (showMobileFilters)
                        {
                            <div class="mt-3">
                                <!-- Rating Filter -->
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Rating</label>
                                    <select class="form-select form-select-sm" @bind="filterRating">
                                        <option value="0">All Ratings</option>
                                        <option value="5">5 Stars</option>
                                        <option value="4">4+ Stars</option>
                                        <option value="3">3+ Stars</option>
                                        <option value="2">2+ Stars</option>
                                        <option value="1">1+ Stars</option>
                                    </select>
                                </div>
                                
                                <!-- Content Type Filter -->
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Content Type</label>
                                    <select class="form-select form-select-sm" @bind="filterContentType">
                                        <option value="">All Content</option>
                                        <option value="specialization">Specializations</option>
                                        <option value="course">Courses</option>
                                        <option value="lecture">Lectures</option>
                                    </select>
                                </div>
                                
                                <!-- Date Range Filter -->
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Date Range</label>
                                    <select class="form-select form-select-sm" @bind="filterDateRange">
                                        <option value="7">Last 7 Days</option>
                                        <option value="30">Last 30 Days</option>
                                        <option value="90">Last 90 Days</option>
                                        <option value="365">Last Year</option>
                                        <option value="all">All Time</option>
                                    </select>
                                </div>
                                
                                <!-- Search -->
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Search</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control" placeholder="Search reviews..." 
                                               @bind="searchQuery" @bind:event="oninput" />
                                        <button class="btn btn-primary" type="button" @onclick="ApplyFilters">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Desktop Filters -->
            <div class="d-none d-md-block">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Rating</label>
                                <select class="form-select" @bind="filterRating">
                                    <option value="0">All Ratings</option>
                                    <option value="5">5 Stars</option>
                                    <option value="4">4+ Stars</option>
                                    <option value="3">3+ Stars</option>
                                    <option value="2">2+ Stars</option>
                                    <option value="1">1+ Stars</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Content Type</label>
                                <select class="form-select" @bind="filterContentType">
                                    <option value="">All Content</option>
                                    <option value="specialization">Specializations</option>
                                    <option value="course">Courses</option>
                                    <option value="lecture">Lectures</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Date Range</label>
                                <select class="form-select" @bind="filterDateRange">
                                    <option value="7">Last 7 Days</option>
                                    <option value="30">Last 30 Days</option>
                                    <option value="90">Last 90 Days</option>
                                    <option value="365">Last Year</option>
                                    <option value="all">All Time</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">&nbsp;</label>
                                <button class="btn btn-primary w-100" @onclick="ApplyFilters">
                                    <i class="fas fa-filter me-2"></i> Apply Filters
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reviews List -->
            <div class="card">
                <!-- Desktop Header -->
                <div class="d-none d-md-flex card-header justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-comments me-2"></i> Student Reviews
                    </h5>
                    <div class="d-flex align-items-center">
                        <div class="input-group input-group-sm" style="width: 200px;">
                            <input type="text" class="form-control" placeholder="Search reviews..." 
                                   @bind="searchQuery" @bind:event="oninput" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="ApplyFilters">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Mobile Header -->
                <div class="d-block d-md-none card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="fas fa-comments me-2"></i> Reviews
                            <span class="badge bg-primary ms-2">@filteredReviewItems.Count</span>
                        </h6>
                        <span class="text-muted small">Page @currentPage of @totalPages</span>
                    </div>
                </div>

                <div class="card-body p-0">
                    @if (reviewItems.Any())
                    {
                        <div class="reviews-list">
                            @foreach (var reviewItem in pagedReviewItems)
                            {
                                var review = reviewItem.Review;
                                
                                <!-- Mobile Review Card -->
                                <div class="d-block d-md-none review-item p-3 border-bottom">
                                    <!-- Header with Avatar and Actions -->
                                    <div class="d-flex mb-2">
                                        <div class="me-2">
                                            @if (!string.IsNullOrEmpty(review.User?.ProfileImageUrl))
                                            {
                                                <img src="@GetImageUrl(review.User.ProfileImageUrl)" 
                                                     class="rounded-circle" width="40" height="40" alt="Student" />
                                            }
                                            else
                                            {
                                                <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                                     style="width: 40px; height: 40px; font-size: 16px;">
                                                    @review.User?.FirstName?[0]
                                                </div>
                                            }
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h6 class="mb-0">@review.User?.FirstName @review.User?.LastName</h6>
                                                    <small class="text-muted">
                                                        <i class="fas fa-clock me-1"></i>
                                                        @review.ReviewDate.ToString("MMM dd, yyyy")
                                                    </small>
                                                </div>
                                                <div class="dropdown">
                                                    <button class="btn btn-link text-dark p-0" type="button" data-bs-toggle="dropdown">
                                                        <i class="fas fa-ellipsis-v"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li>
                                                            <button class="dropdown-item" @onclick="() => ThankStudent(review.UserId)">
                                                                <i class="fas fa-thumbs-up me-2 text-success"></i>Thank
                                                            </button>
                                                        </li>
                                                        <li>
                                                            <button class="dropdown-item" @onclick="() => ReportReview(review.Id)">
                                                                <i class="fas fa-flag me-2 text-danger"></i>Report
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Rating and Content Type -->
                                    <div class="mb-2">
                                        <div class="d-flex align-items-center mb-1">
                                            <div class="rating-stars me-2">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="fas fa-star @(i <= review.Rating ? "text-warning" : "text-muted")" style="font-size: 12px;"></i>
                                                }
                                            </div>
                                            <span class="badge @GetReviewTypeBadge(review.ReviewType) small">
                                                <i class="fas @GetEnrollmentIcon(review.ReviewType) me-1"></i>
                                                @review.ReviewType
                                            </span>
                                        </div>
                                        <small class="text-muted d-block">
                                            @GetReviewEntityTitle(review)
                                        </small>
                                    </div>

                                    <!-- Comment -->
                                    @if (!string.IsNullOrEmpty(review.Comment))
                                    {
                                        <div class="review-comment mb-2 p-2 bg-light rounded">
                                            <p class="mb-0 small">"@review.Comment"</p>
                                        </div>
                                    }

                                    <!-- Doctor Response -->
                                    @if (reviewItem.DoctorResponse != null)
                                    {
                                        <div class="doctor-response p-2 bg-light rounded mb-2">
                                            <div class="d-flex mb-1">
                                                <i class="fas fa-user-md text-primary me-2"></i>
                                                <strong class="small">Your Response</strong>
                                                <small class="text-muted ms-2">
                                                    @reviewItem.DoctorResponse.ResponseDate.ToString("MMM dd")
                                                </small>
                                            </div>
                                            <p class="mb-0 small">@reviewItem.DoctorResponse.Comment</p>
                                        </div>
                                    }

                                    <!-- Response Form -->
                                    @if (reviewItem.DoctorResponse == null)
                                    {
                                        <div class="mb-2">
                                            <textarea class="form-control form-control-sm" 
                                                      placeholder="Write a response..."
                                                      rows="2"
                                                      @bind="@reviewItem.NewResponse"></textarea>
                                        </div>
                                    }

                                    <!-- Action Buttons -->
                                    <div class="d-flex gap-2">
                                        @if (reviewItem.DoctorResponse == null)
                                        {
                                            <button class="btn btn-sm btn-primary flex-fill" 
                                                    @onclick="() => SubmitResponse(reviewItem)">
                                                <i class="fas fa-reply me-1"></i> Reply
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-primary flex-fill" 
                                                    @onclick="() => EditResponse(reviewItem)">
                                                <i class="fas fa-edit me-1"></i> Edit
                                            </button>
                                        }
                                    </div>
                                </div>

                                <!-- Desktop Review Card -->
                                <div class="d-none d-md-block review-item p-4 border-bottom">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <!-- Student Info -->
                                            <div class="d-flex mb-3">
                                                <div class="me-3">
                                                    @if (!string.IsNullOrEmpty(review.User?.ProfileImageUrl))
                                                    {
                                                        <img src="@GetImageUrl(review.User.ProfileImageUrl)" 
                                                             class="rounded-circle" width="48" height="48" alt="Student" />
                                                    }
                                                    else
                                                    {
                                                        <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                                             style="width: 48px; height: 48px;">
                                                            @review.User?.FirstName?[0]
                                                        </div>
                                                    }
                                                </div>
                                                <div>
                                                    <h6 class="mb-1">@review.User?.FirstName @review.User?.LastName</h6>
                                                    <p class="text-muted small mb-0">
                                                        <i class="fas fa-clock me-1"></i>
                                                        @review.ReviewDate.ToString("MMMM dd, yyyy")
                                                    </p>
                                                </div>
                                            </div>

                                            <!-- Rating -->
                                            <div class="mb-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="rating-stars me-2">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <i class="fas fa-star @(i <= review.Rating ? "text-warning" : "text-muted")"></i>
                                                        }
                                                    </div>
                                                    <span class="badge @GetReviewTypeBadge(review.ReviewType)">
                                                        <i class="fas @GetEnrollmentIcon(review.ReviewType) me-1"></i>
                                                        @review.ReviewType
                                                    </span>
                                                    <span class="ms-2 small text-muted">
                                                        @GetReviewEntityTitle(review)
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Comment -->
                                            @if (!string.IsNullOrEmpty(review.Comment))
                                            {
                                                <div class="review-comment mb-3">
                                                    <p class="mb-0">@review.Comment</p>
                                                </div>
                                            }

                                            <!-- Doctor Response -->
                                            @if (reviewItem.DoctorResponse != null)
                                            {
                                                <div class="doctor-response p-3 bg-light rounded">
                                                    <div class="d-flex mb-2">
                                                        <div class="me-2">
                                                            <i class="fas fa-user-md text-primary"></i>
                                                        </div>
                                                        <div>
                                                            <strong>Your Response</strong>
                                                            <small class="text-muted ms-2">
                                                                @reviewItem.DoctorResponse.ResponseDate.ToString("MMM dd")
                                                            </small>
                                                        </div>
                                                    </div>
                                                    <p class="mb-0 small">@reviewItem.DoctorResponse.Comment</p>
                                                </div>
                                            }
                                        </div>

                                        <div class="col-md-4">
                                            <!-- Actions -->
                                            <div class="d-flex flex-column h-100">
                                                @if (reviewItem.DoctorResponse == null)
                                                {
                                                    <div class="mb-3">
                                                        <textarea class="form-control form-control-sm" 
                                                                  placeholder="Type your response here..."
                                                                  rows="3"
                                                                  @bind="@reviewItem.NewResponse"></textarea>
                                                    </div>
                                                }

                                                <div class="mt-auto">
                                                    <div class="btn-group w-100">
                                                        @if (reviewItem.DoctorResponse == null)
                                                        {
                                                            <button class="btn btn-sm btn-primary" 
                                                                    @onclick="() => SubmitResponse(reviewItem)">
                                                                <i class="fas fa-reply me-1"></i> Reply
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-outline-primary" 
                                                                    @onclick="() => EditResponse(reviewItem)">
                                                                <i class="fas fa-edit me-1"></i> Edit
                                                            </button>
                                                        }
                                                        
                                                        <button class="btn btn-sm btn-outline-success" 
                                                                @onclick="() => ThankStudent(review.UserId)">
                                                            <i class="fas fa-thumbs-up me-1"></i> Thank
                                                        </button>
                                                        
                                                        <button class="btn btn-sm btn-outline-danger" 
                                                                @onclick="() => ReportReview(review.Id)">
                                                            <i class="fas fa-flag me-1"></i> Report
                                                        </button>
                                                    </div>

                                                    <div class="mt-2 text-end">
                                                        <small class="text-muted">
                                                            <i class="fas fa-info-circle me-1"></i>
                                                            ID: @review.Id
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Mobile Pagination -->
                        <div class="d-block d-md-none p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <button class="btn btn-sm btn-outline-primary @(currentPage == 1 ? "disabled" : "")" 
                                        @onclick="() => ChangePage(currentPage - 1)">
                                    <i class="fas fa-chevron-left"></i> Previous
                                </button>
                                <span class="small">Page @currentPage of @totalPages</span>
                                <button class="btn btn-sm btn-outline-primary @(currentPage == totalPages ? "disabled" : "")" 
                                        @onclick="() => ChangePage(currentPage + 1)">
                                    Next <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Desktop Pagination -->
                        @if (totalPages > 1)
                        {
                            <div class="d-none d-md-block card-footer">
                                <nav aria-label="Review pagination">
                                    <ul class="pagination justify-content-center mb-0">
                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">
                                                <i class="fas fa-chevron-left"></i>
                                            </button>
                                        </li>
                                        
                                        @for (int i = 1; i <= totalPages; i++)
                                        {
                                            @if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                                            {
                                                <li class="page-item @(i == currentPage ? "active" : "")">
                                                    <button class="page-link" @onclick="() => ChangePage(i)">
                                                        @i
                                                    </button>
                                                </li>
                                            }
                                            else if (i == currentPage - 3 || i == currentPage + 3)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                        }
                                        
                                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">
                                                <i class="fas fa-chevron-right"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-comments fa-3x text-muted mb-3"></i>
                            <h5>No Reviews Yet</h5>
                            <p class="text-muted">You haven't received any reviews for your content yet.</p>
                            <button class="btn btn-primary" @onclick="RequestReviews">
                                <i class="fas fa-envelope me-2"></i> Request Reviews
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Mobile Review Insights -->
            <div class="d-block d-md-none mt-3">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-chart-bar me-2"></i> Quick Insights
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <small class="text-muted d-block mb-2">By Content Type</small>
                            @foreach (var item in reviewsByType)
                            {
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between small">
                                        <span>
                                            <i class="fas @GetEnrollmentIcon(item.Type) me-1"></i>
                                            @item.Type
                                        </span>
                                        <span>@item.Count reviews</span>
                                    </div>
                                    <div class="progress" style="height: 5px;">
                                        <div class="progress-bar bg-info" style="width: @((item.Count * 100.0) / Math.Max(reviewsByType.Sum(r => r.Count), 1))%"></div>
                                    </div>
                                    <small class="text-muted">Avg: @item.AverageRating.ToString("0.0")</small>
                                </div>
                            }
                        </div>
                        <div>
                            <small class="text-muted d-block mb-2">Recent Trend</small>
                            @foreach (var trend in reviewTrend.TakeLast(3))
                            {
                                <div class="d-flex justify-content-between align-items-center mb-1 small">
                                    <span>@trend.Month</span>
                                    <span>@trend.Count reviews</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Desktop Review Insights -->
            <div class="d-none d-md-block">
                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fas fa-chart-bar me-2"></i> Reviews by Content Type
                                </h5>
                            </div>
                            <div class="card-body">
                                @if (reviewsByType.Any())
                                {
                                    <div class="chart-container" style="height: 250px;">
                                        <div class="d-flex flex-column">
                                            @foreach (var item in reviewsByType)
                                            {
                                                <div class="mb-2">
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <span>
                                                            <i class="fas @GetEnrollmentIcon(item.Type) me-2"></i>
                                                            @item.Type.ToString()
                                                        </span>
                                                        <span class="fw-bold">@item.Count</span>
                                                    </div>
                                                    <div class="progress" style="height: 10px;">
                                                        <div class="progress-bar" role="progressbar" 
                                                             style="width: @((item.Count * 100.0) / Math.Max(reviewsByType.Sum(r => r.Count), 1))%">
                                                        </div>
                                                    </div>
                                                    <small class="text-muted">
                                                        Avg. Rating: @item.AverageRating.ToString("0.0")
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <p class="text-muted">No review data by content type</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fas fa-chart-line me-2"></i> Review Trend
                                </h5>
                            </div>
                            <div class="card-body">
                                @if (reviewTrend.Any())
                                {
                                    <div class="chart-container" style="height: 250px;">
                                        <div class="d-flex flex-column">
                                            @foreach (var trend in reviewTrend.TakeLast(6))
                                            {
                                                <div class="mb-2">
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <span>@trend.Month</span>
                                                        <span class="fw-bold">@trend.Count</span>
                                                    </div>
                                                    <div class="progress" style="height: 8px;">
                                                        <div class="progress-bar bg-info" role="progressbar" 
                                                             style="width: @((trend.Count * 100.0) / Math.Max(reviewTrend.Max(t => t.Count), 1))%">
                                                        </div>
                                                    </div>
                                                    <small class="text-muted">
                                                        Avg: @trend.AverageRating.ToString("0.0")
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <p class="text-muted">No review trend data</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // ... (keep all your existing code in the @code block exactly as is)
    private List<ReviewItem> reviewItems = new();
    private bool isLoading = true;
    private string searchQuery = "";
    private string filterRating = "0";
    private string? filterContentType = "";
    private string filterDateRange = "30";
    private int currentPage = 1;
    private int pageSize = 10;
    
    // Mobile-specific fields
    private bool showMobileFilters = false;
    
    // Statistics
    private double averageRating = 0;
    private int totalReviews = 0;
    private List<RatingDistribution> ratingDistribution = new();
    private List<ReviewByType> reviewsByType = new();
    private List<ReviewTrend> reviewTrend = new();
    
    private int totalPages => (int)Math.Ceiling(filteredReviewItems.Count / (double)pageSize);
    private List<ReviewItem> filteredReviewItems => GetFilteredReviewItems();
    private List<ReviewItem> pagedReviewItems => GetPagedReviewItems();

    private string GetImageUrl(string? relativePath)
    {
        if (string.IsNullOrEmpty(relativePath))
            return "/images/default-avatar.png";
        
        if (relativePath.StartsWith("http"))
            return relativePath;
        
        return $"/uploads/{relativePath}";
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/doctor/dashboard");
    }

    private void ToggleMobileFilters()
    {
        showMobileFilters = !showMobileFilters;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadReviews();
    }

    private async Task LoadReviews()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Load all reviews for doctor's content
            await LoadAllReviews();
            CalculateStatistics();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showToast", "error", $"Error loading reviews: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAllReviews()
    {
        reviewItems.Clear();

        // Load doctor's content
        var currentUser = await AuthService.GetCurrentUserAsync();
        var doctorId = currentUser?.Id ?? 0;
        
        if (doctorId == 0) return;

        var specializations = await SpecializationService.GetMySpecializationsAsync() ?? new List<SpecializationDto>();

        foreach (var spec in specializations)
        {
            // Load specialization reviews
            var specReviews = await GetReviewsForSpecialization(spec.Id);
            if (specReviews != null)
            {
                foreach (var review in specReviews)
                {
                    reviewItems.Add(new ReviewItem
                    {
                        Review = review,
                        DoctorResponse = await GetDoctorResponse(review.Id, doctorId)
                    });
                }
            }

            // Load course reviews
            var courses = await CourseService.GetCoursesBySpecializationAsync(spec.Id);
            if (courses != null)
            {
                foreach (var course in courses.Where(c => c.DoctorId == doctorId))
                {
                    var courseReviews = await GetReviewsForCourse(course.Id);
                    if (courseReviews != null)
                    {
                        foreach (var review in courseReviews)
                        {
                            reviewItems.Add(new ReviewItem
                            {
                                Review = review,
                                DoctorResponse = await GetDoctorResponse(review.Id, doctorId)
                            });
                        }
                    }

                    // Load lecture reviews
                    var lectures = await LectureService.GetLecturesByCourseAsync(course.Id);
                    if (lectures != null)
                    {
                        foreach (var lecture in lectures.Where(l => l.DoctorId == doctorId))
                        {
                            var lectureReviews = await GetReviewsForLecture(lecture.Id);
                            if (lectureReviews != null)
                            {
                                foreach (var review in lectureReviews)
                                {
                                    reviewItems.Add(new ReviewItem
                                    {
                                        Review = review,
                                        DoctorResponse = await GetDoctorResponse(review.Id, doctorId)
                                    });
                                }
                            }
                        }
                    }
                }
            }
        }

        totalReviews = reviewItems.Count;
    }

    private async Task<DoctorResponse?> GetDoctorResponse(int reviewId, int doctorId)
    {
        // This would typically come from your API
        // For now, we'll simulate it
        try
        {
            // Try to get doctor responses from localStorage or API
            var responsesJson = await JS.InvokeAsync<string>("localStorage.getItem", $"doctor_responses_{doctorId}");
            if (!string.IsNullOrEmpty(responsesJson))
            {
                var responses = System.Text.Json.JsonSerializer.Deserialize<List<DoctorResponse>>(responsesJson);
                return responses?.FirstOrDefault(r => r.ReviewId == reviewId);
            }
        }
        catch { }
        
        return null;
    }

    private async Task<List<ReviewDto>?> GetReviewsForSpecialization(int specializationId)
    {
        try
        {
            var response = await ReviewService.GetSpecializationReviewsAsync(specializationId);
            return ParseReviewResponse(response);
        }
        catch { return null; }
    }

    private async Task<List<ReviewDto>?> GetReviewsForCourse(int courseId)
    {
        try
        {
            var response = await ReviewService.GetCourseReviewsAsync(courseId);
            return ParseReviewResponse(response);
        }
        catch { return null; }
    }

    private async Task<List<ReviewDto>?> GetReviewsForLecture(int lectureId)
    {
        try
        {
            var response = await ReviewService.GetLectureReviewsAsync(lectureId);
            return ParseReviewResponse(response);
        }
        catch { return null; }
    }

    private List<ReviewDto>? ParseReviewResponse(object? response)
    {
        if (response == null) return null;
        
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(response);
            using var jsonDoc = System.Text.Json.JsonDocument.Parse(json);
            var root = jsonDoc.RootElement;
            
            if (root.TryGetProperty("Reviews", out var reviewsElement) ||
                root.TryGetProperty("reviews", out reviewsElement) ||
                root.TryGetProperty("items", out reviewsElement))
            {
                return System.Text.Json.JsonSerializer.Deserialize<List<ReviewDto>>(
                    reviewsElement.GetRawText(),
                    new System.Text.Json.JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    }
                );
            }
            
            return System.Text.Json.JsonSerializer.Deserialize<List<ReviewDto>>(
                json,
                new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }
            );
        }
        catch { return null; }
    }

    private void CalculateStatistics()
    {
        averageRating = reviewItems.Any() ? reviewItems.Average(r => r.Review.Rating) : 0;

        // Calculate rating distribution
        ratingDistribution = Enumerable.Range(1, 5)
            .Select(i => new RatingDistribution
            {
                Rating = i,
                Count = reviewItems.Count(r => r.Review.Rating == i)
            })
            .ToList();

        // Calculate reviews by type
        reviewsByType = reviewItems
            .GroupBy(r => r.Review.ReviewType)
            .Select(g => new ReviewByType
            {
                Type = g.Key,
                Count = g.Count(),
                AverageRating = g.Average(r => r.Review.Rating)
            })
            .ToList();

        // Calculate review trend
        reviewTrend = reviewItems
            .GroupBy(r => new { r.Review.ReviewDate.Year, r.Review.ReviewDate.Month })
            .Select(g => new ReviewTrend
            {
                Year = g.Key.Year,
                Month = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(g.Key.Month),
                Count = g.Count(),
                AverageRating = g.Average(r => r.Review.Rating)
            })
            .OrderBy(t => t.Year).ThenBy(t => t.Month)
            .ToList();
    }

    private List<ReviewItem> GetFilteredReviewItems()
    {
        var query = reviewItems.AsQueryable();

        // Apply rating filter
        if (int.TryParse(filterRating, out int rating) && rating > 0)
        {
            query = query.Where(r => r.Review.Rating >= rating);
        }

        // Apply content type filter
        if (!string.IsNullOrEmpty(filterContentType))
        {
            var type = filterContentType switch
            {
                "specialization" => EnrollmentType.Specialization,
                "course" => EnrollmentType.Course,
                "lecture" => EnrollmentType.Lecture,
                _ => (EnrollmentType?)null
            };
            
            if (type.HasValue)
                query = query.Where(r => r.Review.ReviewType == type.Value);
        }

        // Apply date range filter
        if (filterDateRange != "all" && int.TryParse(filterDateRange, out int days))
        {
            var startDate = DateTime.Now.AddDays(-days);
            query = query.Where(r => r.Review.ReviewDate >= startDate);
        }

        // Apply search query
        if (!string.IsNullOrEmpty(searchQuery))
        {
            query = query.Where(r =>
                (r.Review.User != null && (
                    r.Review.User.FirstName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    r.Review.User.LastName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    r.Review.User.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                )) ||
                (!string.IsNullOrEmpty(r.Review.Comment) && 
                 r.Review.Comment.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (r.Review.Lecture != null && r.Review.Lecture.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (r.Review.Course != null && r.Review.Course.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (r.Review.Specialization != null && r.Review.Specialization.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            );
        }

        return query
            .OrderByDescending(r => r.Review.ReviewDate)
            .ToList();
    }

    private List<ReviewItem> GetPagedReviewItems()
    {
        return filteredReviewItems
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void ApplyFilters()
    {
        currentPage = 1;
        showMobileFilters = false; // Auto-close filters on mobile after applying
        StateHasChanged();
    }

    private void ChangePage(int page)
    {
        currentPage = page;
        StateHasChanged();
    }

    private string GetReviewTypeBadge(EnrollmentType type)
    {
        return type switch
        {
            EnrollmentType.Lecture => "bg-info",
            EnrollmentType.Course => "bg-primary",
            EnrollmentType.Specialization => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetEnrollmentIcon(EnrollmentType type)
    {
        return type switch
        {
            EnrollmentType.Lecture => "fa-video",
            EnrollmentType.Course => "fa-graduation-cap",
            EnrollmentType.Specialization => "fa-book",
            _ => "fa-file"
        };
    }

    private string GetReviewEntityTitle(ReviewDto review)
    {
        return review.ReviewType switch
        {
            EnrollmentType.Lecture => review.Lecture?.Title ?? "Lecture Review",
            EnrollmentType.Course => review.Course?.Title ?? "Course Review",
            EnrollmentType.Specialization => review.Specialization?.Title ?? "Specialization Review",
            _ => "Review"
        };
    }

    private async Task RequestReviews()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", 
            "Send review requests to students who completed your content?");
        
        if (confirmed)
        {
            // Here you would call a service to send review requests
            await JS.InvokeVoidAsync("showToast", "success", 
                "Review requests sent to eligible students!");
        }
    }

    private async Task SubmitResponse(ReviewItem reviewItem)
    {
        if (string.IsNullOrWhiteSpace(reviewItem.NewResponse))
        {
            await JS.InvokeVoidAsync("showToast", "warning", 
                "Please enter a response before submitting.");
            return;
        }

        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            var doctorId = currentUser?.Id ?? 0;
            
            if (doctorId == 0) return;

            reviewItem.DoctorResponse = new DoctorResponse
            {
                Id = reviewItem.Review.Id * 1000 + 1, // Simple ID generation
                ReviewId = reviewItem.Review.Id,
                DoctorId = doctorId,
                Comment = reviewItem.NewResponse,
                ResponseDate = DateTime.Now
            };

            // Save to localStorage (in real app, save to API)
            await SaveDoctorResponse(reviewItem.DoctorResponse, doctorId);

            reviewItem.NewResponse = "";
            await JS.InvokeVoidAsync("showToast", "success", 
                "Response submitted successfully!");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showToast", "error", 
                $"Error submitting response: {ex.Message}");
        }
    }

    private async Task SaveDoctorResponse(DoctorResponse response, int doctorId)
    {
        try
        {
            // Load existing responses
            var responsesJson = await JS.InvokeAsync<string>("localStorage.getItem", $"doctor_responses_{doctorId}");
            var responses = new List<DoctorResponse>();
            
            if (!string.IsNullOrEmpty(responsesJson))
            {
                responses = System.Text.Json.JsonSerializer.Deserialize<List<DoctorResponse>>(responsesJson) ?? new List<DoctorResponse>();
            }

            // Remove existing response for this review
            responses.RemoveAll(r => r.ReviewId == response.ReviewId);
            
            // Add new response
            responses.Add(response);
            
            // Save back to localStorage
            await JS.InvokeVoidAsync("localStorage.setItem", 
                $"doctor_responses_{doctorId}", 
                System.Text.Json.JsonSerializer.Serialize(responses));
        }
        catch { }
    }

    private async Task EditResponse(ReviewItem reviewItem)
    {
        if (reviewItem.DoctorResponse == null) return;

        var newResponse = await JS.InvokeAsync<string>("prompt", 
            "Edit your response:", 
            reviewItem.DoctorResponse.Comment);
        
        if (!string.IsNullOrEmpty(newResponse))
        {
            reviewItem.DoctorResponse.Comment = newResponse;
            reviewItem.DoctorResponse.ResponseDate = DateTime.Now;
            
            var currentUser = await AuthService.GetCurrentUserAsync();
            var doctorId = currentUser?.Id ?? 0;
            
            if (doctorId > 0)
            {
                await SaveDoctorResponse(reviewItem.DoctorResponse, doctorId);
            }
            
            await JS.InvokeVoidAsync("showToast", "success", 
                "Response updated successfully!");
            StateHasChanged();
        }
    }

