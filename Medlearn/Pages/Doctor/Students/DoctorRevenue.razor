@page "/doctor/revenue"


<PageTitle>Doctor Revenue</PageTitle>

<div class="doctor-revenue">
    <div class="container-fluid px-0 px-md-4">
        <!-- Mobile Header -->
        <div class="d-block d-md-none mb-3">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <div class="flex-grow-1">
                        <h5 class="mb-0">Revenue Analytics</h5>
                        <small class="opacity-75">Track your earnings</small>
                    </div>
                    <button class="btn btn-link text-white p-0 ms-2" @onclick="ExportRevenueReport">
                        <i class="fas fa-file-export fa-lg"></i>
                    </button>
                </div>
            </div>
            
            <!-- Mobile Quick Stats -->
            <div class="row g-2 mt-3 px-3">
                <div class="col-6">
                    <div class="bg-white p-3 rounded-3 shadow-sm">
                        <small class="text-muted d-block">Available</small>
                        <strong class="h5 mb-0">$@availableBalance.ToString("N2")</strong>
                    </div>
                </div>
                <div class="col-6">
                    <div class="bg-white p-3 rounded-3 shadow-sm">
                        <small class="text-muted d-block">This Month</small>
                        <strong class="h5 mb-0">$@monthlyRevenue.ToString("N2")</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-block mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                <div class="mb-3 mb-md-0">
                    <h1 class="h2 mb-1">Revenue Analytics</h1>
                    <p class="text-muted mb-0">Track your earnings and revenue performance</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-primary" @onclick="RequestWithdrawal">
                        <i class="fas fa-money-bill-wave me-2"></i> Request Withdrawal
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ExportRevenueReport">
                        <i class="fas fa-file-export me-2"></i> Export Report
                    </button>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading revenue data...</p>
            </div>
        }
        else if (hasError)
        {
            <div class="alert alert-danger mx-3 mx-md-0">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
                <button class="btn btn-sm btn-outline-danger ms-3" @onclick="LoadRevenueData">
                    <i class="fas fa-redo me-1"></i> Retry
                </button>
            </div>
        }
        else
        {
            <!-- Desktop Revenue Summary Cards -->
            <div class="d-none d-md-block">
                <div class="row g-3 mb-4">
                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="text-muted mb-2">Total Revenue</h6>
                                        <h3 class="mb-0">$@totalRevenue.ToString("N2")</h3>
                                        <small class="@GetRevenueChangeClass(revenueChange)">
                                            <i class="fas @(revenueChange >= 0 ? "fa-arrow-up" : "fa-arrow-down") me-1"></i> 
                                            @(revenueChange >= 0 ? "+" : "")@revenueChange.ToString("0")% from last period
                                        </small>
                                    </div>
                                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded">
                                        <i class="fas fa-chart-line fa-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="text-muted mb-2">Available Balance</h6>
                                        <h3 class="mb-0">$@availableBalance.ToString("N2")</h3>
                                        <small class="text-primary">
                                            <i class="fas fa-wallet me-1"></i> Ready to withdraw
                                        </small>
                                    </div>
                                    <div class="bg-success bg-opacity-10 text-success p-2 rounded">
                                        <i class="fas fa-wallet fa-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="text-muted mb-2">This Month</h6>
                                        <h3 class="mb-0">$@monthlyRevenue.ToString("N2")</h3>
                                        <small class="text-warning">
                                            <i class="fas fa-calendar-alt me-1"></i> 
                                            @monthlyTransactions enrollments
                                        </small>
                                    </div>
                                    <div class="bg-warning bg-opacity-10 text-warning p-2 rounded">
                                        <i class="fas fa-calendar-alt fa-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="text-muted mb-2">Avg. per Student</h6>
                                        <h3 class="mb-0">$@averagePerStudent.ToString("N2")</h3>
                                        <small class="text-info">
                                            <i class="fas fa-user-graduate me-1"></i> 
                                            Lifetime value
                                        </small>
                                    </div>
                                    <div class="bg-info bg-opacity-10 text-info p-2 rounded">
                                        <i class="fas fa-user-graduate fa-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Compact Stats -->
            <div class="d-block d-md-none px-3 mb-3">
                <div class="row g-2">
                    <div class="col-6">
                        <div class="bg-white p-2 rounded-3 shadow-sm">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary p-2 rounded me-2">
                                    <i class="fas fa-chart-line"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Total</small>
                                    <strong>$@totalRevenue.ToString("N0")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="bg-white p-2 rounded-3 shadow-sm">
                            <div class="d-flex align-items-center">
                                <div class="bg-success bg-opacity-10 text-success p-2 rounded me-2">
                                    <i class="fas fa-wallet"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Balance</small>
                                    <strong>$@availableBalance.ToString("N0")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Filters (Bottom Sheet Style) -->
            <div class="d-block d-md-none mb-3 px-3">
                <div class="bg-white rounded-3 shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">Filters</h6>
                        <span class="badge bg-primary" @onclick="ToggleFilters">
                            <i class="fas @(showMobileFilters ? "fa-chevron-up" : "fa-chevron-down")"></i>
                        </span>
                    </div>
                    
                    @if (showMobileFilters)
                    {
                        <div class="mt-3">
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Date Range</label>
                                <select class="form-select form-select-sm" @bind="dateRange" @bind:event="onchange">
                                    <option value="30">Last 30 Days</option>
                                    <option value="90">Last 90 Days</option>
                                    <option value="180">Last 6 Months</option>
                                    <option value="365">Last Year</option>
                                    <option value="all">All Time</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Content Type</label>
                                <select class="form-select form-select-sm" @bind="contentType" @bind:event="onchange">
                                    <option value="">All Content</option>
                                    <option value="1">Lectures</option>
                                    <option value="2">Courses</option>
                                    <option value="3">Specializations</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Group By</label>
                                <select class="form-select form-select-sm" @bind="groupBy" @bind:event="onchange">
                                    <option value="day">Daily</option>
                                    <option value="week">Weekly</option>
                                    <option value="month">Monthly</option>
                                </select>
                            </div>
                            <button class="btn btn-primary w-100 btn-sm mt-2" @onclick="UpdateRevenueData">
                                <i class="fas fa-sync me-2"></i> Apply Filters
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Desktop Filters Section -->
            <div class="d-none d-md-block card mb-4 border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="card-title mb-3">Filter Revenue Data</h6>
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label small fw-bold">Date Range</label>
                            <select class="form-select" @bind="dateRange" @bind:event="onchange">
                                <option value="30">Last 30 Days</option>
                                <option value="90">Last 90 Days</option>
                                <option value="180">Last 6 Months</option>
                                <option value="365">Last Year</option>
                                <option value="all">All Time</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label small fw-bold">Content Type</label>
                            <select class="form-select" @bind="contentType" @bind:event="onchange">
                                <option value="">All Content</option>
                                <option value="1">Lectures</option>
                                <option value="2">Courses</option>
                                <option value="3">Specializations</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label small fw-bold">Group By</label>
                            <select class="form-select" @bind="groupBy" @bind:event="onchange">
                                <option value="day">Daily</option>
                                <option value="week">Weekly</option>
                                <option value="month">Monthly</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label small fw-bold d-none d-md-block">&nbsp;</label>
                            <button class="btn btn-primary w-100" @onclick="UpdateRevenueData">
                                <i class="fas fa-sync me-2"></i> Apply Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Revenue Trend Cards -->
            <div class="d-block d-md-none px-3 mb-3">
                <h6 class="mb-2">Revenue Trend</h6>
                <div class="list-group">
                    @foreach (var period in revenueByPeriod.Take(5))
                    {
                        <div class="list-group-item border-0 bg-white mb-2 rounded-3 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-medium">@period.Period</span>
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2">
                                    $@period.Revenue.ToString("N2")
                                </span>
                            </div>
                            <div class="d-flex justify-content-between small text-muted">
                                <span><i class="fas fa-shopping-cart me-1"></i> @period.Transactions enrollments</span>
                                <span><i class="fas fa-users me-1"></i> @period.Students students</span>
                            </div>
                        </div>
                    }
                </div>
                @if (revenueByPeriod.Count > 5)
                {
                    <button class="btn btn-link text-primary w-100 mt-2" @onclick="ShowAllPeriods">
                        Show All @revenueByPeriod.Count Periods
                    </button>
                }
            </div>

            <!-- Revenue Chart & Analytics (Desktop) -->
            <div class="d-none d-md-block row g-4 mb-4">
                <!-- Revenue Trend Table -->
                <div class="col-lg-8">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-header bg-white border-0 pb-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="fas fa-chart-line me-2 text-primary"></i> Revenue Trend
                                </h5>
                                <span class="badge bg-light text-dark">@dateRangeLabel</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="border-0">Period</th>
                                            <th class="border-0">Revenue</th>
                                            <th class="border-0">Enrollments</th>
                                            <th class="border-0">Avg. per Enrollment</th>
                                            <th class="border-0">Students</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var period in revenueByPeriod)
                                        {
                                            <tr>
                                                <td><strong class="text-dark">@period.Period</strong></td>
                                                <td>
                                                    <span class="fw-bold text-success">$@period.Revenue.ToString("N2")</span>
                                                </td>
                                                <td>@period.Transactions</td>
                                                <td>$@period.AverageTransaction.ToString("N2")</td>
                                                <td>
                                                    <span class="badge bg-info bg-opacity-10 text-info">@period.Students</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (!revenueByPeriod.Any())
                            {
                                <div class="text-center py-5">
                                    <i class="fas fa-chart-line fa-3x text-muted mb-3"></i>
                                    <p class="text-muted">No revenue data for selected period</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Revenue by Content Type (Desktop) -->
                <div class="col-lg-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-header bg-white border-0 pb-0">
                            <h5 class="mb-0">
                                <i class="fas fa-chart-pie me-2 text-primary"></i> Revenue by Type
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (revenueByContentType.Any())
                            {
                                <div class="mb-4">
                                    @foreach (var item in revenueByContentType)
                                    {
                                        var percentage = totalRevenue > 0 ? (item.Revenue * 100.0m / totalRevenue) : 0;
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="d-flex align-items-center">
                                                    <i class="fas @GetEnrollmentIcon(item.Type) me-2 text-muted"></i>
                                                    <span class="fw-medium">@item.Type.ToString()</span>
                                                </span>
                                                <span class="fw-bold">$@item.Revenue.ToString("N2")</span>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                                    <div class="progress-bar @GetProgressBarClass(item.Type)" 
                                                         style="width: @percentage%"></div>
                                                </div>
                                                <small class="text-muted">@percentage.ToString("0.0")%</small>
                                            </div>
                                            <small class="text-muted d-block mt-1">
                                                @item.Transactions enrollments
                                            </small>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <i class="fas fa-chart-pie fa-2x text-muted mb-3"></i>
                                    <p class="text-muted">No revenue data by content type</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Revenue by Type -->
            <div class="d-block d-md-none px-3 mb-3">
                <h6 class="mb-2">Revenue by Type</h6>
                <div class="bg-white rounded-3 shadow-sm p-3">
                    @if (revenueByContentType.Any())
                    {
                        @foreach (var item in revenueByContentType)
                        {
                            var percentage = totalRevenue > 0 ? (item.Revenue * 100.0m / totalRevenue) : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="d-flex align-items-center">
                                        <i class="fas @GetEnrollmentIcon(item.Type) me-2 text-muted"></i>
                                        <span>@item.Type.ToString()</span>
                                    </span>
                                    <span class="fw-bold">$@item.Revenue.ToString("N2")</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                        <div class="progress-bar @GetProgressBarClass(item.Type)" 
                                             style="width: @percentage%"></div>
                                    </div>
                                    <small class="text-muted">@percentage.ToString("0")%</small>
                                </div>
                                <small class="text-muted">@item.Transactions enrollments</small>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">No revenue data by content type</p>
                    }
                </div>
            </div>

            <!-- Top Performing Content (Desktop) -->
            <div class="d-none d-md-block card mb-4 border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-trophy me-2 text-warning"></i> Top Performing Content
                        </h5>
                        <small class="text-muted">Based on revenue</small>
                    </div>
                </div>
                <div class="card-body">
                    @if (topPerformingContent != null && topPerformingContent.Any())
                    {
                        <div class="row g-3">
                            @foreach (var content in topPerformingContent.Take(3))
                            {
                                <div class="col-md-4">
                                    <div class="card border h-100">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <h6 class="mb-1 text-truncate" title="@content.Title">@content.Title</h6>
                                                    <small class="text-muted d-flex align-items-center">
                                                        <i class="fas @GetEnrollmentIcon(content.Type) me-1"></i>
                                                        @content.Type
                                                    </small>
                                                </div>
                                                <span class="badge bg-primary">@content.Enrollments</span>
                                            </div>
                                            
                                            <div class="mb-3">
                                                <div class="d-flex justify-content-between mb-1">
                                                    <small class="text-muted">Completion Rate</small>
                                                    <small class="fw-bold">@content.CompletionRate.ToString("0")%</small>
                                                </div>
                                                <div class="progress" style="height: 6px;">
                                                    <div class="progress-bar bg-success" style="width: @content.CompletionRate%"></div>
                                                </div>
                                            </div>
                                            
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <span class="h5 mb-0 text-success">$@content.Revenue.ToString("N2")</span>
                                                    <small class="text-muted d-block">Revenue</small>
                                                </div>
                                                @if (content.AverageRating > 0)
                                                {
                                                    <div class="text-end">
                                                        <div class="rating-stars">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i class="fas fa-star @(i <= Math.Round(content.AverageRating) ? "text-warning" : "text-muted")" style="font-size: 0.8rem;"></i>
                                                            }
                                                        </div>
                                                        <small class="text-muted">@content.AverageRating.ToString("0.0")</small>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-trophy fa-2x text-muted mb-3"></i>
                            <p class="text-muted">No top performing content data</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Mobile Top Performing Content -->
            <div class="d-block d-md-none px-3 mb-3">
                <h6 class="mb-2">Top Performing Content</h6>
                @if (topPerformingContent != null && topPerformingContent.Any())
                {
                    <div class="swiper-container" style="overflow-x: auto; white-space: nowrap; -webkit-overflow-scrolling: touch;">
                        <div class="d-flex gap-3 pb-2">
                            @foreach (var content in topPerformingContent.Take(5))
                            {
                                <div class="card border shadow-sm" style="width: 250px; flex-shrink: 0;">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="mb-1 text-truncate" style="max-width: 150px;" title="@content.Title">@content.Title</h6>
                                            <span class="badge bg-primary">@content.Enrollments</span>
                                        </div>
                                        <small class="text-muted d-block mb-2">
                                            <i class="fas @GetEnrollmentIcon(content.Type) me-1"></i> @content.Type
                                        </small>
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between mb-1">
                                                <small class="text-muted">Completion</small>
                                                <small class="fw-bold">@content.CompletionRate.ToString("0")%</small>
                                            </div>
                                            <div class="progress" style="height: 4px;">
                                                <div class="progress-bar bg-success" style="width: @content.CompletionRate%"></div>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <strong class="text-success">$@content.Revenue.ToString("N0")</strong>
                                            @if (content.AverageRating > 0)
                                            {
                                                <small class="text-muted">
                                                    <i class="fas fa-star text-warning"></i> @content.AverageRating.ToString("0.0")
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-3">No top performing content</p>
                }
            </div>

            <!-- Mobile Recent Enrollment Revenue -->
            <div class="d-block d-md-none px-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">Recent Enrollments</h6>
                    <button class="btn btn-sm btn-outline-primary" @onclick="ViewAllEnrollments">
                        View All
                    </button>
                </div>
                
                @if (recentEnrollments.Any())
                {
                    <div class="list-group">
                        @foreach (var enrollment in recentEnrollments.Take(5))
                        {
                            <div class="list-group-item border-0 bg-white mb-2 rounded-3 shadow-sm p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-2">
                                            @if (!string.IsNullOrEmpty(enrollment.StudentImage))
                                            {
                                                <img src="@enrollment.StudentImage" 
                                                     class="rounded-circle" width="32" height="32" 
                                                     alt="Student" />
                                            }
                                            else
                                            {
