    private string GetInitials(string fullName)
    {
        if (string.IsNullOrEmpty(fullName))
            return "??";
        
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        else if (parts.Length == 1 && parts[0].Length >= 2)
            return $"{parts[0][0]}{parts[0][1]}".ToUpper();
        else if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();
        else
            return "??";
    }

    private async Task RequestWithdrawal()
    {
        if (withdrawalAmount < 50m)
        {
            withdrawalMessage = "Minimum withdrawal amount is $50.00";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (withdrawalAmount > availableBalance)
        {
            withdrawalMessage = $"Cannot withdraw more than your available balance of ${availableBalance:N2}";
            await InvokeAsync(StateHasChanged);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", 
            $"Request withdrawal of ${withdrawalAmount:N2}?\n\nFunds will be transferred within 3-5 business days.");
        
        if (confirmed)
        {
            withdrawalMessage = $"Withdrawal request for ${withdrawalAmount:N2} submitted successfully!";
            withdrawalAmount = 0;
            
            await JS.InvokeVoidAsync("showToast", "success", "Withdrawal request submitted!");
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ExportRevenueReport()
    {
        try
        {
            var csvContent = "Enrollment Date,Content Type,Content Title,Student,Student Email,Revenue,Payment Status,Payment Method,Learning Progress,Learning Status\n";
            
            foreach (var enrollment in recentEnrollments)
            {
                csvContent += $"{enrollment.Date:yyyy-MM-dd HH:mm},";
                csvContent += $"{enrollment.ContentType},";
                csvContent += $"\"{enrollment.ContentTitle}\",";
                csvContent += $"\"{enrollment.StudentName}\",";
                csvContent += $"{enrollment.StudentEmail},";
                csvContent += $"${enrollment.Amount.ToString("N2")},";
                csvContent += $"{enrollment.PaymentStatus},";
                csvContent += $"{enrollment.PaymentMethod},";
                csvContent += $"{enrollment.ProgressPercentage}%,";
                csvContent += $"{enrollment.LearningStatus}\n";
            }

            var fileName = $"enrollment-revenue-report-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
            
            var bytes = System.Text.Encoding.UTF8.GetBytes(csvContent);
            var fileContent = Convert.ToBase64String(bytes);
            
            await JS.InvokeVoidAsync("downloadFile", fileName, "data:text/csv;base64," + fileContent);
            
            await JS.InvokeVoidAsync("showToast", "success", "Enrollment revenue report exported successfully!");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showToast", "error", $"Export failed: {ex.Message}");
        }
    }

