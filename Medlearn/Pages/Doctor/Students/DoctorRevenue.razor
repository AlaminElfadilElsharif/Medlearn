    private string GetEnrollmentTitle(EnrollmentDto enrollment)
    {
        if (enrollment == null) 
        {
            return "Unknown Content";
        }
        
        var title = enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => 
                enrollment.Specialization?.Title ?? 
                (enrollment.SpecializationId.HasValue ? $"Specialization #{enrollment.SpecializationId}" : "Specialization"),
            EnrollmentType.Course => 
                enrollment.Course?.Title ?? 
                (enrollment.CourseId.HasValue ? $"Course #{enrollment.CourseId}" : "Course"),
            EnrollmentType.Lecture => 
                enrollment.Lecture?.Title ?? 
                (enrollment.LectureId.HasValue ? $"Lecture #{enrollment.LectureId}" : "Lecture"),
            _ => "Unknown Content"
        };
        
        return title;
    }

