    private async Task CalculateRevenueChange()
    {
        try
        {
            var detailedResponse = await EnrollmentService.GetDoctorContentEnrollmentsAsync();
            if (detailedResponse != null)
            {
                var thirtyDaysAgo = DateTime.Now.AddDays(-30);
                var sixtyDaysAgo = DateTime.Now.AddDays(-60);
                
                var recentRevenue = detailedResponse
                    .Where(e => e.EnrollmentDate >= thirtyDaysAgo)
                    .Sum(e => e.PricePaid);
                
                var previousRevenue = detailedResponse
                    .Where(e => e.EnrollmentDate >= sixtyDaysAgo && e.EnrollmentDate < thirtyDaysAgo)
                    .Sum(e => e.PricePaid);
                
                revenueChange = previousRevenue > 0 ?
                    ((recentRevenue - previousRevenue) / previousRevenue * 100) : 
                    (recentRevenue > 0 ? 100 : 0);
                    
                Console.WriteLine($"Revenue change: {revenueChange:N1}% (Recent: ${recentRevenue:N2}, Previous: ${previousRevenue:N2})");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating revenue change: {ex.Message}");
            revenueChange = 0;
        }
    }

    private async Task GenerateRevenueByPeriod()
    {
        try
        {
            var detailedResponse = await EnrollmentService.GetDoctorContentEnrollmentsAsync();
            if (detailedResponse != null)
            {
                revenueByPeriod = new List<RevenuePeriod>();
                
                if (groupBy == "day")
                {
                    var days = dateRange switch
                    {
                        "30" => 30,
                        "90" => 90,
                        "180" => 180,
                        "365" => 365,
                        "all" => detailedResponse.Any() ? 
                            (DateTime.Now.Date - detailedResponse.Min(e => e.EnrollmentDate).Date).Days + 1 : 30,
                        _ => 30
                    };
                    
                    days = Math.Min(days, 365);
                    
                    var periods = Enumerable.Range(0, days)
                        .Select(i => DateTime.Now.AddDays(-i).Date)
                        .OrderBy(d => d)
                        .ToList();
                    
                    foreach (var day in periods)
                    {
                        var dayEnrollments = detailedResponse
                            .Where(e => e.EnrollmentDate.Date == day)
                            .ToList();
                        
                        revenueByPeriod.Add(new RevenuePeriod
                        {
                            Period = day.ToString("MMM dd"),
                            Revenue = dayEnrollments.Sum(e => e.PricePaid),
                            Transactions = dayEnrollments.Count,
                            AverageTransaction = dayEnrollments.Any() ? 
                                dayEnrollments.Average(e => e.PricePaid) : 0,
                            Students = dayEnrollments.Select(e => e.UserId).Distinct().Count()
                        });
                    }
                }
                else if (groupBy == "month")
                {
                    var months = dateRange switch
                    {
                        "30" => 1,
                        "90" => 3,
                        "180" => 6,
                        "365" => 12,
                        "all" => detailedResponse.Any() ? 
                            ((DateTime.Now.Year - detailedResponse.Min(e => e.EnrollmentDate).Year) * 12) + 
                            DateTime.Now.Month - detailedResponse.Min(e => e.EnrollmentDate).Month + 1 : 12,
                        _ => 6
                    };
                    
                    months = Math.Min(months, 24);
                    
                    var periodMonths = Enumerable.Range(0, months)
                        .Select(i => new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-i))
                        .OrderBy(d => d)
                        .ToList();
                    
                    foreach (var month in periodMonths)
                    {
                        var monthEnrollments = detailedResponse
                            .Where(e => e.EnrollmentDate.Year == month.Year && e.EnrollmentDate.Month == month.Month)
                            .ToList();
                        
                        revenueByPeriod.Add(new RevenuePeriod
                        {
                            Period = month.ToString("MMM yyyy"),
                            Revenue = monthEnrollments.Sum(e => e.PricePaid),
                            Transactions = monthEnrollments.Count,
                            AverageTransaction = monthEnrollments.Any() ? 
                                monthEnrollments.Average(e => e.PricePaid) : 0,
                            Students = monthEnrollments.Select(e => e.UserId).Distinct().Count()
                        });
                    }
                }
                else if (groupBy == "week")
                {
                    var weeks = dateRange switch
                    {
                        "30" => 4,
                        "90" => 13,
                        "180" => 26,
                        "365" => 52,
                        "all" => detailedResponse.Any() ? 
                            (int)Math.Ceiling((DateTime.Now.Date - detailedResponse.Min(e => e.EnrollmentDate).Date).TotalDays / 7) : 13,
                        _ => 13
                    };
                    
                    weeks = Math.Min(weeks, 104);
                    
                    for (int i = 0; i < weeks; i++)
                    {
                        var weekStart = DateTime.Now.AddDays(-(i * 7)).Date;
                        var weekEnd = weekStart.AddDays(6).Date;
                        
                        var weekEnrollments = detailedResponse
                            .Where(e => e.EnrollmentDate.Date >= weekStart && e.EnrollmentDate.Date <= weekEnd)
                            .ToList();
                        
                        revenueByPeriod.Add(new RevenuePeriod
                        {
                            Period = $"{weekStart:MMM dd} - {weekEnd:MMM dd}",
                            Revenue = weekEnrollments.Sum(e => e.PricePaid),
                            Transactions = weekEnrollments.Count,
                            AverageTransaction = weekEnrollments.Any() ? 
                                weekEnrollments.Average(e => e.PricePaid) : 0,
                            Students = weekEnrollments.Select(e => e.UserId).Distinct().Count()
                        });
                    }
                }
                
                // Reverse to show most recent first
                revenueByPeriod = revenueByPeriod.OrderByDescending(r => r.Period).ToList();
                Console.WriteLine($"Generated {revenueByPeriod.Count} revenue periods");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating revenue by period: {ex.Message}");
            revenueByPeriod = new List<RevenuePeriod>();
        }
    }

