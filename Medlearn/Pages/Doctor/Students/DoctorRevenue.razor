@code {
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = "";
    private string dateRange = "30";
    private string? contentType = "";
    private string groupBy = "day";
    private decimal withdrawalAmount = 0;
    private string withdrawalMessage = "";
    private bool showMobileFilters = false;
    
    private decimal totalRevenue = 0;
    private decimal availableBalance = 0;
    private decimal monthlyRevenue = 0;
    private int monthlyTransactions = 0;
    private decimal averagePerStudent = 0;
    private decimal revenueChange = 0;
    private int totalDetailedTransactions = 0;
    
    private List<RevenuePeriod> revenueByPeriod = new();
    private List<RevenueByType> revenueByContentType = new();
    private List<PerformingContent> topPerformingContent = new();
    private List<EnrollmentRevenueDto> recentEnrollments = new();
    
    private string dateRangeLabel => dateRange switch
    {
        "30" => "Last 30 Days",
        "90" => "Last 90 Days",
        "180" => "Last 6 Months",
        "365" => "Last Year",
        "all" => "All Time",
        _ => "Last 30 Days"
    };

    // Add this method for mobile filter toggle
    private void ToggleFilters()
    {
        showMobileFilters = !showMobileFilters;
    }

    // Add this method for showing all periods on mobile
    private void ShowAllPeriods()
    {
        // Could navigate to a full page or expand the list
        // For now, just show all in the list
        StateHasChanged();
    }

    // Add this method for back navigation
    private void GoBack()
    {
        Navigation.NavigateTo("/doctor/dashboard");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRevenueData();
    }

    // ... (keep all your existing methods exactly as they are - LoadRevenueData, 
    // CalculateStatisticsFromDetailedData, ProcessAggregatedData, etc.)
    private async Task LoadRevenueData()
    {
        isLoading = true;
        hasError = false;
        errorMessage = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            // Check authentication and doctor role
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                errorMessage = "Please log in to view revenue analytics.";
                hasError = true;
                return;
            }

            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser?.UserType != UserType.Doctor)
            {
                errorMessage = "Access denied. Only doctors can view revenue analytics.";
                hasError = true;
                return;
            }

            // Get doctor's profile for balance
            availableBalance = currentUser.Profile?.Balance ?? 0;

            // Load detailed enrollment data first
            Console.WriteLine("Loading detailed enrollment data...");
            await LoadDetailedEnrollments();
            
            // Calculate top performing content from detailed data
            Console.WriteLine("Calculating top performing content...");
            await CalculateTopPerformingContent();
            
            // Calculate statistics from detailed data
            Console.WriteLine("Calculating statistics from detailed data...");
            await CalculateStatisticsFromDetailedData();
            
            // Try to load aggregated data for additional insights
            try
            {
                Console.WriteLine("Loading aggregated revenue data...");
                var aggregatedResponse = await EnrollmentService.GetDoctorEnrollmentsAsync();
                
                if (aggregatedResponse != null)
                {
                    Console.WriteLine($"Received {aggregatedResponse.Count} aggregated items");
                    await ProcessAggregatedData(aggregatedResponse);
                }
                else
                {
                    Console.WriteLine("No aggregated data received, using detailed data only");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Warning: Could not load aggregated data: {ex.Message}");
                // Continue with detailed data only
            }
            
            await JS.InvokeVoidAsync("showToast", "success", "Revenue data loaded successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading revenue data: {ex.Message}");
            errorMessage = $"Error loading revenue data: {ex.Message}";
            hasError = true;
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CalculateStatisticsFromDetailedData()
    {
        try
        {
            var detailedResponse = await EnrollmentService.GetDoctorContentEnrollmentsAsync();
            if (detailedResponse != null && detailedResponse.Any())
            {
                // Calculate total revenue
                totalRevenue = detailedResponse.Sum(e => e.PricePaid);
                Console.WriteLine($"Total revenue from detailed data: ${totalRevenue:N2}");
                
                // Calculate revenue by content type
                revenueByContentType = detailedResponse
                    .GroupBy(e => e.EnrollmentType)
                    .Select(g => new RevenueByType
                    {
                        Type = g.Key,
                        Revenue = g.Sum(e => e.PricePaid),
                        Transactions = g.Count()
                    })
                    .OrderByDescending(r => r.Revenue)
                    .ToList();
                
                Console.WriteLine($"Revenue by type calculated: {revenueByContentType.Count} types");
                
                // Calculate other statistics
                await CalculateMonthlyRevenue();
                await CalculateAveragePerStudent();
                await CalculateRevenueChange();
                await GenerateRevenueByPeriod();
            }
            else
            {
                Console.WriteLine("No detailed data available for statistics calculation");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating statistics from detailed data: {ex.Message}");
        }
    }

    private async Task ProcessAggregatedData(List<object> aggregatedResponse)
    {
        try
        {
            var contentPerformance = new List<PerformingContent>();
            decimal totalRev = 0;
            int totalEnrollmentsCount = 0;
            
            foreach (var item in aggregatedResponse)
            {
                try
                {
                    var json = JsonSerializer.Serialize(item);
                    var jsonDoc = JsonDocument.Parse(json);
                    
                    if (!jsonDoc.RootElement.TryGetProperty("Type", out var typeElement) ||
                        !jsonDoc.RootElement.TryGetProperty("EntityId", out var entityIdElement) ||
                        !jsonDoc.RootElement.TryGetProperty("Title", out var titleElement) ||
                        !jsonDoc.RootElement.TryGetProperty("TotalEnrollments", out var totalEnrollmentsElement) ||
                        !jsonDoc.RootElement.TryGetProperty("CompletedEnrollments", out var completedEnrollmentsElement) ||
                        !jsonDoc.RootElement.TryGetProperty("TotalRevenue", out var revenueElement))
                    {
                        Console.WriteLine("Skipping aggregated item - missing required properties");
                        continue;
                    }
                    
                    var type = (EnrollmentType)typeElement.GetInt32();
                    var entityId = entityIdElement.GetInt32();
                    var title = titleElement.GetString() ?? "Unknown";
                    var totalEnrollments = totalEnrollmentsElement.GetInt32();
                    var completedEnrollments = completedEnrollmentsElement.GetInt32();
                    var revenue = revenueElement.GetDecimal();
                    
                    totalRev += revenue;
                    totalEnrollmentsCount += totalEnrollments;
                    
                    var completionRate = totalEnrollments > 0 
                        ? (completedEnrollments * 100.0 / totalEnrollments)
                        : 0;
                    
                    contentPerformance.Add(new PerformingContent
                    {
                        Id = entityId,
                        Title = title,
                        Type = type,
                        Revenue = revenue,
                        Enrollments = totalEnrollments,
                        CompletionRate = completionRate,
                        AverageRating = 0
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error processing aggregated item: {ex.Message}");
                    Console.WriteLine($"Item JSON: {JsonSerializer.Serialize(item)}");
                }
            }
            
            if (contentPerformance.Any())
            {
                Console.WriteLine($"Got {contentPerformance.Count} valid aggregated items");
                totalRevenue = totalRev;
                
                var existingIds = new HashSet<int>(topPerformingContent.Select(t => t.Id));
                var newItems = contentPerformance.Where(c => !existingIds.Contains(c.Id));
                topPerformingContent.AddRange(newItems);
                
                topPerformingContent = topPerformingContent
                    .OrderByDescending(c => c.Revenue)
                    .ToList();
                
                revenueByContentType = topPerformingContent
                    .GroupBy(c => c.Type)
                    .Select(g => new RevenueByType
                    {
                        Type = g.Key,
                        Revenue = g.Sum(c => c.Revenue),
                        Transactions = g.Sum(c => c.Enrollments)
                    })
                    .OrderByDescending(r => r.Revenue)
                    .ToList();
            }
            else
            {
                Console.WriteLine("No valid aggregated data found, keeping detailed data");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error processing aggregated data: {ex.Message}");
        }
    }

    private async Task CalculateTopPerformingContent()
    {
        try
        {
            Console.WriteLine("Calculating top performing content from detailed enrollment data...");
            var detailedResponse = await EnrollmentService.GetDoctorContentEnrollmentsAsync();
            
            if (detailedResponse != null && detailedResponse.Any())
            {
                Console.WriteLine($"Received {detailedResponse.Count} detailed enrollment records");
                
                var contentDict = new Dictionary<string, PerformingContent>();
                
                foreach (var enrollment in detailedResponse)
                {
                    string contentKey = $"{enrollment.EnrollmentType}-{enrollment.LectureId ?? enrollment.CourseId ?? enrollment.SpecializationId ?? 0}";
                    string title = GetEnrollmentTitle(enrollment);
                    
                    if (!contentDict.ContainsKey(contentKey))
                    {
                        contentDict[contentKey] = new PerformingContent
                        {
                            Id = enrollment.LectureId ?? enrollment.CourseId ?? enrollment.SpecializationId ?? 0,
                            Title = title,
                            Type = enrollment.EnrollmentType,
                            Revenue = 0,
                            Enrollments = 0,
                            CompletionRate = 0,
                            AverageRating = 0
                        };
                    }
                    
                    contentDict[contentKey].Revenue += enrollment.PricePaid;
                    contentDict[contentKey].Enrollments++;
                }
                
                foreach (var contentKey in contentDict.Keys)
                {
                    var content = contentDict[contentKey];
                    var contentEnrollments = detailedResponse.Where(e => 
                        (e.EnrollmentType == content.Type) &&
                        ((e.EnrollmentType == EnrollmentType.Lecture && e.LectureId == content.Id) ||
                         (e.EnrollmentType == EnrollmentType.Course && e.CourseId == content.Id) ||
                         (e.EnrollmentType == EnrollmentType.Specialization && e.SpecializationId == content.Id)));
                    
                    var total = contentEnrollments.Count();
                    var completed = contentEnrollments.Count(e => e.IsCompleted);
                    content.CompletionRate = total > 0 ? (completed * 100.0 / total) : 0;
                }
                
                topPerformingContent = contentDict.Values
                    .Where(c => !string.IsNullOrEmpty(c.Title) && c.Title != "Unknown Content")
                    .OrderByDescending(c => c.Revenue)
                    .ToList();
                
                Console.WriteLine($"Calculated {topPerformingContent.Count} top performing content items");
                
                if (topPerformingContent.Any())
                {
                    Console.WriteLine("Top performing content:");
                    foreach (var content in topPerformingContent.Take(5))
                    {
                        Console.WriteLine($"  - {content.Title} ({content.Type}): ${content.Revenue:N2}, {content.Enrollments} enrollments");
                    }
                }
                else
                {
                    Console.WriteLine("No top performing content found after filtering");
                    
                    // Add test data for debugging
                    Console.WriteLine("Adding test data for debugging");
                    topPerformingContent = new List<PerformingContent>
                    {
                        new PerformingContent
                        {
                            Id = 1,
                            Title = "Test Lecture 1",
                            Type = EnrollmentType.Lecture,
                            Revenue = 150.50m,
                            Enrollments = 5,
                            CompletionRate = 60,
                            AverageRating = 4.5m
                        },
                        new PerformingContent
                        {
                            Id = 2,
                            Title = "Test Course 1",
                            Type = EnrollmentType.Course,
                            Revenue = 450.00m,
                            Enrollments = 3,
                            CompletionRate = 75,
                            AverageRating = 4.8m
                        }
                    };
                    Console.WriteLine("Added test data to topPerformingContent");
                }
            }
            else
            {
                Console.WriteLine("No detailed enrollment data available for calculating top performing content");
                topPerformingContent = new List<PerformingContent>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating top performing content: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            topPerformingContent = new List<PerformingContent>();
        }
