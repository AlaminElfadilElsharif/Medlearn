    private async Task ExportStudentData()
    {
        try
        {
            var csvContent = new StringBuilder();

            // Student Info
            csvContent.AppendLine("STUDENT INFORMATION");
            csvContent.AppendLine($"Name,{student?.FirstName} {student?.LastName}");
            csvContent.AppendLine($"Email,{student?.Email}");
            csvContent.AppendLine($"Phone,{student?.PhoneNumber ?? "N/A"}");
            csvContent.AppendLine($"Date of Birth,{student?.DateOfBirth?.ToString("yyyy-MM-dd") ?? "N/A"}");
            csvContent.AppendLine($"Joined,{student?.CreatedAt.ToString("yyyy-MM-dd") ?? "N/A"}");
            csvContent.AppendLine();

            // Summary Stats
            csvContent.AppendLine("SUMMARY STATISTICS");
            csvContent.AppendLine($"Total Enrollments,{allEnrollments.Count}");
            csvContent.AppendLine($"Completed Enrollments,{completedEnrollments}");
            csvContent.AppendLine($"In Progress Enrollments,{inProgressEnrollments}");
            csvContent.AppendLine($"Overall Progress,{overallProgress:F1}%");
            csvContent.AppendLine($"Total Materials Completed,{completedMaterials}/{totalMaterials}");
            csvContent.AppendLine();

            // Enrollments
            csvContent.AppendLine("ENROLLMENTS");
            csvContent.AppendLine("Content,Type,Enrollment Date,Progress %,Time Spent,Status,Completed Date");

            foreach (var enrollment in allEnrollments)
            {
                csvContent.AppendLine(
                    $"\"{GetEnrollmentTitle(enrollment)}\"," +
                    $"{enrollment.EnrollmentType}," +
                    $"{enrollment.EnrollmentDate:yyyy-MM-dd}," +
                    $"{enrollment.ProgressPercentage:F1}%," +
                    $"{GetTimeSpent(enrollment)}," +
                    $"{(enrollment.IsCompleted ? "Completed" : enrollment.ProgressPercentage > 0 ? "In Progress" : "Not Started")}," +
                    $"{(enrollment.CompletedDate.HasValue ? enrollment.CompletedDate.Value.ToString("yyyy-MM-dd") : "N/A")}");
            }

            var bytes = Encoding.UTF8.GetBytes(csvContent.ToString());
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"student_{StudentId}_details_{DateTime.Now:yyyyMMdd_HHmmss}.csv";

            await JS.InvokeVoidAsync("downloadFile", base64, fileName, "text/csv");
            await ShowToast("success", "Export completed successfully");
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Export failed: {ex.Message}");
        }
    }

    private async Task ShowToast(string type, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", type, message);
        }
        catch
        {
            Console.WriteLine($"{type.ToUpper()}: {message}");
        }
    }
