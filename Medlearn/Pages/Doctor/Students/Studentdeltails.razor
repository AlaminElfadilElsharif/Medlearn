@page "/doctor/students/{StudentId:int}/details"


<PageTitle>Student Details - @(student?.FirstName ?? "Student")</PageTitle>

<div class="student-details-page">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <h5 class="mb-0 flex-grow-1">Student Details</h5>
                    <button class="btn btn-link text-white p-0" @onclick="ExportStudentData" disabled="@(isLoading || !isAuthenticated)">
                        <i class="fas fa-download fa-lg"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-block mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1>Student Details</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="/doctor">Doctor</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="/doctor/students">Students</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                @(student?.FirstName ?? "Student") @(student?.LastName ?? "")
                            </li>
                        </ol>
                    </nav>
                </div>
                <div>
                    <button class="btn btn-outline-secondary me-2" @onclick="GoBack">
                        <i class="fas fa-arrow-left me-2"></i> Back
                    </button>
                    <button class="btn btn-outline-primary" @onclick="ExportStudentData" disabled="@(isLoading || !isAuthenticated)">
                        <i class="fas fa-file-export me-2"></i> Export
                    </button>
                </div>
            </div>
        </div>

        <!-- Authentication Check -->
        @if (!isAuthenticated)
        {
            <div class="alert alert-warning m-3 m-md-0">
                <i class="fas fa-exclamation-triangle me-2"></i>
                You must be logged in to view student details.
                <a href="/account/login" class="alert-link">Click here to login</a>
            </div>
        }
        else if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading student details...</p>
            </div>
        }
        else if (student == null)
        {
            <div class="alert alert-danger m-3 m-md-0">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Student not found or you don't have permission to view this student's details.
            </div>
        }
        else
        {
            <!-- Student Profile Header -->
            <div class="card border-0 border-md mb-4">
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center">
                                <!-- Avatar -->
                                <div class="me-4">
                                    @if (!string.IsNullOrEmpty(student.ProfileImageUrl))
                                    {
                                        <img src="@student.ProfileImageUrl"
                                             class="rounded-circle"
                                             width="100"
                                             height="100"
                                             alt="@student.FirstName"
                                             style="object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                             style="width: 100px; height: 100px; font-size: 36px;">
                                            @GetUserInitials(student)
                                        </div>
                                    }
                                </div>

                                <!-- Student Info -->
                                <div>
                                    <h3 class="mb-2">@student.FirstName @student.LastName</h3>
                                    <div class="mb-2">
                                        <span class="badge bg-info me-2">
                                            <i class="fas fa-user me-1"></i> Student
                                        </span>
                                        @if (student.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle me-1"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-ban me-1"></i> Inactive
                                            </span>
                                        }
                                    </div>
                                    <div class="text-muted">
                                        <p class="mb-1">
                                            <i class="fas fa-envelope me-2"></i> @student.Email
                                        </p>
                                        @if (!string.IsNullOrEmpty(student.PhoneNumber))
                                        {
                                            <p class="mb-1">
                                                <i class="fas fa-phone me-2"></i> @student.PhoneNumber
                                            </p>
                                        }
                                        @if (student.DateOfBirth.HasValue)
                                        {
                                            <p class="mb-1">
                                                <i class="fas fa-birthday-cake me-2"></i>
                                                @student.DateOfBirth.Value.ToString("MMMM dd, yyyy")
                                                (Age: @CalculateAge(student.DateOfBirth.Value))
                                            </p>
                                        }
                                        <p class="mb-0">
                                            <i class="fas fa-calendar-alt me-2"></i>
                                            Joined: @(student.CreatedAt.ToString("MMMM dd, yyyy"))
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Actions -->
                        <div class="col-md-4">
                            <div class="d-flex justify-content-end align-items-start h-100">
                                <div class="btn-group-vertical w-100">
                                    <button class="btn btn-outline-primary text-start mb-2"
                                            @onclick="() => ViewProgressReport()">
                                        <i class="fas fa-chart-line me-2"></i> View Progress Report
                                    </button>
                                    <button class="btn btn-outline-success text-start mb-2"
                                            @onclick="() => SendMessage()"
                                            disabled="@string.IsNullOrEmpty(student.Email)">
                                        <i class="fas fa-envelope me-2"></i> Send Message
                                    </button>
                                    <button class="btn btn-outline-info text-start"
                                            @onclick="() => GenerateCertificate()"
                                            disabled="@(!hasCompletedEnrollments)">
                                        <i class="fas fa-certificate me-2"></i> Generate Certificate
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Overview -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Total Enrollments</h6>
                                    <h3 class="mb-0">@allEnrollments.Count</h3>
                                </div>
                                <i class="fas fa-book fa-2x text-primary opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Completed</h6>
                                    <h3 class="mb-0">@completedEnrollments</h3>
                                </div>
                                <i class="fas fa-check-circle fa-2x text-success opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">In Progress</h6>
                                    <h3 class="mb-0">@inProgressEnrollments</h3>
                                </div>
                                <i class="fas fa-spinner fa-2x text-info opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Avg Progress</h6>
                                    <h3 class="mb-0">@overallProgress.ToString("0")%</h3>
                                </div>
                                <i class="fas fa-chart-pie fa-2x text-warning opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Progress Overview Card -->
            <div class="card mb-4">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-line me-2 text-primary"></i>
                        Progress Overview
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 text-center">
                            <div class="progress-circle" style="width: 150px; height: 150px; margin: 0 auto;">
                                <svg width="150" height="150" viewBox="0 0 36 36" class="circular-chart">
                                    <path class="circle-bg"
                                          d="M18 2.0845
                                                 a 15.9155 15.9155 0 0 1 0 31.831
                                                 a 15.9155 15.9155 0 0 1 0 -31.831"
                                          fill="none"
                                          stroke="#eee"
                                          stroke-width="2" />
                                    <path class="circle"
                                          stroke="@GetProgressColor(overallProgress)"
                                          stroke-dasharray="@overallProgress.ToString("0"), 100"
                                          d="M18 2.0845
                                                 a 15.9155 15.9155 0 0 1 0 31.831
                                                 a 15.9155 15.9155 0 0 1 0 -31.831"
                                          fill="none"
                                          stroke-width="2"
                                          stroke-linecap="round" />
                                    <text x="18" y="20.35" class="percentage">@overallProgress.ToString("0")%</text>
                                </svg>
                            </div>
                            <p class="mt-2">Overall Completion</p>
                        </div>
                        <div class="col-md-8">
                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="progress-stats-item">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span>Specializations</span>
                                            <span class="fw-bold">@specializationCount</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-info"
                                                 style="width: @(specializationCount > 0 ? (completedSpecializations * 100.0 / specializationCount).ToString("0") : "0")%"></div>
                                        </div>
                                        <small class="text-muted">@completedSpecializations completed</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="progress-stats-item">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span>Courses</span>
                                            <span class="fw-bold">@courseCount</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-success"
                                                 style="width: @(courseCount > 0 ? (completedCourses * 100.0 / courseCount).ToString("0") : "0")%"></div>
                                        </div>
                                        <small class="text-muted">@completedCourses completed</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="progress-stats-item">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span>Lectures</span>
                                            <span class="fw-bold">@lectureCount</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-warning"
                                                 style="width: @(lectureCount > 0 ? (completedLectures * 100.0 / lectureCount).ToString("0") : "0")%"></div>
                                        </div>
                                        <small class="text-muted">@completedLectures completed</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="progress-stats-item">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span>Materials</span>
                                            <span class="fw-bold">@totalMaterials</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-primary"
                                                 style="width: @(totalMaterials > 0 ? (completedMaterials * 100.0 / totalMaterials).ToString("0") : "0")%"></div>
                                        </div>
                                        <small class="text-muted">@completedMaterials completed</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Enrollments Section -->
            <div class="card mb-4">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-book-open me-2 text-primary"></i>
                        Enrollments
                    </h5>
                    <div>
                        <select class="form-select form-select-sm" @onchange="FilterEnrollmentsByType">
                            <option value="">All Types</option>
                            <option value="0">Lectures</option>
                            <option value="1">Courses</option>
                            <option value="2">Specializations</option>
                        </select>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (!filteredEnrollments.Any())
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-book fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No enrollments found</p>
                        </div>
                    }
                    else
                    {
                        <!-- Desktop Table View -->
                        <div class="d-none d-md-block table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Content</th>
                                        <th>Type</th>
                                        <th>Enrolled Date</th>
                                        <th>Progress</th>
                                        <th>Time Spent</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var enrollment in filteredEnrollments)
                                    {
                                        var timeSpent = GetTimeSpent(enrollment);
                                        var enrollmentTitle = GetEnrollmentTitle(enrollment);

                                        <tr>
                                            <td>
                                                <div class="fw-medium">@enrollmentTitle</div>
                                                <small class="text-muted">@GetEnrollmentSubtitle(enrollment)</small>
                                            </td>
                                            <td>
                                                <span class="badge @GetEnrollmentTypeBadge(enrollment.EnrollmentType)">
                                                    @enrollment.EnrollmentType.ToString()
                                                </span>
                                            </td>
                                            <td>@enrollment.EnrollmentDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                                        <div class="progress-bar @GetProgressBarClass(enrollment.ProgressPercentage)"
                                                             style="width: @(enrollment.ProgressPercentage)%"></div>
                                                    </div>
                                                    <span class="small">@enrollment.ProgressPercentage.ToString("0")%</span>
                                                </div>
                                            </td>
                                            <td>@timeSpent</td>
                                            <td>
                                                @if (enrollment.IsCompleted)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check me-1"></i> Completed
                                                    </span>
                                                }
                                                else if (enrollment.ProgressPercentage > 0)
                                                {
                                                    <span class="badge bg-info">
                                                        <i class="fas fa-spinner me-1"></i> In Progress
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">
                                                        <i class="fas fa-clock me-1"></i> Not Started
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-info"
                                                        @onclick="() => ViewEnrollmentDetails(enrollment.Id)">
                                                    <i class="fas fa-chart-bar"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Mobile Card View -->
                        <div class="d-block d-md-none">
                            @foreach (var enrollment in filteredEnrollments)
                            {
                                <div class="card border-0 border-bottom rounded-0">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="mb-1">@GetEnrollmentTitle(enrollment)</h6>
                                                <small class="text-muted">@GetEnrollmentSubtitle(enrollment)</small>
                                            </div>
                                            <span class="badge @GetStatusBadgeClass(enrollment)">
                                                @GetStatusText(enrollment)
                                            </span>
                                        </div>

                                        <div class="row g-2 mb-2 small">
                                            <div class="col-6">
                                                <i class="fas fa-calendar me-1 text-muted"></i>
                                                @enrollment.EnrollmentDate.ToString("MMM dd, yyyy")
                                            </div>
                                            <div class="col-6">
                                                <i class="fas fa-clock me-1 text-muted"></i>
                                                @GetTimeSpent(enrollment)
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span>Progress</span>
                                                <span class="fw-bold">@enrollment.ProgressPercentage.ToString("0")%</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar @GetProgressBarClass(enrollment.ProgressPercentage)"
                                                     style="width: @(enrollment.ProgressPercentage)%"></div>
                                            </div>
                                        </div>

                                        <button class="btn btn-sm btn-outline-info w-100"
                                                @onclick="() => ViewEnrollmentDetails(enrollment.Id)">
                                            <i class="fas fa-chart-bar me-2"></i> View Details
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Recent Activity Timeline -->
            <div class="card">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0">
                        <i class="fas fa-history me-2 text-primary"></i>
                        Recent Activity
                    </h5>
                </div>
                <div class="card-body">
                    @if (recentActivities.Any())
                    {
                        <div class="timeline">
                            @foreach (var activity in recentActivities.OrderByDescending(a => a.Date).Take(10))
                            {
                                <div class="timeline-item mb-3">
                                    <div class="d-flex">
                                        <div class="timeline-marker @GetTimelineMarkerColor(activity.Type) me-3"></div>
                                        <div class="timeline-content flex-grow-1">
                                            <div class="d-flex justify-content-between">
                                                <h6 class="mb-1">@activity.Title</h6>
                                                <small class="text-muted">@FormatRelativeTime(activity.Date)</small>
                                            </div>
                                            <p class="mb-1 text-muted small">@activity.Description</p>
                                            @if (!string.IsNullOrEmpty(activity.CourseTitle))
                                            {
                                                <small class="text-muted">
                                                    <i class="fas fa-book me-1"></i>@activity.CourseTitle
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-history fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No recent activity</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Timeline Styles */
    .timeline-marker {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        flex-shrink: 0;
        margin-top: 5px;
    }

    .timeline-item {
        border-left: 2px solid #e9ecef;
        padding-left: 15px;
        position: relative;
    }

    /* Progress Circle Styles */
    .progress-circle {
        position: relative;
    }

    .circular-chart {
        display: block;
    }

    .circle-bg {
        fill: none;
    }

    .circle {
        fill: none;
        transition: stroke-dasharray 0.3s ease;
    }

    .percentage {
        fill: #666;
        font-size: 0.5em;
        text-anchor: middle;
        font-weight: bold;
    }

    /* Stat Cards */
    .stat-card {
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    /* Progress Stats */
    .progress-stats-item {
        padding: 10px;
        background: #f8f9fa;
        border-radius: 8px;
    }

    /* Responsive Adjustments */
    @@media (max-width: 767px) {
        .student-details-page {
            background-color: #f8f9fa;
            min-height: 100vh;
        }

        .card {
            border-radius: 0 !important;
            margin-bottom: 8px;
        }

        .timeline-item {
            margin-left: 0;
        }
    }
</style>

@code {
    private class ActivityItem
    {
        public DateTime Date { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Type { get; set; } = "";
        public string CourseTitle { get; set; } = "";
    }

    [Parameter] public int StudentId { get; set; }

    private UserDto? student;
    private List<EnrollmentDto> allEnrollments = new();
    private List<EnrollmentDto> filteredEnrollments = new();
    private List<ActivityItem> recentActivities = new();

    private int completedEnrollments = 0;
    private int inProgressEnrollments = 0;
    private double overallProgress = 0;

    private int specializationCount = 0;
    private int courseCount = 0;
    private int lectureCount = 0;
    private int completedSpecializations = 0;
    private int completedCourses = 0;
    private int completedLectures = 0;
    private int totalMaterials = 0;
    private int completedMaterials = 0;
    private bool hasCompletedEnrollments = false;

    private bool isLoading = true;
    private bool isAuthenticated = false;
    private UserDto? currentDoctor;
    private string enrollmentTypeFilter = "";

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();

        if (isAuthenticated)
        {
            await LoadStudentDetails();
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                currentDoctor = await AuthService.GetCurrentUserAsync();

                if (currentDoctor == null || currentDoctor.UserType != UserType.Doctor)
                {
                    await ShowToast("error", "You must be a doctor to view student details.");
                    Navigation.NavigateTo("/", true);
                }
            }
            else
            {
                Navigation.NavigateTo($"/account/login?returnUrl=/doctor/students/{StudentId}/details", true);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
        }
    }

    private async Task LoadStudentDetails()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Get all enrollments for this doctor's content
            var doctorEnrollments = await EnrollmentService.GetDoctorContentEnrollmentsAsync();

            if (doctorEnrollments != null)
            {
                // Filter enrollments for this specific student
                allEnrollments = doctorEnrollments
                    .Where(e => e.UserId == StudentId)
                    .ToList();

                if (allEnrollments.Any())
                {
                    // Get student info from the first enrollment
                    student = allEnrollments.First().User;

                    // Load progress details for each enrollment
                    foreach (var enrollment in allEnrollments)
                    {
                        var progress = await EnrollmentService.GetEnrollmentProgressAsync(enrollment.Id);
                        if (progress != null)
                        {
                            enrollment.ProgressTrackings = progress;
                        }
                    }

                    // Calculate statistics
                    CalculateStatistics();

                    // Apply initial filter
                    FilterEnrollmentsByType(null);

                    // Build recent activities
                    BuildRecentActivities();
                }
                else
                {
                    // Try to get student info separately
                    student = await UserService.GetUserAsync(StudentId);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading student details: {ex.Message}");
            await ShowToast("error", "Failed to load student details");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CalculateStatistics()
    {
        if (!allEnrollments.Any()) return;

        completedEnrollments = allEnrollments.Count(e => e.IsCompleted);
        inProgressEnrollments = allEnrollments.Count(e => !e.IsCompleted && e.ProgressPercentage > 0);
        overallProgress = allEnrollments.Average(e => e.ProgressPercentage);
        hasCompletedEnrollments = completedEnrollments > 0;

        // Count by type
        specializationCount = allEnrollments.Count(e => e.EnrollmentType == EnrollmentType.Specialization);
        courseCount = allEnrollments.Count(e => e.EnrollmentType == EnrollmentType.Course);
        lectureCount = allEnrollments.Count(e => e.EnrollmentType == EnrollmentType.Lecture);

        completedSpecializations = allEnrollments.Count(e => e.EnrollmentType == EnrollmentType.Specialization && e.IsCompleted);
        completedCourses = allEnrollments.Count(e => e.EnrollmentType == EnrollmentType.Course && e.IsCompleted);
        completedLectures = allEnrollments.Count(e => e.EnrollmentType == EnrollmentType.Lecture && e.IsCompleted);

        // Calculate material progress
        totalMaterials = allEnrollments
            .Where(e => e.ProgressTrackings != null)
            .Sum(e => e.ProgressTrackings?.Count ?? 0);

        completedMaterials = allEnrollments
            .Where(e => e.ProgressTrackings != null)
            .Sum(e => e.ProgressTrackings?.Count(p => p.IsCompleted) ?? 0);
    }

    private void FilterEnrollmentsByType(ChangeEventArgs? e)
    {
        enrollmentTypeFilter = e?.Value?.ToString() ?? "";

        if (string.IsNullOrEmpty(enrollmentTypeFilter))
        {
            filteredEnrollments = allEnrollments.ToList();
        }
        else if (int.TryParse(enrollmentTypeFilter, out int typeValue))
        {
            var type = (EnrollmentType)typeValue;
            filteredEnrollments = allEnrollments
                .Where(en => en.EnrollmentType == type)
                .ToList();
        }
    }

    private void BuildRecentActivities()
    {
        recentActivities.Clear();

        foreach (var enrollment in allEnrollments)
        {
            var enrollmentTitle = GetEnrollmentTitle(enrollment);

            // Add enrollment activity
            recentActivities.Add(new ActivityItem
            {
                Date = enrollment.EnrollmentDate,
                Title = "Enrollment",
                Description = $"Enrolled in {enrollmentTitle}",
                Type = "enrollment",
                CourseTitle = enrollmentTitle
            });

            // Add completion activity
            if (enrollment.IsCompleted && enrollment.CompletedDate.HasValue)
            {
                recentActivities.Add(new ActivityItem
                {
                    Date = enrollment.CompletedDate.Value,
                    Title = "Completion",
                    Description = $"Completed {enrollmentTitle}",
                    Type = "completion",
                    CourseTitle = enrollmentTitle
                });
            }

            // Add progress activities
            if (enrollment.ProgressTrackings != null)
            {
                var recentProgress = enrollment.ProgressTrackings
                    .Where(p => p.CompletedDate.HasValue)
                    .OrderByDescending(p => p.CompletedDate)
                    .Take(2);

                foreach (var progress in recentProgress)
                {
                    recentActivities.Add(new ActivityItem
                    {
                        Date = progress.CompletedDate!.Value,
                        Title = "Progress",
                        Description = $"Completed: {progress.Material?.Title ?? "Learning material"}",
                        Type = "progress",
                        CourseTitle = enrollmentTitle
                    });
                }
            }
        }

        recentActivities = recentActivities.OrderByDescending(a => a.Date).ToList();
    }

    private string GetEnrollmentTitle(EnrollmentDto enrollment)
    {
        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => enrollment.Specialization?.Title ?? "Specialization",
            EnrollmentType.Course => enrollment.Course?.Title ?? "Course",
            EnrollmentType.Lecture => enrollment.Lecture?.Title ?? "Lecture",
            _ => "Unknown"
        };
    }

    private string GetEnrollmentSubtitle(EnrollmentDto enrollment)
    {
        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => $"{enrollment.Specialization?.Courses?.Count ?? 0} courses",
            EnrollmentType.Course => $"{enrollment.Course?.Lectures?.Count ?? 0} lectures",
            EnrollmentType.Lecture => $"{enrollment.Lecture?.Materials?.Count ?? 0} materials",
            _ => ""
        };
    }

    private string GetEnrollmentTypeBadge(EnrollmentType type)
    {
        return type switch
        {
            EnrollmentType.Specialization => "bg-primary",
            EnrollmentType.Course => "bg-success",
            EnrollmentType.Lecture => "bg-info",
            _ => "bg-secondary"
        };
    }

    private string GetUserInitials(UserDto user)
    {
        if (user == null) return "??";

        var first = user.FirstName?.Length > 0 ? user.FirstName[0].ToString() : "";
        var last = user.LastName?.Length > 0 ? user.LastName[0].ToString() : "";

        return string.IsNullOrEmpty(first + last) ?
            user.Email?.Substring(0, 2).ToUpper() ?? "??" :
            $"{first}{last}".ToUpper();
    }

    private int CalculateAge(DateTime dateOfBirth)
    {
        var today = DateTime.Today;
        var age = today.Year - dateOfBirth.Year;
        if (dateOfBirth.Date > today.AddYears(-age)) age--;
        return age;
    }

    private string GetTimeSpent(EnrollmentDto enrollment)
    {
        if (enrollment?.ProgressTrackings == null || !enrollment.ProgressTrackings.Any())
            return "0h";

        var totalSeconds = enrollment.ProgressTrackings.Sum(p => p.TimeSpentSeconds);
        var hours = totalSeconds / 3600;
        var minutes = (totalSeconds % 3600) / 60;

        return minutes > 0 ? $"{hours}h {minutes}m" : $"{hours}h";
    }

    private string GetProgressColor(double progress)
    {
        return progress switch
        {
            >= 100 => "#28a745",
            >= 75 => "#17a2b8",
            >= 50 => "#007bff",
            >= 25 => "#ffc107",
            _ => "#dc3545"
        };
    }

    private string GetProgressBarClass(double progress)
    {
