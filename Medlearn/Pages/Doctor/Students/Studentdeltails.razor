        {
            >= 100 => "bg-success",
            >= 75 => "bg-info",
            >= 50 => "bg-primary",
            >= 25 => "bg-warning",
            _ => "bg-danger"
        };
    }

    private string GetStatusBadgeClass(EnrollmentDto enrollment)
    {
        if (enrollment.IsCompleted) return "bg-success";
        if (enrollment.ProgressPercentage > 0) return "bg-info";
        return "bg-warning";
    }

    private string GetStatusText(EnrollmentDto enrollment)
    {
        if (enrollment.IsCompleted) return "Completed";
        if (enrollment.ProgressPercentage > 0) return "In Progress";
        return "Not Started";
    }

    private string GetTimelineMarkerColor(string type)
    {
        return type switch
        {
            "enrollment" => "bg-primary",
            "progress" => "bg-info",
            "completion" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string FormatRelativeTime(DateTime date)
    {
        var diff = DateTime.Now - date;

        if (diff.TotalMinutes < 1)
            return "Just now";
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes} minutes ago";
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours} hours ago";
        if (diff.TotalDays < 7)
            return $"{(int)diff.TotalDays} days ago";
        if (diff.TotalDays < 30)
            return $"{(int)(diff.TotalDays / 7)} weeks ago";
        if (diff.TotalDays < 365)
            return $"{(int)(diff.TotalDays / 30)} months ago";

        return date.ToString("MMM dd, yyyy");
    }

