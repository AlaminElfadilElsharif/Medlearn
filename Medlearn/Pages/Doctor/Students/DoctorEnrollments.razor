    </div>
</div>

@code {
    // Mobile UI state
    private bool showMobileFilters = false;
    private bool showMobileSearch = false;

    // Data collections
    private List<EnrollmentDto> enrollments = new();
    private List<EnrollmentDto> filteredEnrollments = new();
    private List<ContentPerformance> contentPerformance = new();
    
    // UI state
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = "";
    
    // Filter properties
    private string searchQuery = "";
    private string? filterType = "";
    private string? filterStatus = "";
    private string filterDateRange = "30";
    
    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    
    // Statistics
    private int totalEnrollments = 0;
    private int activeStudents = 0;
    private int completedEnrollments = 0;
    private double completionRate = 0;
    private decimal totalRevenue = 0;
    private int enrollmentChange = 0;
    private Dictionary<EnrollmentType, int> enrollmentByType = new();
    private List<MonthlyEnrollment> monthlyEnrollments = new();
    
    // Computed property for total pages
    private int totalPages => (int)Math.Ceiling(filteredEnrollments.Count / (double)pageSize);

    // Mobile helper methods
    private void ToggleMobileFilters()
    {
        showMobileFilters = !showMobileFilters;
        showMobileSearch = false;
    }

    private void ToggleSearch()
    {
        showMobileSearch = !showMobileSearch;
        showMobileFilters = false;
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrEmpty(searchQuery) || 
               !string.IsNullOrEmpty(filterType) || 
               !string.IsNullOrEmpty(filterStatus) || 
               filterDateRange != "30";
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/doctor/dashboard");
    }

    // Filter change handlers
    private void FilterTypeChanged(ChangeEventArgs e)
    {
        filterType = e.Value?.ToString();
        ApplyFilters();
    }

    private void FilterStatusChanged(ChangeEventArgs e)
    {
        filterStatus = e.Value?.ToString();
        ApplyFilters();
    }

    private void FilterDateRangeChanged(ChangeEventArgs e)
    {
        filterDateRange = e.Value?.ToString() ?? "30";
        ApplyFilters();
    }

    private void SearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilters();
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadEnrollments();
    }

    private async Task LoadEnrollments()
    {
        isLoading = true;
        hasError = false;
        errorMessage = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            Console.WriteLine("Loading enrollments...");

            // Check authentication
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                errorMessage = "Please log in to view enrollments.";
                hasError = true;
                return;
            }

            // Get current user to verify doctor role
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser?.UserType != UserType.Doctor)
            {
                errorMessage = "Access denied. Only doctors can view enrollments.";
                hasError = true;
                return;
            }

            Console.WriteLine($"Doctor ID: {currentUser.Id}, Loading enrollments...");

            // Load detailed enrollment data using the correct endpoint
            var enrollmentsResponse = await EnrollmentService.GetDoctorContentEnrollmentsAsync();
            
            if (enrollmentsResponse != null)
            {
                Console.WriteLine($"Loaded {enrollmentsResponse.Count} enrollments");
                enrollments = enrollmentsResponse;
                
                if (enrollments.Any())
                {
                    Console.WriteLine($"Sample enrollment: {enrollments[0].Id}, Type: {enrollments[0].EnrollmentType}, Price: {enrollments[0].PricePaid}");
                }

                // Load aggregated statistics for content performance
                await LoadContentPerformance();
                
                // Calculate statistics
                CalculateStatistics();
                
                // Apply initial filters
                ApplyFilters();
                
                await JS.InvokeVoidAsync("showToast", "success", $"Loaded {enrollments.Count} enrollments");
            }
            else
            {
                Console.WriteLine("No enrollments response received");
                enrollments = new List<EnrollmentDto>();
                ApplyFilters();
                await JS.InvokeVoidAsync("showToast", "info", "No enrollments found");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading enrollments: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            errorMessage = $"Error loading enrollments: {ex.Message}";
            hasError = true;
            enrollments = new List<EnrollmentDto>();
            ApplyFilters();
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadContentPerformance()
    {
        try
        {
            Console.WriteLine("Loading content performance data...");
            
            // Get aggregated statistics for content performance
            var performanceResponse = await EnrollmentService.GetDoctorEnrollmentsAsync();
            
            if (performanceResponse != null)
            {
                contentPerformance = new List<ContentPerformance>();
                
                foreach (var item in performanceResponse)
                {
                    try
                    {
                        // Parse the JSON response
                        var json = JsonSerializer.Serialize(item);
                        var jsonDoc = JsonDocument.Parse(json);
                        
                        var type = (EnrollmentType)jsonDoc.RootElement.GetProperty("Type").GetInt32();
                        var entityId = jsonDoc.RootElement.GetProperty("EntityId").GetInt32();
                        var title = jsonDoc.RootElement.GetProperty("Title").GetString() ?? "Unknown";
                        var totalEnrollments = jsonDoc.RootElement.GetProperty("TotalEnrollments").GetInt32();
                        var completedEnrollments = jsonDoc.RootElement.GetProperty("CompletedEnrollments").GetInt32();
                        var averageProgress = jsonDoc.RootElement.GetProperty("AverageProgress").GetDouble();
                        var totalRevenue = jsonDoc.RootElement.GetProperty("TotalRevenue").GetDecimal();
                        
                        var completionRate = totalEnrollments > 0 
                            ? (completedEnrollments * 100.0 / totalEnrollments)
                            : 0;
                        
                        contentPerformance.Add(new ContentPerformance
                        {
                            Type = type,
                            EntityId = entityId,
                            Title = title,
                            TotalEnrollments = totalEnrollments,
                            CompletedEnrollments = completedEnrollments,
                            AverageProgress = averageProgress,
                            CompletionRate = completionRate,
                            TotalRevenue = totalRevenue
                        });
                        
                        Console.WriteLine($"Content Performance: {title} - {totalEnrollments} enrollments, ${totalRevenue}");
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error parsing content performance item: {ex.Message}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading content performance: {ex.Message}");
        }
    }

    private async Task RefreshData()
    {
        await LoadEnrollments();
    }

    private void CalculateStatistics()
    {
        try
        {
            Console.WriteLine("Calculating statistics...");
            
            totalEnrollments = enrollments.Count;
            Console.WriteLine($"Total enrollments: {totalEnrollments}");

            // Active students: unique users with enrollments not completed and progress > 0
            activeStudents = enrollments
                .Where(e => !e.IsCompleted && e.ProgressPercentage > 0)
                .Select(e => e.UserId)
                .Distinct()
                .Count();
            Console.WriteLine($"Active students: {activeStudents}");
            
            completedEnrollments = enrollments.Count(e => e.IsCompleted);
            Console.WriteLine($"Completed enrollments: {completedEnrollments}");
            
            completionRate = totalEnrollments > 0 ? 
                (completedEnrollments * 100.0 / totalEnrollments) : 0;
            Console.WriteLine($"Completion rate: {completionRate}%");
            
            totalRevenue = enrollments.Sum(e => e.PricePaid);
            Console.WriteLine($"Total revenue: {totalRevenue}");

            // Calculate enrollment by type
            enrollmentByType = enrollments
                .GroupBy(e => e.EnrollmentType)
                .ToDictionary(g => g.Key, g => g.Count());
            
            Console.WriteLine("Enrollment by type:");
            foreach (var item in enrollmentByType)
            {
                Console.WriteLine($"  {item.Key}: {item.Value}");
            }

            // Calculate monthly enrollments
            monthlyEnrollments = enrollments
                .GroupBy(e => new { e.EnrollmentDate.Year, e.EnrollmentDate.Month })
                .Select(g => new MonthlyEnrollment
                {
                    Year = g.Key.Year,
                    Month = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(g.Key.Month),
                    Count = g.Count(),
                    Revenue = g.Sum(e => e.PricePaid)
                })
                .OrderBy(m => m.Year).ThenBy(m => m.Month)
                .ToList();

            Console.WriteLine($"Monthly enrollments: {monthlyEnrollments.Count} months");

            // Calculate enrollment change (last 30 days vs previous 30 days)
            var thirtyDaysAgo = DateTime.Now.AddDays(-30);
            var sixtyDaysAgo = DateTime.Now.AddDays(-60);
            
            var recentEnrollments = enrollments
                .Where(e => e.EnrollmentDate >= thirtyDaysAgo)
                .Count();
            
            var previousEnrollments = enrollments
                .Where(e => e.EnrollmentDate >= sixtyDaysAgo && e.EnrollmentDate < thirtyDaysAgo)
                .Count();

            if (previousEnrollments > 0)
            {
                enrollmentChange = (int)((recentEnrollments - previousEnrollments) * 100.0 / previousEnrollments);
            }
            else if (recentEnrollments > 0)
            {
                enrollmentChange = 100;
            }
            else
            {
                enrollmentChange = 0;
            }

            Console.WriteLine($"Enrollment change: {enrollmentChange}% (Recent: {recentEnrollments}, Previous: {previousEnrollments})");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating statistics: {ex.Message}");
        }
    }

    private void ApplyFilters()
    {
        try
        {
            Console.WriteLine("Applying filters...");
            Console.WriteLine($"Search: '{searchQuery}', Type: '{filterType}', Status: '{filterStatus}', DateRange: '{filterDateRange}'");

            var query = enrollments.AsQueryable();

            // Apply search query
            if (!string.IsNullOrEmpty(searchQuery))
            {
                var search = searchQuery.ToLower();
                query = query.Where(e =>
                    (e.User != null && (
                        (e.User.FirstName != null && e.User.FirstName.ToLower().Contains(search)) ||
                        (e.User.LastName != null && e.User.LastName.ToLower().Contains(search)) ||
                        (e.User.Email != null && e.User.Email.ToLower().Contains(search))
                    )) ||
                    (e.Lecture != null && e.Lecture.Title != null && e.Lecture.Title.ToLower().Contains(search)) ||
                    (e.Course != null && e.Course.Title != null && e.Course.Title.ToLower().Contains(search)) ||
                    (e.Specialization != null && e.Specialization.Title != null && e.Specialization.Title.ToLower().Contains(search))
                );
            }

            // Apply type filter
            if (!string.IsNullOrEmpty(filterType) && int.TryParse(filterType, out int typeValue))
            {
                var enumValue = (EnrollmentType)typeValue;
                query = query.Where(e => e.EnrollmentType == enumValue);
                Console.WriteLine($"Filtered by type: {enumValue}");
            }

            // Apply status filter
            if (!string.IsNullOrEmpty(filterStatus))
            {
                if (filterStatus == "completed")
                {
                    query = query.Where(e => e.IsCompleted);
                    Console.WriteLine("Filtered by status: Completed");
                }
                else if (filterStatus == "in-progress")
                {
                    query = query.Where(e => !e.IsCompleted && e.ProgressPercentage > 0);
                    Console.WriteLine("Filtered by status: In Progress");
                }
            }

            // Apply date range filter
            if (filterDateRange != "all" && int.TryParse(filterDateRange, out int days))
            {
                var startDate = DateTime.Now.AddDays(-days);
                query = query.Where(e => e.EnrollmentDate >= startDate);
                Console.WriteLine($"Filtered by date range: Last {days} days");
            }

            // Order by enrollment date descending
            filteredEnrollments = query
                .OrderByDescending(e => e.EnrollmentDate)
                .ToList();
            
            Console.WriteLine($"Filtered enrollments count: {filteredEnrollments.Count}");
            
            // Reset to first page when filters change
            currentPage = 1;
            
            // Close mobile panels after applying filters
            showMobileFilters = false;
            showMobileSearch = false;
            
            // Force UI update
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error applying filters: {ex.Message}");
            filteredEnrollments = enrollments.ToList();
        }
    }

    private void ClearFilters()
    {
        searchQuery = "";
        filterType = "";
        filterStatus = "";
        filterDateRange = "30";
        ApplyFilters();
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void ChangePageSize(int size)
    {
        pageSize = size;
        currentPage = 1;
        StateHasChanged();
    }

    private IEnumerable<EnrollmentDto> GetCurrentPageItems()
    {
        return filteredEnrollments
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);
    }

    private string GetEnrollmentTitle(EnrollmentDto enrollment)
    {
        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => enrollment.Specialization?.Title ?? "Specialization",
            EnrollmentType.Course => enrollment.Course?.Title ?? "Course",
            EnrollmentType.Lecture => enrollment.Lecture?.Title ?? "Lecture",
            _ => "Unknown Content"
        };
    }

    private string GetEnrollmentIcon(EnrollmentType type)
    {
        return type switch
        {
            EnrollmentType.Lecture => "fa-video",
            EnrollmentType.Course => "fa-graduation-cap",
            EnrollmentType.Specialization => "fa-book",
            _ => "fa-file"
        };
    }

    private string GetEnrollmentTypeBadge(EnrollmentType type)
    {
        return type switch
        {
            EnrollmentType.Lecture => "bg-info",
            EnrollmentType.Course => "bg-primary",
            EnrollmentType.Specialization => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetProgressBarClass(EnrollmentType type)
    {
        return type switch
        {
            EnrollmentType.Lecture => "bg-info",
            EnrollmentType.Course => "bg-primary",
            EnrollmentType.Specialization => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetChangeClass(int change)
    {
        return change >= 0 ? "text-success" : "text-danger";
    }

    private string GetInitials(string? firstName, string? lastName)
    {
        var firstInitial = !string.IsNullOrEmpty(firstName) ? firstName[0].ToString() : "S";
        var lastInitial = !string.IsNullOrEmpty(lastName) ? lastName[0].ToString() : "T";
        return firstInitial + lastInitial;
    }

    private string GetLastActiveTime(EnrollmentDto enrollment)
    {
        if (enrollment.IsCompleted && enrollment.CompletedDate.HasValue)
        {
            var timeSpan = DateTime.Now - enrollment.CompletedDate.Value;
            if (timeSpan.TotalDays < 1)
                return "Completed today";
            return $"Completed {(int)timeSpan.TotalDays} day{(timeSpan.TotalDays > 1 ? "s" : "")} ago";
        }

        // For in-progress enrollments
        if (enrollment.ProgressTrackings != null && enrollment.ProgressTrackings.Any())
        {
            var lastProgress = enrollment.ProgressTrackings
                .Where(p => p.UpdatedAt.HasValue)
                .OrderByDescending(p => p.UpdatedAt)
                .FirstOrDefault();
            
            if (lastProgress != null && lastProgress.UpdatedAt.HasValue)
            {
                var timeSpan = DateTime.Now - lastProgress.UpdatedAt.Value;
                
                if (timeSpan.TotalDays < 1)
                {
                    if (timeSpan.TotalHours < 1)
                        return "Active recently";
                    return $"Active {(int)timeSpan.TotalHours} hour{(timeSpan.TotalHours > 1 ? "s" : "")} ago";
                }
                return $"Active {(int)timeSpan.TotalDays} day{(timeSpan.TotalDays > 1 ? "s" : "")} ago";
            }
        }

        // Fallback to enrollment date
        var enrollmentTimeSpan = DateTime.Now - enrollment.EnrollmentDate;
        if (enrollmentTimeSpan.TotalDays < 1)
            return "Enrolled today";
        return $"Enrolled {(int)enrollmentTimeSpan.TotalDays} day{(enrollmentTimeSpan.TotalDays > 1 ? "s" : "")} ago";
    }

    private async Task ExportEnrollments()
    {
        try
        {
            var csvContent = "Student Name,Student Email,Content Type,Content Title,Enrollment Date,Progress,Amount,Status,Completion Date\n";

            foreach (var enrollment in enrollments)
            {
                csvContent += $"\"{enrollment.User?.FirstName} {enrollment.User?.LastName}\",";
                csvContent += $"{enrollment.User?.Email},";
                csvContent += $"{enrollment.EnrollmentType},";
                csvContent += $"\"{GetEnrollmentTitle(enrollment)}\",";
                csvContent += $"{enrollment.EnrollmentDate:yyyy-MM-dd},";
                csvContent += $"{enrollment.ProgressPercentage}%,";
                csvContent += $"${enrollment.PricePaid.ToString("N2")},";
                csvContent += $"{(enrollment.IsCompleted ? "Completed" : "In Progress")},";
                csvContent += $"{(enrollment.CompletedDate?.ToString("yyyy-MM-dd") ?? "N/A")}\n";
            }

            var fileName = $"enrollments-export-{DateTime.Now:yyyyMMdd-HHmmss}.csv";

            // Convert string to bytes and then to base64
            var bytes = System.Text.Encoding.UTF8.GetBytes(csvContent);
            var base64String = Convert.ToBase64String(bytes);

            // Call the JS function with all three parameters
            await JS.InvokeVoidAsync("downloadFile", base64String, fileName, "text/csv");

            await JS.InvokeVoidAsync("showToast", "success", "Enrollments exported successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Export error: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", $"Export failed: {ex.Message}");
        }
    }

