@page "/doctor/enrollments"


<PageTitle>Doctor Enrollments</PageTitle>

<div class="doctor-enrollments">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none mb-3">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <div class="flex-grow-1">
                        <h5 class="mb-0">Student Enrollments</h5>
                        <small>@filteredEnrollments.Count of @totalEnrollments enrollments</small>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-link text-white p-0" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-ellipsis-v fa-lg"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <button class="dropdown-item" @onclick="ExportEnrollments">
                                    <i class="fas fa-download me-2"></i>Export CSV
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" @onclick="RefreshData">
                                    <i class="fas fa-sync-alt me-2"></i>Refresh
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>Student Enrollments</h1>
                <p class="text-muted">Manage and track all student enrollments in your content</p>
                <small class="text-muted">Showing @filteredEnrollments.Count of @totalEnrollments enrollments</small>
            </div>
            <div>
                <button class="btn btn-primary" @onclick="ExportEnrollments">
                    <i class="fas fa-download me-2"></i> Export CSV
                </button>
                <button class="btn btn-outline-secondary ms-2" @onclick="RefreshData">
                    <i class="fas fa-sync-alt me-2"></i> Refresh
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading enrollments...</p>
            </div>
        }
        else if (hasError)
        {
            <div class="alert alert-danger m-3 m-md-0">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
                <button class="btn btn-sm btn-outline-danger ms-3" @onclick="LoadEnrollments">
                    <i class="fas fa-redo me-1"></i> Retry
                </button>
            </div>
        }
        else
        {
            <!-- Mobile Filter Bar -->
            <div class="d-block d-md-none mb-3 px-3">
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary flex-grow-1" @onclick="ToggleMobileFilters">
                        <i class="fas fa-filter me-2"></i>Filters
                        @if (HasActiveFilters())
                        {
                            <span class="badge bg-primary ms-2">!</span>
                        }
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ToggleSearch">
                        <i class="fas fa-search"></i>
                    </button>
                </div>

                <!-- Mobile Filters Panel -->
                @if (showMobileFilters)
                {
                    <div class="card mt-3">
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label small">Enrollment Type</label>
                                <select class="form-select form-select-sm" @onchange="(e) => FilterTypeChanged(e)">
                                    <option value="">All Types</option>
                                    <option value="1">Lecture</option>
                                    <option value="2">Course</option>
                                    <option value="3">Specialization</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small">Status</label>
                                <select class="form-select form-select-sm" @onchange="(e) => FilterStatusChanged(e)">
                                    <option value="">All Status</option>
                                    <option value="completed">Completed</option>
                                    <option value="in-progress">In Progress</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small">Date Range</label>
                                <select class="form-select form-select-sm" @onchange="(e) => FilterDateRangeChanged(e)">
                                    <option value="30">Last 30 Days</option>
                                    <option value="90">Last 90 Days</option>
                                    <option value="365">Last Year</option>
                                    <option value="all">All Time</option>
                                </select>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary flex-grow-1" @onclick="ApplyFilters">
                                    Apply Filters
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="ClearFilters">
                                    Clear
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Mobile Search Panel -->
                @if (showMobileSearch)
                {
                    <div class="card mt-3">
                        <div class="card-body">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Search students or content..."
                                       @bind="searchQuery" @bind:event="oninput" />
                                <button class="btn btn-primary" type="button" @onclick="ApplyFilters">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Desktop Filters -->
            <div class="d-none d-md-block card mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Enrollment Type</label>
                            <select class="form-select" @onchange="(e) => FilterTypeChanged(e)">
                                <option value="">All Types</option>
                                <option value="1">Lecture</option>
                                <option value="2">Course</option>
                                <option value="3">Specialization</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select class="form-select" @onchange="(e) => FilterStatusChanged(e)">
                                <option value="">All Status</option>
                                <option value="completed">Completed</option>
                                <option value="in-progress">In Progress</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Date Range</label>
                            <select class="form-select" @onchange="(e) => FilterDateRangeChanged(e)">
                                <option value="30">Last 30 Days</option>
                                <option value="90">Last 90 Days</option>
                                <option value="365">Last Year</option>
                                <option value="all">All Time</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Search</label>
                            <div class="input-group">
                                 <input type="text" class="form-control" placeholder="Search students or content..." 
               @bind="searchQuery" @bind:event="oninput" />

                                <button class="btn btn-outline-secondary" type="button" @onclick="ApplyFilters">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12">
                            <button class="btn btn-primary me-2" @onclick="ApplyFilters">
                                <i class="fas fa-filter me-2"></i>Apply Filters
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="ClearFilters">
                                <i class="fas fa-times me-2"></i>Clear Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Cards - Responsive -->
            <div class="row g-2 g-md-3 mb-4 px-2 px-md-0">
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-2 p-md-3">
                            <h6 class="text-muted small mb-1">Total Enrollments</h6>
                            <h3 class="mb-0 mb-md-2">@totalEnrollments</h3>
                            <small class="@GetChangeClass(enrollmentChange) d-none d-md-inline">
                                <i class="fas @(enrollmentChange >= 0 ? "fa-arrow-up" : "fa-arrow-down") me-1"></i> 
                                @(enrollmentChange >= 0 ? "+" : "")@enrollmentChange%
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-2 p-md-3">
                            <h6 class="text-muted small mb-1">Active Students</h6>
                            <h3 class="mb-0 mb-md-2">@activeStudents</h3>
                            <small class="text-success d-none d-md-inline">
                                <i class="fas fa-user-check me-1"></i> Currently learning
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-2 p-md-3">
                            <h6 class="text-muted small mb-1">Completion Rate</h6>
                            <h3 class="mb-0 mb-md-2">@completionRate.ToString("0")%</h3>
                            <small class="text-warning d-none d-md-inline">
                                <i class="fas fa-trophy me-1"></i> @completedEnrollments completed
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-2 p-md-3">
                            <h6 class="text-muted small mb-1">Total Revenue</h6>
                            <h3 class="mb-0 mb-md-2">$@totalRevenue.ToString("N0")</h3>
                            <small class="text-success d-none d-md-inline">
                                <i class="fas fa-dollar-sign me-1"></i> From enrollments
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Stats Footer -->
            <div class="d-block d-md-none px-3 mb-3">
                <div class="d-flex justify-content-between small">
                    <span class="@GetChangeClass(enrollmentChange)">
                        <i class="fas @(enrollmentChange >= 0 ? "fa-arrow-up" : "fa-arrow-down") me-1"></i>
                        @(enrollmentChange >= 0 ? "+" : "")@enrollmentChange% from last period
                    </span>
                    <span class="text-success">
                        <i class="fas fa-dollar-sign me-1"></i> $@totalRevenue.ToString("N0") revenue
                    </span>
                </div>
            </div>

            <!-- Enrollments List - Mobile View -->
            <div class="d-block d-md-none">
                @if (filteredEnrollments.Any())
                {
                    <div class="px-3">
                        @foreach (var enrollment in GetCurrentPageItems())
                        {
                            <div class="card mb-3">
                                <div class="card-body">
                                    <!-- Student Info -->
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="avatar-sm me-2">
                                            @if (!string.IsNullOrEmpty(enrollment.User?.ProfileImageUrl))
                                            {
                                                <img src="@enrollment.User.ProfileImageUrl" 
                                                     class="rounded-circle" width="40" height="40" 
                                                     alt="Student" 
                                                     onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
                                            }
                                            else
                                            {
                                                <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                                     style="width: 40px; height: 40px;">
                                                    @GetInitials(enrollment.User?.FirstName, enrollment.User?.LastName)
                                                </div>
                                            }
                                        </div>
                                        <div class="flex-grow-1">
                                            <strong>@enrollment.User?.FirstName @enrollment.User?.LastName</strong>
                                            <br/>
                                            <small class="text-muted">@enrollment.User?.Email</small>
                                        </div>
                                        <span class="badge bg-success">$@enrollment.PricePaid.ToString("N2")</span>
                                    </div>

                                    <!-- Content Info -->
                                    <div class="mb-2">
                                        <span class="badge @GetEnrollmentTypeBadge(enrollment.EnrollmentType) mb-1">
                                            <i class="fas @GetEnrollmentIcon(enrollment.EnrollmentType) me-1"></i>
                                            @enrollment.EnrollmentType
                                        </span>
                                        <div class="fw-bold">@GetEnrollmentTitle(enrollment)</div>
                                    </div>

                                    <!-- Date -->
                                    <div class="small text-muted mb-2">
                                        <i class="fas fa-calendar me-1"></i>
                                        @enrollment.EnrollmentDate.ToString("MMM dd, yyyy • hh:mm tt")
                                    </div>

                                    <!-- Progress -->
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="small">Progress</span>
                                            <span class="small fw-bold">@enrollment.ProgressPercentage.ToString("0")%</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar @(enrollment.IsCompleted ? "bg-success" : "bg-primary")" 
                                                 role="progressbar" 
                                                 style="width: @enrollment.ProgressPercentage%"></div>
                                        </div>
                                        @if (!enrollment.IsCompleted && enrollment.ProgressPercentage > 0)
                                        {
                                            <small class="text-muted d-block mt-1">
                                                Last active: @GetLastActiveTime(enrollment)
                                            </small>
                                        }
                                    </div>

                                    <!-- Status and Actions -->
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            @if (enrollment.IsCompleted)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check me-1"></i> Completed
                                                    <small class="ms-1">@enrollment.CompletedDate?.ToString("MMM dd")</small>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge @(enrollment.ProgressPercentage > 0 ? "bg-warning" : "bg-secondary")">
                                                    <i class="fas @(enrollment.ProgressPercentage > 0 ? "fa-spinner" : "fa-clock") me-1"></i> 
                                                    @(enrollment.ProgressPercentage > 0 ? "In Progress" : "Not Started")
                                                </span>
                                            }
                                        </div>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" 
                                                    @onclick="() => ViewStudentDetails(enrollment.UserId)"
                                                    title="View Student">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="btn btn-outline-info" 
                                                    @onclick="() => SendMessageToStudent(enrollment.UserId)"
                                                    title="Send Message">
                                                <i class="fas fa-envelope"></i>
                                            </button>
                                            @if (enrollment.ProgressPercentage > 0)
                                            {
                                                <button class="btn btn-outline-success" 
                                                        @onclick="() => ViewProgressDetails(enrollment.Id)"
                                                        title="View Progress">
                                                    <i class="fas fa-chart-line"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Mobile Pagination -->
                    @if (totalPages > 1)
                    {
                        <div class="d-flex justify-content-center align-items-center gap-2 mt-3 mb-4">
                            <button class="btn btn-sm btn-outline-secondary @(currentPage == 1 ? "disabled" : "")" 
                                    @onclick="() => ChangePage(currentPage - 1)">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <span class="mx-2">Page @currentPage of @totalPages</span>
                            <button class="btn btn-sm btn-outline-secondary @(currentPage == totalPages ? "disabled" : "")" 
                                    @onclick="() => ChangePage(currentPage + 1)">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    }

                    <!-- Mobile Page Size -->
                    <div class="d-flex justify-content-center gap-2 mb-4">
                        <span class="text-muted small me-2">Show:</span>
                        <button class="btn btn-sm @(pageSize == 10 ? "btn-primary" : "btn-outline-secondary")" 
                                @onclick="() => ChangePageSize(10)">10</button>
                        <button class="btn btn-sm @(pageSize == 25 ? "btn-primary" : "btn-outline-secondary")" 
                                @onclick="() => ChangePageSize(25)">25</button>
                        <button class="btn btn-sm @(pageSize == 50 ? "btn-primary" : "btn-outline-secondary")" 
                                @onclick="() => ChangePageSize(50)">50</button>
                    </div>
                }
                else
                {
                    <!-- Empty State Mobile -->
                    <div class="text-center py-5 px-3">
                        @if (enrollments.Any() && !filteredEnrollments.Any())
                        {
                            <i class="fas fa-filter fa-3x text-muted mb-3"></i>
                            <h5>No Matching Enrollments</h5>
                            <p class="text-muted">No enrollments match your current filters.</p>
                            <button class="btn btn-outline-primary" @onclick="ClearFilters">
                                <i class="fas fa-times me-2"></i> Clear Filters
                            </button>
                        }
                        else
                        {
                            <i class="fas fa-user-graduate fa-3x text-muted mb-3"></i>
                            <h5>No Enrollments Yet</h5>
                            <p class="text-muted">You don't have any student enrollments yet.</p>
                            <button class="btn btn-primary" @onclick="CreateContent">
                                <i class="fas fa-plus me-2"></i> Create Content
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Desktop Table View -->
            <div class="d-none d-md-block card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Enrollment Details</h5>
                    <div>
                        <span class="text-muted me-3">
                            @((currentPage - 1) * pageSize + 1)-@Math.Min(currentPage * pageSize, filteredEnrollments.Count) of @filteredEnrollments.Count
                        </span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary @(pageSize == 10 ? "active" : "")" @onclick="() => ChangePageSize(10)">
                                10
                            </button>
                            <button class="btn btn-outline-secondary @(pageSize == 25 ? "active" : "")" @onclick="() => ChangePageSize(25)">
                                25
                            </button>
                            <button class="btn btn-outline-secondary @(pageSize == 50 ? "active" : "")" @onclick="() => ChangePageSize(50)">
                                50
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (filteredEnrollments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>Content</th>
                                        <th>Type</th>
                                        <th>Enrollment Date</th>
                                        <th>Progress</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var enrollment in GetCurrentPageItems())
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-sm me-2">
                                                        @if (!string.IsNullOrEmpty(enrollment.User?.ProfileImageUrl))
                                                        {
                                                            <img src="@enrollment.User.ProfileImageUrl" 
                                                                 class="rounded-circle" width="32" height="32" 
                                                                 alt="Student" 
                                                                 onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
                                                        }
                                                        else
                                                        {
                                                            <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                                                 style="width: 32px; height: 32px;">
                                                                @GetInitials(enrollment.User?.FirstName, enrollment.User?.LastName)
                                                            </div>
                                                        }
                                                    </div>
                                                    <div>
                                                        <strong>@enrollment.User?.FirstName @enrollment.User?.LastName</strong>
                                                        <br/>
                                                        <small class="text-muted">@enrollment.User?.Email</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <strong>@GetEnrollmentTitle(enrollment)</strong>
                                            </td>
                                            <td>
                                                <span class="badge @GetEnrollmentTypeBadge(enrollment.EnrollmentType)">
                                                    <i class="fas @GetEnrollmentIcon(enrollment.EnrollmentType) me-1"></i>
                                                    @enrollment.EnrollmentType
                                                </span>
                                            </td>
                                            <td>
                                                @enrollment.EnrollmentDate.ToString("MMM dd, yyyy")
                                                <br/>
                                                <small class="text-muted">@enrollment.EnrollmentDate.ToString("hh:mm tt")</small>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                                        <div class="progress-bar @(enrollment.IsCompleted ? "bg-success" : "bg-primary")" 
                                                             role="progressbar" 
                                                             style="width: @enrollment.ProgressPercentage%"></div>
                                                    </div>
                                                    <span>@enrollment.ProgressPercentage.ToString("0")%</span>
                                                </div>
                                                @if (!enrollment.IsCompleted && enrollment.ProgressPercentage > 0)
                                                {
                                                    <small class="text-muted">
                                                        Last active: @GetLastActiveTime(enrollment)
                                                    </small>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-success">$@enrollment.PricePaid.ToString("N2")</span>
                                            </td>
                                            <td>
                                                @if (enrollment.IsCompleted)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check me-1"></i> Completed
                                                    </span>
                                                    <br/>
                                                    <small>@enrollment.CompletedDate?.ToString("MMM dd, yyyy")</small>
                                                }
                                                else
                                                {
                                                    <span class="badge @(enrollment.ProgressPercentage > 0 ? "bg-warning" : "bg-secondary")">
                                                        <i class="fas @(enrollment.ProgressPercentage > 0 ? "fa-spinner" : "fa-clock") me-1"></i> 
                                                        @(enrollment.ProgressPercentage > 0 ? "In Progress" : "Not Started")
                                                    </span>
                                                    <br/>
                                                    @if (enrollment.ProgressPercentage > 0)
                                                    {
                                                        <small>@enrollment.ProgressPercentage.ToString("0")% complete</small>
                                                    }
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group">
                                                    <button class="btn btn-sm btn-outline-primary" 
                                                            @onclick="() => ViewStudentDetails(enrollment.UserId)"
                                                            title="View Student">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-info" 
                                                            @onclick="() => SendMessageToStudent(enrollment.UserId)"
                                                            title="Send Message">
                                                        <i class="fas fa-envelope"></i>
                                                    </button>
                                                    @if (enrollment.ProgressPercentage >= 0)
                                                    {
                                                        <button class="btn btn-sm btn-outline-success" 
                                                                @onclick="() => ViewProgressDetails(enrollment.Id)"
                                                                title="View Progress">
                                                            <i class="fas fa-chart-line"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Desktop Pagination -->
                        @if (totalPages > 1)
                        {
                            <div class="card-footer">
                                <nav aria-label="Enrollment pagination">
                                    <ul class="pagination justify-content-center mb-0">
                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">
                                                <i class="fas fa-chevron-left"></i>
                                            </button>
                                        </li>
                                        
                                        @for (int i = 1; i <= totalPages; i++)
                                        {
                                            @if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                                            {
                                                <li class="page-item @(i == currentPage ? "active" : "")">
                                                    <button class="page-link" @onclick="() => ChangePage(i)">
                                                        @i
                                                    </button>
