    private void SetTimePeriod(string period)
    {
        timePeriod = period;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = allContent.AsQueryable();

        // Apply content type filter
        if (!string.IsNullOrEmpty(contentType))
        {
            var type = contentType switch
            {
                "specialization" => EnrollmentType.Specialization,
                "course" => EnrollmentType.Course,
                "lecture" => EnrollmentType.Lecture,
                _ => (EnrollmentType?)null
            };
            
            if (type.HasValue)
                query = query.Where(c => c.Type == type.Value);
        }

        // Apply sorting based on actual statistics
        filteredContent = sortBy switch
        {
            "revenue" => query.OrderByDescending(c => GetContentStatistics(c.Id, c.Type).TotalRevenue).ToList(),
            "rating" => query.OrderByDescending(c => GetContentStatistics(c.Id, c.Type).AverageRating).ToList(),
            "completion" => query.OrderByDescending(c => GetContentStatistics(c.Id, c.Type).CompletionRate).ToList(),
            _ => query.OrderByDescending(c => GetContentStatistics(c.Id, c.Type).TotalEnrollments).ToList()
        };
        
        Console.WriteLine($"Applied filters: {filteredContent.Count} items after filtering");
        
        // Close mobile filters after applying
        toggleMobileFilters = false;
    }

