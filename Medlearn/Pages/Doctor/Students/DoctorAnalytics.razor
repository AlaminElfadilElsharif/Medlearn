@code {
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = "";
    private string timePeriod = "30";
    private string? contentType = "";
    private string sortBy = "enrollments";
    private bool toggleMobileFilters = false;
    
    // Overview statistics
    private int totalContent = 0;
    private int specializationsCount = 0;
    private int coursesCount = 0;
    private int lecturesCount = 0;
    private int totalStudents = 0;
    private int activeStudents = 0;
    private int newStudents = 0;
    private decimal averageRating = 0;
    private int totalReviews = 0;
    private double completionRate = 0;
    private int completedEnrollments = 0;
    private int totalEnrollments = 0;
    private decimal totalRevenue = 0;
    
    // Trend statistics
    private double enrollmentChange = 0;
    private double revenueChange = 0;
    private double ratingChange = 0;
    private double completionChange = 0;
    
    // Content performance
    private List<ContentPerformance> allContent = new();
    private List<ContentPerformance> filteredContent = new();
    
    // Student insights
    private List<StudentDemographic> studentDemographics = new();
    
    // Enrollment data
    private List<EnrollmentDto> allEnrollments = new();
    private List<EnrollmentDto> recentEnrollments = new();
    
    // Content statistics cache
    private Dictionary<string, ContentStats> contentStatsCache = new();

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("DoctorAnalytics: Initializing...");
        await LoadAnalyticsData();
    }

    private async Task LoadAnalyticsData()
    {
        isLoading = true;
        hasError = false;
        errorMessage = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            Console.WriteLine("Loading analytics data...");
            
            // Check if user is a doctor
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser?.UserType != UserType.Doctor)
            {
                errorMessage = "Access denied. Only doctors can view analytics.";
                hasError = true;
                return;
            }

            // Reset data
            allContent.Clear();
            allEnrollments.Clear();
            recentEnrollments.Clear();
            contentStatsCache.Clear();
            
            // Get doctor ID
            var doctorId = currentUser.Id;
            Console.WriteLine($"Loading data for doctor ID: {doctorId}");

            // Load data sequentially to ensure dependencies
            await LoadDoctorContent(doctorId);
            await LoadDoctorEnrollments();
            
            // Calculate statistics
            CalculateStatistics();
            ApplyFilters();

            Console.WriteLine($"Analytics loaded: {totalContent} content items, {totalStudents} students");

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading analytics: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            errorMessage = $"Error loading analytics: {ex.Message}";
            hasError = true;
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadDoctorContent(int doctorId)
    {
        try
        {
            Console.WriteLine("Loading doctor content...");
            
            // Load doctor's specializations
            var specializations = await SpecializationService.GetMySpecializationsAsync() ?? new List<SpecializationDto>();
            specializationsCount = specializations.Count;
            
            foreach (var spec in specializations)
            {
                allContent.Add(new ContentPerformance
                {
                    Id = spec.Id,
                    Type = EnrollmentType.Specialization,
                    Title = spec.Title ?? "Unnamed Specialization",
                    ThumbnailUrl = spec.ThumbnailUrl ?? "",
                    CreatedAt = spec.CreatedAt,
                    AverageRating = spec.AverageRating
                });

                // Load courses for this specialization
                var courses = await CourseService.GetCoursesBySpecializationAsync(spec.Id) ?? new List<CourseDto>();
                var doctorCourses = courses.Where(c => c.DoctorId == doctorId).ToList();
                coursesCount += doctorCourses.Count;
                
                foreach (var course in doctorCourses)
                {
                    allContent.Add(new ContentPerformance
                    {
                        Id = course.Id,
                        Type = EnrollmentType.Course,
                        Title = course.Title ?? "Unnamed Course",
                        ThumbnailUrl = course.ThumbnailUrl ?? "",
                        CreatedAt = course.CreatedAt,
                        AverageRating = course.AverageRating
                    });

                    // Load lectures for this course
                    var lectures = await LectureService.GetLecturesByCourseAsync(course.Id) ?? new List<LectureDto>();
                    var doctorLectures = lectures.Where(l => l.DoctorId == doctorId).ToList();
                    lecturesCount += doctorLectures.Count;
                    
                    foreach (var lecture in doctorLectures)
                    {
                        allContent.Add(new ContentPerformance
                        {
                            Id = lecture.Id,
                            Type = EnrollmentType.Lecture,
                            Title = lecture.Title ?? "Unnamed Lecture",
                            CreatedAt = lecture.CreatedAt,
                            AverageRating = lecture.AverageRating
                        });
                    }
                }
            }

            totalContent = allContent.Count;
            Console.WriteLine($"Loaded: {specializationsCount} specs, {coursesCount} courses, {lecturesCount} lectures");
            
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctor content: {ex.Message}");
            throw;
        }
    }

    private async Task LoadDoctorEnrollments()
    {
        try
        {
            Console.WriteLine("Loading doctor enrollments...");
            
            // Get doctor enrollments
            var enrollments = await EnrollmentService.GetDoctorContentEnrollmentsAsync() ?? new List<EnrollmentDto>();
            
            if (enrollments.Any())
            {
                allEnrollments = enrollments;
                
                // Get recent enrollments (last 7 days)
                var sevenDaysAgo = DateTime.Now.AddDays(-7);
                recentEnrollments = enrollments
                    .Where(e => e.EnrollmentDate >= sevenDaysAgo)
                    .OrderByDescending(e => e.EnrollmentDate)
                    .ToList();

                // Calculate overall statistics
                totalStudents = enrollments.Select(e => e.UserId).Distinct().Count();
                totalEnrollments = enrollments.Count;
                completedEnrollments = enrollments.Count(e => e.IsCompleted);
                totalRevenue = enrollments.Sum(e => e.PricePaid);
                completionRate = totalEnrollments > 0 ? 
                    (completedEnrollments * 100.0 / totalEnrollments) : 0;

                // Calculate average rating from content that has ratings
                var ratedContent = allContent.Where(c => c.AverageRating > 0).ToList();
                if (ratedContent.Any())
                {
                    averageRating = (decimal)ratedContent.Average(c => (double)c.AverageRating);
                }

                // Estimate total reviews (20% of enrollments leave reviews)
                totalReviews = (int)(totalEnrollments * 0.2);

                // Calculate student demographics
                CalculateStudentDemographics();
                
                // Calculate trend statistics
                CalculateTrendStatistics();
                
                Console.WriteLine($"Loaded: {enrollments.Count} enrollments, {totalStudents} unique students, ${totalRevenue:N2} revenue");
            }
            else
            {
                Console.WriteLine("No enrollment data received");
            }
            
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading enrollments: {ex.Message}");
        }
    }

    private ContentStats GetContentStatistics(int contentId, EnrollmentType type)
    {
        var cacheKey = $"{type}_{contentId}";
        
        // Return cached stats if available
        if (contentStatsCache.TryGetValue(cacheKey, out var cachedStats))
        {
            return cachedStats;
        }

        // Filter enrollments for this specific content
        List<EnrollmentDto> contentEnrollments;
        
        switch (type)
        {
            case EnrollmentType.Specialization:
                contentEnrollments = allEnrollments
                    .Where(e => e.SpecializationId == contentId)
                    .ToList();
                break;
                
            case EnrollmentType.Course:
                contentEnrollments = allEnrollments
                    .Where(e => e.CourseId == contentId)
                    .ToList();
                break;
                
            case EnrollmentType.Lecture:
                contentEnrollments = allEnrollments
                    .Where(e => e.LectureId == contentId)
                    .ToList();
                break;
                
            default:
                contentEnrollments = new List<EnrollmentDto>();
                break;
        }

        // Calculate statistics
        var stats = new ContentStats
        {
            TotalEnrollments = contentEnrollments.Count,
            CompletedEnrollments = contentEnrollments.Count(e => e.IsCompleted),
            TotalRevenue = contentEnrollments.Sum(e => e.PricePaid),
            AverageProgress = contentEnrollments.Any() ? 
                contentEnrollments.Average(e => e.ProgressPercentage) : 0
        };

        // Calculate completion rate
        stats.CompletionRate = stats.TotalEnrollments > 0 ? 
            (stats.CompletedEnrollments * 100.0 / stats.TotalEnrollments) : 0;

        // Calculate enrollment change (last 30 days vs previous 30 days)
        stats.EnrollmentChange = CalculateContentEnrollmentChange(contentEnrollments);

        // Get average rating from content
        var content = allContent.FirstOrDefault(c => c.Id == contentId && c.Type == type);
        stats.AverageRating = content?.AverageRating ?? 0;

        // Cache the results
        contentStatsCache[cacheKey] = stats;

        return stats;
    }

    private int CalculateContentEnrollmentChange(List<EnrollmentDto> enrollments)
    {
        if (enrollments.Count < 2) return 0;
        
        var thirtyDaysAgo = DateTime.Now.AddDays(-30);
        var sixtyDaysAgo = DateTime.Now.AddDays(-60);
        
        var recentEnrollments = enrollments
            .Count(e => e.EnrollmentDate >= thirtyDaysAgo);
        
        var previousEnrollments = enrollments
            .Count(e => e.EnrollmentDate >= sixtyDaysAgo && e.EnrollmentDate < thirtyDaysAgo);

        if (previousEnrollments == 0) 
            return recentEnrollments > 0 ? 100 : 0;
        
        return (int)((recentEnrollments - previousEnrollments) * 100.0 / previousEnrollments);
    }

    private void CalculateStudentDemographics()
    {
        if (!allEnrollments.Any()) return;
        
        var thirtyDaysAgo = DateTime.Now.AddDays(-30);
        var sevenDaysAgo = DateTime.Now.AddDays(-7);
        
        var uniqueStudentIds = allEnrollments.Select(e => e.UserId).Distinct().ToList();
        
        // Track first enrollment date per student
        var studentFirstEnrollment = allEnrollments
            .GroupBy(e => e.UserId)
            .ToDictionary(g => g.Key, g => g.Min(e => e.EnrollmentDate));
        
        // Active this week: students with enrollments in last 7 days
        var activeThisWeek = allEnrollments
            .Where(e => e.EnrollmentDate >= sevenDaysAgo)
            .Select(e => e.UserId)
            .Distinct()
            .Count();
        
        // New students: first enrolled in last 30 days
        var newStudentsCount = studentFirstEnrollment
            .Count(kv => kv.Value >= thirtyDaysAgo);
        
        // Returning students: first enrolled more than 30 days ago
        var returningStudentsCount = studentFirstEnrollment.Count - newStudentsCount;
        
        // Completed students: those with at least one completed enrollment
        var completedStudents = allEnrollments
            .Where(e => e.IsCompleted)
            .Select(e => e.UserId)
            .Distinct()
            .Count();
        
        // Update the class variables
        activeStudents = activeThisWeek;
        newStudents = newStudentsCount;
        
        studentDemographics = new List<StudentDemographic>
        {
            new() { Category = "New Students", Count = newStudentsCount },
            new() { Category = "Returning Students", Count = returningStudentsCount },
            new() { Category = "Active This Week", Count = activeThisWeek },
            new() { Category = "Completed", Count = completedStudents }
        };

        // Normalize percentages
        var total = studentDemographics.Sum(d => d.Count);
        if (total > 0)
        {
            foreach (var demo in studentDemographics)
            {
                demo.Percentage = (demo.Count * 100.0 / total);
            }
        }
    }

    private void CalculateTrendStatistics()
    {
        var days = int.Parse(timePeriod);
        var currentPeriodStart = DateTime.Now.AddDays(-days);
        var previousPeriodStart = currentPeriodStart.AddDays(-days);
        
        var currentPeriodEnrollments = allEnrollments
            .Where(e => e.EnrollmentDate >= currentPeriodStart)
            .ToList();
        
        var previousPeriodEnrollments = allEnrollments
            .Where(e => e.EnrollmentDate >= previousPeriodStart && 
                       e.EnrollmentDate < currentPeriodStart)
            .ToList();

        var currentEnrollmentsCount = currentPeriodEnrollments.Count;
        var previousEnrollmentsCount = previousPeriodEnrollments.Count;
        
        // Calculate enrollment change
        if (previousEnrollmentsCount > 0)
        {
            enrollmentChange = ((currentEnrollmentsCount - previousEnrollmentsCount) * 100.0 / previousEnrollmentsCount);
        }
        else
        {
            enrollmentChange = currentEnrollmentsCount > 0 ? 100 : 0;
        }

        // Calculate revenue
        var currentRevenueAmount = currentPeriodEnrollments.Sum(e => e.PricePaid);
        var previousRevenueAmount = previousPeriodEnrollments.Sum(e => e.PricePaid);
        
        // Calculate revenue change
        if (previousRevenueAmount > 0)
        {
            revenueChange = (double)((currentRevenueAmount - previousRevenueAmount) * 100.0m / previousRevenueAmount);
        }
        else
        {
            revenueChange = currentRevenueAmount > 0 ? 100 : 0;
        }

        // Calculate completion changes
        var currentCompleted = currentPeriodEnrollments.Count(e => e.IsCompleted);
        var previousCompleted = previousPeriodEnrollments.Count(e => e.IsCompleted);
        
        var currentCompletionRate = currentPeriodEnrollments.Any() ? 
            (currentCompleted * 100.0 / currentPeriodEnrollments.Count) : 0;
        var previousCompletionRate = previousPeriodEnrollments.Any() ? 
            (previousCompleted * 100.0 / previousPeriodEnrollments.Count) : 0;
        
        completionChange = currentCompletionRate - previousCompletionRate;
        
        Console.WriteLine($"Trends: Enrollments change {enrollmentChange:0}%, Revenue change {revenueChange:0}%");
    }

