    private async Task ExportAnalytics()
    {
        try
        {
            var csvContent = "Content,Type,Enrollments,Completed,Revenue,Avg Rating,Completion Rate,Avg Progress\n";
            
            foreach (var content in allContent)
            {
                var stats = GetContentStatistics(content.Id, content.Type);
                csvContent += $"\"{content.Title}\",";
                csvContent += $"{content.Type},";
                csvContent += $"{stats.TotalEnrollments},";
                csvContent += $"{stats.CompletedEnrollments},";
                csvContent += $"${stats.TotalRevenue.ToString("N2")},";
                csvContent += $"{stats.AverageRating.ToString("0.0")},";
                csvContent += $"{stats.CompletionRate.ToString("0")}%,";
                csvContent += $"{stats.AverageProgress.ToString("0")}%\n";
            }

            var fileName = $"analytics-export-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
            var bytes = System.Text.Encoding.UTF8.GetBytes(csvContent);
            var fileContent = Convert.ToBase64String(bytes);
            
            await JS.InvokeVoidAsync("downloadFile", fileName, "data:text/csv;base64," + fileContent);
            
            await ShowToast("success", "Analytics exported successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Export failed: {ex.Message}");
            await ShowToast("error", $"Export failed: {ex.Message}");
        }
    }

