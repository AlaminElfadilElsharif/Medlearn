@page "/doctor/analytics"


<PageTitle>Doctor Analytics</PageTitle>

<div class="doctor-analytics">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none mb-3">
            <div class="bg-primary text-white p-3 rounded-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <div class="flex-grow-1">
                        <h5 class="mb-0">Content Analytics</h5>
                        <small class="opacity-75">Deep insights into your content</small>
                    </div>
                    <button class="btn btn-link text-white p-0 ms-2" @onclick="RefreshAnalytics">
                        <i class="fas fa-sync-alt fa-lg"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>Content Analytics</h1>
                <p class="text-muted">Deep insights into your content performance</p>
            </div>
            <div>
                <button class="btn btn-primary" @onclick="RefreshAnalytics">
                    <i class="fas fa-sync me-2"></i> Refresh Data
                </button>
                <button class="btn btn-outline-secondary ms-2" @onclick="ExportAnalytics">
                    <i class="fas fa-download me-2"></i> Export Analytics
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading analytics...</p>
            </div>
        }
        else if (hasError)
        {
            <div class="alert alert-danger m-3 m-md-0">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
                <button class="btn btn-sm btn-outline-danger ms-3" @onclick="LoadAnalyticsData">
                    <i class="fas fa-redo me-1"></i> Retry
                </button>
            </div>
        }
        else
        {
            <!-- Mobile Overview Cards (Horizontal Scroll) -->
            <div class="d-block d-md-none mb-3">
                <div class="overflow-auto" style="white-space: nowrap; -webkit-overflow-scrolling: touch;">
                    <div class="d-flex px-3" style="gap: 12px;">
                        <!-- Total Content Card -->
                        <div class="card stat-card-mobile flex-shrink-0" style="width: 160px;">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="stat-icon-mobile bg-primary bg-opacity-10 me-2">
                                        <i class="fas fa-book text-primary"></i>
                                    </div>
                                    <small class="text-muted">Content</small>
                                </div>
                                <h4 class="mb-0 fw-bold">@totalContent</h4>
                                <small class="text-muted">@specializationsCount specs</small>
                            </div>
                        </div>

                        <!-- Total Students Card -->
                        <div class="card stat-card-mobile flex-shrink-0" style="width: 160px;">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="stat-icon-mobile bg-success bg-opacity-10 me-2">
                                        <i class="fas fa-users text-success"></i>
                                    </div>
                                    <small class="text-muted">Students</small>
                                </div>
                                <h4 class="mb-0 fw-bold">@totalStudents</h4>
                                <small class="text-success">+@newStudents new</small>
                            </div>
                        </div>

                        <!-- Average Rating Card -->
                        <div class="card stat-card-mobile flex-shrink-0" style="width: 160px;">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="stat-icon-mobile bg-warning bg-opacity-10 me-2">
                                        <i class="fas fa-star text-warning"></i>
                                    </div>
                                    <small class="text-muted">Rating</small>
                                </div>
                                <div class="d-flex align-items-baseline">
                                    <h4 class="mb-0 fw-bold me-1">@averageRating.ToString("0.0")</h4>
                                    <small class="text-muted">/5</small>
                                </div>
                                <small class="text-muted">@totalReviews reviews</small>
                            </div>
                        </div>

                        <!-- Total Revenue Card -->
                        <div class="card stat-card-mobile flex-shrink-0" style="width: 160px;">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="stat-icon-mobile bg-info bg-opacity-10 me-2">
                                        <i class="fas fa-dollar-sign text-info"></i>
                                    </div>
                                    <small class="text-muted">Revenue</small>
                                </div>
                                <h4 class="mb-0 fw-bold">$@totalRevenue.ToString("N0")</h4>
                                <small class="text-info">@totalEnrollments enrolls</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Desktop Overview Cards -->
            <div class="row d-none d-md-flex mb-4">
                <div class="col-md-3">
                    <div class="card stat-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6 class="text-muted">Total Content</h6>
                                    <h3>@totalContent</h3>
                                    <small class="text-primary">
                                        @specializationsCount specs, @coursesCount courses, @lecturesCount lectures
                                    </small>
                                </div>
                                <div class="stat-icon">
                                    <i class="fas fa-book text-primary"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card stat-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6 class="text-muted">Total Students</h6>
                                    <h3>@totalStudents</h3>
                                    <small class="text-success">
                                        @activeStudents active • @newStudents this week
                                    </small>
                                </div>
                                <div class="stat-icon">
                                    <i class="fas fa-users text-success"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card stat-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6 class="text-muted">Avg. Rating</h6>
                                    <div class="d-flex align-items-center">
                                        <div class="rating-stars me-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(i <= Math.Round((double)averageRating) ? "text-warning" : "text-muted")"></i>
                                            }
                                        </div>
                                        <h3 class="mb-0">@averageRating.ToString("0.0")</h3>
                                    </div>
                                    <small class="text-warning">
                                        Based on @totalReviews reviews
                                    </small>
                                </div>
                                <div class="stat-icon">
                                    <i class="fas fa-star text-warning"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card stat-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6 class="text-muted">Total Revenue</h6>
                                    <h3>$@totalRevenue.ToString("N2")</h3>
                                    <small class="text-info">
                                        From @totalEnrollments enrollments
                                    </small>
                                </div>
                                <div class="stat-icon">
                                    <i class="fas fa-dollar-sign text-info"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Filters (Collapsible) -->
            <div class="d-block d-md-none mb-3">
                <div class="card">
                    <div class="card-header bg-white p-3" @onclick="() => toggleMobileFilters = !toggleMobileFilters" style="cursor: pointer;">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold">
                                <i class="fas fa-filter me-2 text-primary"></i>Filters & Sort
                            </span>
                            <i class="fas @(toggleMobileFilters ? "fa-chevron-up" : "fa-chevron-down")"></i>
                        </div>
                    </div>
                    @if (toggleMobileFilters)
                    {
                        <div class="card-body p-3">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Time Period</label>
                                <div class="btn-group w-100" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-sm @(timePeriod == "7" ? "active" : "")" @onclick='() => SetTimePeriod("7")'>7D</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm @(timePeriod == "30" ? "active" : "")" @onclick='() => SetTimePeriod("30")'>30D</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm @(timePeriod == "90" ? "active" : "")" @onclick='() => SetTimePeriod("90")'>90D</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm @(timePeriod == "365" ? "active" : "")" @onclick='() => SetTimePeriod("365")'>1Y</button>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold">Content Type</label>
                                <select class="form-select form-select-sm" @bind="contentType">
                                    <option value="">All Content</option>
                                    <option value="specialization">Specializations</option>
                                    <option value="course">Courses</option>
                                    <option value="lecture">Lectures</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold">Sort By</label>
                                <select class="form-select form-select-sm" @bind="sortBy">
                                    <option value="enrollments">Enrollments</option>
                                    <option value="revenue">Revenue</option>
                                    <option value="rating">Rating</option>
                                    <option value="completion">Completion</option>
                                </select>
                            </div>

                            <button class="btn btn-primary w-100" @onclick="ApplyFilters">
                                <i class="fas fa-check me-2"></i> Apply Filters
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Desktop Filters -->
            <div class="card d-none d-md-block mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Time Period</label>
                            <select class="form-select" @bind="timePeriod">
                                <option value="7">Last 7 Days</option>
                                <option value="30" selected>Last 30 Days</option>
                                <option value="90">Last 90 Days</option>
                                <option value="365">Last Year</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Content Type</label>
                            <select class="form-select" @bind="contentType">
                                <option value="">All Content</option>
                                <option value="specialization">Specializations</option>
                                <option value="course">Courses</option>
                                <option value="lecture">Lectures</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Sort By</label>
                            <select class="form-select" @bind="sortBy">
                                <option value="enrollments">Enrollments</option>
                                <option value="revenue">Revenue</option>
                                <option value="rating">Rating</option>
                                <option value="completion">Completion</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">&nbsp;</label>
                            <button class="btn btn-primary w-100" @onclick="ApplyFilters">
                                <i class="fas fa-filter me-2"></i> Apply Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Performance - Mobile Card View -->
            <div class="d-block d-md-none mb-4">
                <div class="card">
                    <div class="card-header bg-white p-3 d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            <i class="fas fa-trophy me-2 text-primary"></i>Content Performance
                        </h6>
                        <span class="badge bg-primary">@filteredContent.Count items</span>
                    </div>
                    <div class="list-group list-group-flush">
                        @if (filteredContent.Any())
                        {
                            @foreach (var content in filteredContent)
                            {
                                var contentStats = GetContentStatistics(content.Id, content.Type);
                                <div class="list-group-item p-3">
                                    <div class="d-flex mb-2">
                                        @if (!string.IsNullOrEmpty(content.ThumbnailUrl))
                                        {
                                            <img src="@GetImageUrl(content.ThumbnailUrl)" 
                                                 class="rounded me-2" width="48" height="48" alt="Content" style="object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded me-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                                <i class="fas @GetEnrollmentIcon(content.Type) text-muted"></i>
                                            </div>
                                        }
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h6 class="mb-1 fw-bold">@content.Title</h6>
                                                    <span class="badge @GetContentTypeBadge(content.Type) me-2">
                                                        <i class="fas @GetEnrollmentIcon(content.Type) me-1"></i>
                                                        @content.Type.ToString()
                                                    </span>
                                                    <small class="text-muted">@content.CreatedAt.ToString("MMM dd")</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Stats Grid -->
                                    <div class="row g-2 mt-2">
                                        <div class="col-4">
                                            <div class="bg-light rounded p-2 text-center">
                                                <small class="text-muted d-block">Enrollments</small>
                                                <span class="fw-bold">@contentStats.TotalEnrollments</span>
                                                @if (contentStats.EnrollmentChange > 0)
                                                {
                                                    <small class="text-success d-block">
                                                        <i class="fas fa-arrow-up"></i> @contentStats.EnrollmentChange%
                                                    </small>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="bg-light rounded p-2 text-center">
                                                <small class="text-muted d-block">Revenue</small>
                                                <span class="fw-bold">$@contentStats.TotalRevenue.ToString("N0")</span>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="bg-light rounded p-2 text-center">
                                                <small class="text-muted d-block">Rating</small>
                                                @if (contentStats.AverageRating > 0)
                                                {
                                                    <span class="fw-bold">@contentStats.AverageRating.ToString("0.0")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Progress Bars -->
                                    <div class="mt-2">
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span class="text-muted">Completion</span>
                                            <span class="fw-bold">@contentStats.CompletionRate.ToString("0")%</span>
                                        </div>
                                        <div class="progress mb-2" style="height: 6px;">
                                            <div class="progress-bar bg-info" style="width: @contentStats.CompletionRate%"></div>
                                        </div>
                                        
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span class="text-muted">Progress</span>
                                            <span class="fw-bold">@contentStats.AverageProgress.ToString("0")%</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar @(contentStats.AverageProgress >= 50 ? "bg-success" : "bg-warning")" 
                                                 style="width: @contentStats.AverageProgress%"></div>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="d-flex gap-2 mt-3">
                                        <button class="btn btn-sm btn-outline-primary flex-fill" 
                                                @onclick="() => ViewContentDetails(content.Id, content.Type)">
                                            <i class="fas fa-eye me-1"></i> Details
                                        </button>
                                        <button class="btn btn-sm btn-outline-info flex-fill" 
                                                @onclick="() => ViewEnrollmentDetails(content.Id, content.Type)">
                                            <i class="fas fa-users me-1"></i> Enrollments
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-chart-bar fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No content performance data available</p>
                            </div>
                        }
                    </div>
                    @if (filteredContent.Any())
                    {
                        <div class="card-footer bg-white p-3 text-center">
                            <button class="btn btn-link text-primary" @onclick="ViewAllContent">
                                View All Content <i class="fas fa-arrow-right ms-1"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Desktop Content Performance Table -->
            <div class="card d-none d-md-block mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-trophy me-2"></i> Content Performance
                    </h5>
                    <div>
                        <span class="me-2">Showing @filteredContent.Count items</span>
                        <button class="btn btn-sm btn-outline-primary" @onclick="ViewAllContent">
                            View All
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (filteredContent.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Content</th>
                                        <th>Type</th>
                                        <th>Enrollments</th>
                                        <th>Revenue</th>
                                        <th>Avg. Rating</th>
                                        <th>Completion</th>
                                        <th>Avg Progress</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var content in filteredContent)
                                    {
                                        var contentStats = GetContentStatistics(content.Id, content.Type);
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(content.ThumbnailUrl))
                                                    {
                                                        <img src="@GetImageUrl(content.ThumbnailUrl)" 
                                                             class="rounded me-2" width="40" height="40" alt="Content" style="object-fit: cover;" />
                                                    }
                                                    <div>
                                                        <strong>@content.Title</strong>
                                                        <br/>
                                                        <small class="text-muted">
                                                            Created: @content.CreatedAt.ToString("MMM dd, yyyy")
                                                        </small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @GetContentTypeBadge(content.Type)">
                                                    <i class="fas @GetEnrollmentIcon(content.Type) me-1"></i>
                                                    @content.Type.ToString()
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <span class="fw-bold me-2">@contentStats.TotalEnrollments</span>
                                                    @if (contentStats.EnrollmentChange > 0)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="fas fa-arrow-up"></i> @contentStats.EnrollmentChange%
                                                        </span>
                                                    }
                                                    else if (contentStats.EnrollmentChange < 0)
                                                    {
                                                        <span class="badge bg-danger">
                                                            <i class="fas fa-arrow-down"></i> @Math.Abs(contentStats.EnrollmentChange)%
                                                        </span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <strong>$@contentStats.TotalRevenue.ToString("N2")</strong>
                                            </td>
                                            <td>
                                                @if (contentStats.AverageRating > 0)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <div class="rating-stars me-2">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i class="fas fa-star @(i <= Math.Round((double)contentStats.AverageRating) ? "text-warning" : "text-muted")"></i>
                                                            }
                                                        </div>
                                                        <span>@contentStats.AverageRating.ToString("0.0")</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No ratings</span>
                                                }
                                            </td>
                                            <td>
                                                @if (contentStats.TotalEnrollments > 0)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                                            <div class="progress-bar bg-info" role="progressbar" 
                                                                 style="width: @contentStats.CompletionRate%"></div>
                                                        </div>
                                                        <span>@contentStats.CompletionRate.ToString("0")%</span>
                                                        <small class="text-muted ms-1">
                                                            (@contentStats.CompletedEnrollments of @contentStats.TotalEnrollments)
                                                        </small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No enrollments</span>
                                                }
                                            </td>
                                            <td>
                                                @if (contentStats.TotalEnrollments > 0)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                                            <div class="progress-bar @(contentStats.AverageProgress >= 50 ? "bg-success" : "bg-warning")" 
                                                                 role="progressbar" style="width: @contentStats.AverageProgress%"></div>
                                                        </div>
                                                        <span>@contentStats.AverageProgress.ToString("0")%</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group">
                                                    <button class="btn btn-sm btn-outline-primary" 
                                                            @onclick="() => ViewContentDetails(content.Id, content.Type)"
                                                            title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-info ms-1" 
                                                            @onclick="() => ViewEnrollmentDetails(content.Id, content.Type)"
                                                            title="View Enrollments">
                                                        <i class="fas fa-users"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-chart-bar fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No content performance data available</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Mobile Student Insights -->
            <div class="d-block d-md-none mb-4">
                <div class="card">
                    <div class="card-header bg-white p-3">
                        <h6 class="mb-0 fw-bold">
                            <i class="fas fa-user-graduate me-2 text-primary"></i>Student Insights
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <!-- Student Stats -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="bg-light rounded p-3 text-center">
                                    <h5 class="mb-0 text-primary">@totalStudents</h5>
                                    <small class="text-muted">Total Students</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-light rounded p-3 text-center">
                                    <h5 class="mb-0 text-success">@activeStudents</h5>
                                    <small class="text-muted">Active</small>
                                </div>
                            </div>
                        </div>

                        <!-- Demographics -->
                        <h6 class="fw-bold mb-2">Distribution</h6>
                        @foreach (var demo in studentDemographics.Take(3))
                        {
                            <div class="mb-2">
