                                            </td>
                                            <td>
                                                <span class="badge @GetEnrollmentTypeBadge(payment.EnrollmentType)">
                                                    @payment.EnrollmentType.ToString()
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="fw-bold @(payment.Status == PaymentStatus.Approved ? "text-success" : "text-muted")">
                                                    $@payment.Amount.ToString("N2")
                                                </div>
                                                @if (payment.Status == PaymentStatus.Approved)
                                                {
                                                    <div class="mt-1">
                                                        <small class="text-success">
                                                            <i class="fas fa-user-md me-1"></i>
