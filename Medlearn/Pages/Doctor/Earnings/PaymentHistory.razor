@code {
    // ... (keep all your existing code in the @code block exactly as is from your original file)
    private List<PaymentRequestDto> allPayments = new();
    private List<PaymentRequestDto> filteredPayments = new();
    private List<PaymentRequestDto> pagedPayments = new();
    private string searchTerm = "";
    private string statusFilter = "";
    private string contentTypeFilter = "";
    private DateTime? dateFromFilter;
    private DateTime? dateToFilter;
    private int totalPayments = 0;
    private decimal totalAmount = 0;
    private decimal approvedAmount = 0;
    private decimal pendingAmount = 0;
    private decimal doctorShare = 0;
    private int approvedCount = 0;
    private int pendingCount = 0;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private int startPage = 1;
    private int endPage = 1;
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private bool isDoctor = false;
    private int doctorId = 0;
    private string sortField = "CreatedAt";
    private bool sortDescending = true;
    private Timer? refreshTimer;
    private UserDto? currentUser = null;
    private bool showMobileFilters = false;

    private bool HasActiveFilters => 
        !string.IsNullOrEmpty(searchTerm) || 
        !string.IsNullOrEmpty(statusFilter) || 
        !string.IsNullOrEmpty(contentTypeFilter) || 
        dateFromFilter.HasValue || 
        dateToFilter.HasValue;

    private int GetActiveFilterCount()
    {
        int count = 0;
        if (!string.IsNullOrEmpty(searchTerm)) count++;
        if (!string.IsNullOrEmpty(statusFilter)) count++;
        if (!string.IsNullOrEmpty(contentTypeFilter)) count++;
        if (dateFromFilter.HasValue || dateToFilter.HasValue) count++;
        return count;
    }

    private string GetSortDisplayText()
    {
        return sortField switch
        {
            "Amount" => "Amount",
            "InvoiceNumber" => "Invoice #",
            "Status" => "Status",
            _ => "Date"
        };
    }

    private void SetSortField(string field)
    {
        sortField = field;
        ApplyFilters();
        StateHasChanged();
    }

    private void ToggleMobileFilters()
    {
        showMobileFilters = !showMobileFilters;
    }

    private void SetStatusFilter(string status)
    {
        statusFilter = status;
        SearchPayments();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/doctor/earnings");
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
        
        if (isAuthenticated && isDoctor)
        {
            await LoadPaymentHistory();
            
            // Start auto-refresh every 30 seconds
            refreshTimer = new Timer(async _ => await RefreshData(), null, 30000, 30000);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && isAuthenticated && isDoctor)
        {
            await JS.InvokeVoidAsync("eval", @"
                setTimeout(function() {
                    const searchInput = document.querySelector('input[placeholder*=""Search invoice""]');
                    if (searchInput) {
                        searchInput.focus();
                    }
                }, 100);
            ");
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();
            
            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();
                isDoctor = currentUser?.UserType == UserType.Doctor;
                
                if (isDoctor)
                {
                    doctorId = currentUser.Id;
                }
                else
                {
                    await Task.Delay(1000);
                    Navigation.NavigateTo("/");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            isDoctor = false;
            currentUser = null;
        }
    }

    private async Task LoadPaymentHistory()
    {
        if (!isAuthenticated || !isDoctor)
            return;

        isLoading = true;
        StateHasChanged();

        try
        {
            var token = await TokenService.GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                isAuthenticated = false;
                Navigation.NavigateTo("/account/login", true);
                return;
            }

            var payments = await PaymentService.GetMyPaymentRequestsAsync();
            if (payments != null)
            {
                allPayments = payments;
                await FilterDoctorContent();
                ApplyFilters();
                CalculateStats();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading payment history: {ex.Message}");
            await ShowErrorToast("Failed to load payment history");
            
            if (ex.Message.Contains("401") || ex.Message.Contains("Unauthorized"))
            {
                isAuthenticated = false;
                Navigation.NavigateTo("/account/login", true);
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task FilterDoctorContent()
    {
        var doctorContentPayments = new List<PaymentRequestDto>();
        
        foreach (var payment in allPayments)
        {
            try
            {
                bool isDoctorContent = false;
                
                if (payment.SpecializationId.HasValue)
                {
                    var specialization = await SpecializationService.GetSpecializationAsync(payment.SpecializationId.Value);
                    isDoctorContent = specialization?.DoctorId == doctorId;
                }
                else if (payment.CourseId.HasValue)
                {
                    var course = await CourseService.GetCourseAsync(payment.CourseId.Value);
                    isDoctorContent = course?.DoctorId == doctorId;
                }
                else if (payment.LectureId.HasValue)
                {
                    var lecture = await LectureService.GetLectureAsync(payment.LectureId.Value);
                    isDoctorContent = lecture?.DoctorId == doctorId;
                }
                
                if (isDoctorContent)
                {
                    doctorContentPayments.Add(payment);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking payment {payment.Id}: {ex.Message}");
            }
        }
        
        allPayments = doctorContentPayments;
    }

    private void CalculateStats()
    {
        totalPayments = allPayments.Count;
        totalAmount = allPayments.Sum(p => p.Amount);
        doctorShare = totalAmount * 0.8m;
        
        approvedCount = allPayments.Count(p => p.Status == PaymentStatus.Approved);
        approvedAmount = allPayments.Where(p => p.Status == PaymentStatus.Approved).Sum(p => p.Amount);
        
        pendingCount = allPayments.Count(p => p.Status == PaymentStatus.Pending);
        pendingAmount = allPayments.Where(p => p.Status == PaymentStatus.Pending).Sum(p => p.Amount);
    }

    private void ApplyFilters()
    {
        var filtered = allPayments.AsEnumerable();

        // Apply search filter
        if (!string.IsNullOrEmpty(searchTerm))
        {
            var search = searchTerm.ToLower();
            filtered = filtered.Where(p =>
                (!string.IsNullOrEmpty(p.InvoiceNumber) && p.InvoiceNumber.ToLower().Contains(search)) ||
                (p.User != null && 
                 ((!string.IsNullOrEmpty(p.User.FirstName) && !string.IsNullOrEmpty(p.User.LastName) && 
                   (p.User.FirstName + " " + p.User.LastName).ToLower().Contains(search)) ||
                  (!string.IsNullOrEmpty(p.User.Email) && p.User.Email.ToLower().Contains(search)))) ||
                (p.Specialization != null && !string.IsNullOrEmpty(p.Specialization.Title) && 
                 p.Specialization.Title.ToLower().Contains(search)) ||
                (p.Course != null && !string.IsNullOrEmpty(p.Course.Title) && 
                 p.Course.Title.ToLower().Contains(search)) ||
                (p.Lecture != null && !string.IsNullOrEmpty(p.Lecture.Title) && 
                 p.Lecture.Title.ToLower().Contains(search))
            );
        }

        // Apply status filter
        if (!string.IsNullOrEmpty(statusFilter) && int.TryParse(statusFilter, out int statusValue))
        {
            filtered = filtered.Where(p => (int)p.Status == statusValue);
        }

        // Apply content type filter
        if (!string.IsNullOrEmpty(contentTypeFilter) && int.TryParse(contentTypeFilter, out int contentTypeValue))
        {
            filtered = filtered.Where(p => (int)p.EnrollmentType == contentTypeValue);
        }

        // Apply date filters
        if (dateFromFilter.HasValue)
        {
            filtered = filtered.Where(p => p.CreatedAt.Date >= dateFromFilter.Value.Date);
        }
        
        if (dateToFilter.HasValue)
        {
            filtered = filtered.Where(p => p.CreatedAt.Date <= dateToFilter.Value.Date);
        }

        // Apply sorting
        filtered = sortField switch
        {
            "Amount" => sortDescending ? 
                filtered.OrderByDescending(p => p.Amount) : 
                filtered.OrderBy(p => p.Amount),
            "InvoiceNumber" => sortDescending ? 
                filtered.OrderByDescending(p => p.InvoiceNumber) : 
                filtered.OrderBy(p => p.InvoiceNumber),
            "Status" => sortDescending ? 
                filtered.OrderByDescending(p => p.Status) : 
                filtered.OrderBy(p => p.Status),
            _ => sortDescending ? 
                filtered.OrderByDescending(p => p.CreatedAt) : 
                filtered.OrderBy(p => p.CreatedAt)
        };

        filteredPayments = filtered.ToList();
        
        // Calculate pagination
        totalPages = (int)Math.Ceiling((double)filteredPayments.Count / pageSize);
        currentPage = Math.Max(1, Math.Min(currentPage, totalPages));
        
        // Calculate page range for pagination display
        const int maxPagesToShow = 5;
        startPage = Math.Max(1, currentPage - maxPagesToShow / 2);
        endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);
        
        if (endPage - startPage + 1 < maxPagesToShow)
        {
            startPage = Math.Max(1, endPage - maxPagesToShow + 1);
        }

        // Get paged data
        pagedPayments = filteredPayments
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private async Task SearchPayments()
    {
        if (isLoading) return;
        
        currentPage = 1;
        ApplyFilters();
        await InvokeAsync(StateHasChanged);
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages && page != currentPage)
        {
            currentPage = page;
            ApplyFilters();
            StateHasChanged();
        }
    }

    private void ToggleSortDirection()
    {
        sortDescending = !sortDescending;
        ApplyFilters();
        StateHasChanged();
    }

    private void ClearAllFilters()
    {
        searchTerm = "";
        statusFilter = "";
        contentTypeFilter = "";
        dateFromFilter = null;
        dateToFilter = null;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void ClearSearchTerm()
    {
        searchTerm = "";
        SearchPayments();
    }

    private void ClearStatusFilter()
    {
        statusFilter = "";
        SearchPayments();
    }

    private void ClearContentTypeFilter()
    {
        contentTypeFilter = "";
        SearchPayments();
    }

    private void ClearDateFilters()
    {
        dateFromFilter = null;
        dateToFilter = null;
        SearchPayments();
    }

    private string GetStatusDisplayText()
    {
        if (Enum.TryParse<PaymentStatus>(statusFilter, out var status))
        {
            return status.ToString();
        }
        return "Unknown";
    }

    private string GetContentTypeDisplayText()
    {
        if (Enum.TryParse<EnrollmentType>(contentTypeFilter, out var contentType))
        {
            return contentType.ToString();
        }
        return "Unknown";
    }

    private string GetPaymentStatusBadge(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Approved => "bg-success",
            PaymentStatus.Pending => "bg-warning",
            PaymentStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetEnrollmentTypeBadge(EnrollmentType type)
    {
        return type switch
        {
            EnrollmentType.Lecture => "bg-info",
            EnrollmentType.Course => "bg-primary",
            EnrollmentType.Specialization => "bg-success",
            _ => "bg-secondary"
        };
    }

    private async Task ExportHistory()
    {
        try
        {
            if (!isAuthenticated || !isDoctor)
            {
                await ShowErrorToast("Authentication required");
                return;
            }

            var csvContent = new System.Text.StringBuilder();
            
            // Add headers
            csvContent.AppendLine("Date,Invoice Number,Student Name,Student Email,Content Type,Content Title,Amount,Status,Doctor's Share,Platform Fee");
            
            // Add data rows
            foreach (var payment in filteredPayments)
            {
                var studentName = $"{payment.User?.FirstName} {payment.User?.LastName}";
                var studentEmail = payment.User?.Email ?? "";
                var contentType = payment.EnrollmentType.ToString();
                var contentTitle = payment.Specialization?.Title ?? payment.Course?.Title ?? payment.Lecture?.Title ?? "";
                var doctorShareAmount = payment.Status == PaymentStatus.Approved ? payment.Amount * 0.8m : 0;
                var platformFee = payment.Status == PaymentStatus.Approved ? payment.Amount * 0.2m : 0;
                
                csvContent.AppendLine($"\"{payment.CreatedAt:yyyy-MM-dd HH:mm}\",\"{payment.InvoiceNumber}\",\"{studentName}\",\"{studentEmail}\",\"{contentType}\",\"{contentTitle}\",\"{payment.Amount:N2}\",\"{payment.Status}\",\"{doctorShareAmount:N2}\",\"{platformFee:N2}\"");
            }
            
            var fileName = $"payment_history_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            
            await JS.InvokeVoidAsync("downloadFile", csvContent.ToString(), fileName, "text/csv");
            
            await ShowSuccessToast("Payment history exported successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting payment history: {ex.Message}");
            await ShowErrorToast("Failed to export payment history");
        }
    }

    private async Task DownloadInvoice(string invoiceUrl)
    {
        try
        {
            if (!isAuthenticated)
            {
                await ShowErrorToast("Authentication required");
                return;
            }

            await JS.InvokeVoidAsync("open", invoiceUrl, "_blank");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading invoice: {ex.Message}");
            await ShowErrorToast("Failed to download invoice");
        }
    }

    private void ViewContent(PaymentRequestDto payment)
    {
        if (payment.Specialization != null)
        {
            Navigation.NavigateTo($"/content/specializations/{payment.Specialization.Id}");
        }
        else if (payment.Course != null)
        {
            Navigation.NavigateTo($"/content/courses/{payment.Course.Id}");
        }
        else if (payment.Lecture != null)
        {
            Navigation.NavigateTo($"/content/lectures/{payment.Lecture.Id}");
        }
    }

    private async Task RefreshData()
    {
        if (!isAuthenticated || !isDoctor || isLoading) return;
        
        await InvokeAsync(async () =>
        {
            try
            {
                await LoadPaymentHistory();
                await ShowSuccessToast("Payment history refreshed");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error refreshing data: {ex.Message}");
            }
        });
    }

    private async Task ShowSuccessToast(string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", message, "success");
        }
        catch
        {
            Console.WriteLine($"SUCCESS: {message}");
        }
    }

    private async Task ShowErrorToast(string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", message, "error");
        }
        catch
        {
            Console.WriteLine($"ERROR: {message}");
        }
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}