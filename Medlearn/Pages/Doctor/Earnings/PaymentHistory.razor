@page "/doctor/earnings/history"


<PageTitle>Payment History</PageTitle>

@if (!isAuthenticated)
{
    <div class="container py-5">
        <div class="text-center">
            <i class="fas fa-lock fa-3x text-muted mb-3"></i>
            <h4>Authentication Required</h4>
            <p class="text-muted">Please log in to view your payment history.</p>
            <a href="/account/login" class="btn btn-primary mt-2">
                <i class="fas fa-sign-in-alt me-2"></i> Login
            </a>
        </div>
    </div>
}
else if (!isDoctor)
{
    <div class="container py-5">
        <div class="text-center">
            <i class="fas fa-user-md-slash fa-3x text-muted mb-3"></i>
            <h4>Access Denied</h4>
            <p class="text-muted">This page is only accessible to doctors.</p>
            <a href="/" class="btn btn-primary mt-2">
                <i class="fas fa-home me-2"></i> Go Home
            </a>
        </div>
    </div>
}
else
{
    <div class="payment-history">
        <div class="container-fluid px-0 px-md-3">
            <!-- Header - Responsive -->
            <div class="row g-0 mb-3 mb-md-4">
                <div class="col-12">
                    <!-- Mobile Header -->
                    <div class="d-block d-md-none">
                        <div class="bg-primary text-white p-3">
                            <div class="d-flex align-items-center">
                                <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                                    <i class="fas fa-arrow-left fa-lg"></i>
                                </button>
                                <h5 class="mb-0 flex-grow-1">Payment History</h5>
                                <button class="btn btn-link text-white p-0 me-2" @onclick="RefreshData" disabled="@isLoading">
                                    <i class="fas fa-sync-alt @(isLoading ? "fa-spin" : "")"></i>
                                </button>
                                <button class="btn btn-link text-white p-0" @onclick="ExportHistory" disabled="@(!filteredPayments.Any())">
                                    <i class="fas fa-file-export"></i>
                                </button>
                            </div>
                        </div>
                        <!-- Mobile Breadcrumb -->
                        <div class="bg-light p-2 small">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0">
                                    <li class="breadcrumb-item">
                                        <a href="/doctor" class="text-decoration-none">Doctor</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="/doctor/earnings" class="text-decoration-none">Earnings</a>
                                    </li>
                                    <li class="breadcrumb-item active" aria-current="page">History</li>
                                </ol>
                            </nav>
                        </div>
                    </div>

                    <!-- Desktop Header -->
                    <div class="d-none d-md-block">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h1>Payment History</h1>
                                <nav aria-label="breadcrumb">
                                    <ol class="breadcrumb">
                                        <li class="breadcrumb-item">
                                            <a href="/doctor">Doctor</a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="/doctor/earnings">Earnings</a>
                                        </li>
                                        <li class="breadcrumb-item active" aria-current="page">Payment History</li>
                                    </ol>
                                </nav>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-secondary" @onclick="RefreshData" disabled="@isLoading">
                                    <i class="fas fa-sync-alt me-2 @(isLoading ? "fa-spin" : "")"></i> Refresh
                                </button>
                                <button class="btn btn-outline-primary" @onclick="ExportHistory" disabled="@(!filteredPayments.Any())">
                                    <i class="fas fa-file-export me-2"></i> Export
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Stats Cards (Horizontal Scroll) -->
            <div class="d-block d-md-none mb-3">
                <div class="stats-scroll horizontal-scroll">
                    <div class="d-flex gap-2 px-3">
                        <div class="stat-card-mini flex-shrink-0">
                            <div class="card">
                                <div class="card-body p-3">
                                    <small class="text-muted d-block">Total</small>
                                    <h5 class="mb-0">@totalPayments</h5>
                                    <small class="text-success">$@totalAmount.ToString("N0")</small>
                                </div>
                            </div>
                        </div>
                        <div class="stat-card-mini flex-shrink-0">
                            <div class="card">
                                <div class="card-body p-3">
                                    <small class="text-muted d-block">Your Share</small>
                                    <h5 class="mb-0">$@doctorShare.ToString("N0")</h5>
                                    <small class="text-success">80%</small>
                                </div>
                            </div>
                        </div>
                        <div class="stat-card-mini flex-shrink-0">
                            <div class="card">
                                <div class="card-body p-3">
                                    <small class="text-muted d-block">Approved</small>
                                    <h5 class="mb-0 text-success">$@approvedAmount.ToString("N0")</h5>
                                    <small>@approvedCount payments</small>
                                </div>
                            </div>
                        </div>
                        <div class="stat-card-mini flex-shrink-0">
                            <div class="card">
                                <div class="card-body p-3">
                                    <small class="text-muted d-block">Pending</small>
                                    <h5 class="mb-0 text-warning">$@pendingAmount.ToString("N0")</h5>
                                    <small>@pendingCount payments</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Desktop Stats Cards -->
            <div class="d-none d-md-block">
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card stat-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted">Total Payments</h6>
                                        <h3>@totalPayments</h3>
                                        <small class="text-muted">Showing @pagedPayments.Count</small>
                                    </div>
                                    <i class="fas fa-receipt fa-2x text-primary"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted">Total Amount</h6>
                                        <h3>$@totalAmount.ToString("N2")</h3>
                                        <small class="text-muted">Doctor's share: $@doctorShare.ToString("N2")</small>
                                    </div>
                                    <i class="fas fa-dollar-sign fa-2x text-success"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted">Approved</h6>
                                        <h3 class="text-success">$@approvedAmount.ToString("N2")</h3>
                                        <small class="text-success">@approvedCount payments</small>
                                    </div>
                                    <i class="fas fa-check-circle fa-2x text-success"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted">Pending</h6>
                                        <h3 class="text-warning">$@pendingAmount.ToString("N2")</h3>
                                        <small class="text-warning">@pendingCount payments</small>
                                    </div>
                                    <i class="fas fa-clock fa-2x text-warning"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filters - Mobile (Collapsible) -->
            <div class="d-block d-md-none mb-3">
                <div class="card">
                    <div class="card-header p-3" @onclick="ToggleMobileFilters">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <i class="fas fa-filter me-2 text-primary"></i>Filters
                                @if (HasActiveFilters)
                                {
                                    <span class="badge bg-primary ms-2">@GetActiveFilterCount()</span>
                                }
                            </h6>
                            <i class="fas fa-chevron-down @(showMobileFilters ? "rotate-180" : "")"></i>
                        </div>
                    </div>
                    @if (showMobileFilters)
                    {
                        <div class="card-body">
                            <!-- Mobile Search -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Search</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    <input type="text" class="form-control" placeholder="Search payments..." 
                                           @bind="searchTerm" @bind:event="oninput" />
                                    <button class="btn btn-primary" @onclick="SearchPayments" disabled="@isLoading">
                                        <i class="fas fa-arrow-right"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Mobile Status Filter -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Status</label>
                                <div class="d-flex flex-wrap gap-2">
                                    <button class="btn btn-sm @(string.IsNullOrEmpty(statusFilter) ? "btn-primary" : "btn-outline-secondary")" 
                                            @onclick='() => SetStatusFilter("")'>
                                        All
                                    </button>
                                    <button class="btn btn-sm @(statusFilter == "0" ? "btn-warning" : "btn-outline-warning")" 
                                            @onclick='() => SetStatusFilter(" 0")'>
                                        Pending
                                    </button>
                                    <button class="btn btn-sm @(statusFilter == "1" ? "btn-success" : "btn-outline-success")" 
                                            @onclick='() => SetStatusFilter("1")'>
                                        Approved
                                    </button>
                                    <button class="btn btn-sm @(statusFilter == "2" ? "btn-danger" : "btn-outline-danger")" 
                                            @onclick='() => SetStatusFilter(" 2")'>
                                        Rejected
                                    </button>
                                </div>
                            </div>

                            <!-- Mobile Content Type Filter -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Content Type</label>
                                <select class="form-select" @bind="contentTypeFilter" @bind:event="onchange" disabled="@isLoading">
                                    <option value="">All Content</option>
                                    <option value="0">Lecture</option>
                                    <option value="1">Course</option>
                                    <option value="2">Specialization</option>
                                </select>
                            </div>

                            <!-- Mobile Date Range -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Date Range</label>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <input type="date" class="form-control" placeholder="From" 
                                               @bind="dateFromFilter" @bind:format="yyyy-MM-dd" />
                                    </div>
                                    <div class="col-6">
                                        <input type="date" class="form-control" placeholder="To" 
                                               @bind="dateToFilter" @bind:format="yyyy-MM-dd" />
                                    </div>
                                </div>
                            </div>

                            <!-- Mobile Filter Actions -->
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-secondary flex-fill" @onclick="ClearAllFilters">
                                    Clear All
                                </button>
                                <button class="btn btn-primary flex-fill" @onclick="SearchPayments">
                                    Apply Filters
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Desktop Filters -->
            <div class="d-none d-md-block card mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" class="form-control" placeholder="Search invoice, student, content..." 
                                       @bind="searchTerm" @bind:event="oninput" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="SearchPayments" 
                                        disabled="@isLoading">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <select class="form-select" @bind="statusFilter" @bind:event="onchange" disabled="@isLoading">
                                <option value="">All Status</option>
                                <option value="0">Pending</option>
                                <option value="1">Approved</option>
                                <option value="2">Rejected</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select class="form-select" @bind="contentTypeFilter" @bind:event="onchange" disabled="@isLoading">
                                <option value="">All Content</option>
                                <option value="0">Lecture</option>
                                <option value="1">Course</option>
                                <option value="2">Specialization</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <div class="input-group">
                                <input type="date" class="form-control" @bind="dateFromFilter" 
                                       @bind:format="yyyy-MM-dd" @bind:event="onchange" />
                                <span class="input-group-text">to</span>
                                <input type="date" class="form-control" @bind="dateToFilter" 
                                       @bind:format="yyyy-MM-dd" @bind:event="onchange" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <select class="form-select" @bind="pageSize" @bind:event="onchange">
                                <option value="10">10 per page</option>
                                <option value="20">20 per page</option>
                                <option value="50">50 per page</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- Active Filters (Desktop) -->
                    @if (HasActiveFilters)
                    {
                        <div class="mt-3">
                            <div class="d-flex flex-wrap gap-2">
                                @if (!string.IsNullOrEmpty(searchTerm))
                                {
                                    <span class="badge bg-light text-dark">
                                        Search: "@searchTerm"
                                        <button type="button" class="btn-close ms-1" style="font-size: 0.75rem;" 
                                                @onclick="ClearSearchTerm"></button>
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(statusFilter))
                                {
                                    <span class="badge bg-light text-dark">
                                        Status: @GetStatusDisplayText()
                                        <button type="button" class="btn-close ms-1" style="font-size: 0.75rem;"
                                                @onclick="ClearStatusFilter"></button>
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(contentTypeFilter))
                                {
                                    <span class="badge bg-light text-dark">
                                        Type: @GetContentTypeDisplayText()
                                        <button type="button" class="btn-close ms-1" style="font-size: 0.75rem;"
                                                @onclick="ClearContentTypeFilter"></button>
                                    </span>
                                }
                                @if (dateFromFilter.HasValue || dateToFilter.HasValue)
                                {
                                    <span class="badge bg-light text-dark">
                                        Date: @(dateFromFilter?.ToString("MMM d, yyyy") ?? "Start") - @(dateToFilter?.ToString("MMM d, yyyy") ?? "End")
                                        <button type="button" class="btn-close ms-1" style="font-size: 0.75rem;"
                                                @onclick="ClearDateFilters"></button>
                                    </span>
                                }
                                @if (HasActiveFilters)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="ClearAllFilters">
                                        <i class="fas fa-times me-1"></i> Clear All
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Mobile Sort & Info Bar -->
            <div class="d-block d-md-none mb-3">
                <div class="d-flex justify-content-between align-items-center px-3">
                    <small class="text-muted">@filteredPayments.Count payments found</small>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small">Sort by:</span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" 
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                @GetSortDisplayText()
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                                            <li>
                                    <a class="dropdown-item @(sortField == "CreatedAt" ? "active" : "")" href="#" @onclick='() => SetSortField("CreatedAt")'>Date</a>
                                </li>
                                <li><a class="dropdown-item @(sortField == "Amount" ? "active" : "")" href="#" @onclick='() => SetSortField(" Amount")'>Amount</a></li>
                                <li><a class="dropdown-item @(sortField == "InvoiceNumber" ? "active" : "")" href="#" @onclick='() => SetSortField(" InvoiceNumber")'>Invoice #</a></li>
                                <li><a class="dropdown-item @(sortField == "Status" ? "active" : "")" href="#" @onclick='() => SetSortField(" Status")'>Status</a></li>
                            </ul>
                            <button class="btn btn-outline-secondary" @onclick="ToggleSortDirection">
                                <i class="fas @(sortDescending ? "fa-sort-amount-down" : "fa-sort-amount-up")"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Desktop Sort Bar -->
            <div class="d-none d-md-block">
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">Payment History</h5>
                            <small class="text-muted">@filteredPayments.Count payments found</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="input-group input-group-sm" style="width: 200px;">
                                <span class="input-group-text">
                                    <i class="fas fa-filter"></i>
                                </span>
                                <select class="form-select form-select-sm" @bind="sortField" @bind:event="onchange">
                                    <option value="CreatedAt">Date</option>
                                    <option value="Amount">Amount</option>
                                    <option value="InvoiceNumber">Invoice #</option>
                                    <option value="Status">Status</option>
                                </select>
                                <button class="btn btn-outline-secondary" type="button" @onclick="ToggleSortDirection">
                                    <i class="fas @(sortDescending ? "fa-sort-amount-down" : "fa-sort-amount-up")"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment List/Cards -->
            <div class="card">
                <div class="card-body p-0">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading payment history...</p>
                        </div>
                    }
                    else if (!filteredPayments.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                            <h5>No payment history found</h5>
                            <p class="text-muted">@(HasActiveFilters ? "Try adjusting your filters" : "You haven't received any payments yet")</p>
                            @if (!HasActiveFilters)
                            {
                                <a href="/doctor/specializations" class="btn btn-primary mt-2">
                                    <i class="fas fa-plus me-2"></i> Create Content
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Mobile Cards View -->
                        <div class="d-block d-md-none">
                            <div class="payment-cards p-3">
                                @foreach (var payment in pagedPayments)
                                {
                                    <div class="card mb-3 payment-card">
                                        <div class="card-body">
                                            <!-- Header with Status and Amount -->
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <span class="badge @GetPaymentStatusBadge(payment.Status) mb-2">
                                                        @payment.Status
                                                    </span>
                                                    <div class="small text-muted">
                                                        <i class="fas fa-calendar me-1"></i>@payment.CreatedAt.ToString("MMM dd, yyyy")
                                                    </div>
                                                </div>
                                                <div class="text-end">
                                                    <h5 class="mb-0 @(payment.Status == PaymentStatus.Approved ? "text-success" : "text-muted")">
                                                        $@payment.Amount.ToString("N2")
                                                    </h5>
                                                    @if (payment.Status == PaymentStatus.Approved)
                                                    {
                                                        <small class="text-success d-block">
                                                            Your share: $@((payment.Amount * 0.8m).ToString("N2"))
                                                        </small>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Invoice Number -->
                                            <div class="mb-2">
                                                <small class="text-muted">Invoice:</small>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="font-monospace small">@payment.InvoiceNumber</span>
                                                    @if (!string.IsNullOrEmpty(payment.InvoicePdfUrl))
                                                    {
                                                        <button class="btn btn-link btn-sm p-0 text-decoration-none" 
                                                                @onclick="async () => await DownloadInvoice(payment.InvoicePdfUrl)">
                                                            <i class="fas fa-file-pdf text-danger me-1"></i>PDF
                                                        </button>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Student Info -->
                                            <div class="mb-2">
                                                <small class="text-muted">Student:</small>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-sm me-2">
                                                        @if (!string.IsNullOrEmpty(payment.User?.ProfileImageUrl))
                                                        {
                                                            <img src="@payment.User.ProfileImageUrl" 
                                                                 class="rounded-circle" 
                                                                 width="32" height="32" 
                                                                 alt="Student" />
                                                        }
                                                        else
                                                        {
                                                            <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                                                 style="width: 32px; height: 32px; font-size: 12px;">
                                                                @payment.User?.FirstName?[0]@payment.User?.LastName?[0]
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <div class="fw-medium">@($"{payment.User?.FirstName} {payment.User?.LastName}")</div>
                                                        <small class="text-muted">@payment.User?.Email</small>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Content Info -->
                                            <div class="mb-2">
                                                <small class="text-muted">Content:</small>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <div class="fw-medium">
                                                            @if (payment.Specialization != null)
                                                            {
                                                                @payment.Specialization.Title
                                                            }
                                                            else if (payment.Course != null)
                                                            {
                                                                @payment.Course.Title
                                                            }
                                                            else if (payment.Lecture != null)
                                                            {
                                                                @payment.Lecture.Title
                                                            }
                                                        </div>
                                                        <span class="badge @GetEnrollmentTypeBadge(payment.EnrollmentType)">
                                                            @payment.EnrollmentType
                                                        </span>
                                                    </div>
                                                    @if (payment.Status == PaymentStatus.Approved)
                                                    {
                                                        <button class="btn btn-outline-success btn-sm" 
                                                                @onclick="() => ViewContent(payment)">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Rejection Reason (if any) -->
                                            @if (payment.Status == PaymentStatus.Rejected && !string.IsNullOrEmpty(payment.RejectionReason))
                                            {
                                                <div class="alert alert-danger p-2 small mt-2 mb-0">
                                                    <i class="fas fa-exclamation-circle me-1"></i>
                                                    @payment.RejectionReason
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Desktop Table View -->
                        <div class="d-none d-md-block table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr class="table-light">
                                        <th>Date</th>
                                        <th>Invoice #</th>
                                        <th>Student</th>
                                        <th>Content</th>
                                        <th>Type</th>
                                        <th class="text-end">Amount</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in pagedPayments)
                                    {
                                        var studentFullName = $"{payment.User?.FirstName} {payment.User?.LastName}";
                                        <tr>
                                            <td>
                                                <div class="fw-medium">@payment.CreatedAt.ToString("MMM dd, yyyy")</div>
                                                <small class="text-muted">@payment.CreatedAt.ToString("hh:mm tt")</small>
                                                @if (payment.ApprovedDate.HasValue && payment.Status == PaymentStatus.Approved)
                                                {
                                                    <div class="mt-1">
                                                        <small class="text-success">
                                                            <i class="fas fa-check-circle me-1"></i>
                                                            Approved: @payment.ApprovedDate.Value.ToString("MMM dd")
                                                        </small>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-medium font-monospace small">@payment.InvoiceNumber</div>
