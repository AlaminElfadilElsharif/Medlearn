                                                {
                                                    <div class="mt-1">
                                                        <a href="@payment.InvoicePdfUrl" target="_blank" 
                                                           class="small text-decoration-none" @onclick:preventDefault
                                                           @onclick="async () => await DownloadInvoice(payment.InvoicePdfUrl)">
                                                            <i class="fas fa-file-pdf text-danger me-1"></i>Invoice
                                                        </a>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-sm me-2">
                                                        @if (!string.IsNullOrEmpty(payment.User?.ProfileImageUrl))
                                                        {
                                                            <img src="@payment.User.ProfileImageUrl" 
                                                                 class="rounded-circle" 
                                                                 width="32" height="32" 
                                                                 alt="@studentFullName"
                                                                 loading="lazy" />
                                                        }
                                                        else
                                                        {
                                                            <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                                                 style="width: 32px; height: 32px; font-size: 12px;">
                                                                @payment.User?.FirstName?[0]@payment.User?.LastName?[0]
                                                            </div>
                                                        }
                                                    </div>
                                                    <div>
                                                        <div class="fw-medium">@studentFullName</div>
                                                        <small class="text-muted">@payment.User?.Email</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (payment.Specialization != null)
                                                {
                                                    <div>
                                                        <div class="fw-medium">@payment.Specialization.Title</div>
                                                        <small class="text-muted">
                                                            <i class="fas fa-book me-1"></i>Specialization
                                                        </small>
                                                    </div>
                                                }
                                                else if (payment.Course != null)
                                                {
                                                    <div>
                                                        <div class="fw-medium">@payment.Course.Title</div>
                                                        <small class="text-muted">
                                                            <i class="fas fa-graduation-cap me-1"></i>Course
                                                        </small>
                                                    </div>
                                                }
                                                else if (payment.Lecture != null)
                                                {
                                                    <div>
                                                        <div class="fw-medium">@payment.Lecture.Title</div>
                                                        <small class="text-muted">
                                                            <i class="fas fa-chalkboard-teacher me-1"></i>Lecture
                                                        </small>
                                                    </div>
