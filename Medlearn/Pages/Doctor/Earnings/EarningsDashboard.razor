@code {
    // ... (keep all your existing code in the @code block exactly as is)
    private UserDto? currentUser;
    private bool isLoading = true;
    private bool isAuthenticated = false;

    // Dashboard data
    private decimal totalEarnings = 0;
    private decimal monthlyEarnings = 0;
    private decimal availableBalance = 0;
    private decimal pendingWithdrawals = 0;
    private int totalStudents = 0;
    private List<PaymentRequestDto> recentPayments = new();
    private List<WithdrawalRequestDto> recentWithdrawals = new();
    private List<EnrollmentDto> doctorEnrollments = new();
    private List<SpecializationDto> doctorSpecializations = new();
    private List<MonthlyEarningDto> monthlyEarningsList = new();

    // Withdrawal form
    private decimal withdrawalAmount = 0;
    private string selectedPaymentMethod = "";
    private string bankName = "";
    private string accountNumber = "";
    private string accountHolderName = "";
    private string swiftCode = "";
    private string paypalEmail = "";
    private string stripeAccountId = "";
    private bool isWithdrawing = false;

    // UI state
    private string activeTab = "transactions";
    private string activeSection = "content"; // For mobile: content, activity, withdraw
    private DotNetObjectReference<EarningsDashboard>? dotNetHelper;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Check authentication
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (!isAuthenticated)
            {
                isLoading = false;
                await ShowError("Please login to view the earnings dashboard");
                return;
            }

            // Get current user
            currentUser = await AuthService.GetCurrentUserAsync();

            if (currentUser == null)
            {
                isLoading = false;
                await ShowError("Unable to load user profile");
                return;
            }

            if (currentUser.UserType != UserType.Doctor)
            {
                await ShowError("Access denied. This page is for doctors only.");
                await Task.Delay(1000);
                Navigation.NavigateTo("/");
                return;
            }

            // Load all dashboard data
            await LoadDashboardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading earnings dashboard: {ex}");
            await ShowError($"Failed to load dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && monthlyEarningsList.Any())
        {
            await InitializeChart();
        }
    }

    private async Task LoadDashboardData()
    {
        try
        {
            // Load doctor's balance and withdrawal data
            var balanceData = await WithdrawalService.GetDoctorBalanceAsync();
            if (balanceData != null)
            {
                availableBalance = balanceData.AvailableBalance;
                pendingWithdrawals = balanceData.PendingWithdrawals;
                totalEarnings = balanceData.TotalEarned;
                recentWithdrawals = balanceData.RecentWithdrawals;
                monthlyEarningsList = balanceData.MonthlyEarnings;

                // Calculate this month's earnings
                var currentMonth = DateTime.Now.ToString("yyyy-MM");
                var currentMonthData = monthlyEarningsList.FirstOrDefault(m => m.Month == currentMonth);
                monthlyEarnings = currentMonthData?.Earnings ?? 0;
            }

            // Load doctor's specializations
            var specializations = await SpecializationService.GetMySpecializationsAsync();
            doctorSpecializations = specializations ?? new List<SpecializationDto>();

            // Load recent payments
            await LoadRecentPayments();

            // Load doctor's enrollments
            await LoadDoctorEnrollments();

            // Calculate total students
            await CalculateTotalStudents();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex}");
            await ShowError("Failed to load some dashboard data");
        }
    }

    private async Task LoadRecentPayments()
    {
        try
        {
            var payments = await PaymentService.GetMyPaymentRequestsAsync();
            if (payments != null)
            {
                // Get only approved payments for this doctor
                recentPayments = payments
                    .Where(p => p.Status == PaymentStatus.Approved)
                    .OrderByDescending(p => p.ApprovedDate ?? p.CreatedAt)
                    .Take(10)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading payments: {ex}");
            // Don't show error to user for this, just log it
        }
    }

    private async Task LoadDoctorEnrollments()
    {
        try
        {
            doctorEnrollments = await EnrollmentService.GetDoctorContentEnrollmentsAsync() ?? new List<EnrollmentDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading enrollments: {ex}");
            // Don't show error to user for this, just log it
        }
    }

    private async Task CalculateTotalStudents()
    {
        try
        {
            // Count unique students from enrollments
            totalStudents = doctorEnrollments
                .Select(e => e.UserId)
                .Distinct()
                .Count();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating total students: {ex}");
            totalStudents = 0;
        }
    }

    private async Task RequestWithdrawal()
    {
        if (withdrawalAmount < 50 || withdrawalAmount > availableBalance)
        {
            await ShowError("Invalid withdrawal amount. Minimum is $50.00");
            return;
        }

        if (string.IsNullOrEmpty(selectedPaymentMethod))
        {
            await ShowError("Please select a payment method");
            return;
        }

        // Prepare account details based on payment method
        string accountDetails = "";
        switch (selectedPaymentMethod)
        {
            case "Bank Transfer":
                if (string.IsNullOrEmpty(bankName) || string.IsNullOrEmpty(accountNumber))
                {
                    await ShowError("Please provide bank details");
                    return;
                }
                accountDetails = $"Bank: {bankName}, Account: {accountNumber}, Holder: {accountHolderName}, SWIFT: {swiftCode}";
                break;
            case "PayPal":
                if (string.IsNullOrEmpty(paypalEmail))
                {
                    await ShowError("Please provide your PayPal email");
                    return;
                }
                accountDetails = $"PayPal Email: {paypalEmail}";
                break;
            case "Stripe":
                if (string.IsNullOrEmpty(stripeAccountId))
                {
                    await ShowError("Please provide your Stripe account ID");
                    return;
                }
                accountDetails = $"Stripe Account ID: {stripeAccountId}";
                break;
        }

        isWithdrawing = true;
        StateHasChanged();

        try
        {
            var withdrawalDto = new CreateWithdrawalRequestDto
            {
                Amount = withdrawalAmount,
                PaymentMethod = selectedPaymentMethod,
                AccountDetails = accountDetails
            };

            var result = await WithdrawalService.CreateWithdrawalAsync(withdrawalDto);

            if (result != null)
            {
                // Update available balance
                availableBalance -= withdrawalAmount;
                pendingWithdrawals += withdrawalAmount;

                // Update current user's profile balance
                if (currentUser?.Profile != null)
                {
                    currentUser.Profile.Balance = availableBalance;
                }

                // Add to recent withdrawals
                recentWithdrawals.Insert(0, result);

                await ShowSuccess($"Withdrawal request of ${withdrawalAmount:N2} submitted successfully!");

                // Reset form
                ResetWithdrawalForm();

                // Switch to withdrawals tab on mobile
                if (System.Environment.OSVersion.Platform == PlatformID.Other)
                {
                    activeSection = "activity";
                    activeTab = "withdrawals";
                }
                else
                {
                    activeTab = "withdrawals";
                }

                StateHasChanged();
            }
            else
            {
                await ShowError("Failed to submit withdrawal request");
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Failed to process withdrawal: {ex.Message}");
        }
        finally
        {
            isWithdrawing = false;
            StateHasChanged();
        }
    }

    private void ResetWithdrawalForm()
    {
        withdrawalAmount = 0;
        selectedPaymentMethod = "";
        bankName = "";
        accountNumber = "";
        accountHolderName = "";
        swiftCode = "";
        paypalEmail = "";
        stripeAccountId = "";
    }

    private async Task ExportEarnings()
    {
        try
        {
            // Generate CSV content
            var csv = new System.Text.StringBuilder();
            csv.AppendLine("Doctor Earnings Report");
            csv.AppendLine($"Generated: {DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")}");
            csv.AppendLine($"Doctor: {currentUser?.FirstName} {currentUser?.LastName}");
            csv.AppendLine($"Email: {currentUser?.Email}");
            csv.AppendLine();

            csv.AppendLine("SUMMARY");
            csv.AppendLine("Metric,Value");
            csv.AppendLine($"Total Earnings,${totalEarnings:N2}");
            csv.AppendLine($"Monthly Earnings,${monthlyEarnings:N2}");
            csv.AppendLine($"Available Balance,${availableBalance:N2}");
            csv.AppendLine($"Pending Withdrawals,${pendingWithdrawals:N2}");
            csv.AppendLine($"Total Students,{totalStudents}");
            csv.AppendLine();

            csv.AppendLine("RECENT TRANSACTIONS");
            csv.AppendLine("Date,Invoice,Student,Content Type,Content,Amount,Status");

            foreach (var payment in recentPayments)
            {
                var studentName = $"{payment.User?.FirstName} {payment.User?.LastName}";
                var contentType = payment.Specialization != null ? "Specialization" :
                                 payment.Course != null ? "Course" :
                                 payment.Lecture != null ? "Lecture" : "Unknown";
                var contentTitle = payment.Specialization?.Title ??
                                 payment.Course?.Title ??
                                 payment.Lecture?.Title ?? "Unknown";

                csv.AppendLine($"\"{payment.CreatedAt:yyyy-MM-dd HH:mm}\",\"{payment.InvoiceNumber}\",\"{studentName}\",\"{contentType}\",\"{contentTitle}\",${payment.Amount:N2},\"{payment.Status}\"");
            }

            csv.AppendLine();
            csv.AppendLine("RECENT WITHDRAWALS");
            csv.AppendLine("Date,ID,Method,Amount,Status,Account Details");

            foreach (var withdrawal in recentWithdrawals)
            {
                csv.AppendLine($"\"{withdrawal.RequestDate:yyyy-MM-dd HH:mm}\",\"{withdrawal.Id}\",\"{withdrawal.PaymentMethod}\",${withdrawal.Amount:N2},\"{withdrawal.Status}\",\"{withdrawal.AccountDetails}\"");
            }

            csv.AppendLine();
            csv.AppendLine("MONTHLY EARNINGS");
            csv.AppendLine("Month,Earnings,Enrollments");

            foreach (var month in monthlyEarningsList)
            {
                csv.AppendLine($"\"{month.Month}\",${month.Earnings:N2},{month.Enrollments}");
            }

            csv.AppendLine();
            csv.AppendLine("YOUR CONTENT");
            csv.AppendLine("Title,Type,Price,Students,Rating,Status");

            foreach (var spec in doctorSpecializations)
            {
                csv.AppendLine($"\"{spec.Title}\",Specialization,${spec.Price:N2},{spec.TotalEnrollments},{spec.AverageRating:N1},\"{(spec.IsActive ? "Active" : "Inactive")}\"");
            }

            // Trigger download
            var fileName = $"Earnings_Report_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await JS.InvokeVoidAsync("downloadCSV", fileName, csv.ToString());

            await ShowSuccess("Report exported successfully!");
        }
        catch (Exception ex)
        {
            await ShowError($"Failed to export report: {ex.Message}");
        }
    }

    private async Task InitializeChart()
    {
        try
        {
            // Prepare data for chart
            var labels = monthlyEarningsList.Select(m => m.Month).Reverse().ToArray();
            var earnings = monthlyEarningsList.Select(m => (double)m.Earnings).Reverse().ToArray();
            var enrollments = monthlyEarningsList.Select(m => (double)m.Enrollments).Reverse().ToArray();

            await JS.InvokeVoidAsync("initializeEarningsChart",
                new { labels = labels, earnings = earnings, enrollments = enrollments });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing chart: {ex}");
        }
    }

    private async Task ToggleSpecializationStatus(int id, bool isActive)
    {
        try
        {
            var result = await SpecializationService.UpdateSpecializationStatusAsync(id, isActive);
            if (result)
            {
                await ShowSuccess($"Specialization {(isActive ? "activated" : "deactivated")} successfully!");

                // Update local state
                var spec = doctorSpecializations.FirstOrDefault(s => s.Id == id);
                if (spec != null)
                {
                    spec.IsActive = isActive;
                    StateHasChanged();
                }
            }
            else
            {
                await ShowError($"Failed to update specialization status");
            }
        }
        catch (Exception ex)
        {
            await ShowError($"Error: {ex.Message}");
        }
    }

