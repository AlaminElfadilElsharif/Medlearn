    private string GetPaymentStatusBadge(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Approved => "bg-success",
            PaymentStatus.Pending => "bg-warning",
            PaymentStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetWithdrawalStatusBadge(WithdrawalStatus status)
    {
        return status switch
        {
            WithdrawalStatus.Approved => "bg-success",
            WithdrawalStatus.Pending => "bg-warning",
            WithdrawalStatus.Rejected => "bg-danger",
            WithdrawalStatus.Completed => "bg-info",
            _ => "bg-secondary"
        };
    }

    private string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
            return text;

        return text.Substring(0, maxLength - 3) + "...";
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/doctor/dashboard");
    }

    private async Task ShowSuccess(string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", "success", message);
        }
        catch
        {
            // Fallback to alert if toast not available
            await JS.InvokeVoidAsync("alert", message);
        }
    }

    private async Task ShowError(string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", "error", message);
        }
        catch
        {
            // Fallback to alert if toast not available
