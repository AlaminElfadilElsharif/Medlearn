@code {
    // ... (keep all your existing code in the @code block exactly as is from the original)
    private List<CourseDto> allCourses = new();
    private List<CourseDto> filteredCourses = new();
    private List<CourseDto> paginatedCourses = new();
    private List<SpecializationDto> specializations = new();
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private string? errorMessage = null;
    private string? successMessage = null;
    private UserDto? currentUser;

    // Stats
    private int totalCoursesCount = 0;
    private int activeCoursesCount = 0;
    private int totalStudents = 0;
    private decimal totalRevenue = 0;

    // Filtering
    private string searchTerm = "";
    private int selectedSpecializationId = 0;
    private string? statusFilter = null;
    private bool isFiltered = false;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private int startPage = 1;
    private int endPage = 1;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CheckAuthentication();

            if (isAuthenticated && currentUser?.UserType == UserType.Doctor)
            {
                await LoadData();
            }
            else
            {
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            Console.WriteLine($"Error initializing page: {ex.Message}");
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();

                if (currentUser?.UserType != UserType.Doctor)
                {
                    errorMessage = "Access denied. Doctor access required.";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            currentUser = null;
        }
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Load doctor's specializations
            await LoadSpecializations();

            // Load courses for those specializations
            await LoadCourses();

            // Calculate stats
            CalculateStats();

            // Apply initial filters
            await SearchCourses();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadSpecializations()
    {
        try
        {
            var specs = await SpecializationService.GetMySpecializationsAsync();
            if (specs != null)
            {
                specializations = specs.OrderBy(s => s.Title).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading specializations: {ex.Message}");
        }
    }

    private async Task LoadCourses()
    {
        try
        {
            allCourses.Clear();

            // For each specialization, get courses
            foreach (var spec in specializations)
            {
                var coursesForSpec = await CourseService.GetCoursesBySpecializationAsync(spec.Id);
                if (coursesForSpec != null)
                {
                    // Filter courses that belong to this doctor
                    foreach (var course in coursesForSpec)
                    {
                        if (course.DoctorId == currentUser!.Id)
                        {
                            // Fix image URL using ImageUrlService
                            if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                            {
                                course.ThumbnailUrl = ImageUrlService.GetImageUrl(course.ThumbnailUrl);
                            }
                            allCourses.Add(course);
                        }
                    }
                }
            }

            // Sort by specialization and order
            allCourses = allCourses.OrderBy(c => c.SpecializationId)
                                 .ThenBy(c => c.Order)
                                 .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading courses: {ex.Message}");
        }
    }

    private void CalculateStats()
    {
        try
        {
            totalCoursesCount = allCourses.Count;
            activeCoursesCount = allCourses.Count(c => c.IsActive);
            totalStudents = allCourses.Sum(c => c.TotalEnrollments);
            totalRevenue = allCourses.Sum(c => c.Price * c.TotalEnrollments);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating stats: {ex.Message}");
        }
    }

    // Filter methods
    private async Task OnSearchInput()
    {
        await SearchCourses();
    }

    private async Task OnFilterChanged()
    {
        await SearchCourses();
    }

    private async Task ResetFilters()
    {
        searchTerm = "";
        selectedSpecializationId = 0;
        statusFilter = null;
        currentPage = 1;
        await SearchCourses();
    }

    private async Task SearchCourses()
    {
        try
        {
            // Start with all courses
            filteredCourses = allCourses.ToList();

            // Apply text search
            if (!string.IsNullOrEmpty(searchTerm))
            {
                filteredCourses = filteredCourses
                    .Where(c => c.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                               (c.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                    .ToList();
            }

            // Apply specialization filter
            if (selectedSpecializationId > 0)
            {
                filteredCourses = filteredCourses
                    .Where(c => c.SpecializationId == selectedSpecializationId)
                    .ToList();
            }

            // Apply status filter
            if (!string.IsNullOrEmpty(statusFilter))
            {
                bool isActive = statusFilter.ToLower() == "true";
                filteredCourses = filteredCourses
                    .Where(c => c.IsActive == isActive)
                    .ToList();
            }

            // Update filtered state
            isFiltered = !string.IsNullOrEmpty(searchTerm) ||
                        selectedSpecializationId > 0 ||
                        !string.IsNullOrEmpty(statusFilter);

            // Update pagination
            UpdatePagination();

            // Get current page data
            paginatedCourses = filteredCourses
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();

            // Update UI
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error searching courses: {ex.Message}";
            Console.WriteLine($"Error searching courses: {ex.Message}");
        }
    }

    private void UpdatePagination()
    {
        totalPages = (int)Math.Ceiling((double)filteredCourses.Count / pageSize);
        if (totalPages < 1) totalPages = 1;

        if (currentPage > totalPages)
            currentPage = 1;

        int visiblePages = 5;
        startPage = Math.Max(1, currentPage - visiblePages / 2);
        endPage = Math.Min(totalPages, startPage + visiblePages - 1);

        if (endPage - startPage + 1 < visiblePages)
        {
            startPage = Math.Max(1, endPage - visiblePages + 1);
        }
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages || page == currentPage)
            return;

        currentPage = page;
        _ = SearchCourses();
    }

    private async Task ConfirmDelete(int courseId, string courseTitle)
    {
        try
        {
            bool confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Are you sure you want to delete course '{courseTitle}'? This will also delete all associated lectures and materials.");

            if (confirmed)
            {
                var result = await CourseService.DeleteCourseAsync(courseId);

                if (result)
                {
                    successMessage = $"Course '{courseTitle}' deleted successfully.";

                    // Reload data
                    await LoadData();
                }
                else
                {
                    errorMessage = $"Failed to delete course '{courseTitle}'.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting course: {ex.Message}";
            Console.WriteLine($"Error deleting course: {ex.Message}");
        }
    }

    private async Task ToggleCourseStatus(int courseId, bool isActive)
    {
        try
        {
            var result = await CourseService.UpdateCourseStatusAsync(courseId, isActive);
            if (result)
            {
                // Update local course status
                var course = allCourses.FirstOrDefault(c => c.Id == courseId);
                if (course != null)
                {
                    course.IsActive = isActive;
                    await SearchCourses();

                    successMessage = $"Course {(isActive ? "activated" : "deactivated")} successfully.";
                }
            }
            else
            {
                errorMessage = "Failed to update course status.";
                // Revert the toggle
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"Error toggling course status: {ex.Message}");
            // Revert the toggle
            StateHasChanged();
        }
    }

    private void ViewCourse(int courseId)
    {
        Navigation.NavigateTo($"/course/{courseId}");
    }

    private void ViewCourseLectures(int courseId)
    {
        Navigation.NavigateTo($"/content/courses/{courseId}/lectures");
    }

    private void EditCourse(int courseId)
    {
        Navigation.NavigateTo($"/createcourse/{courseId}");
    }

    private void AddLecture(int courseId)
    {
        Navigation.NavigateTo($"/createlecture/{courseId}");
    }

    private void NavigateToCreateCourse()
    {
        Navigation.NavigateTo("/createcourse");
    }

    private void NavigateToSpecializations()
    {
        Navigation.NavigateTo("/content/specializations");
    }

    private void NavigateToLectures()
    {
        Navigation.NavigateTo("/content/lectures");
    }

    private async Task ExportCourses()
    {
        try
        {
            var csv = new System.Text.StringBuilder();
            csv.AppendLine("Doctor Courses Report");
            csv.AppendLine($"Generated: {DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")}");
            csv.AppendLine($"Doctor: {currentUser?.FirstName} {currentUser?.LastName}");
            csv.AppendLine($"Email: {currentUser?.Email}");
            csv.AppendLine();

            csv.AppendLine("COURSE DETAILS");
            csv.AppendLine("ID,Title,Specialization,Price,Students,Enrollments,Rating,Lectures,Created,Status");

            foreach (var course in filteredCourses)
            {
                var specialization = specializations.FirstOrDefault(s => s.Id == course.SpecializationId);
                var specName = specialization?.Title ?? "Unknown";

                csv.AppendLine($"\"{course.Id}\",\"{course.Title}\",\"{specName}\",\"${course.Price:N2}\",\"{course.TotalEnrollments}\",\"{course.AverageRating:0.0}\",\"{course.Lectures?.Count ?? 0}\",\"{course.CreatedAt:yyyy-MM-dd}\",\"{(course.IsActive ? "Active" : "Inactive")}\"");
            }

            var fileName = $"Courses_Report_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await JS.InvokeVoidAsync("downloadCSV", fileName, csv.ToString());

            successMessage = "Report exported successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to export report: {ex.Message}";
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/doctor/dashboard");
    }

    public void Dispose()
    {
        // Clean up if needed
    }
}

