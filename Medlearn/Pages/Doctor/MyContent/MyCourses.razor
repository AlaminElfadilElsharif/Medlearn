@page "/content/courses"


<PageTitle>My Courses</PageTitle>

<div class="my-courses">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <h5 class="mb-0 flex-grow-1">My Courses</h5>
                    @if (isAuthenticated && currentUser?.UserType == UserType.Doctor)
                    {
                        <button class="btn btn-link text-white p-0" @onclick="NavigateToCreateCourse">
                            <i class="fas fa-plus fa-lg"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="px-3 py-2 bg-light border-bottom">
                <p class="text-muted small mb-0">Manage your courses and content</p>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-block">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1>My Courses</h1>
                    <p class="text-muted mb-0">Manage your courses and content</p>
                </div>
                @if (isAuthenticated && currentUser?.UserType == UserType.Doctor)
                {
                    <button class="btn btn-primary" @onclick="NavigateToCreateCourse">
                        <i class="fas fa-plus me-2"></i> Create Course
                    </button>
                }
            </div>
        </div>

        @if (errorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show m-3 m-md-0 mb-md-3" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (successMessage != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3 m-md-0 mb-md-3" role="alert">
                @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
            </div>
        }

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading courses...</p>
            </div>
        }
        else if (!isAuthenticated)
        {
            <!-- Not Authenticated -->
            <div class="text-center py-5 px-3">
                <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                <h5>Authentication Required</h5>
                <p class="text-muted">Please log in to view your courses</p>
                <button class="btn btn-primary mt-3" @onclick='() => Navigation.NavigateTo("/account/login")'>
                    <i class="fas fa-sign-in-alt me-2"></i> Login
                </button>
            </div>
        }
        else if (currentUser?.UserType != UserType.Doctor)
        {
            <!-- Not a Doctor -->
            <div class="text-center py-5 px-3">
                <i class="fas fa-user-md fa-3x text-muted mb-3"></i>
                <h5>Doctor Access Required</h5>
                <p class="text-muted">You need to be logged in as a doctor to access this page</p>
                <button class="btn btn-primary mt-3" @onclick='() => Navigation.NavigateTo("/")'>
                    <i class="fas fa-home me-2"></i> Go Home
                </button>
            </div>
        }
        else
        {
            <!-- Authenticated Doctor View -->
            <!-- Mobile Stats Cards (Horizontal Scroll) -->
            <div class="d-block d-md-none px-3 mt-3">
                <div class="row g-2 flex-nowrap overflow-auto pb-2" style="scrollbar-width: none;">
                    <div class="col-4">
                        <div class="card bg-primary text-white border-0">
                            <div class="card-body p-2 text-center">
                                <h6 class="card-title small mb-1">Total</h6>
                                <h4 class="mb-0">@totalCoursesCount</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card bg-success text-white border-0">
                            <div class="card-body p-2 text-center">
                                <h6 class="card-title small mb-1">Active</h6>
                                <h4 class="mb-0">@activeCoursesCount</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card bg-info text-white border-0">
                            <div class="card-body p-2 text-center">
                                <h6 class="card-title small mb-1">Students</h6>
                                <h4 class="mb-0">@totalStudents</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card bg-warning text-white border-0">
                            <div class="card-body p-2 text-center">
                                <h6 class="card-title small mb-1">Revenue</h6>
                                <h4 class="mb-0">$@totalRevenue.ToString("N0")</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Desktop Stats -->
            <div class="d-none d-md-block">
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted">Total Courses</h6>
                                        <h3>@totalCoursesCount</h3>
                                    </div>
                                    <i class="fas fa-graduation-cap fa-2x text-primary"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted">Active Courses</h6>
                                        <h3>@activeCoursesCount</h3>
                                    </div>
                                    <i class="fas fa-check-circle fa-2x text-success"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted">Total Students</h6>
                                        <h3>@totalStudents</h3>
                                    </div>
                                    <i class="fas fa-users fa-2x text-info"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted">Total Revenue</h6>
                                        <h3>$@totalRevenue.ToString("N2")</h3>
                                    </div>
                                    <i class="fas fa-dollar-sign fa-2x text-warning"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Filter Bar -->
            <div class="d-block d-md-none px-3 mt-3">
                <div class="d-flex gap-2 mb-3">
                    <div class="flex-grow-1">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0"
                                   placeholder="Search courses..."
                                   @bind="searchTerm"
                                   @bind:after="OnSearchInput" />
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" type="button"
                            data-bs-toggle="collapse" data-bs-target="#mobileFilters">
                        <i class="fas fa-filter"></i>
                    </button>
                </div>

                <div class="collapse" id="mobileFilters">
                    <div class="card card-body mb-3">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Specialization</label>
                            <select class="form-select form-select-sm"
                                    @bind="selectedSpecializationId"
                                    @bind:after="OnFilterChanged">
                                <option value="0">All Specializations</option>
                                @foreach (var spec in specializations)
                                {
                                    <option value="@spec.Id">@spec.Title</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Status</label>
                            <select class="form-select form-select-sm"
                                    @bind="statusFilter"
                                    @bind:after="OnFilterChanged">
                                <option value="">All Status</option>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                        <button class="btn btn-sm btn-secondary w-100" @onclick="ResetFilters">
                            <i class="fas fa-undo me-2"></i> Reset Filters
                        </button>
                    </div>
                </div>
            </div>

            <!-- Desktop Filter Section -->
            <div class="d-none d-md-block">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    <input type="text" class="form-control" placeholder="Search courses..."
                                           @bind="searchTerm"
                                           @bind:after="OnSearchInput" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select"
                                        @bind="selectedSpecializationId"
                                        @bind:after="OnFilterChanged">
                                    <option value="0">All Specializations</option>
                                    @foreach (var spec in specializations)
                                    {
                                        <option value="@spec.Id">@spec.Title</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select class="form-select"
                                        @bind="statusFilter"
                                        @bind:after="OnFilterChanged">
                                    <option value="">All Status</option>
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex gap-2">
                                    <button class="btn btn-primary flex-grow-1" @onclick="NavigateToCreateCourse">
                                        <i class="fas fa-plus me-2"></i> Create Course
                                    </button>
                                    <button class="btn btn-secondary" @onclick="ResetFilters">
                                        <i class="fas fa-undo me-2"></i> Reset
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Courses Display -->
            <div class="px-3 px-md-0">
                <!-- Mobile Course Cards View -->
                <div class="d-block d-md-none">
                    @if (!filteredCourses.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-graduation-cap fa-3x text-muted mb-3"></i>
                            <h5>No courses found</h5>
                            <p class="text-muted">@(isFiltered ? "Try changing your filters" : "Create your first course to get started")</p>
                            @if (!isFiltered)
                            {
                                <button class="btn btn-primary mt-3" @onclick="NavigateToCreateCourse">
                                    <i class="fas fa-plus me-2"></i> Create Course
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="course-cards">
                            @foreach (var course in paginatedCourses)
                            {
                                var specialization = specializations.FirstOrDefault(s => s.Id == course.SpecializationId);
                                var imageUrl = ImageUrlService.GetImageUrl(course.ThumbnailUrl);

                                <div class="card mb-3">
                                    <div class="row g-0">
                                        <div class="col-4">
                                            @if (!string.IsNullOrEmpty(imageUrl))
                                            {
                                                <img src="@imageUrl"
                                                     alt="@course.Title"
                                                     class="img-fluid rounded-start h-100"
                                                     style="object-fit: cover;"
                                                     onerror="this.onerror=null; this.src='/placeholder-image.jpg';" />
                                            }
                                            else
                                            {
                                                <div class="bg-light d-flex align-items-center justify-content-center h-100"
                                                     style="min-height: 100px;">
                                                    <i class="fas fa-graduation-cap fa-2x text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="col-8">
                                            <div class="card-body p-2">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <h6 class="card-title mb-1">@course.Title</h6>
                                                    <div class="dropdown">
                                                        <button class="btn btn-link p-0 text-muted" type="button"
                                                                data-bs-toggle="dropdown">
                                                            <i class="fas fa-ellipsis-v"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end">
                                                            <li>
                                                                <a class="dropdown-item" href="#" @onclick="() => ViewCourse(course.Id)">
                                                                    <i class="fas fa-eye me-2"></i> View
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a class="dropdown-item" href="#" @onclick="() => EditCourse(course.Id)">
                                                                    <i class="fas fa-edit me-2"></i> Edit
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a class="dropdown-item" href="#" @onclick="() => AddLecture(course.Id)">
                                                                    <i class="fas fa-video me-2"></i> Add Lecture
                                                                </a>
                                                            </li>
                                                            <li><hr class="dropdown-divider"></li>
                                                            <li>
                                                                <a class="dropdown-item text-danger" href="#"
                                                                   @onclick="async () => await ConfirmDelete(course.Id, course.Title)">
                                                                    <i class="fas fa-trash me-2"></i> Delete
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>

                                                <p class="card-text small text-muted mb-1">
                                                    @specialization?.Title
                                                </p>

                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="badge bg-info">
                                                        <i class="fas fa-video me-1"></i> @(course.Lectures?.Count ?? 0)
                                                    </span>
                                                    <span class="fw-bold text-success small">$@course.Price.ToString("N2")</span>
                                                </div>

                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="small">
                                                        <i class="fas fa-users text-info me-1"></i>
                                                        @course.TotalEnrollments students
                                                    </div>
                                                    <div class="d-flex align-items-center">
                                                        <div class="rating-stars me-1">
                                                            @{
                                                                var rating = (int)Math.Round(course.AverageRating);
                                                                var hasHalfStar = Convert.ToDecimal(course.AverageRating) - Math.Floor(course.AverageRating) >= 0.5m;
                                                            }
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                if (i <= rating)
                                                                {
                                                                    <i class="fas fa-star text-warning" style="font-size: 10px;"></i>
                                                                }
                                                                else if (i == rating + 1 && hasHalfStar)
                                                                {
                                                                    <i class="fas fa-star-half-alt text-warning" style="font-size: 10px;"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="far fa-star text-muted" style="font-size: 10px;"></i>
                                                                }
                                                            }
                                                        </div>
                                                        <small>@course.AverageRating.ToString("0.0")</small>
                                                    </div>
                                                </div>

                                                <div class="d-flex justify-content-between align-items-center mt-2">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               role="switch"
                                                               id="mobile-course-@course.Id"
                                                               checked="@course.IsActive"
                                                               @onchange="async (e) => await ToggleCourseStatus(course.Id, (bool)e.Value)">
                                                        <label class="form-check-label small" for="mobile-course-@course.Id">
                                                            @if (course.IsActive)
                                                            {
                                                                <span class="badge bg-success">Active</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary">Inactive</span>
                                                            }
                                                        </label>
                                                    </div>
                                                    <small class="text-muted">
                                                        @course.CreatedAt.ToString("MMM dd")
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Mobile Pagination -->
                        @if (totalPages > 1)
                        {
                            <div class="d-flex justify-content-between align-items-center mt-3 mb-4">
                                <button class="btn btn-sm btn-outline-primary @(currentPage == 1 ? "disabled" : "")"
                                        @onclick="() => ChangePage(currentPage - 1)">
                                    <i class="fas fa-chevron-left"></i> Previous
                                </button>
                                <span class="small text-muted">
                                    Page @currentPage of @totalPages
                                </span>
                                <button class="btn btn-sm btn-outline-primary @(currentPage == totalPages ? "disabled" : "")"
                                        @onclick="() => ChangePage(currentPage + 1)">
                                    Next <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                        }
                    }
                </div>

                <!-- Desktop Table View -->
                <div class="d-none d-md-block">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Courses (@filteredCourses.Count)</h5>
                        </div>
                        <div class="card-body">
                            @if (!filteredCourses.Any())
                            {
                                <div class="text-center py-5">
                                    <i class="fas fa-graduation-cap fa-3x text-muted mb-3"></i>
                                    <h5>No courses found</h5>
                                    <p class="text-muted">@(isFiltered ? "Try changing your filters" : "Create your first course to get started")</p>
                                    @if (!isFiltered)
                                    {
                                        <button class="btn btn-primary mt-3" @onclick="NavigateToCreateCourse">
                                            <i class="fas fa-plus me-2"></i> Create Course
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Thumbnail</th>
                                                <th>Course</th>
                                                <th>Specialization</th>
                                                <th>Lectures</th>
                                                <th>Students</th>
                                                <th>Price</th>
                                                <th>Rating</th>
                                                <th>Created</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var course in paginatedCourses)
                                            {
                                                var specialization = specializations.FirstOrDefault(s => s.Id == course.SpecializationId);
                                                var imageUrl = ImageUrlService.GetImageUrl(course.ThumbnailUrl);

                                                <tr>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(imageUrl))
                                                        {
                                                            <img src="@imageUrl"
                                                                 alt="@course.Title"
                                                                 class="course-thumbnail rounded"
                                                                 style="width: 60px; height: 40px; object-fit: cover;"
                                                                 onerror="this.onerror=null; this.src='/placeholder-image.jpg';" />
                                                        }
                                                        else
                                                        {
                                                            <div class="course-thumbnail-placeholder rounded d-flex align-items-center justify-content-center"
                                                                 style="width: 60px; height: 40px; background-color: #f8f9fa; border: 1px solid #dee2e6;">
                                                                <i class="fas fa-graduation-cap text-muted"></i>
                                                            </div>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div>
                                                            <strong>@course.Title</strong>
                                                            @if (!string.IsNullOrEmpty(course.Description) && course.Description.Length > 100)
                                                            {
                                                                <div class="text-muted small">
                                                                    @course.Description.Substring(0, 100)...
                                                                </div>
                                                            }
                                                            else if (!string.IsNullOrEmpty(course.Description))
                                                            {
                                                                <div class="text-muted small">
                                                                    @course.Description
                                                                </div>
                                                            }
                                                            <small class="text-muted d-block mt-1">
                                                                <i class="fas fa-sort-numeric-up-alt me-1"></i>Order: @course.Order
                                                            </small>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @if (specialization != null)
                                                        {
                                                            <div class="d-flex align-items-center">
                                                                <span class="text-truncate" style="max-width: 150px;" title="@specialization.Title">
                                                                    @specialization.Title
                                                                </span>
                                                                @if (!specialization.IsActive)
                                                                {
                                                                    <span class="badge bg-danger ms-2">Inactive</span>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">Unknown Specialization</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <span class="badge bg-info">
                                                                <i class="fas fa-video me-1"></i> @(course.Lectures?.Count ?? 0)
                                                            </span>
                                                            @if ((course.Lectures?.Count ?? 0) > 0)
                                                            {
                                                                <button class="btn btn-sm btn-link ms-2 p-0"
                                                                        @onclick="() => ViewCourseLectures(course.Id)"
                                                                        title="View Lectures">
                                                                    <i class="fas fa-list-ul"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <i class="fas fa-users text-info me-1"></i>
                                                            <span>@course.TotalEnrollments</span>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="fw-bold text-success">$@course.Price.ToString("N2")</span>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <div class="rating-stars me-2">
                                                                @{
                                                                    var rating = (int)Math.Round(course.AverageRating);
                                                                    var hasHalfStar = Convert.ToDecimal(course.AverageRating) - Math.Floor(course.AverageRating) >= 0.5m;
                                                                }
                                                                @for (int i = 1; i <= 5; i++)
                                                                {
                                                                    if (i <= rating)
                                                                    {
                                                                        <i class="fas fa-star text-warning" style="font-size: 12px;"></i>
                                                                    }
                                                                    else if (i == rating + 1 && hasHalfStar)
                                                                    {
                                                                        <i class="fas fa-star-half-alt text-warning" style="font-size: 12px;"></i>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="far fa-star text-muted" style="font-size: 12px;"></i>
                                                                    }
                                                                }
                                                            </div>
                                                            <span>@course.AverageRating.ToString("0.0")</span>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted d-block">
                                                            @course.CreatedAt.ToString("MMM dd, yyyy")
                                                        </small>
                                                        <small class="text-muted">
                                                            @course.CreatedAt.ToString("hh:mm tt")
                                                        </small>
                                                    </td>
                                                    <td>
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input course-status-toggle"
                                                                   type="checkbox"
                                                                   role="switch"
                                                                   id="course-@course.Id"
                                                                   checked="@course.IsActive"
                                                                   @onchange="async (e) => await ToggleCourseStatus(course.Id, (bool)e.Value)">
                                                            <label class="form-check-label" for="course-@course.Id">
                                                                @if (course.IsActive)
                                                                {
                                                                    <span class="badge bg-success">Active</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-secondary">Inactive</span>
                                                                }
                                                            </label>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm" role="group">
                                                            <button class="btn btn-outline-info" @onclick="() => ViewCourse(course.Id)"
                                                                    title="View Course">
                                                                <i class="fas fa-eye"></i>
                                                            </button>
                                                            <button class="btn btn-outline-primary"
                                                                    @onclick="() => EditCourse(course.Id)"
                                                                    title="Edit Course">
                                                                <i class="fas fa-edit"></i>
