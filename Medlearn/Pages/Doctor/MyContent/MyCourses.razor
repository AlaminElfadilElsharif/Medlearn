                                                Showing @((currentPage - 1) * pageSize + 1)-@Math.Min(currentPage * pageSize, filteredCourses.Count)
                                                of @filteredCourses.Count courses
                                            </small>
                                        </div>
                                    </nav>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Quick Actions -->
            <div class="d-block d-md-none px-3 mt-3 mb-4">
