@page "/content/specializations"


<PageTitle>My Specializations</PageTitle>

<div class="my-specializations">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <h5 class="mb-0 flex-grow-1">My Specializations</h5>
                    @if (isAuthenticated && currentUser?.UserType == UserType.Doctor)
                    {
                        <button class="btn btn-link text-white p-0" @onclick="NavigateToCreate">
                            <i class="fas fa-plus fa-lg"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="px-3 py-2 bg-light border-bottom">
                <small class="text-muted">@currentUser?.FirstName @currentUser?.LastName • Doctor</small>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-block mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1>My Specializations</h1>
                    <p class="text-muted mb-0">Manage your medical specializations and content</p>
                </div>
                @if (isAuthenticated && currentUser?.UserType == UserType.Doctor)
                {
                    <button class="btn btn-primary" @onclick="NavigateToCreate">
                        <i class="fas fa-plus me-2"></i> Create Specialization
                    </button>
                }
            </div>
        </div>

        <!-- Alerts -->
        @if (errorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mx-2 mx-md-0" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (successMessage != null)
        {
            <div class="alert alert-success alert-dismissible fade show mx-2 mx-md-0" role="alert">
                <i class="fas fa-check-circle me-2"></i>@successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
            </div>
        }

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading specializations...</p>
            </div>
        }
        else if (!isAuthenticated)
        {
            <!-- Not Authenticated -->
            <div class="text-center py-5">
                <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                <h5>Authentication Required</h5>
                <p class="text-muted">Please log in to view your specializations</p>
                <button class="btn btn-primary mt-3" @onclick='() => Navigation.NavigateTo("/account/login")'>
                    <i class="fas fa-sign-in-alt me-2"></i> Login
                </button>
            </div>
        }
        else if (currentUser?.UserType != UserType.Doctor)
        {
            <!-- Not a Doctor -->
            <div class="text-center py-5">
                <i class="fas fa-user-md fa-3x text-muted mb-3"></i>
                <h5>Doctor Access Required</h5>
                <p class="text-muted">You need to be logged in as a doctor to access this page</p>
                <button class="btn btn-primary mt-3" @onclick='() => Navigation.NavigateTo("/")'>
                    <i class="fas fa-home me-2"></i> Go Home
                </button>
            </div>
        }
        else
        {
            <!-- Authenticated Doctor View -->
            <!-- Stats Cards - Responsive -->
            <div class="row g-2 g-md-3 mb-3 mb-md-4 mx-0">
                <div class="col-6 col-md-3 px-1 px-md-2">
                    <div class="card stat-card">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Total</h6>
                                    <h3 class="mb-0">@totalCount</h3>
                                </div>
                                <i class="fas fa-layer-group fa-2x text-primary opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3 px-1 px-md-2">
                    <div class="card stat-card">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Active</h6>
                                    <h3 class="mb-0">@activeCount</h3>
                                </div>
                                <i class="fas fa-check-circle fa-2x text-success opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3 px-1 px-md-2">
                    <div class="card stat-card">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Students</h6>
                                    <h3 class="mb-0">@totalStudents</h3>
                                </div>
                                <i class="fas fa-users fa-2x text-info opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3 px-1 px-md-2">
                    <div class="card stat-card">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Revenue</h6>
                                    <h3 class="mb-0">$@totalRevenue.ToString("N0")</h3>
                                </div>
                                <i class="fas fa-dollar-sign fa-2x text-warning opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Filter Bar -->
            <div class="d-block d-md-none mb-3">
                <div class="card">
                    <div class="card-body p-2">
                        <div class="d-flex gap-2">
                            <div class="flex-grow-1">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white border-end-0">
                                        <i class="fas fa-search text-muted"></i>
                                    </span>
                                    <input type="text" class="form-control border-start-0 ps-0"
                                           placeholder="Search specializations..."
                                           @bind="searchTerm"
                                           @bind:after="OnSearchInput" />
                                </div>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#mobileFilters">
                                <i class="fas fa-filter"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="NavigateToCreate">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>

                        <!-- Mobile Filters Collapse -->
                        <div class="collapse mt-2" id="mobileFilters">
                            <div class="d-flex flex-column gap-2">
                                <select class="form-select form-select-sm"
                                        @bind="statusFilter"
                                        @bind:after="OnFilterChanged">
                                    <option value="">All Status</option>
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                                <select class="form-select form-select-sm"
                                        @bind="featuredFilter"
                                        @bind:after="OnFilterChanged">
                                    <option value="">All Types</option>
                                    <option value="true">Featured</option>
                                    <option value="false">Regular</option>
                                </select>
                                <button class="btn btn-sm btn-secondary" @onclick="ResetFilters">
                                    <i class="fas fa-undo me-2"></i> Reset
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Desktop Filter Section -->
            <div class="d-none d-md-block card mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" class="form-control" placeholder="Search specializations..."
                                       @bind="searchTerm"
                                       @bind:after="OnSearchInput" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select"
                                    @bind="statusFilter"
                                    @bind:after="OnFilterChanged">
                                <option value="">All Status</option>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select"
                                    @bind="featuredFilter"
                                    @bind:after="OnFilterChanged">
                                <option value="">All Types</option>
                                <option value="true">Featured</option>
                                <option value="false">Regular</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary flex-grow-1" @onclick="NavigateToCreate">
                                    <i class="fas fa-plus me-2"></i> Create
                                </button>
                                <button class="btn btn-secondary" @onclick="ResetFilters">
                                    <i class="fas fa-undo me-2"></i> Reset
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Specializations List -->
            <div class="d-block d-md-none">
                <div class="d-flex justify-content-between align-items-center mb-2 px-2">
                    <h6 class="mb-0">Specializations (@filteredSpecializations.Count)</h6>
                    <small class="text-muted">Page @currentPage of @totalPages</small>
                </div>

                @if (!filteredSpecializations.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-layer-group fa-3x text-muted mb-3"></i>
                        <h6>No specializations found</h6>
                        <p class="text-muted small">@(isFiltered ? "Try changing your filters" : "Create your first specialization to get started")</p>
                        @if (!isFiltered)
                        {
                            <button class="btn btn-primary btn-sm mt-2" @onclick="NavigateToCreate">
                                <i class="fas fa-plus me-2"></i> Create Specialization
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="specialization-list px-2">
                        @foreach (var spec in paginatedSpecializations)
                        {
                            var imageUrl = ImageUrlService.GetImageUrl(spec.ThumbnailUrl);

                            <div class="card mb-2 specialization-card @(spec.IsActive ? "" : "bg-light")">
                                <div class="card-body p-2">
                                    <!-- Header with thumbnail and title -->
                                    <div class="d-flex gap-2 mb-2">
                                        <div class="flex-shrink-0">
                                            @if (!string.IsNullOrEmpty(imageUrl))
                                            {
                                                <img src="@imageUrl"
                                                     alt="@spec.Title"
                                                     class="rounded"
                                                     style="width: 60px; height: 40px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded d-flex align-items-center justify-content-center"
                                                     style="width: 60px; height: 40px; background-color: #f8f9fa; border: 1px solid #dee2e6;">
                                                    <i class="fas fa-layer-group text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h6 class="mb-1">@spec.Title</h6>
                                                    <div class="d-flex gap-2 align-items-center">
                                                        <span class="badge bg-success">$@spec.Price.ToString("N0")</span>
                                                        @if (spec.IsFeatured)
                                                        {
                                                            <span class="badge bg-warning text-dark">
                                                                <i class="fas fa-star"></i>
                                                            </span>
                                                        }
                                                        <span class="badge @(spec.IsActive ? "bg-success" : "bg-secondary")">
                                                            @(spec.IsActive ? "Active" : "Inactive")
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Stats row -->
                                    <div class="row g-1 mb-2 text-center small">
                                        <div class="col-3">
                                            <div class="bg-light rounded p-1">
                                                <i class="fas fa-clock text-info"></i>
                                                <div>@spec.EstimatedDurationHours h</div>
                                            </div>
                                        </div>
                                        <div class="col-3">
                                            <div class="bg-light rounded p-1">
                                                <i class="fas fa-book text-primary"></i>
                                                <div>@(spec.Courses?.Count ?? 0)</div>
                                            </div>
                                        </div>
                                        <div class="col-3">
                                            <div class="bg-light rounded p-1">
                                                <i class="fas fa-users text-success"></i>
                                                <div>@spec.TotalEnrollments</div>
                                            </div>
                                        </div>
                                        <div class="col-3">
                                            <div class="bg-light rounded p-1">
                                                <i class="fas fa-star text-warning"></i>
                                                <div>@spec.AverageRating.ToString("0.0")</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Description (if available) -->
                                    @if (!string.IsNullOrEmpty(spec.Description))
                                    {
                                        <p class="small text-muted mb-2">
                                            @(spec.Description.Length > 80 ? spec.Description.Substring(0, 80) + "..." : spec.Description)
                                        </p>
                                    }

                                    <!-- Action buttons -->
                                    <div class="d-flex gap-1 mt-2">
                                        <button class="btn btn-sm btn-outline-info flex-fill" @onclick="() => ViewSpecialization(spec.Id)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => EditSpecialization(spec.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-success flex-fill" @onclick="() => ManageCourses(spec.Id)">
                                            <i class="fas fa-book"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="async () => await ConfirmDelete(spec.Id, spec.Title)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Mobile Pagination -->
                    @if (totalPages > 1)
                    {
                        <div class="d-flex justify-content-center align-items-center gap-2 mt-3">
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => ChangePage(currentPage - 1)"
                                    disabled="@(currentPage == 1)">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <span class="mx-2">Page @currentPage of @totalPages</span>
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => ChangePage(currentPage + 1)"
                                    disabled="@(currentPage == totalPages)">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    }
                }
            </div>

            <!-- Desktop Specializations Table -->
            <div class="d-none d-md-block card">
                <div class="card-header">
                    <h5 class="mb-0">Specializations (@filteredSpecializations.Count)</h5>
                </div>
                <div class="card-body">
                    @if (!filteredSpecializations.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-layer-group fa-3x text-muted mb-3"></i>
                            <h5>No specializations found</h5>
                            <p class="text-muted">@(isFiltered ? "Try changing your filters" : "Create your first specialization to get started")</p>
                            @if (!isFiltered)
                            {
                                <button class="btn btn-primary mt-3" @onclick="NavigateToCreate">
                                    <i class="fas fa-plus me-2"></i> Create Specialization
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Thumbnail</th>
                                        <th>Title</th>
                                        <th>Price</th>
                                        <th>Duration</th>
                                        <th>Courses</th>
                                        <th>Students</th>
                                        <th>Rating</th>
                                        <th>Created</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var spec in paginatedSpecializations)
                                    {
                                        var imageUrl = ImageUrlService.GetImageUrl(spec.ThumbnailUrl);

                                        <tr class="@(spec.IsActive ? "" : "table-secondary")">
                                            <td>
                                                @if (!string.IsNullOrEmpty(imageUrl))
                                                {
                                                    <img src="@imageUrl"
                                                         alt="@spec.Title"
                                                         class="specialization-thumbnail rounded"
                                                         style="width: 60px; height: 40px; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <div class="specialization-thumbnail-placeholder rounded d-flex align-items-center justify-content-center"
                                                         style="width: 60px; height: 40px; background-color: #f8f9fa; border: 1px solid #dee2e6;">
                                                        <i class="fas fa-layer-group text-muted"></i>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div>
                                                    <strong class="@(spec.IsActive ? "" : "text-muted")">@spec.Title</strong>
                                                    @if (!string.IsNullOrEmpty(spec.Description) && spec.Description.Length > 100)
                                                    {
                                                        <div class="text-muted small">
                                                            @spec.Description.Substring(0, 100)...
                                                        </div>
                                                    }
                                                    else if (!string.IsNullOrEmpty(spec.Description))
                                                    {
                                                        <div class="text-muted small">
                                                            @spec.Description
                                                        </div>
                                                    }
                                                    @if (spec.IsFeatured)
                                                    {
                                                        <span class="badge bg-warning text-dark mt-1">
                                                            <i class="fas fa-star me-1"></i> Featured
                                                        </span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <span class="fw-bold text-success">$@spec.Price.ToString("N2")</span>
                                            </td>
                                            <td>
                                                <div class="text-nowrap">
                                                    <i class="fas fa-clock me-1"></i> @spec.EstimatedDurationHours hrs
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">
                                                    <i class="fas fa-book me-1"></i> @(spec.Courses?.Count ?? 0)
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-users text-info me-1"></i>
                                                    <span>@spec.TotalEnrollments</span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="rating-stars me-2">
                                                        @{
                                                            var rating = (int)Math.Round(spec.AverageRating);
                                                            var hasHalfStar = Convert.ToDecimal(spec.AverageRating) - Math.Floor(spec.AverageRating) >= 0.5m;
                                                        }
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            if (i <= rating)
                                                            {
                                                                <i class="fas fa-star text-warning" style="font-size: 12px;"></i>
                                                            }
                                                            else if (i == rating + 1 && hasHalfStar)
                                                            {
                                                                <i class="fas fa-star-half-alt text-warning" style="font-size: 12px;"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="far fa-star text-muted" style="font-size: 12px;"></i>
                                                            }
                                                        }
                                                    </div>
                                                    <span>@spec.AverageRating.ToString("0.0")</span>
                                                </div>
                                            </td>
                                            <td>
                                                <small class="text-muted d-block">
                                                    @spec.CreatedAt.ToString("MMM dd, yyyy")
                                                </small>
                                                <small class="text-muted">
                                                    @spec.CreatedAt.ToString("hh:mm tt")
                                                </small>
                                            </td>
                                            <td>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           role="switch"
                                                           id="specialization-@spec.Id"
                                                           checked="@spec.IsActive"
                                                           @onchange="async (e) => await ToggleSpecializationStatus(spec.Id, (bool)e.Value)">
                                                    <label class="form-check-label" for="specialization-@spec.Id">
                                                        @if (spec.IsActive)
                                                        {
                                                            <span class="badge bg-success">Active</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Inactive</span>
                                                        }
                                                    </label>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-info" @onclick="() => ViewSpecialization(spec.Id)"
                                                            title="View Specialization">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button class="btn btn-outline-primary"
                                                            @onclick="() => EditSpecialization(spec.Id)"
                                                            title="Edit Specialization">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-outline-success"
                                                            @onclick="() => ManageCourses(spec.Id)"
                                                            title="Manage Courses">
                                                        <i class="fas fa-book"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger"
                                                            @onclick="async () => await ConfirmDelete(spec.Id, spec.Title)"
                                                            title="Delete Specialization">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Desktop Pagination -->
                        @if (totalPages > 1)
                        {
                            <nav aria-label="Specializations pagination" class="mt-4">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(1)">
                                            <i class="fas fa-angle-double-left"></i>
                                        </button>
                                    </li>
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">
                                            <i class="fas fa-angle-left"></i>
                                        </button>
                                    </li>

                                    @for (int i = startPage; i <= endPage; i++)
                                    {
                                        <li class="page-item @(i == currentPage ? "active" : "")">
                                            <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
                                        </li>
                                    }

                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">
                                            <i class="fas fa-angle-right"></i>
                                        </button>
                                    </li>
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(totalPages)">
                                            <i class="fas fa-angle-double-right"></i>
                                        </button>
                                    </li>
                                </ul>
                                <div class="text-center mt-2">
                                    <small class="text-muted">
                                        Showing @((currentPage - 1) * pageSize + 1)-@Math.Min(currentPage * pageSize, filteredSpecializations.Count)
                                        of @filteredSpecializations.Count specializations
                                    </small>
                                </div>
                            </nav>
                        }
                    }
                </div>
            </div>

            <!-- Mobile Quick Actions -->
            <div class="d-block d-md-none mt-3">
                <div class="card">
                    <div class="card-header bg-white py-2">
                        <h6 class="mb-0">Quick Actions</h6>
                    </div>
                    <div class="card-body p-2">
                        <div class="row g-2">
                            <div class="col-6">
