@code {
    // ... (keep all your existing code in the @code block exactly as is)
    private List<SpecializationDto> allSpecializations = new();
    private List<SpecializationDto> filteredSpecializations = new();
    private List<SpecializationDto> paginatedSpecializations = new();
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private string? errorMessage = null;
    private string? successMessage = null;
    private UserDto? currentUser;

    // Stats
    private int totalCount = 0;
    private int activeCount = 0;
    private int totalStudents = 0;
    private decimal totalRevenue = 0;

    // Filtering
    private string searchTerm = "";
    private string? statusFilter = null;
    private string? featuredFilter = null;
    private bool isFiltered = false;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private int startPage = 1;
    private int endPage = 1;

    private void GoBack()
    {
        Navigation.NavigateTo("/doctor/dashboard");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CheckAuthentication();

            if (isAuthenticated && currentUser?.UserType == UserType.Doctor)
            {
                await LoadData();
            }
            else
            {
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            Console.WriteLine($"Error initializing page: {ex.Message}");
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();

                if (currentUser?.UserType != UserType.Doctor)
                {
                    errorMessage = "Access denied. Doctor access required.";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            currentUser = null;
        }
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Load doctor's specializations
            await LoadSpecializations();

            // Calculate stats
            CalculateStats();

            // Apply initial filters
            await SearchSpecializations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadSpecializations()
    {
        try
        {
            var specs = await SpecializationService.GetMySpecializationsAsync();
            if (specs != null)
            {
                allSpecializations = specs.OrderBy(s => s.Title).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading specializations: {ex.Message}");
        }
    }

    private void CalculateStats()
    {
        try
        {
            totalCount = allSpecializations.Count;
            activeCount = allSpecializations.Count(s => s.IsActive);
            totalStudents = allSpecializations.Sum(s => s.TotalEnrollments);
            totalRevenue = allSpecializations.Sum(s => s.Price * s.TotalEnrollments);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating stats: {ex.Message}");
        }
    }

    // Filter methods
    private async Task OnSearchInput()
    {
        currentPage = 1;
        await SearchSpecializations();
    }

    private async Task OnFilterChanged()
    {
        currentPage = 1;
        await SearchSpecializations();
    }

    private async Task ResetFilters()
    {
        searchTerm = "";
        statusFilter = null;
        featuredFilter = null;
        currentPage = 1;
        await SearchSpecializations();
    }

    private async Task SearchSpecializations()
    {
        try
        {
            // Start with all specializations
            filteredSpecializations = allSpecializations.ToList();

            // Apply text search
            if (!string.IsNullOrEmpty(searchTerm))
            {
                filteredSpecializations = filteredSpecializations
                    .Where(s => s.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                               (s.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                    .ToList();
            }

            // Apply status filter
            if (!string.IsNullOrEmpty(statusFilter))
            {
                bool isActive = statusFilter.ToLower() == "true";
                filteredSpecializations = filteredSpecializations
                    .Where(s => s.IsActive == isActive)
                    .ToList();
            }

            // Apply featured filter
            if (!string.IsNullOrEmpty(featuredFilter))
            {
                bool isFeatured = featuredFilter.ToLower() == "true";
                filteredSpecializations = filteredSpecializations
                    .Where(s => s.IsFeatured == isFeatured)
                    .ToList();
            }

            // Update filtered state
            isFiltered = !string.IsNullOrEmpty(searchTerm) ||
                        !string.IsNullOrEmpty(statusFilter) ||
                        !string.IsNullOrEmpty(featuredFilter);

            // Update pagination
            UpdatePagination();

            // Get current page data
            paginatedSpecializations = filteredSpecializations
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();

            // Update UI
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error searching specializations: {ex.Message}";
            Console.WriteLine($"Error searching specializations: {ex.Message}");
        }
    }

    private void UpdatePagination()
    {
        totalPages = (int)Math.Ceiling((double)filteredSpecializations.Count / pageSize);
        if (totalPages < 1) totalPages = 1;

        if (currentPage > totalPages)
            currentPage = 1;

        int visiblePages = 5;
        startPage = Math.Max(1, currentPage - visiblePages / 2);
        endPage = Math.Min(totalPages, startPage + visiblePages - 1);

        if (endPage - startPage + 1 < visiblePages)
        {
            startPage = Math.Max(1, endPage - visiblePages + 1);
        }
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages || page == currentPage)
            return;

        currentPage = page;
        _ = SearchSpecializations();
    }

    private async Task ConfirmDelete(int specializationId, string specializationTitle)
    {
        try
        {
            bool confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Are you sure you want to delete specialization '{specializationTitle}'? This will also delete all associated courses, lectures, and materials.");

            if (confirmed)
            {
                var result = await SpecializationService.DeleteSpecializationAsync(specializationId);

                if (result)
                {
                    successMessage = $"Specialization '{specializationTitle}' deleted successfully.";

                    // Reload data
                    await LoadData();
                }
                else
                {
                    errorMessage = $"Failed to delete specialization '{specializationTitle}'.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting specialization: {ex.Message}";
            Console.WriteLine($"Error deleting specialization: {ex.Message}");
        }
    }

    private async Task ToggleSpecializationStatus(int specializationId, bool isActive)
    {
        try
        {
            var result = await SpecializationService.UpdateSpecializationStatusAsync(specializationId, isActive);
            if (result)
            {
                // Update local specialization status
                var spec = allSpecializations.FirstOrDefault(s => s.Id == specializationId);
                if (spec != null)
                {
                    spec.IsActive = isActive;
                    await SearchSpecializations();

                    successMessage = $"Specialization {(isActive ? "activated" : "deactivated")} successfully.";
                }
            }
            else
            {
                errorMessage = "Failed to update specialization status.";
                // Revert the toggle
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"Error toggling specialization status: {ex.Message}");
            // Revert the toggle
            StateHasChanged();
        }
    }

    private void ViewSpecialization(int specializationId)
    {
        Navigation.NavigateTo($"/specialization/{specializationId}");
    }

    private void EditSpecialization(int specializationId)
    {
        Navigation.NavigateTo($"/createspecialization/{specializationId}");
    }

    private void ManageCourses(int specializationId)
    {
        Navigation.NavigateTo($"/content/courses?specializationId={specializationId}");
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/createspecialization");
    }

    private void NavigateToCourses()
    {
        Navigation.NavigateTo("/content/courses");
    }

    private void NavigateToLectures()
    {
        Navigation.NavigateTo("/content/lectures");
    }

    private async Task ExportSpecializations()
    {
        try
        {
            var csv = new System.Text.StringBuilder();
            csv.AppendLine("Doctor Specializations Report");
            csv.AppendLine($"Generated: {DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")}");
            csv.AppendLine($"Doctor: {currentUser?.FirstName} {currentUser?.LastName}");
            csv.AppendLine($"Email: {currentUser?.Email}");
            csv.AppendLine();

            csv.AppendLine("SPECIALIZATION DETAILS");
            csv.AppendLine("ID,Title,Price,Duration (hrs),Courses,Students,Rating,Featured,Status,Created");

            foreach (var spec in filteredSpecializations)
            {
                csv.AppendLine($"\"{spec.Id}\",\"{spec.Title}\",\"${spec.Price:N2}\",\"{spec.EstimatedDurationHours}\",\"{spec.Courses?.Count ?? 0}\",\"{spec.TotalEnrollments}\",\"{spec.AverageRating:0.0}\",\"{(spec.IsFeatured ? "Yes" : "No")}\",\"{(spec.IsActive ? "Active" : "Inactive")}\",\"{spec.CreatedAt:yyyy-MM-dd}\"");
            }

            var fileName = $"Specializations_Report_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await JS.InvokeVoidAsync("downloadCSV", fileName, csv.ToString());

            successMessage = "Report exported successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to export report: {ex.Message}";
        }
    }
}

