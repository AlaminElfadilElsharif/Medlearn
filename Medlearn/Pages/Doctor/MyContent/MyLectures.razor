<!-- Bulk Actions Modal - Mobile Optimized -->
<div class="modal @(showBulkModal ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-layer-group me-2 text-primary"></i>
                    Bulk Material Upload
                </h5>
                <button type="button" class="btn-close" @onclick="() => showBulkModal = false"></button>
            </div>
            <div class="modal-body">
                @if (selectedLecturesForBulk.Any())
                {
                    <div class="alert alert-info d-flex align-items-center">
                        <i class="fas fa-info-circle me-2"></i>
                        <span>Selected <strong>@selectedLecturesForBulk.Count</strong> lectures</span>
                    </div>
                    
                    <!-- File Upload - Mobile Optimized -->
                    <div class="mb-4">
                        <label class="form-label fw-bold">Upload Materials</label>
                        <div class="upload-area-mobile p-4 text-center border rounded bg-light"
                             @onclick="TriggerFileUpload">
                            <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-3"></i>
                            <p class="mb-2 fw-bold">Tap to browse files</p>
                            <p class="text-muted small mb-0">Supports: PDF, Video, Audio, Images</p>
                            <p class="text-muted small">Max file size: 100MB</p>
                        </div>
                        <input type="file" id="bulk-file-input" class="d-none" multiple 
                               @onchange="HandleBulkFileUpload" />
                        
                        @if (bulkFiles.Any())
                        {
                            <div class="mt-3">
                                <label class="form-label small fw-bold">Selected Files</label>
                                @foreach (var file in bulkFiles)
                                {
                                    <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded mb-1">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-file me-2 text-primary"></i>
                                            <small>@file.Name</small>
                                        </div>
                                        <small class="text-muted">@((file.Size / 1024).ToString("N0")) KB</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    
                    <!-- Selected Lectures List -->
                    <div class="mb-4">
                        <label class="form-label fw-bold">Selected Lectures</label>
                        <div class="selected-lectures-list" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var lectureId in selectedLecturesForBulk)
                            {
                                var lecture = allLectures.FirstOrDefault(l => l.Id == lectureId);
                                if (lecture != null)
                                {
                                    <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded mb-1">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-video text-primary me-2"></i>
                                            <small class="fw-bold">@lecture.Title</small>
                                        </div>
                                        <button class="btn btn-sm btn-link text-danger p-0" 
                                                @onclick="() => RemoveFromBulkSelection(lectureId)">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-clipboard-list fa-4x text-muted mb-3"></i>
                        <h6 class="fw-bold">No Lectures Selected</h6>
                        <p class="text-muted small">Select lectures from the list to perform bulk actions</p>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => showBulkModal = false">
                    Cancel
                </button>
                @if (selectedLecturesForBulk.Any())
                {
                    <button type="button" class="btn btn-primary" @onclick="ProcessBulkUpload">
                        <i class="fas fa-upload me-2"></i>
                        Upload to @selectedLecturesForBulk.Count Lecture@(selectedLecturesForBulk.Count > 1 ? "s" : "")
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
