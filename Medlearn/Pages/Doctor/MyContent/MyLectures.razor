@page "/content/lectures"


<PageTitle>My Lectures</PageTitle>

<div class="my-lectures">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none mb-3">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick='() => Navigation.NavigateTo("/doctor/dashboard")'>
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <div class="flex-grow-1">
                        <h5 class="mb-0">My Lectures</h5>
                        <small class="opacity-75">Manage your content</small>
                    </div>
                    <button class="btn btn-light btn-sm" @onclick="NavigateToCreateLecture">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-block mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="mb-1">My Lectures</h1>
                    <p class="text-muted mb-0">Manage your lecture materials and content</p>
                </div>
                @if (isAuthenticated && currentUser?.UserType == UserType.Doctor)
                {
                    <div class="d-flex align-items-center">
                        <span class="text-muted me-3 d-none d-lg-inline">Select a course to add lecture</span>
                        <button class="btn btn-primary" @onclick="NavigateToCreateLecture">
                            <i class="fas fa-plus me-2"></i> Create Lecture
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Alert Messages -->
        @if (errorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mx-3 mx-md-0" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (successMessage != null)
        {
            <div class="alert alert-success alert-dismissible fade show mx-3 mx-md-0" role="alert">
                @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
            </div>
        }

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted">Loading lectures...</p>
            </div>
        }
        else if (!isAuthenticated)
        {
            <!-- Not Authenticated - Mobile & Desktop -->
            <div class="text-center py-5 mx-3">
                <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                <h5 class="mb-2">Authentication Required</h5>
                <p class="text-muted mb-4">Please log in to view your lectures</p>
                <button class="btn btn-primary px-4" @onclick='() => Navigation.NavigateTo("/account/login")'>
                    <i class="fas fa-sign-in-alt me-2"></i> Login
                </button>
            </div>
        }
        else if (currentUser?.UserType != UserType.Doctor)
        {
            <!-- Not a Doctor - Mobile & Desktop -->
            <div class="text-center py-5 mx-3">
                <i class="fas fa-user-md fa-3x text-muted mb-3"></i>
                <h5 class="mb-2">Doctor Access Required</h5>
                <p class="text-muted mb-4">You need to be logged in as a doctor to access this page</p>
                <button class="btn btn-primary px-4" @onclick='() => Navigation.NavigateTo("/")'>
                    <i class="fas fa-home me-2"></i> Go Home
                </button>
            </div>
        }
        else
        {
            <!-- Authenticated Doctor View -->
            
            <!-- Stats Cards - Responsive Grid -->
            <div class="row g-2 g-md-3 mb-4 mx-1 mx-md-0">
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Total Lectures</h6>
                                    <h3 class="mb-0">@totalLecturesCount</h3>
                                </div>
                                <i class="fas fa-video fa-2x text-primary opacity-75"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Free Previews</h6>
                                    <h3 class="mb-0">@freePreviewsCount</h3>
                                </div>
                                <i class="fas fa-eye fa-2x text-success opacity-75"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Materials</h6>
                                    <h3 class="mb-0">@totalMaterials</h3>
                                </div>
                                <i class="fas fa-file-alt fa-2x text-info opacity-75"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Duration</h6>
                                    <h3 class="mb-0">@totalDuration h</h3>
                                </div>
                                <i class="fas fa-clock fa-2x text-warning opacity-75"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Filter Bar -->
            <div class="d-block d-md-none mb-3 mx-3">
                <div class="d-flex gap-2">
                    <div class="flex-grow-1">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 ps-0" 
                                   placeholder="Search lectures..." 
                                   @bind="searchTerm" 
                                   @bind:after="OnSearchInput" />
                        </div>
                    </div>
                    <button class="btn btn-outline-secondary" type="button" 
                            data-bs-toggle="collapse" data-bs-target="#mobileFilters">
                        <i class="fas fa-filter"></i>
                    </button>
                </div>
                
                <!-- Mobile Filters Collapse -->
                <div class="collapse mt-2" id="mobileFilters">
                    <div class="card">
                        <div class="card-body">
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Course</label>
                                <select class="form-select form-select-sm" 
                                        @bind="selectedCourseId" 
                                        @bind:after="OnFilterChanged">
                                    <option value="0">All Courses</option>
                                    @foreach (var course in myCourses)
                                    {
                                        <option value="@course.Id">@course.Title</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Type</label>
                                <select class="form-select form-select-sm" 
                                        @bind="freePreviewFilter" 
                                        @bind:after="OnFilterChanged">
                                    <option value="">All Types</option>
                                    <option value="true">Free Previews</option>
                                    <option value="false">Paid Lectures</option>
                                </select>
                            </div>
                            <div class="d-grid gap-2 mt-3">
                                <button class="btn btn-primary btn-sm" @onclick="NavigateToCreateLecture">
                                    <i class="fas fa-plus me-2"></i> Create Lecture
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="ResetFilters">
                                    <i class="fas fa-undo me-2"></i> Reset Filters
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Desktop Filter Section -->
            <div class="d-none d-md-block card mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" class="form-control" placeholder="Search lectures..." 
                                       @bind="searchTerm" 
                                       @bind:after="OnSearchInput" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" 
                                    @bind="selectedCourseId" 
                                    @bind:after="OnFilterChanged">
                                <option value="0">All Courses</option>
                                @foreach (var course in myCourses)
                                {
                                    <option value="@course.Id">@course.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select class="form-select" 
                                    @bind="freePreviewFilter" 
                                    @bind:after="OnFilterChanged">
                                <option value="">All Types</option>
                                <option value="true">Free Previews</option>
                                <option value="false">Paid Lectures</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary flex-grow-1" @onclick="NavigateToCreateLecture">
                                    <i class="fas fa-plus me-2"></i> Create Lecture
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="ResetFilters">
                                    <i class="fas fa-undo"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lectures List/Grid -->
            <div class="card mx-3 mx-md-0">
                <div class="card-header bg-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            Lectures 
                            <span class="badge bg-primary rounded-pill ms-2">@filteredLectures.Count</span>
                        </h6>
                        <!-- Mobile Bulk Action Toggle -->
                        <button class="btn btn-sm btn-outline-primary d-block d-md-none" 
                                @onclick="ShowBulkActionsModal">
                            <i class="fas fa-layer-group me-1"></i> Bulk
                        </button>
                    </div>
                </div>
                
                <div class="card-body p-0">
                    @if (!filteredLectures.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-video fa-3x text-muted mb-3"></i>
                            <h5 class="mb-2">No lectures found</h5>
                            <p class="text-muted px-4">@(isFiltered ? "Try changing your filters" : "Create your first lecture to add content")</p>
                            @if (!isFiltered)
                            {
                                <button class="btn btn-primary mt-3" @onclick="NavigateToCreateLecture">
                                    <i class="fas fa-plus me-2"></i> Create Lecture
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Mobile Card View -->
                        <div class="d-block d-md-none">
                            @foreach (var lecture in paginatedLectures)
                            {
                                var course = myCourses.FirstOrDefault(c => c.Id == lecture.CourseId);
                                var thumbnailUrl = lecture.Materials
                                    ?.FirstOrDefault(m => !string.IsNullOrEmpty(m.ThumbnailUrl))
                                    ?.ThumbnailUrl;
                                
                                <div class="lecture-card-mobile p-3 border-bottom">
                                    <!-- Mobile Lecture Card Header -->
                                    <div class="d-flex mb-2">
                                        <!-- Thumbnail -->
                                        <div class="me-2">
                                            @if (!string.IsNullOrEmpty(thumbnailUrl))
                                            {
                                                <img src="@ImageUrlService.GetImageUrl(thumbnailUrl)" 
                                                     alt="@lecture.Title"
                                                     class="rounded"
                                                     style="width: 50px; height: 35px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded d-flex align-items-center justify-content-center"
                                                     style="width: 50px; height: 35px; background-color: #f8f9fa; border: 1px solid #dee2e6;">
                                                    <i class="fas fa-video text-muted small"></i>
                                                </div>
                                            }
                                        </div>
                                        
                                        <!-- Title and Course -->
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h6 class="mb-1 fw-bold">@lecture.Title</h6>
                                                    <small class="text-muted d-block">
                                                        <i class="fas fa-folder me-1"></i> @course?.Title
                                                    </small>
                                                </div>
                                                <!-- Status Toggle (Mobile) -->
                                                <div class="form-check form-switch ms-2">
                                                    <input class="form-check-input lecture-status-toggle" 
                                                           type="checkbox" 
                                                           id="mobile-lecture-@lecture.Id"
                                                           checked="@lecture.IsActive"
                                                           @onchange="async (e) => await ToggleLectureStatus(lecture.Id, (bool)e.Value)">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Mobile Lecture Details -->
                                    <div class="row g-2 mb-2 small">
                                        <div class="col-4">
                                            <span class="badge @(lecture.IsFreePreview ? "bg-success" : "bg-warning text-dark") w-100">
                                                @if (lecture.IsFreePreview)
                                                {
                                                    <i class="fas fa-unlock me-1"></i>
                                                    <span>Free </span >
                                                }
                                                else
                                                {
                                                    <i class="fas fa-dollar-sign me-1"></i> @lecture.Price.ToString("N2")
                                                }
                                            </span>
                                        </div>
                                        <div class="col-4">
                                            <span class="badge bg-info w-100">
                                                <i class="fas fa-clock me-1"></i> @lecture.EstimatedDurationMinutes min
                                            </span>
                                        </div>
                                        <div class="col-4">
                                            <span class="badge bg-secondary w-100">
                                                <i class="fas fa-folder me-1"></i> @(lecture.Materials?.Count ?? 0)
                                            </span>
                                        </div>
                                    </div>
                                    
                                    <!-- Mobile Description (if exists) -->
                                    @if (!string.IsNullOrEmpty(lecture.Description))
                                    {
                                        <p class="small text-muted mb-2">
                                            @(lecture.Description.Length > 80 ? lecture.Description.Substring(0, 80) + "..." : lecture.Description)
                                        </p>
                                    }
                                    
                                    <!-- Mobile Action Buttons -->
                                    <div class="d-flex gap-2 mt-2">
                                        <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => ViewLecture(lecture.Id)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary flex-fill" 
                                                @onclick="() => EditLecture(lecture.CourseId, lecture.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-info flex-fill" 
                                                @onclick="() => ManageMaterials(lecture.Id)">
                                            <i class="fas fa-file-alt"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger flex-fill" 
                                                @onclick="async () => await ConfirmDelete(lecture.Id, lecture.Title)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Desktop Table View -->
                        <div class="d-none d-md-block table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-3">Thumbnail</th>
                                        <th>Title</th>
                                        <th>Course</th>
                                        <th>Type</th>
                                        <th>Duration</th>
                                        <th>Materials</th>
                                        <th>Order</th>
                                        <th>Created</th>
                                        <th>Status</th>
                                        <th class="pe-3">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lecture in paginatedLectures)
                                    {
                                        var course = myCourses.FirstOrDefault(c => c.Id == lecture.CourseId);
                                        var thumbnailUrl = lecture.Materials
                                            ?.FirstOrDefault(m => !string.IsNullOrEmpty(m.ThumbnailUrl))
                                            ?.ThumbnailUrl;
                                        <tr>
                                            <td class="ps-3">
                                                @if (!string.IsNullOrEmpty(thumbnailUrl))
                                                {
                                                    <img src="@ImageUrlService.GetImageUrl(thumbnailUrl)" 
                                                         alt="@lecture.Title"
                                                         class="lecture-thumbnail rounded"
                                                         style="width: 60px; height: 40px; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <div class="lecture-thumbnail-placeholder rounded d-flex align-items-center justify-content-center"
                                                         style="width: 60px; height: 40px; background-color: #f8f9fa; border: 1px solid #dee2e6;">
                                                        <i class="fas fa-video text-muted"></i>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div>
                                                    <strong>@lecture.Title</strong>
                                                    @if (!string.IsNullOrEmpty(lecture.Description))
                                                    {
                                                        <div class="text-muted small">
                                                            @(lecture.Description.Length > 50 ? lecture.Description.Substring(0, 50) + "..." : lecture.Description)
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                @if (course != null)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                                        {
                                                            <img src="@ImageUrlService.GetImageUrl(course.ThumbnailUrl)" 
                                                                 alt="@course.Title"
                                                                 class="rounded me-2"
                                                                 style="width: 30px; height: 30px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="bg-light rounded d-flex align-items-center justify-content-center me-2"
                                                                 style="width: 30px; height: 30px;">
                                                                <i class="fas fa-folder text-muted"></i>
                                                            </div>
                                                        }
                                                        <span class="text-truncate" style="max-width: 150px;" title="@course.Title">
                                                            @course.Title
                                                        </span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unknown Course</span>
                                                }
                                            </td>
                                            <td>
                                                @if (lecture.IsFreePreview)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-unlock me-1"></i> Free
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        <i class="fas fa-dollar-sign me-1"></i> $@lecture.Price.ToString("N2")
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-info">
                                                    <i class="fas fa-clock me-1"></i> @lecture.EstimatedDurationMinutes min
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">
                                                    <i class="fas fa-folder me-1"></i> @(lecture.Materials?.Count ?? 0)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-dark">@lecture.Order</span>
                                            </td>
                                            <td>
                                                <small class="text-muted d-block">
                                                    @lecture.CreatedAt.ToString("MMM dd")
                                                </small>
                                            </td>
                                            <td>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input lecture-status-toggle" 
                                                           type="checkbox" 
                                                           id="lecture-@lecture.Id"
                                                           checked="@lecture.IsActive"
                                                           @onchange="async (e) => await ToggleLectureStatus(lecture.Id, (bool)e.Value)">
                                                    <label class="form-check-label" for="lecture-@lecture.Id">
                                                        @if (lecture.IsActive)
                                                        {
                                                            <span class="badge bg-success">Active</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Inactive</span>
                                                        }
                                                    </label>
                                                </div>
                                            </td>
                                            <td class="pe-3">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-primary" @onclick="() => ViewLecture(lecture.Id)" 
                                                            title="View Lecture">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button class="btn btn-outline-secondary" 
                                                            @onclick="() => EditLecture(lecture.CourseId, lecture.Id)" 
                                                            title="Edit Lecture">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-outline-info" 
                                                            @onclick="() => ManageMaterials(lecture.Id)" 
                                                            title="Manage Materials">
                                                        <i class="fas fa-file-alt"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" 
                                                            @onclick="async () => await ConfirmDelete(lecture.Id, lecture.Title)" 
                                                            title="Delete Lecture">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- Pagination -->
                        @if (totalPages > 1)
                        {
                            <div class="p-3">
                                <nav aria-label="Lectures pagination">
                                    <ul class="pagination justify-content-center mb-0 flex-wrap">
                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => ChangePage(1)" aria-label="First">
                                                <i class="fas fa-angle-double-left"></i>
                                            </button>
                                        </li>
                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" aria-label="Previous">
                                                <i class="fas fa-angle-left"></i>
                                            </button>
                                        </li>
                                        
                                        @for (int i = startPage; i <= endPage; i++)
                                        {
                                            <li class="page-item @(i == currentPage ? "active" : "")">
                                                <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
                                            </li>
                                        }
                                        
                                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => ChangePage(currentPage + 1)" aria-label="Next">
                                                <i class="fas fa-angle-right"></i>
                                            </button>
                                        </li>
                                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => ChangePage(totalPages)" aria-label="Last">
                                                <i class="fas fa-angle-double-right"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </nav>
                                <div class="text-center mt-2">
                                    <small class="text-muted">
                                        Showing @((currentPage - 1) * pageSize + 1)-@Math.Min(currentPage * pageSize, filteredLectures.Count) 
                                        of @filteredLectures.Count lectures
                                    </small>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Quick Actions - Mobile Floating Action Button -->
            <div class="d-block d-md-none">
                <button class="btn btn-primary fab-button" @onclick="ShowBulkActionsModal">
                    <i class="fas fa-layer-group"></i>
                </button>
            </div>

            <!-- Quick Actions - Desktop -->
            <div class="d-none d-md-block mt-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0 fw-bold">Quick Actions</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="d-grid">
                                    <button class="btn btn-primary" @onclick="NavigateToCreateLecture">
                                        <i class="fas fa-plus-circle me-2"></i>
                                        Create New Lecture
                                    </button>
                                    <small class="text-muted mt-2 text-center">
                                        Add a new lecture to your course
