    private MaterialType GetMaterialTypeFromFile(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLower();
        return extension switch
        {
            ".pdf" => MaterialType.PDF,
            ".mp4" or ".avi" or ".mov" or ".wmv" => MaterialType.Video,
            ".mp3" or ".wav" or ".ogg" => MaterialType.Audio,
            ".jpg" or ".jpeg" or ".png" or ".gif" => MaterialType.Image,
            ".ppt" or ".pptx" => MaterialType.Presentation,
            ".doc" or ".docx" => MaterialType.Document,
            _ => MaterialType.Document
        };
    }

    private async Task ExportLectures()
    {
        try
        {
            var csv = new System.Text.StringBuilder();
            csv.AppendLine("Doctor Lectures Report");
            csv.AppendLine($"Generated: {DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")}");
            csv.AppendLine($"Doctor: {currentUser?.FirstName} {currentUser?.LastName}");
            csv.AppendLine($"Email: {currentUser?.Email}");
            csv.AppendLine();
            
            csv.AppendLine("LECTURE DETAILS");
            csv.AppendLine("ID,Title,Course,Type,Price,Duration (min),Materials,Created,Status");
            
            foreach (var lecture in filteredLectures)
            {
                var course = myCourses.FirstOrDefault(c => c.Id == lecture.CourseId);
                var courseName = course?.Title ?? "Unknown";
                var type = lecture.IsFreePreview ? "Free" : "Paid";
                var price = lecture.IsFreePreview ? "0" : lecture.Price.ToString("N2");
                
                csv.AppendLine($"\"{lecture.Id}\",\"{lecture.Title}\",\"{courseName}\",\"{type}\",\"${price}\",\"{lecture.EstimatedDurationMinutes}\",\"{lecture.Materials?.Count ?? 0}\",\"{lecture.CreatedAt:yyyy-MM-dd}\",\"{(lecture.IsActive ? "Active" : "Inactive")}\"");
            }

            var fileName = $"Lectures_Report_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await JS.InvokeVoidAsync("downloadCSV", fileName, csv.ToString());
            
            successMessage = "Report exported successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to export report: {ex.Message}";
        }
    }
}

