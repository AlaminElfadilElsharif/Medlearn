    private List<LectureDto> allLectures = new();
    private List<LectureDto> filteredLectures = new();
    private List<LectureDto> paginatedLectures = new();
    private List<CourseDto> myCourses = new();
    private List<SpecializationDto> mySpecializations = new();
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private string? errorMessage = null;
    private string? successMessage = null;
    private UserDto? currentUser;
    
    // Stats
    private int totalLecturesCount = 0;
    private int freePreviewsCount = 0;
    private int totalMaterials = 0;
    private int totalDuration = 0;
    
    // Filtering
    private string searchTerm = "";
    private int selectedCourseId = 0;
    private string? freePreviewFilter = null;
    private bool isFiltered = false;
    
    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private int startPage = 1;
    private int endPage = 1;
    
    // Bulk Actions
    private bool showBulkModal = false;
    private List<int> selectedLecturesForBulk = new();
    private List<IBrowserFile> bulkFiles = new();

    // ... rest of your existing @code methods
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CheckAuthentication();
            
            if (isAuthenticated && currentUser?.UserType == UserType.Doctor)
            {
                await LoadData();
            }
            else
            {
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            Console.WriteLine($"Error initializing page: {ex.Message}");
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();
            
            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();
                
                if (currentUser?.UserType != UserType.Doctor)
                {
                    errorMessage = "Access denied. Doctor access required.";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            currentUser = null;
        }
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            // Load doctor's specializations first
            await LoadMySpecializations();
            
            // Load courses for those specializations
            await LoadMyCourses();
            
            // Load lectures for those courses
            await LoadLectures();
            
            // Calculate stats
            CalculateStats();
            
            // Apply initial filters
            await SearchLectures();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMySpecializations()
    {
        try
        {
            var specs = await SpecializationService.GetMySpecializationsAsync();
            if (specs != null)
            {
                mySpecializations = specs;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading specializations: {ex.Message}");
        }
    }

    private async Task LoadMyCourses()
    {
        try
        {
            myCourses.Clear();
            
            // For each specialization, get courses
            foreach (var spec in mySpecializations)
            {
                var coursesForSpec = await CourseService.GetCoursesBySpecializationAsync(spec.Id);
                if (coursesForSpec != null)
                {
                    // Filter courses that belong to this doctor
                    foreach (var course in coursesForSpec)
                    {
                        if (course.DoctorId == currentUser!.Id)
                        {
                            // Fix image URL using ImageUrlService
                            if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                            {
                                course.ThumbnailUrl = ImageUrlService.GetImageUrl(course.ThumbnailUrl);
                            }
                            myCourses.Add(course);
                        }
                    }
                }
            }
            
            // Sort by specialization and order
            myCourses = myCourses.OrderBy(c => c.SpecializationId)
                               .ThenBy(c => c.Order)
                               .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading courses: {ex.Message}");
        }
    }

    private async Task LoadLectures()
    {
        try
        {
            allLectures.Clear();
            
            // For each course, get lectures
            foreach (var course in myCourses)
            {
                var lecturesForCourse = await LectureService.GetLecturesByCourseAsync(course.Id);
                if (lecturesForCourse != null)
                {
                    // Fix image URLs in materials using ImageUrlService
                    foreach (var lecture in lecturesForCourse)
                    {
                        if (lecture.Materials != null)
                        {
                            foreach (var material in lecture.Materials)
                            {
                                if (!string.IsNullOrEmpty(material.ThumbnailUrl))
                                {
                                    material.ThumbnailUrl = ImageUrlService.GetImageUrl(material.ThumbnailUrl);
                                }
                                if (!string.IsNullOrEmpty(material.ContentUrl))
                                {
                                    material.ContentUrl = ImageUrlService.GetImageUrl(material.ContentUrl);
                                }
                            }
                        }
                        allLectures.Add(lecture);
                    }
                }
            }
            
            // Sort by course and order
            allLectures = allLectures.OrderBy(l => l.CourseId)
                                   .ThenBy(l => l.Order)
                                   .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading lectures: {ex.Message}");
        }
    }

    private void CalculateStats()
    {
        try
        {
            totalLecturesCount = allLectures.Count;
            freePreviewsCount = allLectures.Count(l => l.IsFreePreview);
            totalMaterials = allLectures.Sum(l => l.Materials?.Count ?? 0);
            totalDuration = (int)Math.Ceiling(allLectures.Sum(l => l.EstimatedDurationMinutes) / 60.0);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating stats: {ex.Message}");
        }
    }

    private async Task OnSearchInput()
    {
        await SearchLectures();
    }

    private async Task OnFilterChanged()
    {
        await SearchLectures();
    }

    private async Task ResetFilters()
    {
        searchTerm = "";
        selectedCourseId = 0;
        freePreviewFilter = null;
        selectedLecturesForBulk.Clear();
        currentPage = 1;
        await SearchLectures();
    }

    private async Task SearchLectures()
    {
        try
        {
            // Start with all lectures
            filteredLectures = allLectures.ToList();
            
            // Apply text search
            if (!string.IsNullOrEmpty(searchTerm))
            {
                filteredLectures = filteredLectures
                    .Where(l => l.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                               (l.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                    .ToList();
            }
            
            // Apply course filter
            if (selectedCourseId > 0)
            {
                filteredLectures = filteredLectures
                    .Where(l => l.CourseId == selectedCourseId)
                    .ToList();
            }
            
            // Apply free preview filter
            if (!string.IsNullOrEmpty(freePreviewFilter))
            {
                bool isFree = freePreviewFilter.ToLower() == "true";
                filteredLectures = filteredLectures
                    .Where(l => l.IsFreePreview == isFree)
                    .ToList();
            }
            
            // Update filtered state
            isFiltered = !string.IsNullOrEmpty(searchTerm) || 
                        selectedCourseId > 0 || 
                        !string.IsNullOrEmpty(freePreviewFilter);
            
            // Update pagination
            UpdatePagination();
            
            // Get current page data
            paginatedLectures = filteredLectures
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();
                
            // Update UI
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error searching lectures: {ex.Message}";
            Console.WriteLine($"Error searching lectures: {ex.Message}");
        }
    }

    private void UpdatePagination()
    {
        totalPages = (int)Math.Ceiling((double)filteredLectures.Count / pageSize);
        if (totalPages < 1) totalPages = 1;
        
        if (currentPage > totalPages)
            currentPage = 1;
        
        int visiblePages = 5;
        startPage = Math.Max(1, currentPage - visiblePages / 2);
        endPage = Math.Min(totalPages, startPage + visiblePages - 1);
        
        if (endPage - startPage + 1 < visiblePages)
        {
            startPage = Math.Max(1, endPage - visiblePages + 1);
        }
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages || page == currentPage)
            return;
            
        currentPage = page;
        _ = SearchLectures();
    }

    private async Task ConfirmDelete(int lectureId, string lectureTitle)
    {
        try
        {
            bool confirmed = await JS.InvokeAsync<bool>("confirm", 
                $"Are you sure you want to delete lecture '{lectureTitle}'? This will also delete all associated materials.");
            
            if (confirmed)
            {
                var result = await LectureService.DeleteLectureAsync(lectureId);
                
                if (result)
                {
                    successMessage = $"Lecture '{lectureTitle}' deleted successfully.";
                    
                    // Remove from bulk selection if present
                    selectedLecturesForBulk.Remove(lectureId);
                    
                    // Reload data
                    await LoadData();
                }
                else
                {
                    errorMessage = $"Failed to delete lecture '{lectureTitle}'.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting lecture: {ex.Message}";
            Console.WriteLine($"Error deleting lecture: {ex.Message}");
        }
    }

    private async Task ToggleLectureStatus(int lectureId, bool isActive)
    {
        try
        {
            var result = await LectureService.UpdateLectureStatusAsync(lectureId, isActive);
            if (result)
            {
                // Update local lecture status
                var lecture = allLectures.FirstOrDefault(l => l.Id == lectureId);
                if (lecture != null)
                {
                    lecture.IsActive = isActive;
                    StateHasChanged();
                    
                    successMessage = $"Lecture {(isActive ? "activated" : "deactivated")} successfully.";
                }
            }
            else
            {
                errorMessage = "Failed to update lecture status.";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"Error toggling lecture status: {ex.Message}");
            StateHasChanged();
        }
    }

