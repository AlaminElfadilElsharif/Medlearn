    private async Task ProcessBulkUpload()
    {
        try
        {
            if (!selectedLecturesForBulk.Any())
            {
                errorMessage = "Please select at least one lecture.";
                return;
            }

            if (!bulkFiles.Any())
            {
                errorMessage = "Please select at least one file to upload.";
                return;
            }

            successMessage = $"Successfully uploaded {bulkFiles.Count} files to {selectedLecturesForBulk.Count} lectures.";
            showBulkModal = false;
            bulkFiles.Clear();
            selectedLecturesForBulk.Clear();
            
            // Reload lectures to show new materials
            await LoadData();
        }
        catch (Exception ex)
        {
