    private void ConfirmDelete()
    {
        showDeleteModal = true;
        StateHasChanged();
    }

    private void HideDeleteModal()
    {
        showDeleteModal = false;
        StateHasChanged();
    }

    private async Task DeleteContent()
    {
        try
        {
            isSaving = true;
            HideDeleteModal();
            await InvokeAsync(StateHasChanged);

            bool success = false;
            string successMessage = "";

            switch (ContentTypeParam.ToLower())
            {
                case "specialization":
                    success = await SpecializationService.DeleteSpecializationAsync(ContentId);
                    successMessage = "Specialization deleted successfully";
                    break;
                case "course":
                    success = await CourseService.DeleteCourseAsync(ContentId);
                    successMessage = "Course deleted successfully";
                    break;
                case "lecture":
                    success = await LectureService.DeleteLectureAsync(ContentId);
                    successMessage = "Lecture deleted successfully";
                    break;
            }

            isSaving = false;

            if (success)
            {
                await JS.InvokeVoidAsync("showToast", "success", successMessage);
                Navigation.NavigateTo("/doctor/content");
            }
            else
            {
                await JS.InvokeVoidAsync("showToast", "error", "Failed to delete content");
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            isSaving = false;
            Console.WriteLine($"Error deleting content: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", $"Error: {ex.Message}");
            await InvokeAsync(StateHasChanged);
        }
    }

