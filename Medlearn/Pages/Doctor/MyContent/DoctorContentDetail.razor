    private async Task DeleteCourse(int courseId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this course? This action cannot be undone."))
            return;

        var success = await CourseService.DeleteCourseAsync(courseId);
        if (success)
        {
            await JS.InvokeVoidAsync("showToast", "success", "Course deleted successfully");
            await LoadContent(); // Reload to refresh the list
        }
        else
        {
            await JS.InvokeVoidAsync("showToast", "error", "Failed to delete course");
        }
    }

    private async Task DeleteLecture(int lectureId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this lecture? This action cannot be undone."))
            return;

        var success = await LectureService.DeleteLectureAsync(lectureId);
        if (success)
