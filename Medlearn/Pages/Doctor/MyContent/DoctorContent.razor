    private async Task LoadDoctorData()
    {
        try
        {
            isLoading = true;
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
            
            if (!isAuthenticated)
            {
                await JS.InvokeVoidAsync("showToast", "warning", "Please log in to manage content.");
                return;
            }

            doctor = await AuthService.GetCurrentUserAsync();
            
            if (doctor == null || doctor.UserType != UserType.Doctor)
            {
                await JS.InvokeVoidAsync("showToast", "error", "Access denied. Doctors only.");
                return;
            }

            await LoadDoctorContent();
            await CalculateStatistics();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctor data: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", $"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadDoctorContent()
    {
        try
        {
            allContent.Clear();
            
            // Load specializations
            var specList = await SpecializationService.GetMySpecializationsAsync();
            if (specList != null)
            {
                specializations = specList;
                foreach (var spec in specList)
                {
                    allContent.Add(new DoctorContentItem
                    {
                        Id = spec.Id,
                        Title = spec.Title,
                        Description = spec.Description,
                        ThumbnailUrl = spec.ThumbnailUrl,
                        ContentTypeTab = ContentTab.Specialization,
                        Price = spec.Price,
                        TotalEnrollments = spec.TotalEnrollments,
                        Revenue = CalculateSpecializationRevenue(spec),
                        Rating = (double)spec.AverageRating,
                        IsActive = spec.IsActive,
                        IsFeatured = spec.IsFeatured,
                        CreatedAt = spec.CreatedAt
                    });
                }
            }

            // Load courses
            foreach (var spec in specializations)
            {
                var courseList = await CourseService.GetCoursesBySpecializationAsync(spec.Id);
                if (courseList != null)
                {
                    var doctorCourses = courseList.Where(c => c.DoctorId == doctor?.Id).ToList();
                    courses.AddRange(doctorCourses);
                    
                    foreach (var course in doctorCourses)
                    {
                        allContent.Add(new DoctorContentItem
                        {
                            Id = course.Id,
                            Title = course.Title,
                            Description = course.Description,
                            ThumbnailUrl = course.ThumbnailUrl,
                            ContentTypeTab = ContentTab.Course,
                            Price = course.Price,
                            TotalEnrollments = course.TotalEnrollments,
                            Revenue = CalculateCourseRevenue(course),
                            Rating = (double)course.AverageRating,
                            IsActive = course.IsActive,
                            IsFeatured = false,
                            CreatedAt = course.CreatedAt,
                            ParentId = spec.Id,
                            ParentTitle = spec.Title
                        });
                    }
                }
            }

            // Load lectures
            foreach (var course in courses)
            {
                var lectureList = await LectureService.GetLecturesByCourseAsync(course.Id);
                if (lectureList != null)
                {
                    var doctorLectures = lectureList.Where(l => l.DoctorId == doctor?.Id).ToList();
                    lectures.AddRange(doctorLectures);
                    
                    foreach (var lecture in doctorLectures)
                    {
                        allContent.Add(new DoctorContentItem
                        {
                            Id = lecture.Id,
                            Title = lecture.Title,
                            Description = lecture.Description,
                            ThumbnailUrl = string.Empty,
                            ContentTypeTab = ContentTab.Lecture,
                            Price = lecture.Price,
                            TotalEnrollments = lecture.TotalEnrollments,
                            Revenue = CalculateLectureRevenue(lecture),
                            Rating = (double)lecture.AverageRating,
                            IsActive = lecture.IsActive,
                            IsFeatured = false,
                            CreatedAt = lecture.CreatedAt,
                            ParentId = course.Id,
                            ParentTitle = course.Title
                        });
                    }
                }
            }

            totalContentCount = allContent.Count;
            
            // Log for debugging
            Console.WriteLine($"Loaded {allContent.Count} total items");
            Console.WriteLine($"Active items: {allContent.Count(c => c.IsActive)}");
            Console.WriteLine($"Inactive items: {allContent.Count(c => !c.IsActive)}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctor content: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", $"Error loading content: {ex.Message}");
        }
    }
