    private decimal CalculateSpecializationRevenue(SpecializationDto spec)
    {
        return spec.TotalEnrollments * spec.Price * 0.8m;
    }

    private decimal CalculateCourseRevenue(CourseDto course)
    {
        return course.TotalEnrollments * course.Price * 0.8m;
    }

    private decimal CalculateLectureRevenue(LectureDto lecture)
    {
        return lecture.TotalEnrollments * lecture.Price * 0.8m;
    }

    private async Task CalculateStatistics()
    {
        totalEnrollments = allContent.Sum(c => c.TotalEnrollments);
        totalRevenue = allContent.Sum(c => c.Revenue);
        
        var itemsWithRating = allContent.Where(c => c.Rating > 0).ToList();
        averageRating = itemsWithRating.Any() ? itemsWithRating.Average(c => c.Rating) : 0;
        
        totalReviews = allContent.Sum(c => (int)(c.TotalEnrollments * 0.3));
    }

    private async Task ApplyFiltersAndSorting()
    {
        try
        {
            filteredContent = allContent
                .Where(FilterByTab)
                .Where(FilterBySearch)
                .Where(FilterByStatus)
                .ToList();

            // Apply sorting
            filteredContent = sortBy switch
            {
                "created_desc" => filteredContent.OrderByDescending(c => c.CreatedAt).ToList(),
                "created_asc" => filteredContent.OrderBy(c => c.CreatedAt).ToList(),
                "title_asc" => filteredContent.OrderBy(c => c.Title).ToList(),
                "title_desc" => filteredContent.OrderByDescending(c => c.Title).ToList(),
                "enrollments_desc" => filteredContent.OrderByDescending(c => c.TotalEnrollments).ToList(),
                "rating_desc" => filteredContent.OrderByDescending(c => c.Rating).ToList(),
                "revenue_desc" => filteredContent.OrderByDescending(c => c.Revenue).ToList(),
                _ => filteredContent.OrderByDescending(c => c.CreatedAt).ToList()
            };

            // Calculate pagination
            totalPages = (int)Math.Ceiling((double)filteredContent.Count / pageSize);
            currentPage = Math.Clamp(currentPage, 1, totalPages);
            
            // Apply pagination
            var startIndex = (currentPage - 1) * pageSize;
            filteredContent = filteredContent
                .Skip(startIndex)
                .Take(pageSize)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error applying filters: {ex.Message}");
        }
        
        await InvokeAsync(StateHasChanged);
    }

    private bool FilterByTab(DoctorContentItem content)
    {
        return activeTab == ContentTab.All || content.ContentTypeTab == activeTab;
    }

    private bool FilterBySearch(DoctorContentItem content)
    {
        if (string.IsNullOrEmpty(searchTerm))
            return true;
        
        var searchLower = searchTerm.ToLower();
        return content.Title.ToLower().Contains(searchLower) ||
               content.Description.ToLower().Contains(searchLower) ||
               (content.ParentTitle?.ToLower().Contains(searchLower) ?? false);
    }

    private bool FilterByStatus(DoctorContentItem content)
    {
        return selectedStatusFilter switch
        {
            ContentStatusFilter.All => true,
            ContentStatusFilter.Active => content.IsActive,
            ContentStatusFilter.Inactive => !content.IsActive,
            ContentStatusFilter.Featured => content.IsFeatured,
            _ => true
        };
    }

