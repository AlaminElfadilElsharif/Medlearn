                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th width="50"></th>
                                            <th>Title</th>
                                            <th>Type</th>
                                            <th class="text-center">Enrollments</th>
                                            <th class="text-center">Revenue</th>
                                            <th class="text-center">Rating</th>
                                            <th class="text-center">Status</th>
                                            <th class="text-center">Created</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var content in filteredContent)
                                        {
                                            <tr class="@(content.IsFeatured ? "table-warning" : "")">
                                                <td>
                                                    @if (!string.IsNullOrEmpty(content.ThumbnailUrl))
                                                    {
                                                        <img src="@GetImageUrl(content.ThumbnailUrl)" 
                                                             class="rounded" width="40" height="40" 
                                                             alt="@content.Title" style="object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light rounded d-flex align-items-center justify-content-center" 
                                                             style="width: 40px; height: 40px;">
                                                            <i class="fas @GetContentIcon(content.ContentTypeTab) text-muted"></i>
                                                        </div>
                                                    }
                                                </td>
                                                <td>
                                                    <div>
                                                        <a href="@GetContentUrl(content)" class="text-decoration-none fw-bold">
                                                            @content.Title
                                                        </a>
                                                        @if (content.IsFeatured)
                                                        {
                                                            <span class="badge bg-warning ms-2">
                                                                <i class="fas fa-star me-1"></i> Featured
                                                            </span>
                                                        }
                                                        <div class="text-muted small">
                                                            @TruncateText(content.Description, 50)
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge @GetContentTypeBadge(content.ContentTypeTab)">
                                                        @content.ContentTypeTab
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <div class="fw-bold text-primary">@content.TotalEnrollments</div>
                                                    <small class="text-muted">students</small>
                                                </td>
                                                <td class="text-center">
                                                    <div class="fw-bold text-success">$@content.Revenue.ToString("N2")</div>
                                                    <small class="text-muted">earned</small>
                                                </td>
                                                <td class="text-center">
                                                    <div class="d-flex align-items-center justify-content-center">
                                                        <div class="rating-stars me-2">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i class="fas fa-star @(i <= Math.Round(content.Rating) ? "text-warning" : "text-muted")" style="font-size: 0.8rem;"></i>
                                                            }
                                                        </div>
                                                        <span class="fw-bold">@content.Rating.ToString("0.0")</span>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    @if (content.IsActive)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="fas fa-check-circle me-1"></i> Active
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">
                                                            <i class="fas fa-times-circle me-1"></i> Inactive
                                                        </span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <small class="text-muted">@content.CreatedAt.ToString("MMM dd, yyyy")</small>
                                                </td>
                                                <td class="text-end">
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <button class="btn btn-outline-primary" @onclick="() => ViewContent(content)" title="View">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                        <button class="btn btn-outline-success" @onclick="() => EditContent(content)" title="Edit">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <div class="dropdown">
                                                            <button class="btn btn-outline-secondary dropdown-toggle" 
                                                                    type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                                <i class="fas fa-ellipsis-v"></i>
                                                            </button>
                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                @GenerateActionMenuItems(content)
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        <!-- Mobile List View (alternative to table) -->
                        <div class="d-block d-md-none">
                            @foreach (var content in filteredContent)
                            {
                                <div class="card mb-2">
                                    <div class="card-body p-2">
                                        <div class="d-flex align-items-center mb-2">
                                            @if (!string.IsNullOrEmpty(content.ThumbnailUrl))
                                            {
                                                <img src="@GetImageUrl(content.ThumbnailUrl)" 
                                                     class="rounded me-2" width="40" height="40" 
                                                     alt="@content.Title" style="object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded d-flex align-items-center justify-content-center me-2" 
                                                     style="width: 40px; height: 40px;">
                                                    <i class="fas @GetContentIcon(content.ContentTypeTab) text-muted"></i>
                                                </div>
                                            }
                                            <div class="flex-grow-1">
                                                <div class="fw-bold">@TruncateText(content.Title, 30)</div>
                                                <div class="d-flex align-items-center">
                                                    <span class="badge @GetContentTypeBadge(content.ContentTypeTab) me-2">
                                                        @GetContentTypeShortName(content.ContentTypeTab)
                                                    </span>
                                                    <span class="badge @(content.IsActive ? "bg-success" : "bg-danger")">
                                                        @(content.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row g-1 mb-2">
                                            <div class="col-4 text-center">
                                                <small class="d-block text-primary fw-bold">@content.TotalEnrollments</small>
                                                <small class="text-muted">Enroll</small>
                                            </div>
                                            <div class="col-4 text-center">
                                                <small class="d-block text-success fw-bold">$@content.Revenue.ToString("N0")</small>
                                                <small class="text-muted">Rev</small>
                                            </div>
                                            <div class="col-4 text-center">
                                                <small class="d-block text-warning fw-bold">@content.Rating.ToString("0.0")</small>
                                                <small class="text-muted">Rate</small>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-outline-primary flex-grow-1" @onclick="() => ViewContent(content)">
                                                <i class="fas fa-eye me-1"></i> View
                                            </button>
                                            <button class="btn btn-sm btn-outline-success flex-grow-1" @onclick="() => EditContent(content)">
                                                <i class="fas fa-edit me-1"></i> Edit
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowMobileMenu(content)">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Mobile Pagination -->
                    @if (totalPages > 1)
                    {
                        <div class="d-block d-md-none mt-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <button class="btn btn-sm btn-outline-primary @(currentPage == 1 ? "disabled" : "")" 
                                        @onclick="async () => await ChangePage(currentPage - 1)">
                                    <i class="fas fa-chevron-left"></i>
                                </button>
                                <span class="text-muted small">Page @currentPage of @totalPages</span>
                                <button class="btn btn-sm btn-outline-primary @(currentPage == totalPages ? "disabled" : "")" 
                                        @onclick="async () => await ChangePage(currentPage + 1)">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Desktop Pagination -->
                        <div class="d-none d-md-block">
                            <nav aria-label="Page navigation" class="mt-4">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="javascript:void(0)" @onclick="async () => await ChangePage(currentPage - 1)" 
                                           @onclick:preventDefault>
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                    </li>
                                    
                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                                        {
                                            <li class="page-item @(currentPage == i ? "active" : "")">
                                                <a class="page-link" href="javascript:void(0)" @onclick="async () => await ChangePage(i)" 
                                                   @onclick:preventDefault>@i</a>
                                            </li>
                                        }
                                        else if (i == currentPage - 3 || i == currentPage + 3)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                    }
                                    
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <a class="page-link" href="javascript:void(0)" @onclick="async () => await ChangePage(currentPage + 1)" 
                                           @onclick:preventDefault>
                                            <i class="fas fa-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }

                    <!-- Summary Footer - Mobile -->
                    <div class="d-block d-md-none mt-3 pt-2 border-top">
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="bg-light p-2 rounded">
                                    <small class="text-muted d-block">Showing</small>
                                    <span class="h6 mb-0">@filteredContent.Count items</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-light p-2 rounded">
                                    <small class="text-muted d-block">Revenue</small>
                                    <span class="h6 mb-0 text-success">$@filteredContent.Sum(c => c.Revenue).ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Summary Footer - Desktop -->
                    <div class="d-none d-md-block mt-4 pt-3 border-top">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h5 class="text-primary mb-1">@filteredContent.Count</h5>
                                    <small class="text-muted">Showing Content</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h5 class="text-success mb-1">$@filteredContent.Sum(c => c.Revenue).ToString("N2")</h5>
                                    <small class="text-muted">Total Revenue</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h5 class="text-info mb-1">@filteredContent.Sum(c => c.TotalEnrollments)</h5>
                                    <small class="text-muted">Total Enrollments</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h5 class="text-warning mb-1">@(filteredContent.Average(c => c.Rating).ToString("0.0"))</h5>
                                    <small class="text-muted">Average Rating</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Mobile Action Bottom Sheet -->
@if (showMobileMenu)
{
    <div class="modal fade show d-block d-md-none" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" @onclick="HideMobileMenu">
        <div class="modal-dialog modal-dialog-bottom">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Actions</h5>
                    <button type="button" class="btn-close" @onclick="HideMobileMenu"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="list-group list-group-flush">
                        @if (selectedContent != null)
                        {
                            <a class="list-group-item list-group-item-action" href="#" @onclick="() => ViewEnrollments(selectedContent)">
                                <i class="fas fa-users me-3 text-primary"></i> View Enrollments
                            </a>
                            <a class="list-group-item list-group-item-action" href="#" @onclick="() => ViewReviews(selectedContent)">
                                <i class="fas fa-star me-3 text-warning"></i> View Reviews
                            </a>
                            <div class="list-group-item">
                                <hr class="my-1">
                            </div>
                            @if (selectedContent.IsFeatured)
                            {
                                <a class="list-group-item list-group-item-action" href="#" @onclick="() => ToggleFeatured(selectedContent)">
                                    <i class="fas fa-star me-3 text-warning"></i> Unfeature
                                </a>
                            }
                            else
                            {
                                <a class="list-group-item list-group-item-action" href="#" @onclick="() => ToggleFeatured(selectedContent)">
                                    <i class="fas fa-star me-3 text-muted"></i> Feature
                                </a>
                            }
                            @if (selectedContent.IsActive)
                            {
                                <a class="list-group-item list-group-item-action text-warning" href="#" @onclick="() => ConfirmDeactivate(selectedContent)">
                                    <i class="fas fa-power-off me-3"></i> Deactivate
                                </a>
                            }
                            else
                            {
                                <a class="list-group-item list-group-item-action text-success" href="#" @onclick="() => ActivateContent(selectedContent)">
                                    <i class="fas fa-power-off me-3"></i> Activate
                                </a>
                            }
                            <a class="list-group-item list-group-item-action text-danger" href="#" @onclick="() => ConfirmDelete(selectedContent)">
                                <i class="fas fa-trash me-3"></i> Delete
                            </a>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary w-100" @onclick="HideMobileMenu">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Loading Modal (keep as is) -->
@if (showLoadingModal)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center py-4">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h5>@loadingMessage</h5>
                    <p class="text-muted mb-0">Please wait...</p>
                </div>
            </div>
        </div>
    </div>
}
<!-- Course Selection Modal for Content Management -->
@if (ShowCourseDropdown)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" @onclick="HideCourseDropdown">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-graduation-cap me-2 text-primary"></i>
                        Select Course
                    </h5>
                    <button type="button" class="btn-close" @onclick="HideCourseDropdown"></button>
                </div>
                <div class="modal-body p-0">
                    @if (courses != null && courses.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var course in courses)
                            {
                                <button class="list-group-item list-group-item-action d-flex align-items-center p-3 border-bottom"
                                        @onclick="() => NavigateToCreateLectureForCourse(course.Id)">
                                    <div class="me-3">
                                        @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                        {
                                            <img src="@GetImageUrl(course.ThumbnailUrl)"
                                                 class="rounded" width="45" height="45" alt="Course"
                                                 style="object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                                 style="width: 45px; height: 45px;">
                                                <i class="fas fa-graduation-cap text-muted"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="flex-grow-1 text-start">
                                        <div class="fw-bold">@course.Title</div>
                                        <small class="text-muted d-block">
                                            <i class="fas fa-video me-1"></i> @(course.Lectures?.Count ?? 0) lectures
                                        </small>
                                        <small class="text-success">
                                            <i class="fas fa-dollar-sign me-1"></i> @course.Price.ToString("C")
                                        </small>
                                    </div>
                                    <i class="fas fa-chevron-right text-muted"></i>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-4">
                            <i class="fas fa-exclamation-circle fa-3x text-warning mb-3"></i>
                            <p class="mb-2">No courses available</p>
                            <small class="text-muted d-block mb-3">You need to create a course first</small>
                            <button class="btn btn-primary btn-sm" @onclick='() => Navigation.NavigateTo("/createcourse")'>
                                <i class="fas fa-plus me-2"></i> Create Course
                            </button>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary w-100" @onclick="HideCourseDropdown">
                        <i class="fas fa-times me-2"></i> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Confirmation Modal (keep as is) -->
@if (showConfirmationModal)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                        Confirm Action
                    </h5>
                    <button type="button" class="btn-close" @onclick="HideConfirmationModal"></button>
                </div>
                <div class="modal-body">
                    <p>@confirmationMessage</p>
                    @if (contentToDelete != null)
                    {
                        <div class="alert alert-warning">
                            <strong>Warning:</strong> This action cannot be undone. All associated data will be permanently deleted.
                        </div>
                    }
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" @onclick="HideConfirmationModal">Cancel</button>
                    <button type="button" class="btn @(confirmationAction == "delete" ? "btn-danger" : "btn-primary")" 
                            @onclick="ExecuteConfirmationAction">
                        @(confirmationAction == "delete" ? "Delete" : 
                          confirmationAction == "deactivate" ? "Deactivate" : 
                          confirmationAction == "activate" ? "Activate" : 
                          confirmationAction == "feature" ? "Feature" : "Unfeature")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

