    private void HideConfirmationModal()
    {
        showConfirmationModal = false;
        contentToDelete = null;
        confirmationMessage = string.Empty;
        confirmationAction = string.Empty;
        StateHasChanged();
    }

    private async Task ExecuteConfirmationAction()
    {
        try
        {
            if (contentToDelete == null) return;

            showLoadingModal = true;
            loadingMessage = confirmationAction switch
            {
                "delete" => $"Deleting {contentToDelete.Title}...",
                "deactivate" => $"Deactivating {contentToDelete.Title}...",
                "activate" => $"Activating {contentToDelete.Title}...",
                "feature" => $"Featuring {contentToDelete.Title}...",
                "unfeature" => $"Removing featured status from {contentToDelete.Title}...",
                _ => "Processing..."
            };
            
            await InvokeAsync(StateHasChanged);

            bool success = false;
            string successMessage = string.Empty;

            switch (confirmationAction)
            {
                case "delete":
                    success = await DeleteContent(contentToDelete);
                    successMessage = $"\"{contentToDelete.Title}\" has been deleted successfully.";
                    break;
                    
                case "deactivate":
                    success = await DeactivateContent(contentToDelete);
                    successMessage = $"\"{contentToDelete.Title}\" has been deactivated successfully.";
                    break;
                    
                case "activate":
                    success = await ActivateContentInternal(contentToDelete);
                    successMessage = $"\"{contentToDelete.Title}\" has been activated successfully.";
                    break;
                    
                case "feature":
                    success = await FeatureContent(contentToDelete, true);
                    successMessage = $"\"{contentToDelete.Title}\" has been featured successfully.";
                    break;
                    
                case "unfeature":
                    success = await FeatureContent(contentToDelete, false);
                    successMessage = $"\"{contentToDelete.Title}\" is no longer featured.";
                    break;
            }

            showLoadingModal = false;
            HideConfirmationModal();

            if (success)
            {
                await JS.InvokeVoidAsync("showToast", "success", successMessage);
                await RefreshData();
            }
            else
            {
                await JS.InvokeVoidAsync("showToast", "error", "Operation failed. Please try again.");
            }
        }
        catch (Exception ex)
        {
            showLoadingModal = false;
            HideConfirmationModal();
            Console.WriteLine($"Error executing action: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", $"Error: {ex.Message}");
        }
    }

    private async Task<bool> DeleteContent(DoctorContentItem content)
    {
        try
        {
            return content.ContentTypeTab switch
            {
                ContentTab.Specialization => await SpecializationService.DeleteSpecializationAsync(content.Id),
                ContentTab.Course => await CourseService.DeleteCourseAsync(content.Id),
                ContentTab.Lecture => await LectureService.DeleteLectureAsync(content.Id),
                _ => false
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting content: {ex.Message}");
            return false;
        }
    }

    private async Task<bool> DeactivateContent(DoctorContentItem content)
    {
        try
        {
            var item = allContent.FirstOrDefault(c => c.Id == content.Id && c.ContentTypeTab == content.ContentTypeTab);
            if (item != null)
            {
                item.IsActive = false;
                return true;
            }
            return false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deactivating content: {ex.Message}");
            return false;
        }
    }

    private async Task<bool> ActivateContentInternal(DoctorContentItem content)
    {
        try
        {
            var item = allContent.FirstOrDefault(c => c.Id == content.Id && c.ContentTypeTab == content.ContentTypeTab);
            if (item != null)
            {
                item.IsActive = true;
                return true;
            }
            return false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error activating content: {ex.Message}");
            return false;
        }
    }

    private async Task<bool> FeatureContent(DoctorContentItem content, bool isFeatured)
    {
        try
        {
            if (content.ContentTypeTab != ContentTab.Specialization)
            {
                return false;
            }

            var item = allContent.FirstOrDefault(c => c.Id == content.Id && c.ContentTypeTab == ContentTab.Specialization);
            if (item != null)
            {
                item.IsFeatured = isFeatured;
                
                var updateDto = new UpdateSpecializationDtos
                {
                    IsFeatured = isFeatured
                };
                
                return await SpecializationService.UpdateSpecializationAsync(content.Id, updateDto, null, null);
            }
            return false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating featured status: {ex.Message}");
            return false;
        }
    }

    private async Task ExportData()
    {
        try
        {
            var csvContent = "Title,Type,Enrollments,Revenue,Rating,Status,Featured,Created\n";
            
            foreach (var content in allContent)
            {
                csvContent += $"\"{content.Title}\"," +
                             $"{content.ContentTypeTab}," +
                             $"{content.TotalEnrollments}," +
                             $"{content.Revenue:F2}," +
                             $"{content.Rating:F1}," +
                             $"{(content.IsActive ? "Active" : "Inactive")}," +
                             $"{(content.IsFeatured ? "Yes" : "No")}," +
                             $"{content.CreatedAt:yyyy-MM-dd}\n";
            }
            
            var fileName = $"doctor-content-export-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
            await JS.InvokeVoidAsync("downloadFile", fileName, "text/csv", csvContent);
            
            await JS.InvokeVoidAsync("showToast", "success", "Data exported successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting data: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", "Error exporting data");
        }
    }

