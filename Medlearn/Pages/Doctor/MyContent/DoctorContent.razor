    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(ContentTypeParam))
        {
            // Set active tab based on URL parameter
            if (Enum.TryParse<ContentTab>(ContentTypeParam, true, out var tab))
            {
