    private async Task NavigateToCreateLecture()
    {
        try
        {
            // Check if courses are loaded, if not load them
            if (!courses.Any())
            {
                // Try to load courses if not already loaded
                await LoadDoctorContent();
            }

            if (!courses.Any())
            {
                await JS.InvokeVoidAsync("showToast", "warning", "Please create a course first before adding lectures");
                Navigation.NavigateTo("/createcourse");
                return;
            }

            if (courses.Count == 1)
            {
                // If doctor has only one course, navigate directly
                var courseId = courses[0].Id;
                Navigation.NavigateTo($"/createlecture/{courseId}");
            }
            else
            {
                // Use dropdown approach since we don't have GetDoctorCoursesAsync
                ShowCourseDropdown = !ShowCourseDropdown;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error navigating to create lecture: {ex.Message}");
            await JS.InvokeVoidAsync("showToast", "error", "Error loading courses");

            // Fallback: navigate to create course page
            Navigation.NavigateTo("/createcourse");
        }
    }
