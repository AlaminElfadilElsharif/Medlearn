@page "/doctor/content"
@implements IDisposable

<PageTitle>Manage Content - Doctor Dashboard</PageTitle>

<div class="doctor-content-management">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <h5 class="mb-0 flex-grow-1">Content Management</h5>
                    <button class="btn btn-link text-white p-0 me-2" @onclick="RefreshData">
                        <i class="fas fa-sync-alt fa-lg"></i>
                    </button>
                    <div class="dropdown">
                        <button class="btn btn-link text-white p-0" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-plus fa-lg"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="/createspecialization">
                                    <i class="fas fa-book me-2"></i> Specialization
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/createcourse">
                                    <i class="fas fa-graduation-cap me-2"></i> Course
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/createlecture">
                                    <i class="fas fa-video me-2"></i> Lecture
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">
                    <i class="fas fa-tasks me-2"></i> Content Management
                </h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/doctor/dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Content Management</li>
                    </ol>
                </nav>
            </div>
            <div class="d-flex align-items-center">
                <div class="dropdown me-2">
                    <button class="btn btn-primary dropdown-toggle" type="button" id="createContentDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-plus me-2"></i> Create New
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="createContentDropdown">
                        <li>
                            <a class="dropdown-item" href="/createspecialization">
                                <i class="fas fa-book me-2"></i> Specialization
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/createCourse">
                                <i class="fas fa-graduation-cap me-2"></i> Course
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" @onclick="async () => await NavigateToCreateLecture()">
                                <i class="fas fa-video me-2"></i> Lecture
                            </a>
                        </li>
                    </ul>
                </div>
                <button class="btn btn-outline-secondary" @onclick="RefreshData">
                    <i class="fas fa-sync-alt me-2"></i> Refresh
                </button>
            </div>
        </div>

        <!-- Mobile Horizontal Scroll Tabs -->
        <div class="d-block d-md-none mb-3">
            <div class="overflow-auto" style="white-space: nowrap; -webkit-overflow-scrolling: touch;">
                <div class="btn-group" role="group">
                    <button class="btn @(activeTab == ContentTab.All ? "btn-primary" : "btn-outline-primary")" 
                            @onclick="() => SetActiveTab(ContentTab.All)">
                        <i class="fas fa-th-large me-1"></i> All
                        <span class="badge bg-light text-dark ms-1">@totalContentCount</span>
                    </button>
                    <button class="btn @(activeTab == ContentTab.Specialization ? "btn-primary" : "btn-outline-primary")" 
                            @onclick="() => SetActiveTab(ContentTab.Specialization)">
                        <i class="fas fa-book me-1"></i> Spec
                        <span class="badge bg-light text-dark ms-1">@specializations.Count</span>
                    </button>
                    <button class="btn @(activeTab == ContentTab.Course ? "btn-primary" : "btn-outline-primary")" 
                            @onclick="() => SetActiveTab(ContentTab.Course)">
                        <i class="fas fa-graduation-cap me-1"></i> Courses
                        <span class="badge bg-light text-dark ms-1">@courses.Count</span>
                    </button>
                    <button class="btn @(activeTab == ContentTab.Lecture ? "btn-primary" : "btn-outline-primary")" 
                            @onclick="() => SetActiveTab(ContentTab.Lecture)">
                        <i class="fas fa-video me-1"></i> Lectures
                        <span class="badge bg-light text-dark ms-1">@lectures.Count</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Desktop Tabs -->
        <div class="d-none d-md-block card mb-4">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == ContentTab.All ? "active" : "")" 
                           @onclick="() => SetActiveTab(ContentTab.All)">
                            <i class="fas fa-th-large me-2"></i> All Content
                            <span class="badge bg-secondary ms-1">@totalContentCount</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == ContentTab.Specialization ? "active" : "")" 
                           @onclick="() => SetActiveTab(ContentTab.Specialization)">
                            <i class="fas fa-book me-2"></i> Specializations
                            <span class="badge bg-primary ms-1">@specializations.Count</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == ContentTab.Course ? "active" : "")" 
                           @onclick="() => SetActiveTab(ContentTab.Course)">
                            <i class="fas fa-graduation-cap me-2"></i> Courses
                            <span class="badge bg-success ms-1">@courses.Count</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == ContentTab.Lecture ? "active" : "")" 
                           @onclick="() => SetActiveTab(ContentTab.Lecture)">
                            <i class="fas fa-video me-2"></i> Lectures
                            <span class="badge bg-info ms-1">@lectures.Count</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Mobile Collapsible Stats -->
        <div class="d-block d-md-none mb-3">
            <div class="accordion" id="statsAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#statsCollapse">
                            <i class="fas fa-chart-bar me-2 text-primary"></i>
                            <span class="flex-grow-1">Content Statistics</span>
                            <span class="badge bg-primary">@totalContentCount items</span>
                        </button>
                    </h2>
                    <div id="statsCollapse" class="accordion-collapse collapse" data-bs-parent="#statsAccordion">
                        <div class="accordion-body">
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="bg-light p-2 rounded">
                                        <small class="text-muted d-block">Enrollments</small>
                                        <span class="h6 mb-0 text-primary">@totalEnrollments</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-light p-2 rounded">
                                        <small class="text-muted d-block">Revenue</small>
                                        <span class="h6 mb-0 text-success">$@totalRevenue.ToString("N2")</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-light p-2 rounded">
                                        <small class="text-muted d-block">Avg Rating</small>
                                        <span class="h6 mb-0 text-warning">@averageRating.ToString("0.0")</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-light p-2 rounded">
                                        <small class="text-muted d-block">Reviews</small>
                                        <span class="h6 mb-0 text-info">@totalReviews</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

     <!-- Desktop Stats - COMPLETELY FIXED -->
<div class="d-none d-md-block">
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card border-start border-primary border-4 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-users fa-2x text-primary"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="mb-0">@totalEnrollments</h5>
                            <small class="text-muted">Total Enrollments</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card border-start border-success border-4 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-dollar-sign fa-2x text-success"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="mb-0">$@totalRevenue.ToString("N2")</h5>
                            <small class="text-muted">Total Revenue</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card border-start border-warning border-4 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-star fa-2x text-warning"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="mb-0">@averageRating.ToString("0.0")</h5>
                            <small class="text-muted">Average Rating</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card border-start border-info border-4 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-chart-line fa-2x text-info"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="mb-0">@totalReviews</h5>
                            <small class="text-muted">Total Reviews</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

        <!-- Mobile Search and Filters -->
        <div class="d-block d-md-none mb-3">
            <div class="input-group mb-2">
                <span class="input-group-text bg-white">
                    <i class="fas fa-search text-muted"></i>
                </span>
                <input type="text" class="form-control" placeholder="Search content..." 
                       @bind="searchTerm" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                        <i class="fas fa-times"></i>
                    </button>
                }
            </div>
            
            <div class="row g-2">
                <div class="col-6">
                    <select class="form-select form-select-sm" @onchange="OnStatusFilterChange">
                        <option value="All">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Featured">Featured</option>
                    </select>
                </div>
                <div class="col-6">
                    <select class="form-select form-select-sm" @onchange="OnSortChange">
                        <option value="created_desc">Newest</option>
                        <option value="created_asc">Oldest</option>
                        <option value="title_asc">Title A-Z</option>
                        <option value="title_desc">Title Z-A</option>
                        <option value="enrollments_desc">Most Enrolled</option>
                        <option value="rating_desc">Highest Rated</option>
                        <option value="revenue_desc">Most Revenue</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Desktop Search and Filters - FIXED -->
<div class="d-none d-md-flex flex-wrap align-items-center gap-3 mb-4">
    <div class="flex-grow-1" style="min-width: 300px;">
        <div class="input-group">
            <span class="input-group-text bg-white">
                <i class="fas fa-search text-primary"></i>
            </span>
            <input type="text" class="form-control" placeholder="Search content by title, description, or parent content..." 
                   @bind="searchTerm" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                    <i class="fas fa-times"></i>
                </button>
            }
        </div>
    </div>
    <div style="min-width: 180px;">
        <select class="form-select" @onchange="OnStatusFilterChange">
            <option value="All">📊 All Status</option>
            <option value="Active">✅ Active</option>
            <option value="Inactive">⭕ Inactive</option>
            <option value="Featured">⭐ Featured</option>
        </select>
    </div>
    <div style="min-width: 200px;">
        <select class="form-select" @onchange="OnSortChange">
            <option value="created_desc">🆕 Newest First</option>
            <option value="created_asc">📅 Oldest First</option>
            <option value="title_asc">🔤 Title A-Z</option>
            <option value="title_desc">🔠 Title Z-A</option>
            <option value="enrollments_desc">👥 Most Enrollments</option>
            <option value="rating_desc">⭐ Highest Rating</option>
            <option value="revenue_desc">💰 Most Revenue</option>
        </select>
    </div>
</div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading content...</p>
            </div>
        }
        else if (!isAuthenticated)
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Please log in to manage your content.
                <a href="/account/login" class="alert-link ms-2">Login</a>
            </div>
        }
        else if (doctor == null || doctor.UserType != UserType.Doctor)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>
                Access denied. This page is only available for doctors.
                <a href="/" class="alert-link ms-2">Go to Home</a>
            </div>
        }
        else if (!filteredContent.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No Content Found</h4>
                <p class="text-muted">
                    @(string.IsNullOrEmpty(searchTerm) 
                        ? "You haven't created any content yet." 
                        : "No content matches your search.")
                </p>
                <a href="/createspecialization" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i> Create Your First Content
                </a>
            </div>
        }
        else
        {
            <!-- Content Display -->
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        @(activeTab == ContentTab.All ? "All Content" : $"{activeTab}s")
                        <span class="badge bg-primary ms-2">@filteredContent.Count</span>
                    </h5>
                    <div class="d-flex align-items-center">
                        <!-- Mobile view toggle -->
                        <div class="d-block d-md-none">
                            <button class="btn btn-sm btn-outline-secondary me-2" @onclick="() => isGridView = !isGridView">
                                <i class="fas @(isGridView ? "fa-list" : "fa-th-large")"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ExportData">
                                <i class="fas fa-download"></i>
                            </button>
                        </div>
                        
                        <!-- Desktop view toggle -->
                        <div class="d-none d-md-flex">
                            <div class="form-check form-switch me-3">
                                <input class="form-check-input" type="checkbox" id="gridViewToggle" @bind="isGridView" />
                                <label class="form-check-label" for="gridViewToggle">
                                    <i class="fas @(isGridView ? "fa-list" : "fa-th-large")"></i>
                                </label>
                            </div>
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-secondary" @onclick="ExportData">
                                    <i class="fas fa-download me-1"></i> Export
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="PrintView">
                                    <i class="fas fa-print me-1"></i> Print
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card-body">
                    @if (isGridView)
                    {
                        <!-- Grid View - Responsive -->
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 g-md-4">
                            @foreach (var content in filteredContent)
                            {
                                <div class="col">
                                    <div class="card h-100 content-card shadow-sm">
                                        <!-- Mobile card layout -->
                                        <div class="d-block d-md-none">
                                            <div class="position-relative">
                                                @if (!string.IsNullOrEmpty(content.ThumbnailUrl))
                                                {
                                                    <img src="@GetImageUrl(content.ThumbnailUrl)" 
                                                         class="card-img-top" alt="@content.Title" 
                                                         style="height: 140px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                                                         style="height: 140px;">
                                                        <i class="fas @GetContentIcon(content.ContentTypeTab) fa-3x text-muted"></i>
                                                    </div>
                                                }
                                                <div class="position-absolute top-0 end-0 m-2">
                                                    <span class="badge @GetContentTypeBadge(content.ContentTypeTab)">
                                                        @GetContentTypeShortName(content.ContentTypeTab)
                                                    </span>
                                                </div>
                                                @if (content.IsFeatured)
                                                {
                                                    <div class="position-absolute top-0 start-0 m-2">
                                                        <span class="badge bg-warning">
                                                            <i class="fas fa-star"></i>
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="card-body p-2">
                                                <h6 class="card-title mb-1">@TruncateText(content.Title, 40)</h6>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="badge @(content.IsActive ? "bg-success" : "bg-danger")">
                                                        @(content.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                    <small class="text-muted">@content.CreatedAt.ToString("MMM dd")</small>
                                                </div>
                                                <div class="row g-1 mb-2">
                                                    <div class="col-4 text-center">
                                                        <small class="d-block text-primary fw-bold">@content.TotalEnrollments</small>
                                                        <small class="text-muted">Enroll</small>
                                                    </div>
                                                    <div class="col-4 text-center">
                                                        <small class="d-block text-success fw-bold">$@content.Revenue.ToString("N0")</small>
                                                        <small class="text-muted">Rev</small>
                                                    </div>
                                                    <div class="col-4 text-center">
                                                        <small class="d-block text-warning fw-bold">@content.Rating.ToString("0.0")</small>
                                                        <small class="text-muted">Rate</small>
                                                    </div>
                                                </div>
                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-sm btn-outline-primary flex-grow-1" @onclick="() => EditContent(content)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-info flex-grow-1" @onclick="() => ViewContent(content)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                                            <i class="fas fa-ellipsis-v"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end">
                                                            <li>
                                                                <a class="dropdown-item" href="#" @onclick="() => ViewEnrollments(content)">
                                                                    <i class="fas fa-users me-2"></i> Enrollments
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a class="dropdown-item" href="#" @onclick="() => ViewReviews(content)">
                                                                    <i class="fas fa-star me-2"></i> Reviews
                                                                </a>
                                                            </li>
                                                            <li><hr class="dropdown-divider"></li>
                                                            @GenerateActionMenuItems(content)
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Desktop card layout -->
                                        <div class="d-none d-md-block">
                                            <div class="position-relative">
                                                @if (!string.IsNullOrEmpty(content.ThumbnailUrl))
                                                {
                                                    <img src="@GetImageUrl(content.ThumbnailUrl)" 
                                                         class="card-img-top" alt="@content.Title" 
                                                         style="height: 180px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                                                         style="height: 180px;">
                                                        <i class="fas @GetContentIcon(content.ContentTypeTab) fa-3x text-muted"></i>
                                                    </div>
                                                }
                                                <div class="position-absolute top-0 end-0 m-2">
                                                    <span class="badge @GetContentTypeBadge(content.ContentTypeTab)">
                                                        @content.ContentTypeTab
                                                    </span>
                                                </div>
                                                @if (content.IsFeatured)
                                                {
                                                    <div class="position-absolute top-0 start-0 m-2">
                                                        <span class="badge bg-warning">
                                                            <i class="fas fa-star me-1"></i> Featured
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="card-body d-flex flex-column">
                                                <h6 class="card-title mb-2">
                                                    <a href="@GetContentUrl(content)" class="text-decoration-none text-dark">
                                                        @content.Title
                                                    </a>
                                                </h6>
                                                <p class="card-text small text-muted flex-grow-1">
                                                    @TruncateText(content.Description, 100)
                                                </p>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-4 text-center">
                                                        <div class="border rounded p-1">
                                                            <div class="small text-primary fw-bold">@content.TotalEnrollments</div>
                                                            <div class="x-small text-muted">Enrollments</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-4 text-center">
                                                        <div class="border rounded p-1">
                                                            <div class="small text-success fw-bold">$@content.Revenue.ToString("N0")</div>
                                                            <div class="x-small text-muted">Revenue</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-4 text-center">
                                                        <div class="border rounded p-1">
                                                            <div class="small text-warning fw-bold">@content.Rating.ToString("0.0")</div>
                                                            <div class="x-small text-muted">Rating</div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-between">
                                                    <div>
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditContent(content)">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-info ms-1" @onclick="() => ViewContent(content)">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                    </div>
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                                                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                            <i class="fas fa-ellipsis-v"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end">
                                                            @GenerateActionMenuItems(content)
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-footer bg-transparent">
                                                <small class="text-muted">
                                                    <i class="fas fa-calendar me-1"></i>
                                                    Created @content.CreatedAt.ToString("MMM dd, yyyy")
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
