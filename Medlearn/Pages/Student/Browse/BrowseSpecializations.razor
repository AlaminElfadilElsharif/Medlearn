    {
        return ImageUrlService.GetImageUrl(relativeUrl);
    }

    private RenderFragment RenderContentCard(BrowseItem item, bool isFeatured, bool isDesktop) => @<div class="card @(isFeatured ? "featured-card" : "") h-100 shadow-sm">
            <div class="position-relative">
                @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                {
                    <img src="@GetImageUrl(item.ThumbnailUrl)" class="card-img-top" alt="@item.Title" style="height: @(isDesktop ? "180px" : "120px"); object-fit: cover;"
                         onerror="this.onerror=null; this.src='/placeholder-image.jpg';" />
                }
                else
                {
                    <div class="card-img-top bg-gradient-primary d-flex align-items-center justify-content-center" style="height: @(isDesktop ? "180px" : "120px");">
                        <i class="fas @GetContentIcon(item.Type) @(isDesktop ? "fa-3x" : "fa-2x") text-white"></i>
                    </div>
                }

                @if (isFeatured)
                {
                    <span class="position-absolute top-0 start-0 m-2 badge bg-warning small">
                        <i class="fas fa-star me-1"></i> @(isDesktop ? "Featured" : "")
                    </span>
                }
                else if (item.IsFeatured)
                {
                    <span class="position-absolute top-0 start-0 m-1 badge bg-warning p-1">
                        <i class="fas fa-star fa-xs"></i>
                    </span>
                }

                @if (item.Price == 0)
                {
                    <span class="position-absolute top-0 end-0 m-2 badge bg-success small">
                        FREE
                    </span>
                }

                <span class="position-absolute bottom-0 start-0 m-1 badge @GetContentTypeBadgeClass(item.Type) small">
                    @if (isDesktop)
                    {
                        @item.Type.ToString()
                    }
                    else
                    {
                        @switch (item.Type)
                        {
                            case ContentType.Specialization:
                                <text>Spec</text>
                                ; break;
                            case ContentType.Course:

                                <text>Crs</text>
                                ; break;
                            case ContentType.Lecture:

                                <text>Lec</text>
                                ; break;
                            default:

                                @item.Type.ToString().Substring(0, 3)
                                ; break;
                        }
                    }
                </span>
            </div>
            <div class="card-body p-@(isDesktop ? "3" : "2") d-flex flex-column">
                <h6 class="card-title @(isDesktop ? "h5" : "small fw-bold") mb-1">@TruncateTitle(item.Title, isDesktop ? 50 : 30)</h6>

                @if (isDesktop)
                {
                    <p class="card-text text-muted small flex-grow-1">
                        @(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                    </p>
                }

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <span class="@(isDesktop ? "h5" : "h6") mb-0">$@item.Price.ToString("N2")</span>
                        @if (item.Price == 0 && isDesktop)
                        {
                            <span class="badge bg-success ms-2">FREE</span>
                        }
                    </div>
                    <div class="rating">
                        @if (isDesktop)
                        {
                            for (int i = 1; i <= 5; i++)
                            {
                                <i class="fas fa-star fa-xs @(i <= Math.Round(item.Rating) ? "text-warning" : "text-muted")"></i>
                            }
                            <small class="ms-1">@item.Rating.ToString("0.0")</small>
                        }
                        else
                        {
                            <small class="text-warning">
                                <i class="fas fa-star"></i> @item.Rating.ToString("0.0")
                            </small>
                        }
                    </div>
                </div>

                @if (isDesktop)
                {
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        @if (item.EstimatedHours > 0)
                        {
                            <small class="text-muted">
                                <i class="fas fa-clock me-1"></i>
                                @item.EstimatedHours h
                            </small>
                        }
                        <small class="text-muted">
                            <i class="fas fa-users me-1"></i>
                            @(item.EnrollmentCount > 999 ? $"{item.EnrollmentCount / 1000}K" : item.EnrollmentCount.ToString())
                        </small>
                    </div>
                }

                @if (item.Doctor != null && isDesktop)
                {
                    <div class="d-flex align-items-center mb-3">
                        <div class="avatar-sm me-2">
                            @if (!string.IsNullOrEmpty(item.Doctor.ProfileImageUrl))
                            {
                                <img src="@GetImageUrl(item.Doctor.ProfileImageUrl)" class="rounded-circle" width="24" height="24" alt="Doctor" style="object-fit: cover;"
                                     onerror="this.onerror=null; this.src='/placeholder-image.jpg';" />
                            }
                            else
                            {
                                <div class="avatar-placeholder bg-info text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 12px;">
                                    @item.Doctor.FirstName?.Substring(0, 1)
                                </div>
                            }
                        </div>
                        <small class="text-muted">By @item.Doctor.FirstName</small>
                    </div>
                }

                <div class="d-grid gap-2 mt-auto">
                    <button class="btn btn-outline-primary @(isDesktop ? "btn-sm" : "btn-xs")"
                            @onclick="@(() => ViewContent(item))">
                        <i class="fas fa-eye me-1"></i> @(isDesktop ? "View Details" : "Details")
                    </button>
                    @if (item.Price == 0)
                    {
                        <button class="btn btn-success @(isDesktop ? "btn-sm" : "btn-xs")"
                                @onclick="@(async () => await EnrollFreeContent(item))">
                            <i class="fas fa-graduation-cap me-1"></i> @(isDesktop ? "Enroll Free" : "Free")
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary @(isDesktop ? "btn-sm" : "btn-xs")"
                                @onclick="@(() => EnrollContent(item))">
                            <i class="fas fa-shopping-cart me-1"></i> @(isDesktop ? "Enroll" : "Buy")
                        </button>
                    }
                </div>
            </div>
    </div>;

private string TruncateTitle(string title, int maxLength)
{
if (string.IsNullOrEmpty(title)) return "";
return title.Length <= maxLength ? title : title.Substring(0, maxLength) + "...";
}

