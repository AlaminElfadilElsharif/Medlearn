private string GetContentIcon(ContentType type)
{
return type switch
{
ContentType.Specialization => "fa-graduation-cap",
ContentType.Course => "fa-book",
ContentType.Lecture => "fa-play-circle",
_ => "fa-book"
};
}

private string GetContentTypeBadgeClass(ContentType type)
{
return type switch
{
ContentType.Specialization => "bg-primary",
ContentType.Course => "bg-info",
ContentType.Lecture => "bg-success",
_ => "bg-secondary"
};
}

private void ViewContent(BrowseItem item)
{
var url = item.Type switch
{
ContentType.Specialization => $"/specialization/{item.Id}",
ContentType.Course => $"/course/{item.Id}",
ContentType.Lecture => $"/lectureinfo/{item.Id}",
_ => "#"
};
Navigation.NavigateTo(url);
}

private void EnrollContent(BrowseItem item)
{
var enrollmentType = item.Type switch
{
ContentType.Specialization => "Specialization",
ContentType.Course => "Course",
ContentType.Lecture => "Lecture",
_ => ""
};

Navigation.NavigateTo($"/student/payments/make?type={enrollmentType}&id={item.Id}");
}

private async Task EnrollFreeContent(BrowseItem item)
{
try
{
await ShowToast("info", $"Enrolling in free {item.Type.ToString().ToLower()}...");

var enrollmentDto = new CreateEnrollmentDto
{
EnrollmentType = item.Type switch
{
ContentType.Specialization => EnrollmentType.Specialization,
ContentType.Course => EnrollmentType.Course,
ContentType.Lecture => EnrollmentType.Lecture,
_ => EnrollmentType.Specialization
},
SpecializationId = item.Type == ContentType.Specialization ? item.Id : null,
CourseId = item.Type == ContentType.Course ? item.Id : null,
LectureId = item.Type == ContentType.Lecture ? item.Id : null
};

var enrollment = await EnrollmentService.CreateEnrollmentAsync(enrollmentDto);

if (enrollment != null)
{
await ShowToast("success", $"Successfully enrolled!");

// Navigate to learning page
var url = item.Type switch
{
ContentType.Specialization => $"/student/mylearning/specialization/{item.Id}",
ContentType.Course => $"/student/mylearning/course/{item.Id}",
ContentType.Lecture => $"/student/mylearning/lecture/{item.Id}",
_ => "/student/mylearning"
};
Navigation.NavigateTo(url);
}
else
{
await ShowToast("error", "Failed to enroll. Please try again.");
}
}
catch (Exception ex)
{
await JS.InvokeVoidAsync("console.error", "Enrollment error:", ex.Message);
await ShowToast("error", "Failed to enroll. Please try again.");
}
}

private async Task ShowToast(string type, string message)
{
await JS.InvokeVoidAsync("alert", message);
}
}

