    {
        if (IsSearching)
        {
            return "Search Results";
        }

        return contentType switch
        {
            ContentType.Specialization => "Specializations",
            ContentType.Course => "Courses",
            ContentType.Lecture => "Lectures",
            _ => "All Learning Materials"
        };
    }

