        StateHasChanged();
    }

    private async void StartLecture(int lectureId)
    {
        // Find the lecture to check if it has free preview
        var lecture = specialization?.Courses?
            .SelectMany(c => c.Lectures ?? new List<LectureDto>())
            .FirstOrDefault(l => l.Id == lectureId);
        
        if (lecture == null) return;
        
        // Check access
        if (!lecture.IsFreePreview && enrollment == null)
        {
            await ShowToast("warning", "You need to enroll to access this lecture");
            return;
        }
        
        // Navigate to lecture player
        Navigation.NavigateTo($"/lecture/{lectureId}");
    }

    private async void ContinueLearning()
    {
        // Find the first incomplete lecture
        if (specialization?.Courses == null) return;
        
        foreach (var course in specialization.Courses.OrderBy(c => c.Order))
        {
            if (course.Lectures == null) continue;
            
            foreach (var lecture in course.Lectures.OrderBy(l => l.Order))
            {
                var progress = CalculateLectureProgress(lecture.Id);
                if (progress < 100)
                {
                    StartLecture(lecture.Id);
                    return;
                }
            }
        }
        
        // If all lectures are complete, start from first
        var firstLecture = specialization.Courses
            .OrderBy(c => c.Order)
            .SelectMany(c => c.Lectures ?? new List<LectureDto>())
            .OrderBy(l => l.Order)
            .FirstOrDefault();
        
        if (firstLecture != null)
            StartLecture(firstLecture.Id);
    }

