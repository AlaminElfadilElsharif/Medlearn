    private void ViewCourseDetails(EnrollmentDto enrollment)
    {
        if (enrollment == null) return;
        
        switch (enrollment.EnrollmentType)
        {
            case EnrollmentType.Specialization:
                if (enrollment.SpecializationId.HasValue)
                    Navigation.NavigateTo($"/specializations/{enrollment.SpecializationId.Value}");
                break;
            case EnrollmentType.Course:
                if (enrollment.CourseId.HasValue)
                    Navigation.NavigateTo($"/course/{enrollment.CourseId.Value}");
                break;
            case EnrollmentType.Lecture:
                if (enrollment.LectureId.HasValue)
                    Navigation.NavigateTo($"/lecture/{enrollment.LectureId.Value}");
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isLoading && enrollments.Any() && isAuthenticated)
        {
            await RenderWeeklyActivityChart();
        }
    }

    private async Task RenderWeeklyActivityChart()
    {
        try
        {
            // Generate weekly activity data based on progress trackings
            var days = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
            var activity = new int[7];
            
            // Calculate activity based on progress trackings
            foreach (var enrollment in enrollments)
            {
                if (enrollment.ProgressTrackings == null) continue;
                
                foreach (var progress in enrollment.ProgressTrackings)
                {
                    var date = progress.CompletedDate ?? progress.CreatedAt;
                    if (date >= DateTime.UtcNow.AddDays(-7))
                    {
                        var dayOfWeek = (int)date.DayOfWeek - 1;
                        if (dayOfWeek < 0) dayOfWeek = 6; // Sunday adjustment
                        activity[dayOfWeek] += progress.TimeSpentSeconds / 3600; // Add hours
                    }
                }
            }
            
            await JS.InvokeVoidAsync("renderWeeklyActivityChart", days, activity);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chart error: {ex.Message}");
        }
    }

