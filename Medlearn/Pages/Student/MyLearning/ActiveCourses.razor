@page "/student/mylearning/active"


<PageTitle>Active Courses</PageTitle>

<div class="active-courses">
    <div class="container-fluid px-0 px-md-3">
        <!-- Header - Responsive -->
        <div class="row g-0 mb-3 mb-md-4">
            <div class="col-12">
                <!-- Mobile Header -->
                <div class="d-block d-md-none">
                    <div class="bg-primary text-white p-3">
                        <div class="d-flex align-items-center">
                            <h5 class="mb-0 flex-grow-1">
                                <i class="fas fa-book-open me-2"></i>Active Courses
                            </h5>
                            <button class="btn btn-link text-white p-0" @onclick="NavigateToBrowse">
                                <i class="fas fa-plus-circle fa-lg"></i>
                            </button>
                        </div>
                        <p class="small text-white-50 mb-0 mt-1">Continue your learning journey</p>
                    </div>
                </div>

                <!-- Desktop Header -->
                <div class="d-none d-md-block">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1>Active Courses</h1>
                            <p class="text-muted mb-0">Continue your learning journey</p>
                        </div>
                        <div>
                            <button class="btn btn-primary" @onclick="NavigateToBrowse">
                                <i class="fas fa-plus me-2"></i> Find More Courses
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading your active courses...</p>
            </div>
        }
        else if (!isAuthenticated)
        {
            <div class="text-center py-5">
                <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                <h4>Authentication Required</h4>
                <p class="text-muted mb-4">Please log in to view your active courses</p>
                <button class="btn btn-primary" @onclick="NavigateToLogin">
                    <i class="fas fa-sign-in-alt me-2"></i> Go to Login
                </button>
            </div>
        }
        else if (!activeEnrollments.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-book-open fa-3x text-muted mb-3"></i>
                <h4>No active courses</h4>
                <p class="text-muted mb-4">Start learning by enrolling in a course</p>
                <button class="btn btn-primary" @onclick="NavigateToBrowse">
                    <i class="fas fa-search me-2"></i> Browse Courses
                </button>
            </div>
        }
        else
        {
            <!-- Progress Overview - Responsive -->
            <div class="row g-2 g-md-4 mb-3 mb-md-4">
                <div class="col-12">
                    <div class="card border-0 border-md">
                        <div class="card-body p-3 p-md-4">
                            <!-- Mobile Progress Stats -->
                            <div class="d-block d-md-none">
                                <h6 class="fw-bold mb-3">Your Progress Overview</h6>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="bg-light rounded p-2 text-center">
                                            <div class="fw-bold text-primary">@activeEnrollments.Count</div>
                                            <small class="text-muted">Active Courses</small>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="bg-light rounded p-2 text-center">
                                            <div class="fw-bold text-success">@averageProgress.ToString("0.0")%</div>
                                            <small class="text-muted">Avg Progress</small>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="bg-light rounded p-2 text-center">
                                            <div class="fw-bold text-warning">@upcomingDeadlines</div>
                                            <small class="text-muted">Deadlines</small>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="bg-light rounded p-2 text-center">
                                            <div class="fw-bold text-info">@totalStudyHours</div>
                                            <small class="text-muted">Study Hours</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Desktop Progress Stats -->
                            <div class="d-none d-md-block">
                                <h5 class="mb-3">Learning Progress Overview</h5>
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="text-center">
                                            <div class="display-6 fw-bold text-primary">@activeEnrollments.Count</div>
                                            <small class="text-muted">Active Courses</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="text-center">
                                            <div class="display-6 fw-bold text-success">@averageProgress.ToString("0.0")%</div>
                                            <small class="text-muted">Average Progress</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="text-center">
                                            <div class="display-6 fw-bold text-warning">@upcomingDeadlines</div>
                                            <small class="text-muted">Upcoming Deadlines</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="text-center">
                                            <div class="display-6 fw-bold text-info">@totalStudyHours</div>
                                            <small class="text-muted">Study Hours This Week</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Course List - Responsive -->
            <div class="row g-2 g-md-4 mb-3 mb-md-4">
                <div class="col-12">
                    <div class="card border-0 border-md">
                        <!-- Mobile Course Header -->
                        <div class="card-header bg-transparent d-block d-md-none p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0">Your Active Courses</h6>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-sm @(sortBy == "progress" ? "btn-primary" : "btn-outline-primary")"
                                            @onclick="SortByProgress">
                                        <i class="fas fa-sort-amount-down"></i>
                                    </button>
                                    <button class="btn btn-sm @(sortBy == "recent" ? "btn-primary" : "btn-outline-primary")"
                                            @onclick="SortByRecent">
                                        <i class="fas fa-clock"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Desktop Course Header -->
                        <div class="card-header d-none d-md-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Your Active Courses</h5>
                            <div class="btn-group">
                                <button class="btn btn-sm @(sortBy == "progress" ? "btn-primary" : "btn-outline-primary")"
                                        @onclick="SortByProgress">
                                    <i class="fas fa-sort-amount-down me-2"></i> Progress
                                </button>
                                <button class="btn btn-sm @(sortBy == "recent" ? "btn-primary" : "btn-outline-primary")"
                                        @onclick="SortByRecent">
                                    <i class="fas fa-clock me-2"></i> Recent
                                </button>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <!-- Mobile Course Cards -->
                            <div class="d-block d-md-none">
                                @foreach (var enrollment in sortedEnrollments)
                                {
                                    var lastAccessed = GetLastAccessed(enrollment);
                                    var timeSpent = GetTimeSpent(enrollment);
                                    var deadline = GetDeadlineText(enrollment);
                                    var hasDeadline = HasDeadline(enrollment);

                                    <div class="border-bottom p-3">
                                        <div class="d-flex mb-2">
                                            <div class="me-3">
                                                @if (GetCourseThumbnail(enrollment) != null)
                                                {
                                                    <img src="@GetCourseThumbnail(enrollment)"
                                                         class="rounded"
                                                         width="60"
                                                         height="60"
                                                         alt="Course"
                                                         style="object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                                         style="width: 60px; height: 60px;">
                                                        <i class="fas fa-book text-muted"></i>
                                                    </div>
                                                }
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">@GetCourseTitle(enrollment)</h6>
                                                <div class="d-flex gap-2 mb-1">
                                                    <span class="badge bg-light text-dark">@GetCourseType(enrollment)</span>
                                                    @if (hasDeadline)
                                                    {
                                                        <span class="badge bg-warning">@deadline</span>
                                                    }
                                                </div>
                                                <small class="text-muted">Last: @lastAccessed</small>
                                            </div>
                                        </div>

                                        <!-- Progress Bar -->
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <small>Progress</small>
                                                <small class="fw-bold">@enrollment.ProgressPercentage.ToString("0.0")%</small>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar"
                                                     role="progressbar"
                                                     style="width: @enrollment.ProgressPercentage%;"
                                                     aria-valuenow="@enrollment.ProgressPercentage"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100"></div>
                                            </div>
                                        </div>

                                        <!-- Course Meta & Actions -->
                                        <div class="d-flex justify-content-between align-items-center mt-2">
                                            <div class="small text-muted">
                                                <i class="fas fa-clock me-1"></i> @timeSpent hrs
                                            </div>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-primary"
                                                        @onclick="() => ContinueLearning(enrollment)">
                                                    <i class="fas fa-play me-1"></i> Continue
                                                </button>
                                                <button class="btn btn-outline-secondary"
                                                        @onclick="() => ViewDetails(enrollment)">
                                                    <i class="fas fa-info-circle"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Desktop Course Table -->
                            <div class="d-none d-md-block table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Course</th>
                                            <th>Progress</th>
                                            <th>Last Accessed</th>
                                            <th>Time Spent</th>
                                            <th>Next Deadline</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var enrollment in sortedEnrollments)
                                        {
                                            var lastAccessed = GetLastAccessed(enrollment);
                                            var timeSpent = GetTimeSpent(enrollment);
                                            var deadline = GetDeadlineText(enrollment);
                                            var hasDeadline = HasDeadline(enrollment);

                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="me-3">
                                                            @if (GetCourseThumbnail(enrollment) != null)
                                                            {
                                                                <img src="@GetCourseThumbnail(enrollment)"
                                                                     class="rounded"
                                                                     width="60"
                                                                     height="40"
                                                                     alt="Course"
                                                                     style="object-fit: cover;" />
                                                            }
                                                            else
                                                            {
                                                                <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                                                     style="width: 60px; height: 40px;">
                                                                    <i class="fas fa-book text-muted"></i>
                                                                </div>
                                                            }
                                                        </div>
                                                        <div>
                                                            <h6 class="mb-0">@GetCourseTitle(enrollment)</h6>
                                                            <small class="text-muted">@GetCourseType(enrollment)</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="progress flex-grow-1 me-2" style="height: 6px; width: 100px;">
                                                            <div class="progress-bar"
                                                                 role="progressbar"
                                                                 style="width: @enrollment.ProgressPercentage%;"
                                                                 aria-valuenow="@enrollment.ProgressPercentage"
                                                                 aria-valuemin="0"
                                                                 aria-valuemax="100"></div>
                                                        </div>
                                                        <small>@enrollment.ProgressPercentage.ToString("0.0")%</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <small class="text-muted">
                                                        @lastAccessed
                                                    </small>
                                                </td>
                                                <td>
                                                    <small class="text-muted">
                                                        @timeSpent hours
                                                    </small>
                                                </td>
                                                <td>
                                                    @if (hasDeadline)
                                                    {
                                                        <span class="badge bg-warning">
                                                            @deadline
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <small class="text-muted">No deadline</small>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary"
                                                                @onclick="() => ContinueLearning(enrollment)">
                                                            <i class="fas fa-play"></i>
                                                        </button>
                                                        <button class="btn btn-outline-info"
                                                                @onclick="() => ViewDetails(enrollment)">
                                                            <i class="fas fa-info-circle"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Study Recommendations - Responsive -->
            <div class="row g-2 g-md-4">
                <div class="col-12">
                    <div class="card border-0 border-md">
                        <div class="card-header bg-transparent">
                            <h6 class="fw-bold mb-0 d-block d-md-none">Recommendations</h6>
                            <h5 class="mb-0 d-none d-md-block">Study Recommendations</h5>
                        </div>
                        <div class="card-body p-3 p-md-4">
                            <!-- Mobile Recommendations -->
                            <div class="d-block d-md-none">
                                <div class="row g-2">
                                    <!-- Most Progress -->
                                    <div class="col-12">
                                        <div class="bg-light rounded p-3">
                                            <div class="d-flex align-items-center mb-2">
                                                <i class="fas fa-trophy fa-lg text-warning me-2"></i>
                                                <h6 class="mb-0 flex-grow-1">Almost There!</h6>
                                                @if (mostProgressEnrollment != null)
                                                {
                                                    <button class="btn btn-sm btn-primary"
                                                            @onclick="() => ContinueLearning(mostProgressEnrollment)">
                                                        Finish
                                                    </button>
                                                }
                                            </div>
                                            @if (mostProgressEnrollment != null)
                                            {
                                                <p class="small mb-2">@GetCourseTitle(mostProgressEnrollment)</p>
                                                <div class="progress" style="height: 4px;">
                                                    <div class="progress-bar bg-success"
                                                         role="progressbar"
                                                         style="width: @mostProgressEnrollment.ProgressPercentage%;"></div>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-muted small mb-0">No course with high progress</p>
                                            }
                                        </div>
                                    </div>

                                    <!-- Need Attention -->
                                    <div class="col-12">
                                        <div class="bg-light rounded p-3">
                                            <div class="d-flex align-items-center mb-2">
                                                <i class="fas fa-exclamation-circle fa-lg text-warning me-2"></i>
                                                <h6 class="mb-0 flex-grow-1">Needs Attention</h6>
                                                @if (leastProgressEnrollment != null)
                                                {
                                                    <button class="btn btn-sm btn-warning"
                                                            @onclick="() => ContinueLearning(leastProgressEnrollment)">
                                                        Start
                                                    </button>
                                                }
                                            </div>
                                            @if (leastProgressEnrollment != null)
                                            {
                                                <p class="small mb-2">@GetCourseTitle(leastProgressEnrollment)</p>
                                                <div class="progress" style="height: 4px;">
                                                    <div class="progress-bar bg-warning"
                                                         role="progressbar"
                                                         style="width: @leastProgressEnrollment.ProgressPercentage%;"></div>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-muted small mb-0">All courses have good progress</p>
                                            }
                                        </div>
                                    </div>

                                    <!-- Study Schedule -->
                                    <div class="col-12">
                                        <div class="bg-light rounded p-3">
                                            <div class="d-flex align-items-center mb-2">
                                                <i class="fas fa-calendar-alt fa-lg text-info me-2"></i>
                                                <h6 class="mb-0">Study Schedule</h6>
                                            </div>
                                            <p class="small mb-2">Study for <strong>1 hour</strong> today to stay on track</p>
                                            <div class="d-flex justify-content-between">
                                                @foreach (var day in GetStudySchedule())
                                                {
                                                    <div class="text-center">
                                                        <div class="small @(day.IsToday ? "fw-bold text-primary" : "text-muted")">
                                                            @day.Day
                                                        </div>
                                                        @if (day.HasStudy)
                                                        {
                                                            <i class="fas fa-check text-success"></i>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Desktop Recommendations -->
                            <div class="d-none d-md-block">
                                <div class="row row-cols-1 row-cols-md-3 g-4">
                                    <!-- Most Progress -->
                                    <div class="col">
                                        <div class="card h-100 border-primary">
                                            <div class="card-body text-center">
                                                <i class="fas fa-trophy fa-2x text-warning mb-3"></i>
                                                <h6>Almost There!</h6>
                                                @if (mostProgressEnrollment != null)
                                                {
                                                    <p class="small mb-2">
                                                        Complete <strong>@GetCourseTitle(mostProgressEnrollment)</strong>
                                                    </p>
                                                    <div class="progress mb-3" style="height: 8px;">
                                                        <div class="progress-bar bg-success"
                                                             role="progressbar"
                                                             style="width: @mostProgressEnrollment.ProgressPercentage%;"></div>
                                                    </div>
                                                    <button class="btn btn-sm btn-primary"
                                                            @onclick="() => ContinueLearning(mostProgressEnrollment)">
                                                        Finish Course
                                                    </button>
                                                }
                                                else
                                                {
                                                    <p class="text-muted small">No course with high progress</p>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Need Attention -->
                                    <div class="col">
                                        <div class="card h-100 border-warning">
                                            <div class="card-body text-center">
                                                <i class="fas fa-exclamation-circle fa-2x text-warning mb-3"></i>
                                                <h6>Needs Attention</h6>
                                                @if (leastProgressEnrollment != null)
                                                {
                                                    <p class="small mb-2">
                                                        Start <strong>@GetCourseTitle(leastProgressEnrollment)</strong>
                                                    </p>
                                                    <div class="progress mb-3" style="height: 8px;">
                                                        <div class="progress-bar bg-warning"
                                                             role="progressbar"
                                                             style="width: @leastProgressEnrollment.ProgressPercentage%;"></div>
                                                    </div>
                                                    <button class="btn btn-sm btn-warning"
                                                            @onclick="() => ContinueLearning(leastProgressEnrollment)">
                                                        Start Now
                                                    </button>
                                                }
                                                else
                                                {
                                                    <p class="text-muted small">All courses have good progress</p>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Study Schedule -->
                                    <div class="col">
                                        <div class="card h-100 border-info">
                                            <div class="card-body text-center">
                                                <i class="fas fa-calendar-alt fa-2x text-info mb-3"></i>
                                                <h6>Study Schedule</h6>
                                                <p class="small mb-3">
                                                    Study for <strong>1 hour</strong> today to stay on track
                                                </p>
                                                <div class="d-flex justify-content-center gap-2">
                                                    @foreach (var day in GetStudySchedule())
                                                    {
                                                        <div class="text-center">
                                                            <div class="small @(day.IsToday ? "fw-bold text-primary" : "text-muted")">
                                                                @day.Day
                                                            </div>
                                                            @if (day.HasStudy)
                                                            {
                                                                <i class="fas fa-check text-success"></i>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">-</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Bottom Navigation for Mobile (Quick Access) -->
<div class="d-block d-md-none fixed-bottom bg-white border-top p-2">
    <div class="row g-2">
        <div class="col">
            <button class="btn btn-outline-primary w-100" @onclick="SortByProgress">
                <i class="fas fa-sort-amount-down me-1"></i> Progress
            </button>
        </div>
        <div class="col">
            <button class="btn btn-outline-primary w-100" @onclick="SortByRecent">
                <i class="fas fa-clock me-1"></i> Recent
            </button>
        </div>
    </div>
</div>

<!-- Spacer for mobile bottom navigation -->
<div class="d-block d-md-none" style="height: 60px;"></div>

@code {
    // ... (keep all your existing code in the @code block exactly as is)
    private List<EnrollmentDto> activeEnrollments = new();
    private List<EnrollmentDto> sortedEnrollments = new();
    private EnrollmentDto? mostProgressEnrollment;
    private EnrollmentDto? leastProgressEnrollment;
    private string sortBy = "progress";
    private double averageProgress = 0;
    private int upcomingDeadlines = 0;
    private int totalStudyHours = 0;
    private bool isLoading = true;
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadActiveCourses();
    }

    private async Task LoadActiveCourses()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // SIMPLE AUTHENTICATION CHECK - SAME AS NOTIFICATIONS AND SIDEBAR
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                await LoadUserEnrollments();
            }
            else
            {
                // If not authenticated, we can optionally try to get user data
                // but the main check should be the token
                var currentUser = await AuthService.GetCurrentUserAsync();
                if (currentUser != null)
                {
                    // If AuthService returns a user, update authentication state
                    isAuthenticated = true;
                    await LoadUserEnrollments();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in LoadActiveCourses: {ex.Message}");
            isAuthenticated = false;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadUserEnrollments()
    {
        try
        {
            // Get user's enrollments using EnrollmentService
            // The service should automatically include the auth token
            var enrollments = await EnrollmentService.GetMyEnrollmentsAsync(
                type: null,       // No type filter (get all types)
                completed: false  // Get only non-completed enrollments
            );

            if (enrollments != null)
            {
                activeEnrollments = enrollments.ToList();

                // For each enrollment, load progress trackings if not already loaded
                foreach (var enrollment in activeEnrollments)
                {
                    if (enrollment.ProgressTrackings == null || !enrollment.ProgressTrackings.Any())
                    {
                        // Load progress trackings for this enrollment
                        var progress = await EnrollmentService.GetEnrollmentProgressAsync(enrollment.Id);
                        if (progress != null)
                        {
                            enrollment.ProgressTrackings = progress;
                        }
                    }
                }

                // Calculate stats
                if (activeEnrollments.Any())
                {
                    averageProgress = activeEnrollments.Average(e => e.ProgressPercentage);
                    upcomingDeadlines = CalculateUpcomingDeadlines();
                    totalStudyHours = CalculateTotalStudyHours();

                    // Find recommendations
                    mostProgressEnrollment = activeEnrollments
                        .Where(e => e.ProgressPercentage < 100)
                        .OrderByDescending(e => e.ProgressPercentage)
                        .FirstOrDefault();

                    leastProgressEnrollment = activeEnrollments
                        .Where(e => e.ProgressPercentage < 50)
                        .OrderBy(e => e.ProgressPercentage)
                        .FirstOrDefault();
                }

                // Initial sort
                SortByProgress();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user enrollments: {ex.Message}");

            // If unauthorized, check authentication again
            if (ex.Message.Contains("401") || ex.Message.Contains("Unauthorized"))
            {
                // Re-check authentication
                isAuthenticated = await TokenService.IsAuthenticatedAsync();
                if (!isAuthenticated)
                {
                    Console.WriteLine("User is not authenticated after 401 error");
                }
            }
        }
    }

    private void SortByProgress()
    {
        sortBy = "progress";
        sortedEnrollments = activeEnrollments
            .OrderByDescending(e => e.ProgressPercentage)
            .ToList();
        StateHasChanged();
    }

    private void SortByRecent()
    {
        sortBy = "recent";
        sortedEnrollments = activeEnrollments
            .OrderByDescending(e => GetLastAccessedDate(e))
            .ToList();
        StateHasChanged();
    }

    private string GetCourseTitle(EnrollmentDto enrollment)
    {
        if (enrollment == null) return "Unknown";

        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => enrollment.Specialization?.Title ?? "Specialization",
            EnrollmentType.Course => enrollment.Course?.Title ?? "Course",
            EnrollmentType.Lecture => enrollment.Lecture?.Title ?? "Lecture",
            _ => "Unknown"
        };
    }

    private string? GetCourseThumbnail(EnrollmentDto enrollment)
    {
        if (enrollment == null) return null;

        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => enrollment.Specialization?.ThumbnailUrl,
            EnrollmentType.Course => enrollment.Course?.ThumbnailUrl,
            _ => null
        };
    }

    private string GetCourseType(EnrollmentDto enrollment)
    {
        if (enrollment == null) return "Unknown";

        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => "Specialization",
            EnrollmentType.Course => "Course",
            EnrollmentType.Lecture => "Lecture",
            _ => "Unknown"
        };
    }

    private string GetLastAccessed(EnrollmentDto enrollment)
    {
        if (enrollment == null || enrollment.ProgressTrackings == null || !enrollment.ProgressTrackings.Any())
            return "Never";

        // Get last progress tracking date
        var lastProgress = enrollment.ProgressTrackings
            .Where(p => p.TimeSpentSeconds > 0)
            .OrderByDescending(p => p.CompletedDate ?? p.CreatedAt)
            .FirstOrDefault();

        if (lastProgress != null)
        {
            var date = lastProgress.CompletedDate ?? lastProgress.CreatedAt;
            var daysAgo = (DateTime.UtcNow - date).Days;

            if (daysAgo == 0) return "Today";
            if (daysAgo == 1) return "Yesterday";
            if (daysAgo < 7) return $"{daysAgo} days ago";
            return date.ToString("MMM dd");
        }

        return "Never";
    }

    private DateTime GetLastAccessedDate(EnrollmentDto enrollment)
    {
        if (enrollment == null || enrollment.ProgressTrackings == null || !enrollment.ProgressTrackings.Any())
            return DateTime.MinValue;

        var lastProgress = enrollment.ProgressTrackings
            .Where(p => p.TimeSpentSeconds > 0)
            .OrderByDescending(p => p.CompletedDate ?? p.CreatedAt)
            .FirstOrDefault();

        return lastProgress?.CompletedDate ?? lastProgress?.CreatedAt ?? enrollment.EnrollmentDate;
    }

    private double GetTimeSpent(EnrollmentDto enrollment)
    {
        if (enrollment?.ProgressTrackings == null || !enrollment.ProgressTrackings.Any())
            return 0;

        var totalSeconds = enrollment.ProgressTrackings.Sum(p => p.TimeSpentSeconds);
        return Math.Round(totalSeconds / 3600.0, 1);
    }

    private bool HasDeadline(EnrollmentDto enrollment)
    {
        if (enrollment == null) return false;

        // Check if enrollment has any deadlines
        var daysSinceEnrollment = (DateTime.UtcNow - enrollment.EnrollmentDate).Days;

        // Example logic: If enrolled more than 30 days ago and less than 50% progress
        return enrollment.ProgressPercentage < 50 && daysSinceEnrollment > 30;
    }

    private string GetDeadlineText(EnrollmentDto enrollment)
    {
        if (enrollment == null) return "No deadline";

        var daysSinceEnrollment = (DateTime.UtcNow - enrollment.EnrollmentDate).Days;
        var daysLeft = 60 - daysSinceEnrollment; // 60-day course deadline

        if (daysLeft > 0)
        {
            return $"{daysLeft} days left";
        }
        return "Overdue";
    }

    private int CalculateUpcomingDeadlines()
    {
        var count = 0;
        foreach (var enrollment in activeEnrollments)
        {
            if (HasDeadline(enrollment))
            {
                count++;
            }
        }
        return count;
    }

    private int CalculateTotalStudyHours()
    {
        // Calculate study hours for the past 7 days
        var oneWeekAgo = DateTime.UtcNow.AddDays(-7);
        int totalSeconds = 0;

        foreach (var enrollment in activeEnrollments)
        {
            if (enrollment.ProgressTrackings == null)
                continue;

            foreach (var progress in enrollment.ProgressTrackings)
            {
                var progressDate = progress.CompletedDate ?? progress.CreatedAt;
                if (progressDate >= oneWeekAgo)
                {
                    totalSeconds += progress.TimeSpentSeconds;
                }
            }
        }

        return totalSeconds / 3600;
    }

    private List<StudyDay> GetStudySchedule()
    {
        var schedule = new List<StudyDay>();
        var today = DateTime.Today;

        for (int i = -3; i <= 3; i++)
        {
            var day = today.AddDays(i);
            var dayName = day.ToString("ddd");
            var isToday = i == 0;

            // Check if there was study activity on this day
            var hasStudy = false;
            foreach (var enrollment in activeEnrollments)
            {
                if (enrollment.ProgressTrackings == null)
                    continue;

                foreach (var progress in enrollment.ProgressTrackings)
                {
                    var progressDate = progress.CompletedDate ?? progress.CreatedAt;
                    if (progressDate.Date == day.Date && progress.TimeSpentSeconds > 0)
                    {
                        hasStudy = true;
                        break;
                    }
                }
                if (hasStudy) break;
            }

            schedule.Add(new StudyDay
            {
                Day = dayName,
                IsToday = isToday,
                HasStudy = hasStudy
            });
        }

        return schedule;
    }

    private void ContinueLearning(EnrollmentDto enrollment)
    {
        if (enrollment == null) return;

        switch (enrollment.EnrollmentType)
        {
            case EnrollmentType.Specialization:
                if (enrollment.SpecializationId.HasValue)
                    Navigation.NavigateTo($"/student/mylearning/specialization/{enrollment.SpecializationId.Value}");
                break;
            case EnrollmentType.Course:
                if (enrollment.CourseId.HasValue)
                    Navigation.NavigateTo($"/student/mylearning/course/{enrollment.CourseId.Value}");
                break;
            case EnrollmentType.Lecture:
                if (enrollment.LectureId.HasValue)
                    Navigation.NavigateTo($"/student/mylearning/lecture/{enrollment.LectureId.Value}");
                break;
        }
    }

