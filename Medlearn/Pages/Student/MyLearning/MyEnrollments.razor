@page "/student/mylearning"
@page "/student/mylearning/enrollments"
@page "/my-enrollments"


<PageTitle>My Enrollments</PageTitle>

<div class="my-enrollments">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none mb-3">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <div class="flex-grow-1">
                        <h5 class="mb-0">My Learning</h5>
                        <small class="opacity-75">Track your progress</small>
                    </div>
                    <button class="btn btn-link text-white p-0" @onclick='() => Navigation.NavigateTo("/browse")'>
                        <i class="fas fa-search fa-lg"></i>
                    </button>
                </div>
            </div>
            
            <!-- Mobile Stats Cards -->
            @if (!isLoading && isAuthenticated && allEnrollments.Any())
            {
                <div class="px-3 mt-3">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="card bg-light border-0">
                                <div class="card-body p-2 text-center">
                                    <small class="text-muted d-block">Enrolled</small>
                                    <span class="fw-bold fs-5">@allEnrollments.Count</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card bg-light border-0">
                                <div class="card-body p-2 text-center">
                                    <small class="text-muted d-block">Completed</small>
                                    <span class="fw-bold fs-5">@completedEnrollments.Count</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card bg-light border-0">
                                <div class="card-body p-2 text-center">
                                    <small class="text-muted d-block">Hours</small>
                                    <span class="fw-bold fs-5">@totalStudyHours</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card bg-light border-0">
                                <div class="card-body p-2 text-center">
                                    <small class="text-muted d-block">Rate</small>
                                    <span class="fw-bold fs-5">@completionRate.ToString("0")%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>My Learning</h1>
                <p class="text-muted mb-0">Track your progress across all enrollments</p>
            </div>
            <div>
                <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/browse")'>
                    <i class="fas fa-plus me-2"></i> Browse More
                </button>
            </div>
        </div>

        <!-- Tabs - Responsive -->
        <div class="row mb-3 mb-md-4">
            <div class="col-12">
                <!-- Mobile Tabs (Scrollable) -->
                <div class="d-block d-md-none">
                    <div class="nav nav-tabs flex-nowrap overflow-auto" style="white-space: nowrap; -webkit-overflow-scrolling: touch;">
                        <div class="nav-item">
                            <button class="nav-link @(activeTab == "all" ? "active" : "")" 
                                    @onclick='() => SwitchTab("all")'>
                                All (@allEnrollments.Count)
                            </button>
                        </div>
                        <div class="nav-item">
                            <button class="nav-link @(activeTab == "active" ? "active" : "")" 
                                    @onclick='() => SwitchTab("active")'>
                                Active (@activeEnrollments.Count)
                            </button>
                        </div>
                        <div class="nav-item">
                            <button class="nav-link @(activeTab == "completed" ? "active" : "")" 
                                    @onclick='() => SwitchTab("completed")'>
                                Completed (@completedEnrollments.Count)
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Desktop Tabs -->
                <div class="d-none d-md-block">
                    <ul class="nav nav-tabs">
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "all" ? "active" : "")" 
                                    @onclick='() => SwitchTab("all")'>
                                All Enrollments
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "active" ? "active" : "")" 
                                    @onclick='() => SwitchTab("active")'>
                                Active (@activeEnrollments.Count)
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "completed" ? "active" : "")" 
                                    @onclick='() => SwitchTab("completed")'>
                                Completed (@completedEnrollments.Count)
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading your enrollments...</p>
            </div>
        }
        else if (!isAuthenticated)
        {
            <div class="text-center py-5">
                <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                <h4>Authentication Required</h4>
                <p class="text-muted mb-4">Please log in to view your enrollments</p>
                <button class="btn btn-primary" @onclick="NavigateToLogin">
                    <i class="fas fa-sign-in-alt me-2"></i> Go to Login
                </button>
            </div>
        }
        else if (!currentEnrollments.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-graduation-cap fa-3x text-muted mb-3"></i>
                <h4>No @(activeTab == "all" ? "" : activeTab) enrollments found</h4>
                <p class="text-muted mb-4">
                    @(activeTab == "completed" 
                        ? "Complete a course to see it here" 
                        : "Start your learning journey by enrolling in a course")
                </p>
                <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/browse")'>
                    <i class="fas fa-search me-2"></i> Browse Courses
                </button>
            </div>
        }
        else
        {
            <div class="row">
                <!-- Desktop Stats Summary (Hidden on Mobile) -->
                <div class="col-12 mb-4 d-none d-md-block">
                    <div class="card">
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-3 border-end">
                                    <div class="display-6 fw-bold text-primary">@currentEnrollments.Count</div>
                                    <small class="text-muted">Total Enrollments</small>
                                </div>
                                <div class="col-md-3 border-end">
                                    <div class="display-6 fw-bold text-success">@completionRate.ToString("0.0")%</div>
                                    <small class="text-muted">Completion Rate</small>
                                </div>
                                <div class="col-md-3 border-end">
                                    <div class="display-6 fw-bold text-info">@totalStudyHours</div>
                                    <small class="text-muted">Study Hours</small>
                                </div>
                                <div class="col-md-3">
                                    <div class="display-6 fw-bold text-warning">$@totalSpent.ToString("N2")</div>
                                    <small class="text-muted">Total Spent</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Enrollments Grid - Responsive -->
                <div class="col-12">
                    <!-- Mobile View (List) -->
                    <div class="d-block d-md-none">
                        @foreach (var enrollment in currentEnrollments)
                        {
                            <div class="card mb-3 border-0 shadow-sm">
                                <div class="row g-0">
                                    <div class="col-4">
                                        <div class="position-relative h-100">
                                            @if (GetEnrollmentThumbnail(enrollment) != null)
                                            {
                                                <img src="@GetEnrollmentThumbnail(enrollment)" 
                                                     class="img-fluid rounded-start h-100" 
                                                     alt="Course" 
                                                     style="object-fit: cover; width: 100%;" />
                                            }
                                            else
                                            {
                                                <div class="bg-gradient-primary d-flex align-items-center justify-content-center h-100 rounded-start">
                                                    <i class="fas fa-book fa-2x text-white"></i>
                                                </div>
                                            }
                                            @if (enrollment.IsCompleted)
                                            {
                                                <span class="position-absolute top-0 end-0 m-1 badge bg-success" style="font-size: 0.7rem;">
                                                    <i class="fas fa-check-circle"></i>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-8">
                                        <div class="card-body p-2">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <h6 class="card-title mb-0 small fw-bold">@GetEnrollmentTitle(enrollment)</h6>
                                                <span class="badge @GetEnrollmentTypeBadge(enrollment.EnrollmentType)" style="font-size: 0.6rem;">
                                                    @enrollment.EnrollmentType.ToString()
                                                </span>
                                            </div>
                                            
                                            <!-- Progress Bar -->
                                            <div class="mb-2">
                                                <div class="d-flex justify-content-between mb-1">
                                                    <small class="text-muted" style="font-size: 0.7rem;">Progress</small>
                                                    <small class="text-muted" style="font-size: 0.7rem;">@enrollment.ProgressPercentage.ToString("0")%</small>
                                                </div>
                                                <div class="progress" style="height: 4px;">
                                                    <div class="progress-bar" role="progressbar" 
                                                         style="width: @enrollment.ProgressPercentage%;" 
                                                         aria-valuenow="@enrollment.ProgressPercentage" 
                                                         aria-valuemin="0" aria-valuemax="100">
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <!-- Enrollment Date -->
                                            <small class="text-muted d-block mb-2" style="font-size: 0.7rem;">
                                                <i class="fas fa-calendar me-1"></i>
                                                @enrollment.EnrollmentDate.ToString("MMM dd, yyyy")
                                            </small>
                                            
                                            <!-- Action Buttons -->
                                            <div class="d-grid">
                                                <button class="btn btn-primary btn-sm" @onclick="() => ContinueLearning(enrollment)">
                                                    <i class="fas fa-play me-1"></i> Continue
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Desktop View (Grid) -->
                    <div class="d-none d-md-block">
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                            @foreach (var enrollment in currentEnrollments)
                            {
                                <div class="col">
                                    <div class="card h-100">
                                        <div class="position-relative">
                                            @if (GetEnrollmentThumbnail(enrollment) != null)
                                            {
                                                <img src="@GetEnrollmentThumbnail(enrollment)" class="card-img-top" alt="Course" style="height: 160px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="card-img-top bg-gradient-primary d-flex align-items-center justify-content-center" style="height: 160px;">
                                                    <i class="fas fa-book fa-3x text-white"></i>
                                                </div>
                                            }
                                            @if (enrollment.IsCompleted)
                                            {
                                                <span class="position-absolute top-0 end-0 m-2 badge bg-success">
                                                    <i class="fas fa-check-circle me-1"></i> Completed
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="position-absolute top-0 end-0 m-2 badge bg-primary">
                                                    @enrollment.ProgressPercentage.ToString("0.0")%
                                                </span>
                                            }
                                        </div>
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h6 class="card-title mb-0">@GetEnrollmentTitle(enrollment)</h6>
                                                <span class="badge @GetEnrollmentTypeBadge(enrollment.EnrollmentType)">
                                                    @enrollment.EnrollmentType.ToString()
                                                </span>
                                            </div>
                                            
                                            <p class="card-text text-muted small mb-3">
                                                @GetEnrollmentDescription(enrollment)
                                            </p>
                                            
                                            <!-- Progress Bar -->
                                            <div class="mb-3">
                                                <div class="d-flex justify-content-between mb-1">
                                                    <small class="text-muted">Progress</small>
                                                    <small class="text-muted">@enrollment.ProgressPercentage.ToString("0.0")%</small>
                                                </div>
                                                <div class="progress" style="height: 6px;">
                                                    <div class="progress-bar" role="progressbar" 
                                                         style="width: @enrollment.ProgressPercentage%;" 
                                                         aria-valuenow="@enrollment.ProgressPercentage" 
                                                         aria-valuemin="0" aria-valuemax="100">
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <!-- Enrollment Info -->
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <small class="text-muted">
                                                    <i class="fas fa-calendar me-1"></i>
                                                    @enrollment.EnrollmentDate.ToString("MMM dd, yyyy")
                                                </small>
                                                @if (enrollment.IsCompleted && enrollment.CompletedDate.HasValue)
                                                {
                                                    <small class="text-success">
                                                        <i class="fas fa-check-circle me-1"></i>
                                                        @enrollment.CompletedDate.Value.ToString("MMM dd")
                                                    </small>
                                                }
                                            </div>
                                            
                                            <!-- Action Buttons -->
                                            <div class="d-grid gap-2">
                                                @if (enrollment.IsCompleted)
                                                {
                                                    <button class="btn btn-primary" @onclick="() => ContinueLearning(enrollment)">
                                                        <i class="fas fa-play me-2"></i> Keep Learning
                                                    </button>
                                                    
                                                    @if (enrollment.Review == null)
                                                    {
                                                        <button class="btn btn-outline-primary" @onclick="() => WriteReview(enrollment)">
                                                            <i class="fas fa-star me-2"></i> Write Review
                                                        </button>
                                                    }
                                                }
                                                else
                                                {
                                                    <button class="btn btn-primary" @onclick="() => ContinueLearning(enrollment)">
                                                        <i class="fas fa-play me-2"></i> Continue Learning
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<EnrollmentDto> allEnrollments = new();
    private List<EnrollmentDto> activeEnrollments = new();
    private List<EnrollmentDto> completedEnrollments = new();
    private List<EnrollmentDto> currentEnrollments = new();
    private string activeTab = "all";
    private decimal totalSpent = 0;
    private int totalStudyHours = 0;
    private double completionRate = 0;
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadEnrollments();
        
        // Set up auto-refresh timer (every 60 seconds for this page)
        refreshTimer = new Timer(async _ => await RefreshEnrollments(), null, 60000, 60000);
    }

    private async Task CheckAuthentication()
    {
        try
        {
            // SIMPLE AUTHENTICATION CHECK - SAME AS NOTIFICATIONS AND SIDEBAR
            isAuthenticated = await TokenService.IsAuthenticatedAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
        }
    }

    private async Task LoadEnrollments()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Check authentication first
            await CheckAuthentication();
            
            if (!isAuthenticated)
            {
                isLoading = false;
                StateHasChanged();
                return;
            }

            // Load enrollments using your EnrollmentService
            var enrollments = await EnrollmentService.GetMyEnrollmentsAsync(
                type: null,        // Get all types
                completed: null    // Get both completed and active
            );
            
            if (enrollments != null)
            {
                await ProcessEnrollments(enrollments);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading enrollments: {ex.Message}");
            
            // If unauthorized, update auth state
            if (ex.Message.Contains("401") || ex.Message.Contains("Unauthorized"))
            {
                isAuthenticated = false;
            }
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ProcessEnrollments(IEnumerable<EnrollmentDto> enrollments)
    {
        allEnrollments = enrollments.ToList();
        activeEnrollments = allEnrollments.Where(e => !e.IsCompleted).ToList();
        completedEnrollments = allEnrollments.Where(e => e.IsCompleted).ToList();
        
        // Load progress trackings for each enrollment
        await LoadProgressTrackings();
        
        // Calculate stats
        CalculateStats();
        
        // Set current tab
        SwitchTab(activeTab);
    }

    private async Task LoadProgressTrackings()
    {
        foreach (var enrollment in allEnrollments)
        {
            if (enrollment.ProgressTrackings == null || !enrollment.ProgressTrackings.Any())
            {
                try
                {
                    var progress = await EnrollmentService.GetEnrollmentProgressAsync(enrollment.Id);
                    if (progress != null)
                    {
                        enrollment.ProgressTrackings = progress;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading progress for enrollment {enrollment.Id}: {ex.Message}");
                }
            }
        }
    }

    private void CalculateStats()
    {
        totalSpent = allEnrollments.Sum(e => e.PricePaid);
        totalStudyHours = CalculateTotalStudyHours();
        completionRate = allEnrollments.Any() 
            ? (double)completedEnrollments.Count / allEnrollments.Count * 100 
            : 0;
    }

    private async Task RefreshEnrollments()
    {
        if (!isAuthenticated) return;
        
        await InvokeAsync(async () =>
        {
            try
            {
                Console.WriteLine("Refreshing enrollments...");
                await LoadEnrollments();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error refreshing enrollments: {ex.Message}");
            }
        });
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        currentEnrollments = tab switch
        {
            "active" => activeEnrollments,
            "completed" => completedEnrollments,
            _ => allEnrollments
        };
        StateHasChanged();
    }

    private string GetEnrollmentTitle(EnrollmentDto enrollment)
    {
        if (enrollment == null) return "Unknown";
        
        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => enrollment.Specialization?.Title ?? "Specialization",
            EnrollmentType.Course => enrollment.Course?.Title ?? "Course",
            EnrollmentType.Lecture => enrollment.Lecture?.Title ?? "Lecture",
            _ => "Unknown"
        };
    }

    private string? GetEnrollmentThumbnail(EnrollmentDto enrollment)
    {
        if (enrollment == null) return null;
        
        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => enrollment.Specialization?.ThumbnailUrl,
            EnrollmentType.Course => enrollment.Course?.ThumbnailUrl,
            EnrollmentType.Lecture => null,
            _ => null
        };
    }

    private string GetEnrollmentDescription(EnrollmentDto enrollment)
    {
        if (enrollment == null) return "No description available";
        
        var description = enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => enrollment.Specialization?.Description,
            EnrollmentType.Course => enrollment.Course?.Description,
            EnrollmentType.Lecture => enrollment.Lecture?.Description,
            _ => null
        };
        
        if (string.IsNullOrEmpty(description))
            return "No description available";
        
        return description.Length > 100 ? description.Substring(0, 100) + "..." : description;
    }

    private string GetEnrollmentTypeBadge(EnrollmentType type)
    {
        return type switch
        {
            EnrollmentType.Specialization => "bg-info",
            EnrollmentType.Course => "bg-primary",
            EnrollmentType.Lecture => "bg-secondary",
            _ => "bg-dark"
        };
    }

    private int CalculateTotalStudyHours()
    {
        int totalSeconds = 0;
        foreach (var enrollment in allEnrollments)
        {
            if (enrollment.ProgressTrackings != null)
            {
                foreach (var progress in enrollment.ProgressTrackings)
                {
                    totalSeconds += progress.TimeSpentSeconds;
                }
            }
        }
        return totalSeconds / 3600; // Convert seconds to hours
    }

    private void ContinueLearning(EnrollmentDto enrollment)
    {
        if (enrollment == null) return;
        
        switch (enrollment.EnrollmentType)
        {
            case EnrollmentType.Specialization:
                if (enrollment.SpecializationId.HasValue)
                    Navigation.NavigateTo($"/student/mylearning/specialization/{enrollment.SpecializationId.Value}");
                break;
            case EnrollmentType.Course:
                if (enrollment.CourseId.HasValue)
                    Navigation.NavigateTo($"/student/mylearning/course/{enrollment.CourseId.Value}");
                break;
            case EnrollmentType.Lecture:
                if (enrollment.LectureId.HasValue)
                    Navigation.NavigateTo($"/lecture/{enrollment.LectureId.Value}");
                break;
        }
    }

    private void ViewCertificate(EnrollmentDto enrollment)
    {
        Navigation.NavigateTo($"/student/mylearning/certificate/{enrollment.Id}");
    }

    private void WriteReview(EnrollmentDto enrollment)
    {
        Navigation.NavigateTo($"/student/reviews/write/{enrollment.Id}");
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login", true);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
