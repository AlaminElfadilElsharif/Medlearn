@page "/student/mylearning/course/{CourseId:int}"


<PageTitle>My Learning - @(course?.Title ?? "Course")</PageTitle>

<div class="course-learning-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading your course progress...</p>
        </div>
    }
    else if (enrollment == null || course == null)
    {
        <div class="alert alert-warning mt-4">
            <i class="fas fa-exclamation-triangle me-2"></i>
            You are not enrolled in this course.
            <a href="/course/@CourseId" class="alert-link ms-2">View course details</a>
        </div>
    }
    else
    {
        <div class="container-fluid px-0 px-md-3 py-2 py-md-4">
            <!-- Mobile Header -->
            <div class="d-block d-md-none mb-3">
                <div class="bg-primary text-white p-3">
                    <div class="d-flex align-items-center">
                        <button class="btn btn-link text-white p-0 me-2" @onclick="GoBack">
                            <i class="fas fa-arrow-left fa-lg"></i>
                        </button>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 text-truncate">@course.Title</h6>
                            <small class="opacity-75">My Learning</small>
                        </div>
                        <button class="btn btn-link text-white p-0 ms-2" @onclick="ShareProgress">
                            <i class="fas fa-share-alt fa-lg"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Mobile Progress Card -->
                <div class="card border-0 rounded-0 shadow-sm">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center">
                            <div class="position-relative me-3">
                                <svg width="70" height="70" viewBox="0 0 70 70">
                                    <circle cx="35" cy="35" r="32" fill="none" stroke="#e9ecef" stroke-width="4"/>
                                    <circle cx="35" cy="35" r="32" fill="none" 
                                            stroke="@GetProgressColor()" 
                                            stroke-width="4" 
                                            stroke-linecap="round"
                                            stroke-dasharray="@(overallProgress * 2.01) 201"
                                            transform="rotate(-90 35 35)"/>
                                    <text x="35" y="42" text-anchor="middle" font-size="14" font-weight="bold" fill="@GetProgressColor()">
                                        @overallProgress.ToString("0")%
                                    </text>
                                </svg>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small">Course Progress</span>
                                    <span class="small fw-bold">@completedLectures/@totalLectures lectures</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar @GetProgressBarClass()" 
                                         role="progressbar" 
                                         style="width: @overallProgress%">
                                    </div>
                                </div>
                                @if (totalTimeSpentHours > 0)
                                {
                                    <small class="text-muted d-block mt-2">
                                        <i class="fas fa-clock me-1"></i> @totalTimeSpentHours.ToString("0.0") hours spent
                                    </small>
                                }
                            </div>
                        </div>
                        
                        <!-- Mobile Action Buttons -->
                        <div class="row g-2 mt-3">
                            <div class="col-6">
                                @if (overallProgress < 100)
                                {
                                    <button class="btn btn-primary w-100 btn-sm" @onclick="ContinueLearning">
                                        <i class="fas fa-play me-1"></i> Continue
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-success w-100 btn-sm" @onclick="RestartCourse">
                                        <i class="fas fa-redo me-1"></i> Review
                                    </button>
                                }
                            </div>
                            <div class="col-6">
                                <button class="btn btn-outline-secondary w-100 btn-sm" @onclick="DownloadResources">
                                    <i class="fas fa-download me-1"></i> Resources
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Desktop Breadcrumb -->
            <div class="d-none d-md-block">
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/student/dashboard">Dashboard</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="/student/mylearning">My Learning</a>
                        </li>
                        @if (course.SpecializationId > 0)
                        {
                            <li class="breadcrumb-item">
                                <a href="/student/mylearning/specialization/@course.SpecializationId">
                                    @specializationTitle
                                </a>
                            </li>
                        }
                        <li class="breadcrumb-item active" aria-current="page">
                            @course.Title
                        </li>
                    </ol>
                </nav>
            </div>

            <!-- Desktop Header -->
            <div class="d-none d-md-block course-header mb-5">
                <div class="row">
                    <div class="col-md-8">
                        <div class="d-flex align-items-start">
                            <div class="course-thumbnail me-4">
                                @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                {
                                    <img src="@GetImageUrl(course.ThumbnailUrl)" 
                                         class="rounded" 
                                         alt="@course.Title"
                                         onerror="this.onerror=null;this.src='https://placehold.co/200x150?text=Course';"
                                         style="width: 150px; height: 100px; object-fit: cover;">
                                }
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h1 class="course-title mb-2">@course.Title</h1>
                                        <div class="course-meta mb-3">
                                            <span class="badge bg-info">Course</span>
                                            @if (!string.IsNullOrEmpty(specializationTitle))
                                            {
                                                <span class="text-muted ms-2">
                                                    <i class="fas fa-layer-group me-1"></i> Part of @specializationTitle
                                                </span>
                                            }
                                            <span class="text-muted ms-2">
                                                <i class="fas fa-user-md me-1"></i> @course.Doctor?.FirstName @course.Doctor?.LastName
                                            </span>
                                            <span class="text-muted ms-2">
                                                <i class="fas fa-calendar me-1"></i> Enrolled on @enrollment.EnrollmentDate.ToString("MMM dd, yyyy")
                                            </span>
                                        </div>
                                    </div>
                                    @if (overallProgress >= 100)
                                    {
                                        <div class="completion-badge">
                                            <span class="badge bg-success fs-6">
                                                <i class="fas fa-check-circle me-1"></i> Completed
                                            </span>
                                        </div>
                                    }
                                </div>
                                
                                <!-- Desktop Progress Bar -->
                                <div class="progress-info mt-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span>Course Progress</span>
                                        <span>@overallProgress.ToString("0.0")%</span>
                                    </div>
                                    <div class="progress" style="height: 12px;">
                                        <div class="progress-bar @GetProgressBarClass()" 
                                             role="progressbar" 
                                             style="width: @overallProgress%"
                                             aria-valuenow="@overallProgress" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                    <div class="progress-details mt-2">
                                        <small class="text-muted">
                                            @completedLectures of @totalLectures lectures completed
                                            @if (totalTimeSpentHours > 0)
                                            {
                                                <span class="ms-2">
                                                    <i class="fas fa-clock me-1"></i> @totalTimeSpentHours.ToString("0.0") hours spent
                                                </span>
                                            }
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="course-actions">
                            <div class="action-buttons mb-3">
                                @if (overallProgress < 100)
                                {
                                    <button class="btn btn-primary w-100 mb-2" @onclick="ContinueLearning">
                                        <i class="fas fa-play me-2"></i> Continue Learning
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-success w-100 mb-2" @onclick="RestartCourse">
                                        <i class="fas fa-redo me-2"></i> Review Course
                                    </button>
                                }
                                <button class="btn btn-outline-secondary w-100" @onclick="DownloadResources">
                                    <i class="fas fa-download me-2"></i> Download Resources
                                </button>
                            </div>
                            <div class="quick-stats">
                                <div class="row text-center">
                                    <div class="col-6">
                                        <div class="stat-item">
                                            <div class="stat-icon text-primary">
                                                <i class="fas fa-book"></i>
                                            </div>
                                            <div class="stat-value">@totalLectures</div>
                                            <div class="stat-label">Lectures</div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="stat-item">
                                            <div class="stat-icon text-success">
                                                <i class="fas fa-check-circle"></i>
                                            </div>
                                            <div class="stat-value">@completedLectures</div>
                                            <div class="stat-label">Completed</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="row g-3">
                <!-- Mobile Tabs Navigation -->
                <div class="d-block d-md-none mb-3">
                    <ul class="nav nav-pills nav-fill">
                        <li class="nav-item">
                            <button class="nav-link @(activeMobileTab == "lectures" ? "active" : "")" 
                                    @onclick='() => SetMobileTab("lectures")'>
                                <i class="fas fa-list me-1"></i> Lectures
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeMobileTab == "info" ? "active" : "")" 
                                    @onclick='() => SetMobileTab("info")'>
                                <i class="fas fa-info-circle me-1"></i> Info
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeMobileTab == "progress" ? "active" : "")" 
                                    @onclick='() => SetMobileTab("progress")'>
                                <i class="fas fa-chart-line me-1"></i> Progress
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeMobileTab == "actions" ? "active" : "")" 
                                    @onclick='() => SetMobileTab("actions")'>
                                <i class="fas fa-ellipsis-h me-1"></i> More
                            </button>
                        </li>
                    </ul>
                </div>

                <!-- Lectures Section (Mobile - always visible, full width) -->
                <div class="col-12 col-lg-8">
                    <!-- Mobile Lectures Header -->
                    <div class="d-block d-md-none mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Course Lectures</h5>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                                        type="button" 
                                        data-bs-toggle="dropdown">
                                    <i class="fas fa-sort me-1"></i> Sort
                                </button>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <button class="dropdown-item @(sortBy == "order" ? "active" : "")" 
                                            @onclick='() => SortLectures("order")'>
                                        <i class="fas fa-sort-numeric-down me-2"></i> By Order
                                    </button>
                                    <button class="dropdown-item @(sortBy == "progress" ? "active" : "")" 
                                            @onclick='() => SortLectures("progress")'>
                                        <i class="fas fa-sort-amount-down me-2"></i> By Progress
                                    </button>
                                    <button class="dropdown-item @(sortBy == "duration" ? "active" : "")" 
                                            @onclick='() => SortLectures("duration")'>
                                        <i class="fas fa-clock me-2"></i> By Duration
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Desktop Lectures Header -->
                    <div class="d-none d-md-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">Course Lectures</h4>
                        <div class="sort-options">
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn @(sortBy == "order" ? "btn-primary" : "btn-outline-secondary")" 
                                        @onclick='() => SortLectures("order")'>
                                    <i class="fas fa-sort-numeric-down"></i> By Order
                                </button>
                                <button class="btn @(sortBy == "progress" ? "btn-primary" : "btn-outline-secondary")" 
                                        @onclick='() => SortLectures("progress")'>
                                    <i class="fas fa-sort-amount-down"></i> By Progress
                                </button>
                                <button class="btn @(sortBy == "duration" ? "btn-primary" : "btn-outline-secondary")" 
                                        @onclick='() => SortLectures("duration")'>
                                    <i class="fas fa-clock"></i> By Duration
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Lectures List (Always visible) -->
                    <div class="card">
                        <div class="card-body p-2 p-md-3">
                            @if (sortedLectures != null && sortedLectures.Any())
                            {
                                <div class="lectures-list">
                                    @foreach (var lecture in sortedLectures)
                                    {
                                        var lectureProgress = CalculateLectureProgress(lecture.Id);
                                        var lectureMaterials = lecture.Materials?.Count ?? 0;
                                        var lectureDuration = CalculateLectureDuration(lecture);
                                        
                                        <div class="lecture-item mb-2 border rounded">
                                            <!-- Mobile Lecture Header -->
                                            <div class="d-block d-md-none">
                                                <div class="p-2" @onclick="() => ToggleLectureMaterials(lecture.Id)">
                                                    <div class="d-flex">
                                                        <div class="lecture-number-circle me-2">
                                                            <span class="badge bg-secondary rounded-circle p-2" style="width: 30px; height: 30px;">
                                                                @lecture.Order
                                                            </span>
                                                        </div>
                                                        <div class="flex-grow-1">
                                                            <div class="d-flex justify-content-between align-items-start">
                                                                <h6 class="mb-1">@lecture.Title</h6>
                                                                <i class="fas @(expandedLectures.Contains(lecture.Id) ? "fa-chevron-up" : "fa-chevron-down") text-muted"></i>
                                                            </div>
                                                            <div class="d-flex justify-content-between align-items-center">
                                                                <small class="text-muted">
                                                                    @lectureMaterials materials • @lectureDuration mins
                                                                </small>
                                                                <span class="badge @GetLectureProgressBadgeClass(lectureProgress)">
                                                                    @lectureProgress.ToString("0")%
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Desktop Lecture Header -->
                                            <div class="d-none d-md-block lecture-header p-3" 
                                                 @onclick="() => ToggleLectureMaterials(lecture.Id)"
                                                 style="cursor: pointer;">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="d-flex align-items-center">
                                                        <div class="lecture-number me-3">
                                                            @lecture.Order
                                                        </div>
                                                        <div>
                                                            <h5 class="mb-1">
                                                                <i class="fas @(expandedLectures.Contains(lecture.Id) ? "fa-chevron-down" : "fa-chevron-right") me-2 text-muted"></i>
                                                                @lecture.Title
                                                            </h5>
                                                            <div class="lecture-meta">
                                                                <small class="text-muted">
                                                                    @if (lectureMaterials > 0)
                                                                    {
                                                                        <span>
                                                                            <i class="fas fa-folder me-1"></i> @lectureMaterials materials
                                                                        </span>
                                                                    }
                                                                    @if (lectureDuration > 0)
                                                                    {
                                                                        <span class="ms-2">
                                                                            <i class="fas fa-clock me-1"></i> @lectureDuration mins
                                                                        </span>
                                                                    }
                                                                </small>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="d-flex align-items-center">
                                                        <div class="lecture-progress me-3">
                                                            <div class="progress" style="width: 100px; height: 6px;">
                                                                <div class="progress-bar @GetLectureProgressBarClass(lectureProgress)" 
                                                                     style="width: @lectureProgress%"></div>
                                                            </div>
                                                            <small class="text-muted d-block text-center mt-1">
                                                                @lectureProgress.ToString("0.0")%
                                                            </small>
                                                        </div>
                                                        <button class="btn @GetLectureButtonClass(lectureProgress) btn-sm" 
                                                                @onclick:stopPropagation
                                                                @onclick="() => StartLecture(lecture.Id)">
                                                            @GetLectureButtonIcon(lectureProgress) @GetLectureButtonText(lectureProgress)
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <!-- Lecture Materials (Mobile & Desktop) -->
                                            @if (expandedLectures.Contains(lecture.Id) && lecture.Materials != null && lecture.Materials.Any())
                                            {
                                                <div class="lecture-materials p-2 p-md-3 bg-light border-top">
                                                    <!-- Mobile Materials Header -->
                                                    <div class="d-block d-md-none">
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <h6 class="mb-0 small">
                                                                <i class="fas fa-folder-open me-1"></i>Materials
                                                            </h6>
                                                            <button class="btn btn-sm btn-outline-primary btn-sm" 
                                                                    @onclick="() => DownloadAllMaterials(lecture)">
                                                                <i class="fas fa-download me-1"></i> All
                                                            </button>
                                                        </div>
                                                    </div>

                                                    <!-- Desktop Materials Header -->
                                                    <div class="d-none d-md-block materials-header mb-3">
                                                        <h6 class="mb-2"><i class="fas fa-folder-open me-2"></i>Learning Materials</h6>
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <small class="text-muted">
                                                                @GetMaterialSummary(lecture)
                                                            </small>
                                                            <button class="btn btn-sm btn-outline-primary" 
                                                                    @onclick="() => DownloadAllMaterials(lecture)">
                                                                <i class="fas fa-download me-1"></i> Download All
                                                            </button>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="materials-list">
                                                        @foreach (var material in lecture.Materials.OrderBy(m => m.Order))
                                                        {
                                                            var materialProgress = GetMaterialProgress(material.Id);
                                                            var materialDuration = FormatDuration(material.DurationSeconds);
                                                            
                                                            <!-- Mobile Material Item -->
                                                            <div class="d-block d-md-none material-item mb-2 p-2 border rounded">
                                                                <div class="d-flex align-items-center mb-1">
                                                                    <div class="material-icon me-2">
                                                                        @GetMaterialIcon(material.Type)
                                                                    </div>
                                                                    <div class="flex-grow-1">
                                                                        <h6 class="mb-0 small fw-bold">@material.Title</h6>
                                                                        <small class="text-muted">
                                                                            @GetMaterialTypeName(material.Type)
                                                                            @if (material.DurationSeconds > 0)
                                                                            {
                                                                                <span> • @materialDuration</span>
                                                                            }
                                                                        </small>
                                                                    </div>
                                                                </div>
                                                                <div class="d-flex justify-content-between align-items-center mt-1">
                                                                    <div>
                                                                        @if (materialProgress >= 100)
                                                                        {
                                                                            <span class="badge bg-success">Completed</span>
                                                                        }
                                                                        else if (materialProgress > 0)
                                                                        {
                                                                            <small class="text-warning">In progress</small>
                                                                        }
                                                                    </div>
                                                                    <div>
                                                                        <button class="btn btn-sm @(materialProgress >= 100 ? "btn-outline-success" : "btn-outline-primary") btn-sm"
                                                                                @onclick="() => OpenMaterial(lecture.Id, material.Id)">
                                                                            <i class="fas @(materialProgress >= 100 ? "fa-redo" : "fa-play")"></i>
                                                                        </button>
                                                                        @if (material.IsDownloadable)
                                                                        {
                                                                            <button class="btn btn-sm btn-outline-secondary ms-1"
                                                                                    @onclick="() => DownloadMaterial(material)">
                                                                                <i class="fas fa-download"></i>
                                                                            </button>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- Desktop Material Item -->
                                                            <div class="d-none d-md-block material-item mb-2 p-2 border rounded">
                                                                <div class="d-flex justify-content-between align-items-center">
                                                                    <div class="d-flex align-items-center">
                                                                        <div class="material-icon me-3">
                                                                            @GetMaterialIcon(material.Type)
                                                                        </div>
                                                                        <div>
                                                                            <h6 class="mb-0">@material.Title</h6>
                                                                            <small class="text-muted">
                                                                                @GetMaterialTypeName(material.Type)
                                                                                @if (material.DurationSeconds > 0)
                                                                                {
                                                                                    <span class="ms-2">• @materialDuration</span>
                                                                                }
                                                                                @if (material.FileSize > 0)
                                                                                {
                                                                                    <span class="ms-2">• @FormatFileSize(material.FileSize)</span>
                                                                                }
                                                                            </small>
                                                                        </div>
                                                                    </div>
                                                                    <div class="material-actions">
                                                                        @if (materialProgress >= 100)
                                                                        {
                                                                            <span class="badge bg-success me-2">
                                                                                <i class="fas fa-check"></i> Completed
                                                                            </span>
                                                                        }
                                                                        <button class="btn btn-sm @(materialProgress >= 100 ? "btn-outline-success" : "btn-outline-primary")"
                                                                                @onclick="() => OpenMaterial(lecture.Id, material.Id)">
                                                                            <i class="fas @(materialProgress >= 100 ? "fa-redo" : "fa-play") me-1"></i>
                                                                            @(materialProgress >= 100 ? "Review" : "Open")
                                                                        </button>
                                                                        @if (material.IsDownloadable)
                                                                        {
                                                                            <button class="btn btn-sm btn-outline-secondary ms-2"
                                                                                    @onclick="() => DownloadMaterial(material)">
                                                                                <i class="fas fa-download"></i>
                                                                            </button>
                                                                        }
                                                                    </div>
                                                                </div>
                                                                @if (materialProgress > 0 && materialProgress < 100)
                                                                {
                                                                    <div class="material-progress mt-2">
                                                                        <div class="d-flex justify-content-between">
                                                                            <small>Progress</small>
                                                                            <small>@materialProgress%</small>
                                                                        </div>
                                                                        <div class="progress" style="height: 4px;">
                                                                            <div class="progress-bar bg-info" style="width: @materialProgress%"></div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="fas fa-video-slash fa-3x text-muted mb-3"></i>
                                    <p class="text-muted">No lectures available in this course yet</p>
                                    <p class="small">Check back later or contact the instructor</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Sidebar (Desktop only) -->
                <div class="d-none d-lg-block col-lg-4">
                    <!-- Course Info Card -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Course Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <h6><i class="fas fa-info-circle me-2"></i>Description</h6>
                                <p class="small">@course.Description</p>
                            </div>
                            
                            @if (course.Doctor != null)
                            {
                                <div class="instructor-info mb-3">
                                    <h6><i class="fas fa-user-md me-2"></i>Instructor</h6>
                                    <div class="d-flex align-items-center">
                                        <div class="instructor-avatar me-2">
                                            @if (!string.IsNullOrEmpty(course.Doctor.ProfileImageUrl))
                                            {
                                                <img src="@GetImageUrl(course.Doctor.ProfileImageUrl)" 
                                                     class="rounded-circle" 
                                                     alt="Instructor"
