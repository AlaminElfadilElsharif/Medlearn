@code {
    [Parameter] public int CourseId { get; set; }

    private CourseDto? course;
    private EnrollmentDto? enrollment;
    private List<EnrollmentDto>? allEnrollments;
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private HashSet<int> expandedLectures = new();
    private List<LectureDto>? sortedLectures;
    private string sortBy = "order";
    private string specializationTitle = "";
    private string activeMobileTab = "lectures"; // For mobile tab navigation
    
    // Progress tracking
    private double overallProgress = 0;
    private int totalLectures = 0;
    private int completedLectures = 0;
    private int inProgressLectures = 0;
    private int notStartedLectures = 0;
    private int totalMaterials = 0;
    private double totalTimeSpentHours = 0;
    
    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
        await LoadData();
    }

    private async Task CheckAuthentication()
    {
        isAuthenticated = await TokenService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo($"/account/login?returnUrl=/student/mylearning/course/{CourseId}");
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();
        
        try
        {
            // Load course details
            course = await CourseService.GetCourseAsync(CourseId);
            
            if (course == null)
            {
                await ShowToast("error", "Course not found");
                return;
            }

            // Load specialization title if available
            if (course.SpecializationId > 0)
            {
                var specialization = await SpecializationService.GetSpecializationAsync(course.SpecializationId);
                specializationTitle = specialization?.Title ?? "";
            }

            // Load all user enrollments
            allEnrollments = await EnrollmentService.GetMyEnrollmentsAsync();
            
            // Find course enrollment
            enrollment = allEnrollments?.FirstOrDefault(e => e.CourseId == CourseId);
            
            // If no direct course enrollment, check for specialization enrollment that includes this course
            if (enrollment == null && course.SpecializationId > 0)
            {
                enrollment = allEnrollments?.FirstOrDefault(e => e.SpecializationId == course.SpecializationId);
            }
            
            // If still no enrollment, check for individual lecture enrollments in this course
            if (enrollment == null && course.Lectures != null)
            {
                foreach (var lecture in course.Lectures)
                {
                    var lectureEnrollment = allEnrollments?.FirstOrDefault(e => e.LectureId == lecture.Id);
                    if (lectureEnrollment != null)
                    {
                        enrollment = lectureEnrollment;
                        break;
                    }
                }
            }

            if (enrollment == null)
            {
                await ShowToast("warning", "You are not enrolled in this course");
                return;
            }

            // Calculate progress statistics
            CalculateProgressStatistics();
            
            // Initialize sorted lectures
            if (course.Lectures != null)
            {
                sortedLectures = course.Lectures.OrderBy(l => l.Order).ToList();
                
                // Calculate total materials
                totalMaterials = course.Lectures
                    .Where(l => l.Materials != null)
                    .Sum(l => l.Materials.Count);
            }
            
            // Auto-expand first lecture
            if (sortedLectures != null && sortedLectures.Any())
            {
                expandedLectures.Add(sortedLectures.First().Id);
            }
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/student/mylearning");
    }

    private void SetMobileTab(string tab)
    {
        activeMobileTab = tab;
        StateHasChanged();
    }

    private void CalculateProgressStatistics()
    {
        if (course?.Lectures == null || enrollment == null) return;

        totalLectures = course.Lectures.Count;
        completedLectures = 0;
        inProgressLectures = 0;
        notStartedLectures = 0;
        totalTimeSpentHours = 0;

        foreach (var lecture in course.Lectures)
        {
            var lectureProgress = CalculateLectureProgress(lecture.Id);
            
            if (lectureProgress >= 100)
                completedLectures++;
            else if (lectureProgress > 0)
                inProgressLectures++;
            else
                notStartedLectures++;
            
            // Calculate time spent on this lecture
            totalTimeSpentHours += CalculateLectureTimeSpent(lecture.Id) / 3600.0;
        }

        overallProgress = totalLectures > 0 ? (completedLectures * 100.0) / totalLectures : 0;
    }

    private double CalculateLectureProgress(int lectureId)
    {
        if (enrollment?.ProgressTrackings == null) return 0;
        
        // Check if user has specific lecture enrollment
        var lectureEnrollment = GetLectureEnrollment(lectureId);
        if (lectureEnrollment != null)
        {
            return lectureEnrollment.ProgressPercentage;
        }
        
        // Check progress trackings for materials in this lecture
        var materialProgresses = enrollment.ProgressTrackings
            .Where(p => p.Material?.LectureId == lectureId)
            .ToList();
        
        if (!materialProgresses.Any()) return 0;
        
        int completedMaterials = materialProgresses.Count(p => p.IsCompleted);
        return (completedMaterials * 100.0) / materialProgresses.Count;
    }

    private double CalculateLectureTimeSpent(int lectureId)
    {
        if (enrollment?.ProgressTrackings == null) return 0;
        
        return enrollment.ProgressTrackings
            .Where(p => p.Material?.LectureId == lectureId)
            .Sum(p => p.TimeSpentSeconds);
    }

    private int CalculateLectureDuration(LectureDto lecture)
    {
        if (lecture.Materials == null || !lecture.Materials.Any()) 
            return lecture.EstimatedDurationMinutes;
        
        // Use the estimated duration from lecture or calculate from materials
        if (lecture.EstimatedDurationMinutes > 0)
            return lecture.EstimatedDurationMinutes;
        
        // Sum up material durations
        return (int)Math.Round(lecture.Materials.Sum(m => m.DurationSeconds) / 60.0);
    }

    private double GetMaterialProgress(int materialId)
    {
        if (enrollment?.ProgressTrackings == null) return 0;
        
        var materialProgress = enrollment.ProgressTrackings
            .FirstOrDefault(p => p.MaterialId == materialId);
        
        return materialProgress?.IsCompleted == true ? 100 : 
               materialProgress?.TimeSpentSeconds > 0 ? 50 : 0;
    }

    private EnrollmentDto? GetLectureEnrollment(int lectureId)
    {
        return allEnrollments?.FirstOrDefault(e => e.LectureId == lectureId);
    }

    private string GetImageUrl(string? url) => ImageUrlService.GetImageUrl(url);

    private string GetInitials(string firstName, string lastName)
    {
        var first = !string.IsNullOrEmpty(firstName) ? firstName[0] : 'U';
        var last = !string.IsNullOrEmpty(lastName) ? lastName[0] : 'S';
        return $"{first}{last}";
    }

    private int CalculateTotalDuration()
    {
        if (course?.Lectures == null) return 0;
        
        var totalMinutes = course.Lectures.Sum(lecture =>
        {
            if (lecture.EstimatedDurationMinutes > 0)
                return lecture.EstimatedDurationMinutes;
            
            if (lecture.Materials != null)
                return (int)Math.Round(lecture.Materials.Sum(m => m.DurationSeconds) / 60.0);
            
            return 0;
        });
        
        return totalMinutes;
    }

    private string GetProgressBarClass()
    {
        if (overallProgress >= 100) return "bg-success";
        if (overallProgress >= 50) return "bg-primary";
        if (overallProgress > 0) return "bg-warning";
        return "bg-secondary";
    }

    private string GetLectureProgressBarClass(double progress)
    {
        if (progress >= 100) return "bg-success";
        if (progress >= 50) return "bg-primary";
        if (progress > 0) return "bg-warning";
        return "bg-secondary";
    }

    private string GetLectureProgressBadgeClass(double progress)
    {
        if (progress >= 100) return "bg-success";
        if (progress > 0) return "bg-warning";
        return "bg-secondary";
    }

    private string GetProgressColor()
    {
        if (overallProgress >= 100) return "#198754"; // success green
        if (overallProgress >= 50) return "#0d6efd"; // primary blue
        if (overallProgress > 0) return "#ffc107"; // warning yellow
        return "#6c757d"; // secondary gray
    }

    private string GetLectureButtonClass(double progress)
    {
        if (progress >= 100) return "btn-success btn-sm";
        if (progress > 0) return "btn-primary btn-sm";
        return "btn-outline-primary btn-sm";
    }
    
    private string GetLectureButtonText(double progress)
    {
        if (progress >= 100) return "Review";
        if (progress > 0) return "Continue";
        return "Start";
    }
    
    private MarkupString GetLectureButtonIcon(double progress)
    {
        if (progress >= 100) 
            return new MarkupString("<i class='fas fa-redo me-1'></i>");
        if (progress > 0) 
            return new MarkupString("<i class='fas fa-play me-1'></i>");
        return new MarkupString("<i class='fas fa-play me-1'></i>");
    }

    private MarkupString GetMaterialIcon(MaterialType type)
    {
        return type switch
        {
            MaterialType.Video => new MarkupString("<i class='fas fa-video text-danger'></i>"),
            MaterialType.PDF => new MarkupString("<i class='fas fa-file-pdf text-danger'></i>"),
            MaterialType.Audio => new MarkupString("<i class='fas fa-volume-up text-primary'></i>"),
            MaterialType.Image => new MarkupString("<i class='fas fa-image text-success'></i>"),
            MaterialType.Document => new MarkupString("<i class='fas fa-file-word text-primary'></i>"),
            MaterialType.Presentation => new MarkupString("<i class='fas fa-file-powerpoint text-warning'></i>"),
            MaterialType.Text => new MarkupString("<i class='fas fa-file-alt text-info'></i>"),
            _ => new MarkupString("<i class='fas fa-file text-secondary'></i>")
        };
    }

    private string GetMaterialTypeName(MaterialType type)
    {
        return type switch
        {
            MaterialType.Video => "Video",
            MaterialType.PDF => "PDF Document",
            MaterialType.Audio => "Audio",
            MaterialType.Image => "Image",
            MaterialType.Document => "Word Document",
            MaterialType.Presentation => "Presentation",
            MaterialType.Text => "Text Document",
            _ => "File"
        };
    }

    private string GetMaterialSummary(LectureDto lecture)
    {
        if (lecture.Materials == null) return "No materials";
        
        var videoCount = lecture.Materials.Count(m => m.Type == MaterialType.Video);
        var pdfCount = lecture.Materials.Count(m => m.Type == MaterialType.PDF);
        var audioCount = lecture.Materials.Count(m => m.Type == MaterialType.Audio);
        var imageCount = lecture.Materials.Count(m => m.Type == MaterialType.Image);
        var documentCount = lecture.Materials.Count(m => m.Type == MaterialType.Document);
        var presentationCount = lecture.Materials.Count(m => m.Type == MaterialType.Presentation);
        var textCount = lecture.Materials.Count(m => m.Type == MaterialType.Text);
        var otherCount = lecture.Materials.Count(m => m.Type == MaterialType.Other);
        
        var parts = new List<string>();
        if (videoCount > 0) parts.Add($"{videoCount} video{(videoCount > 1 ? "s" : "")}");
        if (pdfCount > 0) parts.Add($"{pdfCount} PDF{(pdfCount > 1 ? "s" : "")}");
        if (audioCount > 0) parts.Add($"{audioCount} audio{(audioCount > 1 ? "s" : "")}");
        if (imageCount > 0) parts.Add($"{imageCount} image{(imageCount > 1 ? "s" : "")}");
        if (documentCount > 0) parts.Add($"{documentCount} document{(documentCount > 1 ? "s" : "")}");
        if (presentationCount > 0) parts.Add($"{presentationCount} presentation{(presentationCount > 1 ? "s" : "")}");
        if (textCount > 0) parts.Add($"{textCount} text{(textCount > 1 ? "s" : "")}");
        if (otherCount > 0) parts.Add($"{otherCount} other{(otherCount > 1 ? "s" : "")}");
        
        return string.Join(", ", parts);
    }

    private string FormatDuration(int seconds)
    {
        var timeSpan = TimeSpan.FromSeconds(seconds);
        if (timeSpan.TotalHours >= 1)
            return $"{(int)timeSpan.TotalHours}h {timeSpan.Minutes}m";
        return $"{timeSpan.Minutes}m {timeSpan.Seconds}s";
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double len = bytes;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private async void SortLectures(string sortType)
    {
        sortBy = sortType;
        
        if (course?.Lectures == null) return;
        
        sortedLectures = sortType switch
        {
            "order" => course.Lectures.OrderBy(l => l.Order).ToList(),
            "progress" => course.Lectures.OrderByDescending(l => CalculateLectureProgress(l.Id)).ToList(),
            "duration" => course.Lectures.OrderByDescending(l => CalculateLectureDuration(l)).ToList(),
            _ => course.Lectures.OrderBy(l => l.Order).ToList()
        };
        
        StateHasChanged();
    }

    private async void ToggleLectureMaterials(int lectureId)
    {
        if (expandedLectures.Contains(lectureId))
            expandedLectures.Remove(lectureId);
        else
            expandedLectures.Add(lectureId);
        
        StateHasChanged();
    }

    private async void StartLecture(int lectureId)
    {
        // Find the lecture to check access
        var lecture = course?.Lectures?.FirstOrDefault(l => l.Id == lectureId);
        
        if (lecture == null) return;
        
        // Check access - user should be enrolled (we already checked in LoadData)
        if (enrollment == null)
        {
            await ShowToast("warning", "You need to enroll to access this lecture");
            return;
        }
        
        // Navigate to lecture overview page (not directly to material)
        Navigation.NavigateTo($"/lecture/{lectureId}");
    }

    private async void OpenMaterial(int lectureId, int materialId)
    {
        // Navigate to material viewer
        Navigation.NavigateTo($"/student/mylearning/lecture/{lectureId}/material/{materialId}");
    }

    private async void ContinueLearning()
    {
        // Find the first incomplete lecture
        if (course?.Lectures == null) return;
        
        foreach (var lecture in course.Lectures.OrderBy(l => l.Order))
        {
            var progress = CalculateLectureProgress(lecture.Id);
            if (progress < 100)
            {
                StartLecture(lecture.Id);
                return;
            }
        }
        
        // If all lectures are complete, start from first
        var firstLecture = course.Lectures.OrderBy(l => l.Order).FirstOrDefault();
        if (firstLecture != null)
            StartLecture(firstLecture.Id);
    }

    private async void RestartCourse()
    {
        if (course?.Lectures == null) return;
        
        var firstLecture = course.Lectures.OrderBy(l => l.Order).FirstOrDefault();
        if (firstLecture != null)
            StartLecture(firstLecture.Id);
    }

