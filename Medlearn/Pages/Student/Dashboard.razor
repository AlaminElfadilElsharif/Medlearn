@page "/student/dashboard"


<PageTitle>Student Dashboard</PageTitle>

<div class="student-dashboard">
    <div class="container-fluid px-0 px-md-3">
        @if (isLoading)
        {
            <!-- Loading Spinner - Responsive -->
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3">Loading your dashboard...</p>
            </div>
        }
        else if (!isAuthenticated)
        {
            <!-- Not Authenticated - Responsive -->
            <div class="text-center py-5 px-3">
                <div class="alert alert-warning" role="alert">
                    <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                    <h4>Authentication Required</h4>
                    <p>You need to be logged in to access the dashboard.</p>
                    <button class="btn btn-primary mt-3 w-100 w-md-auto" @onclick='() => Navigation.NavigateTo("/account/login")'>
                        <i class="fas fa-sign-in-alt me-2"></i> Go to Login
                    </button>
                </div>
            </div>
        }
        else if (currentUser?.UserType != UserType.User)
        {
            <!-- Wrong User Type - Responsive -->
            <div class="text-center py-5 px-3">
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-ban fa-2x mb-3"></i>
                    <h4>Access Denied</h4>
                    <p>This dashboard is only accessible to students.</p>
                    <button class="btn btn-primary mt-3 w-100 w-md-auto" @onclick='() => Navigation.NavigateTo(GetDashboardRedirect())'>
                        <i class="fas fa-redo-alt me-2"></i> Go to Your Dashboard
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Welcome Section - Responsive -->
            <div class="row g-0 g-md-3 mb-3 mb-md-4">
                <div class="col-12">
                    <div class="card bg-primary text-white border-0 rounded-0 rounded-md">
                        <div class="card-body p-3 p-md-4">
                            <div class="row align-items-center">
                                <!-- Mobile Welcome -->
                                <div class="col-12 d-block d-md-none">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div>
                                            <h5 class="mb-1">Welcome back,</h5>
                                            <h4 class="mb-0">@currentUser?.FirstName!</h4>
                                        </div>
                                        <div class="btn-group">
                                            <button class="btn btn-light btn-sm" @onclick='() => Navigation.NavigateTo("/browse")'>
                                                <i class="fas fa-search"></i>
                                            </button>
                                            <button class="btn btn-outline-light btn-sm" @onclick='() => Navigation.NavigateTo("/student/mylearning")'>
                                                <i class="fas fa-graduation-cap"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <p class="small mb-0 opacity-75">Continue your learning journey or explore new specializations</p>
                                </div>

                                <!-- Desktop Welcome -->
                                <div class="col-md-8 d-none d-md-block">
                                    <h1 class="mb-2">Welcome back, @currentUser?.FirstName!</h1>
                                    <p class="mb-0">Continue your learning journey or explore new specializations</p>
                                </div>
                                <div class="col-md-4 text-end d-none d-md-block">
                                    <button class="btn btn-light me-2" @onclick='() => Navigation.NavigateTo("/browse")'>
                                        <i class="fas fa-search me-2"></i> Browse
                                    </button>
                                    <button class="btn btn-outline-light" @onclick='() => Navigation.NavigateTo("/student/mylearning")'>
                                        <i class="fas fa-graduation-cap me-2"></i> My Learning
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Overview - Responsive -->
            <div class="row g-2 g-md-3 mb-3 mb-md-4">
                <!-- Mobile Horizontal Scroll Stats -->
                <div class="col-12 d-block d-md-none">
                    <div class="stats-scroll-container overflow-auto pb-2">
                        <div class="d-flex gap-2" style="min-width: max-content;">
                            <div class="stat-card-mini bg-primary bg-opacity-10 p-3 rounded" style="width: 150px;">
                                <div class="d-flex flex-column">
                                    <small class="text-muted">Enrollments</small>
                                    <span class="h4 mb-0">@stats.TotalEnrollments</span>
                                    <small class="text-success"><i class="fas fa-chart-line"></i> All time</small>
                                </div>
                            </div>
                            <div class="stat-card-mini bg-info bg-opacity-10 p-3 rounded" style="width: 150px;">
                                <div class="d-flex flex-column">
                                    <small class="text-muted">In Progress</small>
                                    <span class="h4 mb-0">@stats.InProgressEnrollments</span>
                                    <small class="text-info"><i class="fas fa-play-circle"></i> Active</small>
                                </div>
                            </div>
                            <div class="stat-card-mini bg-success bg-opacity-10 p-3 rounded" style="width: 150px;">
                                <div class="d-flex flex-column">
                                    <small class="text-muted">Completed</small>
                                    <span class="h4 mb-0">@stats.CompletedEnrollments</span>
                                    <small class="text-success"><i class="fas fa-check-circle"></i> Great!</small>
                                </div>
                            </div>
                            <div class="stat-card-mini bg-warning bg-opacity-10 p-3 rounded" style="width: 150px;">
                                <div class="d-flex flex-column">
                                    <small class="text-muted">Avg Progress</small>
                                    <span class="h4 mb-0">@stats.AverageProgress.ToString("0")%</span>
                                    <small class="text-warning"><i class="fas fa-chart-bar"></i> Average</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Desktop Grid Stats -->
                <div class="col-md-3 d-none d-md-block">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6 class="text-muted">Total Enrollments</h6>
                                    <h3>@stats.TotalEnrollments</h3>
                                    <small class="text-success">
                                        <i class="fas fa-chart-line"></i> All time
                                    </small>
                                </div>
                                <div class="stat-icon">
                                    <i class="fas fa-graduation-cap text-primary"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 d-none d-md-block">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6 class="text-muted">In Progress</h6>
                                    <h3>@stats.InProgressEnrollments</h3>
                                    <small class="text-info">
                                        <i class="fas fa-play-circle"></i> Active now
                                    </small>
                                </div>
                                <div class="stat-icon">
                                    <i class="fas fa-book-open text-info"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 d-none d-md-block">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6 class="text-muted">Completed</h6>
                                    <h3>@stats.CompletedEnrollments</h3>
                                    <small class="text-success">
                                        <i class="fas fa-check-circle"></i> Great job!
                                    </small>
                                </div>
                                <div class="stat-icon">
                                    <i class="fas fa-check-circle text-success"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 d-none d-md-block">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6 class="text-muted">Avg Progress</h6>
                                    <h3>@stats.AverageProgress.ToString("0")%</h3>
                                    <small class="text-warning">
                                        <i class="fas fa-chart-bar"></i> Current average
                                    </small>
                                </div>
                                <div class="stat-icon">
                                    <i class="fas fa-chart-line text-warning"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Continue Learning - Responsive -->
            <div class="row g-2 g-md-3 mb-3 mb-md-4">
                <div class="col-12">
                    <div class="card border-0 border-md">
                        <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                            <h5 class="mb-0 fw-bold">Continue Learning</h5>
                            <a href="/student/mylearning/active" class="btn btn-sm btn-outline-primary">View All</a>
                        </div>
                        <div class="card-body p-2 p-md-3">
                            @if (recentEnrollments?.Any() == true)
                            {
                                <!-- Mobile Carousel View -->
                                <div class="d-block d-md-none">
                                    <div class="overflow-auto pb-2">
                                        <div class="d-flex gap-2" style="min-width: max-content;">
                                            @foreach (var enrollment in recentEnrollments)
                                            {
                                                <div class="card" style="width: 280px;">
                                                    <div class="card-body p-3">
                                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                                            <h6 class="card-title mb-0 small fw-bold">
                                                                @GetEnrollmentTitle(enrollment)
                                                            </h6>
                                                            <span class="badge bg-primary small">
                                                                @GetEnrollmentTypeBadge(enrollment.EnrollmentType)
                                                            </span>
                                                        </div>

                                                        <div class="progress mb-2" style="height: 4px;">
                                                            <div class="progress-bar" role="progressbar"
                                                                 style="width: @GetProgressBarWidth(enrollment.ProgressPercentage);"
                                                                 aria-valuenow="@enrollment.ProgressPercentage"
                                                                 aria-valuemin="0" aria-valuemax="100">
                                                            </div>
                                                        </div>

                                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                                            <small class="text-muted small">
                                                                @enrollment.ProgressPercentage.ToString("0.0")%
                                                            </small>
                                                            <small class="text-muted small">
                                                                @GetFormattedDate(enrollment.EnrollmentDate)
                                                            </small>
                                                        </div>

                                                        <button class="btn btn-outline-primary btn-sm w-100"
                                                                @onclick="() => ContinueLearning(enrollment)">
                                                            <i class="fas fa-play me-1"></i> Continue
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Desktop Grid View -->
                                <div class="d-none d-md-block">
                                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                                        @foreach (var enrollment in recentEnrollments)
                                        {
                                            <div class="col">
                                                <div class="card h-100">
                                                    <div class="card-body">
                                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                                            <h6 class="card-title mb-0">
                                                                @GetEnrollmentTitle(enrollment)
                                                            </h6>
                                                            <span class="badge bg-primary">
                                                                @GetEnrollmentTypeBadge(enrollment.EnrollmentType)
                                                            </span>
                                                        </div>

                                                        <div class="progress mb-3" style="height: 8px;">
                                                            <div class="progress-bar" role="progressbar"
                                                                 style="width: @GetProgressBarWidth(enrollment.ProgressPercentage);"
                                                                 aria-valuenow="@enrollment.ProgressPercentage"
                                                                 aria-valuemin="0" aria-valuemax="100">
                                                            </div>
                                                        </div>

                                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                                            <small class="text-muted">
                                                                @enrollment.ProgressPercentage.ToString("0.0")% Complete
                                                            </small>
                                                            <small class="text-muted">
                                                                Enrolled: @GetFormattedDate(enrollment.EnrollmentDate)
                                                            </small>
                                                        </div>

                                                        <div class="d-grid">
                                                            <button class="btn btn-outline-primary btn-sm"
                                                                    @onclick="() => ContinueLearning(enrollment)">
                                                                <i class="fas fa-play me-2"></i> Continue
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <i class="fas fa-book-open fa-3x text-muted mb-3"></i>
                                    <h5>No active courses</h5>
                                    <p class="text-muted">Start your learning journey by exploring specializations</p>
                                    <button class="btn btn-primary mt-2 w-100 w-md-auto" @onclick='() => Navigation.NavigateTo("/browse")'>
                                        <i class="fas fa-search me-2"></i> Browse Courses
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Activity & Recommendations - Responsive Stack -->
            <div class="row g-2 g-md-3">
                <!-- Recent Achievements -->
                <div class="col-md-6">
                    <div class="card h-100 border-0 border-md">
                        <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                            <h5 class="mb-0 fw-bold">Recent Achievements</h5>
                            @if (stats.PendingPayments > 0)
                            {
                                <span class="badge bg-warning">@stats.PendingPayments payment(s)</span>
                            }
                        </div>
                        <div class="card-body p-2 p-md-3">
                            @if (completedEnrollments?.Any() == true)
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var enrollment in completedEnrollments.Take(5))
                                    {
                                        <div class="list-group-item px-2 px-md-3">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h6 class="mb-1 small fw-bold">@GetEnrollmentTitle(enrollment)</h6>
                                                <small class="text-success">Completed</small>
                                            </div>
                                            <small class="text-muted d-block mb-2">
                                                <i class="fas fa-calendar me-1"></i> @GetFormattedDate(enrollment.CompletedDate)
                                            </small>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-muted">
                                                    Progress: @enrollment.ProgressPercentage.ToString("0.0")%
                                                </small>
                                                @if (enrollment.Review == null)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            @onclick="() => WriteReview(enrollment)">
                                                        <i class="fas fa-star me-1"></i> Review
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-warning small">
                                                        <i class="fas fa-star"></i> @enrollment.Review.Rating/5
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <i class="fas fa-trophy fa-3x text-muted mb-3"></i>
                                    <p class="text-muted small">Complete your first course to see achievements here</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Recommended Specializations -->
                <div class="col-md-6">
                    <div class="card h-100 border-0 border-md">
                        <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                            <h5 class="mb-0 fw-bold">Recommended For You</h5>
                            <a href="/browse" class="btn btn-sm btn-outline-primary">View All</a>
                        </div>
                        <div class="card-body p-2 p-md-3">
                            @if (recommendedSpecializations?.Any() == true)
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var spec in recommendedSpecializations.Take(4))
                                    {
                                        <div class="list-group-item px-2 px-md-3"
                                             @onclick="() => ViewSpecialization(spec.Id)" style="cursor: pointer;">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h6 class="mb-1 small fw-bold">@spec.Title</h6>
                                                <div class="text-nowrap">
                                                    <span class="badge bg-primary me-1 small">$@spec.Price.ToString("N2")</span>
                                                    @if (spec.IsFeatured)
                                                    {
                                                        <span class="badge bg-warning small">Featured</span>
                                                    }
                                                </div>
                                            </div>
                                            <p class="mb-1 text-muted small">@GetShortDescription(spec.Description, 60)</p>
                                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                                <small class="text-muted small">
                                                    <i class="fas fa-clock"></i> @spec.EstimatedDurationHours hrs
                                                </small>
                                                <small class="text-muted small">
                                                    <i class="fas fa-users"></i> @spec.TotalEnrollments
                                                </small>
                                                @if (spec.AverageRating > 0)
                                                {
                                                    <small class="text-warning small">
                                                        <i class="fas fa-star"></i> @spec.AverageRating.ToString("0.0")
                                                    </small>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <i class="fas fa-lightbulb fa-3x text-muted mb-3"></i>
                                    <p class="text-muted small">Explore our catalog to get personalized recommendations</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pending Payments Section - Responsive -->
            @if (stats.PendingPayments > 0)
            {
                <div class="row g-2 g-md-3 mt-3 mt-md-4">
                    <div class="col-12">
                        <div class="card border-warning border-2">
                            <div class="card-header bg-warning text-dark py-3">
                                <h5 class="mb-0 fw-bold">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <span class="d-none d-md-inline">Attention Needed: @stats.PendingPayments Pending Payment(s)</span>
                                    <span class="d-inline d-md-none">@stats.PendingPayments Payment(s) Pending</span>
                                </h5>
                            </div>
                            <div class="card-body p-3">
                                <p class="small mb-3">You have payment requests waiting for approval.</p>
                                <button class="btn btn-warning w-100 w-md-auto" @onclick='() => Navigation.NavigateTo("/student/payments")'>
                                    <i class="fas fa-dollar-sign me-2"></i> View Payment Requests
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    // ALL YOUR EXISTING CODE BELOW REMAINS EXACTLY THE SAME
    private UserDto? currentUser;
    private bool isAuthenticated = false;
    private bool isLoading = true;
    private List<EnrollmentDto>? allEnrollments;
    private List<EnrollmentDto>? recentEnrollments;
    private List<EnrollmentDto>? completedEnrollments;
    private List<SpecializationDto>? recommendedSpecializations;
    private DashboardStats stats = new DashboardStats();

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();

        if (isAuthenticated && currentUser?.UserType == UserType.User)
        {
            await LoadDashboardData();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            // SIMPLE AUTHENTICATION CHECK - SAME AS NOTIFICATIONS AND SIDEBAR
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                // Try to get user from localStorage (same pattern as other components)
                currentUser = await GetUserFromStorage();

                // If not in storage, get from API
                if (currentUser == null)
                {
                    currentUser = await AuthService.GetCurrentUserAsync();
                    if (currentUser != null)
                    {
                        // Store for next time
                        await JS.InvokeVoidAsync("localStorage.setItem", "currentUser",
                            System.Text.Json.JsonSerializer.Serialize(currentUser));
                    }
                }
            }
            else
            {
                currentUser = null;
                // Clear any stale data
                await JS.InvokeVoidAsync("localStorage.removeItem", "currentUser");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            currentUser = null;
        }
    }

    private async Task<UserDto?> GetUserFromStorage()
    {
        try
        {
            var userJson = await JS.InvokeAsync<string>("localStorage.getItem", "currentUser");

            if (!string.IsNullOrEmpty(userJson))
            {
                return System.Text.Json.JsonSerializer.Deserialize<UserDto>(userJson);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting user from storage: {ex.Message}");
        }

        return null;
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Load user's enrollments
            var enrollments = await EnrollmentService.GetMyEnrollmentsAsync(
                type: null,
                completed: null
            );

            if (enrollments != null)
            {
                allEnrollments = enrollments.ToList();

                // Calculate stats
                stats.TotalEnrollments = allEnrollments.Count;
                stats.InProgressEnrollments = allEnrollments.Count(e => !e.IsCompleted);
                stats.CompletedEnrollments = allEnrollments.Count(e => e.IsCompleted);

                // Convert float to decimal for average progress
                if (allEnrollments.Any())
                {
                    var totalProgress = allEnrollments.Sum(e => (decimal)e.ProgressPercentage);
                    stats.AverageProgress = Math.Round(totalProgress / allEnrollments.Count, 2);
                }
                else
                {
                    stats.AverageProgress = 0;
                }

                // Get recent enrollments (active ones)
                recentEnrollments = allEnrollments
                    .Where(e => !e.IsCompleted)
                    .OrderByDescending(e => e.ProgressPercentage)
                    .ThenByDescending(e => e.EnrollmentDate)
                    .Take(3)
                    .ToList();

                // Get completed enrollments
                completedEnrollments = allEnrollments
                    .Where(e => e.IsCompleted)
                    .OrderByDescending(e => e.CompletedDate)
                    .Take(5)
                    .ToList();
            }

            // Get recommended specializations
            var specializations = await SpecializationService.GetSpecializationsAsync(
                search: null,
                featured: null,
                doctorId: null,
                minPrice: null,
                maxPrice: null,
                page: 1,
                pageSize: 8
            );

            if (specializations != null)
            {
                recommendedSpecializations = specializations
                    .OrderByDescending(s => s.IsFeatured)
                    .ThenByDescending(s => s.TotalEnrollments)
                    .ThenByDescending(s => s.AverageRating)
                    .Take(6)
                    .ToList();
            }

            // Set pending payments
            stats.PendingPayments = 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
            stats = new DashboardStats();
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetDashboardRedirect()
    {
        if (currentUser == null) return "/";

        return currentUser.UserType switch
        {
            UserType.Admin => "/admin/dashboard",
            UserType.Doctor => "/doctor/dashboard",
            UserType.User => "/student/dashboard",
            _ => "/"
        };
    }

    private string GetEnrollmentTitle(EnrollmentDto enrollment)
    {
        if (enrollment == null) return "Unknown";

        return enrollment.EnrollmentType switch
        {
            EnrollmentType.Specialization => enrollment.Specialization?.Title ?? "Specialization",
            EnrollmentType.Course => enrollment.Course?.Title ?? "Course",
            EnrollmentType.Lecture => enrollment.Lecture?.Title ?? "Lecture",
            _ => "Unknown"
        };
    }

    private string GetEnrollmentTypeBadge(EnrollmentType type)
    {
        return type switch
        {
            EnrollmentType.Specialization => "Specialization",
            EnrollmentType.Course => "Course",
            EnrollmentType.Lecture => "Lecture",
            _ => "Unknown"
        };
    }

    private string GetProgressBarWidth(double progress)
    {
        var clampedProgress = Math.Clamp(progress, 0, 100);
        return $"{clampedProgress}%";
    }

    private string GetFormattedDate(DateTime? date)
    {
        if (date.HasValue)
        {
            return date.Value.ToString("MMM dd");
        }
        return "N/A";
    }

    private string GetShortDescription(string description, int maxLength)
    {
        if (string.IsNullOrEmpty(description))
            return "No description available";

        if (description.Length <= maxLength)
            return description;

        return description.Substring(0, maxLength) + "...";
    }

    private void ContinueLearning(EnrollmentDto enrollment)
    {
        if (enrollment == null) return;

        switch (enrollment.EnrollmentType)
        {
            case EnrollmentType.Specialization:
                if (enrollment.SpecializationId != null && enrollment.SpecializationId.Value > 0)
                    Navigation.NavigateTo($"/student/mylearning/specialization/{enrollment.SpecializationId.Value}");
                break;
            case EnrollmentType.Course:
                if (enrollment.CourseId != null && enrollment.CourseId.Value > 0)
                    Navigation.NavigateTo($"/student/mylearning/course/{enrollment.CourseId.Value}");
                break;
            case EnrollmentType.Lecture:
                if (enrollment.LectureId != null && enrollment.LectureId.Value > 0)
                    Navigation.NavigateTo($"/student/mylearning/lecture/{enrollment.LectureId.Value}");
                break;
            default:
                Navigation.NavigateTo("/student/mylearning");
                break;
        }
    }

    private void WriteReview(EnrollmentDto enrollment)
    {
        if (enrollment != null && enrollment.Id > 0)
        {
            Navigation.NavigateTo($"/student/reviews/create?enrollmentId={enrollment.Id}");
        }
    }

    private void ViewSpecialization(int specializationId)
    {
        Navigation.NavigateTo($"/specialization/{specializationId}");
    }

    // Helper class for dashboard stats
    private class DashboardStats
    {
        public int TotalEnrollments { get; set; }
        public int InProgressEnrollments { get; set; }
        public int CompletedEnrollments { get; set; }
        public decimal AverageProgress { get; set; }
        public int PendingPayments { get; set; }
    }
