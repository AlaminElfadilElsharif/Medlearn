    private void ClearFile()
    {
        fileName = "";
        invoiceFile = null;
        StateHasChanged();
    }

    private async Task LoadAvailableItems()
    {
        if (!selectedType.HasValue) return;

        isLoadingItems = true;
        StateHasChanged();

        try
        {
            var type = (EnrollmentType)selectedType.Value;

            switch (type)
            {
                case EnrollmentType.Lecture:
                    await LoadAvailableLectures();
                    break;

                case EnrollmentType.Specialization:
                    await LoadSpecializations();
                    break;

                case EnrollmentType.Course:
                    await LoadCourses();
                    break;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading items: {ex.Message}");
            await ShowToast("error", $"Error loading items: {ex.Message}");
        }
        finally
        {
            isLoadingItems = false;
            StateHasChanged();
        }
    }

    private async Task LoadAvailableLectures()
    {
        try
        {
            // Get all specializations
            var specializations = await SpecializationService.GetSpecializationsAsync(
                search: null,
                featured: null,
                doctorId: null,
                minPrice: null,
                maxPrice: null,
                page: 1,
                pageSize: 50);

            if (specializations == null || !specializations.Any())
            {
                availableItems = new List<ItemInfo>();
                return;
            }

            var allLectures = new List<ItemInfo>();

            // For each specialization, get courses, then lectures
            foreach (var spec in specializations)
            {
                try
                {
                    var courses = await CourseService.GetCoursesBySpecializationAsync(spec.Id);
                    if (courses != null && courses.Any())
                    {
                        foreach (var course in courses)
                        {
                            try
                            {
                                var lectures = await LectureService.GetLecturesByCourseAsync(course.Id);
                                if (lectures != null && lectures.Any())
                                {
                                    // Filter out free preview lectures (they're already free)
                                    var paidLectures = lectures.Where(l => l.Price > 0);

                                    allLectures.AddRange(paidLectures.Select(l => new ItemInfo
                                    {
                                        Id = l.Id,
                                        Title = $"{l.Title} (Course: {course.Title})",
                                        Price = l.Price,
                                        Description = l.Description,
                                        EstimatedDurationMinutes = l.EstimatedDurationMinutes
                                    }));
                                }
                            }
                            catch (Exception ex)
                            {
                                Console.WriteLine($"Error loading lectures for course {course.Id}: {ex.Message}");
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading courses for specialization {spec.Id}: {ex.Message}");
                }
            }

            availableItems = allLectures.DistinctBy(x => x.Id).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading lectures: {ex.Message}");
            availableItems = new List<ItemInfo>();
            throw;
        }
    }

    private async Task LoadSpecializations()
