    private async Task OnTypeChanged()
    {
        selectedItemId = null;
        selectedItem = null;
        availableItems.Clear();

        await LoadAvailableItems();
        StateHasChanged();
    }

    private void OnItemChanged()
    {
        if (selectedItemId.HasValue && selectedItemId > 0)
        {
            selectedItem = availableItems.FirstOrDefault(item => item.Id == selectedItemId);
        }
        else
        {
            selectedItem = null;
        }

        StateHasChanged();
    }

