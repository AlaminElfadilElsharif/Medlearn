            availableItems = new List<ItemInfo>();
        }
    }

    private async Task LoadCourses()
    {
        try
        {
            var allSpecializations = await SpecializationService.GetSpecializationsAsync(
                search: null,
                featured: null,
                doctorId: null,
                minPrice: null,
                maxPrice: null,
                page: 1,
                pageSize: 50);

            if (allSpecializations != null && allSpecializations.Any())
            {
                var allCourses = new List<ItemInfo>();

                foreach (var spec in allSpecializations)
                {
                    try
                    {
                        var courses = await CourseService.GetCoursesBySpecializationAsync(spec.Id);
                        if (courses != null && courses.Any())
                        {
                            allCourses.AddRange(courses.Select(c => new ItemInfo
                            {
                                Id = c.Id,
                                Title = $"{c.Title} (Specialization: {spec.Title})",
                                Price = c.Price,
                                Description = c.Description
                            }));
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error loading courses for specialization {spec.Id}: {ex.Message}");
                    }
                }

                availableItems = allCourses;
            }
            else
            {
                availableItems = new List<ItemInfo>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading courses: {ex.Message}");
            availableItems = new List<ItemInfo>();
        }
    }

    private string GetTypeName(int typeValue)
    {
        return typeValue switch
        {
            0 => "Lecture",
            1 => "Course",
            2 => "Specialization",
            _ => "Unknown"
        };
    }

    private string GetItemDescription(ItemInfo item)
    {
        if (string.IsNullOrEmpty(item.Description))
            return "No description available";

        return item.Description.Length > 150 ? item.Description.Substring(0, 150) + "..." : item.Description;
    }

    private string GetItemDuration(ItemInfo item)
    {
        if (selectedType == (int)EnrollmentType.Lecture && item.EstimatedDurationMinutes.HasValue)
        {
            return $"{item.EstimatedDurationMinutes} minutes";
        }

        if (selectedType == (int)EnrollmentType.Specialization && item.EstimatedDurationHours.HasValue)
        {
            return $"{item.EstimatedDurationHours} hours";
        }

        return "Self-paced";
    }

    private List<string> GetItemFeatures(ItemInfo item)
    {
        var features = new List<string>
        {
            "Lifetime access",
            "Certificate of completion",
            "Downloadable resources"
        };

        if (selectedType == (int)EnrollmentType.Specialization)
        {
            features.Add("Multiple courses included");
            features.Add("Progress tracking");
            features.Add("Specialization certificate");
        }
        else if (selectedType == (int)EnrollmentType.Course)
        {
            features.Add("Multiple lectures");
            features.Add("Quizzes and assignments");
            features.Add("Course completion certificate");
        }
        else if (selectedType == (int)EnrollmentType.Lecture)
        {
            features.Add("Individual lecture access");
            features.Add("Lecture completion badge");
            features.Add("All lecture materials");
        }

        return features;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            fileName = file.Name;
            invoiceFile = file;

            // Validate file size (max 5MB)
            const long maxFileSize = 5 * 1024 * 1024; // 5MB
            if (file.Size > maxFileSize)
            {
                await ShowToast("error", "File size must be less than 5MB");
                fileName = "";
                invoiceFile = null;
                return;
            }

            // Validate file type
            var validExtensions = new[] { ".pdf", ".jpg", ".jpeg", ".png" };
            var fileExtension = System.IO.Path.GetExtension(file.Name).ToLower();

            if (!validExtensions.Contains(fileExtension))
            {
                await ShowToast("error", "Please upload PDF, JPG, JPEG, or PNG files only");
                fileName = "";
                invoiceFile = null;
                return;
            }

            await ShowToast("success", "File uploaded successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading file: {ex.Message}");
            await ShowToast("error", $"Error uploading file: {ex.Message}");
            fileName = "";
            invoiceFile = null;
        }

        StateHasChanged();
    }

    private async Task SubmitPayment()
    {
        if (!CanSubmit || selectedItem == null || !selectedType.HasValue || !selectedItemId.HasValue || invoiceFile == null)
        {
            await ShowToast("error", "Please fill all required fields and upload a receipt");
            return;
        }

        // Double-check authentication before submitting
        if (!isAuthenticated)
        {
            await ShowToast("error", "Your session has expired. Please login again.");
            Navigation.NavigateTo("/account/login");
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        try
        {
            if (currentUser == null)
            {
                currentUser = await AuthService.GetCurrentUserAsync();

                if (currentUser == null)
                {
                    await ShowToast("error", "You must be logged in to make a payment");
                    Navigation.NavigateTo("/account/login", true);
                    return;
                }
            }

            // Create payment request DTO
            var createDto = new CreatePaymentRequestDto
            {
                EnrollmentType = (EnrollmentType)selectedType.Value
            };

            // Set appropriate ID based on type
            switch ((EnrollmentType)selectedType.Value)
            {
                case EnrollmentType.Lecture:
                    createDto.LectureId = selectedItemId;
                    break;
                case EnrollmentType.Course:
                    createDto.CourseId = selectedItemId;
                    break;
                case EnrollmentType.Specialization:
                    createDto.SpecializationId = selectedItemId;
                    break;
                default:
                    await ShowToast("error", "Invalid enrollment type selected");
                    return;
            }

            // Create payment request
            using var stream = invoiceFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);

            var paymentRequest = await PaymentService.CreatePaymentRequestAsync(
                createDto,
                stream,
                invoiceFile.Name
            );

            if (paymentRequest != null)
            {
                await ShowToast("success",
                    $"Payment request submitted successfully! Invoice: {paymentRequest.InvoiceNumber}");

                // Navigate to payment history
                Navigation.NavigateTo("/student/payments");
            }
            else
            {
                await ShowToast("error", "Failed to submit payment request");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error submitting payment: {ex.Message}");
            await ShowToast("error", $"Error submitting payment: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

