@page "/student/payments"
@page "/student/payments/history"


<PageTitle>Payment History</PageTitle>

<div class="payment-history">
    <div class="container-fluid px-0 px-md-3">
        <!-- Authentication Check -->
        @if (!isAuthenticated)
        {
            <div class="text-center py-5">
                <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                <h5>Authentication Required</h5>
                <p class="text-muted">Please log in to view your payment history</p>
                <button class="btn btn-primary mt-2" @onclick="NavigateToLogin">
                    <i class="fas fa-sign-in-alt me-2"></i> Login
                </button>
            </div>
        }
        else if (isLoadingAuth)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Checking authentication...</p>
            </div>
        }
        else
        {
            <!-- Mobile Header -->
            <div class="d-block d-md-none mb-3">
                <div class="bg-primary text-white p-3">
                    <div class="d-flex align-items-center">
                        <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                            <i class="fas fa-arrow-left fa-lg"></i>
                        </button>
                        <h5 class="mb-0 flex-grow-1">Payment History</h5>
                        <button class="btn btn-link text-white p-0" @onclick="NavigateToMakePayment">
                            <i class="fas fa-plus fa-lg"></i>
                        </button>
                    </div>
                </div>
                <p class="text-muted small mt-2 px-3">Track all your payments and invoices</p>
            </div>

            <!-- Desktop Header -->
            <div class="d-none d-md-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1>Payment History</h1>
                    <p class="text-muted mb-0">Track all your payments and invoices</p>
                </div>
                <div>
                    <button class="btn btn-primary" @onclick="NavigateToMakePayment">
                        <i class="fas fa-plus me-2"></i> Make Payment
                    </button>
                </div>
            </div>

            <!-- Stats Cards - Responsive -->
            <div class="row g-2 g-md-3 mb-4">
                <!-- Total Spent -->
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Total Spent</h6>
                                    <h5 class="mb-0 fw-bold">$@totalSpent.ToString("N2")</h5>
                                </div>
                                <div class="stat-icon bg-primary bg-opacity-10 p-2 p-md-3 rounded-circle">
                                    <i class="fas fa-dollar-sign text-primary"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Approved -->
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Approved</h6>
                                    <h5 class="mb-0 fw-bold">@approvedPayments</h5>
                                </div>
                                <div class="stat-icon bg-success bg-opacity-10 p-2 p-md-3 rounded-circle">
                                    <i class="fas fa-check-circle text-success"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pending -->
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Pending</h6>
                                    <h5 class="mb-0 fw-bold">@pendingPayments</h5>
                                </div>
                                <div class="stat-icon bg-warning bg-opacity-10 p-2 p-md-3 rounded-circle">
                                    <i class="fas fa-clock text-warning"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Rejected -->
                <div class="col-6 col-md-3">
                    <div class="card stat-card h-100">
                        <div class="card-body p-2 p-md-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small mb-1">Rejected</h6>
                                    <h5 class="mb-0 fw-bold">@rejectedPayments</h5>
                                </div>
                                <div class="stat-icon bg-danger bg-opacity-10 p-2 p-md-3 rounded-circle">
                                    <i class="fas fa-times-circle text-danger"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filters - Responsive -->
            <div class="card mb-3 mb-md-4">
                <div class="card-body p-3">
                    <!-- Mobile Filter Toggle -->
                    <div class="d-block d-md-none mb-2">
                        <button class="btn btn-outline-primary w-100" @onclick="ToggleMobileFilters">
                            <i class="fas fa-filter me-2"></i> Filter Payments
                            @if (HasActiveFilters())
                            {
                                <span class="badge bg-primary ms-2">Active</span>
                            }
                        </button>
                    </div>

                    <!-- Desktop Filters -->
                    <div class="d-none d-md-block">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    <input type="text" class="form-control" placeholder="Search by invoice..."
                                           @bind="searchTerm" @bind:event="oninput" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="SearchPayments">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" @bind="statusFilter" @bind:event="onchange">
                                    <option value="">All Status</option>
                                    <option value="0">Pending</option>
                                    <option value="1">Approved</option>
                                    <option value="2">Rejected</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" @bind="typeFilter" @bind:event="onchange">
                                    <option value="">All Types</option>
                                    <option value="0">Lecture</option>
                                    <option value="1">Course</option>
                                    <option value="2">Specialization</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">
                                    <i class="fas fa-times me-2"></i> Clear
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Mobile Filters (Collapsible) -->
                    @if (showMobileFilters)
                    {
                        <div class="d-block d-md-none mt-3">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Search</label>
                                <div class="input-group">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="Search by invoice..."
                                           @bind="searchTerm" @bind:event="oninput" />
                                    <button class="btn btn-primary btn-sm" @onclick="SearchPayments">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Status</label>
                                <select class="form-select form-select-sm" @bind="statusFilter" @bind:event="onchange">
                                    <option value="">All Status</option>
                                    <option value="0">Pending</option>
                                    <option value="1">Approved</option>
                                    <option value="2">Rejected</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Type</label>
                                <select class="form-select form-select-sm" @bind="typeFilter" @bind:event="onchange">
                                    <option value="">All Types</option>
                                    <option value="0">Lecture</option>
                                    <option value="1">Course</option>
                                    <option value="2">Specialization</option>
                                </select>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-secondary flex-fill" @onclick="ClearFilters">
                                    <i class="fas fa-times me-2"></i> Clear
                                </button>
                                <button class="btn btn-primary flex-fill" @onclick="ApplyMobileFilters">
                                    <i class="fas fa-check me-2"></i> Apply
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading payment history...</p>
                </div>
            }
            else if (!filteredPayments.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                    <h5>No payments found</h5>
                    <p class="text-muted">Make your first payment to see it here</p>
                    <button class="btn btn-primary mt-2" @onclick="NavigateToMakePayment">
                        <i class="fas fa-shopping-cart me-2"></i> Make Payment
                    </button>
                </div>
            }
            else
            {
                <!-- Mobile Payment Cards -->
                <div class="d-block d-md-none">
                    <div class="payment-cards">
                        @foreach (var payment in pagedPayments)
                        {
                            <div class="card mb-3">
                                <div class="card-body">
                                    <!-- Header with Invoice and Status -->
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <span class="fw-bold">@payment.InvoiceNumber</span>
                                            <span class="badge @GetPaymentStatusBadge(payment.Status) ms-2">
                                                @payment.Status
                                            </span>
                                        </div>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-info btn-sm"
                                                    @onclick="() => ViewInvoice(payment.InvoicePdfUrl)">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="btn btn-outline-primary btn-sm"
                                                    @onclick="() => DownloadInvoice(payment.InvoicePdfUrl, payment.InvoiceNumber)">
                                                <i class="fas fa-download"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Item Details -->
                                    <div class="mb-2">
                                        <div class="fw-bold">@GetPaymentItemTitle(payment)</div>
                                        <div class="d-flex align-items-center mt-1">
                                            <span class="badge @GetPaymentTypeBadge(payment.EnrollmentType) me-2">
                                                @payment.EnrollmentType
                                            </span>
                                            <small class="text-muted">
                                                @payment.CreatedAt.ToString("MMM dd, yyyy")
                                            </small>
                                        </div>
                                    </div>

                                    <!-- Amount -->
                                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                        <span class="text-muted">Amount:</span>
                                        <span class="fw-bold text-primary">$@payment.Amount.ToString("N2")</span>
                                    </div>

                                    <!-- Rejection Reason (if any) -->
                                    @if (!string.IsNullOrEmpty(payment.RejectionReason))
                                    {
                                        <div class="alert alert-danger small mt-2 p-2 mb-0">
                                            <i class="fas fa-exclamation-circle me-1"></i>
                                            @payment.RejectionReason
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Desktop Payments Table -->
                <div class="d-none d-md-block card">
                    <div class="card-header">
                        <h5 class="mb-0">Payment History</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Invoice</th>
                                        <th>Item</th>
                                        <th>Type</th>
                                        <th>Amount</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in pagedPayments)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold">@payment.InvoiceNumber</div>
                                            </td>
                                            <td>
                                                <div>@GetPaymentItemTitle(payment)</div>
                                                <small class="text-muted">@GetPaymentItemType(payment)</small>
                                            </td>
                                            <td>
                                                <span class="badge @GetPaymentTypeBadge(payment.EnrollmentType)">
                                                    @payment.EnrollmentType
                                                </span>
                                            </td>
                                            <td>
                                                <div class="fw-bold">$@payment.Amount.ToString("N2")</div>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @payment.CreatedAt.ToString("MMM dd, yyyy")
                                                </small>
                                            </td>
                                            <td>
                                                <span class="badge @GetPaymentStatusBadge(payment.Status)">
                                                    @payment.Status
                                                </span>
                                                @if (!string.IsNullOrEmpty(payment.RejectionReason))
                                                {
                                                    <div class="small text-danger">
                                                        @payment.RejectionReason
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-info"
                                                            @onclick="() => ViewInvoice(payment.InvoicePdfUrl)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button class="btn btn-outline-primary"
                                                            @onclick="() => DownloadInvoice(payment.InvoicePdfUrl, payment.InvoiceNumber)">
                                                        <i class="fas fa-download"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Mobile Summary Stats -->
                <div class="d-block d-md-none mt-3">
                    <div class="card">
                        <div class="card-body p-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">Showing @pagedPayments.Count of @totalItems payments</small>
                                <small class="text-muted">Total: <span class="fw-bold">$@totalSpent.ToString("N2")</span></small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pagination - Responsive -->
                @if (totalPages > 1)
                {
                    <nav class="mt-3 mt-md-4">
                        <!-- Mobile Pagination -->
                        <div class="d-block d-md-none">
                            <div class="d-flex justify-content-between align-items-center">
                                <button class="btn btn-outline-primary btn-sm @(currentPage == 1 ? "disabled" : "")"
                                        @onclick="() => ChangePage(currentPage - 1)">
                                    <i class="fas fa-chevron-left"></i> Previous
                                </button>
                                <span class="small">
                                    Page @currentPage of @totalPages
                                </span>
                                <button class="btn btn-outline-primary btn-sm @(currentPage == totalPages ? "disabled" : "")"
                                        @onclick="() => ChangePage(currentPage + 1)">
                                    Next <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Desktop Pagination -->
                        <ul class="pagination justify-content-center d-none d-md-flex">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">
                                    Previous
                                </button>
                            </li>

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
                                    </li>
                                }
                                else if (i == currentPage - 3 || i == currentPage + 3)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">
                                    Next
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            }
        }
    </div>
</div>

@code {
    private List<PaymentRequestDto> payments = new();
    private List<PaymentRequestDto> filteredPayments = new();
    private List<PaymentRequestDto> pagedPayments = new();
    private string searchTerm = "";
    private string statusFilter = "";
    private string typeFilter = "";
    private decimal totalSpent = 0;
    private int approvedPayments = 0;
    private int pendingPayments = 0;
    private int rejectedPayments = 0;
    private bool isLoading = true;
    private bool isLoadingAuth = true;
    private bool isAuthenticated = false;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalItems = 0;
    private int totalPages = 0;
    private bool showMobileFilters = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();

        if (isAuthenticated)
        {
            await LoadPaymentHistory();
        }
        else
        {
            isLoading = false;
            isLoadingAuth = false;
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            // SIMPLE AUTHENTICATION CHECK - SAME AS NOTIFICATIONS AND SIDEBAR
            isAuthenticated = await TokenService.IsAuthenticatedAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
        }
        finally
        {
            isLoadingAuth = false;
        }
    }

    private async Task LoadPaymentHistory()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Use your IPaymentService to get payment requests
            var paymentRequests = await PaymentService.GetMyPaymentRequestsAsync();

            if (paymentRequests != null)
            {
                payments = paymentRequests;
                ApplyFilters();
                CalculateStats();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading payment history: {ex.Message}");
            await ShowAlert($"Error loading payment history: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CalculateStats()
    {
        totalSpent = payments
            .Where(p => p.Status == PaymentStatus.Approved)
            .Sum(p => p.Amount);

        approvedPayments = payments.Count(p => p.Status == PaymentStatus.Approved);
        pendingPayments = payments.Count(p => p.Status == PaymentStatus.Pending);
        rejectedPayments = payments.Count(p => p.Status == PaymentStatus.Rejected);
    }

    private void ApplyFilters()
    {
        var query = payments.AsEnumerable();

        // Apply search filter
        if (!string.IsNullOrEmpty(searchTerm))
        {
            var search = searchTerm.ToLower();
            query = query.Where(p =>
                (!string.IsNullOrEmpty(p.InvoiceNumber) && p.InvoiceNumber.ToLower().Contains(search)) ||
                GetPaymentItemTitle(p).ToLower().Contains(search));
        }

        // Apply status filter
        if (!string.IsNullOrEmpty(statusFilter) && int.TryParse(statusFilter, out int statusValue))
        {
            var status = (PaymentStatus)statusValue;
            query = query.Where(p => p.Status == status);
        }

        // Apply type filter
        if (!string.IsNullOrEmpty(typeFilter) && int.TryParse(typeFilter, out int typeValue))
        {
            var type = (EnrollmentType)typeValue;
            query = query.Where(p => p.EnrollmentType == type);
        }

        filteredPayments = query.OrderByDescending(p => p.CreatedAt).ToList();
        totalItems = filteredPayments.Count;
        totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);
        currentPage = Math.Max(1, Math.Min(currentPage, totalPages));

        // Apply pagination
        pagedPayments = filteredPayments
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private async Task SearchPayments()
    {
        currentPage = 1;
        ApplyFilters();
        showMobileFilters = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyMobileFilters()
    {
        SearchPayments();
    }

    private void ClearFilters()
    {
        searchTerm = "";
        statusFilter = "";
        typeFilter = "";
        currentPage = 1;
        ApplyFilters();
        showMobileFilters = false;
        StateHasChanged();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrEmpty(searchTerm) ||
               !string.IsNullOrEmpty(statusFilter) ||
               !string.IsNullOrEmpty(typeFilter);
    }

    private void ToggleMobileFilters()
    {
        showMobileFilters = !showMobileFilters;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages && page != currentPage)
        {
            currentPage = page;
            ApplyFilters();
            StateHasChanged();
        }
    }

    private string GetPaymentItemTitle(PaymentRequestDto payment)
    {
        if (payment == null) return "Unknown";

        return payment.EnrollmentType switch
        {
            EnrollmentType.Specialization => payment.Specialization?.Title ?? "Specialization",
            EnrollmentType.Course => payment.Course?.Title ?? "Course",
            EnrollmentType.Lecture => payment.Lecture?.Title ?? "Lecture",
            _ => "Unknown"
        };
    }

    private string GetPaymentItemType(PaymentRequestDto payment)
    {
        if (payment == null) return "Unknown";

        return payment.EnrollmentType.ToString();
    }

    private string GetPaymentTypeBadge(EnrollmentType type)
    {
        return type switch
        {
            EnrollmentType.Specialization => "bg-info",
            EnrollmentType.Course => "bg-primary",
            EnrollmentType.Lecture => "bg-secondary",
            _ => "bg-dark"
        };
    }

    private string GetPaymentStatusBadge(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Approved => "bg-success",
            PaymentStatus.Pending => "bg-warning",
            PaymentStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private async Task ViewInvoice(string? invoiceUrl)
    {
        if (!string.IsNullOrEmpty(invoiceUrl))
        {
            try
            {
                // Use ImageUrlService to get the correct URL
                string fullUrl = ImageUrlService.GetImageUrl(invoiceUrl);

                // Open the invoice in a new tab
                await JS.InvokeVoidAsync("open", fullUrl, "_blank");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error opening invoice: {ex.Message}");
                await ShowAlert("Error opening invoice. Please try again.");
            }
        }
        else
        {
            await ShowAlert("No invoice PDF available");
        }
    }

    private async Task DownloadInvoice(string? invoiceUrl, string invoiceNumber)
    {
        if (!string.IsNullOrEmpty(invoiceUrl))
        {
            try
            {
                // Use ImageUrlService to get the correct URL
                string fullUrl = ImageUrlService.GetImageUrl(invoiceUrl);

                // Create a download link
                var fileName = $"invoice-{invoiceNumber}.pdf";

                // Method 1: Use anchor tag
                await JS.InvokeVoidAsync("eval", $@"
                    var link = document.createElement('a');
                    link.href = '{fullUrl}';
                    link.download = '{fileName}';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                ");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error downloading invoice: {ex.Message}");

                // Fallback: Try to open in new tab
                try
                {
                    string fullUrl = ImageUrlService.GetImageUrl(invoiceUrl);
                    await JS.InvokeVoidAsync("open", fullUrl, "_blank");
                }
                catch (Exception innerEx)
                {
                    Console.WriteLine($"Error in fallback: {innerEx.Message}");
                    await ShowAlert("Error downloading invoice. Please try again.");
                }
            }
        }
        else
        {
            await ShowAlert("No invoice PDF available");
        }
    }

    private void NavigateToMakePayment()
    {
        Navigation.NavigateTo("/student/payments/make");
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/account/login");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/student/dashboard");
    }

    private async Task ShowAlert(string message)
    {
        await JS.InvokeVoidAsync("alert", message);
    }
}
