    private async Task DeleteReview(ReviewDto review)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Are you sure you want to delete this review? This action cannot be undone.");

        if (!confirmed) return;

        try
        {
            var success = await ReviewService.DeleteReviewAsync(review.Id);

            if (success)
            {
                await ShowToast("success", "Review deleted successfully");

                reviews.Remove(review);
                CalculateStats();
                ApplyFilters();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await ShowToast("error", "Failed to delete review");
            }
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Error deleting review: {ex.Message}");
        }
    }

