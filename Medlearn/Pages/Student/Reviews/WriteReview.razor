@code {
    // ... (keep all your existing code in the @code block exactly as is)
    [Parameter] public int EnrollmentId { get; set; }

    private EnrollmentDto? enrollment;
    private List<ReviewDto> existingReviews = new();
    private CreateReviewDto reviewForm = new CreateReviewDto { Rating = 0 };
    private UpdateReviewDto updateForm = new UpdateReviewDto { Rating = 0 };
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isDeleting = false;
    private bool showDeleteConfirm = false;
    private bool isEditMode = false;
    private bool ratingError = false;
    private bool commentError = false;
    private string? errorMessage;

    // Computed property for current rating
    private int currentRating => isEditMode ? updateForm.Rating : reviewForm.Rating;

    // Separate property for textarea binding to handle both create and edit modes
    private string commentValue
    {
        get => isEditMode ? (updateForm.Comment ?? "") : (reviewForm.Comment ?? "");
        set
        {
            if (isEditMode)
                updateForm.Comment = value;
            else
                reviewForm.Comment = value;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Check authentication
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo($"/login?returnUrl=/student/reviews/write/{EnrollmentId}");
                return;
            }

            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing review page");
            errorMessage = "An error occurred while loading the page.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadData()
    {
        // Check if we're in edit mode
        var uri = Navigation.Uri;
        isEditMode = uri.Contains("/edit");

        // Load enrollment
        var enrollments = await EnrollmentService.GetMyEnrollmentsAsync();
        enrollment = enrollments?.FirstOrDefault(e => e.Id == EnrollmentId);

        if (enrollment == null || !enrollment.IsCompleted)
        {
            return;
        }

        // Load existing review if any
        if (enrollment.Review != null)
        {
            // Initialize forms with existing review data
            reviewForm.Rating = enrollment.Review.Rating;
            reviewForm.Comment = enrollment.Review.Comment;
            updateForm.Rating = enrollment.Review.Rating;
            updateForm.Comment = enrollment.Review.Comment;
        }
        else
        {
            // Initialize with default values for new review
            reviewForm.Rating = 0;
            reviewForm.Comment = "";
            updateForm.Rating = 0;
            updateForm.Comment = "";
        }

        // Load existing reviews for this content
        await LoadExistingReviews();
    }

    private async Task LoadExistingReviews()
    {
        try
        {
            object? reviewsData = null;

            if (enrollment?.LectureId.HasValue == true)
            {
                reviewsData = await ReviewService.GetLectureReviewsAsync(enrollment.LectureId.Value, 1, 5);
            }
            else if (enrollment?.CourseId.HasValue == true)
            {
                reviewsData = await ReviewService.GetCourseReviewsAsync(enrollment.CourseId.Value, 1, 5);
            }
            else if (enrollment?.SpecializationId.HasValue == true)
            {
                reviewsData = await ReviewService.GetSpecializationReviewsAsync(enrollment.SpecializationId.Value, 1, 5);
            }

            if (reviewsData != null)
            {
                // Parse the response (assuming it returns an object with Reviews property)
                var type = reviewsData.GetType();
                var reviewsProperty = type.GetProperty("Reviews");
                if (reviewsProperty != null)
                {
                    var reviews = reviewsProperty.GetValue(reviewsData);
                    if (reviews is List<ReviewDto> reviewsList)
                    {
                        // Filter out current user's review if exists
                        var currentUser = await AuthService.GetCurrentUserAsync();
                        existingReviews = reviewsList
                            .Where(r => enrollment.Review == null || r.Id != enrollment.Review.Id) // Don't show user's own review
                            .Take(2)
                            .ToList();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading existing reviews");
        }
    }

    private string GetRatingLabel(int rating)
    {
        return rating switch
        {
            5 => "Excellent - Outstanding content",
            4 => "Very Good - Great content with minor issues",
            3 => "Good - Decent but could be better",
            2 => "Fair - Needs significant improvement",
            1 => "Poor - Not recommended",
            _ => ""
        };
    }

    private void SelectRating(int rating)
    {
        if (isEditMode)
        {
            updateForm.Rating = rating;
        }
        else
        {
            reviewForm.Rating = rating;
        }
        ratingError = false;
    }

    private async Task HandleSubmit()
    {
        if (!ValidateForm())
        {
            StateHasChanged();
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            if (isEditMode && enrollment?.Review != null)
            {
                // Update existing review
                var success = await ReviewService.UpdateReviewAsync(enrollment.Review.Id, updateForm);
                if (success)
                {
                    // Show success message and redirect
                    Navigation.NavigateTo($"/my-courses?reviewUpdated=true");
                }
                else
                {
                    errorMessage = "Failed to update review. Please try again.";
                }
            }
            else
            {
                // Create new review
                var createDto = new CreateReviewDto
                {
                    EnrollmentId = EnrollmentId,
                    Rating = reviewForm.Rating,
                    Comment = reviewForm.Comment
                };

                var result = await ReviewService.CreateReviewAsync(createDto);
                if (result != null)
                {
                    // Show success message and redirect
                    Navigation.NavigateTo($"/my-courses?reviewSubmitted=true");
                }
                else
                {
                    errorMessage = "Failed to submit review. Please try again.";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error submitting review");
            errorMessage = "An error occurred while submitting your review.";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private bool ValidateForm()
    {
        int currentRating = isEditMode ? updateForm.Rating : reviewForm.Rating;
        string currentComment = isEditMode ? (updateForm.Comment ?? "") : (reviewForm.Comment ?? "");

        ratingError = currentRating < 1 || currentRating > 5;
        commentError = string.IsNullOrWhiteSpace(currentComment) || currentComment.Length < 10;

        return !ratingError && !commentError;
    }

    private void EnableEditMode()
    {
        isEditMode = true;
        Navigation.NavigateTo($"/review/{EnrollmentId}/edit");
    }

    private void Cancel()
    {
        if (isEditMode)
        {
            Navigation.NavigateTo($"/student/reviews/write/{EnrollmentId}");
        }
        else
        {
            Navigation.NavigateTo("/my-courses");
        }
    }

    private void ConfirmDeleteReview()
    {
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
    }

    private async Task DeleteReview()
    {
        if (enrollment?.Review == null) return;

        isDeleting = true;

        try
        {
            var success = await ReviewService.DeleteReviewAsync(enrollment.Review.Id);
            if (success)
            {
                showDeleteConfirm = false;
                Navigation.NavigateTo($"/student/reviews/write/{EnrollmentId}?deleted=true");
            }
            else
            {
                errorMessage = "Failed to delete review. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting review");
            errorMessage = "An error occurred while deleting your review.";
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private void ViewAllReviews()
    {
        if (enrollment?.LectureId.HasValue == true)
        {
            Navigation.NavigateTo($"/lecture/{enrollment.LectureId.Value}/reviews");
        }
        else if (enrollment?.CourseId.HasValue == true)
        {
            Navigation.NavigateTo($"/course/{enrollment.CourseId.Value}/reviews");
        }
        else if (enrollment?.SpecializationId.HasValue == true)
        {
            Navigation.NavigateTo($"/specialization/{enrollment.SpecializationId.Value}/reviews");
        }
    }
}
