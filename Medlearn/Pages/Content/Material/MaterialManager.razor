

<div class="material-manager">
    <!-- Header - Responsive -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <!-- Mobile Header -->
        <div class="d-flex d-md-none align-items-center w-100">
            <h6 class="mb-0 flex-grow-1">
                <i class="fas fa-file-alt me-2"></i> Materials
                @if (Materials != null)
                {
                    <span class="badge bg-secondary ms-2">@Materials.Count</span>
                }
            </h6>
            @if (!showForm)
            {
                <button class="btn btn-sm btn-primary" @onclick="ShowAddForm">
                    <i class="fas fa-plus"></i>
                </button>
            }
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-flex align-items-center w-100">
            <h5 class="mb-0 flex-grow-1">
                <i class="fas fa-file-alt me-2"></i> Learning Materials
                @if (Materials != null)
                {
                    <span class="badge bg-secondary ms-2">@Materials.Count</span>
                }
            </h5>
            @if (!showForm)
            {
                <button class="btn btn-sm btn-primary" @onclick="ShowAddForm">
                    <i class="fas fa-plus me-1"></i> Add Material
                </button>
            }
        </div>
    </div>

    <!-- Empty State - Mobile Optimized -->
    @if ((Materials == null || !Materials.Any()) && !showForm)
    {
        <!-- Mobile Empty State -->
        <div class="d-block d-md-none text-center py-4 border rounded bg-light">
            <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
            <h6 class="text-muted">No Materials Yet</h6>
            <p class="text-muted small mb-3 px-3">Add learning materials to enhance this lecture</p>
            <button class="btn btn-primary btn-sm" @onclick="ShowAddForm">
                <i class="fas fa-plus me-1"></i> Add Material
            </button>
        </div>

        <!-- Desktop Empty State -->
        <div class="d-none d-md-block text-center py-5 border rounded bg-light">
            <i class="fas fa-file-alt fa-4x text-muted mb-3"></i>
            <h5 class="text-muted">No Learning Materials</h5>
            <p class="text-muted mb-3">Add materials to enhance this lecture</p>
            <button class="btn btn-primary" @onclick="ShowAddForm">
                <i class="fas fa-plus me-2"></i> Add First Material
            </button>
        </div>
    }

    <!-- Materials List - Responsive -->
    @if (Materials != null && Materials.Any() && !showForm)
    {
        <!-- Mobile Card View -->
        <div class="d-block d-md-none">
            @foreach (var material in Materials.OrderBy(m => m.Order))
            {
                <div class="card mb-2 border-0 shadow-sm">
                    <div class="card-body p-3">
                        <!-- Material Header -->
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center">
                                <span class="badge bg-secondary me-2">#@material.Order</span>
                                @GetMaterialTypeIcon(material.Type)
                            </div>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary"
                                        @onclick="() => ShowEditForm(material)"
                                        title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-outline-danger"
                                        @onclick="() => DeleteMaterial(material)"
                                        title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Material Content -->
                        <div class="mb-2">
                            <h6 class="fw-bold mb-1">@material.Title</h6>
                            @if (!string.IsNullOrEmpty(material.Description))
                            {
                                <p class="small text-muted mb-2">@material.Description</p>
                            }
                        </div>

                        <!-- Material Meta - FIXED: Using correct properties -->
                        <div class="d-flex flex-wrap gap-2 small">
                            @if (material.DurationSeconds > 0)
                            {
                                <span class="badge bg-light text-dark">
                                    <i class="fas fa-clock me-1"></i>
                                    @FormatDuration(material.DurationSeconds)
                                </span>
                            }

                            @if (material.FileSize > 0)
                            {
                                <span class="badge bg-light text-dark">
                                    <i class="fas fa-database me-1"></i>
                                    @FormatFileSize(material.FileSize)
                                </span>
                            }

                            @if (material.IsDownloadable)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-download me-1"></i> Downloadable
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="fas fa-eye me-1"></i> View Only
                                </span>
                            }
                        </div>

                        <!-- File Info - FIXED: Using ContentUrl -->
                        @if (!string.IsNullOrEmpty(material.ContentUrl))
                        {
                            <div class="mt-2 pt-2 border-top">
                                <a href="@material.ContentUrl" target="_blank" class="btn btn-sm btn-outline-secondary w-100">
                                    <i class="fas fa-external-link-alt me-2"></i> View Material
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Desktop Table View - FIXED: Using correct properties -->
        <div class="d-none d-md-block table-responsive mb-4">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Order</th>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Duration</th>
                        <th>Size</th>
                        <th>Downloadable</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var material in Materials.OrderBy(m => m.Order))
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@material.Order</span></td>
                            <td>
                                <div>
                                    <strong>@material.Title</strong>
                                    @if (!string.IsNullOrEmpty(material.Description))
                                    {
                                        <div class="small text-muted">@material.Description</div>
                                    }
                                </div>
                            </td>
                            <td>@GetMaterialTypeBadge(material.Type)</td>
                            <td>
                                @if (material.DurationSeconds > 0)
                                {
                                    <span>@FormatDuration(material.DurationSeconds)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (material.FileSize > 0)
                                {
                                    <span>@FormatFileSize(material.FileSize)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (material.IsDownloadable)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary"
                                            @onclick="() => ShowEditForm(material)"
                                            title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-outline-danger"
                                            @onclick="() => DeleteMaterial(material)"
                                            title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Material Form - Responsive -->
    @if (showForm)
    {
        <div class="card mt-4 border-0 border-md">
            <div class="card-header d-flex justify-content-between align-items-center bg-light py-2 py-md-3">
                <!-- Mobile Form Header -->
                <div class="d-flex d-md-none align-items-center w-100">
                    <h6 class="mb-0 flex-grow-1">
                        <i class="fas fa-file-alt me-2"></i>
                        @(editingMaterial == null ? "New Material" : "Edit Material")
                    </h6>
                    <button type="button" class="btn-close" @onclick="HideForm"></button>
                </div>

                <!-- Desktop Form Header -->
                <div class="d-none d-md-flex align-items-center w-100">
                    <h5 class="mb-0 flex-grow-1">
                        <i class="fas fa-file-alt me-2"></i>
                        @(editingMaterial == null ? "Add New Material" : "Edit Material")
                    </h5>
                    <button type="button" class="btn-close" @onclick="HideForm"></button>
                </div>
            </div>

            <div class="card-body p-3 p-md-4">
                <!-- Title -->
                <div class="mb-3">
                    <label class="form-label fw-bold small d-md-none">Title *</label>
                    <label class="form-label fw-bold d-none d-md-block">Title *</label>
                    <input type="text"
                           class="form-control @(errors.ContainsKey("Title") ? "is-invalid" : "")"
                           value="@formData.Title"
                           placeholder="Enter material title"
                           @oninput="@(async (ChangeEventArgs e) => await UpdateTitle(e.Value?.ToString() ?? ""))" />
                    @if (errors.ContainsKey("Title"))
                    {
                        <div class="invalid-feedback small">@errors["Title"]</div>
                    }
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label class="form-label fw-bold small d-md-none">Description</label>
                    <label class="form-label fw-bold d-none d-md-block">Description</label>
                    <textarea class="form-control"
                              rows="3"
                              value="@formData.Description"
                              placeholder="Enter material description (optional)"
                              @oninput="@(async (ChangeEventArgs e) => await UpdateDescription(e.Value?.ToString() ?? ""))"></textarea>
                </div>

                <!-- Type and Order Row -->
                <div class="row">
                    <div class="col-12 col-md-6 mb-3">
                        <label class="form-label fw-bold small d-md-none">Type *</label>
                        <label class="form-label fw-bold d-none d-md-block">Material Type *</label>
                        <select class="form-select @(errors.ContainsKey("Type") ? "is-invalid" : "")"
                                value="@((int)formData.Type)"
                                @onchange="@(async (ChangeEventArgs e) => {
                                var val = int.TryParse(e.Value?.ToString(), out var intVal) ? intVal : 0;
                                await UpdateType((MaterialType)val);
                            })">
                        <option value="0">-- Select Type --</option>
                        <option value="@((int)MaterialType.Video)">🎥 Video</option>
                        <option value="@((int)MaterialType.Audio)">🎵 Audio</option>
                        <option value="@((int)MaterialType.PDF)">📄 PDF</option>
                        <option value="@((int)MaterialType.Document)">📝 Document</option>
                        <option value="@((int)MaterialType.Presentation)">📊 Presentation</option>
                        <option value="@((int)MaterialType.Other)">📁 Other</option>
                    </select>
                    @if (errors.ContainsKey("Type"))
                    {
                        <div class="invalid-feedback small">@errors["Type"]</div>
                    }
                </div>

                <div class="col-12 col-md-6 mb-3">
                    <label class="form-label fw-bold small d-md-none">Order *</label>
                    <label class="form-label fw-bold d-none d-md-block">Display Order *</label>
                    <input type="number" min="1"
                           class="form-control @(errors.ContainsKey("Order") ? "is-invalid" : "")"
                           value="@formData.Order.ToString()"
                           @oninput="@(async (ChangeEventArgs e) => {
                           var val = int.TryParse(e.Value?.ToString(), out var intVal) ? intVal : 1;
                           await UpdateOrder(val);
                                                          })" />
                    @if (errors.ContainsKey("Order"))
                    {
                        <div class="invalid-feedback small">@errors["Order"]</div>
                    }
                </div>
            </div>

            <!-- Duration and File Size (Optional fields) -->
            <div class="row">
                <div class="col-12 col-md-6 mb-3">
                    <label class="form-label fw-bold small d-md-none">Duration (seconds)</label>
                    <label class="form-label fw-bold d-none d-md-block">Duration (seconds)</label>
                    <input type="number" min="0"
                           class="form-control"
                           value="@formData.DurationSeconds"
                           placeholder="Optional"
                           @oninput="@(async (ChangeEventArgs e) => {
                           var val = int.TryParse(e.Value?.ToString(), out var intVal) ? intVal : 0;
                           await UpdateDuration(val);
                                                          })" />
                    <small class="text-muted">Optional</small>
                </div>

                <div class="col-12 col-md-6 mb-3">
                    <label class="form-label fw-bold small d-md-none">File Size (bytes)</label>
                    <label class="form-label fw-bold d-none d-md-block">File Size (bytes)</label>
                    <input type="number" min="0"
                           class="form-control"
                           value="@formData.FileSize"
                           placeholder="Optional"
                           @oninput="@(async (ChangeEventArgs e) => {
                                                              var val = long.TryParse(e.Value?.ToString(), out var longVal) ? longVal : 0;
                           await UpdateFileSize(val);
                                                          })" />
                    <small class="text-muted">Optional</small>
                </div>
            </div>

            <!-- File Upload - Mobile Optimized -->
            <div class="mb-3">
                <label class="form-label fw-bold small d-md-none">
                    @(editingMaterial == null ? "Upload File *" : "Replace File (Optional)")
                </label>
                <label class="form-label fw-bold d-none d-md-block">
                    @(editingMaterial == null ? "Upload File *" : "Replace File (Optional)")
                </label>

                <!-- Mobile Upload Area -->
                <div class="d-block d-md-none">
                    @if (string.IsNullOrEmpty(selectedFileName))
                    {
                        <div class="upload-area p-3 text-center border rounded bg-light mb-2"
                             @onclick="TriggerFileUpload">
                            <i class="fas fa-cloud-upload-alt fa-2x text-muted mb-2"></i>
                            <p class="small mb-1">Tap to upload file</p>
                            <p class="text-muted small mb-0">Max: 500MB</p>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info p-2 mb-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="small text-truncate" style="max-width: 200px;">
                                    <i class="fas fa-file me-2"></i>
                                    @selectedFileName
                                    <span class="text-muted ms-1">(@FormatFileSize(selectedFileSize))</span>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="RemoveSelectedFile">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Desktop Upload -->
                <div class="d-none d-md-block">
                    <InputFile class="form-control"
                               OnChange="HandleFileUpload"
                               accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.mp4,.mp3,.jpg,.jpeg,.png,.gif,.zip" />
                </div>

                <!-- Hidden file input for mobile -->
                <InputFile id="mobile-file-upload" class="d-none"
                           OnChange="HandleFileUpload"
                           accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.mp4,.mp3,.jpg,.jpeg,.png,.gif,.zip" />

                @if (!string.IsNullOrEmpty(selectedFileName))
                {
                    <div class="d-none d-md-block alert alert-info mt-2 p-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fas fa-file me-2"></i>
                                <strong>Selected:</strong> @selectedFileName
                                @if (selectedFileSize > 0)
                                {
                                    <span class="text-muted ms-2">(@FormatFileSize(selectedFileSize))</span>
                                }
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    @onclick="RemoveSelectedFile">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                }
                else if (editingMaterial != null && !string.IsNullOrEmpty(editingMaterial.ContentUrl))
                {
                    <div class="alert alert-light mt-2 p-2 small">
                        <i class="fas fa-info-circle me-2"></i>
                        Current file will be retained
                    </div>
                }

                @if (errors.ContainsKey("File"))
                {
                    <div class="invalid-feedback d-block small">@errors["File"]</div>
                }

                <small class="text-muted d-none d-md-block">
                    Supported: PDF, Word, Excel, PowerPoint, Video, Audio, Images, ZIP (Max: 500MB)
                </small>
                <small class="text-muted d-block d-md-none">
                    <i class="fas fa-info-circle me-1"></i>
                    Max 500MB
                </small>
            </div>

            <!-- Downloadable Option -->
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox"
                           checked="@formData.IsDownloadable"
                           id="downloadable-switch"
                           @onchange="@(async (ChangeEventArgs e) => {
                           var isChecked = e.Value?.ToString() == "on" || e.Value?.ToString() == "true";
                           await UpdateIsDownloadable(isChecked);
                                                          })" />
                    <label class="form-check-label fw-bold" for="downloadable-switch">
                        <span class="d-md-none">Allow Download</span>
                        <span class="d-none d-md-block">Allow Download</span>
                    </label>
                </div>
                <small class="text-muted d-block mt-1">
                    <span class="d-md-none">Users can download this file</span>
                    <span class="d-none d-md-block">Users can download this file to their device</span>
                </small>
            </div>

            <!-- Error Message -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger small p-2 mb-3">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @errorMessage
                </div>
            }

            <!-- Form Actions - Responsive -->
            <div class="d-flex justify-content-end gap-2">
                <!-- Mobile Actions -->
                <div class="d-flex d-md-none w-100 gap-2">
                    <button type="button" class="btn btn-outline-secondary flex-fill" @onclick="HideForm">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-primary flex-fill" @onclick="SaveMaterial"
                            disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Saving</span>
                        }
                        else
                        {
                            <i class="fas fa-check me-1"></i>
                            <span>@(editingMaterial == null ? "Create" : "Update")</span>
                        }
                    </button>
                </div>

                <!-- Desktop Actions -->
                <div class="d-none d-md-flex gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="HideForm">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="SaveMaterial"
                            disabled="@isSaving">
                        <i class="fas fa-save me-2"></i>
                        @(isSaving ? "Saving..." : (editingMaterial == null ? "Create Material" : "Update Material"))
                    </button>
                </div>
            </div>
        </div>
    </div>
        }
</div>

@code {
    [Parameter] public int LectureId { get; set; }
    [Parameter] public List<LearningMaterialDto>? Materials { get; set; }
    [Parameter] public EventCallback MaterialsChanged { get; set; }

    // UI State
    private bool showForm = false;
    private bool isSaving = false;
    private string? errorMessage;
    private Dictionary<string, string> errors = new();

    // Current Material
    private LearningMaterialDto? editingMaterial;

    // Form Data - Updated to match DTO
    private MaterialFormData formData = new();

    // File Upload
    private IBrowserFile? selectedFile;
    private string? selectedFileName;
    private long selectedFileSize;

    private class MaterialFormData
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public MaterialType Type { get; set; }
        public int Order { get; set; } = 1;
        public bool IsDownloadable { get; set; } = false;
        public int DurationSeconds { get; set; } = 0;
        public long FileSize { get; set; } = 0;
    }

    // Helper Methods
    private MarkupString GetMaterialTypeBadge(MaterialType type)
    {
        return type switch
        {
            MaterialType.Video => (MarkupString)"<span class='badge bg-danger'><i class='fas fa-video me-1'></i> Video</span>",
            MaterialType.Audio => (MarkupString)"<span class='badge bg-success'><i class='fas fa-music me-1'></i> Audio</span>",
            MaterialType.PDF => (MarkupString)"<span class='badge bg-primary'><i class='fas fa-file-pdf me-1'></i> PDF</span>",
            MaterialType.Document => (MarkupString)"<span class='badge bg-info'><i class='fas fa-file-word me-1'></i> Document</span>",
            MaterialType.Presentation => (MarkupString)"<span class='badge bg-warning'><i class='fas fa-file-powerpoint me-1'></i> Presentation</span>",
            _ => (MarkupString)"<span class='badge bg-secondary'><i class='fas fa-file me-1'></i> File</span>"
        };
    }

    private MarkupString GetMaterialTypeIcon(MaterialType type)
    {
        return type switch
        {
            MaterialType.Video => (MarkupString)"<span class='badge bg-danger me-2'><i class='fas fa-video'></i></span>",
            MaterialType.Audio => (MarkupString)"<span class='badge bg-success me-2'><i class='fas fa-music'></i></span>",
            MaterialType.PDF => (MarkupString)"<span class='badge bg-primary me-2'><i class='fas fa-file-pdf'></i></span>",
            MaterialType.Document => (MarkupString)"<span class='badge bg-info me-2'><i class='fas fa-file-word'></i></span>",
            MaterialType.Presentation => (MarkupString)"<span class='badge bg-warning me-2'><i class='fas fa-file-powerpoint'></i></span>",
            _ => (MarkupString)"<span class='badge bg-secondary me-2'><i class='fas fa-file'></i></span>"
        };
    }

    private string FormatDuration(int seconds)
    {
        if (seconds <= 0) return "0 sec";

        var timeSpan = TimeSpan.FromSeconds(seconds);
        if (timeSpan.TotalHours >= 1)
            return $"{(int)timeSpan.TotalHours}h {timeSpan.Minutes}m";
        if (timeSpan.TotalMinutes >= 1)
            return $"{timeSpan.Minutes}m {timeSpan.Seconds}s";
        return $"{seconds} sec";
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes <= 0) return "0 B";

        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double len = bytes;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private void TriggerFileUpload()
    {
        JS.InvokeVoidAsync("document.getElementById('mobile-file-upload').click()");
    }

    // Show/Hide Form
    private void ShowAddForm()
    {
        editingMaterial = null;
        formData = new MaterialFormData();
        errorMessage = null;
        errors.Clear();
        selectedFile = null;
        selectedFileName = null;
        selectedFileSize = 0;

        // Set default order based on existing materials
        if (Materials != null && Materials.Any())
        {
            formData.Order = Materials.Max(m => m.Order) + 1;
        }
        else
        {
            formData.Order = 1;
        }

        showForm = true;
    }

    private void ShowEditForm(LearningMaterialDto material)
    {
        editingMaterial = material;
        formData = new MaterialFormData
        {
            Title = material.Title,
            Description = material.Description ?? "",
            Type = material.Type,
            Order = material.Order,
            IsDownloadable = material.IsDownloadable,
            DurationSeconds = material.DurationSeconds,
            FileSize = material.FileSize
        };
        errorMessage = null;
        errors.Clear();
        selectedFile = null;
        selectedFileName = null;
        selectedFileSize = 0;
        showForm = true;
    }

    private void HideForm()
    {
        showForm = false;
        editingMaterial = null;
        formData = new MaterialFormData();
        errorMessage = null;
        errors.Clear();
        selectedFile = null;
        selectedFileName = null;
        selectedFileSize = 0;
    }

    // Form Update Methods
    private async Task UpdateTitle(string value)
    {
        formData.Title = value;
        Validate();
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateDescription(string value)
    {
        formData.Description = value;
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateType(MaterialType value)
    {
        formData.Type = value;
        Validate();
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateOrder(int value)
    {
        formData.Order = value;
        Validate();
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateDuration(int value)
    {
        formData.DurationSeconds = value;
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateFileSize(long value)
    {
        formData.FileSize = value;
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateIsDownloadable(bool value)
    {
        formData.IsDownloadable = value;
        await InvokeAsync(StateHasChanged);
    }

    // File Upload
    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            // Validate file size (500MB max)
            if (file.Size > 500 * 1024 * 1024)
            {
                errors["File"] = "File size exceeds 500MB limit";
                await JS.InvokeVoidAsync("showToast", "error", "File size exceeds 500MB limit");
                return;
            }

            selectedFile = file;
            selectedFileName = file.Name;
            selectedFileSize = file.Size;

            errors.Remove("File");
            Validate();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading file: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void RemoveSelectedFile()
    {
        selectedFile = null;
        selectedFileName = null;
        selectedFileSize = 0;
        Validate();
        StateHasChanged();
    }

    // Validation
    private void Validate()
    {
        errors.Clear();

        if (string.IsNullOrWhiteSpace(formData.Title))
        {
            errors["Title"] = "Title is required";
        }

        if (formData.Type == 0)
        {
            errors["Type"] = "Material type is required";
        }

        if (formData.Order < 1)
        {
            errors["Order"] = "Order must be at least 1";
        }

        if (editingMaterial == null && selectedFile == null)
        {
            errors["File"] = "Please upload a file";
        }
    }

    private bool IsValid()
    {
        return !errors.Any();
    }

    // Save Material
    private async Task SaveMaterial()
    {
        Validate();
        if (!IsValid())
        {
            errorMessage = "Please fix validation errors";
            return;
        }

        isSaving = true;
        errorMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var materialDto = new MaterialUploadDtos
            {
                Title = formData.Title,
                Description = formData.Description,
                Type = formData.Type,
                Order = formData.Order,
                IsDownloadable = formData.IsDownloadable,
                DurationSeconds = formData.DurationSeconds,
                FileSize = formData.FileSize,
                File = selectedFile
            };

            bool success;

            if (editingMaterial == null && selectedFile == null)
            {
                errorMessage = "Please upload a file for new materials";
                isSaving = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            Stream? fileStream = null;
            string? fileName = null;

            if (selectedFile != null)
            {
                fileStream = selectedFile.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
                fileName = selectedFile.Name;
            }

            success = await LectureService.AddMaterialAsync(
                LectureId,
                materialDto,
                fileStream,
                fileName);

            if (success)
            {
                await JS.InvokeVoidAsync("showToast", "success",
                    editingMaterial == null ? "Material added successfully" : "Material updated successfully");
                HideForm();
                await MaterialsChanged.InvokeAsync();
            }
            else
            {
                errorMessage = editingMaterial == null
                    ? "Failed to add material. Please try again."
                    : "Failed to update material. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"Error saving material: {ex}");
        }
        finally
        {
            isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Delete Material
    private async Task DeleteMaterial(LearningMaterialDto material)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{material.Title}'?"))
            return;

        try
        {
            var success = await LectureService.DeleteMaterialAsync(material.Id);
            if (success)
            {
                await JS.InvokeVoidAsync("showToast", "success", "Material deleted successfully");
                await MaterialsChanged.InvokeAsync();
            }
            else
            {
                await JS.InvokeVoidAsync("showToast", "error", "Failed to delete material");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showToast", "error", $"Error: {ex.Message}");
        }
    }
}
