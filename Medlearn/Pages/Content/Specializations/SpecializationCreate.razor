@page "/createspecialization/{id:int?}"


<PageTitle>@(IsEditMode ? "Edit Specialization" : "Create Specialization")</PageTitle>

<div class="create-specialization">
    <div class="container-fluid px-0 px-md-3">
        <!-- Header - Responsive -->
        <div class="row g-0 mb-3 mb-md-4">
            <div class="col-12">
                <!-- Mobile Header -->
                <div class="d-block d-md-none">
                    <div class="bg-primary text-white p-3">
                        <div class="d-flex align-items-center">
                            <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                                <i class="fas fa-arrow-left fa-lg"></i>
                            </button>
                            <h5 class="mb-0 flex-grow-1">@(IsEditMode ? "Edit" : "Create") Specialization</h5>
                            <button class="btn btn-link text-white p-0" @onclick="ResetForm">
                                <i class="fas fa-redo fa-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Desktop Header -->
                <div class="d-none d-md-block">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1>@(IsEditMode ? "Edit Specialization" : "Create Specialization")</h1>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="/doctor">Doctor</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="/specializations">My Specializations</a>
                                    </li>
                                    <li class="breadcrumb-item active" aria-current="page">
                                        @(IsEditMode ? "Edit" : "Create")
                                    </li>
                                </ol>
                            </nav>
                        </div>
                        <div>
                            <button class="btn btn-outline-secondary" @onclick="GoBack">
                                <i class="fas fa-arrow-left me-2"></i> Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted">Loading...</p>
            </div>
        }
        else if (!isAuthenticated)
        {
            <div class="text-center py-5">
                <div class="alert alert-warning mx-3 mx-md-auto" style="max-width: 400px;">
                    <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                    <h4>Authentication Required</h4>
                    <p class="mb-4">Please login to create or edit specializations</p>
                    <a href="/account/login" class="btn btn-primary">
                        <i class="fas fa-sign-in-alt me-2"></i> Login
                    </a>
                </div>
            </div>
        }
        else if (!isAuthorized)
        {
            <div class="text-center py-5">
                <div class="alert alert-danger mx-3 mx-md-auto" style="max-width: 400px;">
                    <i class="fas fa-ban fa-2x mb-3"></i>
                    <h4>Access Denied</h4>
                    <p class="mb-4">Only doctors can create or edit specializations</p>
                    <a href="/" class="btn btn-outline-primary">
                        <i class="fas fa-home me-2"></i> Go Home
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row justify-content-center">
                <div class="col-12 col-lg-10">
                    <div class="card border-0 border-md">
                        <div class="card-header bg-transparent d-none d-md-block">
                            <h5 class="mb-0">Specialization Details</h5>
                        </div>
                        <div class="card-body p-3 p-md-4">
                            <EditForm Model="@createDto" OnValidSubmit="SaveSpecialization">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="alert alert-danger d-none d-md-block" />
                                <!-- Mobile Validation Summary -->
                                <ValidationSummary class="alert alert-danger d-block d-md-none small p-2" />

                                <!-- Mobile View -->
                                <div class="d-block d-md-none">
                                    <!-- Basic Information -->
                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-3">
                                            <i class="fas fa-info-circle me-2 text-primary"></i>Basic Information
                                        </h6>

                                        <!-- Title -->
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold" for="mobile-title">
                                                Specialization Title <span class="text-danger">*</span>
                                            </label>
                                            <InputText id="mobile-title" @bind-Value="createDto.Title"
                                                       class="form-control form-control-sm"
                                                       placeholder="Enter specialization title" />
                                            <ValidationMessage For="@(() => createDto.Title)" class="text-danger small" />
                                        </div>

                                        <!-- Price and Duration -->
                                        <div class="row g-2 mb-3">
                                            <div class="col-6">
                                                <label class="form-label small fw-bold" for="mobile-price">
                                                    Price ($) <span class="text-danger">*</span>
                                                </label>
                                                <InputNumber id="mobile-price" @bind-Value="createDto.Price"
                                                             class="form-control form-control-sm"
                                                             placeholder="0.00" />
                                                <ValidationMessage For="@(() => createDto.Price)" class="text-danger small" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-bold" for="mobile-duration">
                                                    Duration (hrs) <span class="text-danger">*</span>
                                                </label>
                                                <InputNumber id="mobile-duration" @bind-Value="createDto.EstimatedDurationHours"
                                                             class="form-control form-control-sm"
                                                             placeholder="Hours" />
                                                <ValidationMessage For="@(() => createDto.EstimatedDurationHours)" class="text-danger small" />
                                            </div>
                                        </div>

                                        <!-- Description -->
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold" for="mobile-description">
                                                Description <span class="text-danger">*</span>
                                            </label>
                                            <InputTextArea id="mobile-description" @bind-Value="createDto.Description"
                                                           class="form-control form-control-sm"
                                                           placeholder="Describe what students will learn"
                                                           style="height: 100px" />
                                            <ValidationMessage For="@(() => createDto.Description)" class="text-danger small" />
                                            <small class="text-muted small">
                                                @(createDto.Description?.Length ?? 0)/500 characters
                                            </small>
                                        </div>

                                        <!-- Prerequisites -->
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold" for="mobile-prerequisites">
                                                Prerequisites <span class="text-muted">(Optional)</span>
                                            </label>
                                            <InputTextArea id="mobile-prerequisites" @bind-Value="createDto.Prerequisites"
                                                           class="form-control form-control-sm"
                                                           placeholder="Required knowledge before starting"
                                                           style="height: 80px" />
                                            <ValidationMessage For="@(() => createDto.Prerequisites)" class="text-danger small" />
                                        </div>
                                    </div>

                                    <!-- Thumbnail Section -->
                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-3">
                                            <i class="fas fa-image me-2 text-primary"></i>Thumbnail Image
                                        </h6>

                                        <!-- Mobile Image Upload -->
                                        <div class="mb-3">
                                            @if (!string.IsNullOrEmpty(previewImageUrl))
                                            {
                                                <div class="position-relative mb-2">
                                                    <img src="@previewImageUrl" class="img-fluid rounded w-100"
                                                         alt="Thumbnail preview" style="max-height: 150px; object-fit: cover;" />
                                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2"
                                                            @onclick="RemoveThumbnail">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            }
                                            else if (IsEditMode && !string.IsNullOrEmpty(existingThumbnailUrl))
                                            {
                                                <div class="position-relative mb-2">
                                                    <img src="@existingThumbnailUrl" class="img-fluid rounded w-100"
                                                         alt="Current thumbnail" style="max-height: 150px; object-fit: cover;" />
                                                    <span class="badge bg-secondary position-absolute top-0 end-0 m-2">Current</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="upload-area mb-2 p-3 text-center border rounded bg-light"
                                                     @onclick="TriggerFileUpload">
                                                    <i class="fas fa-cloud-upload-alt fa-2x text-muted mb-2"></i>
                                                    <p class="small mb-1">Tap to upload image</p>
                                                    <p class="text-muted small mb-0">JPG, PNG (Max 5MB)</p>
                                                </div>
                                            }

                                            <InputFile id="mobile-thumbnail" class="d-none"
                                                       OnChange="OnThumbnailSelected"
                                                       accept="image/*" />

                                            @if (!string.IsNullOrEmpty(uploadError))
                                            {
                                                <div class="alert alert-danger p-2 small mt-2">
                                                    <i class="fas fa-exclamation-circle me-1"></i>
                                                    @uploadError
                                                </div>
                                            }
                                            @if (thumbnailFile != null)
                                            {
                                                <div class="alert alert-info p-2 small mt-2">
                                                    <i class="fas fa-check-circle me-2 text-success"></i>
                                                    @thumbnailFile.Name
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Action Buttons (Mobile) -->
                                    <div class="fixed-bottom d-block d-md-none p-3 bg-white border-top">
                                        <div class="d-flex gap-2">
                                            <button type="button"
                                                    class="btn btn-outline-secondary flex-fill"
                                                    @onclick="GoBack">
                                                Cancel
                                            </button>
                                            <button type="submit"
                                                    class="btn btn-primary flex-fill"
                                                    disabled="@isSubmitting">
                                                @if (isSubmitting)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-save me-1"></i>
                                                }
                                                @(IsEditMode ? "Update" : "Create")
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Spacer for mobile fixed button -->
                                    <div class="mb-5 pb-3 d-block d-md-none"></div>
                                </div>

                                <!-- Desktop View -->
                                <div class="d-none d-md-block">
                                    <div class="row g-3">
                                        <!-- Basic Information -->
                                        <div class="col-12">
                                            <div class="form-floating mb-3">
                                                <InputText id="title" @bind-Value="createDto.Title"
                                                           class="form-control" placeholder="Specialization Title" />
                                                <label for="title">Specialization Title *</label>
                                                <ValidationMessage For="@(() => createDto.Title)" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <InputNumber id="price" @bind-Value="createDto.Price"
                                                             class="form-control" placeholder="Price" />
                                                <label for="price">Price ($) *</label>
                                                <ValidationMessage For="@(() => createDto.Price)" />
                                                <div class="form-text">
                                                    Total price for the entire specialization
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <InputNumber id="duration" @bind-Value="createDto.EstimatedDurationHours"
                                                             class="form-control" placeholder="Estimated Duration" />
                                                <label for="duration">Estimated Duration (Hours) *</label>
                                                <ValidationMessage For="@(() => createDto.EstimatedDurationHours)" />
                                                <div class="form-text">
                                                    Total estimated learning time
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="form-floating mb-3">
                                                <InputTextArea id="description" @bind-Value="createDto.Description"
                                                               class="form-control" placeholder="Description"
                                                               style="height: 150px" />
                                                <label for="description">Description *</label>
                                                <ValidationMessage For="@(() => createDto.Description)" />
                                                <div class="form-text">
                                                    Detailed overview of what students will learn
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="form-floating mb-3">
                                                <InputTextArea id="prerequisites" @bind-Value="createDto.Prerequisites"
                                                               class="form-control" placeholder="Prerequisites"
                                                               style="height: 100px" />
                                                <label for="prerequisites">Prerequisites</label>
                                                <ValidationMessage For="@(() => createDto.Prerequisites)" />
                                                <div class="form-text">
                                                    Required knowledge or skills before starting (optional)
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Thumbnail Upload -->
                                        <div class="col-12">
                                            <hr />
                                            <h5>Thumbnail Image</h5>
                                            <div class="mb-3">
                                                <div class="row align-items-center">
                                                    <div class="col-md-4">
                                                        @if (!string.IsNullOrEmpty(previewImageUrl))
                                                        {
                                                            <div class="thumbnail-preview mb-3">
                                                                <img src="@previewImageUrl" class="img-fluid rounded"
                                                                     alt="Thumbnail preview" style="max-height: 200px;" />
                                                                <button type="button" class="btn btn-sm btn-danger mt-2"
                                                                        @onclick="RemoveThumbnail">
                                                                    <i class="fas fa-trash me-1"></i> Remove
                                                                </button>
                                                            </div>
                                                        }
                                                        else if (IsEditMode && !string.IsNullOrEmpty(existingThumbnailUrl))
                                                        {
                                                            <div class="thumbnail-preview mb-3">
                                                                <img src="@existingThumbnailUrl" class="img-fluid rounded"
                                                                     alt="Current thumbnail" style="max-height: 200px;" />
                                                                <div class="mt-2">
                                                                    <small class="text-muted">Current thumbnail</small>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="col-md-8">
                                                        <div class="mb-3">
                                                            <label class="form-label">Upload Thumbnail Image</label>
                                                            <InputFile id="thumbnail" class="form-control"
                                                                       OnChange="OnThumbnailSelected"
                                                                       accept="image/*" />
                                                            <div class="form-text">
                                                                Recommended: 1280x720px, JPG or PNG format, max 5MB
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(uploadError))
                                                            {
                                                                <div class="text-danger small mt-1">@uploadError</div>
                                                            }
                                                            @if (thumbnailFile != null)
                                                            {
                                                                <div class="alert alert-info mt-2 p-2">
                                                                    <i class="fas fa-check-circle me-2 text-success"></i>
                                                                    File selected: @thumbnailFile.Name (@((thumbnailFile.Size / 1024).ToString("N0")) KB)
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Submit Button -->
                                        <div class="col-12">
                                            <hr />
                                            <div class="d-flex justify-content-between">
                                                <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">
                                                    <i class="fas fa-redo me-2"></i> Reset
                                                </button>
                                                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                                    @if (isSubmitting)
                                                    {
                                                        <span>
                                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                            @(IsEditMode ? "Updating..." : "Creating...")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>
                                                            <i class="fas fa-save me-2"></i>
                                                            @(IsEditMode ? "Update Specialization" : "Create Specialization")
                                                        </span>
                                                    }
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private CreateSpecializationDto createDto = new();
    private SpecializationDto? existingSpecialization;
    private UserDto? currentUser;
    private string previewImageUrl = "";
    private string uploadError = "";
    private string existingThumbnailUrl = "";
    private bool isSubmitting = false;
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private bool isAuthorized = false;
    private IBrowserFile? thumbnailFile;
    private int doctorId = 0;

    private bool IsEditMode => Id.HasValue && Id > 0;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();

        if (isAuthenticated && isAuthorized)
        {
            await LoadSpecializationData();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();

                if (currentUser != null)
                {
                    isAuthorized = currentUser.UserType == UserType.Doctor || currentUser.UserType == UserType.Admin;
                    doctorId = currentUser.Id;
                }
                else
                {
                    isAuthenticated = false;
                }
            }

            if (!isAuthenticated)
            {
                if (IsEditMode)
                {
                    Navigation.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
                }
            }
            else if (!isAuthorized)
            {
                await ShowToast("error", "Only doctors can create or edit specializations");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            isAuthorized = false;
        }
    }

    private async Task LoadSpecializationData()
    {
        isLoading = true;

        try
        {
            if (IsEditMode)
            {
                existingSpecialization = await SpecializationService.GetSpecializationAsync(Id!.Value);

                if (existingSpecialization != null)
                {
                    if (existingSpecialization.DoctorId != doctorId && currentUser?.UserType != UserType.Admin)
                    {
                        await ShowToast("error", "You don't have permission to edit this specialization");
                        Navigation.NavigateTo("/content/specializations");
                        return;
                    }

                    createDto = new CreateSpecializationDto
                    {
                        Title = existingSpecialization.Title,
                        Description = existingSpecialization.Description,
                        Price = existingSpecialization.Price,
                        EstimatedDurationHours = existingSpecialization.EstimatedDurationHours,
                        Prerequisites = existingSpecialization.Prerequisites,
                        IsFeatured = existingSpecialization.IsFeatured
                    };

                    existingThumbnailUrl = existingSpecialization.ThumbnailUrl;
                }
                else
                {
                    await ShowToast("error", "Specialization not found");
                    Navigation.NavigateTo("/content/specializations");
                }
            }
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveSpecialization()
    {
        if (!isAuthenticated || !isAuthorized)
        {
            await ShowToast("error", "You are not authorized to perform this action");
            return;
        }

        isSubmitting = true;
        uploadError = "";

        try
        {
            Stream? thumbnailStream = null;
            string fileName = "";

            if (thumbnailFile != null)
            {
                thumbnailStream = thumbnailFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                fileName = thumbnailFile.Name;
            }

            if (IsEditMode && existingSpecialization != null)
            {
                var updateDto = new UpdateSpecializationDtos
                {
                    Title = createDto.Title,
                    Description = createDto.Description,
                    Price = createDto.Price,
                    EstimatedDurationHours = createDto.EstimatedDurationHours,
                    Prerequisites = createDto.Prerequisites,
                    IsFeatured = createDto.IsFeatured,
                    ThumbnailImage = thumbnailFile
                };

                if (currentUser?.UserType != UserType.Admin)
                {
                    updateDto.IsFeatured = existingSpecialization.IsFeatured;
                }

                var success = await SpecializationService.UpdateSpecializationAsync(
                    existingSpecialization.Id,
                    updateDto,
                    thumbnailStream,
                    fileName
                );

                if (success)
                {
                    await ShowToast("success", "Specialization updated successfully");
                    Navigation.NavigateTo($"/content/specializations/{existingSpecialization.Id}");
                }
                else
                {
                    await ShowToast("error", "Failed to update specialization");
                }
            }
            else
            {
                if (currentUser?.UserType != UserType.Admin)
                {
                    createDto.IsFeatured = false;
                }

                var specialization = await SpecializationService.CreateSpecializationAsync(
                    createDto,
                    thumbnailStream,
                    fileName
                );

                if (specialization != null)
                {
                    await ShowToast("success", "Specialization created successfully");
                    Navigation.NavigateTo("/content/specializations");
                }
                else
                {
                    await ShowToast("error", "Failed to create specialization");
                }
            }
        }
        catch (Exception ex)
        {
            await ShowToast("error", ex.Message);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task OnThumbnailSelected(InputFileChangeEventArgs e)
    {
        uploadError = "";
        var file = e.File;

        if (file.Size > 5 * 1024 * 1024)
        {
            uploadError = "File size must be less than 5MB";
            await ShowToast("error", uploadError);
            return;
        }

        if (!file.ContentType.StartsWith("image/"))
        {
            uploadError = "Please upload an image file (JPG, PNG, etc.)";
            await ShowToast("error", uploadError);
            return;
        }

        thumbnailFile = file;

        try
        {
            var format = "image/jpeg";
            var resizedImage = await file.RequestImageFileAsync(format, 800, 450);
            var buffer = new byte[resizedImage.Size];
            await resizedImage.OpenReadStream().ReadAsync(buffer);
            previewImageUrl = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
        }
        catch (Exception ex)
        {
            uploadError = $"Error creating preview: {ex.Message}";
        }

        StateHasChanged();
    }

    private void TriggerFileUpload()
    {
        JS.InvokeVoidAsync("document.getElementById('mobile-thumbnail').click()");
    }

    private void RemoveThumbnail()
    {
        thumbnailFile = null;
        createDto.ThumbnailImage = null;
        previewImageUrl = "";
        StateHasChanged();
    }

    private void ResetForm()
    {
        if (IsEditMode && existingSpecialization != null)
        {
            createDto = new CreateSpecializationDto
            {
                Title = existingSpecialization.Title,
                Description = existingSpecialization.Description,
                Price = existingSpecialization.Price,
                EstimatedDurationHours = existingSpecialization.EstimatedDurationHours,
                Prerequisites = existingSpecialization.Prerequisites,
                IsFeatured = existingSpecialization.IsFeatured
            };
        }
        else
        {
            createDto = new CreateSpecializationDto();
        }

        thumbnailFile = null;
        createDto.ThumbnailImage = null;
        previewImageUrl = "";
        uploadError = "";

        StateHasChanged();
    }

    private void GoBack()
    {
        if (IsEditMode && existingSpecialization != null)
        {
            Navigation.NavigateTo($"/content/specializations/{existingSpecialization.Id}");
        }
        else
        {
            Navigation.NavigateTo("/content/specializations");
        }
    }

    private async Task ShowToast(string type, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", type, message);
        }
        catch
        {
            Console.WriteLine($"{type.ToUpper()}: {message}");
        }
    }
}