

@if (Data == null)
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle me-2"></i>
        Specialization data not available
    </div>
}
else
{
    <!-- Mobile View (d-block d-md-none) -->
    <div class="d-block d-md-none">
        <!-- Mobile Header with Status -->
        <div class="bg-light p-3 rounded mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold">Specialization Status</span>
                <div class="form-check form-switch d-inline-block">
                    <input class="form-check-input" type="checkbox"
                           id="mobile-status-toggle"
                           checked="@Data.IsActive"
                           @onchange="@(async (ChangeEventArgs e) => {
                           var isChecked = e.Value?.ToString() == "on" || e.Value?.ToString() == "true";
                           await UpdateIsActive(isChecked);
                       })" />
            </div>
        </div>
        <small class="text-muted d-block">
            @(Data.IsActive ? "Active - Visible to users" : "Inactive - Hidden from users")
        </small>

        <div class="mt-2 pt-2 border-top">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold">Featured</span>
                <div class="form-check form-switch d-inline-block">
                    <input class="form-check-input" type="checkbox"
                           id="mobile-featured-toggle"
                           checked="@Data.IsFeatured"
                           @onchange="@(async (ChangeEventArgs e) => {
                           var isChecked = e.Value?.ToString() == "on" || e.Value?.ToString() == "true";
                           await UpdateIsFeatured(isChecked);
                                                          })" />
                </div>
            </div>
        </div>
    </div>

    <!-- Basic Info Section -->
    <div class="mb-4">
        <h6 class="fw-bold mb-3">
            <i class="fas fa-info-circle me-2 text-primary"></i>Basic Information
        </h6>

        <!-- Title (Mobile) -->
        <div class="mb-3">
            <label class="form-label small fw-bold" for="mobile-title">
                Title <span class="text-danger">*</span>
            </label>
            <input type="text"
                   id="mobile-title"
                   class="form-control form-control-sm @(Errors.ContainsKey("Title") ? "is-invalid" : "")"
                   value="@Data.Title"
                   placeholder="Enter specialization title"
                   @oninput="@(async (ChangeEventArgs e) => await UpdateTitle(e.Value?.ToString() ?? ""))" />
            @if (Errors.ContainsKey("Title"))
            {
                <div class="invalid-feedback small">@Errors["Title"]</div>
            }
            <small class="text-muted small">@(Data.Title?.Length ?? 0)/200</small>
        </div>

        <!-- Description (Mobile) -->
        <div class="mb-3">
            <label class="form-label small fw-bold" for="mobile-description">
                Description <span class="text-danger">*</span>
            </label>
            <textarea class="form-control form-control-sm @(Errors.ContainsKey("Description") ? "is-invalid" : "")"
                      id="mobile-description"
                      rows="4"
                      placeholder="Describe the specialization"
                      value="@Data.Description"
                      @oninput="@(async (ChangeEventArgs e) => await UpdateDescription(e.Value?.ToString() ?? ""))"></textarea>
            @if (Errors.ContainsKey("Description"))
            {
                <div class="invalid-feedback small">@Errors["Description"]</div>
            }
            <small class="text-muted small">@(Data.Description?.Length ?? 0)/1000</small>
        </div>
    </div>

    <!-- Pricing & Duration Section (Mobile) -->
    <div class="mb-4">
        <h6 class="fw-bold mb-3">
            <i class="fas fa-tag me-2 text-primary"></i>Pricing & Duration
        </h6>

        <!-- Price (Mobile) -->
        <div class="mb-3">
            <label class="form-label small fw-bold" for="mobile-price">Price ($)</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text">$</span>
                <input type="number" step="0.01" min="0"
                       id="mobile-price"
                       class="form-control @(Errors.ContainsKey("Price") ? "is-invalid" : "")"
                       value="@(Data.Price.ToString("0.00"))"
                       placeholder="0.00"
                       @oninput="@(async (ChangeEventArgs e) => {
                       var val = decimal.TryParse(e.Value?.ToString(), out var decVal) ? decVal : 0;
                       await UpdatePrice(val);
                                                  })" />
            </div>
            @if (Errors.ContainsKey("Price"))
            {
                <div class="invalid-feedback small">@Errors["Price"]</div>
            }
        </div>

        <!-- Duration (Mobile) -->
        <div class="mb-3">
            <label class="form-label small fw-bold" for="mobile-duration">Estimated Duration</label>
            <div class="input-group input-group-sm">
                <input type="number" min="1"
                       id="mobile-duration"
                       class="form-control @(Errors.ContainsKey("Duration") ? "is-invalid" : "")"
                       value="@(Data.EstimatedDurationHours.ToString())"
                       placeholder="Hours"
                       @oninput="@(async (ChangeEventArgs e) => {
                       var val = int.TryParse(e.Value?.ToString(), out var intVal) ? intVal : 1;
                       await UpdateDuration(val);
                                                  })" />
                <span class="input-group-text">hours</span>
            </div>
            @if (Errors.ContainsKey("Duration"))
            {
                <div class="invalid-feedback small">@Errors["Duration"]</div>
            }
        </div>
    </div>

    <!-- Prerequisites (Mobile) -->
    <div class="mb-4">
        <h6 class="fw-bold mb-3">
            <i class="fas fa-list-check me-2 text-primary"></i>Prerequisites
        </h6>

        <div class="mb-3">
            <textarea class="form-control form-control-sm"
                      id="mobile-prerequisites"
                      rows="3"
                      value="@Data.Prerequisites"
                      @oninput="@(async (ChangeEventArgs e) => await UpdatePrerequisites(e.Value?.ToString() ?? ""))"
                      placeholder="List any prerequisites or requirements (one per line)"></textarea>
            <small class="text-muted small">Optional. List what students should know before starting</small>
        </div>
    </div>

    <!-- Thumbnail Section (Mobile) -->
    <div class="mb-4">
        <h6 class="fw-bold mb-3">
            <i class="fas fa-image me-2 text-primary"></i>Thumbnail Image
        </h6>

        <!-- Current Thumbnail -->
        @if (!string.IsNullOrEmpty(Data.ThumbnailUrl) && string.IsNullOrEmpty(thumbnailPreview))
        {
            <div class="mb-3">
                <p class="small text-muted mb-2">Current Thumbnail:</p>
                <div class="position-relative">
                    <img src="@Data.ThumbnailUrl"
                         class="img-fluid rounded w-100"
                         style="max-height: 150px; object-fit: cover;"
                         alt="Current thumbnail" />
                    <button class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2"
                            type="button" @onclick="RemoveThumbnail">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        }

        <!-- Hidden InputFile for JS interop -->
        <InputFile id="mobile-thumbnail-input"
                   class="d-none"
                   accept=".jpg,.jpeg,.png,.gif"
                   OnChange="@HandleFileUpload" />

        <!-- Upload New (Mobile) -->
        <div class="border rounded p-3 bg-light">
            @if (string.IsNullOrEmpty(thumbnailPreview))
            {
                <!-- No preview - Show upload button -->
                <div class="text-center">
                    <button type="button" class="btn btn-outline-primary w-100"
                            @onclick="TriggerFileUpload">
                        <i class="fas fa-cloud-upload-alt me-2"></i>
                        Tap to Upload Thumbnail
                    </button>
                    <p class="text-muted small mb-0 mt-2">
                        <i class="fas fa-info-circle me-1"></i>
                        JPG, PNG, GIF (Max 2MB)
                    </p>
                </div>
            }
            else
            {
                <!-- Preview Mode -->
                <div>
                    <p class="small text-muted mb-2">New Thumbnail Preview:</p>
                    <img src="@thumbnailPreview"
                         class="img-fluid rounded w-100"
                         style="max-height: 150px; object-fit: cover;"
                         alt="New thumbnail preview" />

                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-sm btn-outline-secondary flex-fill"
                                type="button" @onclick="ClearNewThumbnail">
                            <i class="fas fa-times me-1"></i> Clear
                        </button>
                        <button class="btn btn-sm btn-outline-primary flex-fill"
                                type="button" @onclick="TriggerFileUpload">
                            <i class="fas fa-sync-alt me-1"></i> Change
                        </button>
                    </div>
                </div>
            }

            <small class="text-muted small d-block mt-2">
                <i class="fas fa-info-circle me-1"></i>
                Recommended: 800x600px, Max 2MB
            </small>
        </div>
    </div>

    <!-- Mobile Action Buttons -->
    <div class="fixed-bottom d-block d-md-none p-3 bg-white border-top">
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary flex-fill" @onclick="Cancel">
                Cancel
            </button>
            <button type="button" class="btn btn-primary flex-fill" @onclick="Save">
                <i class="fas fa-save me-1"></i> Save
            </button>
        </div>
    </div>

    <!-- Spacer for fixed button -->
    <div class="mb-5 pb-3 d-block d-md-none"></div>
</div>

<!-- Desktop View (d-none d-md-block) -->
<div class="d-none d-md-block">
    <div class="row">
        <!-- Title -->
        <div class="col-12 mb-3">
            <label class="form-label fw-bold" for="desktop-title">Title *</label>
            <input type="text"
                   id="desktop-title"
                   class="form-control @(Errors.ContainsKey("Title") ? "is-invalid" : "")"
                   value="@Data.Title"
                   placeholder="Enter specialization title"
                   @oninput="@(async (ChangeEventArgs e) => await UpdateTitle(e.Value?.ToString() ?? ""))" />
            @if (Errors.ContainsKey("Title"))
            {
                <div class="invalid-feedback">@Errors["Title"]</div>
            }
            <small class="text-muted">@(Data.Title?.Length ?? 0)/200 characters</small>
        </div>

        <!-- Description -->
        <div class="col-12 mb-3">
            <label class="form-label fw-bold" for="desktop-description">Description *</label>
            <textarea class="form-control @(Errors.ContainsKey("Description") ? "is-invalid" : "")"
                      id="desktop-description"
                      rows="4"
                      placeholder="Describe the specialization in detail"
                      value="@Data.Description"
                      @oninput="@(async (ChangeEventArgs e) => await UpdateDescription(e.Value?.ToString() ?? ""))"></textarea>
            @if (Errors.ContainsKey("Description"))
            {
                <div class="invalid-feedback">@Errors["Description"]</div>
            }
            <small class="text-muted">@(Data.Description?.Length ?? 0)/1000 characters</small>
        </div>

        <!-- Price -->
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold" for="desktop-price">Price ($)</label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input type="number" step="0.01" min="0"
                       id="desktop-price"
                       class="form-control @(Errors.ContainsKey("Price") ? "is-invalid" : "")"
                       value="@(Data.Price.ToString("0.00"))"
                       placeholder="0.00"
                       @oninput="@(async (ChangeEventArgs e) => {
                       var val = decimal.TryParse(e.Value?.ToString(), out var decVal) ? decVal : 0;
                       await UpdatePrice(val);
                                                  })" />
            </div>
            @if (Errors.ContainsKey("Price"))
            {
                <div class="invalid-feedback">@Errors["Price"]</div>
            }
        </div>

        <!-- Estimated Duration -->
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold" for="desktop-duration">Estimated Duration (hours)</label>
            <input type="number" min="1"
                   id="desktop-duration"
                   class="form-control @(Errors.ContainsKey("Duration") ? "is-invalid" : "")"
                   value="@(Data.EstimatedDurationHours.ToString())"
                   placeholder="Hours"
                   @oninput="@(async (ChangeEventArgs e) => {
                   var val = int.TryParse(e.Value?.ToString(), out var intVal) ? intVal : 1;
                   await UpdateDuration(val);
                                          })" />
            @if (Errors.ContainsKey("Duration"))
            {
                <div class="invalid-feedback">@Errors["Duration"]</div>
            }
        </div>

        <!-- Prerequisites -->
        <div class="col-12 mb-3">
            <label class="form-label fw-bold" for="desktop-prerequisites">Prerequisites</label>
            <textarea class="form-control" rows="3"
                      id="desktop-prerequisites"
                      value="@Data.Prerequisites"
                      @oninput="@(async (ChangeEventArgs e) => await UpdatePrerequisites(e.Value?.ToString() ?? ""))"
                      placeholder="List any prerequisites or requirements..."></textarea>
            <small class="text-muted">Optional. List what students should know before starting</small>
        </div>

        <!-- Thumbnail Upload -->
        <div class="col-12 mb-3">
            <label class="form-label fw-bold">Thumbnail Image</label>

            <!-- Current Thumbnail Preview -->
            @if (!string.IsNullOrEmpty(Data.ThumbnailUrl) && string.IsNullOrEmpty(thumbnailPreview))
            {
                <div class="mb-3">
                    <p class="small text-muted">Current Thumbnail:</p>
                    <div class="d-flex align-items-center">
                        <img src="@Data.ThumbnailUrl"
                             class="img-thumbnail"
                             style="max-width: 200px; max-height: 150px; object-fit: cover;"
                             alt="Current thumbnail" />
                        <button class="btn btn-sm btn-outline-danger ms-2" type="button" @onclick="RemoveThumbnail">
                            <i class="fas fa-trash me-1"></i> Remove
                        </button>
                    </div>
                </div>
            }

            <!-- Upload New -->
            <div class="border rounded p-3">
                <InputFile class="form-control"
                           accept=".jpg,.jpeg,.png,.gif"
                           OnChange="@HandleFileUpload" />
                <small class="text-muted">
                    Recommended size: 800x600px. Max file size: 2MB. Supported formats: JPG, PNG, GIF
                </small>

                <!-- New Thumbnail Preview -->
                @if (!string.IsNullOrEmpty(thumbnailPreview))
                {
                    <div class="mt-3">
                        <p class="small text-muted">New Thumbnail Preview:</p>
                        <div class="d-flex align-items-center">
                            <img src="@thumbnailPreview"
                                 class="img-thumbnail"
                                 style="max-width: 200px; max-height: 150px; object-fit: cover;"
                                 alt="New thumbnail preview" />
                            <button class="btn btn-sm btn-outline-secondary ms-2"
                                    type="button" @onclick="ClearNewThumbnail">
                                <i class="fas fa-times me-1"></i> Clear
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Status Toggle -->
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox"
                               id="desktop-status-toggle"
                               checked="@Data.IsActive"
                               @onchange="@(async (ChangeEventArgs e) => {
                               var isChecked = e.Value?.ToString() == "on" || e.Value?.ToString() == "true";
                               await UpdateIsActive(isChecked);
                                                                  })" />
                        <label class="form-check-label fw-bold" for="desktop-status-toggle">
                            Active
                        </label>
                    </div>
                    <small class="text-muted d-block mt-2">
                        @(Data.IsActive
                                                ? "✓ This specialization is visible to users and available for enrollment." 
                                                                : "⛔ This specialization is hidden from users and cannot be enrolled in.")
                    </small>
                </div>
            </div>
        </div>

        <!-- Featured -->
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox"
                               id="desktop-featured-toggle"
                               checked="@Data.IsFeatured"
                               @onchange="@(async (ChangeEventArgs e) => {
                               var isChecked = e.Value?.ToString() == "on" || e.Value?.ToString() == "true";
                               await UpdateIsFeatured(isChecked);
                                                                  })" />
                        <label class="form-check-label fw-bold" for="desktop-featured-toggle">
                            Featured
                        </label>
                    </div>
                    <small class="text-muted d-block mt-2">
                        @(Data.IsFeatured
                                                ? "⭐ Featured specializations are highlighted on the homepage" 
                                                                : "Not featured - will appear in regular listings")
                    </small>
                </div>
            </div>
        </div>

        <!-- Desktop Action Buttons -->
        <div class="col-12 mt-3">
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" @onclick="Cancel">
                    Cancel
                </button>
                <button type="button" class="btn btn-primary" @onclick="Save">
                    <i class="fas fa-save me-2"></i> Save Specialization
                </button>
            </div>
        </div>
    </div>
</div>
}

@code {
    [Parameter] public SpecializationDto? Data { get; set; }
    [Parameter] public Dictionary<string, string> Errors { get; set; } = new();
    [Parameter] public EventCallback<SpecializationDto> OnDataChanged { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnThumbnailUploaded { get; set; }
    [Parameter] public EventCallback OnThumbnailRemoved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    private string? thumbnailPreview;

    private async Task UpdateTitle(string value)
    {
        if (Data == null) return;
        Data.Title = value;
        await OnDataChanged.InvokeAsync(Data);
    }

    private async Task UpdateDescription(string value)
    {
        if (Data == null) return;
        Data.Description = value;
        await OnDataChanged.InvokeAsync(Data);
    }

    private async Task UpdatePrice(decimal value)
    {
        if (Data == null) return;
        Data.Price = value;
        await OnDataChanged.InvokeAsync(Data);
    }

    private async Task UpdateDuration(int value)
    {
        if (Data == null) return;
        Data.EstimatedDurationHours = value;
        await OnDataChanged.InvokeAsync(Data);
    }

    private async Task UpdatePrerequisites(string value)
    {
        if (Data == null) return;
        Data.Prerequisites = value;
        await OnDataChanged.InvokeAsync(Data);
    }

    private async Task UpdateIsActive(bool value)
    {
        if (Data == null) return;
        Data.IsActive = value;
        await OnDataChanged.InvokeAsync(Data);
    }

    private async Task UpdateIsFeatured(bool value)
    {
        if (Data == null) return;
        Data.IsFeatured = value;
        await OnDataChanged.InvokeAsync(Data);
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        if (OnThumbnailUploaded.HasDelegate)
        {
            await OnThumbnailUploaded.InvokeAsync(e);
        }

        // Create preview
        if (e.File != null)
        {
            try
            {
                var buffer = new byte[e.File.Size];
                await e.File.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024).ReadAsync(buffer);
                thumbnailPreview = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(buffer)}";

                // Show success message
                await ShowToast("success", "Image uploaded successfully!");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error creating thumbnail preview: {ex.Message}");
                await ShowToast("error", "Failed to upload image. Please try again.");
            }
        }
    }

    private async Task TriggerFileUpload()
    {
        try
        {
            await JS.InvokeVoidAsync("triggerFileUpload", "mobile-thumbnail-input");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error triggering file upload: {ex.Message}");
            await ShowToast("error", "Failed to open file dialog. Please try again.");
        }
    }

    private void ClearNewThumbnail()
    {
        thumbnailPreview = null;
    }

    private async Task RemoveThumbnail()
    {
        try
        {
            if (OnThumbnailRemoved.HasDelegate)
            {
                await OnThumbnailRemoved.InvokeAsync();
            }
            thumbnailPreview = null;
            Data!.ThumbnailUrl = null;
            await ShowToast("success", "Thumbnail removed successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing thumbnail: {ex.Message}");
            await ShowToast("error", "Failed to remove thumbnail.");
        }
    }

    private async Task Cancel()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }

    private async Task Save()
    {
        if (OnSave.HasDelegate)
        {
            await OnSave.InvokeAsync();
        }
    }

    private async Task ShowToast(string type, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", type, message);
        }
        catch
        {
            // Fallback to console if toast fails
            Console.WriteLine($"{type.ToUpper()}: {message}");
        }
    }
}