@page "/specialization/{SpecializationId:int}"


<PageTitle>@(specialization?.Title ?? "Specialization Details")</PageTitle>

<div class="content-details specialization-details">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading specialization details...</p>
        </div>
    }
    else if (specialization == null)
    {
        <div class="alert alert-danger m-3">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Specialization not found
        </div>
    }
    else
    {
        <!-- Mobile View (d-block d-md-none) -->
        <div class="d-block d-md-none">
            <!-- Mobile Header with Back Button -->
            <div class="mobile-header bg-white border-bottom sticky-top">
                <div class="d-flex align-items-center p-3">
                    <button class="btn btn-link text-dark p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <h6 class="mb-0 flex-grow-1 text-truncate">@specialization.Title</h6>
                    <button class="btn btn-link text-dark p-0" @onclick="ShareSpecialization">
                        <i class="fas fa-share-alt fa-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Content -->
            <div class="mobile-content pb-5">
                <!-- Thumbnail Image (Mobile) -->
                @if (!string.IsNullOrEmpty(specialization.ThumbnailUrl))
                {
                    <div class="mobile-thumbnail">
                        <img src="@GetImageUrl(specialization.ThumbnailUrl)"
                             class="img-fluid w-100"
                             alt="@specialization.Title"
                             style="height: 200px; object-fit: cover;"
                             onerror="this.onerror=null;this.src='https://placehold.co/600x200?text=Specialization';" />
                    </div>
                }

                <!-- Mobile Info Section -->
                <div class="p-3">
                    <!-- Title and Badges -->
                    <div class="mb-3">
                        <h1 class="h4 mb-2">@specialization.Title</h1>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <span class="badge bg-primary">Specialization</span>
                            @if (specialization.IsFeatured)
                            {
                                <span class="badge bg-warning">
                                    <i class="fas fa-star me-1"></i> Featured
                                </span>
                            }
                            @if (isEnrolled)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle me-1"></i> Enrolled
                                </span>
                            }
                        </div>
                        <div class="small text-muted">
                            <i class="fas fa-user-md me-1"></i> By @specialization.Doctor?.FirstName @specialization.Doctor?.LastName
                        </div>
                    </div>

                    <!-- Mobile Price Card -->
                    <div class="mobile-price-card bg-light rounded p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="h4 mb-0 text-primary">$@specialization.Price.ToString("N2")</span>
                                @if (specialization.Price == 0)
                                {
                                    <span class="badge bg-success ms-2">FREE</span>
                                }
                            </div>
                            @if (isEnrolled)
                            {
                                <button class="btn btn-success" @onclick="ContinueLearning">
                                    <i class="fas fa-play me-1"></i> Continue
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-primary" @onclick="HandleEnrollment">
                                    @(specialization.Price == 0 ? "Enroll Free" : "Enroll Now")
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Mobile Stats Row -->
                    <div class="row g-2 mb-3">
                        <div class="col-3">
                            <div class="mobile-stat-card text-center p-2 bg-light rounded">
                                <div class="small fw-bold">@specialization.Courses?.Count</div>
                                <small class="text-muted">Courses</small>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="mobile-stat-card text-center p-2 bg-light rounded">
                                <div class="small fw-bold">@specialization.EstimatedDurationHours</div>
                                <small class="text-muted">Hours</small>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="mobile-stat-card text-center p-2 bg-light rounded">
                                <div class="small fw-bold">@specialization.AverageRating.ToString("0.0")</div>
                                <small class="text-muted">Rating</small>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="mobile-stat-card text-center p-2 bg-light rounded">
                                <div class="small fw-bold">@specialization.TotalEnrollments</div>
                                <small class="text-muted">Students</small>
                            </div>
                        </div>
                    </div>

                    <!-- Mobile Description -->
                    <div class="mobile-section mb-3">
                        <h6 class="fw-bold mb-2">
                            <i class="fas fa-info-circle me-2 text-primary"></i>Description
                        </h6>
                        <p class="small mb-0">@specialization.Description</p>
                    </div>

                    <!-- Mobile Prerequisites -->
                    @if (!string.IsNullOrEmpty(specialization.Prerequisites))
                    {
                        <div class="mobile-section mb-3">
                            <h6 class="fw-bold mb-2">
                                <i class="fas fa-graduation-cap me-2 text-primary"></i>Prerequisites
                            </h6>
                            <p class="small mb-0 bg-light p-2 rounded">@specialization.Prerequisites</p>
                        </div>
                    }

                    <!-- Mobile Curriculum Accordion -->
                    <div class="mobile-section mb-3">
                        <h6 class="fw-bold mb-2">
                            <i class="fas fa-book me-2 text-primary"></i>Curriculum
                            <span class="badge bg-secondary ms-2">@specialization.Courses?.Count courses</span>
                        </h6>

                        @if (specialization.Courses != null && specialization.Courses.Any())
                        {
                            <div class="accordion accordion-flush" id="curriculumAccordion">
                                @foreach (var course in specialization.Courses.OrderBy(c => c.Order))
                                {
                                    <div class="accordion-item border mb-2 rounded">
                                        <h2 class="accordion-header" id="heading@(course.Id)">
                                            <button class="accordion-button collapsed p-3" type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#collapse@(course.Id)">
                                                <div class="d-flex w-100 align-items-center">
                                                    <span class="badge bg-primary me-2">@course.Order</span>
                                                    <div class="flex-grow-1">
                                                        <div class="fw-bold small">@course.Title</div>
                                                        <div class="small text-muted">
                                                            <i class="fas fa-video me-1"></i> @course.Lectures?.Count lectures
                                                        </div>
                                                    </div>
                                                    <i class="fas fa-chevron-down"></i>
                                                </div>
                                            </button>
                                        </h2>
                                        <div id="collapse@(course.Id)" class="accordion-collapse collapse"
                                             data-bs-parent="#curriculumAccordion">
                                            <div class="accordion-body p-3 bg-light">
                                                <p class="small mb-2">@course.Description</p>
                                                <button class="btn btn-outline-primary btn-sm w-100"
                                                        @onclick="() => ViewCourse(course.Id)">
                                                    View Course Details
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small text-center py-3">No courses available yet</p>
                        }
                    </div>

                    <!-- Mobile Instructor -->
                    @if (specialization.Doctor != null)
                    {
                        <div class="mobile-section mb-3">
                            <h6 class="fw-bold mb-2">
                                <i class="fas fa-user-md me-2 text-primary"></i>Instructor
                            </h6>
                            <div class="d-flex align-items-center bg-light p-2 rounded">
                                <div class="mobile-instructor-avatar me-2">
                                    @if (!string.IsNullOrEmpty(specialization.Doctor.ProfileImageUrl))
                                    {
                                        <img src="@GetImageUrl(specialization.Doctor.ProfileImageUrl)"
                                             class="rounded-circle"
                                             alt="Instructor"
                                             style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="avatar-placeholder-small rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                             style="width: 40px; height: 40px;">
                                            @GetInitials(specialization.Doctor.FirstName, specialization.Doctor.LastName)
                                        </div>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold small">@specialization.Doctor.FirstName @specialization.Doctor.LastName</div>
                                    @if (specialization.Doctor.Profile != null)
                                    {
                                        <div class="small text-muted">@specialization.Doctor.Profile.Title</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Mobile Action Footer -->
                    @if (!isEnrolled)
                    {
                        <div class="mobile-action-footer fixed-bottom bg-white border-top p-3">
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-primary flex-fill" @onclick="AddToWishlist">
                                    <i class="fas fa-heart me-1"></i> Wishlist
                                </button>
                                <button class="btn btn-primary flex-fill" @onclick="HandleEnrollment">
                                    @(specialization.Price == 0 ? "Enroll Free" : "Enroll Now")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Desktop View (d-none d-md-block) - Original Layout -->
        <div class="d-none d-md-block">
            <div class="container-fluid">
                <!-- Breadcrumb Navigation -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/browse">Browse</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="/specializations">Specializations</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            @specialization.Title
                            @if (isEnrolled)
                            {
                                <span class="badge bg-success ms-2">Enrolled</span>
                            }
                        </li>
                    </ol>
                </nav>

                <div class="mb-4">
                    <button class="btn btn-outline-secondary" @onclick="GoBack">
                        <i class="fas fa-arrow-left me-2"></i> Back to Specializations
                    </button>
                </div>

                <div class="row">
                    <!-- Main Content Column -->
                    <div class="col-lg-8">
                        <!-- Header Card -->
                        <div class="card content-header-card mb-4">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h1 class="content-title mb-2">@specialization.Title</h1>
                                        <div class="content-meta mb-3">
                                            <span class="content-type-badge badge bg-primary">Specialization</span>
                                            @if (specialization.IsFeatured)
                                            {
                                                <span class="badge bg-warning ms-2">
                                                    <i class="fas fa-star me-1"></i> Featured
                                                </span>
                                            }
                                            @if (isEnrolled)
                                            {
                                                <span class="badge bg-success ms-2">
                                                    <i class="fas fa-check-circle me-1"></i> Enrolled
                                                </span>
                                            }
                                        </div>
                                        <div class="content-instructor">
                                            <i class="fas fa-user-md me-2"></i>
                                            By @specialization.Doctor?.FirstName @specialization.Doctor?.LastName
                                        </div>
                                    </div>
                                    <div class="content-price">
                                        <div class="price-amount">$@specialization.Price.ToString("N2")</div>
                                        @if (specialization.Price == 0)
                                        {
                                            <div class="price-badge badge bg-success">FREE</div>
                                        }
                                    </div>
                                </div>

                                <!-- Thumbnail Image -->
                                @if (!string.IsNullOrEmpty(specialization.ThumbnailUrl))
                                {
                                    <div class="content-thumbnail mb-4">
                                        <img src="@GetImageUrl(specialization.ThumbnailUrl)"
                                             class="img-fluid rounded"
                                             alt="@specialization.Title"
                                             onerror="this.onerror=null;this.src='https://placehold.co/1200x400?text=Specialization';" />
                                    </div>
                                }

                                <!-- Description -->
                                <div class="content-description mb-4">
                                    <h4 class="section-title">
                                        <i class="fas fa-info-circle me-2"></i>Description
                                    </h4>
                                    <p>@specialization.Description</p>
                                </div>

                                <!-- Stats Row -->
                                <div class="row stats-row mb-4">
                                    <div class="col-md-3 col-6">
                                        <div class="stat-card">
                                            <div class="stat-icon">
                                                <i class="fas fa-book"></i>
                                            </div>
                                            <div class="stat-value">@specialization.Courses?.Count</div>
                                            <div class="stat-label">Courses</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <div class="stat-card">
                                            <div class="stat-icon">
                                                <i class="fas fa-clock"></i>
                                            </div>
                                            <div class="stat-value">@specialization.EstimatedDurationHours</div>
                                            <div class="stat-label">Hours</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <div class="stat-card">
                                            <div class="stat-icon">
                                                <i class="fas fa-star"></i>
                                            </div>
                                            <div class="stat-value">@specialization.AverageRating.ToString("0.0")</div>
                                            <div class="stat-label">Rating</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <div class="stat-card">
                                            <div class="stat-icon">
                                                <i class="fas fa-users"></i>
                                            </div>
                                            <div class="stat-value">@specialization.TotalEnrollments</div>
                                            <div class="stat-label">Enrollments</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Prerequisites -->
                                @if (!string.IsNullOrEmpty(specialization.Prerequisites))
                                {
                                    <div class="content-section mb-4">
                                        <h4 class="section-title">
                                            <i class="fas fa-graduation-cap me-2"></i>Prerequisites
                                        </h4>
                                        <div class="card">
                                            <div class="card-body">
                                                <p class="mb-0">@specialization.Prerequisites</p>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Instructor -->
                                @if (specialization.Doctor != null)
                                {
                                    <div class="content-section mb-4">
                                        <h4 class="section-title">
                                            <i class="fas fa-user-md me-2"></i>About the Instructor
                                        </h4>
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="d-flex align-items-center">
                                                    <div class="instructor-avatar me-3">
                                                        @if (!string.IsNullOrEmpty(specialization.Doctor.ProfileImageUrl))
                                                        {
                                                            <img src="@GetImageUrl(specialization.Doctor.ProfileImageUrl)"
                                                                 class="rounded-circle"
                                                                 alt="Instructor"
                                                                 onerror="this.onerror=null;this.src='https://placehold.co/80x80?text=DR';" />
                                                        }
                                                        else
                                                        {
                                                            <div class="avatar-placeholder">
                                                                @GetInitials(specialization.Doctor.FirstName, specialization.Doctor.LastName)
                                                            </div>
                                                        }
                                                    </div>
                                                    <div>
                                                        <h5 class="mb-1">@specialization.Doctor.FirstName @specialization.Doctor.LastName</h5>
                                                        @if (specialization.Doctor.Profile != null)
                                                        {
                                                            <p class="text-muted mb-1">@specialization.Doctor.Profile.Title</p>
                                                        }
                                                        @if (!string.IsNullOrEmpty(specialization.Doctor.Bio))
                                                        {
                                                            <p class="mb-0">@specialization.Doctor.Bio</p>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Curriculum Section -->
                        <div class="card content-section-card mb-4">
                            <div class="card-header">
                                <h4 class="mb-0">
                                    <i class="fas fa-book me-2"></i>Curriculum
                                </h4>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-info mb-3">
                                    <i class="fas fa-info-circle me-2"></i>
                                    This specialization contains @specialization.Courses?.Count courses with a total of @GetTotalLectureCount() lectures.
                                </div>

                                @if (specialization.Courses != null && specialization.Courses.Any())
                                {
                                    <div class="courses-list">
                                        @foreach (var course in specialization.Courses.OrderBy(c => c.Order))
                                        {
                                            <div class="course-item card mb-3">
                                                <div class="card-body">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div class="flex-grow-1">
                                                            <div class="d-flex align-items-center mb-2">
                                                                <div class="course-number me-3">
                                                                    @course.Order
                                                                </div>
                                                                <div>
                                                                    <h5 class="mb-0">
                                                                        <a href="/course/@course.Id" class="text-decoration-none">
                                                                            @course.Title
                                                                        </a>
                                                                    </h5>
                                                                    <div class="course-meta">
                                                                        <i class="fas fa-video"></i> @course.Lectures?.Count lectures
                                                                        <i class="fas fa-clock ms-2"></i> @GetCourseDuration(course) hours
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <p>@course.Description</p>
                                                        </div>
                                                        <div class="course-actions">
                                                            <button class="btn btn-outline-primary btn-sm"
                                                                    @onclick="() => ViewCourse(course.Id)">
                                                                View Course
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <i class="fas fa-book fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">No courses available yet</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Sidebar Column (Desktop) -->
                    <div class="col-lg-4">
                        <!-- Enrollment Card -->
                        <div class="card enrollment-card mb-4">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">Enrollment Options</h5>
                            </div>
                            <div class="card-body">
                                <!-- Price Display -->
                                <div class="text-center mb-4">
                                    <div class="price-display">$@specialization.Price.ToString("N2")</div>
                                    @if (specialization.Price == 0)
                                    {
                                        <span class="badge bg-success">FREE SPECIALIZATION</span>
                                    }
                                    else
                                    {
                                        <small class="text-muted">One-time payment</small>
                                    }
                                </div>

                                <!-- Features List -->
                                <div class="features-list mb-4">
                                    <h6><i class="fas fa-gift me-2"></i>What's Included</h6>
                                    <ul>
                                        <li><i class="fas fa-check text-success me-2"></i>@specialization.Courses?.Count courses</li>
                                        <li><i class="fas fa-check text-success me-2"></i>@GetTotalLectureCount() lectures</li>
                                        <li><i class="fas fa-check text-success me-2"></i>Certificate of completion</li>
                                        <li><i class="fas fa-check text-success me-2"></i>Lifetime access</li>
                                    </ul>
                                </div>

                                <!-- Action Buttons -->
                                <div class="action-buttons mb-4">
                                    @if (isEnrolled)
                                    {
                                        <button class="btn btn-success w-100 mb-2" @onclick="ContinueLearning">
                                            <i class="fas fa-play me-2"></i> Continue Learning
                                        </button>
                                    }
                                    else
                                    {
                                        @if (specialization.Price == 0)
                                        {
                                            <button class="btn btn-success w-100 mb-2" @onclick="EnrollFree">
                                                <i class="fas fa-graduation-cap me-2"></i> Enroll for Free
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-primary w-100 mb-2" @onclick="EnrollNow">
                                                <i class="fas fa-shopping-cart me-2"></i> Enroll Now
                                            </button>
                                        }
                                        <button class="btn btn-outline-primary w-100" @onclick="AddToWishlist">
                                            <i class="fas fa-heart me-2"></i> Add to Wishlist
                                        </button>
                                    }
                                </div>

                                <!-- Share Section -->
                                <div class="share-section border-top pt-3">
                                    <h6><i class="fas fa-share-alt me-2"></i>Share</h6>
                                    <div class="d-flex justify-content-center gap-2">
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => ShareOnFacebook()">
                                            <i class="fab fa-facebook-f"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => ShareOnTwitter()">
                                            <i class="fab fa-twitter"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => ShareOnLinkedIn()">
                                            <i class="fab fa-linkedin-in"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Progress Card (if enrolled) -->
                        @if (isEnrolled)
                        {
                            <div class="card progress-card">
                                <div class="card-header">
                                    <h6 class="mb-0">Your Progress</h6>
                                </div>
                                <div class="card-body">
                                    <div class="progress-circle mx-auto mb-3">
                                        <div class="progress-value">@CalculateProgress()%</div>
                                        <small class="text-muted">Complete</small>
                                    </div>
                                    <p class="text-center mb-0">@GetCompletedCourses() of @specialization.Courses?.Count courses completed</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int SpecializationId { get; set; }

    private SpecializationDto? specialization;
    private bool isLoading = true;
    private bool isEnrolled = false;
    private bool isAuthenticated = false;
    private UserDto? currentUser;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
        await LoadData();
    }

    private async Task CheckAuthentication()
    {
        isAuthenticated = await TokenService.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
            currentUser = await AuthService.GetCurrentUserAsync();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            specialization = await SpecializationService.GetSpecializationAsync(SpecializationId);
            if (isAuthenticated && specialization != null)
            {
                await CheckEnrollmentStatus();
            }
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CheckEnrollmentStatus()
    {
        var enrollments = await EnrollmentService.GetMyEnrollmentsAsync();
        isEnrolled = enrollments?.Any(e => e.SpecializationId == SpecializationId) ?? false;
    }

    // Helper methods
    private string GetImageUrl(string? url) => ImageUrlService.GetImageUrl(url);

    private string GetInitials(string firstName, string lastName)
    {
        var first = !string.IsNullOrEmpty(firstName) ? firstName[0] : 'U';
        var last = !string.IsNullOrEmpty(lastName) ? lastName[0] : 'S';
        return $"{first}{last}";
    }

    private int GetTotalLectureCount()
    {
        return specialization?.Courses?.Sum(c => c.Lectures?.Count ?? 0) ?? 0;
    }

    private string GetCourseDuration(CourseDto course)
    {
        var minutes = course.Lectures?.Sum(l => l.EstimatedDurationMinutes) ?? 0;
        return (minutes / 60.0).ToString("0.0");
    }

    private int CalculateProgress() => 0; // Implement based on your logic
    private int GetCompletedCourses() => 0; // Implement based on your logic

    private void GoBack()
    {
        Navigation.NavigateTo("/specializations");
    }

    // Action methods
    private void ContinueLearning()
    {
        Navigation.NavigateTo($"/student/mylearning/specialization/{SpecializationId}");
    }

    private void EnrollNow()
    {
        if (!isAuthenticated)
        {
            Navigation.NavigateTo($"/account/login?returnUrl=/specialization/{SpecializationId}");
            return;
        }
        Navigation.NavigateTo($"/student/payments/make?type=Specialization&id={SpecializationId}");
    }

    private async Task EnrollFree()
    {
        if (!isAuthenticated)
        {
            Navigation.NavigateTo($"/account/login?returnUrl=/specialization/{SpecializationId}");
            return;
        }
        try
        {
            var enrollment = await EnrollmentService.CreateEnrollmentAsync(new CreateEnrollmentDto
            {
                EnrollmentType = EnrollmentType.Specialization,
                SpecializationId = SpecializationId
            });

            if (enrollment != null)
            {
                await ShowToast("success", "Successfully enrolled!");
                isEnrolled = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Enrollment failed: {ex.Message}");
        }
    }

    private async Task AddToWishlist()
    {
        await ShowToast("info", "Added to wishlist!");
    }

    private void ViewCourse(int courseId)
    {
        Navigation.NavigateTo($"/course/{courseId}");
    }

    // Share methods
    private void ShareSpecialization()
    {
        // Implement share functionality for mobile
        var url = Navigation.Uri;
        JS.InvokeVoidAsync("navigator.share", new { title = specialization?.Title, url = url });
    }

    private void ShareOnFacebook()
    {
        var url = $"https://www.facebook.com/sharer/sharer.php?u={Uri.EscapeDataString(Navigation.Uri)}";
        Navigation.NavigateTo(url, true);
    }

    private void ShareOnTwitter()
    {
        var text = $"Check out this specialization: {specialization?.Title}";
        var url = $"https://twitter.com/intent/tweet?text={Uri.EscapeDataString(text)}&url={Uri.EscapeDataString(Navigation.Uri)}";
        Navigation.NavigateTo(url, true);
    }

    private void ShareOnLinkedIn()
    {
        var url = $"https://www.linkedin.com/sharing/share-offsite/?url={Uri.EscapeDataString(Navigation.Uri)}";
        Navigation.NavigateTo(url, true);
    }

    private async Task ShowToast(string type, string message)
    {
        await JS.InvokeVoidAsync("showToast", type, message);
    }

    private async Task HandleEnrollment()
    {
        if (specialization?.Price == 0)
        {
            await EnrollFree();
        }
        else
        {
            EnrollNow(); // or await EnrollNow() if you make it async
        }
    }
}

