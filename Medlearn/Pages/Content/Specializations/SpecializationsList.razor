@code {
    // ... (keep all your existing code in the @code block exactly as is)
    private List<SpecializationDto> allSpecializations = new();
    private List<SpecializationDto> featuredSpecializations = new();
    private List<SpecializationDto> filteredSpecializations = new();
    private List<SpecializationDto> paginatedSpecializations = new();
    private string searchTerm = "";
    private string sortBy = "popular";
    private string priceRange = "all";
    private string durationFilter = "all";
    private bool featuredOnly = false;
    private bool IsSearching => !string.IsNullOrEmpty(searchTerm);
    private int currentPage = 1;
    private const int pageSize = 12;
    private int totalPages = 1;
    private bool isLoading = true;
    private bool isInitialLoad = true;

    // Mobile-specific properties
    private bool showMobileSearch = false;
    private bool showMobileFilters = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSpecializations();
        isInitialLoad = false;
    }

    private async Task LoadSpecializations()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Calculate min and max price from priceRange
            decimal? minPrice = null;
            decimal? maxPrice = null;

            switch (priceRange)
            {
                case "free":
                    minPrice = 0;
                    maxPrice = 0;
                    break;
                case "under-50":
                    minPrice = 0.01m;
                    maxPrice = 49.99m;
                    break;
                case "50-100":
                    minPrice = 50m;
                    maxPrice = 100m;
                    break;
                case "100-200":
                    minPrice = 100m;
                    maxPrice = 200m;
                    break;
                case "200-plus":
                    minPrice = 200m;
                    maxPrice = null;
                    break;
            }

            // Get all specializations using the service method
            var result = await SpecializationService.GetSpecializationsAsync(
                search: !string.IsNullOrEmpty(searchTerm) ? searchTerm : null,
                featured: featuredOnly ? true : null,
                doctorId: null,
                minPrice: minPrice,
                maxPrice: maxPrice,
                page: currentPage,
                pageSize: pageSize
            );

            if (result != null)
            {
                // Filter for active specializations only
                allSpecializations = result.Where(s => s.IsActive).ToList();
            }
            else
            {
                allSpecializations = new List<SpecializationDto>();
            }

            // Get featured specializations separately if not searching
            if (!IsSearching && !featuredOnly)
            {
                var featuredResult = await SpecializationService.GetSpecializationsAsync(
                    search: null,
                    featured: true,
                    doctorId: null,
                    minPrice: null,
                    maxPrice: null,
                    page: 1,
                    pageSize: 6
                );

                if (featuredResult != null)
                {
                    // Filter for active featured specializations only
                    featuredSpecializations = featuredResult.Where(s => s.IsActive).ToList();
                }
                else
                {
                    featuredSpecializations = new List<SpecializationDto>();
                }
            }
            else
            {
                featuredSpecializations.Clear();
            }

            // Apply local sorting and filtering
            ApplySortingAndFiltering();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", "Error loading specializations:", ex.Message);
            await ShowToast("error", "Failed to load specializations. Please try again.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplySortingAndFiltering()
    {
        // Start with all specializations
        filteredSpecializations = new List<SpecializationDto>(allSpecializations);

        // Apply duration filter locally
        if (durationFilter != "all")
        {
            filteredSpecializations = durationFilter switch
            {
                "short" => filteredSpecializations.Where(s => s.EstimatedDurationHours >= 1 && s.EstimatedDurationHours <= 10).ToList(),
                "medium" => filteredSpecializations.Where(s => s.EstimatedDurationHours > 10 && s.EstimatedDurationHours <= 30).ToList(),
                "long" => filteredSpecializations.Where(s => s.EstimatedDurationHours > 30).ToList(),
                _ => filteredSpecializations
            };
        }

        // Apply sorting
        filteredSpecializations = sortBy switch
        {
            "rating" => filteredSpecializations.OrderByDescending(s => s.AverageRating).ToList(),
            "newest" => filteredSpecializations.OrderByDescending(s => s.CreatedAt).ToList(),
            "price-low" => filteredSpecializations.OrderBy(s => s.Price).ToList(),
            "price-high" => filteredSpecializations.OrderByDescending(s => s.Price).ToList(),
            _ => filteredSpecializations.OrderByDescending(s => s.TotalEnrollments).ToList() // popular
        };

        // Calculate pagination
        totalPages = (int)Math.Ceiling((double)filteredSpecializations.Count / pageSize);

        // Apply pagination
        var startIndex = (currentPage - 1) * pageSize;
        paginatedSpecializations = filteredSpecializations
            .Skip(startIndex)
            .Take(pageSize)
            .ToList();
    }

    private async Task ApplyFilters()
    {
        if (!isInitialLoad)
        {
            currentPage = 1;
            await LoadSpecializations();
        }
    }

    private async Task SearchSpecializations()
    {
        currentPage = 1;
        showMobileSearch = false; // Auto-close mobile search after search
        await LoadSpecializations();
    }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            // Since we're doing local filtering, we don't need to reload from server
            // Just recalculate pagination
            ApplySortingAndFiltering();
            // Scroll to top of results
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
    }

    private async Task ClearFilters()
    {
        searchTerm = "";
        sortBy = "popular";
        priceRange = "all";
        durationFilter = "all";
        featuredOnly = false;
        currentPage = 1;
        showMobileFilters = false;
        await LoadSpecializations();
    }

    private void ClearSearch()
    {
        searchTerm = "";
        currentPage = 1;
        LoadSpecializations();
    }

    private void ResetPriceRange()
    {
        priceRange = "all";
        currentPage = 1;
        LoadSpecializations();
    }

    private void ResetDuration()
    {
        durationFilter = "all";
        currentPage = 1;
        LoadSpecializations();
    }

    private void ToggleFeaturedOnly()
    {
        featuredOnly = !featuredOnly;
        currentPage = 1;
        LoadSpecializations();
    }

    private void ToggleMobileSearch()
    {
        showMobileSearch = !showMobileSearch;
        if (showMobileFilters) showMobileFilters = false;
    }

    private void ToggleMobileFilters()
    {
        showMobileFilters = !showMobileFilters;
        if (showMobileSearch) showMobileSearch = false;
    }

    private void SetMobileSort(string sort)
    {
        sortBy = sort;
        ApplyMobileFilters();
    }

    private void SetMobileDuration(string duration)
    {
        durationFilter = duration;
        ApplyMobileFilters();
    }

    private async Task ApplyMobileFilters()
    {
        showMobileFilters = false;
        currentPage = 1;
        await LoadSpecializations();
    }

    private string GetPriceRangeText()
    {
        return priceRange switch
        {
            "free" => "Free",
            "under-50" => "Under $50",
            "50-100" => "$50 - $100",
            "100-200" => "$100 - $200",
            "200-plus" => "$200+",
            _ => "All Prices"
        };
    }

    private string GetDurationText()
    {
        return durationFilter switch
        {
            "short" => "Short",
            "medium" => "Medium",
            "long" => "Long",
            _ => "Any Duration"
        };
    }

    private void ViewSpecialization(int specializationId)
    {
        Navigation.NavigateTo($"/specialization/{specializationId}");
    }

    private void EnrollSpecialization(SpecializationDto specialization)
    {
        Navigation.NavigateTo($"/student/payments/make?type=Specialization&id={specialization.Id}");
    }

    private async Task EnrollFreeSpecialization(SpecializationDto specialization)
    {
        try
        {
            // For free specializations, create enrollment directly
            await ShowToast("info", "Enrolling in free specialization...");

            // Create enrollment using EnrollmentService
            var enrollmentDto = new CreateEnrollmentDto
            {
                EnrollmentType = EnrollmentType.Specialization,
                SpecializationId = specialization.Id
            };

            var enrollment = await EnrollmentService.CreateEnrollmentAsync(enrollmentDto);

            if (enrollment != null)
            {
                await ShowToast("success", "Successfully enrolled in free specialization!");
                // Navigate to the specialization learning page
                Navigation.NavigateTo($"/student/mylearning/specialization/{specialization.Id}");
            }
            else
            {
                await ShowToast("error", "Failed to enroll. Please try again.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", "Enrollment error:", ex.Message);
            await ShowToast("error", "Failed to enroll. Please try again.");
        }
    }

    // Helper method to get specialization image URL using ImageUrlService
    private string GetSpecializationImageUrl(string? thumbnailUrl)
    {
        return ImageUrlService.GetImageUrl(thumbnailUrl);
    }

    // Helper method to get doctor image URL using ImageUrlService
    private string GetDoctorImageUrl(string? profileImageUrl)
    {
        return ImageUrlService.GetImageUrl(profileImageUrl);
    }

    // Helper method to get doctor initials for placeholder
    private string GetDoctorInitials(object doctor)
    {
        if (doctor == null) return "DR";

        try
        {
            // Using reflection to access properties since we don't know the exact type
            var firstNameProp = doctor.GetType().GetProperty("FirstName");
            var lastNameProp = doctor.GetType().GetProperty("LastName");

            var firstName = firstNameProp?.GetValue(doctor) as string;
            var lastName = lastNameProp?.GetValue(doctor) as string;

            var firstInitial = !string.IsNullOrEmpty(firstName) ? firstName[0] : 'D';
            var lastInitial = !string.IsNullOrEmpty(lastName) ? lastName[0] : 'R';

            return $"{firstInitial}{lastInitial}";
        }
        catch
        {
            return "DR";
        }
    }

    private async Task ShowToast(string type, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", type, message);
        }
        catch
        {
            // Fallback if toast function is not available
            await JS.InvokeVoidAsync("alert", message);
        }
    }
}
