@page "/specializations"


<PageTitle>Browse Specializations</PageTitle>

<div class="browse-specializations">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <h5 class="mb-0 flex-grow-1">Browse Specializations</h5>
                    <button class="btn btn-link text-white p-0" @onclick="ToggleMobileSearch">
                        <i class="fas fa-search fa-lg"></i>
                    </button>
                    <button class="btn btn-link text-white p-0 ms-3" @onclick="ToggleMobileFilters">
                        <i class="fas fa-sliders-h fa-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Search Bar (Expandable) -->
            @if (showMobileSearch)
            {
                <div class="p-3 bg-light border-bottom">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Search specializations..."
                               @bind="searchTerm" @bind:event="oninput"
                               @onkeypress="@(async (e) => { if (e.Key == "Enter") await SearchSpecializations(); })" />
                        <button class="btn btn-primary" @onclick="SearchSpecializations">
                            <i class="fas fa-search"></i>
                        </button>
                        @if (!string.IsNullOrEmpty(searchTerm))
                        {
                            <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                                <i class="fas fa-times"></i>
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Mobile Filters Drawer -->
            @if (showMobileFilters)
            {
                <div class="mobile-filters-overlay" @onclick="ToggleMobileFilters"></div>
                <div class="mobile-filters-drawer">
                    <div class="p-3 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">Filters</h6>
                            <button class="btn btn-link text-danger p-0" @onclick="ClearFilters">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>

                        <!-- Sort By (Mobile) -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Sort By</label>
                            <div class="btn-group w-100" role="group">
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm @(sortBy == "popular" ? "active" : "")"
                                        @onclick="@(() => SetMobileSort("popular"))">
                                    <i class="fas fa-fire me-1"></i> Popular
                                </button>
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm @(sortBy == "rating" ? "active" : "")"
                                        @onclick="@(() => SetMobileSort("rating"))">
                                    <i class="fas fa-star me-1"></i> Rating
                                </button>
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm @(sortBy == "newest" ? "active" : "")"
                                        @onclick="@(() => SetMobileSort("newest"))">
                                    <i class="fas fa-clock me-1"></i> New
                                </button>
                            </div>
                            <div class="btn-group w-100 mt-2" role="group">
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm @(sortBy == "price-low" ? "active" : "")"
                                        @onclick="@(() => SetMobileSort("price-low"))">
                                    <i class="fas fa-arrow-up me-1"></i> Price: Low
                                </button>
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm @(sortBy == "price-high" ? "active" : "")"
                                        @onclick="@(() => SetMobileSort("price-high"))">
                                    <i class="fas fa-arrow-down me-1"></i> Price: High
                                </button>
                            </div>
                        </div>

                        <!-- Price Range (Mobile) -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Price Range</label>
                            <select class="form-select form-select-sm" @bind="priceRange" @bind:after="ApplyMobileFilters">
                                <option value="all">All Prices</option>
                                <option value="free">Free Only</option>
                                <option value="under-50">Under $50</option>
                                <option value="50-100">$50 - $100</option>
                                <option value="100-200">$100 - $200</option>
                                <option value="200-plus">$200+</option>
                            </select>
                        </div>

                        <!-- Duration (Mobile) -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Duration</label>
                            <div class="btn-group w-100" role="group">
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm @(durationFilter == "all" ? "active" : "")"
                                        @onclick="@(() => SetMobileDuration("all"))">
                                    All
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm @(durationFilter == "short" ? "active" : "")"
                                        @onclick="@(() => SetMobileDuration("short"))">
                                    Short
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm @(durationFilter == "medium" ? "active" : "")"
                                        @onclick="@(() => SetMobileDuration("medium"))">
                                    Medium
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm @(durationFilter == "long" ? "active" : "")"
                                        @onclick="@(() => SetMobileDuration("long"))">
                                    Long
                                </button>
                            </div>
                        </div>

                        <!-- Featured Only (Mobile) -->
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="mobileFeaturedOnly"
                                       @bind="featuredOnly" @bind:after="ApplyMobileFilters" />
                                <label class="form-check-label small" for="mobileFeaturedOnly">
                                    Show Featured Only
                                </label>
                            </div>
                        </div>

                        <!-- Apply Filters Button (Mobile) -->
                        <div class="d-grid mt-4">
                            <button class="btn btn-primary" @onclick="ToggleMobileFilters">
                                <i class="fas fa-check me-2"></i> Apply Filters
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-block">
            <div class="row mb-4">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1>Browse Specializations</h1>
                            <p class="text-muted mb-0">Explore comprehensive learning paths</p>
                        </div>
                        <div class="search-box" style="width: 350px;">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Search specializations..."
                                       @bind="searchTerm" @bind:event="oninput"
                                       @onkeypress="@(async (e) => { if (e.Key == "Enter") await SearchSpecializations(); })" />
                                <button class="btn btn-primary" @onclick="SearchSpecializations">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Desktop Filters -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label">Sort By</label>
                                    <select class="form-select" @bind="sortBy" @bind:after="ApplyFilters">
                                        <option value="popular">Most Popular</option>
                                        <option value="rating">Highest Rated</option>
                                        <option value="newest">Newest</option>
                                        <option value="price-low">Price: Low to High</option>
                                        <option value="price-high">Price: High to Low</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Price Range</label>
                                    <select class="form-select" @bind="priceRange" @bind:after="ApplyFilters">
                                        <option value="all">All Prices</option>
                                        <option value="free">Free Only</option>
                                        <option value="under-50">Under $50</option>
                                        <option value="50-100">$50 - $100</option>
                                        <option value="100-200">$100 - $200</option>
                                        <option value="200-plus">$200+</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Duration</label>
                                    <select class="form-select" @bind="durationFilter" @bind:after="ApplyFilters">
                                        <option value="all">Any Duration</option>
                                        <option value="short">Short (1-10 hours)</option>
                                        <option value="medium">Medium (10-30 hours)</option>
                                        <option value="long">Long (30+ hours)</option>
                                    </select>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="featuredOnly"
                                               @bind="featuredOnly" @bind:after="ApplyFilters" />
                                        <label class="form-check-label" for="featuredOnly">
                                            Featured Only
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Filters Display (Mobile) -->
        <div class="d-block d-md-none px-3 py-2">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="small text-muted">Active filters:</span>
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <span class="badge bg-primary">
                        Search: @searchTerm
                        <i class="fas fa-times ms-1" @onclick="ClearSearch" style="cursor: pointer;"></i>
                    </span>
                }
                @if (priceRange != "all")
                {
                    <span class="badge bg-secondary">
                        @GetPriceRangeText()
                        <i class="fas fa-times ms-1" @onclick="ResetPriceRange" style="cursor: pointer;"></i>
                    </span>
                }
                @if (durationFilter != "all")
                {
                    <span class="badge bg-secondary">
                        @GetDurationText()
                        <i class="fas fa-times ms-1" @onclick="ResetDuration" style="cursor: pointer;"></i>
                    </span>
                }
                @if (featuredOnly)
                {
                    <span class="badge bg-warning">
                        Featured Only
                        <i class="fas fa-times ms-1" @onclick="ToggleFeaturedOnly" style="cursor: pointer;"></i>
                    </span>
                }
            </div>
        </div>

        <!-- Featured Section (Mobile Optimized) -->
        @if (featuredSpecializations.Any() && !IsSearching && !featuredOnly)
        {
            <div class="row mb-4 mb-md-5">
                <div class="col-12">
                    <h2 class="h5 h2-md mb-2 mb-md-3 px-3 px-md-0">Featured Specializations</h2>

                    <!-- Mobile Horizontal Scroll -->
                    <div class="d-block d-md-none">
                        <div class="featured-scroll-container">
                            <div class="featured-scroll-wrapper">
                                @foreach (var spec in featuredSpecializations.Take(5))
                                {
                                    <div class="featured-scroll-item">
                                        <div class="card h-100 shadow-sm" style="width: 280px;">
                                            <div class="position-relative">
                                                @if (!string.IsNullOrEmpty(spec.ThumbnailUrl))
                                                {
                                                    <img src="@GetSpecializationImageUrl(spec.ThumbnailUrl)"
                                                         class="card-img-top"
                                                         alt="@spec.Title"
                                                         style="height: 140px; object-fit: cover;"
                                                         onerror="this.onerror=null;this.src='https://placehold.co/400x140?text=@Uri.EscapeDataString(spec.Title)';" />
                                                }
                                                else
                                                {
                                                    <div class="card-img-top bg-gradient-primary d-flex align-items-center justify-content-center" style="height: 140px;">
                                                        <i class="fas fa-layer-group fa-2x text-white"></i>
                                                    </div>
                                                }
                                                <span class="position-absolute top-0 start-0 m-2 badge bg-warning" style="font-size: 10px;">
                                                    <i class="fas fa-star me-1"></i> Featured
                                                </span>
                                                @if (spec.Price == 0)
                                                {
                                                    <span class="position-absolute top-0 end-0 m-2 badge bg-success" style="font-size: 10px;">
                                                        FREE
                                                    </span>
                                                }
                                            </div>
                                            <div class="card-body p-2">
                                                <h6 class="card-title small fw-bold mb-1">@spec.Title</h6>
                                                <p class="card-text text-muted small mb-2">
                                                    @(spec.Description.Length > 60 ? spec.Description.Substring(0, 60) + "..." : spec.Description)
                                                </p>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="fw-bold small">$@spec.Price.ToString("N2")</span>
                                                    <div class="rating">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <i class="fas fa-star @(i <= Math.Round(spec.AverageRating) ? "text-warning" : "text-muted")" style="font-size: 10px;"></i>
                                                        }
                                                        <small class="ms-1" style="font-size: 10px;">@spec.TotalEnrollments</small>
                                                    </div>
                                                </div>
                                                <div class="d-grid">
                                                    <button class="btn btn-primary btn-sm" @onclick="@(() => ViewSpecialization(spec.Id))">
                                                        <i class="fas fa-eye me-1"></i> View
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Desktop Grid -->
                    <div class="d-none d-md-block">
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                            @foreach (var spec in featuredSpecializations.Take(3))
                            {
                                <div class="col">
                                    <div class="card featured-card h-100 shadow-sm">
                                        <div class="position-relative">
                                            @if (!string.IsNullOrEmpty(spec.ThumbnailUrl))
                                            {
                                                <img src="@GetSpecializationImageUrl(spec.ThumbnailUrl)"
                                                     class="card-img-top"
                                                     alt="@spec.Title"
                                                     style="height: 180px; object-fit: cover;"
                                                     onerror="this.onerror=null;this.src='https://placehold.co/400x180?text=@Uri.EscapeDataString(spec.Title)';" />
                                            }
                                            else
                                            {
                                                <div class="card-img-top bg-gradient-primary d-flex align-items-center justify-content-center" style="height: 180px;">
                                                    <i class="fas fa-layer-group fa-3x text-white"></i>
                                                </div>
                                            }
                                            <span class="position-absolute top-0 start-0 m-3 badge bg-warning">
                                                <i class="fas fa-star me-1"></i> Featured
                                            </span>
                                            @if (spec.Price == 0)
                                            {
                                                <span class="position-absolute top-0 end-0 m-3 badge bg-success">
                                                    FREE
                                                </span>
                                            }
                                        </div>
                                        <div class="card-body">
                                            <h5 class="card-title">@spec.Title</h5>
                                            <p class="card-text text-muted small">
                                                @(spec.Description.Length > 120 ? spec.Description.Substring(0, 120) + "..." : spec.Description)
                                            </p>
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <span class="h5 mb-0">$@spec.Price.ToString("N2")</span>
                                                </div>
                                                <div class="rating">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <i class="fas fa-star @(i <= Math.Round(spec.AverageRating) ? "text-warning" : "text-muted")"></i>
                                                    }
                                                    <small class="ms-1">(@spec.TotalEnrollments)</small>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <small class="text-muted">
                                                    <i class="fas fa-clock me-1"></i>
                                                    @spec.EstimatedDurationHours hours
                                                </small>
                                                <small class="text-muted">
                                                    @spec.Courses?.Count courses
                                                </small>
                                            </div>
                                            <div class="d-grid gap-2">
                                                <button class="btn btn-primary" @onclick="@(() => ViewSpecialization(spec.Id))">
                                                    <i class="fas fa-eye me-2"></i> View Details
                                                </button>
                                                @if (spec.Price > 0)
                                                {
                                                    <button class="btn btn-outline-primary" @onclick="@(() => EnrollSpecialization(spec))">
                                                        <i class="fas fa-shopping-cart me-2"></i> Enroll Now
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-success" @onclick="@(async () => await EnrollFreeSpecialization(spec))">
                                                        <i class="fas fa-graduation-cap me-2"></i> Enroll Free
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- All Specializations Section -->
        <div class="row">
            <div class="col-12">
                <h2 class="h5 h2-md mb-2 mb-md-3 px-3 px-md-0">
                    @(IsSearching ? "Search Results" : (featuredOnly ? "Featured Specializations" : "All Specializations"))
                    <small class="text-muted ms-2">(@filteredSpecializations.Count)</small>
                </h2>

                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading specializations...</p>
                    </div>
                }
                else if (!filteredSpecializations.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                        <h5>No specializations found</h5>
                        <p class="text-muted">Try adjusting your search or filters</p>
                        <button class="btn btn-outline-primary mt-2" @onclick="ClearFilters">
                            <i class="fas fa-times me-2"></i> Clear Filters
                        </button>
                    </div>
                }
                else
                {
                    <!-- Mobile Card Grid -->
                    <div class="d-block d-md-none">
                        <div class="px-3">
                            @foreach (var spec in paginatedSpecializations)
                            {
                                <div class="card mb-3 shadow-sm">
                                    <div class="row g-0">
                                        <div class="col-4">
                                            @if (!string.IsNullOrEmpty(spec.ThumbnailUrl))
                                            {
                                                <img src="@GetSpecializationImageUrl(spec.ThumbnailUrl)"
                                                     class="img-fluid rounded-start h-100"
                                                     alt="@spec.Title"
                                                     style="object-fit: cover; height: 120px; width: 100%;"
                                                     onerror="this.onerror=null;this.src='https://placehold.co/120x120?text=@Uri.EscapeDataString(spec.Title)';" />
                                            }
                                            else
                                            {
                                                <div class="bg-light d-flex align-items-center justify-content-center h-100" style="height: 120px;">
                                                    <i class="fas fa-layer-group fa-2x text-muted"></i>
                                                </div>
                                            }
                                            @if (spec.IsFeatured)
                                            {
                                                <span class="position-absolute top-0 start-0 m-1 badge bg-warning" style="font-size: 8px;">
                                                    <i class="fas fa-star"></i>
                                                </span>
                                            }
                                            @if (spec.Price == 0)
                                            {
                                                <span class="position-absolute top-0 end-0 m-1 badge bg-success" style="font-size: 8px;">
                                                    FREE
                                                </span>
                                            }
                                        </div>
                                        <div class="col-8">
                                            <div class="card-body p-2">
                                                <h6 class="card-title small fw-bold mb-1">@spec.Title</h6>
                                                <p class="card-text small text-muted mb-1">
                                                    @(spec.Description.Length > 50 ? spec.Description.Substring(0, 50) + "..." : spec.Description)
                                                </p>
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold small">$@spec.Price.ToString("N2")</span>
                                                    <div class="rating">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <i class="fas fa-star @(i <= Math.Round(spec.AverageRating) ? "text-warning" : "text-muted")" style="font-size: 8px;"></i>
                                                        }
                                                        <small class="ms-1" style="font-size: 8px;">@spec.AverageRating.ToString("0.0")</small>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <small class="text-muted" style="font-size: 8px;">
                                                        <i class="fas fa-clock me-1"></i> @spec.EstimatedDurationHours h
                                                    </small>
                                                    <small class="text-muted" style="font-size: 8px;">
                                                        <i class="fas fa-users me-1"></i> @spec.TotalEnrollments
                                                    </small>
                                                </div>
                                                <button class="btn btn-outline-primary btn-sm w-100"
                                                        @onclick="@(() => ViewSpecialization(spec.Id))">
                                                    <i class="fas fa-eye me-1"></i> View
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Desktop Card Grid -->
                    <div class="d-none d-md-block">
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                            @foreach (var spec in paginatedSpecializations)
                            {
                                <div class="col">
                                    <div class="card h-100 shadow-sm">
                                        <div class="position-relative">
                                            @if (!string.IsNullOrEmpty(spec.ThumbnailUrl))
                                            {
                                                <img src="@GetSpecializationImageUrl(spec.ThumbnailUrl)"
                                                     class="card-img-top"
                                                     alt="@spec.Title"
                                                     style="height: 160px; object-fit: cover;"
                                                     onerror="this.onerror=null;this.src='https://placehold.co/400x160?text=@Uri.EscapeDataString(spec.Title)';" />
                                            }
                                            else
                                            {
                                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 160px;">
                                                    <i class="fas fa-layer-group fa-3x text-muted"></i>
                                                </div>
                                            }
                                            @if (spec.IsFeatured)
                                            {
                                                <span class="position-absolute top-0 start-0 m-2 badge bg-warning">
                                                    <i class="fas fa-star me-1"></i>
                                                </span>
                                            }
                                            @if (spec.IsActive)
                                            {
                                                <span class="position-absolute top-0 end-0 m-2 badge bg-success">
                                                    Active
                                                </span>
                                            }
                                        </div>
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">@spec.Title</h5>
                                            <p class="card-text text-muted small flex-grow-1">
                                                @(spec.Description.Length > 100 ? spec.Description.Substring(0, 100) + "..." : spec.Description)
                                            </p>
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div>
                                                    <span class="h5 mb-0">$@spec.Price.ToString("N2")</span>
                                                    @if (spec.Price == 0)
                                                    {
                                                        <span class="badge bg-success ms-2">FREE</span>
                                                    }
                                                </div>
                                                <div class="rating">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <i class="fas fa-star @(i <= Math.Round(spec.AverageRating) ? "text-warning" : "text-muted")" style="font-size: 12px;"></i>
                                                    }
                                                    <small class="ms-1">@spec.AverageRating.ToString("0.0")</small>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <small class="text-muted">
                                                    <i class="fas fa-clock me-1"></i>
                                                    @spec.EstimatedDurationHours hours
                                                </small>
                                                <small class="text-muted">
                                                    <i class="fas fa-users me-1"></i>
                                                    @spec.TotalEnrollments
                                                </small>
                                            </div>
                                            @if (spec.Doctor != null)
                                            {
                                                <div class="d-flex align-items-center mb-3">
                                                    <div class="avatar-sm me-2">
                                                        @if (!string.IsNullOrEmpty(spec.Doctor.ProfileImageUrl))
                                                        {
                                                            <img src="@GetDoctorImageUrl(spec.Doctor.ProfileImageUrl)"
                                                                 class="rounded-circle"
                                                                 width="24" height="24"
                                                                 alt="@($"{spec.Doctor.FirstName} {spec.Doctor.LastName}")"
                                                                 style="object-fit: cover;"
                                                                 onerror="this.onerror=null;this.src='https://placehold.co/24x24?text=@Uri.EscapeDataString(GetDoctorInitials(spec.Doctor))';" />
                                                        }
                                                        else
                                                        {
                                                            <div class="avatar-placeholder bg-info text-white rounded-circle d-flex align-items-center justify-content-center"
                                                                 style="width: 24px; height: 24px; font-size: 12px;">
                                                                @GetDoctorInitials(spec.Doctor)
                                                            </div>
                                                        }
                                                    </div>
                                                    <small class="text-muted">By @spec.Doctor.FirstName @spec.Doctor.LastName</small>
                                                </div>
                                            }
                                            <div class="d-grid gap-2 mt-auto">
                                                <button class="btn btn-outline-primary btn-sm"
                                                        @onclick="@(() => ViewSpecialization(spec.Id))">
                                                    <i class="fas fa-eye me-2"></i> View Details
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Pagination (Mobile Optimized) -->
                    @if (totalPages > 1)
                    {
                        <nav class="mt-3 mt-md-4">
                            <!-- Mobile Pagination -->
                            <div class="d-block d-md-none">
                                <div class="d-flex justify-content-between align-items-center px-3">
                                    <button class="btn btn-outline-primary btn-sm @(currentPage == 1 ? "disabled" : "")"
                                            @onclick="@(async () => await ChangePage(currentPage - 1))">
                                        <i class="fas fa-chevron-left"></i> Previous
                                    </button>
                                    <span class="small">Page @currentPage of @totalPages</span>
                                    <button class="btn btn-outline-primary btn-sm @(currentPage == totalPages ? "disabled" : "")"
                                            @onclick="@(async () => await ChangePage(currentPage + 1))">
                                        Next <i class="fas fa-chevron-right"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Desktop Pagination -->
                            <ul class="pagination justify-content-center d-none d-md-flex">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="@(async () => await ChangePage(currentPage - 1))">
                                        <i class="fas fa-chevron-left"></i>
                                    </button>
                                </li>

                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(currentPage == i ? "active" : "")">
                                        <button class="page-link" @onclick="@(async () => await ChangePage(i))">@i</button>
                                    </li>
                                }

                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="@(async () => await ChangePage(currentPage + 1))">
                                        <i class="fas fa-chevron-right"></i>
                                    </button>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</div>

