@page "/createlecture/{courseId:int}/{lectureId:int?}"
@page "/createlecture"


<PageTitle>@(IsEditMode ? "Edit Lecture" : "Create Lecture")</PageTitle>

<div class="create-lecture">
    <div class="container-fluid px-0 px-md-3">
        <!-- Mobile Header -->
        <div class="d-block d-md-none">
            <div class="bg-primary text-white p-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <h5 class="mb-0 flex-grow-1">@(IsEditMode ? "Edit Lecture" : "Create Lecture")</h5>
                </div>
            </div>
            <div class="px-3 py-2 bg-light border-bottom">
                <small class="text-muted">
                    <i class="fas fa-book me-1"></i> Course: @(course?.Title ?? "Loading...")
                </small>
            </div>
        </div>

        <!-- Desktop Header -->
        <div class="d-none d-md-block">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1>@(IsEditMode ? "Edit Lecture" : "Create Lecture")</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="/doctor">Doctor</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="/doctor/content/courses/@CourseId">Course</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                @(IsEditMode ? "Edit Lecture" : "Create Lecture")
                            </li>
                        </ol>
                    </nav>
                </div>
                <div>
                    <button class="btn btn-outline-secondary" @onclick="GoBack">
                        <i class="fas fa-arrow-left me-2"></i> Cancel
                    </button>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted">Loading lecture details...</p>
            </div>
        }
        else if (!isAuthenticated)
        {
            <div class="text-center py-5">
                <div class="alert alert-warning mx-3 mx-md-0">
                    <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                    <h4>Authentication Required</h4>
                    <p>Please login to create or edit lectures</p>
                    <a href="/account/login" class="btn btn-primary">
                        <i class="fas fa-sign-in-alt me-2"></i> Login
                    </a>
                </div>
            </div>
        }
        else if (!isAuthorized)
        {
            <div class="text-center py-5">
                <div class="alert alert-danger mx-3 mx-md-0">
                    <i class="fas fa-ban fa-2x mb-3"></i>
                    <h4>Access Denied</h4>
                    <p>Only doctors can create or edit lectures</p>
                    <a href="/" class="btn btn-outline-primary">
                        <i class="fas fa-home me-2"></i> Go Home
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row justify-content-center g-0 g-md-3">
                <div class="col-lg-10">
                    <div class="card border-0 border-md">
                        <div class="card-header bg-transparent d-none d-md-block">
                            <h5 class="mb-0">Lecture Details</h5>
                        </div>
                        <div class="card-body p-3 p-md-4">
                            <EditForm Model="@createDto" OnValidSubmit="SaveLecture">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="alert alert-danger" />

                                <!-- Mobile View -->
                                <div class="d-block d-md-none">
                                    <!-- Basic Information -->
                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-3">
                                            <i class="fas fa-info-circle me-2 text-primary"></i>Basic Information
                                        </h6>

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Lecture Title *</label>
                                            <InputText @bind-Value="createDto.Title"
                                                       class="form-control form-control-sm"
                                                       placeholder="Enter lecture title" />
                                            <ValidationMessage For="@(() => createDto.Title)" class="text-danger small" />
                                        </div>

                                        <div class="row g-2">
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Order *</label>
                                                <InputNumber @bind-Value="createDto.Order"
                                                             class="form-control form-control-sm"
                                                             placeholder="Sequence" />
                                                <ValidationMessage For="@(() => createDto.Order)" class="text-danger small" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Duration (min) *</label>
                                                <InputNumber @bind-Value="createDto.EstimatedDurationMinutes"
                                                             class="form-control form-control-sm"
                                                             placeholder="Minutes" />
                                                <ValidationMessage For="@(() => createDto.EstimatedDurationMinutes)" class="text-danger small" />
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Description *</label>
                                            <InputTextArea @bind-Value="createDto.Description"
                                                           class="form-control form-control-sm"
                                                           placeholder="Describe what this lecture covers"
                                                           rows="3" />
                                            <ValidationMessage For="@(() => createDto.Description)" class="text-danger small" />
                                        </div>

                                        <div class="row g-2">
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Price ($)</label>
                                                <InputNumber @bind-Value="createDto.Price"
                                                             class="form-control form-control-sm"
                                                             placeholder="0 = free" />
                                                <ValidationMessage For="@(() => createDto.Price)" class="text-danger small" />
                                            </div>
                                            <div class="col-6">
                                                <div class="form-check form-switch mt-4">
                                                    <InputCheckbox @bind-Value="createDto.IsFreePreview"
                                                                   class="form-check-input" />
                                                    <label class="form-check-label small">Free Preview</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Materials Section (Mobile) -->
                                    <div class="mb-4">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="fw-bold mb-0">
                                                <i class="fas fa-paperclip me-2 text-primary"></i>Materials
                                            </h6>
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    @onclick="AddNewMaterial">
                                                <i class="fas fa-plus me-1"></i> Add
                                            </button>
                                        </div>

                                        @if (materials.Count == 0)
                                        {
                                            <div class="alert alert-info py-2">
                                                <i class="fas fa-info-circle me-2"></i>
                                                <small>No materials added yet</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="mb-3">
                                                @for (int i = 0; i < materials.Count; i++)
                                                {
                                                    var index = i;
                                                    var material = materials[index];
                                                    var materialError = materialErrors.ContainsKey(index) ? materialErrors[index] : null;

                                                    <div class="card mb-2">
                                                        <div class="card-header bg-light py-2">
                                                            <div class="d-flex justify-content-between align-items-center">
                                                                <span class="fw-bold small">Material @(index + 1)</span>
                                                                <button type="button" class="btn btn-sm btn-link text-danger p-0"
                                                                        @onclick="() => RemoveMaterial(index)">
                                                                    <i class="fas fa-trash"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <div class="card-body p-2">
                                                            <div class="mb-2">
                                                                <label class="form-label small">Title *</label>
                                                                <InputText @bind-Value="@material.Title"
                                                                           class="form-control form-control-sm" />
                                                            </div>

                                                            <div class="mb-2">
                                                                <label class="form-label small">Type *</label>
                                                                <InputSelect @bind-Value="@material.Type"
                                                                             class="form-select form-select-sm"
                                                                             @onchange="() => OnMaterialTypeChanged(index)">
                                                                    <option value="@MaterialType.PDF">📄 PDF</option>
                                                                    <option value="@MaterialType.Document">📋 Document</option>
                                                                    <option value="@MaterialType.Video">🎥 Video</option>
                                                                    <option value="@MaterialType.Audio">🎵 Audio</option>
                                                                    <option value="@MaterialType.Image">🖼️ Image</option>
                                                                    <option value="@MaterialType.Text">📝 Text</option>
                                                                    <option value="@MaterialType.Presentation">📊 Presentation</option>
                                                                    <option value="@MaterialType.Other">📦 Other</option>
                                                                </InputSelect>
                                                            </div>

                                                            <div class="mb-2">
                                                                <label class="form-label small">File *</label>
                                                                <InputFile class="form-control form-control-sm"
                                                                           OnChange="(e) => OnMaterialFileSelected(e, index)"
                                                                           accept="@GetAcceptAttributeForMaterialType(material.Type)" />

                                                                @if (material.File != null)
                                                                {
                                                                    <div class="alert alert-success p-1 small mt-1">
                                                                        <i class="fas fa-check-circle me-1"></i>
                                                                        @material.File.Name
                                                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2"
                                                                                @onclick="() => RemoveMaterialFile(index)">
                                                                            <i class="fas fa-times"></i>
                                                                        </button>
                                                                    </div>
                                                                }
                                                                else if (!string.IsNullOrEmpty(materialError))
                                                                {
                                                                    <div class="alert alert-danger p-1 small mt-1">
                                                                        @materialError
                                                                    </div>
                                                                }
                                                            </div>

                                                            <div class="row g-1 mb-2">
                                                                <div class="col-4">
                                                                    <label class="form-label small">Order</label>
                                                                    <InputNumber @bind-Value="@material.Order"
                                                                                 class="form-control form-control-sm" />
                                                                </div>
                                                                <div class="col-8">
                                                                    <div class="form-check mt-2">
                                                                        <InputCheckbox @bind-Value="@material.IsDownloadable"
                                                                                       class="form-check-input" />
                                                                        <label class="form-check-label small">Allow Download</label>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="mb-2">
                                                                <label class="form-label small">Description (Optional)</label>
                                                                <InputTextArea @bind-Value="@material.Description"
                                                                               class="form-control form-control-sm"
                                                                               rows="2" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <!-- Mobile Action Buttons -->
                                    <div class="fixed-bottom d-block d-md-none p-3 bg-white border-top">
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-outline-secondary flex-fill" @onclick="ResetForm">
                                                Reset
                                            </button>
                                            <button type="submit" class="btn btn-primary flex-fill" disabled="@isSubmitting">
                                                @if (isSubmitting)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                                }
                                                @(IsEditMode ? "Update" : "Create")
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Spacer for mobile fixed button -->
                                    <div class="mb-5 pb-3 d-block d-md-none"></div>
                                </div>

                                <!-- Desktop View -->
                                <div class="d-none d-md-block">
                                    <div class="row g-3">
                                        <!-- Basic Information -->
                                        <div class="col-12">
                                            <div class="form-floating mb-3">
                                                <InputText id="title" @bind-Value="createDto.Title"
                                                           class="form-control" placeholder="Lecture Title" />
                                                <label for="title">Lecture Title *</label>
                                                <ValidationMessage For="@(() => createDto.Title)" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <InputNumber id="order" @bind-Value="createDto.Order"
                                                             class="form-control" placeholder="Order" />
                                                <label for="order">Order *</label>
                                                <ValidationMessage For="@(() => createDto.Order)" />
                                                <div class="form-text">
                                                    Sequence in the course
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <InputNumber id="duration" @bind-Value="createDto.EstimatedDurationMinutes"
                                                             class="form-control" placeholder="Duration" />
                                                <label for="duration">Estimated Duration (Minutes) *</label>
                                                <ValidationMessage For="@(() => createDto.EstimatedDurationMinutes)" />
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="form-floating mb-3">
                                                <InputTextArea id="description" @bind-Value="createDto.Description"
                                                               class="form-control" placeholder="Description"
                                                               style="height: 150px" />
                                                <label for="description">Description *</label>
                                                <ValidationMessage For="@(() => createDto.Description)" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <InputNumber id="price" @bind-Value="createDto.Price"
                                                             class="form-control" placeholder="Price" />
                                                <label for="price">Price ($)</label>
                                                <ValidationMessage For="@(() => createDto.Price)" />
                                                <div class="form-text">
                                                    Leave as 0 if included in course price
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-check form-switch mt-4">
                                                <InputCheckbox id="freePreview" @bind-Value="createDto.IsFreePreview"
                                                               class="form-check-input" />
                                                <label class="form-check-label" for="freePreview">
                                                    Free Preview Lecture
                                                </label>
                                                <div class="form-text">
                                                    Students can view this lecture for free
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Materials Section (Desktop) -->
                                        <div class="col-12">
                                            <hr />
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <h5 class="mb-0">Lecture Materials</h5>
                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        @onclick="AddNewMaterial">
                                                    <i class="fas fa-plus me-1"></i> Add Material
                                                </button>
                                            </div>

                                            @if (materials.Count == 0)
                                            {
                                                <div class="alert alert-info">
                                                    <i class="fas fa-info-circle me-2"></i>
                                                    No materials added yet. Add PDFs, videos, or other resources for this lecture.
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="list-group mb-3">
                                                    @for (int i = 0; i < materials.Count; i++)
                                                    {
                                                        var index = i;
                                                        var material = materials[index];
                                                        var materialError = materialErrors.ContainsKey(index) ? materialErrors[index] : null;

                                                        <div class="list-group-item mb-2 border rounded">
                                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                                <h6 class="mb-0">Material @(index + 1)</h6>
                                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                                        @onclick="() => RemoveMaterial(index)">
                                                                    <i class="fas fa-trash"></i>
                                                                </button>
                                                            </div>

                                                            <div class="row g-2">
                                                                <div class="col-md-6">
                                                                    <div class="form-floating mb-2">
                                                                        <InputText @bind-Value="@material.Title"
                                                                                   class="form-control form-control-sm"
                                                                                   placeholder="Title" />
                                                                        <label>Title *</label>
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-6">
                                                                    <div class="form-floating mb-2">
                                                                        <InputSelect @bind-Value="@material.Type"
                                                                                     class="form-control form-control-sm"
                                                                                     @onchange="() => OnMaterialTypeChanged(index)">
                                                                            <option value="@MaterialType.PDF">📄 PDF</option>
                                                                            <option value="@MaterialType.Document">📋 Document</option>
                                                                            <option value="@MaterialType.Video">🎥 Video</option>
                                                                            <option value="@MaterialType.Audio">🎵 Audio</option>
                                                                            <option value="@MaterialType.Image">🖼️ Image</option>
                                                                            <option value="@MaterialType.Text">📝 Text</option>
                                                                            <option value="@MaterialType.Presentation">📊 Presentation</option>
                                                                            <option value="@MaterialType.Other">📦 Other</option>
                                                                        </InputSelect>
                                                                        <label>Type *</label>
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-4">
                                                                    <div class="form-floating mb-2">
                                                                        <InputNumber @bind-Value="@material.Order"
                                                                                     class="form-control form-control-sm"
                                                                                     placeholder="Order" />
                                                                        <label>Order</label>
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-8">
                                                                    <div class="form-check mt-3">
                                                                        <InputCheckbox @bind-Value="@material.IsDownloadable"
                                                                                       class="form-check-input" />
                                                                        <label class="form-check-label small">Allow Download</label>
                                                                    </div>
                                                                </div>

                                                                <div class="col-12">
                                                                    <div class="form-floating mb-2">
                                                                        <InputTextArea @bind-Value="@material.Description"
                                                                                       class="form-control form-control-sm"
                                                                                       placeholder="Description"
                                                                                       style="height: 80px" />
                                                                        <label>Description (Optional)</label>
                                                                    </div>
                                                                </div>

                                                                <div class="col-12">
                                                                    <div class="mb-2">
                                                                        <label class="form-label small">File *</label>
                                                                        <InputFile class="form-control form-control-sm"
                                                                                   OnChange="(e) => OnMaterialFileSelected(e, index)"
                                                                                   accept="@GetAcceptAttributeForMaterialType(material.Type)" />

                                                                        @if (material.File != null)
                                                                        {
                                                                            <div class="alert alert-success p-2 mt-1">
                                                                                <i class="fas fa-check-circle me-2"></i>
                                                                                @material.File.Name (@((material.File.Size / 1024).ToString("N0")) KB)
                                                                                <button type="button" class="btn btn-sm btn-outline-danger ms-2"
                                                                                        @onclick="() => RemoveMaterialFile(index)">
                                                                                    <i class="fas fa-times"></i>
                                                                                </button>
                                                                            </div>
                                                                        }
                                                                        else if (!string.IsNullOrEmpty(materialError))
                                                                        {
                                                                            <div class="alert alert-danger p-2 mt-1">
                                                                                <i class="fas fa-exclamation-circle me-2"></i>
                                                                                @materialError
                                                                                <button type="button" class="btn btn-sm btn-link text-danger float-end p-0"
                                                                                        @onclick="() => materialErrors.Remove(index)">
                                                                                    <i class="fas fa-times"></i>
                                                                                </button>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <!-- Desktop Submit Button -->
                                        <div class="col-12">
                                            <hr />
                                            <div class="d-flex justify-content-between">
                                                <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">
                                                    <i class="fas fa-redo me-2"></i> Reset
                                                </button>
                                                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                                    @if (isSubmitting)
                                                    {
                                                        <span>
                                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                            @(IsEditMode ? "Updating..." : "Creating...")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>
                                                            <i class="fas fa-save me-2"></i>
                                                            @(IsEditMode ? "Update Lecture" : "Create Lecture")
                                                        </span>
                                                    }
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // ... (keep all your existing code in the @code block exactly as is)
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int? LectureId { get; set; }

    private CreateLectureDtos createDto = new();
    private LectureDto? existingLecture;
    private List<MaterialUploadDtos> materials = new();
    private Dictionary<int, string> materialErrors = new();
    private UserDto? currentUser;
    private bool isSubmitting = false;
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private bool isAuthorized = false;
    private CourseDto? course;
    private int doctorId = 0;

    private bool IsEditMode => LectureId.HasValue && LectureId > 0;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();

        if (isAuthenticated && isAuthorized)
        {
            await LoadCourseAndLectureData();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();

                if (currentUser != null)
                {
                    isAuthorized = currentUser.UserType == UserType.Doctor || currentUser.UserType == UserType.Admin;
                    doctorId = currentUser.Id;
                }
                else
                {
                    isAuthenticated = false;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            isAuthorized = false;
        }
    }

    private async Task LoadCourseAndLectureData()
    {
        isLoading = true;

        try
        {
            // Load course to verify ownership
            course = await CourseService.GetCourseAsync(CourseId);

            if (course == null)
            {
                await ShowToast("error", "Course not found");
                Navigation.NavigateTo("/doctor/content/courses");
                return;
            }

            // Verify the doctor owns this course
            if (course.DoctorId != doctorId && currentUser?.UserType != UserType.Admin)
            {
                await ShowToast("error", "You don't have permission to create lectures in this course");
                Navigation.NavigateTo("/doctor/content/courses");
                return;
            }

            if (IsEditMode)
            {
                // Load existing lecture
                existingLecture = await LectureService.GetLectureAsync(LectureId!.Value);

                if (existingLecture != null)
                {
                    // Verify the lecture belongs to this course
                    if (existingLecture.CourseId != CourseId)
                    {
                        await ShowToast("error", "Lecture does not belong to this course");
                        Navigation.NavigateTo($"/doctor/content/courses/{CourseId}");
                        return;
                    }

                    // Load existing materials
                    var lectureMaterials = await LectureService.GetLecturesByCourseAsync(CourseId);
                    var currentLectureMaterials = lectureMaterials?.FirstOrDefault(l => l.Id == LectureId.Value);

                    if (currentLectureMaterials?.Materials != null)
                    {
                        // Convert existing materials to CreateMaterialDto format
                        materials = currentLectureMaterials.Materials.Select(m => new MaterialUploadDtos
                        {
                            Title = m.Title,
                            Description = m.Description,
                            Type = m.Type,
                            Order = m.Order,
                            IsDownloadable = m.IsDownloadable,
                            // Note: We cannot pre-populate files for existing materials
                            File = null
                        }).ToList();
                    }

                    createDto = new CreateLectureDtos
                    {
                        Title = existingLecture.Title,
                        Description = existingLecture.Description,
                        Order = existingLecture.Order,
                        CourseId = CourseId,
                        Price = existingLecture.Price,
                        IsFreePreview = existingLecture.IsFreePreview,
                        EstimatedDurationMinutes = existingLecture.EstimatedDurationMinutes,
                        Materials = materials
                    };
                }
                else
                {
                    await ShowToast("error", "Lecture not found");
                    Navigation.NavigateTo($"/doctor/content/courses/{CourseId}");
                }
            }
            else
            {
                // New lecture
                createDto = new CreateLectureDtos
                {
                    CourseId = CourseId,
                    Order = 1, // Default order
                    Price = 0, // Default price (included in course)
                    EstimatedDurationMinutes = 60, // Default 1 hour
                    Materials = new List<MaterialUploadDtos>()
                };
            }
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void AddNewMaterial()
    {
        materials.Add(new MaterialUploadDtos
        {
            Title = "",
            Description = "",
            Type = MaterialType.PDF, // Default to PDF
            Order = materials.Count + 1,
            IsDownloadable = true,
            File = null
        });
        StateHasChanged();
    }

    private void RemoveMaterial(int index)
    {
        if (index >= 0 && index < materials.Count)
        {
            materials.RemoveAt(index);
            materialErrors.Remove(index);
            StateHasChanged();
        }
    }

    private void RemoveMaterialFile(int index)
    {
        if (index >= 0 && index < materials.Count)
        {
            materials[index].File = null;
            materialErrors.Remove(index);
            StateHasChanged();
        }
    }

    private void OnMaterialTypeChanged(int index)
    {
        if (index >= 0 && index < materials.Count)
        {
            // Clear any existing file selection when type changes
            materials[index].File = null;
            materialErrors.Remove(index);
            StateHasChanged();
        }
    }

    private string GetAcceptAttributeForMaterialType(MaterialType type)
    {
        return type switch
        {
            MaterialType.PDF => ".pdf",
            MaterialType.Document => ".doc,.docx,.txt,.rtf,.xls,.xlsx",
            MaterialType.Video => ".mp4,.webm,.ogg,.avi,.mov,.wmv,.flv,.mkv",
            MaterialType.Audio => ".mp3,.wav,.ogg,.m4a,.flac,.aac",
            MaterialType.Image => ".jpg,.jpeg,.png,.gif,.bmp,.webp,.svg",
            MaterialType.Text => ".txt,.md,.rtf,.html,.htm,.xml,.json,.csv",
            MaterialType.Presentation => ".ppt,.pptx,.pdf",
            MaterialType.Other => "*",
            _ => "*"
        };
    }

    private async Task OnMaterialFileSelected(InputFileChangeEventArgs e, int index)
    {
        if (index < 0 || index >= materials.Count) return;

        materialErrors.Remove(index);
        var file = e.File;

        // Validate file size (500MB max)
        if (file.Size > 500 * 1024 * 1024)
        {
            materialErrors[index] = "File size must be less than 100MB";
            await ShowToast("error", materialErrors[index]);
            return;
        }

        // Get allowed extensions based on selected material type
        var allowedExtensions = GetAllowedExtensionsForMaterialType(materials[index].Type);
        var fileExtension = Path.GetExtension(file.Name).ToLowerInvariant();

        // For "Other" type, allow any file
        if (materials[index].Type != MaterialType.Other && !allowedExtensions.Contains(fileExtension))
        {
            var typeName = GetMaterialTypeName(materials[index].Type);
            materialErrors[index] = $"Invalid file type for {typeName}. Allowed: {string.Join(", ", allowedExtensions)}";
            await ShowToast("error", materialErrors[index]);
            return;
        }

        materials[index].File = file;
        StateHasChanged();
    }

    private List<string> GetAllowedExtensionsForMaterialType(MaterialType type)
    {
        return type switch
        {
            MaterialType.PDF => new List<string> { ".pdf" },
            MaterialType.Document => new List<string> { ".doc", ".docx", ".txt", ".rtf", ".xls", ".xlsx" },
            MaterialType.Video => new List<string> { ".mp4", ".webm", ".ogg", ".avi", ".mov", ".wmv", ".flv", ".mkv" },
            MaterialType.Audio => new List<string> { ".mp3", ".wav", ".ogg", ".m4a", ".flac", ".aac" },
            MaterialType.Image => new List<string> { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".svg" },
            MaterialType.Text => new List<string> { ".txt", ".md", ".rtf", ".html", ".htm", ".xml", ".json", ".csv" },
            MaterialType.Presentation => new List<string> { ".ppt", ".pptx", ".pdf" },
            _ => new List<string>() // Empty list for "Other" means all files allowed
        };
    }

    private string GetMaterialTypeName(MaterialType type)
    {
        return type switch
        {
            MaterialType.PDF => "PDF",
            MaterialType.Document => "Document",
            MaterialType.Video => "Video",
            MaterialType.Audio => "Audio",
            MaterialType.Image => "Image",
            MaterialType.Text => "Text",
            MaterialType.Presentation => "Presentation",
            _ => "Other"
        };
    }

    private async Task SaveLecture()
    {
        if (!isAuthenticated || !isAuthorized || course == null)
        {
            await ShowToast("error", "You are not authorized to perform this action");
            return;
        }

        // Validate materials
        bool hasMaterialErrors = false;
        materialErrors.Clear();

        for (int i = 0; i < materials.Count; i++)
        {
            var material = materials[i];

            if (string.IsNullOrWhiteSpace(material.Title))
            {
                materialErrors[i] = "Title is required";
                hasMaterialErrors = true;
            }
            else if (material.File == null && !IsEditMode)
            {
                materialErrors[i] = "File is required for new materials";
                hasMaterialErrors = true;
            }
        }

        if (hasMaterialErrors)
        {
            await ShowToast("error", "Please fix material errors before saving");
            StateHasChanged();
            return;
        }

        isSubmitting = true;

        try
        {
            // Set materials in DTO
            createDto.Materials = materials;

            if (IsEditMode && existingLecture != null)
            {
                // For edit mode, we need to handle materials differently
                // Since we can't update materials in bulk with files, we'll use a different approach
                // First update the lecture without materials
                var updateDto = new UpdateLectureDtos
                {
                    Title = createDto.Title,
                    Description = createDto.Description,
                    Order = createDto.Order,
                    Price = createDto.Price,
                    IsFreePreview = createDto.IsFreePreview,
                    EstimatedDurationMinutes = createDto.EstimatedDurationMinutes
                };

                var success = await LectureService.UpdateLectureAsync(existingLecture.Id, updateDto);

                if (success)
                {
                    // Now add/update materials individually
                    foreach (var material in materials.Where(m => m.File != null))
                    {
                        var stream = material.File!.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
                        var materialUploadDto = new MaterialUploadDtos
                        {
                            Title = material.Title,
                            Description = material.Description,
                            Type = material.Type,
                            Order = material.Order,
                            IsDownloadable = material.IsDownloadable
                        };

                        await LectureService.AddMaterialAsync(existingLecture.Id, materialUploadDto, stream, material.File.Name);
                    }

                    await ShowToast("success", "Lecture updated successfully");
                    Navigation.NavigateTo($"/doctor/content/courses/{CourseId}/lectures/{existingLecture.Id}");
                }
                else
                {
                    await ShowToast("error", "Failed to update lecture");
                }
            }
            else
            {
                // Create new lecture with materials
                var lecture = await LectureService.CreateLectureAsync(createDto);

                if (lecture != null)
                {
                    await ShowToast("success", "Lecture created successfully");
                    Navigation.NavigateTo($"/doctor/content/courses/{CourseId}/lectures/{lecture.Id}");
                }
                else
                {
                    await ShowToast("error", "Failed to create lecture");
                }
            }
        }
        catch (Exception ex)
        {
            await ShowToast("error", ex.Message);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void ResetForm()
    {
        if (IsEditMode && existingLecture != null)
        {
            createDto = new CreateLectureDtos
            {
                Title = existingLecture.Title,
                Description = existingLecture.Description,
                Order = existingLecture.Order,
                CourseId = CourseId,
                Price = existingLecture.Price,
                IsFreePreview = existingLecture.IsFreePreview,
                EstimatedDurationMinutes = existingLecture.EstimatedDurationMinutes
            };

            // Reset materials but keep existing ones without files
            materials.Clear();
            materialErrors.Clear();

            // Note: We cannot reset files for existing materials
        }
        else
        {
            createDto = new CreateLectureDtos
            {
                CourseId = CourseId,
                Order = 1,
                Price = 0,
                EstimatedDurationMinutes = 60,
                Materials = new List<MaterialUploadDtos>()
            };
            materials.Clear();
            materialErrors.Clear();
        }

        StateHasChanged();
    }

    private void GoBack()
    {
        if (IsEditMode && existingLecture != null)
        {
            Navigation.NavigateTo($"/doctor/content/courses/{CourseId}/lectures/{existingLecture.Id}");
        }
        else
        {
            Navigation.NavigateTo($"/doctor/content/courses/{CourseId}");
        }
    }

    private async Task ShowToast(string type, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", type, message);
        }
        catch
        {
            Console.WriteLine($"{type.ToUpper()}: {message}");
        }
    }
