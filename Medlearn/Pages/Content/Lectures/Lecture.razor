@code {
    [Parameter] public int Id { get; set; }

    private LectureDto? lecture;
    private LearningMaterialDto? primaryMaterial;
    private LearningMaterialDto? fullScreenMaterial;
    private int currentPrimaryIndex = 0;
    private bool isLoading = true;
    private string errorMessage = "";
    private string mobileTab = "content";
    private bool showMobileMenu = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            lecture = await LectureService.GetLectureAsync(Id);
            
            // Set the first material as primary by default
            if (lecture?.Materials != null && lecture.Materials.Any())
            {
                var orderedMaterials = lecture.Materials.OrderBy(m => m.Order).ToList();
                primaryMaterial = orderedMaterials.First();
                currentPrimaryIndex = 0;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading lecture: {ex.Message}";
            Console.WriteLine($"Error loading lecture: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("initializeScrollHandling");
                
                // Add keyboard shortcuts
                await JS.InvokeVoidAsync("eval", @"
                    document.addEventListener('keydown', function(e) {
                        if (e.key === 'Escape' && document.querySelector('.modal.show')) {
                            window.dispatchEvent(new CustomEvent('closefullscreen'));
                        }
                        if (e.key === 'ArrowLeft' && !e.target.matches('input, textarea')) {
                            window.dispatchEvent(new CustomEvent('previouscontent'));
                        }
                        if (e.key === 'ArrowRight' && !e.target.matches('input, textarea')) {
                            window.dispatchEvent(new CustomEvent('nextcontent'));
                        }
                    });

                    window.addEventListener('closefullscreen', function() {
                        DotNet.invokeMethodAsync('BlazorApp1', 'HandleCloseFullScreen');
                    });
                    
                    window.addEventListener('previouscontent', function() {
                        DotNet.invokeMethodAsync('BlazorApp1', 'HandlePreviousContent');
                    });
                    
                    window.addEventListener('nextcontent', function() {
                        DotNet.invokeMethodAsync('BlazorApp1', 'HandleNextContent');
                    });
                    
                    function initializeScrollHandling() {
                        const viewerContainers = document.querySelectorAll('.viewer-container, .fullscreen-viewer-container');
                        viewerContainers.forEach(container => {
                            container.style.overflow = 'auto';
                            container.style.overflowX = 'auto';
                            container.style.overflowY = 'auto';
                            container.style.webkitOverflowScrolling = 'touch';
                            
                            const secureViewer = container.querySelector('.secure-file-viewer');
                            if (secureViewer) {
                                secureViewer.style.overflow = 'visible';
                                
                                const displayAreas = secureViewer.querySelectorAll('.pdf-display-area, .image-display-area, .text-display-area');
                                displayAreas.forEach(area => {
                                    area.style.overflow = 'auto';
                                    area.style.maxHeight = 'none';
                                    area.style.webkitOverflowScrolling = 'touch';
                                });
                            }
                        });
                    }
                ");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error in OnAfterRenderAsync: {ex.Message}");
            }
        }
    }

    private void SetPrimaryMaterial(LearningMaterialDto material)
    {
        primaryMaterial = material;
        
        if (lecture?.Materials != null)
        {
            var orderedMaterials = lecture.Materials.OrderBy(m => m.Order).ToList();
            currentPrimaryIndex = orderedMaterials.IndexOf(material);
        }
        
        if (fullScreenMaterial != null)
        {
            fullScreenMaterial = material;
        }
        
        // On mobile, switch to content tab when selecting material
        mobileTab = "content";
        
        _ = JS.InvokeVoidAsync("initializeScrollHandling");
    }

    private void OnMobileMaterialChange(ChangeEventArgs e)
    {
        var materialId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(materialId) && lecture?.Materials != null)
        {
            var material = lecture.Materials.FirstOrDefault(m => m.Id.ToString() == materialId);
            if (material != null)
            {
                SetPrimaryMaterial(material);
            }
        }
    }

    private void ShowNextContent()
    {
        if (lecture?.Materials == null) return;
        
        var orderedMaterials = lecture.Materials.OrderBy(m => m.Order).ToList();
        currentPrimaryIndex = (currentPrimaryIndex + 1) % orderedMaterials.Count;
        primaryMaterial = orderedMaterials[currentPrimaryIndex];
        
        if (fullScreenMaterial != null)
        {
            fullScreenMaterial = primaryMaterial;
        }
    }

    private void ShowPreviousContent()
    {
        if (lecture?.Materials == null) return;
        
        var orderedMaterials = lecture.Materials.OrderBy(m => m.Order).ToList();
        currentPrimaryIndex = (currentPrimaryIndex - 1 + orderedMaterials.Count) % orderedMaterials.Count;
        primaryMaterial = orderedMaterials[currentPrimaryIndex];
        
        if (fullScreenMaterial != null)
        {
            fullScreenMaterial = primaryMaterial;
        }
    }

    private void OpenInFullScreen(LearningMaterialDto material)
    {
        fullScreenMaterial = material;
        _ = JS.InvokeVoidAsync("document.body.style.overflow", "hidden");
        _ = JS.InvokeVoidAsync("initializeScrollHandling");
    }

    private void CloseFullScreen()
    {
        fullScreenMaterial = null;
        _ = JS.InvokeVoidAsync("document.body.style.overflow", "auto");
    }

    private void ToggleMobileMenu()
    {
        showMobileMenu = !showMobileMenu;
        StateHasChanged();
    }

    private string GetMaterialIcon(LearningMaterialDto material)
    {
        return material.Type switch
        {
            MaterialType.Document => "fas fa-file-pdf text-danger",
            MaterialType.Video => "fas fa-video text-primary",
            MaterialType.Audio => "fas fa-music text-success",
            MaterialType.Presentation => "fas fa-chart-line text-warning",
            MaterialType.Image => "fas fa-image text-info",
            MaterialType.Text => "fas fa-file-alt text-secondary",
            _ => "fas fa-file text-secondary"
        };
    }

    private string GetMaterialTypeName(MaterialType type)
    {
        return type.ToString();
    }

    private int GetVideoCount()
    {
        return lecture?.Materials?.Count(m => m.Type == MaterialType.Video) ?? 0;
    }

    private int GetDownloadableCount()
    {
        return lecture?.Materials?.Count(m => m.IsDownloadable) ?? 0;
    }

    private string GetTotalDuration()
    {
        if (lecture?.Materials == null) return "0";
        
        var totalSeconds = lecture.Materials.Sum(m => m.DurationSeconds);
        var totalMinutes = (int)Math.Ceiling(totalSeconds / 60.0);
        return totalMinutes.ToString();
    }

    private async Task OpenInNewTab(LearningMaterialDto material)
    {
        var secureUrl = $"/api/SecureMaterials/{material.Id}/view";
        var fullUrl = ImageUrlService.GetImageUrl(secureUrl);
        await JS.InvokeVoidAsync("open", fullUrl, "_blank");
    }

    private async Task DownloadMaterial(LearningMaterialDto material)
    {
        try
        {
            if (!material.IsDownloadable)
            {
                await ShowToast("warning", "This material is not available for download.");
                return;
            }

            await ShowToast("info", $"Downloading {material.Title}...");
            await SecureFileViewerService.DownloadMaterialAsync(material.Id, material.Title);
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Error downloading material: {ex.Message}");
            Console.WriteLine($"Error downloading material: {ex.Message}");
        }
    }

    private async Task DownloadAllMaterials()
    {
        try
        {
            if (lecture?.Materials == null)
            {
                await ShowToast("warning", "No materials available.");
                return;
            }

            var downloadableMaterials = lecture.Materials.Where(m => m.IsDownloadable).ToList();
            
            if (!downloadableMaterials.Any())
            {
                await ShowToast("warning", "No downloadable materials available.");
                return;
            }

            await ShowToast("info", $"Downloading {downloadableMaterials.Count} materials...");
            
            foreach (var material in downloadableMaterials)
            {
                try
                {
                    await SecureFileViewerService.DownloadMaterialAsync(material.Id, material.Title);
                    await Task.Delay(500);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error downloading {material.Title}: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Error downloading materials: {ex.Message}");
            Console.WriteLine($"Error downloading materials: {ex.Message}");
        }
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes == 0) return "0 B";
        
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double len = bytes;
        
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        
        return $"{len:0.##} {sizes[order]}";
    }

    private string FormatDuration(int seconds)
    {
        var timeSpan = TimeSpan.FromSeconds(seconds);
        
        if (timeSpan.Hours > 0)
        {
            return $"{timeSpan.Hours}h {timeSpan.Minutes}m";
        }
        else if (timeSpan.Minutes > 0)
        {
            return $"{timeSpan.Minutes}m {timeSpan.Seconds}s";
        }
        else
        {
            return $"{timeSpan.Seconds}s";
        }
    }

    private async Task ShowToast(string type, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", type, message);
        }
        catch
        {
            Console.WriteLine($"{type.ToUpper()}: {message}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/courses");
    }

    private void NavigateToCourse()
    {
        if (lecture != null)
        {
            Navigation.NavigateTo($"/course/{lecture.CourseId}");
        }
    }

    private async Task EnrollInLecture()
    {
        try
        {
            await ShowToast("success", "You have enrolled in this free preview lecture!");
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Error enrolling: {ex.Message}");
        }
    }

    private async Task PurchaseLecture()
    {
        try
        {
            await ShowToast("info", "Redirecting to checkout...");
            // Navigation.NavigateTo($"/checkout/lecture/{lecture.Id}");
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Error processing purchase: {ex.Message}");
        }
    }

    private async Task ShareLecture()
    {
        try
        {
            string url = Navigation.Uri;
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            await ShowToast("success", "Lecture URL copied to clipboard!");
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Error sharing: {ex.Message}");
        }
    }

    [JSInvokable]
    public void HandleCloseFullScreen()
    {
        CloseFullScreen();
        StateHasChanged();
    }

    [JSInvokable]
    public void HandlePreviousContent()
    {
        if (fullScreenMaterial != null || primaryMaterial != null)
        {
            ShowPreviousContent();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void HandleNextContent()
    {
        if (fullScreenMaterial != null || primaryMaterial != null)
        {
            ShowNextContent();
            StateHasChanged();
        }
    }
}
