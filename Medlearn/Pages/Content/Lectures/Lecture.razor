                <!-- Modal Footer -->
                <div class="modal-footer border-top border-secondary" style="background-color: rgba(0,0,0,0.9); height: 60px;">
                    <small class="text-muted">
                        Press <kbd>ESC</kbd> to exit
                    </small>
                </div>
            </div>
        </div>
    </div>
}

