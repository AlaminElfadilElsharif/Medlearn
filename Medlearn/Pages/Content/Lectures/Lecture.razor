@page "/lecture/{Id:int}"


<PageTitle>@(lecture?.Title ?? "Loading Lecture...")</PageTitle>

<div class="lecture-view">
    <div class="container-fluid px-0 px-lg-3">
        <!-- Mobile Header -->
        <div class="d-block d-lg-none">
            @if (!isLoading && lecture != null)
            {
                <div class="bg-primary text-white p-3">
                    <div class="d-flex align-items-center">
                        <button class="btn btn-link text-white p-0 me-2" @onclick="GoBack">
                            <i class="fas fa-arrow-left fa-lg"></i>
                        </button>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 text-truncate">@lecture.Title</h6>
                            <small class="opacity-75">
                                @if (lecture.IsFreePreview)
                                {
                                    <span><i class="fas fa-unlock me-1"></i>Free Preview</span>
                                }
                                else
                                {
                                    <span><i class="fas fa-dollar-sign me-1"></i>$@lecture.Price.ToString("N2")</span>
                                }
                            </small>
                        </div>
                        <button class="btn btn-link text-white p-0" @onclick="ToggleMobileMenu">
                            <i class="fas fa-ellipsis-v fa-lg"></i>
                        </button>
                    </div>
                </div>

                <!-- Mobile Bottom Navigation -->
                <div class="mobile-bottom-nav d-flex d-lg-none bg-white border-top fixed-bottom">
                    <button class="flex-fill py-3 text-center @(mobileTab == "content" ? "active" : "")" 
                            @onclick='() => mobileTab = "content"'>
                        <i class="fas fa-play-circle d-block mb-1"></i>
                        <small>Content</small>
                    </button>
                    <button class="flex-fill py-3 text-center @(mobileTab == "materials" ? "active" : "")" 
                            @onclick='() => mobileTab = "materials"'>
                        <i class="fas fa-list d-block mb-1"></i>
                        <small>Materials</small>
                    </button>
                    <button class="flex-fill py-3 text-center @(mobileTab == "info" ? "active" : "")" 
                            @onclick='() => mobileTab = "info"'>
                        <i class="fas fa-info-circle d-block mb-1"></i>
                        <small>Info</small>
                    </button>
                    <button class="flex-fill py-3 text-center @(mobileTab == "actions" ? "active" : "")" 
                            @onclick='() => mobileTab = "actions"'>
                        <i class="fas fa-ellipsis-h d-block mb-1"></i>
                        <small>More</small>
                    </button>
                </div>
            }
        </div>

        <!-- Desktop Breadcrumb -->
        <nav aria-label="breadcrumb" class="d-none d-lg-block mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="/">Home</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="/courses">Courses</a>
                </li>
                @if (lecture != null)
                {
                    <li class="breadcrumb-item">
                        <a href="/course/@lecture.CourseId">Course @lecture.CourseId</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        @lecture.Title
                    </li>
                }
            </ol>
        </nav>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading lecture...</p>
            </div>
        }
        else if (lecture == null)
        {
            <div class="alert alert-danger text-center py-5">
                <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                <h4>Lecture Not Found</h4>
                <p>The lecture you're looking for doesn't exist or has been removed.</p>
                <button class="btn btn-primary mt-3" @onclick='() => Navigation.NavigateTo("/courses")'>
                    <i class="fas fa-arrow-left me-2"></i> Back to Courses
                </button>
            </div>
        }
        else
        {
            <!-- Desktop Layout (lg and above) -->
            <div class="d-none d-lg-block">
                <div class="row">
                    <!-- Main Content -->
                    <div class="col-lg-8">
                        <!-- Desktop Main Content -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h1 class="mb-1">@lecture.Title</h1>
                                        <div class="d-flex align-items-center gap-3">
                                            @if (lecture.IsFreePreview)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-unlock me-1"></i> Free Preview
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">
                                                    <i class="fas fa-dollar-sign me-1"></i> $@lecture.Price.ToString("N2")
                                                </span>
                                            }
                                            <span class="text-muted">
                                                <i class="fas fa-clock me-1"></i> @lecture.EstimatedDurationMinutes minutes
                                            </span>
                                        </div>
                                    </div>
                                    <button class="btn btn-outline-primary" @onclick="GoBack">
                                        <i class="fas fa-arrow-left me-2"></i> Back
                                    </button>
                                </div>

                                <div class="lecture-description mb-4">
                                    <h5>Description</h5>
                                    <div class="p-3 bg-light rounded">
                                        @if (string.IsNullOrEmpty(lecture.Description))
                                        {
                                            <p class="text-muted mb-0">No description provided.</p>
                                        }
                                        else
                                        {
                                            <p class="mb-0">@lecture.Description</p>
                                        }
                                    </div>
                                </div>

                                <!-- Main Content Area -->
                                @if (lecture.Materials != null && lecture.Materials.Any())
                                {
                                    <!-- Content Selection Toolbar -->
                                    <div class="content-selector mb-3">
                                        <div class="card">
                                            <div class="card-body py-2">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <small class="text-muted">Select content:</small>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="dropdown">
                                                            <button class="btn btn-sm btn-outline-primary dropdown-toggle" 
                                                                    type="button" 
                                                                    data-bs-toggle="dropdown">
                                                                <i class="fas fa-play-circle me-1"></i>
                                                                @(primaryMaterial?.Title ?? "Select Primary Content")
                                                            </button>
                                                            <ul class="dropdown-menu">
                                                                @foreach (var material in lecture.Materials.OrderBy(m => m.Order))
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item" href="#" 
                                                                           @onclick="() => SetPrimaryMaterial(material)" 
                                                                           @onclick:preventDefault>
                                                                            <i class="@GetMaterialIcon(material) me-2"></i>
                                                                            @material.Title
                                                                        </a>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </div>
                                                        
                                                        @if (lecture.Materials.Count > 1)
                                                        {
                                                            <div class="btn-group">
                                                                <button class="btn btn-sm btn-outline-secondary" 
                                                                        @onclick="ShowPreviousContent" 
                                                                        disabled="@(primaryMaterial == null || currentPrimaryIndex <= 0)">
                                                                    <i class="fas fa-chevron-left"></i>
                                                                </button>
                                                                <button class="btn btn-sm btn-outline-secondary" 
                                                                        @onclick="ShowNextContent" 
                                                                        disabled="@(primaryMaterial == null || currentPrimaryIndex >= lecture.Materials.Count - 1)">
                                                                    <i class="fas fa-chevron-right"></i>
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Main Content Display -->
                                    <div class="main-content-display mb-4">
                                        @if (primaryMaterial != null)
                                        {
                                            <div class="card border-primary">
                                                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                                    <div class="d-flex align-items-center">
                                                        <i class="@GetMaterialIcon(primaryMaterial) me-2"></i>
                                                        <strong>@primaryMaterial.Title</strong>
                                                    </div>
                                                    <div class="d-flex gap-2">
                                                        @if (lecture.Materials.Count > 1)
                                                        {
                                                            <span class="badge bg-light text-dark">
                                                                @(currentPrimaryIndex + 1) / @lecture.Materials.Count
                                                            </span>
                                                        }
                                                        @if (primaryMaterial.IsDownloadable)
                                                        {
                                                            <button class="btn btn-sm btn-light" 
                                                                    @onclick="async () => await DownloadMaterial(primaryMaterial)">
                                                                <i class="fas fa-download"></i>
                                                            </button>
                                                        }
                                                        <button class="btn btn-sm btn-light" 
                                                                @onclick="() => OpenInFullScreen(primaryMaterial)">
                                                            <i class="fas fa-expand"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="card-body p-0" style="height: 600px;">
                                                    <div class="viewer-container" style="height: 100%; width: 100%;">
                                                        <SecureFileViewer Material="@primaryMaterial" />
                                                    </div>
                                                </div>
                                                @if (!string.IsNullOrEmpty(primaryMaterial.Description))
                                                {
                                                    <div class="card-footer">
                                                        <small class="text-muted">
                                                            <i class="fas fa-info-circle me-1"></i> @primaryMaterial.Description
                                                        </small>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center p-5 border rounded bg-light">
                                                <i class="fas fa-video fa-4x text-muted mb-3"></i>
                                                <h4>Select Content to View</h4>
                                                <p class="text-muted">Choose a material from the dropdown above to start viewing</p>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info mb-4">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-info-circle fa-2x me-3"></i>
                                            <div>
                                                <h5 class="alert-heading">No Content Available</h5>
                                                <p class="mb-0">This lecture doesn't have any materials yet.</p>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Desktop Materials List -->
                                @if (lecture.Materials != null && lecture.Materials.Any())
                                {
                                    <div class="card mb-4">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0">
                                                <i class="fas fa-list me-2"></i> All Materials
                                                <span class="badge bg-secondary ms-2">@lecture.Materials.Count</span>
                                            </h5>
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="list-group list-group-flush">
                                                @foreach (var material in lecture.Materials.OrderBy(m => m.Order))
                                                {
                                                    <div class="list-group-item list-group-item-action @(primaryMaterial?.Id == material.Id ? "active" : "") material-list-item" 
                                                         @onclick="() => SetPrimaryMaterial(material)">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div class="d-flex align-items-center">
                                                                <div class="me-3 text-center" style="width: 40px;">
                                                                    <i class="@GetMaterialIcon(material) fa-lg @(primaryMaterial?.Id == material.Id ? "text-white" : "text-primary")"></i>
                                                                </div>
                                                                <div>
                                                                    <h6 class="mb-1 @(primaryMaterial?.Id == material.Id ? "text-white" : "")">
                                                                        @material.Title
                                                                        @if (primaryMaterial?.Id == material.Id)
                                                                        {
                                                                            <span class="badge bg-light text-primary ms-2">Current</span>
                                                                        }
                                                                    </h6>
                                                                    <small class="@(primaryMaterial?.Id == material.Id ? "text-white-75" : "text-muted")">
                                                                        <span class="badge @(primaryMaterial?.Id == material.Id ? "bg-light text-dark" : "bg-secondary") me-2">
                                                                            @material.Type
                                                                        </span>
                                                                        @if (material.DurationSeconds > 0)
                                                                        {
                                                                            <span class="me-2">
                                                                                <i class="fas fa-clock me-1"></i> @FormatDuration(material.DurationSeconds)
                                                                            </span>
                                                                        }
                                                                        <span>
                                                                            <i class="fas fa-hdd me-1"></i> @FormatFileSize(material.FileSize)
                                                                        </span>
                                                                    </small>
                                                                </div>
                                                            </div>
                                                            <div class="d-flex gap-1">
                                                                @if (material.IsDownloadable)
                                                                {
                                                                    <button class="btn btn-sm @(primaryMaterial?.Id == material.Id ? "btn-light" : "btn-outline-primary")" 
                                                                            @onclick:preventDefault
                                                                            @onclick="async () => await DownloadMaterial(material)">
                                                                        <i class="fas fa-download"></i>
                                                                    </button>
                                                                }
                                                                <button class="btn btn-sm @(primaryMaterial?.Id == material.Id ? "btn-light" : "btn-outline-secondary")" 
                                                                        @onclick:preventDefault
                                                                        @onclick="async () => await OpenInNewTab(material)">
                                                                    <i class="fas fa-external-link-alt"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Desktop Lecture Info -->
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="mb-0">Lecture Information</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <table class="table table-sm">
                                                    <tbody>
                                                        <tr><th>Lecture ID:</th><td>@lecture.Id</td></tr>
                                                        <tr><th>Course ID:</th><td>@lecture.CourseId</td></tr>
                                                        <tr><th>Order:</th><td>@lecture.Order</td></tr>
                                                        <tr><th>Duration:</th><td>@lecture.EstimatedDurationMinutes minutes</td></tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="col-md-6">
                                                <table class="table table-sm">
                                                    <tbody>
                                                        <tr><th>Price:</th><td>@(lecture.IsFreePreview ? "Free" : $"${lecture.Price:N2}")</td></tr>
                                                        <tr><th>Materials:</th><td>@(lecture.Materials?.Count ?? 0)</td></tr>
                                                        <tr><th>Created:</th><td>@lecture.CreatedAt.ToString("MMM dd, yyyy")</td></tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Desktop Sidebar -->
                    <div class="col-lg-4">
                        <!-- Navigation Actions -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h6 class="mb-0">Navigation</h6>
                            </div>
                            <div class="card-body">
                                <div class="d-grid gap-2">
                                    <button class="btn btn-primary" @onclick="NavigateToCourse">
                                        <i class="fas fa-book me-2"></i> View Course
                                    </button>
                                    <button class="btn btn-outline-secondary" @onclick="GoBack">
                                        <i class="fas fa-arrow-left me-2"></i> Back
                                    </button>
                                    @if (primaryMaterial != null)
                                    {
                                        <button class="btn btn-outline-primary" @onclick="() => OpenInFullScreen(primaryMaterial)">
                                            <i class="fas fa-expand me-2"></i> Full Screen
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Content Stats -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h6 class="mb-0">Content Stats</h6>
                            </div>
                            <div class="card-body">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="stat-card p-3 bg-light rounded text-center">
                                            <i class="fas fa-file-alt fa-2x text-primary mb-2"></i>
                                            <h5 class="mb-0">@(lecture.Materials?.Count ?? 0)</h5>
                                            <small class="text-muted">Files</small>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="stat-card p-3 bg-light rounded text-center">
                                            <i class="fas fa-play-circle fa-2x text-success mb-2"></i>
                                            <h5 class="mb-0">@GetVideoCount()</h5>
                                            <small class="text-muted">Videos</small>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="stat-card p-3 bg-light rounded text-center">
                                            <i class="fas fa-download fa-2x text-info mb-2"></i>
                                            <h5 class="mb-0">@GetDownloadableCount()</h5>
                                            <small class="text-muted">Downloadable</small>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="stat-card p-3 bg-light rounded text-center">
                                            <i class="fas fa-clock fa-2x text-warning mb-2"></i>
                                            <h5 class="mb-0">@GetTotalDuration()</h5>
                                            <small class="text-muted">Minutes</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Current Content Info -->
                        @if (primaryMaterial != null)
                        {
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h6 class="mb-0">Currently Viewing</h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex align-items-start mb-3">
                                        <i class="@GetMaterialIcon(primaryMaterial) fa-2x me-3 mt-1"></i>
                                        <div>
                                            <h6 class="mb-1">@primaryMaterial.Title</h6>
                                            <small class="text-muted d-block">@GetMaterialTypeName(primaryMaterial.Type)</small>
                                            @if (primaryMaterial.DurationSeconds > 0)
                                            {
                                                <small class="text-muted">
                                                    <i class="fas fa-clock me-1"></i> @FormatDuration(primaryMaterial.DurationSeconds)
                                                </small>
                                            }
                                        </div>
                                    </div>
                                    
                                    <div class="d-grid gap-2">
                                        @if (primaryMaterial.IsDownloadable)
                                        {
                                            <button class="btn btn-sm btn-outline-primary" 
                                                    @onclick="async () => await DownloadMaterial(primaryMaterial)">
                                                <i class="fas fa-download me-1"></i> Download
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-outline-secondary" 
                                                @onclick="async () => await OpenInNewTab(primaryMaterial)">
                                            <i class="fas fa-external-link-alt me-1"></i> Open in New Tab
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Action Buttons -->
                        <div class="card">
                            <div class="card-header">
                                <h6 class="mb-0">Actions</h6>
                            </div>
                            <div class="card-body">
                                <div class="d-grid gap-2">
                                    @if (lecture.IsFreePreview)
                                    {
                                        <button class="btn btn-success" @onclick="EnrollInLecture">
                                            <i class="fas fa-play-circle me-2"></i> Start Learning
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-warning" @onclick="PurchaseLecture">
                                            <i class="fas fa-shopping-cart me-2"></i> Purchase ($@lecture.Price.ToString("N2"))
                                        </button>
                                    }
                                    
                                    <button class="btn btn-outline-info" @onclick="ShareLecture">
                                        <i class="fas fa-share-alt me-2"></i> Share Lecture
                                    </button>
                                    
                                    @if (lecture.Materials?.Any(m => m.IsDownloadable) == true)
                                    {
                                        <button class="btn btn-outline-primary" @onclick="DownloadAllMaterials">
                                            <i class="fas fa-download me-2"></i> Download All Materials
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Layout (below lg) -->
            <div class="d-block d-lg-none">
                <div class="pb-5 mb-4"> <!-- Spacing for bottom nav -->
                    <!-- Content Tab -->
                    @if (mobileTab == "content")
                    {
                        <div class="px-3">
                            <div class="mt-3">
                                <h6 class="fw-bold mb-3">
                                    <i class="fas fa-play-circle me-2 text-primary"></i>Current Content
                                </h6>
                                
                                @if (lecture.Materials != null && lecture.Materials.Any())
                                {
                                    <!-- Material Selector -->
                                    <div class="mb-3">
                                        <select class="form-select" @onchange="OnMobileMaterialChange">
                                            @foreach (var material in lecture.Materials.OrderBy(m => m.Order))
                                            {
                                                @if (primaryMaterial?.Id == material.Id)
                                                {
                                                    <option value="@material.Id" selected>
                                                        @material.Title (@material.Type)
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@material.Id">
                                                        @material.Title (@material.Type)
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    
                                    <!-- Mobile Viewer -->
                                    @if (primaryMaterial != null)
                                    {
                                        <div class="card mb-3">
                                            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                                                <small class="text-truncate">@primaryMaterial.Title</small>
                                                <div class="d-flex gap-2">
                                                    @if (primaryMaterial.IsDownloadable)
                                                    {
                                                        <button class="btn btn-sm btn-light py-0" 
                                                                @onclick="async () => await DownloadMaterial(primaryMaterial)">
                                                            <i class="fas fa-download"></i>
                                                        </button>
                                                    }
                                                    <button class="btn btn-sm btn-light py-0" 
                                                            @onclick="() => OpenInFullScreen(primaryMaterial)">
                                                        <i class="fas fa-expand"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="card-body p-0" style="height: 50vh;">
                                                <div class="viewer-container" style="height: 100%; width: 100%;">
                                                    <SecureFileViewer Material="@primaryMaterial" />
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Navigation Buttons -->
                                        @if (lecture.Materials.Count > 1)
                                        {
                                            <div class="d-flex justify-content-between gap-2 mb-3">
                                                <button class="btn btn-outline-primary flex-fill" 
                                                        @onclick="ShowPreviousContent"
                                                        disabled="@(currentPrimaryIndex <= 0)">
                                                    <i class="fas fa-chevron-left me-1"></i> Previous
                                                </button>
                                                <button class="btn btn-outline-primary flex-fill" 
                                                        @onclick="ShowNextContent"
                                                        disabled="@(currentPrimaryIndex >= lecture.Materials.Count - 1)">
                                                    Next <i class="fas fa-chevron-right ms-1"></i>
                                                </button>
                                            </div>
                                        }
                                        
                                        <!-- Material Info -->
                                        <div class="card bg-light">
                                            <div class="card-body py-2">
                                                <small class="d-block">
                                                    <i class="fas fa-info-circle me-1 text-primary"></i>
                                                    @(!string.IsNullOrEmpty(primaryMaterial.Description) ? primaryMaterial.Description : "No description available")
                                                </small>
                                                <small class="d-block mt-1">
                                                    <i class="fas fa-hdd me-1 text-primary"></i> Size: @FormatFileSize(primaryMaterial.FileSize)
                                                    @if (primaryMaterial.DurationSeconds > 0)
                                                    {
                                                        <span class="ms-2"><i class="fas fa-clock me-1 text-primary"></i> @FormatDuration(primaryMaterial.DurationSeconds)</span>
                                                    }
                                                </small>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-info">
                                        <p class="mb-0">No content available for this lecture.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Materials Tab -->
                    @if (mobileTab == "materials")
                    {
                        <div class="px-3">
                            <div class="mt-3">
                                <h6 class="fw-bold mb-3">
                                    <i class="fas fa-list me-2 text-primary"></i>All Materials
                                    <span class="badge bg-secondary ms-2">@lecture.Materials?.Count</span>
                                </h6>
                                
                                @if (lecture.Materials != null && lecture.Materials.Any())
                                {
                                    <div class="list-group">
                                        @foreach (var material in lecture.Materials.OrderBy(m => m.Order))
                                        {
                                            <div class="list-group-item @(primaryMaterial?.Id == material.Id ? "active" : "") p-2">
                                                <div class="d-flex align-items-center">
                                                    <div class="me-2">
                                                        <i class="@GetMaterialIcon(material) fa-lg @(primaryMaterial?.Id == material.Id ? "text-white" : "text-primary")"></i>
                                                    </div>
                                                    <div class="flex-grow-1 min-width-0">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <h6 class="mb-0 text-truncate @(primaryMaterial?.Id == material.Id ? "text-white" : "")">@material.Title</h6>
                                                            <small class="@(primaryMaterial?.Id == material.Id ? "text-white-75" : "text-muted") ms-2">@FormatFileSize(material.FileSize)</small>
                                                        </div>
                                                        <div class="d-flex gap-2 small">
                                                            <span class="badge @(primaryMaterial?.Id == material.Id ? "bg-light text-dark" : "bg-secondary")">@material.Type</span>
                                                            @if (material.DurationSeconds > 0)
                                                            {
                                                                <span class="@(primaryMaterial?.Id == material.Id ? "text-white-75" : "text-muted")">
                                                                    <i class="fas fa-clock me-1"></i>@FormatDuration(material.DurationSeconds)
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="d-flex gap-1 ms-2">
                                                        <button class="btn btn-sm @(primaryMaterial?.Id == material.Id ? "btn-light" : "btn-outline-primary")" 
                                                                @onclick="() => SetPrimaryMaterial(material)"
                                                                title="View">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                        @if (material.IsDownloadable)
                                                        {
                                                            <button class="btn btn-sm @(primaryMaterial?.Id == material.Id ? "btn-light" : "btn-outline-primary")" 
                                                                    @onclick="async () => await DownloadMaterial(material)"
                                                                    title="Download">
                                                                <i class="fas fa-download"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted text-center py-3">No materials available</p>
                                }
                            </div>
                        </div>
                    }

                    <!-- Info Tab -->
                    @if (mobileTab == "info")
                    {
                        <div class="px-3">
                            <div class="mt-3">
                                <h6 class="fw-bold mb-3">
                                    <i class="fas fa-info-circle me-2 text-primary"></i>Lecture Information
                                </h6>
                                
                                <!-- Lecture Header Info -->
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <h5 class="card-title">@lecture.Title</h5>
                                        <div class="d-flex gap-2 mb-2">
                                            @if (lecture.IsFreePreview)
                                            {
                                                <span class="badge bg-success">Free Preview</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">$@lecture.Price.ToString("N2")</span>
                                            }
                                            <span class="badge bg-secondary">Order @lecture.Order</span>
                                        </div>
                                        <p class="card-text">@(string.IsNullOrEmpty(lecture.Description) ? "No description provided." : lecture.Description)</p>
                                    </div>
                                </div>
                                
                                <!-- Content Stats -->
                                <div class="card mb-3">
                                    <div class="card-header">
                                        <h6 class="mb-0">Content Stats</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <div class="stat-card p-3 bg-light rounded text-center">
                                                    <i class="fas fa-file-alt fa-2x text-primary mb-2"></i>
                                                    <h5 class="mb-0">@(lecture.Materials?.Count ?? 0)</h5>
                                                    <small class="text-muted">Files</small>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="stat-card p-3 bg-light rounded text-center">
                                                    <i class="fas fa-play-circle fa-2x text-success mb-2"></i>
                                                    <h5 class="mb-0">@GetVideoCount()</h5>
                                                    <small class="text-muted">Videos</small>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="stat-card p-3 bg-light rounded text-center">
                                                    <i class="fas fa-download fa-2x text-info mb-2"></i>
                                                    <h5 class="mb-0">@GetDownloadableCount()</h5>
                                                    <small class="text-muted">Downloadable</small>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="stat-card p-3 bg-light rounded text-center">
                                                    <i class="fas fa-clock fa-2x text-warning mb-2"></i>
                                                    <h5 class="mb-0">@GetTotalDuration()</h5>
                                                    <small class="text-muted">Minutes</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Details Table -->
                                <div class="card">
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tbody>
                                                <tr><th>Lecture ID:</th><td>@lecture.Id</td></tr>
                                                <tr><th>Course ID:</th><td>@lecture.CourseId</td></tr>
                                                <tr><th>Duration:</th><td>@lecture.EstimatedDurationMinutes minutes</td></tr>
                                                <tr><th>Materials:</th><td>@(lecture.Materials?.Count ?? 0)</td></tr>
                                                <tr><th>Created:</th><td>@lecture.CreatedAt.ToString("MMM dd, yyyy")</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Actions Tab -->
                    @if (mobileTab == "actions")
                    {
                        <div class="px-3">
                            <div class="mt-3">
                                <h6 class="fw-bold mb-3">
                                    <i class="fas fa-ellipsis-h me-2 text-primary"></i>Actions
                                </h6>
                                
                                <div class="d-grid gap-2">
                                    <!-- Purchase/Enroll -->
                                    @if (lecture.IsFreePreview)
                                    {
                                        <button class="btn btn-success btn-lg" @onclick="EnrollInLecture">
                                            <i class="fas fa-play-circle me-2"></i> Start Learning
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-warning btn-lg" @onclick="PurchaseLecture">
                                            <i class="fas fa-shopping-cart me-2"></i> Purchase ($@lecture.Price.ToString("N2"))
                                        </button>
                                    }
                                    
                                    <!-- Navigation -->
                                    <button class="btn btn-primary" @onclick="NavigateToCourse">
                                        <i class="fas fa-book me-2"></i> View Course
                                    </button>
                                    
                                    <!-- Current Material Actions -->
                                    @if (primaryMaterial != null)
                                    {
                                        <div class="card mt-3">
                                            <div class="card-header">
                                                <h6 class="mb-0">Current Material</h6>
                                            </div>
                                            <div class="card-body">
                                                <p class="mb-2 fw-bold">@primaryMaterial.Title</p>
                                                <div class="d-grid gap-2">
                                                    <button class="btn btn-outline-primary" @onclick="() => OpenInFullScreen(primaryMaterial)">
                                                        <i class="fas fa-expand me-2"></i> Full Screen
                                                    </button>
                                                    @if (primaryMaterial.IsDownloadable)
                                                    {
                                                        <button class="btn btn-outline-primary" @onclick="async () => await DownloadMaterial(primaryMaterial)">
                                                            <i class="fas fa-download me-2"></i> Download
                                                        </button>
                                                    }
                                                    <button class="btn btn-outline-secondary" @onclick="async () => await OpenInNewTab(primaryMaterial)">
                                                        <i class="fas fa-external-link-alt me-2"></i> Open in New Tab
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    
                                    <!-- Bulk Actions -->
                                    @if (lecture.Materials?.Any(m => m.IsDownloadable) == true)
                                    {
                                        <button class="btn btn-outline-primary mt-2" @onclick="DownloadAllMaterials">
                                            <i class="fas fa-download me-2"></i> Download All Materials
                                        </button>
                                    }
                                    
                                    <!-- Share -->
                                    <button class="btn btn-outline-info" @onclick="ShareLecture">
                                        <i class="fas fa-share-alt me-2"></i> Share Lecture
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Full Screen Modal (same for both) -->
@if (fullScreenMaterial != null)
{
    <div class="modal-backdrop show" style="z-index: 1040;"></div>
    
    <div class="modal show d-block" tabindex="-1" style="z-index: 1050;">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content border-0 rounded-0 bg-dark text-white">
                <!-- Modal Header - Responsive -->
                <div class="modal-header border-bottom border-secondary" style="background-color: rgba(0,0,0,0.9);">
                    <div class="d-flex align-items-center w-100">
                        <i class="@GetMaterialIcon(fullScreenMaterial) me-2 me-lg-3 fa-lg"></i>
                        <div class="flex-grow-1 min-width-0">
                            <h5 class="modal-title mb-0 text-truncate">@fullScreenMaterial.Title</h5>
                            <small class="text-light opacity-75 d-none d-md-block">
                                @fullScreenMaterial.Description
                            </small>
                        </div>
                        
                        <!-- Navigation -->
                        @if (lecture?.Materials?.Count > 1)
                        {
                            <div class="d-flex align-items-center gap-1 gap-lg-3 me-2 me-lg-3">
                                <button class="btn btn-sm btn-outline-light" 
                                        @onclick="ShowPreviousContent" 
                                        title="Previous">
                                    <i class="fas fa-chevron-left"></i>
                                </button>
                                <span class="text-light d-none d-md-inline">
                                    @(currentPrimaryIndex + 1) / @lecture.Materials.Count
                                </span>
                                <span class="text-light d-md-none">
                                    @(currentPrimaryIndex + 1)/@lecture.Materials.Count
                                </span>
                                <button class="btn btn-sm btn-outline-light" 
                                        @onclick="ShowNextContent" 
                                        title="Next">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                        }
                        
                        <!-- Action Buttons -->
                        <div class="d-flex gap-1 gap-lg-2">
                            @if (fullScreenMaterial.IsDownloadable)
                            {
                                <button class="btn btn-sm btn-outline-light" 
                                        @onclick="async () => await DownloadMaterial(fullScreenMaterial)"
                                        title="Download">
                                    <i class="fas fa-download"></i>
                                </button>
                            }
                            <button class="btn btn-sm btn-outline-light" 
                                    @onclick="CloseFullScreen"
