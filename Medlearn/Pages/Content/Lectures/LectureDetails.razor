@page "/lectureinfo/{LectureId:int}"


<PageTitle>@(lecture?.Title ?? "Lecture Details")</PageTitle>

<div class="content-details lecture-details">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading lecture details...</p>
        </div>
    }
    else if (lecture == null)
    {
        <div class="alert alert-danger m-3">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Lecture not found
        </div>
    }
    else
    {
        <!-- Mobile Header (Fixed) -->
        <div class="d-block d-lg-none mobile-header">
            <div class="mobile-header-content">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-dark p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <div class="flex-grow-1">
                        <h6 class="mb-0 text-truncate">@lecture.Title</h6>
                        @if (course != null)
                        {
                            <small class="text-muted text-truncate d-block">@course.Title</small>
                        }
                    </div>
                    @if (!isEnrolled)
                    {
                        <button class="btn btn-warning btn-sm ms-2" @onclick="ScrollToEnrollment">
                            <i class="fas fa-shopping-cart me-1"></i> Enroll
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Desktop Breadcrumb (Hidden on Mobile) -->
        <div class="d-none d-lg-block container-fluid mt-3">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/browse">Browse</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="/lectures">Lectures</a>
                    </li>
                    @if (course != null)
                    {
                        <li class="breadcrumb-item">
                            <a href="/course/@course.Id">@course.Title</a>
                        </li>
                    }
                    <li class="breadcrumb-item active" aria-current="page">
                        @lecture.Title
                        @if (isEnrolled)
                        {
                            <span class="badge bg-success ms-2">Enrolled</span>
                        }
                    </li>
                </ol>
            </nav>
        </div>

        <div class="container-fluid">
            <!-- Desktop Back Button (Hidden on Mobile) -->
            <div class="d-none d-lg-block mb-4">
                @if (course != null)
                {
                    <button class="btn btn-outline-secondary" @onclick="GoBackToCourse">
                        <i class="fas fa-arrow-left me-2"></i> Back to @course.Title
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-secondary" @onclick="GoBack">
                        <i class="fas fa-arrow-left me-2"></i> Back to Lectures
                    </button>
                }
            </div>

            <!-- Mobile Spacer for Fixed Header -->
            <div class="d-block d-lg-none" style="height: 60px;"></div>

            <div class="row">
                <!-- Main Content Column -->
                <div class="col-lg-8">
                    <!-- Header Card -->
                    <div class="card content-header-card mb-4">
                        <div class="card-body p-3 p-lg-4">
                            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start mb-3">
                                <div class="w-100">
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                        <span class="content-type-badge badge bg-warning">Lecture</span>
                                        @if (lecture.IsFreePreview)
                                        {
                                            <span class="badge bg-info">
                                                <i class="fas fa-unlock me-1"></i> Free Preview
                                            </span>
                                        }
                                        @if (isEnrolled)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle me-1"></i> Enrolled
                                            </span>
                                        }
                                    </div>
                                    <h1 class="content-title mb-2">@lecture.Title</h1>
                                    @if (course != null)
                                    {
                                        <div class="content-parent mb-2">
                                            <i class="fas fa-book me-2"></i>
                                            Part of: 
                                            <a href="/course/@course.Id" 
                                               class="text-decoration-none fw-bold">
                                                @course.Title
                                            </a>
                                        </div>
                                    }
                                </div>
                                <div class="content-price mt-3 mt-lg-0">
                                    <div class="price-amount">$@lecture.Price.ToString("N2")</div>
                                    @if (lecture.Price == 0)
                                    {
                                        <div class="price-badge badge bg-success mt-1">FREE</div>
                                    }
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="content-description mb-4">
                                <h4 class="section-title">
                                    <i class="fas fa-info-circle me-2"></i>About This Lecture
                                </h4>
                                <p class="mb-0">@lecture.Description</p>
                            </div>

                            <!-- Stats Row - Responsive Grid -->
                            <div class="row stats-row g-2 g-lg-3 mb-4">
                                <div class="col-4">
                                    <div class="stat-card p-2 p-lg-3">
                                        <div class="stat-icon">
                                            <i class="fas fa-clock"></i>
                                        </div>
                                        <div class="stat-value">@lecture.EstimatedDurationMinutes</div>
                                        <div class="stat-label">Minutes</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="stat-card p-2 p-lg-3">
                                        <div class="stat-icon">
                                            <i class="fas fa-file"></i>
                                        </div>
                                        <div class="stat-value">@(lecture.Materials?.Count ?? 0)</div>
                                        <div class="stat-label">Materials</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="stat-card p-2 p-lg-3">
                                        <div class="stat-icon">
                                            <i class="fas fa-sort-numeric-up"></i>
                                        </div>
                                        <div class="stat-value">@lecture.Order</div>
                                        <div class="stat-label">Order</div>
                                    </div>
                                </div>
                            </div>

                            <!-- What You'll Learn -->
                            <div class="content-section mb-4">
                                <h4 class="section-title">
                                    <i class="fas fa-check-circle text-success me-2"></i>What You'll Learn
                                </h4>
                                <ul class="learn-list">
                                    @if (lecture.Materials != null && lecture.Materials.Any())
                                    {
                                        @foreach (var material in lecture.Materials.Take(3))
                                        {
                                            <li>
                                                <i class="fas fa-check text-success me-2"></i>
                                                Access to: @material.Title
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li><i class="fas fa-check text-success me-2"></i>Comprehensive lecture content</li>
                                    }
                                    <li><i class="fas fa-check text-success me-2"></i>Downloadable resources</li>
                                    <li><i class="fas fa-check text-success me-2"></i>Lifetime access</li>
                                    <li><i class="fas fa-check text-success me-2"></i>Certificate of completion</li>
                                </ul>
                            </div>

                            <!-- Materials Preview - Mobile Accordion Style -->
                            @if (lecture.Materials != null && lecture.Materials.Any())
                            {
                                <div class="content-section mb-4">
                                    <h4 class="section-title d-flex justify-content-between align-items-center"
                                        @onclick="ToggleMaterials" style="cursor: pointer;">
                                        <span>
                                            <i class="fas fa-file-alt me-2"></i>Learning Materials
                                        </span>
                                        <i class="fas @(showMaterials ? "fa-chevron-up" : "fa-chevron-down") d-block d-lg-none"></i>
                                    </h4>
                                    <div class="materials-list @(showMaterials ? "d-block" : "d-none d-lg-block")">
                                        @foreach (var material in lecture.Materials)
                                        {
                                            <div class="material-item card mb-2">
                                                <div class="card-body p-3">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div class="flex-grow-1">
                                                            <div class="d-flex align-items-center">
                                                                @switch (material.Type)
                                                                {
                                                                    case MaterialType.Video:
                                                                        <i class="fas fa-video text-danger me-2"></i>
                                                                        break;
                                                                    case MaterialType.PDF:
                                                                        <i class="fas fa-file-pdf text-danger me-2"></i>
                                                                        break;
                                                                    case MaterialType.Document:
                                                                        <i class="fas fa-file-word text-primary me-2"></i>
                                                                        break;
                                                                    case MaterialType.Audio:
                                                                        <i class="fas fa-music text-primary me-2"></i>
                                                                        break;
                                                                    default:
                                                                        <i class="fas fa-file text-secondary me-2"></i>
                                                                        break;
                                                                }
                                                                <span class="fw-bold">@material.Title</span>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(material.Description))
                                                            {
                                                                <p class="small mb-0 mt-1 text-muted">@material.Description</p>
                                                            }
                                                        </div>
                                                        <div class="text-end ms-2">
                                                            @if (material.DurationSeconds > 0)
                                                            {
                                                                <div class="small text-nowrap">
                                                                    @TimeSpan.FromSeconds(material.DurationSeconds).ToString(@"mm\:ss")
                                                                </div>
                                                            }
                                                            @if (material.FileSize > 0)
                                                            {
                                                                <div class="small text-muted text-nowrap">
                                                                    @GetFileSize(material.FileSize)
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Sidebar Column - Different for Mobile and Desktop -->
                <div class="col-lg-4">
                    <!-- Desktop Sidebar (Sticky) -->
                    <div class="d-none d-lg-block">
                        <!-- Enrollment Card -->
                        <div class="card enrollment-card fix-top" style="top: 20px; z-index: 100;">
                            <div class="card-header bg-warning text-dark">
                                <h5 class="mb-0">Enrollment Options</h5>
                            </div>
                            <div class="card-body">
                                <!-- Inline the HTML instead of using RenderEnrollmentOptions -->
                                <div class="enrollment-options">
                                    <!-- Price Display -->
                                    <div class="text-center mb-4">
                                        <div class="price-display">
                                            $@lecture?.Price.ToString("N2")
                                        </div>
                                        @if (lecture?.Price == 0)
                                        {
                                            <span class="badge bg-success">FREE LECTURE</span>
                                        }
                                        else
                                        {
                                            <small class="text-muted">One-time payment</small>
                                        }
                                    </div>

                                    <!-- Features List -->
                                    <div class="features-list mb-4">
                                        <h6><i class="fas fa-gift me-2"></i>What's Included</h6>
                                        <ul>
                                            <li>
                                                <i class="fas fa-check text-success me-2"></i>
                                                @(lecture?.EstimatedDurationMinutes ?? 0) minutes of content
                                            </li>
                                            <li>
                                                <i class="fas fa-check text-success me-2"></i>
                                                @(lecture?.Materials?.Count ?? 0) learning materials
                                            </li>
                                            <li>
                                                <i class="fas fa-check text-success me-2"></i>
                                                Downloadable resources
                                            </li>
                                            <li>
                                                <i class="fas fa-check text-success me-2"></i>
                                                Lifetime access
                                            </li>
                                        </ul>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="action-buttons">
                                        @if (isEnrolled)
                                        {
                                            <button class="btn btn-success w-100 mb-2" @onclick="AccessLecture">
                                                <i class="fas fa-play me-2"></i> Access Lecture
                                            </button>
                                        }
                                        else
                                        {
                                            @if (lecture?.Price == 0)
                                            {
                                                <button class="btn btn-success w-100 mb-2" @onclick="EnrollFree">
                                                    <i class="fas fa-graduation-cap me-2"></i> Enroll for Free
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-warning w-100 mb-2" @onclick="EnrollNow">
                                                    <i class="fas fa-shopping-cart me-2"></i> Enroll Now
                                                </button>
                                            }

                                            @if (lecture?.IsFreePreview == true)
                                            {
                                                <button class="btn btn-outline-warning w-100" @onclick="ViewFreePreview">
                                                    <i class="fas fa-eye me-2"></i> Try Free Preview
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Lecture Navigation -->
                        @if (courseLectures != null && courseLectures.Any())
                        {
                            <div class="card lecture-navigation-card mt-4">
                                <div class="card-header">
                                    <h6 class="mb-0">Course Lectures (@currentLectureOrder/@totalLectures)</h6>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                                        @foreach (var courseLecture in courseLectures.OrderBy(l => l.Order))
                                        {
                                            <div class="list-group-item @(courseLecture.Id == lecture.Id ? "active" : "")" 
                                                 @onclick="() => ViewLecture(courseLecture.Id)">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="text-truncate me-2">
                                                        <i class="fas fa-play-circle @(courseLecture.Id == lecture.Id ? "text-white" : "text-primary") me-2"></i>
                                                        <span class="@(courseLecture.Id == lecture.Id ? "text-white" : "")">
                                                            @courseLecture.Title
                                                        </span>
                                                    </div>
                                                    <div class="d-flex align-items-center flex-shrink-0">
                                                        @if (courseLecture.IsFreePreview)
                                                        {
                                                            <span class="badge bg-info me-2">Preview</span>
                                                        }
                                                        <small class="@(courseLecture.Id == lecture.Id ? "text-white-50" : "text-muted")">
                                                            @courseLecture.EstimatedDurationMinutes min
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Mobile Sticky Bottom Enrollment Bar -->
                    <div class="d-block d-lg-none">
                        <div class="mobile-enrollment-bar">
                            <div class="container-fluid">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="mobile-price">$@lecture.Price.ToString("N2")</div>
                                        @if (lecture.Price == 0)
                                        {
                                            <span class="badge bg-success">FREE</span>
                                        }
                                    </div>
                                    <div class="d-flex gap-2">
                                        @if (isEnrolled)
                                        {
                                            <button class="btn btn-success" @onclick="AccessLecture">
                                                <i class="fas fa-play me-1"></i> Start
                                            </button>
                                        }
                                        else
                                        {
                                            @if (lecture.Price == 0)
                                            {
                                                <button class="btn btn-success" @onclick="EnrollFree">
                                                    <i class="fas fa-graduation-cap me-1"></i> Enroll Free
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-warning" @onclick="EnrollNow">
                                                    <i class="fas fa-shopping-cart me-1"></i> Enroll
                                                </button>
                                            }
                                            @if (lecture.IsFreePreview)
                                            {
                                                <button class="btn btn-outline-warning" @onclick="ViewFreePreview">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Mobile Lecture Navigation (Collapsible) -->
                    @if (courseLectures != null && courseLectures.Any())
                    {
                        <div class="d-block d-lg-none mt-3">
                            <div class="card">
                                <div class="card-header bg-light" 
                                     @onclick="ToggleLectureNav" 
                                     style="cursor: pointer;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0">
                                            <i class="fas fa-list me-2"></i>
                                            Course Lectures (@currentLectureOrder/@totalLectures)
                                        </h6>
                                        <i class="fas @(showLectureNav ? "fa-chevron-up" : "fa-chevron-down")"></i>
                                    </div>
                                </div>
                                @if (showLectureNav)
                                {
                                    <div class="card-body p-0">
                                        <div class="list-group list-group-flush">
                                            @foreach (var courseLecture in courseLectures.OrderBy(l => l.Order))
                                            {
                                                <div class="list-group-item @(courseLecture.Id == lecture.Id ? "active" : "") p-2" 
                                                     @onclick="() => ViewLecture(courseLecture.Id)">
                                                    <div class="d-flex align-items-center">
                                                        <div class="flex-grow-1 me-2">
                                                            <div class="d-flex align-items-center">
                                                                <i class="fas fa-play-circle @(courseLecture.Id == lecture.Id ? "text-white" : "text-primary") me-2"></i>
                                                                <span class="small @(courseLecture.Id == lecture.Id ? "text-white" : "") text-truncate">
                                                                    @courseLecture.Title
                                                                </span>
                                                            </div>
                                                        </div>
                                                        <div class="d-flex align-items-center flex-shrink-0">
                                                            @if (courseLecture.IsFreePreview)
                                                            {
                                                                <span class="badge bg-info me-2">Preview</span>
                                                            }
                                                            <small class="@(courseLecture.Id == lecture.Id ? "text-white-50" : "text-muted")">
                                                                @courseLecture.EstimatedDurationMinutes min
                                                            </small>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Mobile Spacer for Bottom Bar -->
            <div class="d-block d-lg-none" style="height: 80px;"></div>
        </div>
    }
</div>

<!-- Enrollment Options Component -->
@code {
    [Parameter] public int LectureId { get; set; }
    
    private LectureDto? lecture;
    private CourseDto? course;
    private List<LectureDto> courseLectures = new();
    private bool isLoading = true;
    private bool isEnrolled = false;
    private bool isAuthenticated = false;
    private UserDto? currentUser;
    private int currentLectureOrder = 0;
    private int totalLectures = 0;
    
    // UI State
    private bool showMaterials = true;
    private bool showLectureNav = false;
    
    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
        await LoadData();
    }
    
    protected override async Task OnParametersSetAsync()
    {
        if (ParameterChanged())
        {
            await LoadData();
        }
    }
    
    private bool ParameterChanged()
    {
        return lecture?.Id != LectureId;
    }
    
    private async Task CheckAuthentication()
    {
        isAuthenticated = await TokenService.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
            currentUser = await AuthService.GetCurrentUserAsync();
        }
    }
    
    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();
        
        try
        {
            lecture = null;
            course = null;
            courseLectures = new();
            
            lecture = await LectureService.GetLectureAsync(LectureId);
            
            if (lecture != null)
            {
                currentLectureOrder = lecture.Order;
                
                if (lecture.CourseId > 0)
                {
                    course = await CourseService.GetCourseAsync(lecture.CourseId);
                    
                    if (course != null)
                    {
                        var lectures = await LectureService.GetLecturesByCourseAsync(course.Id);
                        courseLectures = lectures?.ToList() ?? new List<LectureDto>();
                        totalLectures = courseLectures.Count;
                    }
                }
                
                if (isAuthenticated)
                {
                    await CheckEnrollmentStatus();
                }
            }
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Error loading lecture: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    
    private async Task CheckEnrollmentStatus()
    {
        try
        {
            var enrollments = await EnrollmentService.GetMyEnrollmentsAsync();
            isEnrolled = enrollments?.Any(e => 
                e.LectureId == LectureId || 
                (e.CourseId == lecture?.CourseId && e.EnrollmentType == EnrollmentType.Course) ||
                (course?.SpecializationId > 0 && e.SpecializationId == course.SpecializationId)
            ) ?? false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking enrollment: {ex.Message}");
            isEnrolled = false;
        }
    }
    
    // Helper methods
    private string GetImageUrl(string? url) => ImageUrlService.GetImageUrl(url);
    
    private string GetFileSize(long bytes)
    {
        if (bytes == 0) return "0 B";
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double len = bytes;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
    
    // UI Interaction Methods
    private void ToggleMaterials()
    {
        showMaterials = !showMaterials;
    }
    
    private void ToggleLectureNav()
    {
        showLectureNav = !showLectureNav;
    }
    
    private async void ScrollToEnrollment()
    {
        await JS.InvokeVoidAsync("scrollToElement", ".mobile-enrollment-bar");
    }
    
    // Navigation methods
    private void GoBack()
    {
        Navigation.NavigateTo("/lectures");
    }
    
    private void GoBackToCourse()
    {
        if (course != null)
        {
            Navigation.NavigateTo($"/course/{course.Id}");
        }
        else
        {
            GoBack();
        }
    }
    
    private void AccessLecture()
    {
        Navigation.NavigateTo($"/lecture/{LectureId}");
    }
    
    private void EnrollNow()
    {
        if (!isAuthenticated)
        {
            Navigation.NavigateTo($"/account/login?returnUrl=/lecture/{LectureId}");
            return;
        }
        Navigation.NavigateTo($"/student/payments/make?type=Lecture&id={LectureId}");
    }
    
    private async Task EnrollFree()
    {
        if (!isAuthenticated)
        {
            Navigation.NavigateTo($"/account/login?returnUrl=/lecture/{LectureId}");
            return;
        }
        try
        {
            var enrollment = await EnrollmentService.CreateEnrollmentAsync(new CreateEnrollmentDto
            {
                EnrollmentType = EnrollmentType.Lecture,
                LectureId = LectureId
            });
            
            if (enrollment != null)
            {
                await ShowToast("success", "Successfully enrolled!");
                isEnrolled = true;
                await CheckEnrollmentStatus();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await ShowToast("error", $"Enrollment failed: {ex.Message}");
        }
    }
    
    private void ViewFreePreview()
    {
        Navigation.NavigateTo($"/lecture/{LectureId}");
    }
    
    private void ViewCourse(int courseId)
    {
        Navigation.NavigateTo($"/course/{courseId}");
    }
    
    private void ViewLecture(int lectureId)
    {
        if (lectureId != LectureId)
        {
            showLectureNav = false; // Close mobile nav after navigation
            Navigation.NavigateTo($"/lectureinfo/{lectureId}", forceLoad: true);
        }
    }
    
    private async Task ShowToast(string type, string message)
    {
        await JS.InvokeVoidAsync("showToast", type, message);
    }
    
    [Inject] private HttpClient _httpClient { get; set; } = default!;
}

<!-- RenderFragment for Enrollment Options -->
@code {
    private class RenderEnrollmentOptions : ComponentBase
    {
        [Parameter] public LectureDto? Lecture { get; set; }
        [Parameter] public bool IsEnrolled { get; set; }
        [Parameter] public bool IsAuthenticated { get; set; }
        [Parameter] public EventCallback EnrollNow { get; set; }
        [Parameter] public EventCallback EnrollFree { get; set; }
        [Parameter] public EventCallback AccessLecture { get; set; }
        [Parameter] public EventCallback ViewFreePreview { get; set; }

        protected override void BuildRenderTree(RenderTreeBuilder builder)
        {
            if (Lecture == null) return;

            builder.OpenElement(0, "div");
            
            // Price Display
            builder.OpenElement(1, "div");
            builder.AddAttribute(2, "class", "text-center mb-4");
            
            builder.OpenElement(3, "div");
            builder.AddAttribute(4, "class", "price-display");
            builder.AddContent(5, $"${Lecture.Price.ToString("N2")}");
            builder.CloseElement();
            
            if (Lecture.Price == 0)
            {
                builder.OpenElement(6, "span");
                builder.AddAttribute(7, "class", "badge bg-success");
                builder.AddContent(8, "FREE LECTURE");
                builder.CloseElement();
            }
            else
            {
                builder.OpenElement(9, "small");
                builder.AddAttribute(10, "class", "text-muted");
                builder.AddContent(11, "One-time payment");
                builder.CloseElement();
            }
            
            builder.CloseElement();

            // Features List
            builder.OpenElement(12, "div");
            builder.AddAttribute(13, "class", "features-list mb-4");
            
            builder.OpenElement(14, "h6");
            builder.AddContent(15, new MarkupString("<i class=\"fas fa-gift me-2\"></i>What's Included"));
            builder.CloseElement();
            
            builder.OpenElement(16, "ul");
            
            builder.OpenElement(17, "li");
            builder.AddContent(18, new MarkupString("<i class=\"fas fa-check text-success me-2\"></i>"));
            builder.AddContent(19, $"{Lecture.EstimatedDurationMinutes} minutes of content");
            builder.CloseElement();
            
            builder.OpenElement(20, "li");
            builder.AddContent(21, new MarkupString("<i class=\"fas fa-check text-success me-2\"></i>"));
            builder.AddContent(22, $"{(Lecture.Materials?.Count ?? 0)} learning materials");
            builder.CloseElement();
            
            builder.OpenElement(23, "li");
            builder.AddContent(24, new MarkupString("<i class=\"fas fa-check text-success me-2\"></i>Downloadable resources"));
            builder.CloseElement();
            
            builder.OpenElement(25, "li");
            builder.AddContent(26, new MarkupString("<i class=\"fas fa-check text-success me-2\"></i>Lifetime access"));
            builder.CloseElement();
            
            builder.CloseElement();
            builder.CloseElement();

            // Action Buttons
            builder.OpenElement(27, "div");
            builder.AddAttribute(28, "class", "action-buttons");

            if (IsEnrolled)
            {
                builder.OpenElement(29, "button");
                builder.AddAttribute(30, "class", "btn btn-success w-100 mb-2");
                builder.AddAttribute(31, "onclick", EventCallback.Factory.Create(this, AccessLecture));
                builder.AddContent(32, new MarkupString("<i class=\"fas fa-play me-2\"></i> Access Lecture"));
                builder.CloseElement();
            }
            else
            {
                if (Lecture.Price == 0)
                {
                    builder.OpenElement(33, "button");
                    builder.AddAttribute(34, "class", "btn btn-success w-100 mb-2");
                    builder.AddAttribute(35, "onclick", EventCallback.Factory.Create(this, EnrollFree));
                    builder.AddContent(36, new MarkupString("<i class=\"fas fa-graduation-cap me-2\"></i> Enroll for Free"));
                    builder.CloseElement();
                }
                else
                {
                    builder.OpenElement(37, "button");
                    builder.AddAttribute(38, "class", "btn btn-warning w-100 mb-2");
                    builder.AddAttribute(39, "onclick", EventCallback.Factory.Create(this, EnrollNow));
                    builder.AddContent(40, new MarkupString("<i class=\"fas fa-shopping-cart me-2\"></i> Enroll Now"));
                    builder.CloseElement();
                }

                if (Lecture.IsFreePreview)
                {
                    builder.OpenElement(41, "button");
                    builder.AddAttribute(42, "class", "btn btn-outline-warning w-100");
                    builder.AddAttribute(43, "onclick", EventCallback.Factory.Create(this, ViewFreePreview));
                    builder.AddContent(44, new MarkupString("<i class=\"fas fa-eye me-2\"></i> Try Free Preview"));
                    builder.CloseElement();
                }
            }

            builder.CloseElement();
            builder.CloseElement();
        }
    }
}

