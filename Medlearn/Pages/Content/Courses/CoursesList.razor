@page "/courses"


<PageTitle>Browse Courses</PageTitle>

<div class="browse-courses">
    <div class="container-fluid px-0 px-md-3">
        <!-- Header - Responsive -->
        <div class="row g-0 g-md-3 mb-3 mb-md-4">
            <div class="col-12">
                <!-- Mobile Header -->
                <div class="d-block d-md-none">
                    <div class="bg-primary text-white p-3">
                        <div class="d-flex align-items-center">
                            <button class="btn btn-link text-white p-0 me-3" @onclick="GoToHome">
                                <i class="fas fa-arrow-left fa-lg"></i>
                            </button>
                            <div class="flex-grow-1">
                                <h5 class="mb-0">Browse Courses</h5>
                                <small class="opacity-75">Expand your skills</small>
                            </div>
                            <button class="btn btn-link text-white p-0" @onclick="ToggleMobileFilters">
                                <i class="fas fa-sliders-h fa-lg"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Mobile Search Bar -->
                    <div class="p-3 border-bottom bg-white">
                        <div class="input-group">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Search courses..."
                                   @bind="searchTerm" @bind:event="oninput"
                                   @onkeypress="@(async (e) => { if (e.Key == "Enter") await SearchCourses(); })" />
                            <button class="btn btn-primary btn-sm" @onclick="SearchCourses">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Desktop Header -->
                <div class="d-none d-md-block">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1>Browse Courses</h1>
                            <p class="text-muted mb-0">Discover individual courses to expand your skills</p>
                        </div>
                        <div class="search-box" style="width: 300px;">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Search courses..."
                                       @bind="searchTerm" @bind:event="oninput"
                                       @onkeypress="@(async (e) => { if (e.Key == "Enter") await SearchCourses(); })" />
                                <button class="btn btn-primary" @onclick="SearchCourses">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mobile Filters Sidebar -->
        <div class="mobile-filters-overlay @(showMobileFilters ? "show" : "")" @onclick="CloseMobileFilters">
            <div class="mobile-filters-sidebar @(showMobileFilters ? "show" : "")" @onclick:stopPropagation="true">
                <div class="filters-header bg-primary text-white p-3 d-flex align-items-center">
                    <h6 class="mb-0 flex-grow-1">Filter Courses</h6>
                    <button class="btn btn-link text-white p-0" @onclick="CloseMobileFilters">
                        <i class="fas fa-times fa-lg"></i>
                    </button>
                </div>
                <div class="filters-body p-3">
                    <div class="mb-4">
                        <label class="form-label small fw-bold">Specialization</label>
                        <select class="form-select form-select-sm" @bind="selectedSpecializationId" @bind:after="ApplyFilters">
                            <option value="0">All Specializations</option>
                            @if (specializations != null)
                            {
                                @foreach (var spec in specializations)
                                {
                                    <option value="@spec.Id">@spec.Title</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold">Sort By</label>
                        <select class="form-select form-select-sm" @bind="sortBy" @bind:after="ApplyFilters">
                            <option value="popular">Most Popular</option>
                            <option value="rating">Highest Rated</option>
                            <option value="newest">Newest</option>
                            <option value="price-low">Price: Low to High</option>
                            <option value="price-high">Price: High to Low</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold">Price Range</label>
                        <select class="form-select form-select-sm" @bind="priceRange" @bind:after="ApplyFilters">
                            <option value="all">All Prices</option>
                            <option value="free">Free Only</option>
                            <option value="under-25">Under $25</option>
                            <option value="25-50">$25 - $50</option>
                            <option value="50-100">$50 - $100</option>
                            <option value="100-plus">$100+</option>
                        </select>
                    </div>

                    <button class="btn btn-outline-secondary w-100 mt-3" @onclick="ClearFilters">
                        <i class="fas fa-times me-2"></i> Clear All Filters
                    </button>
                </div>
            </div>
        </div>

        <!-- Desktop Filters -->
        <div class="d-none d-md-block row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Specialization</label>
                                <select class="form-select" @bind="selectedSpecializationId" @bind:after="ApplyFilters">
                                    <option value="0">All Specializations</option>
                                    @if (specializations != null)
                                    {
                                        @foreach (var spec in specializations)
                                        {
                                            <option value="@spec.Id">@spec.Title</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Sort By</label>
                                <select class="form-select" @bind="sortBy" @bind:after="ApplyFilters">
                                    <option value="popular">Most Popular</option>
                                    <option value="rating">Highest Rated</option>
                                    <option value="newest">Newest</option>
                                    <option value="price-low">Price: Low to High</option>
                                    <option value="price-high">Price: High to Low</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Price Range</label>
                                <select class="form-select" @bind="priceRange" @bind:after="ApplyFilters">
                                    <option value="all">All Prices</option>
                                    <option value="free">Free Only</option>
                                    <option value="under-25">Under $25</option>
                                    <option value="25-50">$25 - $50</option>
                                    <option value="50-100">$50 - $100</option>
                                    <option value="100-plus">$100+</option>
                                </select>
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">
                                    <i class="fas fa-times me-2"></i> Clear Filters
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Results Count - Responsive -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="h5 h2-md mb-0">
                        @(IsSearching ? "Search Results" : "All Courses")
                        <small class="text-muted ms-2">(@filteredCourses.Count courses)</small>
                    </h2>

                    <!-- Mobile Active Filters -->
                    <div class="d-block d-md-none">
                        @if (!string.IsNullOrEmpty(searchTerm) || selectedSpecializationId > 0 || priceRange != "all")
                        {
                            <span class="badge bg-primary me-2">Filters Active</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Courses Grid -->
        <div class="row">
            <div class="col-12">
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading courses...</p>
                    </div>
                }
                else if (!courses.Any() || !filteredCourses.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-book fa-3x text-muted mb-3"></i>
                        <h5>No courses found</h5>
                        <p class="text-muted">Try adjusting your search or filters</p>
                        <button class="btn btn-outline-primary mt-2" @onclick="ClearFilters">
                            <i class="fas fa-times me-2"></i> Clear Filters
                        </button>
                    </div>
                }
                else
                {
                    <!-- Mobile Course Grid (2 columns) -->
                    <div class="d-block d-md-none">
                        <div class="row row-cols-2 g-2">
                            @foreach (var course in paginatedCourses)
                            {
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="position-relative">
                                            @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                            {
                                                <img src="@GetCourseImageUrl(course.ThumbnailUrl)"
                                                     class="card-img-top"
                                                     alt="@course.Title"
                                                     style="height: 100px; object-fit: cover; border-radius: 8px 8px 0 0;" />
                                            }
                                            else
                                            {
                                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                                     style="height: 100px; border-radius: 8px 8px 0 0;">
                                                    <i class="fas fa-book fa-2x text-muted"></i>
                                                </div>
                                            }
                                            @if (course.Price == 0)
                                            {
                                                <span class="position-absolute top-0 end-0 m-1 badge bg-success" style="font-size: 10px;">
                                                    FREE
                                                </span>
                                            }
                                        </div>
                                        <div class="card-body p-2">
                                            <h6 class="card-title small fw-bold mb-1" style="line-height: 1.2;">@course.Title</h6>

                                            <div class="d-flex align-items-center mb-1">
                                                <div class="rating me-1">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <i class="fas fa-star @(i <= Math.Round(course.AverageRating) ? "text-warning" : "text-muted")"
                                                           style="font-size: 8px;"></i>
                                                    }
                                                </div>
                                                <small class="text-muted" style="font-size: 9px;">@course.AverageRating.ToString("0.0")</small>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center">
                                                @if (course.Price > 0)
                                                {
                                                    <span class="fw-bold" style="font-size: 12px;">$@course.Price.ToString("N0")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-success fw-bold" style="font-size: 12px;">Free</span>
                                                }
                                                <button class="btn btn-sm btn-outline-primary"
                                                        style="padding: 2px 8px; font-size: 10px;"
                                                        @onclick="@(() => ViewCourse(course.Id))">
                                                    View
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Desktop Course Grid (3 columns) -->
                    <div class="d-none d-md-block">
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                            @foreach (var course in paginatedCourses)
                            {
                                <div class="col">
                                    <div class="card h-100 shadow-sm">
                                        <div class="position-relative">
                                            @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                            {
                                                <img src="@GetCourseImageUrl(course.ThumbnailUrl)"
                                                     class="card-img-top"
                                                     alt="@course.Title"
                                                     style="height: 160px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 160px;">
                                                    <i class="fas fa-book fa-3x text-muted"></i>
                                                </div>
                                            }
                                            @if (course.Price == 0)
                                            {
                                                <span class="position-absolute top-0 end-0 m-2 badge bg-success">
                                                    FREE
                                                </span>
                                            }
                                        </div>
                                        <div class="card-body d-flex flex-column">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h5 class="card-title">@course.Title</h5>
                                                @if (course.SpecializationId > 0)
                                                {
                                                    <span class="badge bg-info">Part of Specialization</span>
                                                }
                                            </div>

                                            <p class="card-text text-muted small flex-grow-1">
                                                @(course.Description.Length > 100 ? course.Description.Substring(0, 100) + "..." : course.Description)
                                            </p>

                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div>
                                                    <span class="h5 mb-0">$@course.Price.ToString("N2")</span>
                                                </div>
                                                <div class="rating">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <i class="fas fa-star @(i <= Math.Round(course.AverageRating) ? "text-warning" : "text-muted")" style="font-size: 12px;"></i>
                                                    }
                                                    <small class="ms-1">@course.AverageRating.ToString("0.0")</small>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <small class="text-muted">
                                                    <i class="fas fa-clock me-1"></i>
                                                    @GetCourseDuration(course) hours
                                                </small>
                                                <small class="text-muted">
                                                    <i class="fas fa-users me-1"></i>
                                                    @course.TotalEnrollments
                                                </small>
                                            </div>

                                            @if (course.Doctor != null)
                                            {
                                                <div class="d-flex align-items-center mb-3">
                                                    <div class="avatar-sm me-2">
                                                        @if (!string.IsNullOrEmpty(course.Doctor.ProfileImageUrl))
                                                        {
                                                            <img src="@GetDoctorImageUrl(course.Doctor.ProfileImageUrl)"
                                                                 class="rounded-circle"
                                                                 width="24" height="24"
                                                                 alt="@($"{course.Doctor.FirstName} {course.Doctor.LastName}")"
                                                                 style="object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="avatar-placeholder bg-info text-white rounded-circle d-flex align-items-center justify-content-center"
                                                                 style="width: 24px; height: 24px; font-size: 12px;">
                                                                @GetDoctorInitials(course.Doctor)
                                                            </div>
                                                        }
                                                    </div>
                                                    <small class="text-muted">By @course.Doctor.FirstName @course.Doctor.LastName</small>
                                                </div>
                                            }

                                            <div class="d-grid gap-2 mt-auto">
                                                <button class="btn btn-outline-primary btn-sm"
                                                        @onclick="@(() => ViewCourse(course.Id))">
                                                    <i class="fas fa-eye me-2"></i> View Details
                                                </button>
                                                @if (course.Price > 0)
                                                {
                                                    <button class="btn btn-primary btn-sm"
                                                            @onclick="@(() => EnrollCourse(course.Id))">
                                                        <i class="fas fa-shopping-cart me-2"></i> Enroll Now
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-success btn-sm"
                                                            @onclick="@(() => EnrollFreeCourse(course))">
                                                        <i class="fas fa-graduation-cap me-2"></i> Enroll Free
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Pagination - Responsive -->
                    @if (totalPages > 1)
                    {
                        <nav class="mt-3 mt-md-4">
                            <!-- Mobile Pagination -->
                            <div class="d-block d-md-none">
                                <div class="d-flex justify-content-between align-items-center">
                                    <button class="btn btn-outline-primary btn-sm @(currentPage == 1 ? "disabled" : "")"
                                            @onclick="@(async () => await ChangePage(currentPage - 1))">
                                        <i class="fas fa-chevron-left"></i> Prev
                                    </button>
                                    <span class="small">Page @currentPage of @totalPages</span>
                                    <button class="btn btn-outline-primary btn-sm @(currentPage == totalPages ? "disabled" : "")"
                                            @onclick="@(async () => await ChangePage(currentPage + 1))">
                                        Next <i class="fas fa-chevron-right"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Desktop Pagination -->
                            <div class="d-none d-md-block">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="@(async () => await ChangePage(currentPage - 1))">
                                            <i class="fas fa-chevron-left"></i>
                                        </button>
                                    </li>

                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        <li class="page-item @(currentPage == i ? "active" : "")">
                                            <button class="page-link" @onclick="@(async () => await ChangePage(i))">@i</button>
                                        </li>
                                    }

                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="@(async () => await ChangePage(currentPage + 1))">
                                            <i class="fas fa-chevron-right"></i>
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<CourseDto> courses = new();
    private List<SpecializationDto> specializations = new();
    private List<CourseDto> filteredCourses = new();
    private List<CourseDto> paginatedCourses = new();
    private string searchTerm = "";
    private int selectedSpecializationId = 0;
    private string sortBy = "popular";
    private string priceRange = "all";
    private bool IsSearching => !string.IsNullOrEmpty(searchTerm);
    private int currentPage = 1;
    private const int pageSize = 12;
    private const int mobilePageSize = 10;
    private int totalPages = 1;
    private bool isLoading = true;
    private bool showMobileFilters = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Load specializations for filter
            var specs = await SpecializationService.GetSpecializationsAsync(
                search: null,
                featured: null,
                doctorId: null,
                minPrice: null,
                maxPrice: null,
                page: 1,
                pageSize: 50
            );

            if (specs != null)
            {
                // Filter for active specializations only
                specializations = specs.Where(s => s.IsActive).ToList();
            }

            // Load all courses by getting courses from each specialization
            await LoadAllCourses();

            // Apply initial filters
            ApplyFilters();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", "Error loading data:", ex.Message);
            await ShowToast("error", "Failed to load courses. Please try again.");
        }
        finally
        {
            isLoading = false;
        }
    }
    private void GoToHome()
    {
        Navigation.NavigateTo("/");
    }
    private async Task LoadAllCourses()
    {
        var allCourses = new List<CourseDto>();

        if (specializations != null && specializations.Any())
        {
            foreach (var spec in specializations)
            {
                // Only get courses from active specializations
                if (!spec.IsActive) continue;

                try
                {
                    var coursesInSpec = await CourseService.GetCoursesBySpecializationAsync(spec.Id);
                    if (coursesInSpec != null)
                    {
                        // Filter for active courses only
                        var activeCourses = coursesInSpec.Where(c => c.IsActive).ToList();
                        allCourses.AddRange(activeCourses);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading courses for specialization {spec.Id}: {ex.Message}");
                }
            }
        }

        courses = allCourses;
    }

    private void ApplyFilters()
    {
        var filtered = courses.AsEnumerable();

        // Apply specialization filter (0 means "All Specializations")
        if (selectedSpecializationId > 0)
        {
            filtered = filtered.Where(c => c.SpecializationId == selectedSpecializationId);
        }

        // Apply search filter
        if (!string.IsNullOrEmpty(searchTerm))
        {
            var searchLower = searchTerm.ToLower();
            filtered = filtered.Where(c =>
                c.Title.ToLower().Contains(searchLower) ||
                c.Description.ToLower().Contains(searchLower) ||
                (c.Doctor != null &&
                 (c.Doctor.FirstName.ToLower().Contains(searchLower) ||
                  c.Doctor.LastName.ToLower().Contains(searchLower))));
        }

        // Apply price filter
        if (priceRange != "all")
        {
            filtered = priceRange switch
            {
                "free" => filtered.Where(c => c.Price == 0),
                "under-25" => filtered.Where(c => c.Price > 0 && c.Price < 25),
                "25-50" => filtered.Where(c => c.Price >= 25 && c.Price <= 50),
                "50-100" => filtered.Where(c => c.Price > 50 && c.Price <= 100),
                "100-plus" => filtered.Where(c => c.Price > 100),
                _ => filtered
            };
        }

        // Apply sorting
        filteredCourses = sortBy switch
        {
            "rating" => filtered.OrderByDescending(c => c.AverageRating).ToList(),
            "newest" => filtered.OrderByDescending(c => c.CreatedAt).ToList(),
            "price-low" => filtered.OrderBy(c => c.Price).ToList(),
            "price-high" => filtered.OrderByDescending(c => c.Price).ToList(),
            _ => filtered.OrderByDescending(c => c.TotalEnrollments).ToList() // popular
        };

        // Calculate pagination
        var itemsPerPage = IsMobile() ? mobilePageSize : pageSize;
        totalPages = (int)Math.Ceiling((double)filteredCourses.Count / itemsPerPage);
        currentPage = Math.Max(1, Math.Min(currentPage, totalPages));

        // Apply pagination
        var startIndex = (currentPage - 1) * itemsPerPage;
        paginatedCourses = filteredCourses
            .Skip(startIndex)
            .Take(itemsPerPage)
            .ToList();

        CloseMobileFilters();
    }

    private bool IsMobile()
    {
        // This would need JavaScript interop to detect screen size
        // For now, we'll use a simple approach based on viewport width
        return true; // Default to mobile-friendly
    }

    private void ToggleMobileFilters()
    {
        showMobileFilters = !showMobileFilters;
        StateHasChanged();
    }

    private void CloseMobileFilters()
    {
        showMobileFilters = false;
        StateHasChanged();
    }

    // Helper method to get course image URL using ImageUrlService
    private string GetCourseImageUrl(string? thumbnailUrl)
    {
        return ImageUrlService.GetImageUrl(thumbnailUrl);
    }

    // Helper method to get doctor image URL using ImageUrlService
    private string GetDoctorImageUrl(string? profileImageUrl)
    {
        return ImageUrlService.GetImageUrl(profileImageUrl);
    }

    // Helper method to get doctor initials for placeholder
    private string GetDoctorInitials(object doctor)
    {
        if (doctor == null) return "DR";

        try
        {
            // Using reflection to access properties since we don't know the exact type
            var firstNameProp = doctor.GetType().GetProperty("FirstName");
            var lastNameProp = doctor.GetType().GetProperty("LastName");

            var firstName = firstNameProp?.GetValue(doctor) as string;
            var lastName = lastNameProp?.GetValue(doctor) as string;

            var firstInitial = !string.IsNullOrEmpty(firstName) ? firstName[0] : 'D';
            var lastInitial = !string.IsNullOrEmpty(lastName) ? lastName[0] : 'R';

            return $"{firstInitial}{lastInitial}";
        }
        catch
        {
            return "DR";
        }
    }

    private string GetCourseDuration(CourseDto course)
    {
        if (course.Lectures == null || !course.Lectures.Any())
            return "0";

        var totalMinutes = course.Lectures.Sum(l => l.EstimatedDurationMinutes);
        return (totalMinutes / 60.0).ToString("0.0");
    }

    private async Task SearchCourses()
    {
        currentPage = 1;
        ApplyFilters();
        await InvokeAsync(StateHasChanged);
        CloseMobileFilters();
    }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            ApplyFilters();
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
    }

    private async Task ClearFilters()
    {
        searchTerm = "";
        selectedSpecializationId = 0;
        sortBy = "popular";
        priceRange = "all";
        currentPage = 1;
        ApplyFilters();
        await InvokeAsync(StateHasChanged);
        CloseMobileFilters();
    }

    private void ViewCourse(int courseId)
    {
        Navigation.NavigateTo($"/course/{courseId}");
    }

    private void EnrollCourse(int courseId)
    {
        Navigation.NavigateTo($"/student/payments/make?type=Course&id={courseId}");
    }

    private async Task EnrollFreeCourse(CourseDto course)
    {
        try
        {
            await ShowToast("info", "Enrolling in free course...");

            var enrollmentDto = new CreateEnrollmentDto
            {
                EnrollmentType = EnrollmentType.Course,
                CourseId = course.Id
            };

            var enrollment = await EnrollmentService.CreateEnrollmentAsync(enrollmentDto);

            if (enrollment != null)
            {
                await ShowToast("success", "Successfully enrolled in free course!");
                Navigation.NavigateTo($"/student/mylearning/course/{course.Id}");
            }
            else
            {
                await ShowToast("error", "Failed to enroll. Please try again.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", "Enrollment error:", ex.Message);
            await ShowToast("error", "Failed to enroll. Please try again.");
        }
    }

    private async Task ShowToast(string type, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", type, message);
        }
        catch
        {
            await JS.InvokeVoidAsync("alert", message);
        }
    }
}
