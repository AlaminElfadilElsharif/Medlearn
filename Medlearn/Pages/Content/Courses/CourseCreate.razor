@page "/createcourse/{Id:int?}"


<PageTitle>@(IsEditMode ? "Edit Course" : "Create Course")</PageTitle>

<div class="create-course">
    <div class="container-fluid px-0 px-md-3">
        <!-- Header - Responsive -->
        <div class="row g-0 mb-3 mb-md-4">
            <div class="col-12">
                <!-- Mobile Header -->
                <div class="d-block d-md-none">
                    <div class="bg-primary text-white p-3">
                        <div class="d-flex align-items-center">
                            <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                                <i class="fas fa-arrow-left fa-lg"></i>
                            </button>
                            <h5 class="mb-0 flex-grow-1">@(IsEditMode ? "Edit Course" : "Create Course")</h5>
                            @if (isAuthenticated && currentUser?.UserType == UserType.Doctor)
                            {
                                <small class="text-white-50">
                                    <i class="fas fa-user-md me-1"></i>
                                </small>
                            }
                        </div>
                    </div>

                    <!-- Mobile Breadcrumb -->
                    <div class="bg-light p-2 small">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item">
                                    <a href="/doctor" class="text-decoration-none">Doctor</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="/content/courses" class="text-decoration-none">Courses</a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">
                                    @(IsEditMode ? "Edit" : "Create")
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <!-- Desktop Header -->
                <div class="d-none d-md-block">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1>@(IsEditMode ? "Edit Course" : "Create Course")</h1>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="/doctor">Doctor</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="/doctor/content/courses">My Courses</a>
                                    </li>
                                    <li class="breadcrumb-item active" aria-current="page">
                                        @(IsEditMode ? "Edit" : "Create")
                                    </li>
                                </ol>
                            </nav>
                        </div>
                        <div>
                            <button class="btn btn-outline-secondary" @onclick="GoBack">
                                <i class="fas fa-arrow-left me-2"></i> Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted">Loading course data...</p>
            </div>
        }
        else if (!isAuthenticated)
        {
            <div class="container py-4">
                <div class="alert alert-warning text-center">
                    <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                    <h4>Authentication Required</h4>
                    <p class="mb-4">You need to be logged in as a doctor to create or edit courses.</p>
                    <a href="/account/login?returnUrl=/createcourse@(IsEditMode ? $"/{Id}" : "")"
                       class="btn btn-primary">
                        <i class="fas fa-sign-in-alt me-2"></i> Login
                    </a>
                </div>
            </div>
        }
        else if (currentUser == null || currentUser.UserType != UserType.Doctor)
        {
            <div class="container py-4">
                <div class="alert alert-danger text-center">
                    <i class="fas fa-ban fa-3x mb-3"></i>
                    <h4>Access Denied</h4>
                    <p class="mb-4">Only doctors can create or edit courses.</p>
                    <button class="btn btn-outline-secondary" @onclick="GoBack">
                        <i class="fas fa-arrow-left me-2"></i> Go Back
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="row justify-content-center">
                <div class="col-12 col-lg-10">
                    <div class="card border-0 border-md">
                        <!-- Mobile Card Header -->
                        <div class="d-block d-md-none card-header bg-white">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-book me-2 text-primary"></i>
                                <span class="fw-bold">Course Details</span>
                                <span class="ms-auto text-muted small">
                                    <i class="fas fa-user-md me-1"></i>
                                    @currentUser.FirstName
                                </span>
                            </div>
                        </div>

                        <!-- Desktop Card Header -->
                        <div class="d-none d-md-block card-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Course Details</h5>
                                <div>
                                    <small class="text-muted">
                                        <i class="fas fa-user-md me-1"></i>
                                        Doctor: @currentUser.FirstName @currentUser.LastName
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-3 p-md-4">
                            <EditForm Model="@createDto" OnValidSubmit="HandleValidSubmit">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="alert alert-danger d-none d-md-block" />
                                <ValidationSummary class="alert alert-danger small d-block d-md-none" />

                                <!-- Mobile View (Stacked Layout) -->
                                <div class="d-block d-md-none">
                                    <div class="vstack gap-3">
                                        <!-- Specialization Selection (Mobile) -->
                                        <div>
                                            <label class="form-label small fw-bold" for="mobile-specialization">
                                                Specialization <span class="text-danger">*</span>
                                            </label>
                                            <InputSelect id="mobile-specialization" @bind-Value="createDto.SpecializationId"
                                                         class="form-control form-control-sm" disabled="@IsEditMode">
                                                <option value="0">Select Specialization</option>
                                                @if (specializations != null && specializations.Any())
                                                {
                                                    @foreach (var spec in specializations)
                                                    {
                                                        <option value="@spec.Id">@spec.Title</option>
                                                    }
                                                }
                                                else
                                                {
                                                    <option value="0" disabled>No specializations found</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="@(() => createDto.SpecializationId)" />
                                            @if (IsEditMode)
                                            {
                                                <div class="form-text text-warning small mt-1">
                                                    <i class="fas fa-info-circle me-1"></i>
                                                    Cannot change specialization
                                                </div>
                                            }
                                            else if (specializations == null || !specializations.Any())
                                            {
                                                <div class="alert alert-warning small mt-2 p-2">
                                                    <i class="fas fa-exclamation-circle me-1"></i>
                                                    Create a specialization first.
                                                    <a href="/createspecialization" class="d-block mt-1">Create Specialization</a>
                                                </div>
                                            }
                                        </div>

                                        <!-- Order (Mobile) -->
                                        <div>
                                            <label class="form-label small fw-bold" for="mobile-order">
                                                Order in Specialization <span class="text-danger">*</span>
                                            </label>
                                            <InputNumber id="mobile-order" @bind-Value="createDto.Order"
                                                         class="form-control form-control-sm" placeholder="e.g., 1" />
                                            <ValidationMessage For="@(() => createDto.Order)" />
                                            <small class="form-text text-muted d-block mt-1">
                                                Lower numbers appear first
                                            </small>
                                        </div>

                                        <!-- Title (Mobile) -->
                                        <div>
                                            <label class="form-label small fw-bold" for="mobile-title">
                                                Course Title <span class="text-danger">*</span>
                                            </label>
                                            <InputText id="mobile-title" @bind-Value="createDto.Title"
                                                       class="form-control form-control-sm"
                                                       placeholder="Enter course title" />
                                            <ValidationMessage For="@(() => createDto.Title)" />
                                            <small class="form-text text-muted">@(createDto.Title?.Length ?? 0)/200</small>
                                        </div>

                                        <!-- Price (Mobile) -->
                                        <div>
                                            <label class="form-label small fw-bold" for="mobile-price">
                                                Price ($) <span class="text-danger">*</span>
                                            </label>
                                            <InputNumber id="mobile-price" @bind-Value="createDto.Price"
                                                         class="form-control form-control-sm"
                                                         placeholder="0.00" step="0.01" />
                                            <ValidationMessage For="@(() => createDto.Price)" />
                                            <small class="form-text text-muted">Set to 0 for free course</small>
                                        </div>

                                        <!-- Description (Mobile) -->
                                        <div>
                                            <label class="form-label small fw-bold" for="mobile-description">
                                                Description <span class="text-danger">*</span>
                                            </label>
                                            <InputTextArea id="mobile-description" @bind-Value="createDto.Description"
                                                           class="form-control form-control-sm"
                                                           placeholder="What will students learn?"
                                                           rows="4" />
                                            <ValidationMessage For="@(() => createDto.Description)" />
                                        </div>

                                        <!-- Thumbnail Upload (Mobile) -->
                                        <div>
                                            <label class="form-label small fw-bold">
                                                Thumbnail Image <span class="text-danger">*</span>
                                            </label>

                                            <!-- Mobile Thumbnail Section -->
                                            <div class="mb-2">
                                                @if (!string.IsNullOrEmpty(previewImageUrl))
                                                {
                                                    <div class="position-relative mb-2">
                                                        <img src="@previewImageUrl" class="img-fluid rounded w-100"
                                                             alt="Thumbnail preview" style="max-height: 150px; object-fit: cover;" />
                                                        <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2"
                                                                @onclick="RemoveThumbnail">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                }
                                                else if (IsEditMode && !string.IsNullOrEmpty(existingThumbnailUrl) && !hasRemovedExistingThumbnail)
                                                {
                                                    <div class="position-relative mb-2">
                                                        <img src="@existingThumbnailUrl" class="img-fluid rounded w-100"
                                                             alt="Current thumbnail" style="max-height: 150px; object-fit: cover;" />
                                                        <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2"
                                                                @onclick="RemoveExistingThumbnail">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                        <small class="text-muted d-block mt-1">Current thumbnail</small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="upload-area p-3 text-center border rounded bg-light mb-2"
                                                         onclick="document.getElementById('mobile-thumbnail').click()">
                                                        <i class="fas fa-cloud-upload-alt fa-2x text-muted mb-2"></i>
                                                        <p class="small mb-1">Tap to upload thumbnail</p>
                                                        <p class="text-muted small mb-0">1280x720px, max 5MB</p>
                                                    </div>
                                                }

                                                <InputFile id="mobile-thumbnail" class="d-none"
                                                           OnChange="HandleThumbnailUpload"
                                                           accept="image/png, image/jpeg, image/jpg" />

                                                @if (!string.IsNullOrEmpty(uploadError))
                                                {
                                                    <div class="alert alert-danger p-2 small mt-2">
                                                        <i class="fas fa-exclamation-circle me-1"></i>
                                                        @uploadError
                                                    </div>
                                                }
                                                @if (thumbnailFile != null)
                                                {
                                                    <div class="alert alert-info small p-2 mt-2">
                                                        <i class="fas fa-check-circle me-1 text-success"></i>
                                                        @thumbnailFile.Name
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <!-- Action Buttons (Mobile) -->
                                        <div class="fixed-bottom d-block d-md-none p-3 bg-white border-top">
                                            <div class="d-flex gap-2">
                                                <button type="button"
                                                        class="btn btn-outline-secondary flex-fill"
                                                        @onclick="GoBack">
                                                    Cancel
                                                </button>
                                                <button type="button"
                                                        class="btn btn-outline-primary"
                                                        @onclick="ResetForm">
                                                    <i class="fas fa-redo"></i>
                                                </button>
                                                <button type="submit"
                                                        class="btn btn-primary flex-fill"
                                                        disabled="@isSubmitting">
                                                    @if (isSubmitting)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-save me-1"></i>
                                                    }
                                                    @(IsEditMode ? "Update" : "Create")
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Spacer for mobile fixed button -->
                                        <div class="mb-5 pb-3"></div>
                                    </div>
                                </div>

                                <!-- Desktop View (Original Layout) -->
                                <div class="d-none d-md-block">
                                    <div class="row g-3">
                                        <!-- Specialization Selection -->
                                        <div class="col-md-8">
                                            <div class="form-floating mb-3">
                                                <InputSelect id="specialization" @bind-Value="createDto.SpecializationId"
                                                             class="form-control" disabled="@IsEditMode">
                                                    <option value="0">Select Specialization *</option>
                                                    @if (specializations != null && specializations.Any())
                                                    {
                                                        @foreach (var spec in specializations)
                                                        {
                                                            <option value="@spec.Id">@spec.Title</option>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <option value="0" disabled>No specializations found</option>
                                                    }
                                                </InputSelect>
                                                <label for="specialization">Specialization *</label>
                                                <ValidationMessage For="@(() => createDto.SpecializationId)" />
                                                @if (IsEditMode)
                                                {
                                                    <div class="form-text text-warning">
                                                        <i class="fas fa-info-circle me-1"></i>
                                                        Cannot change specialization after creation
                                                    </div>
                                                }
                                                else if (specializations == null || !specializations.Any())
                                                {
                                                    <div class="form-text text-danger">
                                                        <i class="fas fa-exclamation-circle me-1"></i>
                                                        You need to create a specialization first.
                                                        <a href="/createspecialization" class="ms-1">Create Specialization</a>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating mb-3">
                                                <InputNumber id="order" @bind-Value="createDto.Order"
                                                             class="form-control" placeholder="Order" />
                                                <label for="order">Order in Specialization *</label>
                                                <ValidationMessage For="@(() => createDto.Order)" />
                                                <div class="form-text">
                                                    Determines display sequence (1 = first)
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Basic Information -->
                                        <div class="col-12">
                                            <div class="form-floating mb-3">
                                                <InputText id="title" @bind-Value="createDto.Title"
                                                           class="form-control" placeholder="Course Title" />
                                                <label for="title">Course Title *</label>
                                                <ValidationMessage For="@(() => createDto.Title)" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <InputNumber id="price" @bind-Value="createDto.Price"
                                                             class="form-control" placeholder="Price" />
                                                <label for="price">Price ($) *</label>
                                                <ValidationMessage For="@(() => createDto.Price)" />
                                                <div class="form-text">
                                                    Set to 0 for free course
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="form-floating mb-3">
                                                <InputTextArea id="description" @bind-Value="createDto.Description"
                                                               class="form-control" placeholder="Description"
                                                               style="height: 120px" />
                                                <label for="description">Description *</label>
                                                <ValidationMessage For="@(() => createDto.Description)" />
                                                <div class="form-text">
                                                    What will students learn in this course?
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Thumbnail Upload -->
                                        <div class="col-12">
                                            <hr />
                                            <h5>Thumbnail Image</h5>
                                            <div class="mb-3">
                                                <div class="row align-items-center">
                                                    <div class="col-md-4">
                                                        @if (!string.IsNullOrEmpty(previewImageUrl))
                                                        {
                                                            <div class="thumbnail-preview mb-3">
                                                                <img src="@previewImageUrl" class="img-fluid rounded"
                                                                     alt="Thumbnail preview" style="max-height: 200px;" />
                                                                <button type="button" class="btn btn-sm btn-danger mt-2"
                                                                        @onclick="RemoveThumbnail">
                                                                    <i class="fas fa-trash me-1"></i> Remove
                                                                </button>
                                                            </div>
                                                        }
                                                        else if (IsEditMode && !string.IsNullOrEmpty(existingThumbnailUrl) && !hasRemovedExistingThumbnail)
                                                        {
                                                            <div class="thumbnail-preview mb-3">
                                                                <img src="@existingThumbnailUrl" class="img-fluid rounded"
                                                                     alt="Current thumbnail" style="max-height: 200px;" />
                                                                <div class="mt-2">
                                                                    <small class="text-muted">Current thumbnail</small>
                                                                    <button type="button" class="btn btn-sm btn-outline-danger ms-2"
                                                                            @onclick="RemoveExistingThumbnail">
                                                                        <i class="fas fa-trash me-1"></i> Remove
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="thumbnail-preview mb-3">
                                                                <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                                                     style="height: 150px; border: 2px dashed #dee2e6;">
                                                                    <div class="text-center">
                                                                        <i class="fas fa-image fa-2x text-muted mb-2"></i>
                                                                        <p class="text-muted small mb-0">Thumbnail Preview</p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="col-md-8">
                                                        <div class="mb-3">
                                                            <label class="form-label">Upload Thumbnail Image *</label>
                                                            <InputFile id="thumbnail" class="form-control"
                                                                       OnChange="HandleThumbnailUpload"
                                                                       accept="image/png, image/jpeg, image/jpg" />
                                                            <div class="form-text">
                                                                Recommended: 1280x720px, JPG or PNG format, max 5MB
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(uploadError))
                                                            {
                                                                <div class="alert alert-danger p-2 mt-2">
                                                                    <i class="fas fa-exclamation-circle me-2"></i>
                                                                    @uploadError
                                                                </div>
                                                            }
                                                            @if (thumbnailFile != null)
                                                            {
                                                                <div class="alert alert-info mt-2 p-2">
                                                                    <i class="fas fa-check-circle me-2 text-success"></i>
                                                                    File selected: @thumbnailFile.Name (@((thumbnailFile.Size / 1024).ToString("N0")) KB)
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Submit Button -->
                                        <div class="col-12">
                                            <hr />
                                            <div class="d-flex justify-content-between">
                                                <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">
                                                    <i class="fas fa-redo me-2"></i> Reset
                                                </button>
                                                <div class="d-flex gap-2">
                                                    <button type="button" class="btn btn-outline-secondary" @onclick="GoBack">
                                                        <i class="fas fa-times me-2"></i> Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                                        @if (isSubmitting)
                                                        {
                                                            <span>
                                                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                                @(IsEditMode ? "Updating..." : "Creating...")
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span>
                                                                <i class="fas fa-save me-2"></i>
                                                                @(IsEditMode ? "Update Course" : "Create Course")
                                                            </span>
                                                        }
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // ... (keep all your existing code in the @code block exactly as is)
    [Parameter] public int? Id { get; set; }

    private CreateCourseRequestDto createDto = new();
    private CourseDto? existingCourse;
    private List<SpecializationDto> specializations = new();
    private string? existingThumbnailUrl;
    private string previewImageUrl = "";
    private string uploadError = "";
    private bool isSubmitting = false;
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private IBrowserFile? thumbnailFile;
    private UserDto? currentUser = null;
    private bool hasRemovedExistingThumbnail = false;

    private bool IsEditMode => Id.HasValue && Id > 0;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
        await LoadCourseData();
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();

                if (currentUser == null || currentUser.UserType != UserType.Doctor)
                {
                    isAuthenticated = false;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            currentUser = null;
        }
    }

    private async Task LoadCourseData()
    {
        if (!isAuthenticated || currentUser == null) return;

        isLoading = true;

        try
        {
            var specs = await SpecializationService.GetMySpecializationsAsync();
            if (specs != null)
            {
                specializations = specs;
            }

            if (IsEditMode)
            {
                existingCourse = await CourseService.GetCourseAsync(Id.Value);

                if (existingCourse != null)
                {
                    if (existingCourse.DoctorId != currentUser.Id)
                    {
                        await ShowToast("error", "You don't have permission to edit this course");
                        Navigation.NavigateTo("/doctor/content/courses");
                        return;
                    }

                    createDto.Title = existingCourse.Title;
                    createDto.Description = existingCourse.Description;
                    createDto.Price = existingCourse.Price;
                    createDto.Order = existingCourse.Order;
                    createDto.SpecializationId = existingCourse.SpecializationId;

                    // Set ThumbnailUrl for edit mode
                    createDto.ThumbnailUrl = existingCourse.ThumbnailUrl;
                    existingThumbnailUrl = existingCourse.ThumbnailUrl;
                }
                else
                {
                    await ShowToast("error", "Course not found");
                    Navigation.NavigateTo("/doctor/content/courses");
                }
            }
            else
            {
                // For new course, ensure ThumbnailUrl is set to empty string
                createDto.ThumbnailUrl = "";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading course data: {ex.Message}");
            await ShowToast("error", $"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleThumbnailUpload(InputFileChangeEventArgs e)
    {
        uploadError = "";
        var file = e.File;

        if (file.Size > 5 * 1024 * 1024)
        {
            uploadError = "File size must be less than 5MB";
            await ShowToast("error", uploadError);
            return;
        }

        var allowedTypes = new[] { "image/jpeg", "image/jpg", "image/png" };
        if (!allowedTypes.Contains(file.ContentType.ToLower()))
        {
            uploadError = "Please upload a JPG, JPEG, or PNG file";
            await ShowToast("error", uploadError);
            return;
        }

        thumbnailFile = file;
        createDto.ThumbnailImage = file;
        hasRemovedExistingThumbnail = false;

        try
        {
            var format = "image/jpeg";
            var resizedImage = await file.RequestImageFileAsync(format, 800, 450);
            var buffer = new byte[resizedImage.Size];
            await resizedImage.OpenReadStream().ReadAsync(buffer);
            previewImageUrl = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
        }
        catch (Exception ex)
        {
            uploadError = $"Error creating preview: {ex.Message}";
            Console.WriteLine($"Error creating preview: {ex.Message}");
        }

        StateHasChanged();
    }

    private void RemoveThumbnail()
    {
        thumbnailFile = null;
        createDto.ThumbnailImage = null;
        previewImageUrl = "";
        uploadError = "";
        // Keep ThumbnailUrl as empty string
        StateHasChanged();
    }

    private void RemoveExistingThumbnail()
    {
        existingThumbnailUrl = null;
        createDto.ThumbnailUrl = ""; // Set to empty string when removing
        hasRemovedExistingThumbnail = true;
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        if (!isAuthenticated || currentUser == null)
        {
            await ShowToast("error", "Please log in to continue");
            Navigation.NavigateTo("/account/login");
            return;
        }

        isSubmitting = true;
        uploadError = "";

        try
        {
            if (createDto.SpecializationId <= 0)
            {
                await ShowToast("error", "Please select a specialization");
                isSubmitting = false;
                StateHasChanged();
                return;
            }

            // For new courses, require thumbnail
            if (!IsEditMode && thumbnailFile == null)
            {
                await ShowToast("error", "Please upload a thumbnail image");
                isSubmitting = false;
                StateHasChanged();
                return;
            }

            // For edit mode, handle existing thumbnail
            if (IsEditMode && existingCourse != null)
            {
                if (hasRemovedExistingThumbnail && thumbnailFile == null)
                {
                    await ShowToast("error", "Please upload a thumbnail image or keep the existing one");
                    isSubmitting = false;
                    StateHasChanged();
                    return;
                }
            }

            if (!specializations.Any(s => s.Id == createDto.SpecializationId))
            {
                await ShowToast("error", "Invalid specialization selected");
                isSubmitting = false;
                StateHasChanged();
                return;
            }

            // Ensure ThumbnailUrl is always set before sending
            if (IsEditMode && existingCourse != null)
            {
                // If we have existing thumbnail and didn't remove it, use it
                if (!hasRemovedExistingThumbnail && string.IsNullOrEmpty(createDto.ThumbnailUrl))
                {
                    createDto.ThumbnailUrl = existingThumbnailUrl;
                }
            }
            else if (!IsEditMode && string.IsNullOrEmpty(createDto.ThumbnailUrl))
            {
                // For new courses, ensure it's empty string
                createDto.ThumbnailUrl = "";
            }

            if (IsEditMode && existingCourse != null)
            {
                var updateDto = new UpdateCourseRequestDto
                {
                    Title = createDto.Title,
                    Description = createDto.Description,
                    Price = createDto.Price,
                    Order = createDto.Order,
                    ThumbnailUrl = createDto.ThumbnailUrl
                };

                Stream? thumbnailStream = null;
                string fileName = "";

                if (thumbnailFile != null)
                {
                    thumbnailStream = thumbnailFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                    fileName = thumbnailFile.Name;
                }

                var success = await CourseService.UpdateCourseAsync(
                    existingCourse.Id,
                    updateDto,
                    thumbnailStream,
                    fileName
                );

                if (success)
                {
                    await ShowToast("success", "Course updated successfully");
                    Navigation.NavigateTo($"/doctor/content/courses/{existingCourse.Id}");
                }
                else
                {
                    await ShowToast("error", "Failed to update course");
                }
            }
            else
            {
                // Create new course - ensure ThumbnailUrl is set
                Stream? thumbnailStream = null;
                string fileName = "";

                if (thumbnailFile != null)
                {
                    thumbnailStream = thumbnailFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                    fileName = thumbnailFile.Name;
                }

                var createdCourse = await CourseService.CreateCourseAsync(
                    createDto,
                    thumbnailStream,
                    fileName
                );

                if (createdCourse != null)
                {
                    await ShowToast("success", "Course created successfully");
                    Navigation.NavigateTo($"/doctor/content/courses/{createdCourse.Id}");
                }
                else
                {
                    await ShowToast("error", "Failed to create course");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error submitting course: {ex.Message}");
            await ShowToast("error", $"Error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void ResetForm()
    {
        if (IsEditMode && existingCourse != null)
        {
            createDto = new CreateCourseRequestDto
            {
                Title = existingCourse.Title,
                Description = existingCourse.Description,
                Price = existingCourse.Price,
                Order = existingCourse.Order,
                SpecializationId = existingCourse.SpecializationId,
                ThumbnailUrl = existingCourse.ThumbnailUrl
            };
            thumbnailFile = null;
            createDto.ThumbnailImage = null;
            previewImageUrl = "";
            existingThumbnailUrl = existingCourse.ThumbnailUrl;
            hasRemovedExistingThumbnail = false;
        }
        else
        {
            createDto = new CreateCourseRequestDto
            {
                ThumbnailUrl = "" // Ensure empty string for new courses
            };
            thumbnailFile = null;
            previewImageUrl = "";
        }

        uploadError = "";
        StateHasChanged();
    }

    private void GoBack()
    {
        if (IsEditMode && existingCourse != null)
        {
            Navigation.NavigateTo($"/doctor/content/courses/{existingCourse.Id}");
        }
        else
            Navigation.NavigateTo("/doctor/content/courses");
    }
    private async Task ShowToast(string type, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", type, message);
        }
        catch
        {
            Console.WriteLine($"{type.ToUpper()}: {message}");
        }
    }
}

