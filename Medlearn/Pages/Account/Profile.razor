    private async Task SetAuthorizationHeader()
    {
        try
        {
            var token = await TokenService.GetTokenAsync();

            if (!string.IsNullOrEmpty(token) && token.StartsWith("eyJ"))
            {
                // Set the Authorization header for all subsequent requests
                Http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

                Console.WriteLine("Authorization header set with token");
            }
            else
            {
                Console.WriteLine("Invalid token format - not setting authorization header");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting authorization header: {ex.Message}");
        }
    }

    private async Task LoadUserData()
    {
        try
        {
            // Make sure authorization header is set
            await SetAuthorizationHeader();

            // Try to get user from AuthService (which should use the token)
            user = await AuthService.GetCurrentUserAsync();

            if (user != null)
            {
                InitializeFromCurrentUser();
                ShowAuthStatus("success", "Profile loaded successfully", "fas fa-check-circle", "alert-success");
            }
            else
            {
                // User not found - try to get from localStorage as fallback
                try
                {
                    var localStorageUser = await JS.InvokeAsync<string>("localStorage.getItem", "currentUser");
                    if (!string.IsNullOrEmpty(localStorageUser))
                    {
                        user = System.Text.Json.JsonSerializer.Deserialize<UserDto>(localStorageUser);
                        if (user != null)
                        {
                            InitializeFromCurrentUser();
                            ShowAuthStatus("warning", "Profile loaded from cache. Some features may not work.", "fas fa-exclamation-triangle", "alert-warning");
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading from localStorage: {ex.Message}");
                }

                if (user == null)
                {
                    showError = true;
                    errorMessage = "Unable to load profile data. The authentication token may have expired.";
                    ShowAuthStatus("error", "Authentication token expired. Please log in again.", "fas fa-exclamation-circle", "alert-danger");
                }
            }
        }
        catch (HttpRequestException httpEx) when (httpEx.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            // 401 Unauthorized - token expired or invalid
            showError = true;
            errorMessage = "Your session has expired. Please log in again.";
            ShowAuthStatus("error", "Session expired. Please log in again.", "fas fa-exclamation-circle", "alert-danger");

            // Clear invalid token
            await TokenService.RemoveTokenAsync();
            isAuthenticated = false;

            await JS.InvokeVoidAsync("console.error", "HTTP 401 - Unauthorized:", httpEx.Message);
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = "Failed to load profile data: " + ex.Message;
            ShowAuthStatus("error", $"Error loading profile: {ex.Message}", "fas fa-exclamation-circle", "alert-danger");
            await JS.InvokeVoidAsync("console.error", "Error loading user data:", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAuthStatus(string type, string message, string icon, string alertClass)
    {
        authStatusMessage = message;
        authStatusIcon = icon;
        authStatusClass = alertClass;
        showAuthStatus = true;

        // Auto-hide success messages after 5 seconds
        if (type == "success")
        {
            _ = Task.Delay(5000).ContinueWith(_ =>
            {
                InvokeAsync(() =>
                {
                    showAuthStatus = false;
                    StateHasChanged();
                });
            });
        }
    }

