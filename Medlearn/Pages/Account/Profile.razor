    private async Task CheckAuthentication()
    {
        try
        {
            Console.WriteLine("=== Profile Page: CheckAuthentication called ===");

            // First, check if we have a valid token
            var token = await TokenService.GetTokenAsync();
            bool hasValidToken = !string.IsNullOrEmpty(token) && token.StartsWith("eyJ");

            Console.WriteLine($"TokenService returned token: Length={token?.Length}, Valid format={hasValidToken}");

            if (hasValidToken)
            {
                // Set authorization header for HttpClient
                await SetAuthorizationHeader();

                // Try to get current user via AuthService
                user = await AuthService.GetCurrentUserAsync();

                if (user != null)
                {
                    isAuthenticated = true;
                    Console.WriteLine($"AuthService returned user: {user.Email}, Type: {user.UserType}");

                    // Show authentication status
                    ShowAuthStatus("success", "Authentication successful", "fas fa-check-circle", "alert-success");
                }
                else
                {
                    // User not found but token is valid - might be expired
                    isAuthenticated = false;
                    ShowAuthStatus("warning", "Session expired. Please log in again.", "fas fa-exclamation-triangle", "alert-warning");
                    await JS.InvokeVoidAsync("console.warn", "Token appears valid but user not found - token may be expired");
                }
            }
            else
            {
                // No valid token found
                isAuthenticated = false;

                // Check localStorage for debugging
                try
                {
                    var localStorageToken = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
                    Console.WriteLine($"localStorage token: {!string.IsNullOrEmpty(localStorageToken)}, Starts with 'eyJ': {localStorageToken?.StartsWith("eyJ")}");

                    if (!string.IsNullOrEmpty(localStorageToken) && !localStorageToken.StartsWith("eyJ"))
                    {
                        ShowAuthStatus("error", "Authentication token is corrupted. Please log in again.", "fas fa-exclamation-circle", "alert-danger");
                        await JS.InvokeVoidAsync("console.error", "Corrupted token in localStorage:", localStorageToken?.Substring(0, Math.Min(50, localStorageToken?.Length ?? 0)));

                        // Clear corrupted token
                        await TokenService.RemoveTokenAsync();
                    }
                    else
                    {
                        ShowAuthStatus("info", "Please log in to access your profile.", "fas fa-sign-in-alt", "alert-info");
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error reading localStorage: {ex.Message}");
                }
            }

            Console.WriteLine($"Final authentication state: {isAuthenticated}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}\n{ex.StackTrace}");
            isAuthenticated = false;
            user = null;
            ShowAuthStatus("error", $"Authentication error: {ex.Message}", "fas fa-exclamation-circle", "alert-danger");
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Message))
        {
            if (Message == "password-changed")
            {
                ShowAuthStatus("success", "Password changed successfully!", "fas fa-check-circle", "alert-success");
            }
            else if (Message == "profile-updated")
            {
                ShowAuthStatus("success", "Profile updated successfully!", "fas fa-check-circle", "alert-success");
            }
        }
