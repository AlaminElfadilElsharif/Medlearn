@page "/account/profile"
@page "/account/profile/{Message}"


<PageTitle>My Profile - Learning Platform</PageTitle>

<div class="profile-page">
    @if (!isAuthenticated)
    {
        <!-- Not Authenticated - Mobile Optimized -->
        <div class="container mt-3 mt-md-5">
            <div class="row justify-content-center">
                <div class="col-11 col-md-6">
                    <div class="alert alert-warning text-center p-4 p-md-5" role="alert">
                        <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                        <h4 class="h5 h4-md">Authentication Required</h4>
                        <p class="small text-muted mb-4">You need to be logged in to view your profile.</p>
                        <button class="btn btn-primary w-100 w-md-auto" @onclick='() => Navigation.NavigateTo("/account/login")'>
                            <i class="fas fa-sign-in-alt me-2"></i> Go to Login
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (isLoading)
    {
        <!-- Loading Spinner - Centered -->
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-12 text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 text-muted">Loading your profile...</p>
                </div>
            </div>
        </div>
    }
    else if (user == null)
    {
        <!-- User Not Found -->
        <div class="container mt-3 mt-md-5">
            <div class="row justify-content-center">
                <div class="col-11 col-md-6">
                    <div class="alert alert-danger text-center p-4" role="alert">
                        <i class="fas fa-user-slash fa-3x mb-3"></i>
                        <h4 class="h5 h4-md">User Not Found</h4>
                        <p class="small">Unable to load your profile information.</p>
                        <button class="btn btn-primary w-100 w-md-auto mt-3" @onclick="ReloadPage">
                            <i class="fas fa-redo me-2"></i> Try Again
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Main Profile Content - Responsive -->
        <div class="container-fluid px-0 px-md-3 mt-0 mt-md-4">
            <!-- Mobile Header -->
            <div class="d-block d-md-none bg-primary text-white p-3 mb-3">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </button>
                    <h5 class="mb-0 flex-grow-1">My Profile</h5>
                    <button class="btn btn-link text-white p-0" @onclick="ToggleEditMode">
                        <i class="fas @(isEditing ? "times" : "edit") fa-lg"></i>
                    </button>
                </div>
            </div>

            <div class="row g-0 g-md-3">
                <!-- Profile Sidebar - Responsive -->
                <div class="col-lg-4 mb-3 mb-md-4">
                    <!-- Mobile Profile Card -->
                    <div class="d-block d-md-none">
                        <div class="card border-0 rounded-0">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center">
                                    <!-- Profile Image - Mobile -->
                                    <div class="position-relative me-3">
                                        @if (isUploadingProfileImage)
                                        {
                                            <div class="profile-image-container-mobile">
                                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                    <span class="visually-hidden">Uploading...</span>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="profile-image-container-mobile">
                                                <img src="@profileImageUrl"
                                                     alt="Profile"
                                                     class="profile-image-mobile rounded-circle"
                                                     onerror="this.onerror=null;this.src='@ImageUrlService.GetImageUrl(null)'">

                                                <label class="profile-image-overlay-mobile">
                                                    <i class="fas fa-camera text-white small"></i>
                                                    <InputFile OnChange="HandleProfileImageUpload"
                                                               accept="image/*"
                                                               style="display: none;"
                                                               id="mobileProfileImageUpload" />
                                                </label>
                                            </div>
                                        }
                                    </div>

                                    <!-- User Info - Mobile -->
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@(user?.FirstName) @(user?.LastName)</h6>
                                        <p class="small text-muted mb-1">@(user?.Email)</p>
                                        <span class="badge @GetUserTypeBadgeClass()">
                                            <i class="@GetUserTypeIcon() me-1"></i>
                                            @(user?.UserType.ToString())
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Mobile Stats for Doctors -->
                        @if (user?.UserType == UserType.Doctor && user.Profile != null)
                        {
                            <div class="card border-0 rounded-0 mt-2">
                                <div class="card-body p-3">
                                    <div class="row g-2 text-center">
                                        <div class="col-4">
                                            <div class="stat-value-mobile text-primary">@(user.Profile?.TotalStudents ?? 0)</div>
                                            <div class="stat-label-mobile">Students</div>
                                        </div>
                                        <div class="col-4">
                                            <div class="stat-value-mobile text-success">@((user.Profile?.RatingAverage ?? 0).ToString("0.0"))</div>
                                            <div class="stat-label-mobile">Rating</div>
                                        </div>
                                        <div class="col-4">
                                            <div class="stat-value-mobile text-warning">$@((user.Profile?.Balance ?? 0).ToString("N0"))</div>
                                            <div class="stat-label-mobile">Earnings</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Mobile Navigation Menu -->
                        <div class="card border-0 rounded-0 mt-2">
                            <div class="list-group list-group-flush">
                                <a href="/account/profile"
                                   class="list-group-item list-group-item-action active d-flex align-items-center">
                                    <i class="fas fa-user-circle me-3"></i>
                                    <span>Profile Information</span>
                                </a>
                                <a href="/account/change-password"
                                   class="list-group-item list-group-item-action d-flex align-items-center">
                                    <i class="fas fa-lock me-3"></i>
                                    <span>Change Password</span>
                                </a>
                                @if (user?.UserType == UserType.Doctor)
                                {
                                    <a href="/doctor/dashboard"
                                       class="list-group-item list-group-item-action d-flex align-items-center">
                                        <i class="fas fa-user-md me-3"></i>
                                        <span>Instructor Dashboard</span>
                                    </a>
                                }
                                else if (user?.UserType == UserType.Admin)
                                {
                                    <a href="/admin/dashboard"
                                       class="list-group-item list-group-item-action d-flex align-items-center">
                                        <i class="fas fa-user-cog me-3"></i>
                                        <span>Admin Dashboard</span>
                                    </a>
                                }
                                <button type="button"
                                        class="list-group-item list-group-item-action d-flex align-items-center text-danger border-0 bg-transparent"
                                        @onclick="Logout">
                                    <i class="fas fa-sign-out-alt me-3"></i>
                                    <span>Logout</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Desktop Profile Sidebar -->
                    <div class="d-none d-md-block">
                        <div class="card shadow-sm border-0">
                            <div class="card-body text-center">
                                <div class="position-relative mb-3">
                                    @if (isUploadingProfileImage)
                                    {
                                        <div class="profile-image-container">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Uploading...</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="profile-image-container">
                                            <img src="@profileImageUrl"
                                                 alt="Profile Image"
                                                 class="profile-image rounded-circle shadow"
                                                 onerror="this.onerror=null;this.src='@ImageUrlService.GetImageUrl(null)'">

                                            <label class="profile-image-overlay">
                                                <i class="fas fa-camera text-white"></i>
                                                <span class="visually-hidden">Change photo</span>
                                                <InputFile OnChange="HandleProfileImageUpload"
                                                           accept="image/*"
                                                           style="display: none;"
                                                           id="profileImageUpload" />
                                            </label>
                                        </div>
                                    }
                                </div>

                                <h4 class="mb-1">@(user?.FirstName) @(user?.LastName)</h4>
                                <p class="text-muted mb-2">
                                    <i class="fas fa-envelope me-2"></i>@(user?.Email)
                                </p>

                                <div class="d-flex justify-content-center mb-3">
                                    <span class="badge @GetUserTypeBadgeClass()">
                                        <i class="@GetUserTypeIcon() me-1"></i>
                                        @(user?.UserType.ToString())
                                    </span>
                                </div>

                                <div class="text-muted small">
                                    <i class="fas fa-calendar-alt me-1"></i>
                                    Member since: @(user?.CreatedAt.ToString("MMM yyyy"))
                                </div>
                            </div>
                        </div>

                        @if (user?.UserType == UserType.Doctor && user.Profile != null)
                        {
                            <div class="card shadow-sm border-0 mt-4">
                                <div class="card-header bg-info text-white">
                                    <i class="fas fa-chart-line me-2"></i>Instructor Stats
                                </div>
                                <div class="card-body">
                                    <div class="row text-center">
                                        <div class="col-6 mb-3">
                                            <div class="stat-value text-primary">@(user.Profile?.TotalStudents ?? 0)</div>
                                            <div class="stat-label">Students</div>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <div class="stat-value text-success">@((user.Profile?.RatingAverage ?? 0).ToString("0.0"))</div>
                                            <div class="stat-label">Rating</div>
                                        </div>
                                        <div class="col-12">
                                            <div class="stat-value text-warning">$@((user.Profile?.Balance ?? 0).ToString("N2"))</div>
                                            <div class="stat-label">Earnings</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="card shadow-sm border-0 mt-4">
                            <div class="card-body">
                                <div class="list-group list-group-flush">
                                    <a href="/account/profile"
                                       class="list-group-item list-group-item-action active">
                                        <i class="fas fa-user-circle me-2"></i>Profile Information
                                    </a>
                                    <a href="/account/change-password"
                                       class="list-group-item list-group-item-action">
                                        <i class="fas fa-lock me-2"></i>Change Password
                                    </a>
                                    @if (user?.UserType == UserType.Doctor)
                                    {
                                        <a href="/doctor/dashboard"
                                           class="list-group-item list-group-item-action">
                                            <i class="fas fa-user-md me-2"></i>Instructor Dashboard
                                        </a>
                                    }
                                    else if (user?.UserType == UserType.Admin)
                                    {
                                        <a href="/admin/dashboard"
                                           class="list-group-item list-group-item-action">
                                            <i class="fas fa-user-cog me-2"></i>Admin Dashboard
                                        </a>
                                    }
                                    <button type="button"
                                            class="list-group-item list-group-item-action text-danger border-0 bg-transparent"
                                            @onclick="Logout">
                                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Content Area - Responsive -->
                <div class="col-lg-8">
                    <div class="card shadow-sm border-0 rounded-0 rounded-md">
                        <div class="card-header bg-primary text-white d-none d-md-block">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="fas fa-user-edit me-2"></i>Edit Profile
                                </h5>
                                <button class="btn btn-sm btn-light" @onclick="ToggleEditMode">
                                    @(isEditing ? "Cancel" : "Edit Profile")
                                </button>
                            </div>
                        </div>

                        <div class="card-body p-3 p-md-4">
                            <!-- Authentication Status Display (Mobile Optimized) -->
                            @if (showAuthStatus)
                            {
                                <div class="alert @authStatusClass alert-dismissible fade show small p-2 p-md-3" role="alert">
                                    <div class="d-flex align-items-center">
                                        <i class="@authStatusIcon me-2"></i>
                                        <span class="flex-grow-1">@authStatusMessage</span>
                                        <button type="button" class="btn-close btn-close-sm" @onclick="() => showAuthStatus = false"></button>
                                    </div>
                                </div>
                            }

                            @if (showSuccess)
                            {
                                <div class="alert alert-success alert-dismissible fade show small p-2 p-md-3" role="alert">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-check-circle me-2"></i>
                                        <span class="flex-grow-1">Profile updated successfully!</span>
                                        <button type="button" class="btn-close btn-close-sm" @onclick="() => showSuccess = false"></button>
                                    </div>
                                </div>
                            }

                            @if (showError)
                            {
                                <div class="alert alert-danger alert-dismissible fade show small p-2 p-md-3" role="alert">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-exclamation-circle me-2"></i>
                                        <span class="flex-grow-1">@errorMessage</span>
                                        <button type="button" class="btn-close btn-close-sm" @onclick="() => showError = false"></button>
                                    </div>
                                </div>
                            }

                            <!-- View Mode - Mobile Optimized -->
                            @if (!isEditing)
                            {
                                <div class="view-mode">
                                    <!-- Mobile View -->
                                    <div class="d-block d-md-none">
                                        <div class="mb-4">
                                            <h6 class="fw-bold mb-3">
                                                <i class="fas fa-info-circle me-2 text-primary"></i>Personal Information
                                            </h6>

                                            <div class="bg-light p-3 rounded mb-3">
                                                <div class="d-flex justify-content-between mb-2">
                                                    <span class="text-muted">First Name:</span>
                                                    <span class="fw-medium">@user?.FirstName</span>
                                                </div>
                                                <div class="d-flex justify-content-between mb-2">
                                                    <span class="text-muted">Last Name:</span>
                                                    <span class="fw-medium">@user?.LastName</span>
                                                </div>
                                                <div class="d-flex justify-content-between mb-2">
                                                    <span class="text-muted">Email:</span>
                                                    <span class="fw-medium text-break">@user?.Email</span>
                                                </div>
                                                <div class="d-flex justify-content-between mb-2">
                                                    <span class="text-muted">Phone:</span>
                                                    <span class="fw-medium">@(user?.PhoneNumber ?? "Not provided")</span>
                                                </div>
                                                <div class="d-flex justify-content-between">
                                                    <span class="text-muted">Date of Birth:</span>
                                                    <span class="fw-medium">@(user?.DateOfBirth?.ToString("MMM dd, yyyy") ?? "Not provided")</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mb-4">
                                            <h6 class="fw-bold mb-3">
                                                <i class="fas fa-align-left me-2 text-primary"></i>Bio
                                            </h6>
                                            <div class="bg-light p-3 rounded">
                                                @(string.IsNullOrEmpty(user?.Bio) ? "No bio provided" : user.Bio)
                                            </div>
                                        </div>

                                        @if (user?.Profile != null)
                                        {
                                            <div class="mb-4">
                                                <h6 class="fw-bold mb-3">
                                                    <i class="fas fa-id-card me-2 text-primary"></i>Additional Information
                                                </h6>

                                                <div class="bg-light p-3 rounded">
                                                    @if (!string.IsNullOrEmpty(user.Profile.Title))
                                                    {
                                                        <div class="d-flex justify-content-between mb-2">
                                                            <span class="text-muted">Title:</span>
                                                            <span class="fw-medium">@user.Profile.Title</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(user.Profile.Department))
                                                    {
                                                        <div class="d-flex justify-content-between mb-2">
                                                            <span class="text-muted">Department:</span>
                                                            <span class="fw-medium">@user.Profile.Department</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(user.Profile.Institution))
                                                    {
                                                        <div class="d-flex justify-content-between mb-2">
                                                            <span class="text-muted">Institution:</span>
                                                            <span class="fw-medium">@user.Profile.Institution</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(user.Profile.Expertise))
                                                    {
                                                        <div class="d-flex justify-content-between mb-2">
                                                            <span class="text-muted">Expertise:</span>
                                                            <span class="fw-medium">@user.Profile.Expertise</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(user.Profile.EducationBackground))
                                                    {
                                                        <div class="mb-2">
                                                            <span class="text-muted d-block mb-1">Education:</span>
                                                            <span class="fw-medium">@user.Profile.EducationBackground</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(user.Profile.Interests))
                                                    {
                                                        <div>
                                                            <span class="text-muted d-block mb-1">Interests:</span>
                                                            <span class="fw-medium">@user.Profile.Interests</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <!-- Mobile Edit Button -->
                                        <button class="btn btn-primary w-100 mt-3 d-block d-md-none" @onclick="ToggleEditMode">
                                            <i class="fas fa-edit me-2"></i>Edit Profile
                                        </button>
                                    </div>

                                    <!-- Desktop View -->
                                    <div class="d-none d-md-block">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label text-muted">First Name</label>
                                                <div class="form-control-plaintext">@user?.FirstName</div>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label text-muted">Last Name</label>
                                                <div class="form-control-plaintext">@user?.LastName</div>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label text-muted">Email</label>
                                                <div class="form-control-plaintext">@user?.Email</div>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label text-muted">Phone Number</label>
                                                <div class="form-control-plaintext">@(user?.PhoneNumber ?? "Not provided")</div>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label text-muted">Date of Birth</label>
                                                <div class="form-control-plaintext">
                                                    @(user?.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "Not provided")
                                                </div>
                                            </div>
                                            <div class="col-12 mb-3">
                                                <label class="form-label text-muted">Bio</label>
                                                <div class="form-control-plaintext">
                                                    @(string.IsNullOrEmpty(user?.Bio) ? "No bio provided" : user.Bio)
                                                </div>
                                            </div>
                                        </div>

                                        @if (user?.Profile != null)
                                        {
                                            <div class="mt-4 pt-4 border-top">
                                                <h6 class="text-muted mb-3">
                                                    <i class="fas fa-id-card me-2"></i>Additional Information
                                                </h6>
                                                <div class="row">
                                                    @if (!string.IsNullOrEmpty(user.Profile.Title))
                                                    {
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label text-muted">Title</label>
                                                            <div class="form-control-plaintext">@user.Profile.Title</div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(user.Profile.Department))
                                                    {
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label text-muted">Department</label>
                                                            <div class="form-control-plaintext">@user.Profile.Department</div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(user.Profile.Institution))
                                                    {
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label text-muted">Institution</label>
                                                            <div class="form-control-plaintext">@user.Profile.Institution</div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(user.Profile.Expertise))
                                                    {
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label text-muted">Expertise</label>
                                                            <div class="form-control-plaintext">@user.Profile.Expertise</div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(user.Profile.EducationBackground))
                                                    {
                                                        <div class="col-12 mb-3">
                                                            <label class="form-label text-muted">Education</label>
                                                            <div class="form-control-plaintext">@user.Profile.EducationBackground</div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(user.Profile.Interests))
                                                    {
                                                        <div class="col-12 mb-3">
                                                            <label class="form-label text-muted">Interests</label>
                                                            <div class="form-control-plaintext">@user.Profile.Interests</div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Edit Mode - Mobile Optimized -->
                                <EditForm Model="@updateUserDto" OnValidSubmit="@HandleSaveProfile">
                                    <DataAnnotationsValidator />

                                    <!-- Mobile Edit Form -->
                                    <div class="d-block d-md-none">
                                        <h6 class="fw-bold mb-3">
                                            <i class="fas fa-info-circle me-2 text-primary"></i>Personal Information
                                        </h6>

                                        <div class="mb-3">
                                            <label for="mobileFirstName" class="form-label small">First Name *</label>
                                            <InputText id="mobileFirstName"
                                                       class="@($"form-control form-control-sm {(errors.ContainsKey("FirstName") ? "is-invalid" : "")}")"
                                                       @bind-Value="updateUserDto.FirstName" />
                                            @if (errors.ContainsKey("FirstName"))
                                            {
                                                <div class="invalid-feedback small">@errors["FirstName"]</div>
                                            }
                                        </div>

                                        <div class="mb-3">
                                            <label for="mobileLastName" class="form-label small">Last Name *</label>
                                            <InputText id="mobileLastName"
                                                       class="@($"form-control form-control-sm {(errors.ContainsKey("LastName") ? "is-invalid" : "")}")"
                                                       @bind-Value="updateUserDto.LastName" />
                                            @if (errors.ContainsKey("LastName"))
                                            {
                                                <div class="invalid-feedback small">@errors["LastName"]</div>
                                            }
                                        </div>

                                        <div class="mb-3">
                                            <label for="mobilePhone" class="form-label small">Phone Number</label>
                                            <InputText id="mobilePhone"
                                                       class="form-control form-control-sm"
                                                       @bind-Value="updateUserDto.PhoneNumber"
                                                       placeholder="Enter phone number" />
                                        </div>

                                        <div class="mb-3">
                                            <label for="mobileDob" class="form-label small">Date of Birth</label>
                                            <InputDate id="mobileDob"
                                                       class="form-control form-control-sm"
                                                       @bind-Value="dateOfBirthEdit"
                                                       max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                        </div>

                                        <div class="mb-4">
                                            <label for="mobileBio" class="form-label small">Bio</label>
                                            <InputTextArea id="mobileBio"
                                                           class="form-control form-control-sm"
                                                           rows="3"
                                                           @bind-Value="updateUserDto.Bio"
                                                           placeholder="Tell us about yourself" />
                                        </div>

                                        <hr class="my-4">

                                        <h6 class="fw-bold mb-3">
                                            <i class="fas fa-id-card me-2 text-primary"></i>Additional Information
                                        </h6>

                                        @if (user?.UserType == UserType.Doctor)
                                        {
                                            <div class="mb-3">
