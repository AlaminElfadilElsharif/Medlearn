    private async Task HandleProfileImageUpload(InputFileChangeEventArgs e)
    {
        isUploadingProfileImage = true;
        showError = false;
        showAuthStatus = false;

        try
        {
            var file = e.File;

            // Validate file
            if (file.Size > 5 * 1024 * 1024) // 5MB limit
            {
                showError = true;
                errorMessage = "File size must be less than 5MB";
                isUploadingProfileImage = false;
                StateHasChanged();
                return;
            }

            if (!file.ContentType.StartsWith("image/"))
            {
                showError = true;
                errorMessage = "Only image files are allowed";
                isUploadingProfileImage = false;
                StateHasChanged();
                return;
            }

            // IMPORTANT: Read the file into a MemoryStream first
            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(memoryStream);
            memoryStream.Position = 0; // Reset position

            // Use the memory stream instead of the browser file stream
            var fileUrl = await AuthService.UploadProfileImageAsync(memoryStream, file.Name);

            if (!string.IsNullOrEmpty(fileUrl))
            {
                // Update local user object
                if (user != null)
                {
                    // Store the relative URL
                    user.ProfileImageUrl = fileUrl;

                    // Update display URL using ImageUrlService
                    profileImageUrl = ImageUrlService.GetImageUrl(fileUrl);

                    updateUserDto.ProfileImageUrl = fileUrl;

                    // Update localStorage
                    await UpdateLocalStorage();

                    showSuccess = true;
                    ShowAuthStatus("success", "Profile image updated successfully!", "fas fa-check-circle", "alert-success");

                    Console.WriteLine("Profile image updated successfully!");
                }
            }
            else
            {
                showError = true;
                errorMessage = "Failed to upload image";
                ShowAuthStatus("error", "Failed to upload image", "fas fa-exclamation-circle", "alert-danger");
            }
        }
        catch (HttpRequestException httpEx) when (httpEx.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            showError = true;
            errorMessage = "Your session has expired. Please log in again.";
            ShowAuthStatus("error", "Session expired. Please log in again.", "fas fa-exclamation-circle", "alert-danger");

            // Clear invalid token
            await TokenService.RemoveTokenAsync();
            isAuthenticated = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = "Failed to upload image: " + ex.Message;
            ShowAuthStatus("error", $"Failed to upload image: {ex.Message}", "fas fa-exclamation-circle", "alert-danger");
            Console.WriteLine($"Error uploading image: {ex.Message}");
        }
        finally
        {
            isUploadingProfileImage = false;
            StateHasChanged();
        }
    }

