        showError = false;
        showAuthStatus = false;
        if (!isEditing)
        {
            // Reset to original data when canceling edit
            InitializeFromCurrentUser();
        }
    }

    private async Task Logout()
    {
        try
        {
            ShowAuthStatus("info", "Logging out...", "fas fa-sign-out-alt", "alert-info");
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/account/login", true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during logout: {ex.Message}");
            ShowAuthStatus("error", $"Error during logout: {ex.Message}", "fas fa-exclamation-circle", "alert-danger");
        }
    }

    private void ReloadPage()
    {
        Navigation.NavigateTo(Navigation.Uri, true);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    private string GetUserTypeBadgeClass()
    {
        return user?.UserType switch
        {
            UserType.Admin => "bg-danger",
            UserType.Doctor => "bg-info",
            _ => "bg-primary"
        };
    }

    private string GetUserTypeIcon()
    {
        return user?.UserType switch
        {
            UserType.Admin => "fas fa-user-cog",
            UserType.Doctor => "fas fa-user-md",
            _ => "fas fa-user-graduate"
        };
    }
}
