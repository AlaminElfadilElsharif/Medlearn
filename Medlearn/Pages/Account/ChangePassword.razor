@page "/account/change-password"


<PageTitle>Change Password - Learning Platform</PageTitle>

<!-- Mobile View -->
<div class="d-block d-md-none">
    <!-- Mobile Header -->
    <div class="bg-warning text-white">
        <div class="d-flex align-items-center p-3">
            <button class="btn btn-link text-white p-0 me-3" @onclick="GoBack">
                <i class="fas fa-arrow-left fa-lg"></i>
            </button>
            <div class="flex-grow-1">
                <h5 class="mb-0">Change Password</h5>
                <small class="opacity-75">Keep your account secure</small>
            </div>
        </div>
    </div>

    <!-- Mobile Content -->
    <div class="p-3">
        @if (isCheckingAuth)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-warning mb-3" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="text-muted">Loading...</p>
            </div>
        }
        else if (!isAuthenticated)
        {
            <div class="text-center py-4">
                <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                    <i class="fas fa-lock fa-3x text-warning"></i>
                </div>
                <h5>Authentication Required</h5>
                <p class="text-muted small mb-4">You need to be logged in to change your password.</p>
                <button class="btn btn-warning w-100" @onclick='() => Navigation.NavigateTo($"/login?returnUrl={Navigation.Uri}")'>
                    <i class="fas fa-sign-in-alt me-2"></i> Go to Login
                </button>
            </div>
        }
        else if (showSuccess)
        {
            <div class="text-center py-4">
                <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                    <i class="fas fa-check-circle fa-3x text-success"></i>
                </div>
                <h5 class="text-success">Success!</h5>
                <p class="text-muted small mb-3">Password changed successfully!</p>
                <div class="progress mb-3" style="height: 3px;">
                    <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" 
                         style="width: 100%"></div>
                </div>
                <p class="text-muted small">Redirecting to profile...</p>
            </div>
        }
        else
        {
            <!-- Mobile Form -->
            <form @onsubmit="HandleChangePassword">
                <!-- Security Info Collapse -->
                <div class="mb-3">
                    <div class="bg-info bg-opacity-10 rounded p-3" 
                         data-bs-toggle="collapse" 
                         data-bs-target="#passwordRequirements"
                         role="button"
                         aria-expanded="false">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-shield-alt text-info me-2"></i>
                            <span class="flex-grow-1 small fw-bold">Password Requirements</span>
                            <i class="fas fa-chevron-down text-muted"></i>
                        </div>
                    </div>
                    <div class="collapse mt-2" id="passwordRequirements">
                        <div class="card card-body bg-light p-3">
                            <ul class="small mb-0 ps-3">
                                <li class="mb-1">At least 8 characters long</li>
                                <li class="mb-1">Contains at least one uppercase letter</li>
                                <li class="mb-1">Contains at least one lowercase letter</li>
                                <li class="mb-1">Contains at least one number</li>
                                <li class="mb-1">Contains at least one special character</li>
                            </ul>
                        </div>
                    </div>
                </div>

                @if (showError)
                {
                    <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                        <i class="fas fa-exclamation-circle me-1"></i>
                        @errorMessage
                        <button type="button" class="btn-close btn-sm" @onclick="() => showError = false"></button>
                    </div>
                }

                <!-- Current Password -->
                <div class="mb-3">
                    <label class="form-label small fw-bold">Current Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-lock text-muted"></i>
                        </span>
                        <input type="@(showCurrentPassword ? "text" : "password")"
                               class="form-control form-control-sm @(errors.ContainsKey("CurrentPassword") ? "is-invalid" : "")"
                               placeholder="Enter current password"
                               @bind="changePasswordDto.CurrentPassword"
                               @bind:event="oninput" />
                        <button class="btn btn-outline-secondary btn-sm" 
                                type="button"
                                @onclick="ToggleCurrentPasswordVisibility">
                            <i class="@(showCurrentPassword ? "fas fa-eye-slash" : "fas fa-eye")"></i>
                        </button>
                    </div>
                    @if (errors.ContainsKey("CurrentPassword"))
                    {
                        <div class="text-danger small mt-1">
                            <i class="fas fa-exclamation-circle me-1"></i>
                            @errors["CurrentPassword"]
                        </div>
                    }
                </div>

                <!-- New Password -->
                <div class="mb-3">
                    <label class="form-label small fw-bold">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-key text-muted"></i>
                        </span>
                        <input type="@(showNewPassword ? "text" : "password")"
                               class="form-control form-control-sm @(errors.ContainsKey("NewPassword") ? "is-invalid" : "")"
                               placeholder="Enter new password"
                               @bind="changePasswordDto.NewPassword"
                               @bind:event="oninput"
                               @onkeyup="CalculatePasswordStrength" />
                        <button class="btn btn-outline-secondary btn-sm" 
                                type="button"
                                @onclick="ToggleNewPasswordVisibility">
                            <i class="@(showNewPassword ? "fas fa-eye-slash" : "fas fa-eye")"></i>
                        </button>
                    </div>

                    <!-- Password Strength (Mobile) -->
                    @if (!string.IsNullOrEmpty(changePasswordDto.NewPassword))
                    {
                        <div class="mt-2">
                            <div class="d-flex align-items-center mb-1">
                                <div class="flex-grow-1 me-2">
                                    <div class="progress" style="height: 4px;">
                                        <div class="progress-bar @GetPasswordStrengthClass()"
                                             role="progressbar"
                                             style="@($"width: {passwordStrength}%")">
                                        </div>
                                    </div>
                                </div>
                                <small class="fw-bold @GetPasswordStrengthTextClass()">@GetPasswordStrengthText()</small>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-1">
                                <small class="text-muted me-2">Requirements:</small>
                                <small class="@(changePasswordDto.NewPassword.Length >= 8 ? "text-success" : "text-muted")">
                                    <i class="fas @(changePasswordDto.NewPassword.Length >= 8 ? "fa-check-circle" : "fa-circle") fa-xs me-1"></i>8+ chars
                                </small>
                                <small class="@(HasUppercase() ? "text-success" : "text-muted")">
                                    <i class="fas @(HasUppercase() ? "fa-check-circle" : "fa-circle") fa-xs me-1"></i>A-Z
                                </small>
                                <small class="@(HasLowercase() ? "text-success" : "text-muted")">
                                    <i class="fas @(HasLowercase() ? "fa-check-circle" : "fa-circle") fa-xs me-1"></i>a-z
                                </small>
                                <small class="@(HasNumber() ? "text-success" : "text-muted")">
                                    <i class="fas @(HasNumber() ? "fa-check-circle" : "fa-circle") fa-xs me-1"></i>0-9
                                </small>
                                <small class="@(HasSpecialChar() ? "text-success" : "text-muted")">
                                    <i class="fas @(HasSpecialChar() ? "fa-check-circle" : "fa-circle") fa-xs me-1"></i>
                                    &#33;&#64;&#35;
                                </small>
                            </div>
                        </div>
                    }

                    @if (errors.ContainsKey("NewPassword"))
                    {
                        <div class="text-danger small mt-1">
                            <i class="fas fa-exclamation-circle me-1"></i>
                            @errors["NewPassword"]
                        </div>
                    }
                </div>

                <!-- Confirm New Password -->
                <div class="mb-4">
                    <label class="form-label small fw-bold">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-check-circle text-muted"></i>
                        </span>
                        <input type="@(showConfirmNewPassword ? "text" : "password")"
                               class="form-control form-control-sm @(errors.ContainsKey("ConfirmNewPassword") ? "is-invalid" : "")"
                               placeholder="Confirm new password"
                               @bind="confirmNewPassword"
                               @bind:event="oninput" />
                        <button class="btn btn-outline-secondary btn-sm" 
                                type="button"
                                @onclick="ToggleConfirmNewPasswordVisibility">
                            <i class="@(showConfirmNewPassword ? "fas fa-eye-slash" : "fas fa-eye")"></i>
                        </button>
                    </div>
                    @if (errors.ContainsKey("ConfirmNewPassword"))
                    {
                        <div class="text-danger small mt-1">
                            <i class="fas fa-exclamation-circle me-1"></i>
                            @errors["ConfirmNewPassword"]
                        </div>
                    }

                    <!-- Password Match Indicator -->
                    @if (!string.IsNullOrEmpty(confirmNewPassword) && !string.IsNullOrEmpty(changePasswordDto.NewPassword))
                    {
                        <div class="mt-1">
                            @if (changePasswordDto.NewPassword == confirmNewPassword)
                            {
                                <small class="text-success">
                                    <i class="fas fa-check-circle me-1"></i>Passwords match
                                </small>
                            }
                            else
                            {
                                <small class="text-danger">
                                    <i class="fas fa-exclamation-circle me-1"></i>Passwords do not match
                                </small>
                            }
                        </div>
                    }
                </div>

                <!-- Mobile Action Buttons -->
                <div class="fixed-bottom p-3 bg-white border-top">
                    <div class="d-flex gap-2">
                        <button type="button" 
                                class="btn btn-outline-secondary flex-fill" 
                                @onclick="GoBack">
                            Cancel
                        </button>
                        <button type="submit" 
                                class="btn btn-warning flex-fill" 
                                disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Updating...</span>
                            }
                            else
                            {
                                <text>Update Password</text>
                            }
                        </button>
                    </div>
                </div>

                <!-- Spacer for fixed bottom button -->
                <div class="mb-5 pb-4"></div>
            </form>
        }
    </div>
</div>

<!-- Desktop View -->
<div class="d-none d-md-block">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/" class="text-decoration-none">Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="/account/profile" class="text-decoration-none">Profile</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Change Password</li>
                    </ol>
                </nav>

                <!-- Main Card -->
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-warning text-white text-center py-4">
                        <h3 class="mb-0">
                            <i class="fas fa-key me-2"></i>Change Password
                        </h3>
                        <p class="mb-0 mt-2 small opacity-75">Keep your account secure</p>
                    </div>

                    <div class="card-body p-4">
                        @if (isCheckingAuth)
                        {
                            <div class="text-center py-4">
                                <div class="spinner-border text-warning mb-3" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="text-muted">Loading your account information...</p>
                            </div>
                        }
                        else if (!isAuthenticated)
                        {
                            <div class="alert alert-warning text-center">
                                <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                                <h4>Authentication Required</h4>
                                <p class="mb-4">You need to be logged in to change your password.</p>
                                <button class="btn btn-warning" @onclick='() => Navigation.NavigateTo($"/login?returnUrl={Navigation.Uri}")'>
                                    <i class="fas fa-sign-in-alt me-2"></i> Go to Login
                                </button>
                            </div>
                        }
                        else if (showSuccess)
                        {
                            <div class="text-center py-4">
                                <div class="text-success mb-3">
                                    <i class="fas fa-check-circle fa-4x"></i>
                                </div>
                                <h4 class="text-success mb-3">Password Changed Successfully!</h4>
                                <p class="text-muted mb-4">Your password has been updated. You'll be redirected to your profile in a moment.</p>
                                <div class="progress mb-3" style="height: 5px;">
                                    <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" 
                                         style="width: 100%"></div>
                                </div>
                                <p class="text-muted small">Redirecting...</p>
                            </div>
                        }
                        else
                        {
                            <!-- Requirements Alert -->
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>Password Requirements:</strong>
                                <ul class="mb-0 mt-2">
                                    <li>At least 8 characters long</li>
                                    <li>Contains at least one uppercase letter</li>
                                    <li>Contains at least one lowercase letter</li>
                                    <li>Contains at least one number</li>
                                    <li>Contains at least one special character</li>
                                </ul>
                            </div>

                            @if (showError)
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="fas fa-exclamation-circle me-2"></i>
                                    @errorMessage
                                    <button type="button" class="btn-close" @onclick="() => showError = false"></button>
                                </div>
                            }

                            <!-- Desktop Form -->
                            <form @onsubmit="HandleChangePassword">
                                <!-- Current Password -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold">Current Password</label>
                                    <div class="input-group">
                                        <input type="@(showCurrentPassword ? "text" : "password")"
                                               class="form-control @(errors.ContainsKey("CurrentPassword") ? "is-invalid" : "")"
                                               @bind="changePasswordDto.CurrentPassword"
                                               @bind:event="oninput"
                                               placeholder="Enter your current password" />
                                        <button class="btn btn-outline-secondary"
                                                type="button"
                                                @onclick="ToggleCurrentPasswordVisibility">
                                            <i class="@(showCurrentPassword ? "fas fa-eye-slash" : "fas fa-eye")"></i>
                                        </button>
                                    </div>
                                    @if (errors.ContainsKey("CurrentPassword"))
                                    {
                                        <div class="invalid-feedback d-block">
                                            @errors["CurrentPassword"]
                                        </div>
                                    }
                                </div>

                                <!-- New Password -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold">New Password</label>
                                    <div class="input-group">
                                        <input type="@(showNewPassword ? "text" : "password")"
                                               class="form-control @(errors.ContainsKey("NewPassword") ? "is-invalid" : "")"
                                               @bind="changePasswordDto.NewPassword"
                                               @bind:event="oninput"
                                               @onkeyup="CalculatePasswordStrength"
                                               placeholder="Enter new password" />
                                        <button class="btn btn-outline-secondary"
                                                type="button"
                                                @onclick="ToggleNewPasswordVisibility">
                                            <i class="@(showNewPassword ? "fas fa-eye-slash" : "fas fa-eye")"></i>
                                        </button>
                                    </div>

                                    <!-- Password Strength Indicator -->
                                    <div class="password-strength mt-2">
                                        <div class="progress" style="height: 5px;">
                                            <div class="progress-bar @GetPasswordStrengthClass()"
                                                 role="progressbar"
                                                 style="@($"width: {passwordStrength}%")">
                                            </div>
                                        </div>
                                        <small class="text-muted mt-1 d-block">
                                            Password strength: <span class="fw-bold @GetPasswordStrengthTextClass()">@GetPasswordStrengthText()</span>
                                        </small>
                                    </div>

                                    @if (errors.ContainsKey("NewPassword"))
                                    {
                                        <div class="invalid-feedback d-block">
                                            @errors["NewPassword"]
                                        </div>
                                    }
                                </div>

                                <!-- Confirm New Password -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold">Confirm New Password</label>
                                    <div class="input-group">
                                        <input type="@(showConfirmNewPassword ? "text" : "password")"
                                               class="form-control @(errors.ContainsKey("ConfirmNewPassword") ? "is-invalid" : "")"
                                               @bind="confirmNewPassword"
                                               @bind:event="oninput"
                                               placeholder="Confirm your new password" />
                                        <button class="btn btn-outline-secondary"
                                                type="button"
                                                @onclick="ToggleConfirmNewPasswordVisibility">
                                            <i class="@(showConfirmNewPassword ? "fas fa-eye-slash" : "fas fa-eye")"></i>
                                        </button>
                                    </div>
                                    @if (errors.ContainsKey("ConfirmNewPassword"))
                                    {
                                        <div class="invalid-feedback d-block">
                                            @errors["ConfirmNewPassword"]
                                        </div>
                                    }
                                </div>

                                <!-- Desktop Action Buttons -->
                                <div class="d-flex justify-content-between">
                                    <button type="button" 
                                            class="btn btn-outline-secondary" 
                                            @onclick="GoBack">
                                        <i class="fas fa-times me-2"></i>Cancel
                                    </button>
                                    <button type="submit" 
                                            class="btn btn-warning px-4" 
                                            disabled="@isLoading">
                                        @if (isLoading)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <span>Processing...</span>
                                        }
                                        else
                                        {
                                            <text>
                                                <i class="fas fa-save me-2"></i>Change Password
                                            </text>
                                        }
                                    </button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ChangePasswordDto changePasswordDto = new ChangePasswordDto();
    private string confirmNewPassword = string.Empty;

    private bool showCurrentPassword;
    private bool showNewPassword;
    private bool showConfirmNewPassword;

    private int passwordStrength;
    private bool isLoading;
    private bool isCheckingAuth = true;
    private bool isAuthenticated = false;
    private bool showSuccess;
    private bool showError;
    private string errorMessage = string.Empty;
    private int? currentUserId;
    private UserDto? currentUser;

    private Dictionary<string, string> errors = new Dictionary<string, string>();

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isAuthenticated = await TokenService.IsAuthenticatedAsync();
            
            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();
                
                if (currentUser != null)
                {
                    currentUserId = currentUser.Id;
                }
                else
                {
                    isAuthenticated = false;
                    await TokenService.RemoveTokenAsync();
                    await JS.InvokeVoidAsync("localStorage.removeItem", "currentUser");
                }
            }
            else
            {
                currentUser = null;
                currentUserId = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            currentUser = null;
            currentUserId = null;
        }
        finally
        {
            isCheckingAuth = false;
            StateHasChanged();
        }
    }

    private void ToggleCurrentPasswordVisibility() => showCurrentPassword = !showCurrentPassword;
    private void ToggleNewPasswordVisibility() => showNewPassword = !showNewPassword;
    private void ToggleConfirmNewPasswordVisibility() => showConfirmNewPassword = !showConfirmNewPassword;

    private void GoBack()
    {
        Navigation.NavigateTo("/account/profile");
    }

    private async Task HandleChangePassword()
    {
        if (!isAuthenticated || !currentUserId.HasValue)
        {
            showError = true;
            errorMessage = "Session expired. Please login again.";
            StateHasChanged();
            
            await Task.Delay(2000);
            Navigation.NavigateTo($"/login?returnUrl={Navigation.Uri}", true);
            return;
        }

        isLoading = true;
        showError = false;
        errors.Clear();
        StateHasChanged();

        ValidateForm();

        if (errors.Count > 0)
        {
            isLoading = false;
            showError = true;
            errorMessage = "Please fix the validation errors";
            StateHasChanged();
            return;
        }

        try
        {
            var result = await AuthService.ChangePasswordAsync(currentUserId.Value, changePasswordDto);
            
            if (result)
            {
                showSuccess = true;
                showError = false;
                
                changePasswordDto = new ChangePasswordDto();
                confirmNewPassword = string.Empty;
                passwordStrength = 0;
                
                StateHasChanged();
                
                await Task.Delay(2000);
                Navigation.NavigateTo("/account/profile?message=password-changed", true);
            }
            else
            {
                showError = true;
                errorMessage = "Failed to change password. Please try again.";
                isLoading = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = GetUserFriendlyErrorMessage(ex);
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetUserFriendlyErrorMessage(Exception ex)
    {
        var message = ex.Message.ToLower();
        
        if (message.Contains("current password") && message.Contains("incorrect"))
            return "Your current password is incorrect.";
        
        if (message.Contains("unauthorized") || message.Contains("401"))
            return "Your session has expired. Please login again.";
        
        if (message.Contains("not found") || message.Contains("404"))
            return "User account not found. Please login again.";
        
        if (message.Contains("permission") || message.Contains("forbidden") || message.Contains("403"))
            return "You don't have permission to change this password.";
        
        if (message.Contains("network") || message.Contains("connection"))
            return "Network error. Please check your connection and try again.";
        
        return "An error occurred while changing password. Please try again.";
    }

    private void ValidateForm()
    {
        errors.Clear();

        if (string.IsNullOrWhiteSpace(changePasswordDto.CurrentPassword))
        {
            errors["CurrentPassword"] = "Current password is required";
        }

        if (string.IsNullOrWhiteSpace(changePasswordDto.NewPassword))
        {
            errors["NewPassword"] = "New password is required";
        }
        else
        {
            if (changePasswordDto.NewPassword.Length < 8)
                errors["NewPassword"] = "Password must be at least 8 characters";
            
            if (!HasUppercase())
                errors["NewPassword"] = "Password must contain at least one uppercase letter";
            
            if (!HasLowercase())
                errors["NewPassword"] = "Password must contain at least one lowercase letter";
            
            if (!HasNumber())
                errors["NewPassword"] = "Password must contain at least one number";
            
            if (!HasSpecialChar())
                errors["NewPassword"] = "Password must contain at least one special character (!@#$%^&*(),.?\":{}|<>)";
        }

        if (string.IsNullOrWhiteSpace(confirmNewPassword))
        {
            errors["ConfirmNewPassword"] = "Please confirm your new password";
        }
        else if (changePasswordDto.NewPassword != confirmNewPassword)
        {
            errors["ConfirmNewPassword"] = "Passwords do not match";
        }

        if (!string.IsNullOrEmpty(changePasswordDto.CurrentPassword) && 
            !string.IsNullOrEmpty(changePasswordDto.NewPassword) &&
            changePasswordDto.CurrentPassword == changePasswordDto.NewPassword)
        {
            errors["NewPassword"] = "New password cannot be the same as current password";
        }

        CalculatePasswordStrength();
    }

    private void CalculatePasswordStrength()
    {
        var password = changePasswordDto.NewPassword ?? string.Empty;
        var strength = 0;

        if (password.Length >= 8) strength += 20;
        if (password.Length >= 12) strength += 10;
        if (HasUppercase()) strength += 20;
        if (HasLowercase()) strength += 20;
        if (HasNumber()) strength += 15;
        if (HasSpecialChar()) strength += 15;

        passwordStrength = Math.Min(strength, 100);
        StateHasChanged();
    }

    private bool HasUppercase() =>
        !string.IsNullOrEmpty(changePasswordDto.NewPassword) &&
        System.Text.RegularExpressions.Regex.IsMatch(changePasswordDto.NewPassword, "[A-Z]");

    private bool HasLowercase() =>
        !string.IsNullOrEmpty(changePasswordDto.NewPassword) &&
        System.Text.RegularExpressions.Regex.IsMatch(changePasswordDto.NewPassword, "[a-z]");

    private bool HasNumber() =>
        !string.IsNullOrEmpty(changePasswordDto.NewPassword) &&
        System.Text.RegularExpressions.Regex.IsMatch(changePasswordDto.NewPassword, "[0-9]");

    private bool HasSpecialChar() =>
        !string.IsNullOrEmpty(changePasswordDto.NewPassword) &&
        System.Text.RegularExpressions.Regex.IsMatch(changePasswordDto.NewPassword, "[!@#$%^&*(),.?\":{}|<>]");

    private string GetPasswordStrengthClass() =>
        passwordStrength < 40 ? "bg-danger" :
        passwordStrength < 70 ? "bg-warning" :
        "bg-success";

    private string GetPasswordStrengthText() =>
        passwordStrength < 40 ? "Weak" :
        passwordStrength < 70 ? "Medium" :
        "Strong";

    private string GetPasswordStrengthTextClass() =>
        passwordStrength < 40 ? "text-danger" :
        passwordStrength < 70 ? "text-warning" :
        "text-success";
}
