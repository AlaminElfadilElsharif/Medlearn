@code {
    private bool isAuthenticated = false;
    private UserDto? currentUser = null;
    private bool isLoading = false;
    private string currentUrl = "";
    private bool showMobileMenu = false;
    private string? openDropdown = null;
    private bool isDesktop = true;
    private int unreadMessagesCount = 0;

    private string newsletterEmail = "";
    private bool showNewsletterMessage = false;
    private bool newsletterSuccess = false;
    private string newsletterMessage = "";

    protected override async Task OnInitializedAsync()
    {
        currentUrl = Navigation.Uri;
        Navigation.LocationChanged += HandleLocationChanged;
        await CheckAuthentication();
        await CheckScreenSize();
        await LoadUnreadMessagesCount();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeBackToTop();
            await CheckScreenSize();
        }
    }

    private async Task LoadUnreadMessagesCount()
    {
        try
        {
            if (currentUser?.UserType == UserType.Admin)
            {
                unreadMessagesCount = await ContactService.GetUnreadCountAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading unread messages count: {ex.Message}");
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            isAuthenticated = await TokenService.IsAuthenticatedAsync();

            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();
                if (currentUser?.UserType == UserType.Admin)
                {
                    await LoadUnreadMessagesCount();
                }
            }
            else
            {
                currentUser = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CheckAuthentication: {ex.Message}");
            isAuthenticated = false;
            currentUser = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CheckScreenSize()
    {
        try
        {
            isDesktop = await JS.InvokeAsync<bool>("eval", "window.innerWidth >= 992");
        }
        catch
        {
            isDesktop = true;
        }
    }

    private async Task InitializeBackToTop()
    {
        string js = @"
            function initBackToTop() {
                const backToTopBtn = document.querySelector('.btn-floating');
                if (!backToTopBtn) return;
                
                function updateBackToTop() {
                    if (window.scrollY > 300) {
                        backToTopBtn.style.opacity = '1';
                        backToTopBtn.style.transform = 'translateY(0)';
                    } else {
                        backToTopBtn.style.opacity = '0';
                        backToTopBtn.style.transform = 'translateY(20px)';
                    }
                }
                
                window.addEventListener('scroll', updateBackToTop);
                updateBackToTop();
                
                backToTopBtn.addEventListener('click', function() {
                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });
                });
            }
            
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initBackToTop);
            } else {
                initBackToTop();
            }
        ";

        await JS.InvokeVoidAsync("eval", js);
    }

    private void ToggleMobileMenu()
    {
        showMobileMenu = !showMobileMenu;

        // Prevent body scroll when mobile menu is open
        if (showMobileMenu)
        {
            _ = JS.InvokeVoidAsync("eval", "document.body.style.overflow = 'hidden'");
        }
        else
        {
            _ = JS.InvokeVoidAsync("eval", "document.body.style.overflow = ''");
        }
    }

    private void CloseMobileMenu()
    {
        showMobileMenu = false;
        _ = JS.InvokeVoidAsync("eval", "document.body.style.overflow = ''");
    }

    private void OpenDropdown(string dropdownId)
    {
        if (isDesktop)
        {
            openDropdown = dropdownId;
            StateHasChanged();
        }
    }

    private void CloseDropdown(string dropdownId)
    {
        if (isDesktop && openDropdown == dropdownId)
        {
            openDropdown = null;
            StateHasChanged();
        }
    }

    private void ToggleDropdown(string dropdownId)
    {
        if (!isDesktop)
        {
            // On mobile, toggle on click
            openDropdown = openDropdown == dropdownId ? null : dropdownId;
        }
        else
        {
            // On desktop, just open it
            openDropdown = dropdownId;
        }
        StateHasChanged();
    }

    private string GetUserInitials()
    {
        if (currentUser == null) return "G";

        var firstName = currentUser.FirstName?.Trim();
        var lastName = currentUser.LastName?.Trim();

        if (!string.IsNullOrEmpty(firstName) && !string.IsNullOrEmpty(lastName))
        {
            return $"{firstName[0]}{lastName[0]}".ToUpper();
        }
        else if (!string.IsNullOrEmpty(firstName))
        {
            return firstName[0].ToString().ToUpper();
        }

        return "U";
    }

    private string GetUserRoleText()
    {
        if (currentUser == null) return "Guest";

        return currentUser.UserType switch
        {
            UserType.Admin => "Administrator",
            UserType.Doctor => "Doctor/Instructor",
            UserType.User => "Student",
            _ => "User"
        };
    }

    private string GetDashboardLink()
    {
        if (currentUser == null) return "/";

        return currentUser.UserType switch
        {
            UserType.Admin => "/admin/dashboard",
            UserType.Doctor => "/doctor/dashboard",
            UserType.User => "/student/dashboard",
            _ => "/"
        };
    }

    private string GetNavLinkClass(string url)
    {
        if (url == "/learn" && currentUrl.StartsWith("/browse"))
            return "active";
        if (url == "/learn" && currentUrl.StartsWith("/student/mylearning"))
            return "active";
        if (url == "/learn" && currentUrl.StartsWith("/specializations"))
            return "active";
        if (url == "/learn" && currentUrl.StartsWith("/courses"))
            return "active";

        if (url == "/admin" && currentUrl.StartsWith("/admin"))
            return "active";

        if (url == "/doctor" && currentUser?.UserType == UserType.Doctor && currentUrl.StartsWith("/doctor"))
            return "active";

        return currentUrl == url || currentUrl.StartsWith(url + "/") ? "active" : "";
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        currentUrl = e.Location;

        isLoading = true;
        StateHasChanged();

        Task.Run(async () =>
        {
            await Task.Delay(100);
            await CheckAuthentication();

            if (showMobileMenu)
            {
                showMobileMenu = false;
            }

            isLoading = false;
            await InvokeAsync(StateHasChanged);
            await ScrollToTop();
        });
    }

    private async Task ScrollToTop()
    {
        await JS.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
    }

    private async Task Logout()
    {
        try
        {
            await AuthService.LogoutAsync();
            isAuthenticated = false;
            currentUser = null;
            showMobileMenu = false;
            openDropdown = null;
            Navigation.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during logout: {ex.Message}");
            Navigation.NavigateTo("/", true);
        }
    }

    private async Task SubscribeNewsletter()
    {
        if (string.IsNullOrEmpty(newsletterEmail) || !newsletterEmail.Contains("@"))
        {
            newsletterSuccess = false;
            newsletterMessage = "Please enter a valid email address";
            showNewsletterMessage = true;

            await HideMessageAfterDelay(5000);
            return;
        }

        try
        {
            // Simulate API call
            await Task.Delay(1000);

            newsletterSuccess = true;
            newsletterMessage = "Thank you for subscribing to our newsletter!";
            newsletterEmail = "";
            showNewsletterMessage = true;

            await HideMessageAfterDelay(5000);
        }
        catch (Exception ex)
        {
            newsletterSuccess = false;
            newsletterMessage = $"Error: {ex.Message}";
            showNewsletterMessage = true;

            await HideMessageAfterDelay(5000);
        }
    }

    private async Task HideMessageAfterDelay(int milliseconds)
    {
        await Task.Delay(milliseconds);
        await InvokeAsync(() =>
        {
            showNewsletterMessage = false;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
