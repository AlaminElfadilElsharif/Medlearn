@inherits LayoutComponentBase
@namespace Medlearn.Layout



<PageTitle>MedLearn</PageTitle>

<!-- Main Container -->
<div class="d-flex flex-column min-vh-100">

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm d-none d-lg-flex">
        <div class="container-fluid px-4">
            <!-- Logo -->
            <a class="navbar-brand d-flex align-items-center" href="/">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                     style="width: 40px; height: 40px;">
                    <i class="fas fa-stethoscope"></i>
                </div>
                <div>
                    <div class="fw-bold text-primary">MedLearn</div>
                    <div class="small text-muted">Medical Education Platform</div>
                </div>
            </a>

            <!-- Navigation Links -->
            <div class="navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @GetNavLinkClass("/")" href="/">Home</a>
                    </li>

                    @if (isAuthenticated && currentUser != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link @GetNavLinkClass("/dashboard")" href="@GetDashboardLink()">Dashboard</a>
                        </li>

                        <!-- Learn Dropdown with Blazor events -->
                        <li class="nav-item dropdown" @onmouseenter='() => OpenDropdown("learn")' @onmouseleave='() => CloseDropdown("learn")'>
                            <a class="nav-link dropdown-toggle @GetNavLinkClass("/learn")"
                               @onclick='() => ToggleDropdown("learn")'>
                                Learn
                            </a>
                            <ul class="dropdown-menu @(openDropdown == "learn" ? "show" : "")">
                                <li><a class="dropdown-item" href="/browse">Browse Courses</a></li>
                                <li><a class="dropdown-item" href="/student/mylearning">My Learning</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/specializations">Specializations</a></li>
                                <li><a class="dropdown-item" href="/courses">Courses</a></li>
                            </ul>
                        </li>

                        @if (currentUser.UserType == UserType.Admin)
                        {
                            <li class="nav-item dropdown" @onmouseenter='() => OpenDropdown("admin")' @onmouseleave='() => CloseDropdown("admin")'>
                                <a class="nav-link dropdown-toggle @GetNavLinkClass("/admin")"
                                   @onclick='() => ToggleDropdown("admin")'>
                                    Admin
                                </a>
                                <ul class="dropdown-menu @(openDropdown == "admin" ? "show" : "")" style="min-width: 280px;">
                                    <li><h6 class="dropdown-header">Reports</h6></li>
                                    <li><a class="dropdown-item" href="/admin/reports/revenue">Reports revenue</a></li>
                                    <li><a class="dropdown-item" href="/admin/reports/enrollment">Reports enrollment</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">Support</h6></li>
                                    <li>
                                        <div class="px-3 py-2">
                                            <ContactMessagesCompactWidget ShowInNavbar="true" />
                                        </div>
                                    </li>
                                </ul>
                            </li>
                        }
                        else if (currentUser.UserType == UserType.Doctor)
                        {
                            <li class="nav-item dropdown" @onmouseenter='() => OpenDropdown("doctor")' @onmouseleave='() => CloseDropdown("doctor")'>
                                <a class="nav-link dropdown-toggle @GetNavLinkClass("/doctor")"
                                   @onclick='() => ToggleDropdown("doctor")'>
                                    Doctor
                                </a>
                                <ul class="dropdown-menu @(openDropdown == "doctor" ? "show" : "")">
                                    <li><a class="dropdown-item" href="/content/courses">My courses</a></li>
                                    <li><a class="dropdown-item" href="/content/specializations">My specializations</a></li>
                                    <li><a class="dropdown-item" href="/content/lectures">My lectures</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/doctor/earnings/history">Earnings history</a></li>
                                </ul>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @GetNavLinkClass("/browse")" href="/browse">Browse Courses</a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link @GetNavLinkClass("/about")" href="/about">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @GetNavLinkClass("/contact")" href="/contact">Contact</a>
                    </li>
                </ul>

                <!-- Right Side Actions -->
                <div class="d-flex align-items-center">
                    @if (isAuthenticated && currentUser != null)
                    {
                        <!-- Notifications Dropdown - Using the component -->
                        <div class="me-3">
                            <Notifications />
                        </div>

                        <!-- User Profile Dropdown with Blazor events -->
                        <div class="dropdown" @onmouseenter='() => OpenDropdown("user")' @onmouseleave='() => CloseDropdown("user")'>
                            <a class="dropdown-toggle d-flex align-items-center text-decoration-none"
                               href="#"
                               @onclick='() => ToggleDropdown("user")'
                               role="button"
                               id="userDropdown"
                               aria-expanded="@(openDropdown == "user" ? "true" : "false")">
                                <div class="me-2">
                                    @if (!string.IsNullOrEmpty(currentUser.ProfileImageUrl))
                                    {
                                        <img src="@ImageUrlService.GetImageUrl(currentUser.ProfileImageUrl)"
                                             alt="Profile"
                                             class="rounded-circle border"
                                             style="width: 32px; height: 32px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                             style="width: 32px; height: 32px;">
                                            <span class="fw-bold small">@GetUserInitials()</span>
                                        </div>
                                    }
                                </div>
                                <div class="d-none d-md-block">
                                    <div class="fw-semibold">@currentUser.FirstName</div>
                                    <div class="small">
                                        @if (currentUser.UserType == UserType.Admin)
                                        {
                                            <span class="badge bg-danger">Admin</span>
                                        }
                                        else if (currentUser.UserType == UserType.Doctor)
                                        {
                                            <span class="badge bg-info">Doctor</span>
                                        }
                                        else if (currentUser.UserType == UserType.User)
                                        {
                                            <span class="badge bg-success">Student</span>
                                        }
                                    </div>
                                </div>
                            </a>

                            <!-- Dropdown Menu -->
                            <ul class="dropdown-menu dropdown-menu-end @(openDropdown == "user" ? "show" : "")"
                                aria-labelledby="userDropdown"
                                style="width: 280px; max-width: 90vw;">
                                <li>
                                    <a class="dropdown-item" href="/account/profile" @onclick='() => CloseDropdown("user")'>
                                        <i class="fas fa-user me-2" style="width: 16px;"></i> My Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/student/mylearning" @onclick='() => CloseDropdown("user")'>
                                        <i class="fas fa-graduation-cap me-2" style="width: 16px;"></i> My Learning
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/settings" @onclick='() => CloseDropdown("user")'>
                                        <i class="fas fa-cog me-2" style="width: 16px;"></i> Settings
                                    </a>
                                </li>
                                @if (currentUser.UserType == UserType.Doctor)
                                {
                                    <li>
                                        <a class="dropdown-item" href="/doctor/earnings" @onclick='() => CloseDropdown("user")'>
                                            <i class="fas fa-dollar-sign me-2" style="width: 16px;"></i> Earnings
                                        </a>
                                    </li>
                                }
                                @if (currentUser.UserType == UserType.Admin)
                                {
                                    <li>
                                        <a class="dropdown-item" href="/admin/dashboard" @onclick='() => CloseDropdown("user")'>
                                            <i class="fas fa-cogs me-2" style="width: 16px;"></i> Admin Dashboard
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="javascript:void(0)" @onclick="Logout">
                                        <i class="fas fa-sign-out-alt me-2" style="width: 16px;"></i> Logout
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-2">
                            <a href="/account/login" class="btn btn-outline-primary">Login</a>
                            <a href="/account/register" class="btn btn-primary">Sign Up</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Mobile Navbar -->
    <nav class="navbar navbar-light bg-white shadow-sm d-lg-none sticky-top">
        <div class="container-fluid px-3">
            <!-- Logo and Hamburger -->
            <div class="d-flex align-items-center w-100">
                <button class="btn btn-link text-dark me-2" @onclick="ToggleMobileMenu">
                    <i class="fas fa-bars fa-lg"></i>
                </button>
                <a class="navbar-brand flex-grow-1 text-center" href="/">
                    <span class="fw-bold text-primary">MedLearn</span>
                </a>
                @if (isAuthenticated && currentUser != null)
                {
                    <div class="me-2">
                        <Notifications />
                    </div>
                }
            </div>

            <!-- Mobile Menu -->
            @if (showMobileMenu)
            {
                <div class="position-fixed top-0 start-0 w-100 h-100 bg-white" style="z-index: 1050; overflow-y: auto;">
                    <!-- Header -->
                    <div class="p-3 border-bottom bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                @if (isAuthenticated && currentUser != null)
                                {
                                    <div class="me-3">
                                        @if (!string.IsNullOrEmpty(currentUser.ProfileImageUrl))
                                        {
                                            <img src="@ImageUrlService.GetImageUrl(currentUser.ProfileImageUrl)"
                                                 alt="Profile"
                                                 class="rounded-circle border border-3 border-white"
                                                 style="width: 50px; height: 50px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center border border-3 border-white"
                                                 style="width: 50px; height: 50px;">
                                                <span class="fw-bold">@GetUserInitials()</span>
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <h6 class="mb-0">@currentUser.FirstName @currentUser.LastName</h6>
                                        <small>@GetUserRoleText()</small>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-user-circle fa-2x me-2"></i>
                                        <div>
                                            <h6 class="mb-0">Welcome Guest</h6>
                                            <small>Sign in to access features</small>
                                        </div>
                                    </div>
                                }
                            </div>
                            <button class="btn btn-link text-white" @onclick="ToggleMobileMenu">
                                <i class="fas fa-times fa-lg"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Navigation -->
                    <div class="p-3">
                        <!-- Main Navigation -->
                        <div class="mb-4">
                            <a href="/" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/")" @onclick="CloseMobileMenu">
                                <i class="fas fa-home me-3"></i> Home
                            </a>

                            @if (isAuthenticated && currentUser != null)
                            {
                                <a href="@GetDashboardLink()" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/dashboard")" @onclick="CloseMobileMenu">
                                    <i class="fas fa-tachometer-alt me-3"></i> Dashboard
                                </a>

                                <!-- Learning Section -->
                                <div class="mt-3 mb-2">
                                    <small class="text-uppercase text-muted fw-bold">Learning</small>
                                </div>
                                <a href="/browse" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/browse")" @onclick="CloseMobileMenu">
                                    <i class="fas fa-search me-3"></i> Browse Courses
                                </a>
                                <a href="/student/mylearning" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/student/mylearning")" @onclick="CloseMobileMenu">
                                    <i class="fas fa-graduation-cap me-3"></i> My Learning
                                </a>
                                <a href="/specializations" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/specializations")" @onclick="CloseMobileMenu">
                                    <i class="fas fa-layer-group me-3"></i> Specializations
                                </a>

                                <!-- Admin Section -->
                                @if (currentUser.UserType == UserType.Admin)
                                {
                                    <div class="mt-3 mb-2">
                                        <small class="text-uppercase text-muted fw-bold">Admin</small>
                                    </div>
                                    <a href="/admin/dashboard" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/admin/dashboard")" @onclick="CloseMobileMenu">
                                        <i class="fas fa-cogs me-3"></i> Admin Dashboard
                                    </a>
                                    <a href="/admin/users" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/admin/users")" @onclick="CloseMobileMenu">
                                        <i class="fas fa-users me-3"></i> Manage Users
                                    </a>
                                    <a href="/admin/payments" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/admin/payments")" @onclick="CloseMobileMenu">
                                        <i class="fas fa-credit-card me-3"></i> Payment Requests
                                    </a>
                                    <a href="/admin/withdrawals" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/admin/withdrawals")" @onclick="CloseMobileMenu">
                                        <i class="fas fa-money-bill me-3"></i> Withdrawals
                                    </a>
                                    <a href="/admin/announcements" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/admin/announcements")" @onclick="CloseMobileMenu">
                                        <i class="fas fa-bullhorn me-3"></i> Announcements
                                    </a>
                                    <a href="/admin/contact-messages" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/admin/contact-messages")" @onclick="CloseMobileMenu">
                                        <i class="fas fa-envelope me-3"></i> Contact Messages
                                        @if (unreadMessagesCount > 0)
                                        {
                                            <span class="badge bg-danger ms-2">@unreadMessagesCount</span>
                                        }
                                    </a>
                                }
                                else if (currentUser.UserType == UserType.Doctor)
                                {
                                    <div class="mt-3 mb-2">
                                        <small class="text-uppercase text-muted fw-bold">Doctor</small>
                                    </div>
                                    <a href="/doctor/dashboard" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/doctor/dashboard")" @onclick="CloseMobileMenu">
                                        <i class="fas fa-user-md me-3"></i> Doctor Dashboard
                                    </a>
                                    <a href="/content/courses" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/doctor/content/courses")" @onclick="CloseMobileMenu">
                                        <i class="fas fa-book me-3"></i> My Courses
                                    </a>
                                    <a href="/doctor/earnings" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/doctor/earnings")" @onclick="CloseMobileMenu">
                                        <i class="fas fa-dollar-sign me-3"></i> Earnings
                                    </a>
                                }
                            }
                            else
                            {
                                <a href="/browse" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/browse")" @onclick="CloseMobileMenu">
                                    <i class="fas fa-search me-3"></i> Browse Courses
                                </a>
                            }

                            <!-- General Links -->
                            <div class="mt-3 mb-2">
                                <small class="text-uppercase text-muted fw-bold">General</small>
                            </div>
                            <a href="/about" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/about")" @onclick="CloseMobileMenu">
                                <i class="fas fa-info-circle me-3"></i> About
                            </a>
                            <a href="/contact" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/contact")" @onclick="CloseMobileMenu">
                                <i class="fas fa-envelope me-3"></i> Contact
                            </a>
                            <a href="/help" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/help")" @onclick="CloseMobileMenu">
                                <i class="fas fa-question-circle me-3"></i> Help
                            </a>
                        </div>

                        <!-- Account Section -->
                        @if (isAuthenticated && currentUser != null)
                        {
                            <div class="border-top pt-3">
                                <div class="mb-2">
                                    <small class="text-uppercase text-muted fw-bold">Account</small>
                                </div>
                                <a href="/account/profile" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/account/profile")" @onclick="CloseMobileMenu">
                                    <i class="fas fa-user me-3"></i> My Profile
                                </a>
                                <a href="/settings" class="d-block p-2 text-dark text-decoration-none rounded @GetNavLinkClass("/settings")" @onclick="CloseMobileMenu">
                                    <i class="fas fa-cog me-3"></i> Settings
                                </a>
                            </div>
                        }

                        <!-- Auth Buttons -->
                        <div class="mt-4">
                            @if (isAuthenticated && currentUser != null)
                            {
                                <button class="btn btn-danger w-100" @onclick="Logout">
                                    <i class="fas fa-sign-out-alt me-2"></i> Logout
                                </button>
                            }
                            else
                            {
                                <div class="d-grid gap-2">
                                    <a href="/account/login" class="btn btn-primary" @onclick="CloseMobileMenu">
                                        <i class="fas fa-sign-in-alt me-2"></i> Login
                                    </a>
                                    <a href="/account/register" class="btn btn-outline-primary" @onclick="CloseMobileMenu">
                                        <i class="fas fa-user-plus me-2"></i> Sign Up
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Overlay -->
                <div class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50"
                     style="z-index: 1040;"
                     @onclick="ToggleMobileMenu"></div>
            }
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="flex-grow-1">
        <div class="content-area">
            @Body
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white pt-5 pb-4 mt-auto">
        <div class="container px-4">
            <div class="row">
                <!-- Company Info -->
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 50px; height: 50px;">
                            <i class="fas fa-stethoscope fa-lg text-white"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold text-white mb-0">MedLearn</h4>
                            <small class="text-light">Medical Education Platform</small>
                        </div>
                    </div>
                    <p class="text-light mb-4">
                        Transforming medical education through innovative technology and expert-led
                        courses for healthcare professionals worldwide.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-outline-light btn-floating btn-sm rounded-circle">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="btn btn-outline-light btn-floating btn-sm rounded-circle">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#" class="btn btn-outline-light btn-floating btn-sm rounded-circle">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                        <a href="#" class="btn btn-outline-light btn-floating btn-sm rounded-circle">
                            <i class="fab fa-youtube"></i>
                        </a>
                        <a href="#" class="btn btn-outline-light btn-floating btn-sm rounded-circle">
                            <i class="fab fa-instagram"></i>
                        </a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                    <h5 class="fw-bold text-white mb-3">Platform</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a href="/" class="text-light text-decoration-none">
                                <i class="fas fa-chevron-right fa-xs me-2"></i> Home
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="/about" class="text-light text-decoration-none">
                                <i class="fas fa-chevron-right fa-xs me-2"></i> About Us
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="/browse" class="text-light text-decoration-none">
                                <i class="fas fa-chevron-right fa-xs me-2"></i> Browse Courses
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="/specializations" class="text-light text-decoration-none">
                                <i class="fas fa-chevron-right fa-xs me-2"></i> Specializations
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="/pricing" class="text-light text-decoration-none">
                                <i class="fas fa-chevron-right fa-xs me-2"></i> Pricing
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Resources -->
                <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                    <h5 class="fw-bold text-white mb-3">Resources</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a href="/faq" class="text-light text-decoration-none">
                                <i class="fas fa-chevron-right fa-xs me-2"></i> FAQ
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="/help" class="text-light text-decoration-none">
                                <i class="fas fa-chevron-right fa-xs me-2"></i> Help Center
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="/blog" class="text-light text-decoration-none">
                                <i class="fas fa-chevron-right fa-xs me-2"></i> Blog
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="/case-studies" class="text-light text-decoration-none">
                                <i class="fas fa-chevron-right fa-xs me-2"></i> Case Studies
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="/research" class="text-light text-decoration-none">
                                <i class="fas fa-chevron-right fa-xs me-2"></i> Research
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Contact & Newsletter -->
                <div class="col-lg-4 col-md-4">
                    <h5 class="fw-bold text-white mb-3">Stay Updated</h5>
                    <p class="text-light mb-3">
                        Subscribe to our newsletter for the latest medical education insights and course updates.
                    </p>

                    <!-- Newsletter Form -->
                    <div class="mb-4">
                        <div class="input-group">
                            <input type="email"
                                   class="form-control bg-dark text-white border-light"
                                   placeholder="Your email address"
                                   @bind="newsletterEmail" />
                            <button class="btn btn-primary" type="button" @onclick="SubscribeNewsletter">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                        @if (showNewsletterMessage)
                        {
                            <div class="alert @(newsletterSuccess ? "alert-success" : "alert-danger") mt-2 mb-0 p-2">
                                <small class="mb-0">@newsletterMessage</small>
                            </div>
                        }
                    </div>

                    <!-- Contact Info -->
                    <div>
                        <h6 class="fw-bold text-white mb-2">Contact Info</h6>
                        <ul class="list-unstyled text-light mb-0">
                            <li class="mb-2">
                                <i class="fas fa-map-marker-alt me-2"></i>
                                123 Medical Plaza, Suite 500<br>
                                <span class="ms-4">Boston, MA 02115</span>
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-phone me-2"></i>
                                +1 (555) 123-4567
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-envelope me-2"></i>
                                support@medicallearning.com
                            </li>
                            <li class="mb-0">
